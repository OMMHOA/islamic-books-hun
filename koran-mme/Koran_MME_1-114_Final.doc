\par }\pard \ql \fi-380\li380\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin380\itap0 {\insrsid8013616\charrsid12917982 1. A K\'f6ny\'f6r\'fclet}{\insrsid8923927\charrsid12917982 es \'e9s az Irgalmas Allah nev\'e9ben.}{
\insrsid8013616\charrsid12917982 
\par 2. A h\'e1latelt dics\'e9ret Allahot illeti, a teremtm\'e9nyek Ur\'e1t,
\par 3. A K\'f6ny\'f6r\'fcletest \'e9s az Irgalmast,
\par 4. Az \'cdt\'e9let Napj\'e1nak Birtokos\'e1t.
\par }{\insrsid7214487\charrsid12917982 
\par }{\insrsid8013616\charrsid12917982 5. Csak T\'e9ged szolg\'e1lunk, \'e9s csak T\'f5led k\'e9r\'fcnk seg\'edts\'e9get.
\par }{\insrsid7214487\charrsid12917982 
\par }{\insrsid8013616\charrsid12917982 6. Vezess minket az egyenes \'fatra,
\par }\pard \ql \fi-285\li270\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin270\itap0\pararsid8923927 {\insrsid8013616\charrsid12917982 7. }{\insrsid8923927\charrsid12917982 A}{\insrsid8013616\charrsid12917982 zoknak az \'fatj\'e1
ra, akiket j\'f3t\'e9tem\'e9nyekben r\'e9szes\'edtett\'e9l, nem azok\'e9ra, akiket haragv\'e1s s\'fajt, sem a t\'e9velyg\'f5k\'e9re!}{\insrsid12917982 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid12917982 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\f0\fs24\insrsid12917982\charrsid12917982 \page }{\f0\fs24\insrsid8013616\charrsid12917982 2. A }{\f0\fs24\insrsid8923927\charrsid12917982 T}{\f0\fs24\insrsid8013616\charrsid12917982 eh\'e9n (Al-Bakara) c. sz\'fara\line 
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid12917982 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid12917982 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }{\insrsid8013616 
\par }\pard \qj \fi-454\li454\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin454\itap0\pararsid12917982 {\insrsid8013616 1. Alif-l\'e1m-m\'edm.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid12917982 {\insrsid8013616 2. Ez az \'cdr\'e1s (a Kor\'e1n), melyhez nem f\'e9r k\'e9ts\'e9g, \'fatmutat\'e1s az istenf\'e9l\'f5knek,
\par }{\insrsid7214487 
\par }{\insrsid8013616 3. }{\insrsid8923927 A}{\insrsid8013616 kik hisznek a rejtett dolgokban, megtartj\'e1k az im\'e1dkoz\'e1st, \'e9s adakoznak abb\'f3l, amivel ell\'e1ttuk \'f5ket,
\par }\pard \qj \fi-285\li285\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin285\itap0\pararsid12917982 {\insrsid8013616 4. \'e9s akik hisznek abban, ami [kinyilatkoztat\'e1s gyan\'e1nt] lebocs\'e1ttatott hozz\'e1d [\'f3 Mohamed], \'e9
s abban, ami lebocs\'e1ttatott te el\'f5tted, \'e9s szil\'e1rd bizonyoss\'e1ggal hisznek a t\'falvil\'e1gban.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid12917982 {\insrsid8013616 5. \'d5k Urukt\'f3l val\'f3 \'fatmutat\'e1st k\'f6vetnek, \'e9s \'f5k azok, akik boldogulnak.
\par }{\insrsid7214487 
\par }{\insrsid8013616 6. Bizony, akik hitetlenn\'e9 v\'e1ltak, egyre megy nekik, hogy figyelmeztetted-e \'f5ket (\'f3 Mohamed) vagy nem figyelmeztetted, nem hisznek.
\par 7. Allah lepecs\'e9telte a sz\'edv\'fcket}{\insrsid8923927 ,}{\insrsid8013616  \'e9s a hall\'e1sukat \'e9s a l\'e1t\'e1sukat lepel fedi, \'e9s hatalmas gy\'f6trelem j\'e1r nekik.
\par }{\insrsid7214487 
\par }{\insrsid8013616 8. \'c9s vannak az emberek k\'f6z\'fcl olyanok, akik azt mondj\'e1k: \'84hisz\'fcnk Allahban \'e9s az Utols\'f3 Napban\'94, \'e1m \'f5k [val\'f3j\'e1ban] nem hisznek.
\par 9. F\'e9lre akarj\'e1k vezetni Allahot \'e9s azokat, akik hisznek, \'e1m nem vezetnek f\'e9lre m\'e1st, csup\'e1n magukat, \'e9s [ezt] \'e9szre sem veszik.
\par 10. Sz\'edv\'fckben betegs\'e9g van, \'e9s Allah tet\'e9zte \'f5ket betegs\'e9ggel. F\'e1jdalmas gy\'f6trelem j\'e1r nekik az\'e9rt, mert hazudtak.
\par 11. \'c9s ha azt mondj\'e1k nekik: \'84Ne okozzatok roml\'e1st a f\'f6ld\'f6n!\'94 \endash  azt felelik: \'84Bizony, mi csup\'e1n javul\'e1st hozunk.\'94
\par 12. L\'e1m, bizony \'f5k a roml\'e1s okoz\'f3i, \'e9s \'e9szre sem veszik!
\par 13. \'c9s ha azt mondj\'e1k nekik: \'84Higgyetek, ahogyan az emberek (Mohamed k\'f6vet\'f5i) hittek!\'94 \endash  azt felelik: \'84Vajon \'fagy higgy\'fcnk, ahogyan az ostob\'e1k hittek?\'94 L\'e1m, bizony \'f5k az ostob\'e1k, de nem rendelkeznek tud\'e1
ssal.\'94 
\par 14. \'c9s ha tal\'e1lkoznak azokkal, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben], azt mondj\'e1k: \'84hisz\'fcnk\'94, de ha egyed\'fcl maradnak a s\'e1t\'e1njaikkal, azt mondj\'e1k: \'84
Mi veletek vagyunk, mi csup\'e1n g\'fanyol\'f3dunk.\'94
\par 15. Allah g\'fanyol\'f3dik vel\'fck \'e9s hagyja \'f5ket t\'falkap\'e1saikba s\'fcllyedni \'fagy, hogy vakon bolyonganak.
\par 16. \'d5k azok, akik a t\'e9velyg\'e9st v\'e1s\'e1rolt\'e1k az [igaz] \'fatmutat\'e1s\'e9rt cser\'e9be, ez\'e9rt az \'f5 keresked\'e9s\'fck nem hozott hasznot, \'e9s nem leltek az [igaz \'fatra].
\par }{\insrsid7214487 
\par }{\insrsid8013616 17. Hasonlatosak \'f5k ahhoz, aki t\'fczet gy\'fajtott, s amikor az f\'e9nnyel \'e1rasztott el mindent k\'f6r\'fcl\'f6tte, Allah elvette a vil\'e1goss\'e1gukat (a jelenl\'e9v\'f5k\'e9t), \'e9s [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9
gekben hagyta \'f5ket \'fagy, hogy nem l\'e1tnak.
\par }\pard \qj \fi-454\li454\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin454\itap0\pararsid12917982 {\insrsid8013616 18. S\'fcketek [\'f5k], n\'e9m\'e1k \'e9s vakok, \'e9s \'f5k nem t\'e9rnek vissza [az igaz \'fatra].
\par }\pard \qj \fi-30\li30\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin30\itap0\pararsid12917982 {\insrsid8013616 19. Vagy [olyanok \'f5k], mint [akiket el\'e9rt] az \'e9gb\'f5l szakad\'f3 es\'f5, mely [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9
ts\'e9gekkel, mennyd\'f6rg\'e9ssel \'e9s vill\'e1mmal teli. Ujjukat a f\'fcl\'fckbe teszik a vill\'e1mcsap\'e1s [hangja] el\'f5l, a hal\'e1lt\'f3l val\'f3 f\'e9lelm\'fckben, \'e1m Allah k\'f6r\'fclveszi a hitetleneket.
\par 20. A vill\'e1m majdnem elragadja a l\'e1t\'e1sukat. Valah\'e1nyszor vil\'e1goss\'e1got ad nekik, j\'e1rnak abban, ha pedig s\'f6t\'e9ts\'e9ggel bor\'edtja be \'f5ket, meg\'e1llnak. Ha Allah akarn\'e1, bizony elvenn\'e9 a hall\'e1sukat \'e9s a l\'e1t\'e1
sukat. Bizony, Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par }{\insrsid7214487 
\par }{\insrsid8013616 21. \'d3, emberek! Szolg\'e1lj\'e1tok Uratokat (Allahot), aki megteremtett titeket \'e9s azokat, akik el\'f5ttetek \'e9ltek, h\'e1tha istenf\'e9l\'f5k lesztek.
\par 22. Aki a f\'f6ldet fekhelly\'e9, az eget \'e9p\'edtm\'e9nny\'e9 tette, \'e9s az \'e9gb\'f5l vizet bocs\'e1tott le, \'e9s az \'e1ltal term\'e9seket hozott el\'f5 ell\'e1t\'e1sul nektek. Ne \'e1ll\'edtsatok h\'e1t Allah mell\'e9 vet\'e9lyt\'e1rsakat [az im
\'e1datban], mik\'f6zben ti tudj\'e1tok [hogy egyed\'fcl Allah \'e9rdemli meg az im\'e1datot]!
\par }{\insrsid7214487 
\par }{\insrsid8013616 23. \'c9s ha k\'e9ts\'e9gben vagytok afel\'f5l, amit lebocs\'e1tottunk (a Kor\'e1nt) a Mi szolg\'e1nknak (Mohamednek), akkor \'e1lljatok el\'f5 egy hozz\'e1 (a Kor\'e1n sz\'far\'e1ihoz }{\insrsid11821204 \endash }{\insrsid8013616 
 fejezeteihez) hasonl\'f3 sz\'far\'e1val \'e9s h\'edvj\'e1tok a tan\'faitokat (seg\'edt\'f5iteket \'e9s t\'e1mogat\'f3itokat) Allahon k\'edv\'fcl, ha }{\insrsid2818494 val\'f3ban }{\insrsid8013616 igazmond\'f3k vagytok}{\insrsid11821204 !}{
\insrsid8013616 
\par 24. De ha nem teszitek meg \endash  \'e9s nem is lesztek k\'e9pesek megtenni \endash , akkor \'f3vj\'e1tok magatokat a [Pokol-]t\'fbzt\'f5l, melynek t\'fczel\'f5je az emberek \'e9s a [b\'e1lv\'e1ny]k\'f6vek, [\'e9s amely] el\'f5 van k\'e9sz\'ed
tve a hitetlenek sz\'e1m\'e1ra.
\par }{\insrsid7214487 
\par }{\insrsid8013616 25. \'c9s add \'f6r\'f6mh\'edr\'fcl azoknak, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben], \'e9s j\'f3
tetteket cselekszenek, hogy Kertjeik lesznek (a Paradicsomban), amelyek alatt foly\'f3k folynak. Valah\'e1nyszor csak ell\'e1t\'e1st kapnak gy\'fcm\'f6lcseikb\'f5l, azt mondj\'e1k: \'84Ez ugyanaz, amit kor\'e1bban kaptunk ell\'e1t\'e1sk\'e9nt\'94, \'e1
m [csak ahhoz] hasonl\'f3t kaptak (az alakjuk hasonl\'f3, de az \'edze m\'e1s), s tiszt\'e1v\'e1 tett h\'e1zast\'e1rsaik lesznek, \'e9s \'f5k \'f6r\'f6kk\'e9 abban fognak maradni.
\par }{\insrsid7214487 
\par }{\insrsid8013616 26. Bizony, Allah nem sz\'e9gyell p\'e9ld\'e1zatot adni, ak\'e1r egy sz\'fanyogr\'f3l, vagy valami [kisebbr\'f5l], ami f\'f6l\'f6tte (rajta) van. Azok, akik hisznek, tudj\'e1k, hogy ez az igazs\'e1g az Urukt\'f3
l, azonban, akik nem hisznek, azt mondj\'e1k: \'84Mit akart [mondani] Allah ezzel a p\'e9ld\'e1zattal?\'94 T\'e9velyg\'e9sbe visz vele sokakat, de sokakat [az igaz \'fatra] vezet \'e1ltala. \'c1m csup\'e1n az engedetleneket viszi t\'e9velyg\'e9sbe \'e1
ltala.
\par 27. Akik megszegik az Allahhal [k\'f6t\'f6tt] egyezs\'e9get, miut\'e1n megk\'f6t\'f6tt\'e9k azt, \'e9s elv\'e1gj\'e1k azt [a k\'f6tel\'e9ket], }{\cf1\insrsid8013616 amire Allah parancsot adott, hogy egybek\'f6ttessen}{\insrsid8013616 , \'e9s roml\'e1st 
okoznak a f\'f6ld\'f6n. }{\insrsid417847 \'d5k b}{\insrsid8013616 izony a vesztesek.
\par }{\insrsid7214487 
\par }{\insrsid8013616 28. Hogyan v\'e1lhattok hitetlenn\'e9 Allahhal szemben, holott halottak voltatok \'e9s \'e9letre keltett titeket, azt\'e1n hal\'e1lba k\'fcld, majd \'e9letre kelt titeket [a Felt\'e1mad\'e1s napj\'e1n], azut\'e1n Hozz\'e1
 lesztek visszavitetve?
\par 29. \'d5 az, aki teremtette nektek mindazt, ami a f\'f6ld\'f6n van, azut\'e1n az \'e9g fel\'e9 fordult, \'e9s h\'e9t \'e9gboltt\'e1 form\'e1lta azt. \'c9s \'d5 minden dologr\'f3l tudom\'e1ssal b\'edr.
\par }{\insrsid7214487 
\par }{\insrsid8013616 30. \'c9s [eml\'edtsd meg azt], amikor Urad \'edgy sz\'f3lt az angyalokhoz: \'84Bizony helytart\'f3t fogok helyezni a f\'f6ldre\'94, azt mondt\'e1k: \'84Vajon olyasvalakit helyezel oda, aki ott roml\'e1st okoz \'e9s v\'e9
rt ont, holott mi magasztalunk a T\'e9ged illet\'f5 h\'e1latelt dics\'e9rettel, \'e9s szents\'e9gedet zengj\'fck?\'94 [Allah \'edgy sz\'f3lt]: \'84\'c9n bizony tudom, amit ti nem tudtok.\'94
\par 31. \'c9s megtan\'edtotta \'c1d\'e1mnak az \'f6sszes nevet, majd megmutatta az angyaloknak [a dolgokat] \'e9s azt mondta: \'84Adj\'e1tok h\'edr\'fcl nekem ezeknek a nev\'e9t, ha }{\insrsid2818494 val\'f3ban }{\insrsid8013616 igazmond\'f3k vagytok!\'94

\par 32. [Az angyalok] azt mondt\'e1k: \'84Magasztaltass\'e1l! Mi nem tudunk m\'e1st, csak amit Te tan\'edtott\'e1l nek\'fcnk. Te vagy a Mindentud\'f3, a B\'f6lcs.\'94
\par 33 Azt mondta [Allah]: \'84\'d3 \'c1d\'e1m, add h\'edr\'fcl nekik a [dolgok] neveit!\'94 Miut\'e1n h\'edr\'fcl adta nekik a neveiket, \'edgy sz\'f3lt [Allah]: \'84Vajon nem mondtam-e nektek, hogy tudom az \'e9g \'e9s a f\'f6ld rejtett dolgait, \'e9
s tudom azt, amit felfedtetek, \'e9s azt, amit elrejtettetek?\'94
\par }{\insrsid7214487 
\par }{\insrsid8013616 34. \'c9s [eml\'edtsd meg azt], amikor \'edgy sz\'f3ltunk az angyalokhoz: \'84Boruljatok le \'c1d\'e1m el\'f5tt!\'94 \'c9s \'f5k leborultak, kiv\'e9ve }{\i\insrsid8013616 Ibl\'edsz-t}{\insrsid8013616  (a S\'e1t\'e1nt), [aki] visszautas
\'edtotta, \'e9s fennh\'e9j\'e1zott, \'e9s azok k\'f6z\'e9 tartozott, akik hitetlenek.
\par 35. \'c9s azt mondtuk: \'84\'d3 \'c1d\'e1m! Lakozz\'e1l a feles\'e9geddel egy\'fctt a Paradicsomban, \'e9s egyetek abb\'f3l}{\insrsid11404096 ,}{\insrsid11952605  }{\insrsid8013616 b\'f5s\'e9ges }{\insrsid11952605 \'e9s j\'f3\'edz\'fb [}{\insrsid8013616 
term\'e9seib\'f5l}{\insrsid11952605 ],}{\insrsid8013616  ahol csak akartok. \'c1m ne k\'f6zeledjetek ehhez a f\'e1hoz, k\'fcl\'f6nben az igazs\'e1gtalanok k\'f6z\'e9 fogtok tartozni!\'94
\par 36. Majd botl\'e1sra k\'e9sztette \'f5ket a S\'e1t\'e1n, \'e9s elt\'e1vol\'edtotta \'f5ket abb\'f3l [a j\'f3l\'e9tb\'f5l], amelyben voltak. \'c9s Mi azt mondtuk: \'84Menjetek le [a Paradicsomb\'f3l]! Egyik\'f5t\'f6k a m\'e1siknak ellens\'e9ge, \'e9s a f
\'f6ld\'f6n sz\'e1ll\'e1shely \'e9s \'e9lvezet lesz sz\'e1motokra egy [meghat\'e1rozott] ideig.\'94
\par 37. \'c1d\'e1m ezut\'e1n szavakat kapott Ur\'e1t\'f3l. \'c9s [Ura] kiengesztel\'f5d\'f6tt ir\'e1nta. Bizony, \'d5 a Kiengesztel\'f5d\'f5, az Irgalmas.
\par 38. Azt mondtuk: \'84Menjetek le mindannyian innen (a Paradicsomb\'f3l)! Amikor \'fatmutat\'e1s \'e9rkezik hozz\'e1tok majd T\'f5lem, akik k\'f6vetik az \'fatmutat\'e1somat, azokon nem lesz \'farr\'e1 a f\'e9lelem [a T\'falvil\'e1gon], \'e9s n
em fognak szomorkodni.
\par 39. Azonban, akik nem hisznek \'e9s meghazudtolj\'e1k a jeleinket, azok a [Pokol-]t\'fbz lak\'f3i lesznek, \'f6r\'f6kk\'e9 abban fognak maradni.\'94
\par }{\insrsid7214487 
\par }{\insrsid8013616 40. \'d3, Izrael fiai! Eml\'e9kezzetek a j\'f3t\'e9tem\'e9nyemre, amellyel megaj\'e1nd\'e9koztalak titeket \'e9s tarts\'e1tok be a Velem k\'f6t\'f6tt egyezs\'e9g}{\insrsid8323548 [}{\insrsid8013616 em}{\insrsid8323548 ]}{\insrsid8013616 
et (teljes\'edts\'e9tek az el\'f5\'edr\'e1saimat), akkor \'e9n [is] tartom a veletek k\'f6t\'f6tt egyezs\'e9get (megkapj\'e1tok a jutalmat), \'e9s csak T\'f5lem rettegjetek!
\par 41. \'c9s higgyetek abban, amit lebocs\'e1tottam (a Kor\'e1nt) igazolva annak az igazs\'e1g\'e1t, ami n\'e1latok van (a T\'f3ra \'e9s az Evang\'e9lium)! \'c9s ne legyetek azok, akik els\'f5kk\'e9nt tagadj\'e1k meg! \'c9s ne k\'f3tyavety\'e9lj\'e9
tek el a jeleimet (szavaimat) csek\'e9ly \'e1ron, \'e9s csak Engem f\'e9ljetek!
\par 42. Ne tegy\'e9tek zavaross\'e1 az igazs\'e1got a hamiss\'e1ggal, \'e9s ne leplezz\'e9tek az igazs\'e1got (azt, hogy Mohamed Allah k\'fcld\'f6tte, akinek tulajdons\'e1gai megtal\'e1lhat\'f3k a T\'f3r\'e1ban \'e9s az Evang\'e9liumban), mik\'f6zben ti tudj
\'e1tok [azt]!
\par 43. \'c9s tarts\'e1tok meg az im\'e1dkoz\'e1st, adj\'e1tok meg a k\'f6telez\'f5 adom\'e1nyt, \'e9s hajoljatok meg a meghajl\'f3kkal egy\'fctt (k\'f6z\'f6ss\'e9gben im\'e1dkozzatok)! \'c9s [im\'e1dkoz\'e1sotokban] hajoljatok meg a meghajl\'f3kkal egy\'fc
tt. 
\par 44. Vajon j\'f3s\'e1gra sz\'f3l\'edtj\'e1tok fel az embereket, \'e9s ti magatok elfelejtitek azt [gyakorolni], holott olvass\'e1tok az \'cdr\'e1st [a T\'f3r\'e1t]? H\'e1t vajon nem \'e9ltek az eszetekkel?
\par 45. \'c9s leljetek seg\'edt}{\insrsid8323548 s}{\insrsid8013616 \'e9}{\insrsid8323548 g}{\insrsid8013616 et a t\'fcrelemben \'e9s az im\'e1dkoz\'e1sban! Val\'f3ban neh\'e9z dolog ez, de nem az \'e1h\'edtatosak sz\'e1m\'e1ra,
\par 46 }{\insrsid8323548 A}{\insrsid8013616 kik [teljes bizonyoss\'e1ggal] v\'e9lik azt, hogy tal\'e1lkozni fognak Urukkal \'e9s \'d5hozz\'e1 fognak visszat\'e9rni.
\par 47. \'d3, Izrael fiai! Eml\'e9kezzetek a j\'f3t\'e9tem\'e9nyemre, amellyel megaj\'e1nd\'e9koztalak benneteket, \'e9s arra, hogy [kor\'e1bban] el\'f5nyben r\'e9szes\'edtettelek titeket a [hajdan \'e9lt] teremtm\'e9nyekkel szemben [az emberek k\'f6z\'fcl]!

\par 48. \'c9s \'f3vj\'e1tok magatokat egy olyan nap [b\'fcntet\'e9s\'e9t\'f5l], amikor egy ember sem tehet semmit a m\'e1sik\'e9rt, k\'f6zbenj\'e1r\'e1sa nem fogadtatik el, \'e9s v\'e1lts\'e1got sem vesznek \'e1t t\'f5le, \'e9
s (a hitetlenek) nem lesznek megseg\'edtve}{\insrsid8323548 !}{\insrsid8013616 
\par }{\insrsid7214487 
\par }{\insrsid8013616 49 \'c9s [eml\'e9kezzetek arra], amikor megmentett\'fcnk titeket a F\'e1ra\'f3 embereit\'f5l, [akik] sz\'f6rny\'fb gy\'f6trelemmel s\'fajtottak titeket, lem\'e9sz\'e1rolt\'e1k fiaitokat \'e9s asszonyaitokat \'e9letben hagyt\'e1k! \'c9
s ebben hatalmas pr\'f3bat\'e9tel volt sz\'e1motokra Uratokt\'f3l.
\par 50. \'c9s [eml\'e9kezzetek arra], amikor sz\'e9tv\'e1lasztottuk sz\'e1motokra a tengert, megmentett\'fcnk benneteket \'e9s v\'edzbe fullasztottuk a F\'e1ra\'f3 embereit, mik\'f6zben n\'e9zt\'e9tek [ahogy a tenger bez\'e1rult felett\'fck]}{\insrsid8323548 
!}{\insrsid8013616 
\par 51. \'c9s [eml\'e9kezzetek arra], amikor M\'f3zesnek negyven \'e9jszak\'e1t jel\'f6lt\'fcnk ki [a Vel\'fcnk val\'f3 tal\'e1lkoz\'e1sra], majd a t\'e1voll\'e9t\'e9ben [isten}{\insrsid11892319 etekk\'e9}{\insrsid8013616 ] tett\'e9tek az [arany] borj\'fat 
\'e9s igazs\'e1gtalanok voltatok!
\par 52. Majd megbocs\'e1tottunk nektek ezut\'e1n, h\'e1tha h\'e1l\'e1sak lesztek.
\par }{\insrsid7214487 
\par }{\insrsid8013616 53. \'c9s [eml\'e9kezzetek arra], amikor M\'f3zesnek adtuk az \'cdr\'e1st (a T\'f3r\'e1t), \'e9s az [igazs\'e1g \'e9s hamiss\'e1g k\'f6z\'f6tti] Sz\'e9tv\'e1laszt\'f3t, h\'e1tha [az igaz] \'fatra leltek}{\insrsid8323548 !}{
\insrsid8013616 
\par 54. \'c9s [eml\'e9kezzetek arra], amikor M\'f3zes \'edgy sz\'f3lt a n\'e9p\'e9hez: \'84\'d3 n\'e9pem, bizony igazs\'e1gtalans\'e1got k\'f6vettetek el magatok ellen azzal, hogy [isten}{\insrsid11892319 etekk\'e9}{\insrsid8013616 ] tett\'e9tek a borj\'fa
t. Forduljatok h\'e1t b\'fbnb\'e1nattal a ti Alkot\'f3tokhoz, \'f6lj\'e9tek meg magatok [k\'f6z\'fcl az arany borj\'fat im\'e1d}{\insrsid8323548 \'f3}{\insrsid8013616 kat]! Ez jobb nektek a ti Alkot\'f3tok el\'f5tt.\'94 Azut\'e1n \'d5 kiengesztel\'f5d\'f6
tt ir\'e1ntatok. Bizony \'d5 a Kiengesztel\'f5d\'f5, az Irgalmas.
\par 55. \'c9s [eml\'e9kezzetek arra], amikor azt mondt\'e1tok: \'84\'d3 M\'f3zes! Nem hisz\'fcnk neked addig, am\'edg nem l\'e1tjuk Allahot szemmel l\'e1that\'f3 m\'f3don\'94. \'c9s elragadott (meg\'f6lt) benneteket a vill\'e1mcsap\'e1s, mik\'f6zben n\'e9zt
\'e9tek [azt].
\par 56. Azut\'e1n felt\'e1masztottunk titeket a hal\'e1lotok ut\'e1n, h\'e1tha h\'e1l\'e1sak lesztek.
\par 57. \'c9s \'e1rny\'e9kot bor\'edtottunk re\'e1tok a felh\'f5kkel, \'e9s mann\'e1t \'e9s f\'fcrjeket bocs\'e1tottunk le nektek, [\'edgy sz\'f3lv\'e1n:] \'84Egyetek azokb\'f3l a j\'f3 dolgokb\'f3l, amelyekkel ell\'e1ttunk titeket!\'94 \'c1m nem ellen\'fc
nk k\'f6vettek el igazs\'e1gtalans\'e1got, hanem saj\'e1t magukkal voltak igazs\'e1gtalanok.
\par }{\insrsid7214487 
\par }{\insrsid8013616 58. \'c9s [eml\'e9kezzetek arra], amikor azt mondtuk: \'84L\'e9pjetek be ebbe a telep\'fcl\'e9sbe (Jeruzs\'e1lembe), \'e9s ahol csak akartok, egyetek abb\'f3l}{\insrsid9377656 ,}{\insrsid11404096  }{\insrsid8013616 b\'f5s\'e9ges}{
\insrsid11952605  \'e9s j\'f3\'edz\'fb [}{\insrsid8013616 term\'e9seib\'f5l}{\insrsid11952605 ],}{\insrsid8013616  \'e9s l\'e9pjetek be a kapun al\'e1zattal (\'e9s boruljatok le h\'e1l\'e1san), s mondj\'e1tok: \'84Vedd le [r\'f3lunk a v\'e9tkeinket]\'94
! Megbocs\'e1tjuk nektek a v\'e9tkeiteket \'e9s t\'f6bbet fogunk adni a }{\insrsid7415419\charrsid11885244 j\'f3te}{\insrsid8013616\charrsid11885244 v\'f5knek}{\insrsid8013616 .
\par 59. \'c1m akik igazs\'e1gtalans\'e1got k\'f6vettek el, m\'e1s besz\'e9dre cser\'e9lt\'e9k azt, ami mondva lett nekik. \'c9s azokra, akik igazs\'e1gtalans\'e1got k\'f6vettek el, b\'fcntet\'e9st bocs\'e1tottunk le az \'e9gb\'f5l, ami\'e9r
t engedetlenek voltak.
\par }{\insrsid7214487 
\par }{\insrsid8013616 60. \'c9s [eml\'e9kezzetek arra], amikor M\'f3zes vizet k\'e9rt n\'e9p\'e9nek. Mi azt mondtuk: \'84\'dcss a botoddal a szikl\'e1ra!\'94, s tizenk\'e9t forr\'e1s t\'f6rt el\'f5 abb\'f3l. Tudta m\'e1
r minden embercsoport azt, hogy hol van az iv\'f3helye. \'84Egyetek \'e9s igyatok Allah ell\'e1t\'e1s\'e1b\'f3l, \'e9s ne j\'e1rjatok [gonoszul] a f\'f6ld\'f6n roml\'e1st okozva!\'94
\par 61. \'c9s [eml\'e9kezzetek arra], amikor \'edgy sz\'f3ltatok: \'84\'d3 M\'f3zes! Nem tudjuk elviselni ugyanazt [az egyfajta] \'e9lelmet. Foh\'e1szkodj az Uradhoz \'e9rt\'fcnk, hogy hozzon el\'f5 nek\'fcnk abb\'f3l, amit a f\'f6ld terem: z\'f6lds\'e9geib
\'f5l, ubork\'e1j\'e1b\'f3l, fokhagym\'e1j\'e1b\'f3l, lencs\'e9j\'e9b\'f5l \'e9s hagym\'e1j\'e1b\'f3l.\'94 \'d5 \'edgy sz\'f3lt: \'84Vajon al\'e1val\'f3bbra akarj\'e1tok cser\'e9lni azt, ami jobb? Menjetek le b\'e1rmelyik v\'e1rosba, [ott] megkapj\'e1
tok azt, amit k\'e9rtek!\'94 \'c9s megal\'e1ztat\'e1s \'e9s nyomor\'fas\'e1g vettetett r\'e1juk, \'e9s Allah haragv\'e1s\'e1t vont\'e1k magukra. Ez az\'e9rt volt, mert [sorozatosan] hitetlenn\'e9 v\'e1ltak Allah jeleivel szemben, \'e9s jogtalanul meg\'f6
lt\'e9k a pr\'f3f\'e9t\'e1kat, \'e9s az\'e9rt mert ellenszeg\'fcltek, \'e9s t\'falkap\'e1sra vetemedtek.
\par 62. Bizony, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben], \'e9s akik zsid\'f3k, \'e9s a kereszt\'e9nyek \'e9s a sz\'e1beit\'e1k, akik hisznek Allahban, \'e9s a}{\insrsid11885244 z}{\insrsid8013616 
 Utols\'f3 Napban \'e9s j\'f3t cselekszenek, megvan a jutalmuk az Urukn\'e1l, nem lesz \'farr\'e1 rajtuk a f\'e9lelem [a T\'falvil\'e1gon], \'e9s nem fognak szomorkodni.
\par }{\insrsid7214487 
\par }{\insrsid8013616 63. \'c9s [eml\'e9kezzetek arra], amikor sz\'f6vets\'e9get k\'f6t\'f6tt\'fcnk veletek \'e9s f\'f6l\'e9tek emelt\'fck a [S\'ednai] hegyet, [mondv\'e1n]: \'84Ragaszkodjatok er\'f5sen ahhoz, amit [kinyilatkoztat\'e1s gyan\'e1
nt] adtunk nektek \'e9s eml\'e9kezzetek arra, amit [az] tartalmaz!\'94, h\'e1tha istenf\'e9l\'f5k lesztek.
\par 64. Ezut\'e1n azonban h\'e1tat ford\'edtottatok. \'c9s ha nem lenne Allah kegye \'e9s k\'f6ny\'f6r\'fclete ir\'e1ntatok, akkor a vesztesek k\'f6z\'e9 tartozn\'e1tok.
\par 65. \'c9s bizonyosan tudtatok azokr\'f3l, akik k\'f6z\'fcletek t\'falkap\'e1sra vetemedtek a szombat [szents\'e9g\'e9vel] szemben \'e9s [ez\'e9rt] azt mondtuk nekik: \'84Legyetek megvetett majmok!\'94
\par 66. Elrettent\'f5 b\'fcntet\'e9ss\'e9 tett\'fck ezt az akkori n\'e9peknek \'e9s azoknak, akik ut\'e1nuk k\'f6vetkeztek, \'e9s int\'e9ss\'e9 az istenf\'e9l\'f5knek.
\par }{\insrsid7214487 
\par }{\insrsid8013616 67. \'c9s [eml\'e9kezzetek arra], amikor M\'f3zes \'edgy sz\'f3lt a n\'e9p\'e9hez: \'84Allah bizony megparancsolja nektek, hogy v\'e1gjatok le egy tehenet!\'94 \'cdgy sz\'f3ltak: \'84Vajon cs\'fafot \'fbz\'f6l vel\'fcnk?\'94 [M\'f3zes] 
\'edgy sz\'f3lt: \'84Mened\'e9ket k\'e9rek Allaht\'f3l, [az ellen] hogy a tudatlanok k\'f6z\'e9 tartozzak!\'94
\par 68. Azt mondt\'e1k: \'84Esedezz a nev\'fcnkben az Uradhoz, hogy tegye vil\'e1goss\'e1 sz\'e1munkra, milyen [teh\'e9n] legyen az!\'94 [M\'f3zes] azt mondta: \'84\'d5 azt mondja, hogy olyan teh\'e9n legyen, amely se nem t\'fal \'f6reg, se nem t\'fa
l fiatal, hanem a kett\'f5 k\'f6z\'f6tt van. Tegy\'e9tek h\'e1t, amire parancsot kaptatok!\'94
\par 69. Azt mondt\'e1k: \'84Esedezz a nev\'fcnkben az Uradhoz, hogy tegye vil\'e1goss\'e1 sz\'e1munkra, milyen sz\'edn\'fb legyen!\'94 Azt mondta [M\'f3zes]: \'84\'d5 azt mondja, hogy \'e9l\'e9nk s\'e1rga teh\'e9n legyen, amely \'f6r\'f6
met okoz azoknak, akik n\'e9zik}{\insrsid15734002 .}{\insrsid8013616 \'94
\par 70. Azt mondt\'e1k: \'84Esedezz a nev\'fcnkben az Uradhoz, hogy tegye vil\'e1goss\'e1 sz\'e1munkra, melyik is az, bizony a tehenek egyform\'e1k sz\'e1munkra. Bizony mi, ha Allah \'fagy akarja, r\'e1lel\'fcnk [a k\'e9rt teh\'e9nre].\'94
\par 71. [M\'f3zes] azt mondta: \'84\'d5 azt mondja, hogy az egy olyan teh\'e9n, amely nem [v\'e1lt] kezess\'e9, hogy a f\'f6ldet sz\'e1ntsa, vagy a vet\'e9st \'f6nt\'f6zze; hib\'e1tlan \'e9s makul\'e1tlan (egysz\'edn\'fb).\'94 \'d5k azt mondt\'e1k: \'84Most j
\'f6tt\'e9l el az igazs\'e1ggal}{\insrsid15734002 .}{\insrsid8013616 \'94 \'c9s akkor lev\'e1gt\'e1k azt, \'e1m k\'f6zel \'e1lltak ahhoz, hogy ne tegy\'e9k meg.
\par 72. \'c9s [eml\'e9kezzetek arra], hogy meg\'f6ltetek egy embert \'e9s egym\'e1st okolt\'e1tok azzal! Allah azonban el\'f5hozza azt, amit eltitkoltatok.
\par 73. \'c9s Mi azt mondtuk: \'84\'dcssetek r\'e1 (a halottra) [a teh\'e9n] egy darabj\'e1val!\'94 \'cdgy kelti \'e9letre Allah a halottakat, s mutatja meg nektek a jeleit, h\'e1tha \'e9ltek az eszetekkel.
\par }{\insrsid7214487 
\par }{\insrsid8013616 74. Ezut\'e1n azonban megkem\'e9nyedett a sz\'edvetek, olyan lett, mint a k\'f5, vagy m\'e9g kem\'e9nyebb. S bizony a k\'f6vek k\'f6z\'f6tt van olyan, amelyb\'f5l foly\'f3k t\'f6rnek el\'f5; van olyan, amely sz\'e9thasad, \'e9s v\'edz 
\'e1rad bel\'f5le, \'e9s van olyan, amely leereszkedik Allaht\'f3l val\'f3 f\'e9lelm\'e9ben. \'c9s Allah nem hagyja figyelmen k\'edv\'fcl, amit cselekszetek.
\par 75. Vajon abban rem\'e9nykedtek [ti muszlimok], hogy [a zsid\'f3k] hinni fognak nektek, mik\'f6zben volt egy olyan csoport k\'f6z\'fcl\'fck, amely hallotta Allah szav\'e1t, majd meghamis\'edtotta, miut\'e1n meg\'e9rtette azt, holott tudt\'e1
k [hogy Allah szav\'e1t hamis\'edtj\'e1k meg]?
\par }{\insrsid7214487 
\par }{\insrsid8013616 76. \'c9s ha tal\'e1lkoznak azokkal, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben], azt mondj\'e1k: \'84Hisz\'fcnk.\'94 \'c1m ha egym\'e1s k\'f6z\'f6tt egyed\'fc
l maradnak, azt mondj\'e1k: \'84Vajon elmondan\'e1tok nekik (a muszlimoknak) azt, amit Allah nyilv\'e1nval\'f3v\'e1 tett nektek [a T\'f3r\'e1ban Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9vel kapcsolatban], hogy ezzel \'e9rvelve sz\'e1lljanak vit\'e1
ba veletek Uratok el\'f5tt?\'94 H\'e1t nem \'e9ltek az eszetekkel?
\par 77. Vajon nem tudj\'e1k, hogy Allah tudja mindazt, amit eltitkolnak, \'e9s azt, amit kinyilv\'e1n\'edtanak?
\par }{\insrsid7214487 
\par }{\insrsid8013616 78. \'c9s vannak k\'f6z\'f6tt\'fck \'edr\'e1studatlanok, akik nem ismerik az \'cdr\'e1st, csup\'e1n annak recit\'e1l\'e1s\'e1t [meg\'e9rt\'e9se n\'e9lk\'fcl], \'e9s csup\'e1n v\'e9lekednek.
\par 79. \'c1m jaj azoknak, akik saj\'e1t kez\'fckkel \'edrj\'e1k az \'cdr\'e1st (a T\'f3r\'e1t), s azut\'e1n azt mondj\'e1k: \'84Ez Allaht\'f3l sz\'e1rmazik\'94, hogy elk\'f3tyavety\'e9lj\'e9k azt csek\'e9ly \'e1ron! Jaj nekik az\'e9rt, amit a kez\'fck \'ed
rt, \'e9s jaj nekik az\'e9rt a haszon\'e9rt, amit szereztek!
\par }{\insrsid7214487 
\par }{\insrsid8013616 80. \'c9s azt mondt\'e1k [a zsid\'f3k]: \'84Nem fog \'e9rinteni minket a [Pokol-]t\'fbz [a felt\'e1mad\'e1s ut\'e1n], csup\'e1n meghat\'e1rozo}{\insrsid14250851 tt sz\'e1m\'fa napig.\'94 Mondd [nekik, \'f3}{\insrsid8013616  Mohamed]: 
\'84Vajon egyezs\'e9get k\'f6t\'f6ttetek [erre n\'e9zv\'e9n] Allahhal \endash  \'e9s akkor Allah nem fogja az egyezs\'e9g\'e9t megszegni \endash  vagy tal\'e1n olyasmit \'e1ll\'edtotok Allahr\'f3l, amit nem tudtok?}{\insrsid15734002 \'94}{\insrsid8013616 

\par 81. Dehogynem! Akik rosszat szereztek maguknak, \'e9s k\'f6r\'fclvette \'f5ket a v\'e9tk\'fck, azok a [Pokol-] t\'fbz lak\'f3i lesznek, \'f6r\'f6kk\'e9 abban fognak maradni.
\par 82. Azok, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s a k\'fcld\'f6tteiben], \'e9s j\'f3tetteket cselekszenek, a Paradicsom lak\'f3i lesznek, \'e9s \'f6r\'f6kk\'e9 abban fognak maradni.
\par }{\insrsid7214487 
\par }{\insrsid8013616 83. \'c9s [eml\'e9kezzetek arra,] amikor Izrael fiaival sz\'f6vets\'e9get k\'f6t\'f6tt\'fcnk [mondv\'e1n]: \'84Ne szolg\'e1ljatok m\'e1st, csak Allahot! B\'e1njatok j\'f3l a sz\'fcl\'f5kkel, a rokonokkal, az \'e1rv\'e1kkal \'e9s a szeg
\'e9nyekkel! \'c9s j\'f3t mondjatok az embereknek! Tarts\'e1tok meg az im\'e1dkoz\'e1st \'e9s adj\'e1tok meg a k\'f6telez\'f5 adom\'e1nyt! Azut\'e1n h\'e1tat ford\'edtottatok [az egyezs\'e9gnek] \endash  kiv\'e9ve kevesen k\'f6z\'fcletek \endash  mik\'f6
zben \'fcgyet sem vetettetek r\'e1.
\par 84. \'c9s [eml\'e9kezzetek arra,] amikor sz\'f6vets\'e9get k\'f6t\'f6tt\'fcnk veletek arr\'f3l, hogy nem ontj\'e1tok ki egym\'e1s v\'e9r\'e9t, \'e9s nem \'fbzitek ki egym\'e1st a lakhelyeitekr\'f5l! Azut\'e1n elfogadt\'e1tok ezt \'e9
s ti magatok voltatok a tan\'fak.
\par 85. Azut\'e1n pedig ti vagytok azok, akik meg\'f6litek egym\'e1st, ki\'fbzt\'f6k egy csoportot magatok k\'f6z\'fcl a lakhely\'e9r\'f5l, seg\'edtitek [ellens\'e9geiket] \'f5ellen\'fck a b\'fbnben \'e9s a t\'falkap\'e1sban, \'e9s ha fogs\'e1gba esnek, kiv
\'e1ltj\'e1tok \'f5ket, mik\'f6zben [eredend\'f5en] tilalmas lett volna sz\'e1motokra a ki\'fbz\'e9s\'fck. Vajon az \'cdr\'e1s egy r\'e9sz\'e9ben hisztek, \'e9s a m\'e1sik r\'e9sz\'e9t tagadj\'e1tok? Mi m\'e1s a fizets\'e9ge annak, aki ezt teszi k\'f6z
\'fcletek, mint megsz\'e9gyen\'edt\'e9s az evil\'e1gi \'e9letben, \'e9s a Felt\'e1mad\'e1s Napj\'e1n pedig a legs\'falyosabb gy\'f6trelembe juttatnak, \'e9s Allah nem hagyja figyelmen k\'edv\'fcl, amit tesztek.
\par 86. \'d5k azok, akik megv\'e1s\'e1rolt\'e1k az evil\'e1gi \'e9letet a t\'falvil\'e1gi \'e9let\'e9rt cser\'e9be. Nem enyh\'edttetik sz\'e1mukra a gy\'f6trelem, \'e9s nem lesznek megseg\'edtve.
\par }{\insrsid7214487 
\par }{\insrsid8013616 87. \'c9s bizony odaadtuk M\'f3zesnek az \'cdr\'e1st (a T\'f3r\'e1t), \'e9s ut\'e1na k\'fcldt\'fck [egym\'e1st k\'f6vet\'f5en] a k\'fcld\'f6tteket. Vil\'e1gos bizony\'edt\'e9kokat adtunk J\'e9zusnak, M\'e1ria fi\'e1nak, \'e9s meger\'f5s
\'edtett\'fck \'f5t a Szent L\'e9lekkel (G\'e1briel angyallal). Vajon ah\'e1nyszor egy k\'fcld\'f6tt olyasvalamivel j\'f6tt el hozz\'e1tok, amely nem volt a magatok kedv\'e9re, akkor fennh\'e9j\'e1ztatok? Egyeseket hazugs\'e1ggal v\'e1doltatok, m\'e1
sokat pedig meg\'f6ltetek.
\par 88. \'c9s azt mondt\'e1k [a zsid\'f3k]: \'84Burokban van a mi sz\'edv\'fcnk (nem hatja meg Allah szava).\'94 Dehogy! Allah meg\'e1tkozta \'f5ket a hitetlens\'e9g\'fck\'e9rt: ez\'e9rt hisznek oly kev\'e9ss\'e9.
\par }{\insrsid7214487 
\par }{\insrsid8013616 89. \'c9s amikor \'cdr\'e1s j\'f6tt el hozz\'e1juk Allaht\'f3l (a Kor\'e1n), igazolva annak az igazs\'e1g\'e1t, ami a birtokukban van (a T\'f3ra \'e9s az Evang\'e9lium) \endash  noha kor\'e1bban (Mohamed k\'fcldet\'e9se el\'f5tt) gy\'f5
zelemmel fenyegett\'e9k azokat, akik hitetlenn\'e9 v\'e1ltak [Medin\'e1ban] \endash  m\'e9gis miut\'e1n elj\'f6tt hozz\'e1juk az, amit m\'e1r ismertek, akkor nem hittek benne. Allah \'e1tka legyen a hitetleneken!
\par 90. Mily nyomor\'fas\'e1gos \'e1ron adt\'e1k el magukat az\'e1ltal, hogy nem hisznek abban, amit Allah lebocs\'e1tott, irigykedve amiatt, hogy Allah annak bocs\'e1t le kegy\'e9b\'f5l, az \'f5 szolg\'e1i k\'f6z\'fcl, akinek akar. Haragv\'e1st haragv\'e1
sra vontak \'f5k magukra. \'c9s a hitetleneknek megal\'e1z\'f3 gy\'f6trelem j\'e1r.
\par }{\insrsid7214487 
\par }{\insrsid8013616 91. \'c9s amikor azt mondj\'e1k nekik (a zsid\'f3knak): \'84Higgyetek abban, amit Allah lebocs\'e1tott!\'94 \endash  \'f5k azt mondj\'e1k: \'84Mi csak abban hisz\'fcnk, ami hozz\'e1nk lett lebocs\'e1tva.\'94 \'c9s megtagadj\'e1
k azt, ami azut\'e1n j\'f6tt el, mik\'f6zben az az igazs\'e1g, igazolva azt, ami a birtokukban van (a T\'f3ra \'e9s az Evang\'e9lium). Mondd: \'84Akkor mi\'e9rt \'f6lt\'e9tek meg Allah pr\'f3f\'e9t\'e1it kor\'e1bban, ha }{\insrsid2818494 val\'f3ban }{
\insrsid8013616 h\'edv\'f5k vagytok?\'94
\par 92. \'c9s bizony M\'f3zes vil\'e1gos bizony\'edt\'e9kokkal j\'f6tt el hozz\'e1tok, majd a t\'e1voll\'e9t\'e9ben [isten}{\insrsid12912959 etekk\'e9}{\insrsid8013616 ] tett\'e9tek az [arany] borj\'fat \'e9s igazs\'e1gtalanok voltatok}{\insrsid1408158 .}{
\insrsid8013616 
\par 93. \'c9s [eml\'e9kezzetek arra,] amikor sz\'f6vets\'e9get k\'f6t\'f6tt\'fcnk veletek \'e9s felemelt\'fck f\'f6l\'e9tek a [S\'ednai] hegyet [mondv\'e1n:] \'84Ragaszkodjatok er\'f5sen ahhoz, amit adtunk nektek \'e9s hallgassatok arra!\'94 \'d5k azt mondt
\'e1k: \'84Hallottuk \'e9s ellenszeg\'fcl\'fcnk.\'94 \'c9s hitetlens\'e9g\'fck\'e9rt a sz\'edv\'fck \'e1titat\'f3dott a borj\'fa [im\'e1dat\'e1val]. Mondd: \'84Mily nyomor\'fas\'e1gos dolog az, amit a hitetek parancsol nektek, ha [val\'f3ban] h\'edv\'f5
k vagytok}{\insrsid1408158 !}{\insrsid8013616 \'94
\par }{\insrsid7214487 
\par }{\insrsid8013616 94. Mondd: \'84Ha a t\'falvil\'e1gi lakhely Allahn\'e1l (a Paradicsom) minden m\'e1s emberrel szemben kiz\'e1r\'f3lag titeket illet meg, akkor k\'edv\'e1nj\'e1tok a hal\'e1lt, ha }{\insrsid226275 val\'f3ban }{\insrsid8013616 igazmond\'f3
k vagytok!\'94
\par 95. \'c1m soha nem fogj\'e1k k\'edv\'e1nni azt amiatt, amit a kez\'fck elk\'f6vetett. \'c9s Allahnak tudom\'e1sa van az igazs\'e1gtalanokr\'f3l.
\par 96. \'c9s bizony \'fagy tal\'e1lod \'f5ket, hogy minden ember k\'f6z\'fcl \'f5k ragaszkodnak legjobban az \'e9lethez \endash  [m\'e9g] azokn\'e1l is jobban, akik [Allah mell\'e9] t\'e1rs}{\insrsid8013616\charrsid8923927 istent \'e1ll\'edtanak}{
\insrsid8013616 . Mindegyik\'fck azt szeretn\'e9, ha ezer esztendeig \'e9lhetne, \'e1m ha annyi ideig \'e9lne is, az sem tartan\'e1 t\'e1vol \'f5t a [meg\'e9rdemelt] gy\'f6trelemt\'f5l. \'c9s Allah l\'e1tja mindazt, amit cselekszenek.
\par }{\insrsid7214487 
\par }{\insrsid8013616 97. Mondd (\'d3 Mohamed): }{\insrsid1408158 \'84}{\insrsid8013616 Aki ellens\'e9ge G\'e1brielnek, h\'e1t bizony \'f5 hozta le [a Kor\'e1nt] Allah engedelm\'e9vel a sz\'edvedbe, igazolva annak az igazs\'e1g\'e1t, ami el\'f5tte volt (a T
\'f3ra \'e9s az Evang\'e9lium), \'fatmutat\'e1sk\'e9nt \'e9s \'f6r\'f6mh\'edrk\'e9nt a h\'edv\'f5knek.
\par 98. Aki ellens\'e9ge Allahnak, az angyalainak, a k\'fcld\'f6tteinek, G\'e1brielnek \'e9s Mik\'e1elnek, h\'e1t Allah is ellens\'e9ge a hitetleneknek.}{\insrsid1408158 \'94}{\insrsid8013616 
\par }{\insrsid7214487 
\par }{\insrsid8013616 99. Bizony}{\insrsid1408158 ,}{\insrsid8013616  vil\'e1gos jeleket bocs\'e1tottunk le hozz\'e1d, \'e9s csup\'e1n az engedetlenek v\'e1lnak hitetlenn\'e9 vele szemben.
\par 100. Vajon valah\'e1nyszor csak egyezs\'e9get k\'f6t\'f6ttek, nem haj\'edtotta-e el (szegte-e meg) }{\insrsid1408158\charrsid11404096 azt}{\insrsid1408158  }{\insrsid8013616 egy csoport k\'f6z\'fcl\'fck? De a legt\'f6bbj\'fck nem hisz.
\par 101. \'c9s amikor egy k\'fcld\'f6tt (Mohamed) j\'f6tt el hozz\'e1juk Allaht\'f3l, igazolva annak az igazs\'e1g\'e1t, ami a birtokukban van (a T\'f3ra \'e9s az Evang\'e9lium), akkor egy csoport azok k\'f6z\'fcl, akiknek az \'cdr\'e1s adatott, a h\'e1ta m
\'f6g\'e9 haj\'edtotta Allah \'cdr\'e1s\'e1t, mintha nem rendelkezn\'e9nek tud\'e1ssal.
\par }{\insrsid7214487 
\par }{\insrsid8013616 102. \'c9s azt k\'f6vett\'e9k, amit a s\'e1t\'e1nok terjesztettek Salamon kir\'e1lyi uralma alatt. Nem Salamon v\'e1lt hitetlenn\'e9, hanem a s\'e1t\'e1nok v\'e1ltak hitetlenn\'e9, [az\'e1ltal, hogy] megtan\'edtj\'e1k az embereknek a var
\'e1zsl\'e1st. \'c9s azt [k\'f6vett\'e9k], ami a k\'e9t angyalnak, }{\i\insrsid8013616 H\'e1r\'fat}{\insrsid8013616 nak \'e9s }{\i\insrsid8013616 M\'e1r\'fat}{\insrsid8013616 nak bocs\'e1tatott le B\'e1belben. \'c1m \'f5k ketten csak \'fagy tan\'ed
tottak valakit, hogy el\'f5bb azt mondt\'e1k: \'84Bizony, mi csup\'e1n k\'eds\'e9rt\'e9s vagyunk. Ne v\'e1lj h\'e1t hitetlenn\'e9!\'94 \'c9s [az emberek] megtanult\'e1k kettej\'fckt\'f5l azt, amivel sz\'e9tv\'e1lasztj\'e1k az embert a h\'e1zast\'e1rs\'e1t
\'f3l. \'c1m nem tudnak \'e1rtani ezzel senkinek sem, csak Allah engedelm\'e9vel. Olyasmit tanultak, ami \'e1rt nekik, \'e9s nem v\'e1lik hasznukra. \'c9s bizony tudt\'e1k, hogy aki ilyesmit (var\'e1zsl\'e1st) v\'e1s\'e1rol, annak a t\'falvil\'e1
gon nem lesz semmilyen r\'e9szesed\'e9se. Milyen nyomor\'fas\'e1gos \'e1ron adt\'e1k el magukat! B\'e1rcsak rendelkeztek volna tud\'e1ssal!
\par 103. \'c9s hogyha hittek volna \'e9s istenf\'e9l\'f5k lettek volna, akkor bizony [megbizonyosodtak volna arr\'f3l, hogy] jobb az Allaht\'f3l sz\'e1rmaz\'f3 jutalom. B\'e1rcsak rendelkeztek volna tud\'e1ssal!
\par }{\insrsid7214487 
\par }{\insrsid8013616 104. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne mondj\'e1tok azt [a Pr\'f3f\'e9t\'e1nak], hogy \'84R\'e1ina!\'94 (adj id\'f5t, hogy meg\'e9rts\'fck \'e9s ostob\'e1
t is jelent), hanem azt, hogy \'84Unzurna!\'94 (adj id\'f5t, hogy meg\'e9rts\'fck), \'e9s hallgassatok r\'e1! \'c9s a hitetleneknek f\'e1jdalmas gy\'f6trelem j\'e1r.
\par 105. Azok, akik nem hisznek az \'cdr\'e1s n\'e9pe k\'f6z\'fcl \'e9s akik [Allah mell\'e9] t\'e1rsistent \'e1ll\'edtanak, nem szeretn\'e9k azt, hogy b\'e1rmif\'e9le j\'f3 bocs\'e1ttasson le nektek az Uratokt\'f3l. Allah azonban azt t\'fcnteti ki k\'f6ny
\'f6r\'fclet\'e9vel, akit akar. \'c9s Allah\'e9 a hatalmas kegy.
\par }{\insrsid7214487 
\par }{\insrsid8013616 106. Ha egy jelet (Kor\'e1n-id\'e9zetet) elt\'f6rl\'fcnk, vagy elfeledtet\'fcnk, akkor egy ann\'e1l jobbat, vagy hozz\'e1 hasonl\'f3t hozunk. Vajon nem tudod, hogy Allah minden dologra kiterjed\'f5 hatalm\'fa?
\par 107. Vajon nem tudod, hogy Allah\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett, \'e9s hogy Allahon k\'edv\'fcl nincs se p\'e1rtfog\'f3tok, se seg\'edt\'f5t\'f6k?
\par 108. Vagy olyat akartok k\'e9rni a ti k\'fcld\'f6ttetekt\'f5l (Mohamedt\'f5l), mint amit M\'f3zest\'f5l k\'e9rtek kor\'e1bban [hogy saj\'e1t szem\'fckkel l\'e1thass\'e1k Allahot]? Aki hitetlens\'e9gre cser\'e9li el a hitet, az imm\'e1r elt\'e9
velyedett az egyenes \'fatt\'f3l.
\par }{\insrsid7214487 
\par }{\insrsid8013616 109. Az \'cdr\'e1s n\'e9pe k\'f6z\'fcl sokan szeretn\'e9k, ha visszat\'e9r\'edthetn\'e9nek titeket a hitetlens\'e9ghez miut\'e1n h\'edv\'f5k lettetek, magukb\'f3l t\'e1madt irigys\'e9gb\'f5l, miut\'e1n vil\'e1goss\'e1 v\'e1lt el\'f5tt
\'fck az igazs\'e1g (az, hogy Mohamed Allah k\'fcld\'f6tte). N\'e9zz\'e9tek h\'e1t el [nekik] \'e9s hagyjatok fel [a b\'fcntet\'e9s\'fckkel], am\'edg Allah el nem hozza parancs\'e1t}{\insrsid7353460 !}{\insrsid8013616  Bizony Allah minden dologra kiterjed
\'f5 hatalm\'fa.
\par 110. \'c9s tarts\'e1tok meg az im\'e1dkoz\'e1st \'e9s adj\'e1tok meg a k\'f6telez\'f5 adom\'e1nyt}{\insrsid7353460 !}{\insrsid8013616  B\'e1rmi j\'f3t el\'f5re k\'fcldt\'f6k magatoknak [az evil\'e1gon], azt megtal\'e1lj\'e1tok [majd] Allahn\'e1
l. Bizony Allah l\'e1tja mindazt, amit cselekszetek.
\par }{\insrsid7214487 
\par }{\insrsid8013616 111. \'c9s [a zsid\'f3k, illetve a kereszt\'e9nyek] azt mondt\'e1k: \'84Nem l\'e9phet be a Paradicsomba m\'e1s, csak az, aki zsid\'f3, illetve kereszt\'e9ny}{\insrsid7353460 .}{\insrsid8013616 \'94 Ezek az \'f5 v\'e1gy\'e1lmaik. Mondd: 
\'84Adj\'e1tok ide a bizony\'edt\'e9kotokat, ha val\'f3ban igazmond\'f3k vagytok!}{\insrsid7353460 \'94}{\insrsid8013616 
\par 112. De igen! }{\insrsid8013616\charrsid7353460 Aki al\'e1veti arc\'e1t }{\insrsid12611241\charrsid7353460 (}{\insrsid7353460\charrsid7353460 \'f6n}{\insrsid8013616\charrsid7353460 mag\'e1t}{\insrsid12611241\charrsid7353460 )}{
\insrsid8013616\charrsid7353460  Allahnak \'e9s }{\insrsid12611241\charrsid7353460 j\'f3tev\'f5}{\insrsid8013616 , annak meglesz a jutalma Ur\'e1n\'e1l. Nem lesz \'farr\'e1 rajtuk a f\'e9lelem [a T\'falvil\'e1gon], \'e9s nem fognak szomorkodni.
\par }{\insrsid7214487 
\par }{\insrsid8013616 113. \'c9s a zsid\'f3k azt mondt\'e1k: \'84A kereszt\'e9nyek nem rendelkeznek semmivel sem [az igaz hitb\'f5l].\'94 \'c9s a kereszt\'e9nyek azt mondt\'e1k: \'84A zsid\'f3k nem rendelkeznek semmivel sem [az igaz hitb\'f5l]\'94 \endash 
 mik\'f6zben mindannyian recit\'e1lj\'e1k az \'cdr\'e1st. Az \'f5 szavaikhoz hasonl\'f3t mondtak azok, akik nem rendelkeznek tud\'e1ssal. Allah azonban \'edt\'e9lkezni fog k\'f6z\'f6tt\'fck a Felt\'e1mad\'e1s Napj\'e1n abban (a vall\'e1s \'fcgy\'e9
ben), amiben \'f6sszek\'fcl\'f6nb\'f6ztek.
\par }{\insrsid7214487 
\par }{\insrsid8013616 114. \'c9s ki lehet igazs\'e1gtalanabb ann\'e1l, mint aki megakad\'e1lyozza, hogy Allah mecseteiben az \'d5 nev\'e9t eml\'edts\'e9k, \'e9s igyekszik azok lerombol\'e1s\'e1ra? \'d5k nem l\'e9phetnek be oda (a mecsetekbe), csak f\'e9
lelemmel eltelve. Az evil\'e1gon megsz\'e9gyen\'edt\'e9s j\'e1r nekik, a t\'falvil\'e1gon pedig hatalmas gy\'f6trelemben lesz r\'e9sz\'fck.
\par 115. Allah\'e9 a Napkelet \'e9s a Napnyugat, \'e9s ahov\'e1 csak fordultok, Allah arca ott van. Bizony Allah [mindent] \'c1tfog\'f3, Mindentud\'f3.
\par }{\insrsid7214487 
\par }{\insrsid8013616 116. \'c9s azt mondj\'e1k: \'84Allah gyermek\'e9v\'e9 tett [valakit].\'94 Magasztaltass\'e9k! Dehogy! Az \'d6v\'e9 minden, ami az egekben \'e9s ami a f\'f6ld\'f6n van. Minden [teremtm\'e9ny] al\'e1zatosan engedelmeskedik Neki.
\par 117. \'d5 az egek \'e9s a f\'f6ld l\'e9trehoz\'f3ja, \'e9s amikor elrendel egy dolgot, akkor csup\'e1n azt mondja annak: \'84Legy\'e9l!\'94, \'e9s az van.
\par 118. \'c9s azt mondj\'e1k azok, akik nem rendelkeznek tud\'e1ssal: \'84Mi\'e9rt nem sz\'f3l Allah hozz\'e1nk [szem\'e9lyesen], vagy mi\'e9rt nem j\'f6n hozz\'e1nk valami jel? Az \'f5 szavaikhoz hasonl\'f3t mondtak azok is, akik el\'f5tt\'fck \'e9
ltek. Egyforma a sz\'edv\'fck [a meg\'e1talkodotts\'e1gban]. Vil\'e1goss\'e1 tett\'fck m\'e1r a jeleket egy olyan n\'e9pnek, akik teljes bizonyoss\'e1ggal hisznek.
\par 119. Bizony elk\'fcldt\'fcnk t\'e9ged [\'f3 Mohamed] az igazs\'e1ggal, mint \'f6r\'f6mh\'edr-hoz\'f3t [a h\'edv\'f5knek, arr\'f3l hogy a Paradicsomba ker\'fclnek] \'e9s figyelmeztet\'f5t [a hitetleneknek arr\'f3l, hogy a Pokol-t\'fbzbe ker\'fclnek]. \'c9
s nem leszel megk\'e9rdezve a Pokol lak\'f3ir\'f3l.
\par }{\insrsid7214487 
\par }{\insrsid8013616 120. \'c9s nem lesznek el\'e9gedettek veled a zsid\'f3k, sem a kereszt\'e9nyek, am\'edg nem az \'f5 vall\'e1sukat k\'f6veted. Mondd [\'f3 Mohamed]: Allah \'fatmutat\'e1sa az [igaz]}{\i\insrsid8013616  }{\insrsid8013616 \'fatmutat\'e1s. 
\'c9s ha k\'f6vetn\'e9d az \'f5 k\'e9ny\'fcket mindazon tud\'e1st k\'f6vet\'f5en, ami Allaht\'f3l j\'f6tt el hozz\'e1d, akkor bizony Allahhal szemben nem lenne p\'e1rtfog\'f3d, sem seg\'edt\'f5d.
\par 121. Akiknek adtuk az \'cdr\'e1st, [\'e9s] \'fagy recit\'e1lj\'e1k, ahogyan recit\'e1lni kell (k\'f6vetik tan\'edt\'e1sait), azok hisznek benne. Akik azonban nem hisznek benne, azok}{\insrsid417847  bizony}{\insrsid8013616  a vesztesek.
\par }{\insrsid7214487 
\par }{\insrsid8013616 122. \'d3, Izrael fiai! Eml\'e9kezzetek a j\'f3t\'e9tem\'e9nyemre, amellyel megaj\'e1nd\'e9koztalak benneteket, \'e9s arra, hogy [kor\'e1bban}{\insrsid8013616\charrsid9130633 ] el\'f5nyben}{\insrsid8013616  r\'e9szes\'ed
tettelek titeket a [hajdan \'e9lt] teremtm\'e9nyekkel szemben [az emberek k\'f6z\'fcl]!
\par 123. \'c9s \'f3vj\'e1tok magatokat egy olyan nap [b\'fcntet\'e9s\'e9t\'f5l], amikor egy ember sem tehet semmit a m\'e1sik\'e9rt, v\'e1lts\'e1got sem vesznek \'e1t t\'f5le, \'e9s nem haszn\'e1l neki k\'f6zbenj\'e1r\'e1s, \'e9s nem lesznek megseg\'edtve}{
\insrsid14949795 !}{\insrsid8013616 
\par }{\insrsid7214487 
\par }{\insrsid8013616 124. \'c9s [}{\insrsid13257502\charrsid13257502 eml\'edtsd}{\insrsid13257502  meg}{\insrsid8013616 ,] amikor szavakkal (el\'f5\'edr\'e1sokkal) tette pr\'f3b\'e1ra \'c1brah\'e1mot az \'f5 Ura, s [\'c1brah\'e1m] teljes\'edtette azokat}{
\insrsid13257502 !}{\insrsid8013616  [Allah] azt mondta: \'84El\'f6lj\'e1r\'f3v\'e1 teszlek t\'e9ged az emberek sz\'e1m\'e1ra [az\'e9rt, hogy t\'e9ged k\'f6vessenek].\'94 [\'c1brah\'e1m] azt k\'e9rte: \'84\'c9s az ut\'f3daim k\'f6z\'fcl is [legyen el\'f6
lj\'e1r\'f3]!\'94 [Allah] azt mondta: \'84Az egyezs\'e9gemet nem kapj\'e1k meg az igazs\'e1gtalanok.\'94
\par 125. \'c9s [}{\insrsid13257502 eml\'edtsd meg}{\insrsid8013616 ,] hogy a H\'e1zat (a K\'e1ba szent\'e9lyt Mekk\'e1ban) az emberek sz\'e1m\'e1ra l\'e1togat\'e1si c\'e9ll\'e1 \'e9s biztons\'e1g hely\'e9v\'e9 tett\'fck}{\insrsid13257502 !}{\insrsid8013616  
\'c9s tegy\'e9tek \'c1brah\'e1m \'e1ll\'f3hely\'e9t imahelly\'e9! \'c9s meghagytuk \'c1brah\'e1mnak \'e9s Izmaelnek, hogy \'84Tiszt\'edts\'e1tok meg a H\'e1zamat a k\'f6rbej\'e1r\'e1st elv\'e9gz\'f5knek, \'e9s azoknak, akik ott [hosszasan] tart\'f3
zkodnak (i\rquote tik\'e1fot v\'e9geznek), \'e9s a meghajol\'f3knak \'e9s a leborul\'f3knak (im\'e1dkoz\'f3knak)!\'94
\par 126. \'c9s [}{\insrsid13257502 eml\'edtsd meg}{\insrsid8013616 ,] amikor \'c1brah\'e1m azt mondta: \'84Uram! Tedd ezt a helys\'e9get (Mekk\'e1t) biztons\'e1gos helys\'e9gg\'e9 \'e9s l\'e1sd el a lak\'f3it [k\'fcl\'f6nb\'f6z\'f5] term\'e9sekkel \endash 
 azokat, akik hisznek k\'f6z\'fcl\'fck Allahban \'e9s az Utols\'f3 napban!\'94 [Allah] azt mondta: \'84\'c9s akik nem hisznek, [ell\'e1tom] azokat, \'e1m [csak] r\'f6vid ideig r\'e9szes\'edtem \'e9lvezetben, azut\'e1n a [Pokol-]t\'fbz gy\'f6trelm\'e9be k
\'e9nyszer\'edtem \'f5ket. Milyen nyomor\'fas\'e1gos v\'e9gc\'e9l!\'94
\par 127. \'c9s [}{\insrsid13257502 eml\'edtsd meg}{\insrsid8013616 ,] amikor \'c1brah\'e1m \'e9s Izmael felemelt\'e9k a H\'e1z alapjait (a K\'e1ba szent\'e9lyt Mekk\'e1ban) [ekk\'e9ppen foh\'e1szkodva:] \'84Urunk! Fogadd el t\'f5l\'fcnk [ezt a szolg\'e1
latot]! Bizony Te vagy a Mindent Hall\'f3 \'e9s a Mindentud\'f3.
\par 128. Urunk! T\'e9gy minket olyanokk\'e1, akik al\'e1vetik magukat Neked, \'e9s a lesz\'e1rmazottainkat olyan k\'f6z\'f6ss\'e9gg\'e9, amely al\'e1veti mag\'e1t Neked! Mutasd meg nek\'fcnk a szertart\'e1sainkat [a Haddzsal \'e9s az Umr\'e1
val kapcsolatban], s engesztel\'f5dj ki ir\'e1ntunk! Bizony Te vagy a Kiengesztel\'f5d\'f5, az Irgalmas.
\par 129. Urunk! \'c9s t\'e1massz k\'f6z\'f6tt\'fck egy k\'f6z\'fcl\'fck val\'f3 k\'fcld\'f6ttet, aki recit\'e1lja nekik a jeleidet (a szavaidat), megtan\'edtja nekik az \'cdr\'e1st (a Kor\'e1nt) \'e9s a b\'f6lcsess\'e9get (a t\'f6rv\'e9ny rejtelmeit), \'e9
s megtiszt\'edtja \'f5ket}{\insrsid13257502 !}{\insrsid8013616  Bizony Te vagy a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.\'94
\par }{\insrsid7214487 
\par }{\insrsid8013616 130. Ki fordulna el \'c1brah\'e1m vall\'e1s\'e1t\'f3l, ha csak nem az, aki ostob\'e1v\'e1 teszi mag\'e1t? Mi bizony kiv\'e1lasztottuk \'f5t (\'c1brah\'e1mot) az evil\'e1gon, \'e9s bizony \'f5 a t\'falvil\'e1gon a j\'f3 emberek k\'f6z\'e9
 fog tartozni.
\par 131. [}{\insrsid13257502 Eml\'edtsd meg}{\insrsid8013616 ,] amikor Ura azt mondta neki [\'c1brah\'e1mnak]: \'84Vesd al\'e1 magad [nekem]!\'94 Azt mondta: \'84Al\'e1vetettem magam a teremtm\'e9nyek Ur\'e1nak.\'94
\par 132. \'c9s ezt (az Allahnak val\'f3 al\'e1vet\'e9st) hagyta meg \'c1brah\'e1m a fiainak \endash  \'e9s J\'e1kob is \endash  [mondv\'e1n]: \'84Fiaim! Allah kiv\'e1lasztotta nektek }{\insrsid8013616\charrsid13257502 a[z igaz]}{\insrsid8013616  vall\'e1
st. Ne haljatok h\'e1t meg, csakis olyanokk\'e9nt, akik al\'e1vetik magukat [Allahnak]!\'94
\par 133. Vagy tal\'e1n tan\'fai voltatok annak, amikor a hal\'e1l elj\'f6tt J\'e1kob\'e9rt, amikor azt mondta a fiainak: \'84Mit fogtok szolg\'e1lni \'e9n ut\'e1nam?\'94 Azt mondt\'e1k: \'84Szolg\'e1lni fogjuk a te Istenedet \'e9s aty\'e1idnak: \'c1brah\'e1
mnak, Izmaelnek \'e9s Izs\'e1knak Isten\'e9t, az Egyetlen Istent, \'e9s mi Neki (Allahnak) vetj\'fck al\'e1 magunkat.\'94
\par 134. Az a k\'f6z\'f6ss\'e9g m\'e1r elt\'e1vozott [az \'e9l\'f5k sor\'e1b\'f3l]. Az \'f5 r\'e9sz\'fck az lesz, amit \'f5k szereztek, a ti r\'e9szetek pedig az, amit ti szereztetek. \'c9s nem lesztek megk\'e9rdezve arr\'f3l, amit \'f5k cselekedtek.
\par }{\insrsid7214487 
\par }{\insrsid8013616 135. \'c9s azt mondt\'e1k: }{\insrsid13257502 \'84}{\insrsid8013616 Legyetek zsid\'f3k vagy kereszt\'e9nyek, akkor [az igaz] \'fatra leltek.}{\insrsid13257502 \'94}{\insrsid8013616  Mondd [}{\insrsid14250851 \'f3}{\insrsid13257502  }{
\insrsid8013616 Mohamed]: }{\insrsid13257502 \'84}{\insrsid8013616 Dehogy! \'c1brah\'e1m vall\'e1s\'e1t [k\'f6vetj\'fck], aki han\'edf (egyistenh\'edv\'f5, a hamis vall\'e1sokt\'f3l elhajl\'f3) volt, \'e9s nem tartozott azok k\'f6z\'e9, akik [Allah mell
\'e9] t\'e1rsistent \'e1ll\'edtanak.}{\insrsid13257502 \'94}{\insrsid8013616 
\par 136. Mondj\'e1tok [\'f3 muszlimok]: }{\insrsid13257502 \'84}{\insrsid8013616 Hisz\'fcnk Allahban \'e9s abban, ami lebocs\'e1ttatott hozz\'e1nk, s abban, ami lebocs\'e1ttatott \'c1brah\'e1mhoz, Izmaelhez, Izs\'e1khoz, J\'e1kobhoz \'e9s a T\'f6rzsekhez (J
\'e1kob tizenk\'e9t fi\'e1nak lesz\'e1rmazottaihoz), s abban, amit M\'f3zes \'e9s J\'e9zus kapott, \'e9s abban, amit a pr\'f3f\'e9t\'e1k kaptak Urukt\'f3l. Nem tesz\'fcnk k\'fcl\'f6nbs\'e9get egyik\'fck jav\'e1ra sem k\'f6z\'fcl\'fck, \'e9
s mi Neki (Allahnak) vetj\'fck al\'e1 magunkat.}{\insrsid2126331 \'94}{\insrsid8013616 
\par 137. S ha hisznek abban, amiben ti hisztek, akkor val\'f3ban [az igaz] \'fatra leltek. \'c1m ha h\'e1tat ford\'edtanak, akkor \'f5k csup\'e1n ellent\'e9tben vannak. \'c9s elegend\'f5 lesz Allah neked vel\'fck szemben, \'e9s \'d5 a Mindent Hall\'f3
, a Mindentud\'f3.
\par 138. [K\'f6vess\'e9tek] Allah sz\'ednezet\'e9t (vall\'e1s\'e1t)}{\insrsid2126331 !}{\insrsid8013616  \'c9s melyik sz\'ednezet (vall\'e1s) lehet jobb Allah\'e9n\'e1l? S mi \'d5t szolg\'e1ljuk.
\par }{\insrsid7214487 
\par }{\insrsid8013616 139. Mondd [}{\insrsid14250851 \'f3}{\insrsid2126331  }{\insrsid8013616 Mohamed a zsid\'f3knak \'e9s a kereszt\'e9nyeknek]: }{\insrsid2126331 \'84}{\insrsid8013616 Vajon \'e9rvelve sz\'e1lltok vit\'e1ba vel\'fcnk Allahot illet\'f5en, mik
\'f6zben \'d5 a mi Urunk, \'e9s a ti Uratok? A mi cselekedeteink\'e9rt a mi\'e9nk [a felel\'f5ss\'e9g], \'e9s a ti cselekedeteitek\'e9rt pedig ti\'e9tek [a felel\'f5ss\'e9g], \'e9s mi \'f5szinte odaad\'f3ak vagyunk ir\'e1nta [az istenszolg\'e1latban \'e9
s az engedelmess\'e9gben].}{\insrsid2126331 \'94}{\insrsid8013616 
\par 140. Vagy azt mondj\'e1tok: Bizony \'c1brah\'e1m, Izmael, Izs\'e1k, J\'e1kob \'e9s a T\'f6rzsek (J\'e1kob tizenk\'e9t fi\'e1nak lesz\'e1rmazottai) zsid\'f3k vagy kereszt\'e9nyek voltak? Mondd: }{\insrsid2126331 \'84}{\insrsid8013616 Vajon ti tudj\'e1
tok-e jobban, vagy Allah? S ki igazs\'e1gtalanabb ann\'e1l, mint az, aki eltitkol egy n\'e1la l\'e9v\'f5, Allaht\'f3l sz\'e1rmaz\'f3 tan\'fas\'e1got (hogy Mohamed Allah k\'fcld\'f6tte, ahogyan \'edrva van a k\'f6nyveikben)? \'c9
s Allah nem hagyja figyelmen k\'edv\'fcl, amit tesztek.}{\insrsid2126331 \'94}{\insrsid8013616 
\par 141. Az a k\'f6z\'f6ss\'e9g m\'e1r elt\'e1vozott [az \'e9l\'f5k sor\'e1b\'f3l]. Az \'f5 r\'e9sz\'fck az lesz, amit \'f5k szereztek, a ti r\'e9szetek pedig az, amit ti szereztetek. \'c9s nem lesztek megk\'e9rdezve arr\'f3l, amit \'f5k cselekedtek.
\par }{\insrsid7214487 
\par }{\insrsid8013616 142. Az ostob\'e1k az emberek k\'f6z\'fcl azt fogj\'e1k mondani: }{\insrsid2126331 \'84M}{\insrsid8013616 i ford\'edtotta el \'f5ket (a muszlimokat) az imair\'e1nyukt\'f3l, mely fel\'e9 eddig fordultak?}{\insrsid2126331 \'94}{
\insrsid8013616  Mondd [\'f3 Mohamed]: }{\insrsid2126331 \'84}{\insrsid8013616 Allah\'e9 a napkelet \'e9s a napnyugat. \'d5 azt vezet az Egyenes \'datra, akit akar.}{\insrsid2126331 \'94}{\insrsid8013616 
\par 143. \'c9s ekk\'e9ppen tett\'fcnk titeket k\'f6z\'e9p\'faton j\'e1r\'f3 (kiegyens\'falyozott \'e9s igazs\'e1gos) k\'f6z\'f6ss\'e9gg\'e9, hogy tan\'fak legyetek az emberekkel szemben, \'e9s hogy a K\'fcld\'f6tt tan\'fa legyen veletek szemben. S az imair
\'e1nyt, mely fel\'e9 kor\'e1bban fordult\'e1l (Jeruzs\'e1lemet), nem rendelt\'fck el m\'e1s\'e9rt, csup\'e1n az\'e9rt, hogy nyilv\'e1nval\'f3v\'e1 tegy\'fck [az embereknek] azt, amit m\'e1r tudtunk: ki az}{\insrsid11692712 , aki}{\insrsid8013616  k\'f6
veti a K\'fcld\'f6ttet, s ki az, aki sarkon fordul (elhagyja a hit\'e9t). Bizony neh\'e9z dolog ez (az imair\'e1ny megv\'e1ltoz\'e1sa), kiv\'e9ve azok sz\'e1m\'e1ra, akiket Allah [az igaz] \'fatra vezetett. Allah sosem hagyja, hogy k\'e1
rba vesszen a hitetek (a kor\'e1bbi im\'e1itok Jeruzs\'e1lem fel\'e9). Bizony, Allah Egy\'fctt\'e9rz\'f5, Irgalmas.
\par 144. Bizony, gyakran l\'e1tjuk arcod fordul\'e1s\'e1t az \'e9g fel\'e9, s Mi bizony, egy olyan imair\'e1ny fel\'e9 ford\'edtunk t\'e9ged, mellyel el\'e9gedett leszel. Ford\'edtsd h\'e1t arcodat a Tilalmas Mecset fel\'e9 [Mekk\'e1ban]! S b\'e1rhol 
is vagytok, ford\'edts\'e1tok arcotokat fel\'e9je [im\'e1dkoz\'e1skor]! S bizony azok, akiknek az \'cdr\'e1s adatott (a zsid\'f3k \'e9s a kereszt\'e9nyek) tudj\'e1k, hogy ez az igazs\'e1g az \'f5 Urukt\'f3l. \'c9s Allah nem hagyja figyelmen k\'edv\'fc
l, amit }{\insrsid11692712 cselekszenek}{\insrsid8013616 .
\par 145. S ha az \'f6sszes jelet (bizony\'edt\'e9kot) elhozn\'e1d azoknak, akiknek az \'cdr\'e1s adatott, akkor sem k\'f6vetn\'e9k a te imair\'e1nyodat. \'c9s te sem k\'f6veted az \'f5 imair\'e1nyukat, \'e9s \'f5k sem k\'f6vetik egym\'e1s imair\'e1ny\'e1t. 
\'c9s ha k\'f6vetn\'e9d az \'f5 k\'e9ny\'fcket azut\'e1n, ami elj\'f6tt hozz\'e1d a tud\'e1sb\'f3l [Allaht\'f3l], akkor bizony az igazs\'e1gtalanok k\'f6z\'e9 tartozn\'e1l.
\par }{\insrsid6491027 
\par }{\insrsid8013616 146. Azok, akiknek az \'cdr\'e1st adtuk, ismerik \'f5t (Mohamed Pr\'f3f\'e9t\'e1t), ahogyan gyermekeiket ismerik, \'e1m egy csoport k\'f6z\'fcl\'fck eltitkolja az igazs\'e1got, mik\'f6zben rendelkeznek tud\'e1ssal.
\par 147. Az igazs\'e1g a te Uradt\'f3l val\'f3, \'e9s ne tartozz a k\'e9telked\'f5k k\'f6z\'e9}{\insrsid11692712 !}{\insrsid8013616 
\par 148. Mindenkinek van egy ir\'e1nya, mely fel\'e9 fordul. }{\insrsid8013616\charrsid1343483 Igyekezzetek h\'e1t el\'f6l}{\insrsid1343483\charrsid1343483  }{\insrsid8013616\charrsid1343483 j\'e1rni a j\'f3tettekben}{\insrsid8013616 ! Ak\'e1
rhol vagytok is, Allah [hi\'e1nytalanul] \'f6sszegy\'fbjt mindny\'e1jatokat [az \'cdt\'e9let Napj\'e1n]. Bizony, Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 149. \'c9s ak\'e1rhonnan l\'e9psz is ki [utaz\'e1sod alatt], ford\'edtsd arcodat [im\'e1dkoz\'e1skor] a Tilalmas Mecset (Mekka) fel\'e9; s bizony ez az igazs\'e1g az Uradt\'f3l}{\insrsid1343483 !}{\insrsid8013616  \'c9s Allah nem hagyja figyelmen k\'edv
\'fcl, amit cselekszetek.
\par 150. \'c9s ak\'e1rhonnan l\'e9psz is ki, ford\'edtsd arcodat [im\'e1dkoz\'e1skor] a Tilalmas Mecset (Mekka) fel\'e9! \'c9s ak\'e1rhol is vagytok, ford\'edts\'e1tok arcotokat fel\'e9je [im\'e1dkoz\'e1skor] az\'e9rt, hogy ne legyen az embereknek \'e9rv\'fc
k veletek szemben, kiv\'e9ve azokat, akik igazs\'e1gtalanok k\'f6z\'fcl\'fck. Ne t\'f5l\'fck f\'e9ljetek, hanem T\'f5lem! \'c9s az\'e9rt, hogy kiteljes\'edtsem a j\'f3t\'e9tem\'e9nyemet ir\'e1ntatok, \'e9s h\'e1tha [az igaz] \'fatra leltek.
\par }{\insrsid6491027 
\par }{\insrsid8013616 151. Hasonl\'f3k\'e9ppen [a j\'f3t\'e9tem\'e9nyem kiteljes\'edt\'e9sek\'e9nt] k\'fcldt\'fcnk el k\'f6z\'e9tek egy k\'f6z\'fcletek sz\'e1rmaz\'f3 k\'fcld\'f6ttet [Mohamedet], aki recit\'e1lja nektek a jeleinket, \'e9s megtiszt\'ed
t benneteket \'e9s megtan\'edtja nektek az \'cdr\'e1st (a Kor\'e1nt) \'e9s a b\'f6lcsess\'e9get (a t\'f6rv\'e9ny rejtelmeit), \'e9s megtan\'edtja nektek azt, amit eddig nem tudtatok.
\par 152. }{\insrsid8013616\charrsid1343483 Eml\'e9kezzetek h\'e1t R\'e1m (}{\insrsid1343483\charrsid1343483 a }{\insrsid8013616\charrsid1343483 kegyeimre \'e9s }{\insrsid1343483\charrsid1343483 a }{\insrsid8013616\charrsid1343483 parancsaimra), \'c9n is eml
\'e9kezni fogok r\'e1tok [b\'f5s\'e9ges ell\'e1t\'e1ssal}{\insrsid8013616  \'e9s jutalmaz\'e1ssal], \'e9s adjatok h\'e1l\'e1t Nekem, \'e9s ne tagadjatok meg [Engem]}{\insrsid1343483 !}{\insrsid8013616 
\par 153. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Leljetek seg\'edts\'e9gre a t\'fcrelemben \'e9s az im\'e1dkoz\'e1sban! Allah bizony a t\'fcrelmesekkel van.
\par }{\insrsid6491027 
\par }{\insrsid8013616 154. \'c9s ne mondj\'e1tok azokr\'f3l, akik meg\'f6lettek Allah \'fatj\'e1n, hogy halottak! Dehogy, \'e9l\'f5k \'f5k, \'e1m ti nem \'e9rzitek.
\par 155. \'c9s bizony pr\'f3b\'e1ra tesz\'fcnk titeket valamennyi f\'e9lelemmel \'e9s \'e9hs\'e9ggel, \'e9s a vagyon, \'e9s a lelkek \'e9s a term\'e9sek fogyatkoz\'e1s\'e1val, \'e1m adj \'f6r\'f6mh\'edrt a t\'fcrelmeseknek}{\insrsid1343483 !}{\insrsid8013616 

\par 156. Akik, ha valamilyen csap\'e1s s\'fajtja \'f5ket, azt mondj\'e1k: bizony mi Allah\'e9 vagyunk, \'e9s bizony mi Hozz\'e1 t\'e9r\'fcnk vissza}{\insrsid1343483 .}{\insrsid8013616 
\par 157. \'d5k azok, akiken Urukt\'f3l val\'f3 \'e1ld\'e1sok lesznek \'e9s k\'f6ny\'f6r\'fclet, \'e9s \'f5k }{\insrsid6636557 bizony }{\insrsid8013616 azok, akik [az igaz] \'fatra leltek.
\par }{\insrsid6491027 
\par }{\insrsid8013616 158. Bizony, a Szaf\'e1 \'e9s a Marua az Allah \'e1ltal kijel\'f6lt szertart\'e1si [helyek] k\'f6z\'e9 tartoznak. Ha valaki elzar\'e1ndokol a H\'e1zhoz, vagy megl\'e1togatja, azt nem terheli v\'e9ts\'e9g [amiatt, hogy kor\'e1bban ott b
\'e1lv\'e1nyok \'e1lltak], ha elv\'e9gzi a k\'f6z\'f6tt\'fck val\'f3 j\'e1r\'e1st. \'c9s aki \'f6nk\'e9nt tesz j\'f3t, akkor Allah bizony Megh\'e1l\'e1l\'f3, Mindentud\'f3.
\par }{\insrsid6491027 
\par }{\insrsid8013616 159. Bizony, akik eltitkolj\'e1k azt, amit lebocs\'e1tottunk a vil\'e1gos bizony\'edt\'e9kokb\'f3l \'e9s az \'fatmutat\'e1sb\'f3l, miut\'e1n vil\'e1goss\'e1 tett\'fck azt az embereknek az \'cdr\'e1sban, azokat el\'e1tkozza Allah \'e9s el
\'e1tkozz\'e1k \'f5ket az el\'e1tkoz\'f3k.
\par }{\insrsid8013616\charrsid5314282 160.}{\insrsid8013616  Kiv\'e9ve azokat, akik b\'fbnb\'e1natot tan\'fas\'edtanak, \'e9s }{\insrsid5314282 javul\'e1st hoznak}{\insrsid8013616 , \'e9s vil\'e1goss\'e1 teszik [amit eltitkoltak]. \'d5
k azok, akikkel szemben kiengesztel\'f5d\'f6m, hiszen \'c9n vagyok a Kiengesztel\'f5d\'f5, az Irgalmas.
\par 161. Bizony, akik megtagadj\'e1k [a hitet] \'e9s hitetlenk\'e9nt halnak meg, azokon legyen Allah \'e1tka, az angyalok\'e9 \'e9s minden ember\'e9}{\insrsid1343483 !}{\insrsid8013616 
\par 162. \'d6r\'f6kk\'e9 abban (a Pokol-t\'fbzben) fognak maradni, nem enyh\'edttetik sz\'e1mukra a gy\'f6trelem, \'e9s halad\'e9kot sem fognak kapni.
\par }{\insrsid6491027 
\par }{\insrsid8013616 163. \'c9s a ti Istenetek Egyetlen Isten, nincs m\'e1s [jogosan im\'e1dhat\'f3] }{\insrsid8469901 isten}{\insrsid2842080 ,}{\insrsid8013616  csak \'d5, a K\'f6ny\'f6r\'fcletes, az Irgalmas.
\par 164. Bizony, az egek \'e9s a f\'f6ld megteremt\'e9s\'e9ben, \'e9s az \'e9jszaka \'e9s a nappal v\'e1ltakoz\'e1s\'e1ban, \'e9s a haj\'f3kban, melyek a tengeren haladnak azzal, ami hasznos az embereknek, \'e9s abban a v\'edzben (az es\'f5
ben), amit Allah az \'e9gb\'f5l bocs\'e1t le, amellyel \'e9letre keltette a f\'f6ldet, annak hal\'e1la (kisz\'e1rad\'e1sa) ut\'e1n \'e9s azon mindenf\'e9le mozg\'f3 [\'e9l\'f5l\'e9nyt] sz\'f3rt sz\'e9t, \'e9s a szelek ir\'e1ny\'edt\'e1s\'e1ban, \'e9s az 
\'e9g \'e9s a f\'f6ld k\'f6z\'f6tt szolg\'e1latra rendelt felh\'f5kben, [mindezekben] jelek vannak egy olyan n\'e9p sz\'e1m\'e1ra, akik \'e9lnek az esz\'fckkel}{\insrsid1343483 .}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 165. Vannak az emberek k\'f6z\'f6tt olyanok, akik Allahnak vet\'e9lyt\'e1rsakat \'e1ll\'edtanak, \'e9s ugyan\'fagy szeretik azokat, ahogy Allahot szeretik. \'c1m azok, akik hisznek, er\'f5sebb szeretettel vannak Allah ir\'e1nt. \'c9s b
\'e1rcsak l\'e1tn\'e1k azok, akik igazs\'e1gtalanok \endash  amikor megl\'e1tj\'e1k a gy\'f6trelmet \endash  hogy minden er\'f5 Allah\'e9, \'e9s hogy Allah szigor\'fa a gy\'f6trelemmel [s\'fajt\'e1sban].
\par 166. Amikor azok, akiket k\'f6vettek elhat\'e1rol\'f3dnak azokt\'f3l (nem v\'e1llalnak felel\'f5ss\'e9get azok\'e9rt), akik k\'f6vett\'e9k \'f5ket \'e9s l\'e1tj\'e1k [majd] a gy\'f6trelmet, \'e9s szerteszakadnak k\'f6z\'f6tt\'fck a k\'f6tel\'e9kek.
\par 167. \'c9s azt mondj\'e1k a k\'f6vet\'f5k: }{\insrsid8196593 \'84}{\insrsid8013616 \'d3 b\'e1rcsak lenne m\'e9g lehet\'f5s\'e9g\'fcnk a visszat\'e9r\'e9sre [az evil\'e1gba], akkor mi is elhat\'e1roln\'e1nk magunkat t\'f5l\'fck, ahogyan \'f5k elhat\'e1rolt
\'e1k magukat t\'f5l\'fcnk}{\insrsid8196593 !\'94}{\insrsid8013616  Allah ekk\'e9ppen mutatja meg nekik a cselekedeteiket, [amelyek] b\'e1nat forr\'e1s\'e1v\'e1 v\'e1lnak sz\'e1mukra, s \'f5k sohasem fognak kil\'e9pni a [Pokol-]t\'fbzb\'f5l.
\par }{\insrsid6491027 
\par }{\insrsid8013616 168. \'d3 ti}{\insrsid14250851 ,}{\insrsid8013616  emberek! Egyetek mindabb\'f3l, ami a f\'f6ld\'f6n van [ami] megengedett \'e9s j\'f3, \'e9s ne k\'f6vess\'e9tek a s\'e1t\'e1n l\'e9pteit! Bizony \'f5 nyilv\'e1nval\'f3 ellens\'e9getek.

\par 169 Bizony, \'f5 csup\'e1n a rosszat \'e9s a f\'f6rtelmess\'e9get parancsolja meg nektek, \'e9s azt, hogy olyat mondjatok Allahr\'f3l, amit nem tudtok.
\par }{\insrsid6491027 
\par }{\insrsid8013616 170. \'c9s ha azt mondj\'e1k nekik: \'84K\'f6vess\'e9tek azt, amit Allah lebocs\'e1tott!\'94 Azt mondj\'e1k: }{\insrsid8196593 \'84}{\insrsid8013616 Dehogy! Azt k\'f6vetj\'fck, amin aty\'e1inkat tal\'e1ltuk.}{\insrsid8196593 \'94}{
\insrsid8013616  Vajon [k\'f6vetik \'f5ket] akkor is, ha aty\'e1ik nem \'e9ltek az esz\'fckkel semmivel kapcsolatban \'e9s nem leltek [az igaz] \'fatra?
\par 171. Akik hitetlenn\'e9 v\'e1ltak (megtagadj\'e1k Allah egyed\'fclval\'f3s\'e1g\'e1t \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9t), hasonlatosak ahhoz [a p\'e1sztorhoz], aki olyannak ki\'e1lt, mely nem hall semmit, csak h\'edv\'e1st \'e9s sz\'f3l\'edt
\'e1st. S\'fcketek, n\'e9m\'e1k \'e9s vakok, ez\'e9rt nem \'e9ltek az esz\'fckkel.
\par }{\insrsid6491027 
\par }{\insrsid8013616 172. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Egyetek azokb\'f3l a j\'f3 [t\'e1pl\'e1l\'e9kokb\'f3l], amelyekkel ell\'e1ttunk titeket, \'e9s legyetek h\'e1l\'e1
sak Allahnak, ha }{\insrsid14579225 val\'f3ban }{\insrsid8013616 \'d5t szolg\'e1lj\'e1tok!
\par }\pard \qj \fi-30\li30\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin30\itap0\pararsid3161635 {\insrsid8013616 173. Bizony, csup\'e1n az elhullott \'e1llat [h\'fas\'e1t] tette tilalmass\'e1 sz\'e1motokra, \'e9s a v\'e9rt \'e9s a diszn
\'f3h\'fast, \'e9s azt, ami}{\insrsid8196593 t}{\insrsid3301969  [}{\insrsid3161635 a l}{\insrsid3301969 ev\'e1g\'e1skor] Allah helyett [t\'e1rsistennek] }{\insrsid8013616 aj\'e1n}{\insrsid4667191 l}{\insrsid8196593 anak}{\insrsid8013616  fel. \'c1
m, aki r\'e1k\'e9nyszer\'fcl [ezek fogyaszt\'e1s\'e1ra] an\'e9lk\'fcl, hogy v\'e1gyakozna [az engedetlens\'e9gre], vagy t\'falkap\'e1sr}{\insrsid16674381 a vetemedne [ezek fogyaszt\'e1s\'e1ban}{\insrsid8013616 ], azt nem terheli b\'fb
n. Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par }\pard \qj \fi-30\li30\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin30\itap0\pararsid12917982 {\insrsid6491027 
\par }{\insrsid8013616 174. Bizony azok, akik elrejtik azt, amit Allah lebocs\'e1tott az \'cdr\'e1sb\'f3l, \'e9s elk\'f3tyavety\'e9lik azt csek\'e9ly \'e1ron, \'f5k nem t\'f6ltenek m\'e1st [majd] a hasukba, csup\'e1n t\'fczet. Allah nem fog sz\'f3lni hozz\'e1
juk a Felt\'e1mad\'e1s Napj\'e1n, nem tiszt\'edtja meg \'f5ket \'e9s f\'e1jdalmas gy\'f6trelem j\'e1r nekik.
\par 175. \'d5k azok, akik a t\'e9velyg\'e9st v\'e1s\'e1rolt\'e1k meg az \'fatmutat\'e1s\'e9rt cser\'e9be, s a gy\'f6trelmet a megbocs\'e1t\'e1s\'e9rt. Mennyire kitart\'f3ak \'f5k a [Pokol-]t\'fbzzel szemben!
\par 176. Ez [a b\'fcntet\'e9s] az\'e9rt [j\'e1r nekik], mert Allah lebocs\'e1totta az \'cdr\'e1st az igazs\'e1ggal [\'f5k pedig megtagadt\'e1k]. \'c1m azok, akik \'f6sszek\'fcl\'f6nb\'f6ztek az \'cdr\'e1son, azok [az igazs\'e1gt\'f3l] messzemen\'f5 ellent\'e9
tben vannak.
\par }{\insrsid6491027 
\par }{\insrsid8013616 177. Nem az a j\'f3s\'e1g, hogyha arcotokat napkelet \'e9s napnyugat fel\'e9 ford\'edtj\'e1tok, hanem a[z igazi] j\'f3s\'e1g [az\'e9], aki hisz Allahban, az Utols\'f3 Napban, az angyalokban, az \'cdr\'e1sban, a pr\'f3f\'e9t\'e1kban \'e9
s aki odaadja a vagyon\'e1t \endash  b\'e1rmily kedves is az neki \endash  a rokonainak, az \'e1rv\'e1knak, a szeg\'e9nyeknek, az \'faton l\'e9v\'f5knek, azoknak, akik k\'e9rnek \'e9s a rabszolg\'e1k [kiv\'e1lt\'e1s\'e1ra]; \'e9s aki megtartja az im\'e1
dkoz\'e1st, megadja a k\'f6telez\'f5 adom\'e1nyt, \'e9s [amellett azok\'e9] akik betartj\'e1k egyezs\'e9g\'fcket, ha egyezs\'e9get k\'f6t\'f6ttek, \'e9s akik t\'fcrelmesek a nyomor\'fas\'e1gban, a bajban \'e9s a [harci] csa}{\insrsid6491027 p\'e1s idej
\'e9n. \'d5k azok, akik igazat mondtak}{\insrsid8013616  \'e9s \'f5k }{\insrsid14957710 bizony }{\insrsid8013616 az istenf\'e9l\'f5k.
\par }{\insrsid6491027 
\par }{\insrsid8013616 178. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! El\'f5\'edratott nektek a kiegyenl\'edt\'e9s (t\'f6rv\'e9nye) a [sz\'e1nd\'e9kosan] meggyilkoltak eset\'e9
ben: szabadot a szabad\'e9rt, szolg\'e1t a szolg\'e1\'e9rt, n\'f5t a n\'f5\'e9rt. \'c1m ha [a gyilkosnak] megbocs\'e1tanak (az \'e1ldozat hozz\'e1tartoz\'f3i) a hittestv\'e9r\'e9vel kapcsolatban valamit [\'e9let\'e9nek kiolt\'e1s\'e1t a v\'e9rd\'edj\'e9
rt cser\'e9be], akkor m\'e9lt\'e1nyos legyen [a v\'e9rd\'edj] k\'f6vetel\'e9se, a kifizet\'e9s pedig illend\'f5 m\'f3don [t\'f6rt\'e9njen]}{\insrsid5056123 !}{\insrsid8013616  Ez k\'f6nny\'edt\'e9s a ti Uratokt\'f3l \'e9s k\'f6ny\'f6r\'fclet, \'e1
m ha valaki ezut\'e1n t\'falkap\'e1sra vetemedik (gyilkol a v\'e9rd\'edj elfogad\'e1sa ut\'e1n), annak f\'e1jdalmas gy\'f6trelem j\'e1r.
\par 179. S a kiegyenl\'edt\'e9s t\'f6rv\'e9ny\'e9ben \'e9let van sz\'e1motokra, \'f3 \'e9rtelemmel b\'edr\'f3k, h\'e1tha istenf\'e9l\'f5k lesztek.
\par }{\insrsid6491027 
\par }{\insrsid8013616 180. El\'f5\'edratott a sz\'e1motokra \endash  ha elj\'f6n valamelyik\'f5t\'f6k\'e9rt a hal\'e1l, s javakat hagy h\'e1tra \endash  a v\'e9grendelkez\'e9s a sz\'fcl\'f5k \'e9s a rokonok jav\'e1ra [a Sar\'eda \'e1ltal] elismert m\'f3don, k
\'f6teless\'e9gk\'e9nt [\'edratott el\'f5] az istenf\'e9l\'f5k sz\'e1m\'e1ra.
\par 181. Aki pedig megv\'e1ltoztatja, miut\'e1n hallotta (tudom\'e1s\'e1ra jutott), annak [a megv\'e1ltoztat\'e1snak] a v\'e9ts\'e9ge azokat terheli, akik megv\'e1ltoztatj\'e1k (a v\'e9grendeletet). Allah bizony Mindent Hall\'f3, Mindentud\'f3.
\par 182. \'c1m ha valaki a v\'e9grendelkez\'f5 r\'e9sz\'e9r\'f5l [nem sz\'e1nd\'e9kos] r\'e9szrehajl\'e1st\'f3l vagy v\'e9ts\'e9gt\'f5l tart, s egyezs\'e9get k\'f6t k\'f6z\'f6tt\'fck (az \'e9rintettek k\'f6z\'f6tt) [megv\'e1ltoztatva ezzel a v\'e9grendeletet 
\'fagy, hogy az megfeleljen a Sari\'e1nak], azt nem terheli b\'fbn. Bizony Allah Megbocs\'e1t\'f3, Irgalmas.
\par }{\insrsid6491027 
\par }{\insrsid8013616 183. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! El\'f5\'edratott sz\'e1motokra a b\'f6jt\'f6l\'e9s, ahogyan el\'f5\'edratott azok sz\'e1m\'e1ra is, akik el\'f5ttetek 
\'e9ltek, h\'e1tha istenf\'e9l\'f5k lesztek.
\par 184. Meghat\'e1rozott sz\'e1m\'fa napig [\'edratott el\'f5 sz\'e1motokra a b\'f6jt\'f6l\'e9s]; de aki beteg k\'f6z\'fcletek vagy \'faton van, annak m\'e1skor azonos sz\'e1m\'fa napot [kell b\'f6jt\'f6lnie]. S akik k\'e9pesek lenn\'e9nek r\'e1
 [de nem akarnak b\'f6jt\'f6lni], azoknak v\'e1lts\'e1gd\'edjk\'e9nt egy szeg\'e9nyt kell \'e9lelmezni\'fck. Aki pedig \'f6nk\'e9nt tesz j\'f3t, az a maga sz\'e1m\'e1ra j\'f3}{\insrsid5056123 .}{\insrsid8013616  \'c1m jobb nektek az, hogy b\'f6jt\'f6lt
\'f6k, ha val\'f3ban rendelkeztek tud\'e1ssal.
\par 185. [A b\'f6jt\'f6l\'e9s ideje] Ramad\'e1n hava, melyben a Kor\'e1n lebocs\'e1ttatott \'fatmutat\'e1sk\'e9nt az emberis\'e9g sz\'e1m\'e1ra, vil\'e1gos bizony\'edt\'e9kokkal az \'fatmutat\'e1sra \'e9s [az igazs\'e1g \'e9s a hamiss\'e1g k\'f6z\'f6tti] sz
\'e9tv\'e1laszt\'e1sra [vonatkoz\'f3an]. \'c9s aki jelen van [otthon\'e1ban] ebben a h\'f3napban, az b\'f6jt\'f6lje azt v\'e9gig}{\insrsid5056123 !}{\insrsid8013616  Aki pedig beteg vagy \'faton van, annak m\'e1skor azonos sz\'e1m\'fa napot [kell b\'f6jt
\'f6lnie]. Allah a k\'f6nnyebbs\'e9get akarja sz\'e1motokra, nem pedig a neh\'e9zs\'e9get, \'e9s [azt akarja, hogy] tegy\'e9tek teljess\'e9 a [b\'f6jtnapok] sz\'e1m\'e1t, \'e9s Allah nagys\'e1g\'e1t dics\'f5\'edts\'e9tek, ami\'e9rt [az igaz] \'fa
tra vezetett titeket, \'e9s hogy h\'e1l\'e1sak lehessetek.
\par 186. S ha fel\'f5lem k\'e9rdeznek a szolg\'e1im t\'e9ged [\'f3 Mohamed], \'c9n bizony k\'f6zel vagyok [hozz\'e1juk]. Meghallgatom a foh\'e1szkod\'f3 foh\'e1sz\'e1t, amikor [\'f5szint\'e9n] hozz\'e1m foh\'e1szkodik. Engedelmeskedjenek h\'e1t Nekem \'e9
s higgyenek Bennem, h\'e1tha a helyes \'fatra lelnek}{\insrsid5056123 !}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 187. Megengedett\'e9 t\'e9tetett nektek a b\'f6jt \'e9jszak\'e1j\'e1n a h\'e1zas\'e9let asszonyaitokkal. \'d5k olyanok sz\'e1motokra, mint az \'f6lt\'f6z\'e9k, \'e9s ti is olyanok vagytok az \'f5 sz\'e1mukra, mint az \'f6lt\'f6z\'e9
k. Allah tudta, hogy ti kor\'e1bban becsapt\'e1tok magatokat, [azonban] kiengesztel\'f5d\'f6tt ir\'e1ntatok, \'e9s megbocs\'e1tott nektek. Mostant\'f3l \'e9rintkezhettek vel\'fck, \'e9s keress\'e9tek azt, amit Allah elrendelt nektek [a gyermek\'e1ld\'e1sb
\'f3l]}{\insrsid5056123 !}{\insrsid8013616  \'c9s egyetek \'e9s igyatok eg\'e9szen addig, m\'edg megk\'fcl\'f6nb\'f6ztethet\'f5v\'e9 nem v\'e1lik sz\'e1motokra a feh\'e9r sz\'e1l (a hajnal f\'e9nye) a fekete sz\'e1lt\'f3l (az \'e9jszaka s\'f6t\'e9ts\'e9g
\'e9t\'f5l) hajnalhasad\'e1skor, majd tarts\'e1tok be a b\'f6jt\'f6t az \'e9j be\'e1llt\'e1ig (napnyugt\'e1ig)}{\insrsid5056123 !}{\insrsid8013616  \'c9s ne \'e9rintkezzetek vel\'fck (asszonyaitokkal), ha [hosszasan] tart\'f3zkodtok (i\rquote tik\'e1fot v
\'e9geztek) a mecsetekben}{\insrsid5056123 !}{\insrsid8013616  Ezek Allah [\'e1ltal kijel\'f6lt] hat\'e1rok, ne k\'f6zel\'edts\'e9tek meg azokat}{\insrsid5056123 !}{\insrsid8013616  Allah ekk\'e9ppen teszi vil\'e1goss\'e1 a jeleit az emberek sz\'e1m\'e1
ra, h\'e1tha istenf\'e9l\'f5k lesznek.
\par }{\insrsid6491027 
\par }{\insrsid8013616 188. S ne falj\'e1tok fel egym\'e1s k\'f6z\'f6tt vagyonotokat jogtalanul, \'e9s ne vesztegess\'e9tek meg a b\'edr\'f3kat \'e1ltala, [hogy] ez\'e1ltal felfalj\'e1tok b\'fbn\'f6s m\'f3don az emberek vagyon\'e1nak egy r\'e9sz\'e9t, mik\'f6
zben tudj\'e1tok [hogy ez tilalmas sz\'e1motokra]}{\insrsid5056123 !}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 189 K\'e9rdeznek t\'e9ged [\'f3 Mohamed] az \'fajholdakr\'f3l. Mondd: }{\insrsid5056123 \'84E}{\insrsid8013616 zek id\'f5pontjelz\'f5k az emberek \'e9s a zar\'e1ndoklat sz\'e1m\'e1ra.}{\insrsid5056123 \'94}{\insrsid8013616  Nem az a j
\'f3s\'e1g, ha a h\'e1zakba h\'e1tulr\'f3l l\'e9ptek be, hanem a j\'f3s\'e1g az, ha valaki istenf\'e9l\'f5. \'cdgy a h\'e1zakba az ajt\'f3kon l\'e9pjetek be, \'e9s f\'e9lj\'e9tek Allahot, h\'e1tha boldogultok}{\insrsid13917064 !}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 190. \'c9s harcoljatok Allah \'fatj\'e1n (Allah\'e9rt) azok ellen, akik harcolnak ellenetek! \'c1m ne k\'f6vessetek el t\'falkap\'e1st (a harcol\'f3kkal \'e9s a fegyvertelenekkel szemben)}{\insrsid13917064 !}{\insrsid8013616 
 Allah bizony nem szereti az t\'falkap\'e1sokra vetemed\'f5ket [akik megengedett\'e9 teszik azt, amit Allah tilalmass\'e1 tett].
\par 191. \'c9s \'f6lj\'e9tek meg \'f5ket [azokat, akik harcolnak ellenetek], ahol csak r\'e1juk leltek \'e9s \'fbzz\'e9tek ki \'f5ket onnan, ahonnan ki\'fbztek benneteket}{\insrsid13917064 !}{\insrsid8013616  S a k\'eds\'e9rt\'e9s (k\'e9sztet\'e9s a t\'f6
bbistenhitre) s\'falyosabb, mint az \'f6l\'e9s. \'c9s ne kezdem\'e9nyezz\'e9tek ellen\'fck a harcot a [mekkai] Tilalmas Mecsetn\'e9l, am\'edg \'f5k nem harcolnak ellenetek ott}{\insrsid13917064 !}{\insrsid8013616  De ha harcolnak ellenetek [ott], akkor 
\'f6lj\'e9tek meg \'f5ket}{\insrsid13917064 !}{\insrsid8013616  Ilyen a hitetlenek fizets\'e9ge.
\par 192. Ha azonban abbahagyj\'e1k, akkor Allah bizony Megbocs\'e1t\'f3, Irgalmas.
\par 193. \'c9s harcoljatok h\'e1t ellen\'fck, hogy ne legyen k\'eds\'e9rt\'e9s (\'fcld\'f6ztet\'e9s \'e9s a t\'f6bbistenhitre k\'e9nyszer\'edt\'e9s) \'e9s hogy a vall\'e1s (az istenszolg\'e1lat) Allah\'e9 legyen}{\insrsid13917064 !}{\insrsid8013616  \'c1
m ha abbahagyj\'e1k [a hitetlens\'e9get \'e9s a h\'edv\'f5k elleni harcot], akkor ne legyen t\'falkap\'e1s (\'fat a b\'fcntet\'e9shez), csak az igazs\'e1gtalanokkal szemben}{\insrsid13917064 !}{\insrsid8013616 
\par 194. A tilalmas h\'f3nap [megszeg\'e9se harc \'e1ltal] a tilalmas h\'f3nap [hasonl\'f3 megs\'e9rt\'e9s\'e9\'e9rt t\'f6rt\'e9nt]}{\insrsid13917064 .}{\insrsid8013616  A tilalmak [megs\'e9rt\'e9se] a kiegyenl\'edt\'e9s t\'f6rv\'e9nye [al\'e1
 esik]. S ha valaki t\'falkap\'e1sra vetemedik ellenetek, akkor ti is vetemedjetek t\'falkap\'e1sra ellene, ugyanolyan m\'e9rt\'e9kben, ahogyan \'f5k vetemedtek t\'falkap\'e1sra ellenetek}{\insrsid13917064 !}{\insrsid8013616  S f\'e9lj\'e9
tek Allahot, s tudj\'e1tok meg, hogy Allah az istenf\'e9l\'f5kkel van!
\par }{\insrsid6491027 
\par }{\insrsid8013616 195. \'c9s k\'f6ltsetek Allah \'fatj\'e1n, s ne tasz\'edts\'e1tok magatokat saj\'e1t kezetekkel a pusztul\'e1sba! \'c9s helyesen cselekedjetek! Bizony, Allah szereti }{\insrsid8013616\charrsid12190593 a }{
\insrsid4667191\charrsid12190593 j\'f3te}{\insrsid8013616\charrsid12190593 v\'f5ket.}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 196. Teljes\'edts\'e9tek a zar\'e1ndoklatot \'e9s a [mekkai] l\'e1togat\'e1st Allahnak [Mohamed \'fatmutat\'e1sa szerint]! \'c1m ha akad\'e1lyozva vagytok (nem tudj\'e1tok befejezni a szertart\'e1st), akkor olyan \'e1ldozati \'e1
llat [felaj\'e1nl\'e1sa k\'f6telez\'f5 sz\'e1motokra] ami el\'e9rhet\'f5, de ne borotv\'e1lj\'e1tok le a fejeteket [kil\'e9pve ezzel az ihr\'e1m \'e1llapotb\'f3l] addig, m\'edg az \'e1ldozati \'e1llat el nem \'e9ri [a fel\'e1ldoz\'e1si] hely\'e9
t (ott, ahol az akad\'e1lyoztat\'e1s t\'f6rt\'e9nt)}{\insrsid12190593 !}{\insrsid8013616  S ha valaki k\'f6z\'fcletek beteg vagy b\'e1ntalom van a fej\'e9n (ami miatt kor\'e1bban le kell borotv\'e1lnia a haj\'e1t), v\'e1lts\'e1gd\'edjk\'e9nt b\'f6jt\'f6
lnie vagy adakoznia vagy \'e1ldoznia kell. \'c1m ha biztons\'e1gban vagytok, akkor az, aki a [mekkai] l\'e1togat\'e1s ut\'e1n a zar\'e1ndoklat kezdet\'e9ig \'e9lvezi [a mentess\'e9get az ihr\'e1m tilalmai al\'f3l], annak olyan \'e1ldozati \'e1llat [felaj
\'e1nl\'e1sa k\'f6telez\'f5] ami el\'e9rhet\'f5. S aki nem tal\'e1lt [m\'f3dot erre], az b\'f6jt\'f6lj\'f6n h\'e1rom napot a zar\'e1ndoklat alatt, \'e9s hetet, ha visszat\'e9rtetek: ez t\'edz teljes nap, \'e9s ez el\'f5\'edr\'e1s annak, akinek a csal\'e1
dja nem lakik a Tilalmas Mecsetn\'e9l (Mekk\'e1ban).}{\i\insrsid8013616  }{\insrsid8013616 F\'e9lj\'e9tek Allahot, \'e9s tudj\'e1tok meg, hogy Allah szigor\'fa a b\'fcntet\'e9sben}{\insrsid12190593 !}{\insrsid8013616 
\par 197. A zar\'e1ndoklat h\'f3napjai ismertek. S aki ezekben felv\'e1llalta a zar\'e1ndoklatot [\'e9s ihr\'e1m \'e1llapotba l\'e9pett], annak tilos a h\'e1zas\'e9let (}{\i\insrsid8013616 refeth}{\insrsid8013616 ), az engedetlens\'e9g \'e9s a vitatkoz\'e1
s a zar\'e1ndoklat alatt. \'c9s ha b\'e1rmi j\'f3t tesztek, Allah tud r\'f3la. \'c9s l\'e1ss\'e1tok el magatokat \'fatraval\'f3val, \'e1m a legjobb \'fatraval\'f3 az istenf\'e9lelem! \'c9s Engem f\'e9ljetek, \'f3 \'e9rtelemmel b\'edr\'f3k!
\par 198. Nem terhel titeket v\'e9ts\'e9g, ha Uratokt\'f3l sz\'e1rmaz\'f3 kegyet kerestek [az\'e1ltal, hogy kereskedtek a zar\'e1ndoklat ideje alatt]. S ha levonultatok Arafatr\'f3l [napnyugta ut\'e1n], akkor eml\'e9kezzetek meg Allahr\'f3l al-Masar al-Haram-n
\'e1l (Muzdalif\'e1ban)}{\insrsid5199835 !}{\insrsid8013616  S eml\'e9kezzetek meg R\'f3la olyan m\'f3don, amelyre \'d5 vezetett benneteket, s bizony ti azel\'f5tt a t\'e9velyg\'f5k k\'f6z\'e9 tartoztatok!
\par 199. Majd v\'e9gezz\'e9tek el a levonul\'e1st onnan, ahonnan a t\'f6bbi ember v\'e9gzi, s k\'e9rjetek megbocs\'e1t\'e1st Allaht\'f3l! Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 200. S ha elv\'e9gezt\'e9tek a szertart\'e1saitokat, eml\'e9kezzetek meg Allahr\'f3l, ahogyan aty\'e1itokr\'f3l eml\'e9keztetek meg, vagy m\'e9g [ann\'e1l is] er\'f5sebb megeml\'e9kez\'e9ssel}{\insrsid5199835 !}{\insrsid8013616  Vannak az emberek k\'f6z
\'f6tt olyanok, akik azt mondj\'e1k: }{\insrsid5199835 \'84}{\insrsid8013616 Urunk! Adj nek\'fcnk az evil\'e1gon [minden j\'f3b\'f3l]}{\insrsid5199835 \'94}{\insrsid8013616 , \'e1m a t\'falvil\'e1gon nem lesz semmilyen r\'e9szesed\'e9
se (mivel a figyelme csak az evil\'e1gra korl\'e1tozza).
\par 201. \'c9s van k\'f6z\'f6tt\'fck olyan [is], aki azt mondja: }{\insrsid5199835 \'84}{\insrsid8013616 Urunk! Adj nek\'fcnk j\'f3t az evil\'e1gon \'e9s j\'f3t a t\'falvil\'e1gon, \'e9s ments meg minket a [Pokol-] t\'fbz gy\'f6trelm\'e9t\'f5l!}{
\insrsid5199835 \'94}{\insrsid8013616 
\par 202. Ezeknek nagy jutalmuk lesz amiatt, amit megszereztek [a j\'f3tettekb\'f5l]. Bizony, Allah gyors az elsz\'e1moltat\'e1sban.
\par 203. Eml\'e9kezzetek meg Allahr\'f3l meghat\'e1rozott sz\'e1m\'fa napon (az \'c1ldoz\'e1s napj\'e1t k\'f6vet\'f5 h\'e1rom napon), s, aki hamarabb }{\insrsid16473481 \endash  }{\insrsid8013616 k\'e9t nap alatt }{\insrsid16473481 \endash  }{\insrsid8013616 
[v\'e9gzi el], az nem k\'f6vet el v\'e9ts\'e9get, s aki pedig tov\'e1bb marad, az sem k\'f6vet el v\'e9ts\'e9get, ez azokra vonatkozik, akik istenf\'e9l\'f5k. F\'e9lj\'e9tek h\'e1t Allahot, \'e9s tudj\'e1tok meg, hogy \'d5hozz\'e1 lesztek egybegy\'fbjtve}
{\insrsid16473481 !}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 204. Van a [k\'e9pmutat\'f3] emberek k\'f6z\'f6tt olyan, akinek az evil\'e1gi \'e9letr\'f5l val\'f3 besz\'e9de tetszik neked [\'f3 Mohamed], \'e9s Allahot h\'edvja tan\'fanak arra, hogy a sz\'edv\'e9ben [hit] van, holott \'f5 a leg\'e1d
\'e1zabb civakod\'f3.
\par 205. \'c9s amikor h\'e1tat ford\'edt [neked], arra t\'f6rekszik a f\'f6ld\'f6n, hogy roml\'e1st okozzon rajta, \'e9s elpuszt\'edtsa a vet\'e9st \'e9s az \'e1llatszaporulatot. Allah bizony nem szereti a roml\'e1s okoz\'f3it.
\par 206. S amikor azt mondj\'e1k neki: }{\insrsid16473481 \'84}{\insrsid8013616 F\'e9ld Allahot!}{\insrsid16473481 \'94,}{\insrsid8013616  }{\insrsid16473481 a}{\insrsid8013616 kkor a b\'fcszk\'e9lked\'e9se (fennh\'e9j\'e1z\'e1sa) m\'e9g t\'f6bb v\'e9ts\'e9
gre veszi r\'e1. Nos, a Gyehenna el\'e9gs\'e9ges [b\'fcntet\'e9s] lesz sz\'e1m\'e1ra, \'e9s mily nyomor\'fas\'e1gos fekhely!
\par 207. Van az emberek k\'f6z\'f6tt olyan is, aki saj\'e1t mag\'e1t viszi v\'e1s\'e1rra, Allah tetsz\'e9s\'e9t keresv\'e9n, \'e9s Allah Egy\'fctt\'e9rz\'f5 a szolg\'e1ival.
\par }{\insrsid6491027 
\par }{\insrsid8013616 208. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! L\'e9pjetek be az iszl\'e1mba, [felv\'e1llalva azt] teljes eg\'e9sz\'e9ben, \'e9s ne k\'f6vess\'e9tek a s\'e1t\'e1n l
\'e9pteit! Bizony \'f5 nyilv\'e1nval\'f3 ellens\'e9g nektek.
\par 209. \'c1m ha botl\'e1st k\'f6vettetek el azut\'e1n, hogy vil\'e1gos bizony\'edt\'e9kok j\'f6ttek el hozz\'e1tok, akkor tudj\'e1tok meg, hogy Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.
\par 210. Vajon mi m\'e1sra v\'e1rnak, mint hogy elj\'f6jj\'f6n hozz\'e1juk Allah feh\'e9r felh\'f5k \'e1rny\'e9k\'e1nak k\'eds\'e9ret\'e9ben, \'e9s az angyalok (is)? Az \'fcgy [akkor m\'e1r] el lesz d\'f6ntve! \'c9s Allahhoz vitetnek vissza az \'fcgyek (d\'f6
nt\'e9sre)}{\insrsid16473481 .}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 211. K\'e9rdezd meg Izrael fiait, h\'e1nyat adtunk nekik a vil\'e1gos jelekb\'f5l! S aki elcser\'e9li Allah j\'f3t\'e9tem\'e9ny\'e9t (az egyistenhitet hitetlens\'e9gre), miut\'e1n az elj\'f6tt hozz\'e1 [arra s\'falyos b\'fcntet\'e9s v
\'e1r]. Bizony, Allah szigor\'fa a b\'fcntet\'e9sben.
\par 212. D\'edszess\'e9 t\'e9tetett az evil\'e1gi \'e9let azoknak, akik hitetlenn\'e9 v\'e1ltak, \'e9s \'f5k kig\'fanyolj\'e1k azokat, akik hisznek. \'c1m akik istenf\'e9lelmet tan\'fas\'edtanak, azok (rangban) felett\'fck \'e1llnak [majd] a Felt\'e1mad\'e1
s Napj\'e1n. Allah azt l\'e1tja el, akit akar, sz\'e1mad\'e1s n\'e9lk\'fcl.
\par }{\insrsid6491027 
\par }{\insrsid8013616 213. Az emberek egy k\'f6z\'f6ss\'e9get alkottak [majd \'f6sszek\'fcl\'f6nb\'f6ztek], azut\'e1n Allah pr\'f3f\'e9t\'e1kat t\'e1masztott (k\'fcld\'f6tt) \'f6r\'f6mh\'edrhoz\'f3kk\'e9nt \'e9s figyelmeztet\'f5kk\'e9nt, \'e9s lebocs\'e1
totta vel\'fck az \'cdr\'e1st az igazs\'e1ggal, hogy \'edt\'e9lkezzen az emberek k\'f6z\'f6tt abban, amiben \'f6sszek\'fcl\'f6nb\'f6ztek. \'c9s nem k\'fcl\'f6nb\'f6ztek \'f6ssze azon [az \'cdr\'e1son] csup\'e1n azok, akiknek adatott, miut\'e1n elj\'f6
ttek hozz\'e1juk a vil\'e1gos bizony\'edt\'e9kok, az egym\'e1s ir\'e1nti irigys\'e9g miatt. Majd Allah az \'d5 engedelm\'e9vel r\'e1vezette azokat, akik hisznek, arra az igazs\'e1gra, amiben \'f6sszek\'fcl\'f6nb\'f6ztek. \'c9
s Allah bizony azt vezet egyenes \'fatra, akit akar.
\par 214. Vagy azt gondolt\'e1tok, hogy bel\'e9ptek a Paradicsomba, m\'e9g miel\'f5tt hasonl\'f3 [megpr\'f3b\'e1ltat\'e1s] \'e9rne titeket, mint azokat, akik el\'f5ttetek t\'e1voztak el [az \'e9l\'f5k sor\'e1b\'f3l]? Nyomor\'fas\'e1g \'e9s baj \'e9rte \'f5
ket, \'e9s megrend\'fcltek, [olyannyira] hogy a k\'fcld\'f6tt \'e9s a h\'edv\'f5k, akik vele voltak azt mondt\'e1k: }{\insrsid16473481 \'84}{\insrsid8013616 Mikor [j\'f6n el] Allah gy\'f5zelme?}{\insrsid16473481 \'94}{\insrsid8013616  L\'e1
m, bizony Allah gy\'f5zelme k\'f6zel van!
\par }{\insrsid6491027 
\par }{\insrsid8013616 215. K\'e9rdeznek t\'e9ged [\'f3 Mohamed] arr\'f3l, hogy mit adakozzanak. Mondd: }{\insrsid16473481 \'84}{\insrsid8013616 B\'e1rmi j\'f3t adakoztok, az [legyen] a sz\'fcl\'f5k\'e9, a rokonok\'e9, az \'e1rv\'e1k\'e9, a szeg\'e9nyek\'e9, 
\'e9s azok\'e9, akik \'faton vannak. \'c9s b\'e1rmi j\'f3t tesztek, bizony arr\'f3l Allahnak tudom\'e1sa van.}{\insrsid16473481 \'94}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 216. El\'f5\'edratott sz\'e1motokra a harc, holott az ut\'e1latos nektek. Lehet, hogy ut\'e1ltok valamit, noha az j\'f3 nektek; \'e9s lehet, hogy szerettek valamit, noha az rossz nektek. S Allah tudja [mi j\'f3 sz\'e1
motokra], de ti nem tudj\'e1tok.
\par 217. K\'e9rdeznek t\'e9ged a tilalmas h\'f3napr\'f3l, [arr\'f3l, hogy megengedett-e] a harc benne? Mondd: }{\insrsid16473481 \'84}{\insrsid8013616 A harc benne nagy [\'e1th\'e1g\'e1s]. \'c1m t\'e1vol tartani [az embereket] Allah \'fatj\'e1t\'f3
l, megtagadni \'d5t, [a t\'e1vol tart\'e1s] a Tilalmas Mecsett\'f5l, \'e9s n\'e9p\'e9t ki\'fbzni onnan m\'e9g nagyobb [\'e1th\'e1g\'e1s] Allah el\'f5tt. \'c9s a k\'eds\'e9rt\'e9s (a k\'e9nyszer\'edt\'e9s a t\'f6bbistenhitre) s\'falyosabb, mint az \'f6l
\'e9s}{\insrsid8013616\charrsid9773670 .}{\insrsid16473481\charrsid9773670 \'94}{\insrsid8013616  \'c9s nem sz\'fbnnek meg harcolni ellenetek, am\'edg vissza nem t\'e9r\'edtenek vall\'e1sotokr\'f3l, ha k\'e9pesek lenn\'e9nek r\'e1. \'c9s akik visszat\'e9
rnek vall\'e1sukr\'f3l, \'e9s hitetlenk\'e9nt halnak meg, azoknak szertefoszlanak a cselekedeteik}{\insrsid4667191  }{\insrsid4667191\charrsid16473481 az}{\insrsid8013616  evil\'e1gon \'e9s a t\'falvil\'e1gon. S azok a [Pokol-]t\'fbz lak\'f3i lesznek, 
\'f6r\'f6kk\'e9 abban fognak maradni.
\par 218. Bizony, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben], \'e9s akik [vall\'e1suk\'e9rt] kiv\'e1ndoroltak, \'e9s k\'fczd\'f6ttek Allah \'fatj\'e1n, azok Allah k\'f6ny\'f6r\'fclet\'e9t rem\'e9lik. 
\'c9s Allah Megbocs\'e1t\'f3, Irgalmas.
\par }{\insrsid6491027 
\par }{\insrsid8013616 219. K\'e9rdeznek t\'e9ged a szeszes italr\'f3l \'e9s a szerencsej\'e1t\'e9kr\'f3l. Mondd: }{\insrsid16473481 \'84}{\insrsid8013616 Nagy b\'fbn van benn\'fck \'e9s [n\'e9mi] haszon is az emberek sz\'e1m\'e1ra, de a bel\'f5l\'fck fakad
\'f3 b\'fbn nagyobb a hasznukn\'e1l.}{\insrsid16473481 \'94}{\insrsid8013616  S k\'e9rdeznek t\'e9ged arr\'f3l, hogy mit adakozzanak. Mondd: }{\insrsid16473481 \'84}{\insrsid8013616 A felesleget!}{\insrsid16473481 \'94}{\insrsid8013616  Ekk\'e9
ppen teszi vil\'e1goss\'e1 Allah a jeleket, h\'e1tha elgondolkodtok}{\insrsid12264521 .}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 220. }{\insrsid4667191\charrsid16349536 A}{\insrsid8013616\charrsid16349536 z}{\insrsid8013616  evil\'e1gon \'e9s a t\'falvil\'e1gon. \'c9s k\'e9rdeznek t\'e9ged az \'e1rv\'e1kr\'f3l. Mondd: \'84A legjobb a javukra lenni, \'e1
m ha keveredik [vagyonotok] az \'f6v\'e9kkel [ez nem kifog\'e1solhat\'f3] hiszen \'f5k a testv\'e9reitek. Allah tudja ki a roml\'e1st okoz\'f3 (megk\'e1ros\'edt\'f3), \'e9s ki a javul\'e1st hoz\'f3. \'c9s ha Allah akarta volna, akkor bizony neh\'e9
z helyzetbe hozott volna titeket. Bizony, Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.}{\insrsid16349536 \'94}{\insrsid8013616 
\par 221. S ne h\'e1zasodjatok azokkal a n\'f5kkel, akik [Allah mell\'e9] t\'e1rsistent \'e1ll\'edtanak, am\'edg nem hisznek [Allahban egyed\'fcl]! \'c9s bizony egy h\'edv\'f5 rabszolgan\'f5 jobb egy olyan n\'f5n\'e9l, aki [Allah mell\'e9] t\'e1rsistent \'e1ll
\'edt, m\'e9g akkor is, ha tetszik nektek. S ne h\'e1zas\'edts\'e1tok meg azokat a f\'e9rfiakat, akik [Allah mell\'e9] t\'e1rsistent \'e1ll\'edtanak, am\'edg nem hisznek [egyed\'fcl Allahban]! Bizony, egy h\'edv\'f5 rabszolga jobb, mint egy olyan f\'e9
rfi, aki [Allah mell\'e9] t\'e1rsistent \'e1ll\'edt, m\'e9g akkor is, ha tetszik nektek. \'d5k a [Pokol-]t\'fbzh\'f6z h\'edvnak, \'e1m Allah \endash  az engedelm\'e9vel \endash  a Paradicsomhoz \'e9s a megbocs\'e1t\'e1shoz h\'edv \'e9s vil\'e1goss\'e1
 teszi jeleit az embereknek, h\'e1tha okulnak [az int\'e9sb\'f5l].
\par }{\insrsid6491027 
\par }{\insrsid8013616 222. \'c9s k\'e9rdeznek t\'e9ged a havi v\'e9rz\'e9sr\'f5l. Mondd: }{\insrsid16349536 \'84}{\insrsid8013616 Az b\'e1ntalom, tarts\'e1tok magatokat t\'e1vol az asszonyokt\'f3l a havi v\'e9rz\'e9s alatt, \'e9s ne k\'f6zeledjetek hozz\'e1
juk (ne \'e9ljetek vel\'fck h\'e1zas\'e9letet), am\'edg tiszt\'e1v\'e1 nem v\'e1lnak (v\'e9get nem \'e9r a v\'e9rz\'e9s\'fck)}{\insrsid16349536 !}{\insrsid8013616  Majd amikor megtiszt\'e1lkodtak, akkor k\'f6zeledjetek hozz\'e1
juk, ahogyan Allah megparancsolta nektek}{\insrsid16349536 !}{\insrsid8013616  Bizony Allah szereti a b\'fbnb\'e1natot tan\'fas\'edt\'f3kat, \'e9s szereti a megtisztul\'f3kat.}{\insrsid16349536 \'94}{\insrsid8013616 
\par 223. Asszonyaitok sz\'e1nt\'f3f\'f6ld sz\'e1motokra, menjetek h\'e1t a sz\'e1nt\'f3f\'f6ldetekre, ahogyan csak akartok}{\insrsid16349536 !}{\insrsid8013616  \'c9s k\'fcldjetek el\'f5re magatoknak [j\'f3 cselekedetet]! F\'e9lj\'e9tek Allahot, \'e9s tudj
\'e1tok meg, hogy tal\'e1lkozni fogtok Vele! Adj h\'e1t \'f6r\'f6mh\'edrt a h\'edv\'f5knek!
\par }{\insrsid6491027 
\par }{\insrsid8013616 224. Ne tegy\'e9tek esk\'fcitekkel Allahot annak akad\'e1ly\'e1v\'e1, hogy j\'f3s\'e1got tan\'fas\'edtsatok, istenf\'e9l\'f5k legyetek, \'e9s hogy megb\'e9k\'e9l\'e9st k\'f6zvet\'edtsetek az emberek k\'f6z\'f6tt! Allah a Mindent Hall\'f3
, Mindentud\'f3.
\par 225. Allah nem k\'e9ri sz\'e1mon rajtatok a nem sz\'e1nd\'e9kos esk\'fciteket, azonban sz\'e1mon k\'e9ri rajtatok azt, amit a sz\'edvetek szerzett meg (a sz\'e1nd\'e9kos hazugs\'e1got). S Allah a Megbocs\'e1t\'f3, a B\'e9ket\'fbr\'f5.
\par }{\insrsid6491027 
\par }{\insrsid8013616 226. Akik megesk\'fcsznek arra, hogy nem h\'e1lnak egy\'fctt asszonyaikkal, azoknak v\'e1rakozniuk kell n\'e9gy h\'f3napig. \'c1m ha visszat\'e9rnek (a feles\'e9g\'fckh\'f6z a n\'e9gy h\'f3nap letelte el\'f5tt)}{\insrsid16349536 ,}{
\insrsid8013616  }{\insrsid16349536 b}{\insrsid8013616 izony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 227. \'c1m ha elsz\'e1nt\'e1k magukat a v\'e1l\'e1sra, h\'e1t bizony Allah Mindent Hall\'f3, Mindentud\'f3.
\par }{\insrsid6491027 
\par }{\insrsid8013616 228. Az elv\'e1lt n\'f5k h\'e1rom havi v\'e9rz\'e9s [letelt\'e9ig] v\'e1rakozzanak magukra n\'e9zve (miel\'f5tt \'fajrah\'e1zasodn\'e1nak)! S nem megengedett sz\'e1mukra, hogy eltitkolj\'e1k azt, amit Allah a m\'e9h\'fc
kben teremtett, ha hisznek Allahban \'e9s az Utols\'f3 Napban. \'c9s f\'e9rjeiket illeti meg legink\'e1bb az, hogy visszat\'e9rjenek hozz\'e1juk ez alatt, ha jav\'edtani (b\'e9k\'fclni) akarnak. A n\'f5knek ugyanolyan jog j\'e1r [a f\'e9rj\'fck r\'e9sz
\'e9r\'f5l] mint amivel \'f5k tartoznak [a f\'e9rj\'fcknek], hely\'e9nval\'f3 m\'f3don. \'c1m a f\'e9rfiak egy fokkal felett\'fck \'e1llnak [a csal\'e1df\'f5s\'e9g \'e9s a felel\'f5ss\'e9g ter\'e9n]. \'c9s Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.
\par 229. A [visszavonhat\'f3] v\'e1l\'e1s k\'e9tszer [lehets\'e9ges]. Akkor azonban vagy meg kell tartani [a feles\'e9get] hely\'e9nval\'f3 m\'f3don, vagy el kell bocs\'e1tani illend\'f5 m\'f3don. \'c9s [v\'e1l\'e1s eset\'e9n] nem megengedett nektek (f\'e9
rjeknek), hogy b\'e1rmit visszavegyetek abb\'f3l, amit a n\'f5knek adtatok, kiv\'e9ve akkor, ha mindketten f\'e9lnek att\'f3l, hogy nem tudj\'e1k betartani az Allah [\'e1ltal kijel\'f6lt] hat\'e1rokat, \'e9s ha ti [akik k\'e9pviselitek \'f5ket] att\'f3l f
\'e9ltek, hogy nem tartj\'e1k be mindketten az Allah [\'e1ltal kijel\'f6lt] hat\'e1rokat, akkor nem terheli \'f5ket v\'e9ts\'e9g az\'e9rt, hogy a n\'f5 megv\'e1ltja mag\'e1t [a h\'e1zass\'e1g al\'f3l]. Ezek az Allah [\'e1ltal kijel\'f6lt] hat\'e1rok, h
\'e1t ne h\'e1gj\'e1tok \'e1t ezeket! \'c9s akik \'e1th\'e1gj\'e1k az Allah [\'e1ltal kijel\'f6lt] hat\'e1rokat, azok bizony az igazs\'e1gtalanok.}{\insrsid6491027 
\par }{\insrsid8013616 230. \'c1m ha elv\'e1lik t\'f5le [harmadj\'e1ra is], akkor nem megengedett sz\'e1m\'e1ra [hogy \'fajra elvegye feles\'e9g\'fcl], mindaddig, am\'edg valaki m\'e1ssal meg nem h\'e1zasodik. Majd ha az is elv\'e1lik t\'f5
le, akkor nem terheli \'f5ket v\'e9ts\'e9g amiatt, hogy visszat\'e9rnek [egym\'e1shoz], ha \'fagy v\'e9lik, hogy betartj\'e1k az Allah [\'e1ltal kijel\'f6lt] hat\'e1rokat. \'c9s ezek Allah [\'e1ltal kijel\'f6lt] hat\'e1rok, melyeket vil\'e1goss\'e1
 tesz egy olyan n\'e9pnek, akik rendelkeznek tud\'e1ssal.
\par }{\insrsid6491027 
\par }{\insrsid8013616 231. \'c9s ha elv\'e1ltok az asszonyokt\'f3l, \'e9s el\'e9rt\'e9k a [v\'e1rakoz\'e1si] hat\'e1ridej\'fcket, akkor vagy tarts\'e1tok meg \'f5ket hely\'e9nval\'f3 m\'f3don, vagy bocs\'e1ss\'e1tok el \'f5ket hely\'e9nval\'f3 m\'f3don}{
\insrsid16349536 !}{\insrsid8013616  De ne tarts\'e1tok \'f5ket vissza, hogy \'e1rtsatok [nekik] ez\'e1ltal, t\'falkap\'e1sra vetemedve! \'c9s aki ezt megteszi, igazs\'e1gtalans\'e1got k\'f6vet el \'f6nmaga ellen. S ne tegy\'e9tek Allah jeleit (szavait) g
\'fany t\'e1rgy\'e1v\'e1! \'c9s eml\'e9kezzetek Allah j\'f3t\'e9tem\'e9ny\'e9re [amiben] r\'e9szes\'edtett titeket, \'e9s arra, amit lebocs\'e1tott nektek az \'cdr\'e1sb\'f3l \'e9s a b\'f6lcsess\'e9gb\'f5l, amivel int titeket! S f\'e9lj\'e9tek Allahot 
\'e9s tudj\'e1tok meg, hogy Allah minden dologr\'f3l tudom\'e1ssal b\'edr!
\par 232. \'c9s ha elv\'e1ltok az asszonyokt\'f3l, \'e9s el\'e9rt\'e9k a [v\'e1rakoz\'e1si] hat\'e1ridej\'fcket, akkor ne akad\'e1lyozz\'e1tok \'f5ket, hogy [ism\'e9t] megh\'e1zasodjanak [kor\'e1bbi] h\'e1zast\'e1rsaikkal, ha \'f5k hely\'e9nval\'f3 m\'f3
don megegyeznek egym\'e1ssal}{\insrsid5841334 !}{\insrsid8013616  Ez int\'e9s annak, aki hisz k\'f6z\'fcletek Allahban \'e9s az Utols\'f3 Napban. Ez \'e1ld\'e1sosabb sz\'e1motokra \'e9s tiszt\'e1bb. \'c9s Allah tud, de ti nem tudtok.
\par }{\insrsid6491027 
\par }{\insrsid8013616 233. A sz\'fcl\'f5any\'e1k k\'e9t teljes \'e9vig szoptass\'e1k gyermekeiket}{\insrsid5841334 !}{\insrsid8013616  [Ez] arra [vonatkozik] aki teljess\'e9 akarja tenni a szoptat\'e1st. \'c9s a gyermek apj\'e1nak k\'f6teless\'e9ge [a szoptat
\'f3 any\'e1k ir\'e1nt] hely\'e9nval\'f3 m\'f3don ell\'e1tni \'f5ket \'e9s ruh\'e1zatot biztos\'edtani nekik. Senki sem lesz k\'f6telezve t\'f6bbre, mint amire k\'e9pes. Egyetlen sz\'fcl\'f5anya sem k\'e1ros\'edthat\'f3
 a gyermeke miatt, sem az apa a gyermeke miatt. \'c9s az [apa] \'f6r\'f6k\'f6s\'e9nek ugyanaz a k\'f6teless\'e9ge [a szoptat\'f3 any\'e1k ir\'e1nt]. \'c1m ha \'f5k (a sz\'fcl\'f5k) kettej\'fck k\'f6z\'f6tti megegyez\'e9s \'e9s tan\'e1cskoz\'e1s alapj\'e1
n [a meghat\'e1rozott id\'f5 el\'f5tt] el akarj\'e1k v\'e1lasztani [a gyermeket a szoptat\'e1st\'f3l], akkor nem terheli \'f5ket v\'e9ts\'e9g. \'c1m ha gyermekeiteknek szoptat\'f3 dajk\'e1t akartok k\'e9rni, akkor nem terhel titeket v\'e9ts\'e9g, felt\'e9
ve, ha megadj\'e1tok azt (a b\'e9rt), amit oda akartatok adni hely\'e9nval\'f3 m\'f3don. \'c9s f\'e9lj\'e9tek Allahot, s tudj\'e1tok meg, hogy Allah l\'e1tja mindazt, amit cselekszetek}{\insrsid5841334 !}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 234. \'c9s akik elsz\'f3l\'edttatnak (meghalnak) k\'f6z\'fcletek, \'e9s h\'e1trahagynak h\'e1zast\'e1rsakat, [azoknak az asszonyai] v\'e1rakozzanak magukra n\'e9zve n\'e9gy h\'f3napot \'e9s t\'edz napot [miel\'f5tt \'fajrah\'e1zasodn\'e1
nak]}{\insrsid5841334 !}{\insrsid8013616  Majd ha el\'e9rik a hat\'e1ridej\'fcket, akkor ti (a k\'e9pvisel\'f5k) nem k\'f6vettek el v\'e9ts\'e9get az\'e9rt, amit hely\'e9nval\'f3 m\'f3don magukkal tesznek (h\'e1zass\'e1g \'e9rdek\'e9ben). \'c9s Allah j
\'f3l ismeri mindazt, amit cselekszetek.
\par 235. \'c9s nem terhel titeket v\'e9ts\'e9g az\'e1ltal, hogy [v\'e1rakoz\'e1si idej\'fck alatt] c\'e9lz\'e1st tesztek az asszonyok eljegyz\'e9s\'e9re, vagy azt magatokban tartj\'e1tok. Allah tudja, hogy ti meg fogj\'e1tok eml\'edteni \'f5ket, \'e1
m ne tegyetek nekik [h\'e1zass\'e1gi] \'edg\'e9retet titokban, csak ha hely\'e9nval\'f3 besz\'e9det mondotok nekik! \'c9s ne sz\'e1nj\'e1tok el magatokat a h\'e1zass\'e1g megk\'f6t\'e9s\'e9re, m\'edg az \'edr\'e1s [a v\'e1rakoz\'e1si id\'f5szak] el nem 
\'e9ri hat\'e1ridej\'e9t}{\insrsid5841334 !}{\insrsid8013616  S tudj\'e1tok meg, hogy Allah tudja azt, ami}{\insrsid5841334 t}{\insrsid8013616  magatokban rejtetek, \'f3vakodjatok h\'e1t T\'f5le! S tudj\'e1tok meg, hogy Allah Megbocs\'e1t\'f3, B\'e9ket
\'fbr\'f5!
\par 236. Nem terhel titeket v\'e9ts\'e9g, ha elv\'e1ltok az asszonyokt\'f3l, miel\'f5tt \'e9rintett\'e9tek volna \'f5ket, vagy k\'f6telezt\'e9tek volna magatokat jegyaj\'e1nd\'e9k megad\'e1s\'e1ra a r\'e9sz\'fckre. \'c9s hely\'e9nval\'f3 m\'f3don l\'e1ss\'e1
tok el \'f5ket [aj\'e1nd\'e9kkal k\'e1rp\'f3tl\'e1sk\'e9nt], a gazdag a lehet\'f5s\'e9ge szerint, \'e9s a szeg\'e9ny is a lehet\'f5s\'e9ge szerint}{\insrsid5841334 !}{\insrsid8013616  K\'f6teless\'e9g ez a }{\insrsid4667191\charrsid5841334 j\'f3te}{
\insrsid8013616\charrsid5841334 v\'f5k}{\insrsid8013616  sz\'e1m\'e1ra.
\par 237. \'c9s ha elv\'e1ltok t\'f5l\'fck azel\'f5tt, hogy \'e9rintett\'e9tek volna \'f5ket, de m\'e1r k\'f6telezt\'e9tek magatokat jegyaj\'e1nd\'e9k megad\'e1s\'e1ra r\'e9sz\'fckre, akkor [megilleti \'f5ket] annak a fele, amire k\'f6telezt\'e9
tek magatokat, kiv\'e9ve, ha \'f5k lemondanak r\'f3la, vagy lemond r\'f3la az, akinek a kez\'e9ben van a h\'e1zass\'e1g megk\'f6t\'e9se. De ha lemondotok, az k\'f6zelebb van az istenf\'e9lelemhez. S ne feledkezzetek meg arr\'f3l}{\insrsid6515746  [a j\'f3
r\'f3l}{\insrsid8013616 , }{\insrsid6515746 ami] k\'f6ztetek [volt]}{\insrsid5841334 !}{\insrsid8013616  Bizony, Allah l\'e1tja mindazt, amit cselekszetek.
\par }{\insrsid6491027 
\par }{\insrsid8013616 238. Tarts\'e1tok be az im\'e1dkoz\'e1sokat (a napi \'f6t im\'e1t), \'e9s a k\'f6z\'e9ps\'f5 im\'e1dkoz\'e1st, s \'e1lljatok fel Allah el\'f5tt al\'e1zatosan engedelmeskedve!
\par 239. De ha f\'e9ltek [az ellens\'e9gt\'f5l], akkor gyalogosan, vagy lovagolva [im\'e1dkozzatok]}{\insrsid5841334 !}{\insrsid8013616  Majd amikor biztons\'e1gban vagytok, eml\'edts\'e9tek meg Allahot (im\'e1dkozzatok) \'fagy, ahogyan \'d5 tan\'ed
tott benneteket arra, amit nem tudtatok}{\insrsid5841334 !}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 240. \'c9s akik elsz\'f3l\'edttatnak (meghalnak) k\'f6z\'fcletek, \'e9s h\'e1trahagynak h\'e1zast\'e1rsakat, [azok \'edrjanak] v\'e9grendeletet h\'e1zast\'e1rsaik (feles\'e9geik) sz\'e1m\'e1ra ell\'e1t\'e1sr\'f3l [lakhely\'fck\'f6
n maradva] egy \'e9vig kilakoltat\'e1s n\'e9lk\'fcl}{\insrsid5841334 !}{\insrsid8013616  De ha elhagyj\'e1k [lakhely\'fcket], akkor nem terhel titeket v\'e9ts\'e9g azzal, amit \'f5k hely\'e9nval\'f3 m\'f3don tesznek magukkal. \'c9s Allah M\'e9lt\'f3s\'e1
gteljes, B\'f6lcs.
\par 241. \'c9s az elv\'e1lt n\'f5knek hely\'e9nval\'f3 m\'f3don [j\'e1r] ell\'e1t\'e1s, k\'f6teless\'e9g ez az istenf\'e9l\'f5k sz\'e1m\'e1ra.
\par 242. Ekk\'e9ppen teszi vil\'e1goss\'e1 nektek Allah a jeleit, h\'e1tha \'e9ltek az eszetekkel.
\par }{\insrsid6491027 
\par }{\insrsid8013616 243. Vajon nem jutott tudom\'e1sodra [\'f3 Mohamed] azoknak [a h\'edre], akik ezr\'e9vel hagyt\'e1k el lakhelyeiket hal\'e1lt\'f3l val\'f3 f\'e9lelm\'fckben? Majd Allah azt mondta nekik: }{\insrsid5841334 \'84}{\insrsid8013616 
Haljatok meg!}{\insrsid5841334 \'94}{\insrsid8013616  Azut\'e1n \'e9letre keltette \'f5ket. Bizony Allah kegyes az emberek ir\'e1nt, azonban a legt\'f6bb ember nem h\'e1l\'e1s.
\par 244. S harcoljatok Allah \'fatj\'e1n, \'e9s tudj\'e1tok meg, hogy Allah mindent Hall\'f3, Mindentud\'f3}{\insrsid5841334 !}{\insrsid8013616 
\par }\pard \qj \fi-30\li30\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin30\itap0\pararsid3755787 {\insrsid8013616 245. Ki az, aki sz\'e9p k\'f6lcs\'f6nt }{\insrsid3755787 ad}{\f0\insrsid3755787  }{\insrsid3755787\charrsid3307951 
Allahnak (a k\'f6telez\'f5n fel\'fcl ad}{\insrsid3755787 akozik}{\insrsid3755787\charrsid3307951 )}{\insrsid8013616 , hogy \'d5 azt sokszorosan t\'f6bbsz\'f6r\'f6zze meg neki? S Allah van, hogy visszatartja, s van, hogy kiterjeszti [ell\'e1t\'e1s\'e1t]. 
\'c9s Hozz\'e1 lesztek visszavitetve.
\par }\pard \qj \fi-30\li30\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin30\itap0\pararsid12917982 {\insrsid6491027 
\par }{\insrsid8013616 246. Vajon nem jutott tudom\'e1sodra Izrael fiai el\'f5kel\'f5inek [a h\'edre] M\'f3zes ut\'e1n, amikor azt mondt\'e1k egyik pr\'f3f\'e9t\'e1juknak (S\'e1muelnek): }{\insrsid5841334 \'84}{\insrsid8013616 T\'e1massz nek\'fcnk egy kir\'e1
lyt, hogy [vezet\'e9s\'e9vel] Allah \'fatj\'e1n harcoljunk}{\insrsid5841334 !\'94}{\insrsid2380445 ?}{\insrsid8013616  Azt mondta: }{\insrsid5841334 \'84}{\insrsid8013616 Vajon lehets\'e9ges \endash  ha el\'f5\'edratik sz\'e1motokra a harc \endash }{
\insrsid5841334 ,}{\insrsid8013616  hogy nem fogtok harcolni?}{\insrsid5841334 \'94}{\insrsid8013616  Azt mondt\'e1k: }{\insrsid5841334 \'84}{\insrsid8013616 Mi\'e9rt ne harcoln\'e1nk Allah \'fatj\'e1n, holott el\'fbztek minket lakhelyeinkr\'f5l \'e9
s gyermekeinkt\'f5l?}{\insrsid5841334 \'94}{\insrsid8013616  Majd amikor el\'f5\'edratott sz\'e1mukra a harc, akkor elfordultak, kiv\'e9ve n\'e9h\'e1nyan k\'f6z\'fcl\'fck. \'c9s Allahnak tudom\'e1sa van az igazs\'e1gtalanokr\'f3l.
\par }{\insrsid6491027 
\par }{\insrsid8013616 247. S azt mondta nekik a pr\'f3f\'e9t\'e1juk (S\'e1muel): \'84Allah bizony egy kir\'e1lyt t\'e1masztott k\'f6z\'f6ttetek, T\'e1l\'fat-ot (Sault)}{\insrsid2380445 .}{\insrsid8013616 \'94 Azt mondt\'e1k [az el\'f5kel\'f5k]: \'84
Hogyan lehetne kir\'e1lyi uralma felett\'fcnk, holott minket illet meg legink\'e1bb a kir\'e1lyi uralom, \'e9s nem adatott sz\'e1m\'e1ra b\'f5s\'e9ges vagyon?\'94 Azt mondta: \'84Allah bizony f\'f6l\'e9tek v\'e1lasztotta \'f5t, \'e9s gyarap\'edtotta \'f5
t b\'f5s\'e9ggel tud\'e1sban \'e9s termetess\'e9ggel alkatban.\'94 S Allah annak adja az \'f5 kir\'e1lyi uralm\'e1t, akinek akarja. S Allah [mindent] \'c1tfog\'f3, Mindentud\'f3.
\par 248. \'c9s azt mondta nekik a pr\'f3f\'e9t\'e1juk (S\'e1muel): }{\insrsid2380445 \'84}{\insrsid8013616 Bizony, kir\'e1lyi uralm\'e1nak jele az, hogy [ism\'e9t] hozz\'e1tok ker\'fcl a Frigyl\'e1da, amelyben a ti Uratokt\'f3l val\'f3 nyugalom van, \'e9
s erekly\'e9k abb\'f3l, amit M\'f3zes \'e9s \'c1ron nemzets\'e9ge hagyott h\'e1tra, s [ezt] az angyalok hordozz\'e1k. Bizony ebben jel van sz\'e1motokra, ha }{\insrsid14579225 val\'f3ban }{\insrsid8013616 h\'edv\'f5k vagytok.}{\insrsid2380445 \'94}{
\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 249 Majd amikor T\'e1l\'fat (Saul) elvonult a katon\'e1ival, azt mondta: \'84Allah bizony pr\'f3b\'e1ra tesz benneteket egy foly\'f3 \'e1ltal. \'cdgy aki iszik bel\'f5le, az nem tartozik hozz\'e1m, aki pedig meg sem k\'f3stolja, az hozz
\'e1m tartozik \endash  kiv\'e9ve azt, aki a kez\'e9vel egy teny\'e9rnyit mer\'edt bel\'f5le [az nem hib\'e1ztathat\'f3].}{\insrsid2380445 \'94}{\insrsid8013616  \'c9s mindannyian ittak bel\'f5le}{\insrsid2380445 ,}{\insrsid8013616  kiv\'e9ve n\'e9h\'e1
nyan k\'f6z\'fcl\'fck. Majd miut\'e1n \'e1tkelt rajta, \'f5 \'e9s akik vele egy\'fctt h\'edv\'f5k voltak, azt mondt\'e1k: }{\insrsid2380445 \'84}{\insrsid8013616 Nincs ma er\'f5nk G\'f3li\'e1t \'e9s katon\'e1i ellen.}{\insrsid2380445 \'94}{
\insrsid8013616  Azok, akik [teljes bizonyoss\'e1ggal] v\'e9lik azt, hogy tal\'e1lkozni fognak Allahhal azt mondt\'e1k: \'84H\'e1ny kissz\'e1m\'fa csapat aratott m\'e1r gy\'f5zelmet nagysz\'e1m\'fa csapat felett Allah engedelm\'e9vel! \'c9s Allah a t\'fc
relmesekkel van!\'94
\par 250. S miut\'e1n megjelentek (felsorakoztak) G\'f3li\'e1t \'e9s katon\'e1i el\'f5tt, azt mondt\'e1k: }{\insrsid2380445 \'84}{\insrsid8013616 Urunk! Terjessz ki r\'e1nk t\'fcrelmet, szil\'e1rd\'edtsd meg a l\'e1bunkat, \'e9s vigy\'e9l minket gy\'f5
zelemre a hitetlen n\'e9p ellen!}{\insrsid2380445 \'94}{\insrsid8013616 
\par 251. \'cdgy veres\'e9get m\'e9rtek r\'e1juk Allah engedelm\'e9vel, \'e9s meg\'f6lte D\'e1vid G\'f3li\'e1tot, \'e9s Allah neki adta [Saul \'e9s S\'e1muel hal\'e1la ut\'e1n] a kir\'e1lyi uralmat \'e9s a b\'f6lcsess\'e9get (pr\'f3f\'e9tas\'e1got), s megtan
\'edtotta azokra, amikre akarta. \'c9s ha Allah nem tartan\'e1 vissza az embereket, egyik\'fcket a m\'e1sik \'e1ltal, akkor bizony m\'e1r megromlott volna a f\'f6ld. Azonban Allah kegyes a teremtm\'e9nyek ir\'e1nt.
\par 252. Ezek Allah jelei (szavai), melyeket az igazs\'e1gnak megfelel\'f5en recit\'e1lunk el }{\insrsid14250851 neked [\'f3 }{\insrsid8013616\charrsid7100848 Mohamed], \'e9s te bizony a k\'fcld\'f6ttek k\'f6z\'e9 tartozol!}{\insrsid8013616 
\par }{\insrsid6491027 
\par }{\insrsid8013616 253. Ezek a k\'fcld\'f6ttek, egyeseket k\'f6z\'fcl\'fck }{\insrsid8013616\charrsid9130633 el\'f5nyben}{\insrsid8013616  r\'e9szes\'edtett\'fcnk a t\'f6bbiekkel szemben. Vannak k\'f6z\'f6tt\'fck, akikhez Allah besz\'e9lt, \'e9s egyeseket
 k\'f6z\'fcl\'fck t\'f6bb fokozattal feljebb emelt. \'c9s J\'e9zusnak, M\'e1ria fi\'e1nak odaadtuk a vil\'e1gos bizony\'edt\'e9kokat, \'e9s meger\'f5s\'edtett\'fck \'f5t a Szent L\'e9lekkel [G\'e1
briel angyallal]. S ha Allah nem akarta volna, nem harcoltak volna egym\'e1s ellen azok, akik ut\'e1nuk \'e9ltek, miut\'e1n elj\'f6ttek hozz\'e1juk a vil\'e1gos bizony\'edt\'e9kok, de \'f5k \'f6sszek\'fcl\'f6nb\'f6ztek, \'edgy n\'e9h\'e1nyan k\'f6z\'fcl
\'fck hittek, m\'e1sok pedig hitetlenn\'e9 v\'e1ltak. \'c9s ha Allah nem akarta volna, nem harcoltak volna egym\'e1ssal, \'e1m Allah azt teszi, amit akar.
\par 254. \'d3 ti, akik hisztek}{\insrsid4667191  }{\insrsid4667191\charrsid7100848 [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]!}{\insrsid8013616  Adakozzatok abb\'f3l, amivel ell\'e1ttunk titeket, m\'e9g miel\'f5
tt elj\'f6n egy olyan nap, amelyen nem lesz sem ad\'e1s-v\'e9tel, sem bar\'e1ts\'e1g, sem pedig k\'f6zbenj\'e1r\'e1s}{\insrsid7100848 !}{\insrsid8013616  \'c9s val\'f3ban a hitetlenek az igazs\'e1gtalanok.
\par }{\insrsid6491027 
\par }{\insrsid8013616 255. Allah, nincs m\'e1s [jogosan }{\insrsid8013616\charrsid3018534 im\'e1dhat\'f3] }{\insrsid8469901 isten}{\insrsid2842080  }{\insrsid8013616\charrsid10844748 Rajta}{\insrsid8013616  k\'edv\'fcl}{\insrsid10371738 !}{\insrsid8013616 
 Az \'c9l\'f5, a [saj\'e1t mag\'e1t \'e9s minden l\'e9tez\'f5t] Fenntart\'f3. Nem vesz rajta er\'f5t sem szenderg\'e9s, sem \'e1lom. \'d6v\'e9 mindaz, ami az egekben, \'e9s ami a f\'f6ld\'f6n van. Ki az, aki [a Felt\'e1mad\'e1s napj\'e1n] k\'f6zbenj\'e1
rhatna n\'e1la az enged\'e9lye n\'e9lk\'fcl? Tudja mindazt, ami el\'f5tt\'fck van [a j\'f6v\'f5t illet\'f5en], \'e9s mindazt, ami m\'f6g\'f6tt\'fck van [a m\'faltat illet\'f5en], \'e9s nem foghatnak fel semmit a tud\'e1s\'e1b\'f3l, csak azt, amit \'d5
 akar. Sz\'e9ke \'e1tfogja az egeket \'e9s a f\'f6ldet, \'e9s nem terheli meg \'d5t a meg\'f5rz\'e9s\'fck. \'c9s \'d5 a Magass\'e1gos, a Hatalmas.
\par }{\insrsid6491027 
\par }{\insrsid8013616 256. Nincs k\'e9nyszer a Vall\'e1sban! Bizony a helyes \'fat megk\'fcl\'f6nb\'f6ztethet\'f5v\'e9 v\'e1lt a t\'e9velyg\'e9st\'f5l. Aki megtagadja a hamisan isten\'edtetteket (}{\i\insrsid8013616 T\'e1gh\'fat}{\insrsid8013616 ), \'e9
s hisz Allahban, az bizony megragadta a szil\'e1rd kapaszkod\'f3t, mely nem szakad el. S Allah Mindent Hall\'f3, Mindentud\'f3.
\par }{\insrsid6491027 
\par }{\insrsid8013616 257. Allah }{\insrsid6383694 a }{\insrsid8013616 p\'e1rtfog\'f3ja azoknak, akik hisznek, kivezeti \'f5ket a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gekb\'f5l a vil\'e1goss\'e1gra. \'c1m akik nem hisznek, a hamisan isten\'edtettek (}{
\i\insrsid8013616 T\'e1gh\'fat}{\insrsid8013616 ) az \'f5 p\'e1rtfog\'f3ik, kiviszik \'f5ket a vil\'e1goss\'e1gb\'f3l a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gekbe. Azok a [Pokol-]t\'fbz lak\'f3i lesznek, \'f6r\'f6kk\'e9 abban fognak maradni.
\par }{\insrsid6491027 
\par }{\insrsid8013616 258. Vajon nem jutott tudom\'e1sodra annak [a h\'edre], aki \'e9rvelve sz\'e1llt vit\'e1ba \'c1brah\'e1mmal az Ur\'e1t illet\'f5en, mivelhogy Allah neki adta a kir\'e1lyi uralmat? [}{\insrsid6383694 Eml\'edtsd meg}{\insrsid8013616 
] amikor \'c1brah\'e1m azt mondta: }{\insrsid6383694 \'84}{\insrsid8013616 Az \'e9n Uram az, aki \'e9letre kelt, \'e9s hal\'e1lba k\'fcld.}{\insrsid6383694 \'94}{\insrsid8013616  Azt mondta: }{\insrsid6383694 \'84}{\insrsid8013616 \'c9n keltek \'e9letre, 
\'e9s \'e9n k\'fcld\'f6k hal\'e1lba!}{\insrsid6383694 \'94}{\insrsid8013616  Azt mondta \'c1brah\'e1m: }{\insrsid6383694 \'84}{\insrsid8013616 Allah a Napot keletr\'f5l hozza, hozzad te nyugatr\'f3l}{\insrsid6383694 !\'94}{\insrsid8013616 
 Erre a hitetlen megh\'f6kkent. Allah nem vezeti [az igaz] \'fatra az igazs\'e1gtalan n\'e9pet.
\par }{\insrsid6491027 
\par }{\insrsid8013616 259. Vagy (nem jutott tudom\'e1sodra az), aki elhaladt egy telep\'fcl\'e9s (Jeruzs\'e1lem) mellett, amely kihalt \'e9s romokban hevert, s azt mondta: \'84Hogyan kelthetn\'e9 ezt \'e9letre Allah miut\'e1n kihalt?\'94 Allah pedig hal\'e1
lt bocs\'e1tott re\'e1 sz\'e1z \'e9vig. Azut\'e1n felt\'e1masztotta \'f5t, s azt k\'e9rdezte: \'84Mennyi ideig id\'f5zt\'e9l?\'94 Azt mondta: \'84Egy napig id\'f5ztem, vagy a nap egy r\'e9sz\'e9ig\'94. [Allah] azt mondta: \'84Dehogy! Sz\'e1z \'e9vig id
\'f5zt\'e9l. N\'e9zz h\'e1t \'e9lelmedre \'e9s italodra! Nem romlottak meg. \'c9s n\'e9zz a szamaradra (a sz\'e9tsz\'f3rt csontjaira)! \'c9s hogy [int\'f5] jell\'e9 tegy\'fcnk t\'e9ged az emberek sz\'e1m\'e1ra, n\'e9zd a csontokat, hogyan \'e1ll\'edtjuk 
\'f6ssze azokat, \'e9s azt\'e1n felruh\'e1zzuk h\'fassal!\'94 Miut\'e1n mindez vil\'e1goss\'e1 v\'e1lt el\'f5tte, azt mondta: \'84Tudom, hogy Allah minden dologra kiterjed\'f5 hatalm\'fa.\'94
\par }{\insrsid6491027 
\par }{\insrsid8013616 260. S [}{\insrsid6383694 eml\'edtsd meg}{\insrsid8013616 ] amikor \'c1brah\'e1m azt mondta: \'84Uram! Mutasd meg nekem, hogyan kelted \'e9letre a halottakat!\'94 [Allah] azt k\'e9rdezte: \'84H\'e1t vajon nem hiszel?\'94 Azt mondta: \'84
Dehogynem! \'c1m az\'e9rt [k\'e9rem ezt], hogy megnyugodjon a sz\'edvem!\'94 [Allah] azt mondta: \'84V\'e9gy h\'e1t n\'e9gy madarat, gy\'fbjtsd magad el\'e9 [v\'e1gd le \'e9s darabold fel] azokat! Azut\'e1n tegy\'e9l minden hegyre egy-egy darabot bel\'f5l
\'fck, majd h\'edvd azokat, sietve j\'f6nnek hozz\'e1d}{\insrsid6383694 !}{\insrsid8013616  \'c9s tudd meg, hogy Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs}{\insrsid6383694 !}{\insrsid8013616 \'94
\par }{\insrsid6491027 
\par }{\insrsid8013616 261. Akik vagyonukat Allah \'datj\'e1n k\'f6ltik el, azok hasonlatosak egy gabonaszem [\'fcltet\'f5ihez], amely h\'e9t kal\'e1szt hozott, s minden egyes kal\'e1szban sz\'e1z mag van. S Allah [ezt] megt\'f6bbsz\'f6r\'f6
zi annak, akinek akarja. \'c9s Allah [mindent] \'c1tfog\'f3, Mindentud\'f3.
\par 262. Akik vagyonukat Allah \'fatj\'e1n k\'f6ltik el, majd azt, amit elk\'f6lt\'f6ttek nem k\'f6vetik felh\'e1nytorgat\'e1ssal, sem b\'e1nt\'f3 szavakkal, azoknak a jutalma az Urukn\'e1l van. Nem lesz \'farr\'e1 rajtuk a f\'e9lelem, \'e9
s nem fognak szomorkodni.
\par 263. A hely\'e9nval\'f3 besz\'e9d \'e9s a megbocs\'e1t\'e1s jobb az olyan adom\'e1nyn\'e1l, amelyet b\'e1nt\'e1s k\'f6vet. Allah Gazdag, B\'e9ket\'fbr\'f5.
\par 264. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne tegy\'e9tek semmiv\'e9 az adom\'e1nyaitokat a felh\'e1nytorgat\'e1s \'e9s a b\'e1nt\'e1s \'e1ltal, [ez olyan] mint, aki az\'e9rt k\'f6
lti vagyon\'e1t, hogy l\'e1ss\'e1k az emberek, \'e9s nem is hisz Allahban \'e9s az Utols\'f3 Napban}{\insrsid6383694 !}{\insrsid8013616  \'c9s hasonlatos \'f5 a sima szikl\'e1hoz, amelyen kev\'e9s por van, s b\'f5s\'e9ges es\'f5 \'e9
ri, majd csupaszon hagyja. Nincs hatalmuk semmi felett abb\'f3l}{\insrsid6383694 ,}{\insrsid8013616  amit [az evil\'e1gon] szereztek, \'e9s Allah nem vezeti [az igaz] \'fatra a hitetlen n\'e9pet.
\par }{\insrsid6491027 
\par }{\insrsid8013616 265. Akik Allah megel\'e9ged\'e9s\'e9t keresve, \'e9s a lelk\'fckb\'f5l j\'f6v\'f5 bizonyoss\'e1gb\'f3l fakad\'f3an adakozz\'e1k vagyonukat, azok hasonlatosak egy dombon fekv\'f5 kerthez, amelyet b\'f5s\'e9ges es\'f5 \'e9r, s ez\'e9rt k
\'e9tszeres term\'e9st hoz, \'e1m ha nem \'e9ri b\'f5s\'e9ges es\'f5, [legal\'e1bb] enyhe es\'f5 [\'e9ri]. S Allah l\'e1tja mindazt, amit cselekszetek.
\par 266. Vajon szeretn\'e9-e valaki k\'f6z\'fcletek, hogy datolyap\'e1lm\'e1kb\'f3l \'e9s sz\'f5l\'f5kb\'f5l legyen kertje, amely alatt foly\'f3k folynak, s amelyben mindenf\'e9le term\'e9s van sz\'e1m\'e1ra, \'e9s el\'e9ri \'f5t az \'f6regs\'e9g, \'e9s ut
\'f3dai [m\'e9g] gyeng\'e9k, majd ezt a [kertet] t\'fczes forg\'f3sz\'e9l s\'fajtja, amelyt\'f5l el\'e9g? Ekk\'e9ppen teszi vil\'e1goss\'e1 Allah nektek a jeleket, h\'e1tha elgondolkodtok.
\par }{\insrsid6491027 
\par }{\insrsid8013616 267. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Adakozzatok azokb\'f3l a j\'f3 dolgokb\'f3l, amiket szereztetek, \'e9s abb\'f3l amit sarjasztottunk nektek a f\'f6ldb
\'f5l! \'c9s ne a hitv\'e1nyat sz\'e1nj\'e1tok arra, hogy eladakozz\'e1tok, mik\'f6zben ti magatok sem venn\'e9tek el, csak \'fagy, ha behunyj\'e1tok a szemeteket}{\insrsid14050431 !}{\insrsid8013616  S tudj\'e1tok meg, hogy Allah Gazdag, Dics\'e9retrem
\'e9lt\'f3}{\insrsid14050431 !}{\insrsid8013616 
\par 268. A s\'e1t\'e1n a nincstelens\'e9get \'edg\'e9ri nektek [ha adakoztok], \'e9s a f\'f6rtelmess\'e9get parancsolja meg nektek. \'c1m Allah T\'f5le sz\'e1rmaz\'f3 megbocs\'e1t\'e1st \'e9s kegyet \'edg\'e9r nektek. \'c9s Allah [mindent] \'c1tfog\'f3
, Mindentud\'f3.
\par 269. \'d5 annak adja a b\'f6lcsess\'e9get, akinek akarja. S akinek a b\'f6lcsess\'e9g megadatik, az bizony sok j\'f3ban r\'e9szes\'fcl. \'c1m csakis az \'e9rtelemmel b\'edr\'f3k veszik ezt int\'e9snek.
\par }{\insrsid6491027 
\par }{\insrsid8013616 270. S ha b\'e1rmilyen adom\'e1nyt adtok, vagy b\'e1rmilyen fogadalmat fogadtok, Allah tud r\'f3la. S az igazs\'e1gtalanoknak nem lesznek seg\'edt\'f5ik.
\par 271. Ha nyilv\'e1noss\'e1 teszitek az adom\'e1nyokat, az dics\'e9retes dolog. \'c1m ha titokban tartj\'e1tok, \'e9s a nincsteleneknek adj\'e1tok, akkor az jobb nektek. \'c9s elt\'f6r\'f6l nektek valamennyit a rossz tetteitekb\'f5l. \'c9s Allah j\'f3
l ismeri mindazt, amit cselekszetek.
\par }{\insrsid6491027 
\par }{\insrsid8013616 272. Nem r\'e1d tartozik [\'f3 Mohamed] a vezet\'e9s\'fck, hanem Allah vezeti [az igaz] \'fatra azt, akit akar. \'c9s b\'e1rmi j\'f3t adakoztok, az }{\insrsid14050431 a }{\insrsid8013616 magatok haszn\'e1ra v\'e1lik, \'e9s [a h\'edv\'f5
k] nem adakoznak, csak \'fagy, hogy Allah arc\'e1t (megel\'e9ged\'e9s\'e9t) keresik \'e1ltala. \'c9s ami j\'f3t adakoztok, teljes m\'e9rt\'e9kben visszakapj\'e1tok, \'e9s nem szenvedtek igazs\'e1gtalans\'e1got.
\par 273. [Az adom\'e1nyotok] a nincsteleneket illeti, akik akad\'e1lyoztatva vannak Allah \'datj\'e1n, nem tudnak utazni a f\'f6ld\'f6n [a keresked\'e9s vagy munka c\'e9lj\'e1b\'f3l], a tudatlan pedig gazdagoknak gondolja \'f5ket az\'e9rt, mert megtart\'f3
ztatj\'e1k magukat [\'e9s nem koldulnak]. Felismered \'f5ket a jellemvon\'e1sukr\'f3l, nem k\'e9rnek az emberekt\'f5l tolakod\'f3 m\'f3don. \'c9s ami j\'f3t adakoztok, bizony Allahnak tudom\'e1sa van r\'f3la.}{\insrsid6491027 
\par }{\insrsid8013616 274. Akik [Allah \'fatj\'e1n] k\'f6ltik el vagyonukat \'e9jjel \'e9s nappal, titkon \'e9s ny\'edltan, azoknak a jutalma az Urukn\'e1l van, \'e9s nem lesz \'farr\'e1 rajtuk a f\'e9lelem [a T\'falvil\'e1gon], \'e9s nem fognak szomorkodni.

\par }{\insrsid6491027 
\par }{\insrsid8013616 275. Akik felfalj\'e1k (szedik \'e9s felhaszn\'e1lj\'e1k) a kamatot, azok nem t\'e1madnak fel (az \'cdt\'e9let napon) csak \'fagy, mint az, akit a s\'e1t\'e1n \'f6ssze-vissza r\'e1ngat az \'e9rint\'e9s\'e9vel. Ez az\'e9
rt van, mert azt mondt\'e1k: }{\insrsid14050431 \'84}{\insrsid8013616 Bizony, az ad\'e1sv\'e9tel csup\'e1n olyan, mint a kamat.}{\insrsid14050431 \'94}{\insrsid8013616  \'c1m Allah megengedte az ad\'e1sv\'e9telt, \'e9s tilalmass\'e1 tette a kamatot. Ez
\'e9rt akihez Ur\'e1t\'f3l int\'e9s j\'f6tt el (a kamattilt\'e1sr\'f3l), \'e9s abbahagyta [a kamatszed\'e9st], azt megilleti az, amit kor\'e1bban szerzett, \'e9s az \'f5 \'fcgye Allahra tartozik. \'c1m akik visszat\'e9rnek [a kamatszed\'e9
shez], azok a [Pokol-]t\'fbz lak\'f3i lesznek, \'f6r\'f6kk\'e9 abban fognak maradni.
\par 276. Allah megsemmis\'edti a kamatot, de gyarap\'edtja az adom\'e1nyokat. S Allah nem szeret egyetlen meg\'e1talkodottan hitetlent, b\'fbn\'f6st sem.
\par }{\insrsid6491027 
\par }{\insrsid8013616 277. Bizony, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben], \'e9s j\'f3tetteket cselekszenek, megtartj\'e1k az im\'e1dkoz\'e1st, \'e9s megadj\'e1k a k\'f6telez\'f5 adom\'e1nyt, az 
\'f5 jutalmuk az Urukn\'e1l van. Nem lesz \'farr\'e1 rajtuk a f\'e9lelem [a T\'falvil\'e1gon], \'e9s nem fognak szomorkodni.
\par 278. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! F\'e9lj\'e9tek Allahot \'e9s engedj\'e9tek el azt, ami megmaradt a kamatb\'f3l, ha val\'f3ban h\'edv\'f5k vagytok!
\par 279. S ha nem teszitek meg, akkor tudj\'e1tok meg, hogy Allah \'e9s }{\insrsid14050431 a K}{\insrsid8013616 \'fcld\'f6tte h\'e1bor\'fat [ind\'edt ellenetek]}{\insrsid14050431 !}{\insrsid8013616  De ha b\'fbnb\'e1natot tan\'fas\'ed
totok, akkor megillet titeket a t\'f5k\'e9tek, nem k\'f6vettek el igazs\'e1gtalans\'e1got, \'e9s ti sem szenvedtek igazs\'e1gtalans\'e1got.
\par 280. \'c1m ha [ad\'f3sotok] szorult helyzetben van, akkor adjatok (neki) halad\'e9kot, am\'edg nem lesz k\'f6nnyebb helyzetben}{\insrsid14050431 !}{\insrsid8013616  Ha adakoztok (elengedtek a tartoz\'e1sb\'f3l), az jobb sz\'e1motokra, ha val\'f3
ban rendelkeztek tud\'e1ssal.
\par 281. \'d3vj\'e1tok magatokat egy olyan nap [b\'fcntet\'e9s\'e9t\'f5l], amikor vissza lesztek vitetve Allahhoz! Majd minden ember [fizets\'e9ge] teljess\'e9 t\'e9tetik az\'e9rt, amit szerzett, \'e9s nem szenvednek el igazs\'e1gtalans\'e1got.
\par }{\insrsid6491027 
\par }{\insrsid14250851 282 \'d3}{\insrsid8013616  ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Amikor megszabott hat\'e1ridej\'fb k\'f6lcs\'f6nr\'f5l szerz\'f5dt\'f6k, akkor \'edrj\'e1tok le! \'c9
s egy \'edrnok \'edrja le igazs\'e1gosan k\'f6z\'f6ttetek}{\insrsid14050431 !}{\insrsid8013616  \'c9s egyetlen \'edrnok se tagadja meg, hogy le\'edrja azt \'fagy, ahogyan Allah megtan\'edtotta neki}{\insrsid14050431 !}{\insrsid8013616  \'cdrjon h\'e1
t (az \'edrnok), \'e9s mondja tollba az, akit a k\'f6lcs\'f6n terhel, \'e9s f\'e9lje Allahot, az Ur\'e1t, \'e9s ne r\'f6vid\'edtsen abb\'f3l (az ad\'f3ss\'e1g\'e1b\'f3l) semmit! \'c1m ha az, akit a k\'f6lcs\'f6n terhel korl\'e1tolt \'e9rtelm\'fb
 vagy gyenge, vagy nincs m\'f3dja arra, hogy tollba mondjon, akkor a p\'e1rtfog\'f3ja (gy\'e1mja) mondjon tollba igazs\'e1gosan}{\insrsid14050431 !}{\insrsid8013616  S k\'e9t tan\'fat k\'e9rjetek fel tan\'fas\'e1gra a f\'e9rfiaitok k\'f6z\'fcl! \'c9s ha 
nincs k\'e9t f\'e9rfi, akkor legyen egy f\'e9rfi \'e9s k\'e9t n\'f5 azok k\'f6z\'fcl, akiket elfogadtok tan\'fakk\'e9nt, az\'e9rt hogy ha }{\insrsid679737 a }{\insrsid8013616 k\'e9t n\'f5 k\'f6z\'fcl az egyik t\'e9vedne, akkor a m\'e1sik eml\'e9keztesse 
\'f5t}{\insrsid679737 !}{\insrsid8013616  \'c9s a tan\'fak pedig ne utas\'edts\'e1k vissza, amikor [tan\'fas\'e1gra] h\'edvatnak}{\insrsid679737 !}{\insrsid8013616  \'c9s ne tarts\'e1tok f\'e1raszt\'f3nak le\'edrni azt (az ad\'f3ss\'e1
got), [legyen az] kev\'e9s, avagy sok, a hat\'e1ridej\'e9vel [egy\'fctt]}{\insrsid679737 !}{\insrsid8013616  Ez \'edgy igazs\'e1gosabb Allah el\'f5tt, \'e9s egyenesebb (szil\'e1rdabb bizony\'edt\'e9kk\'e9nt) a tan\'fas\'e1got illet\'f5en, \'e9s k\'f6
zelebb van ahhoz, hogy ne k\'e9telkedjetek. Azonban, ha helyben t\'f6rt\'e9n\'f5 keresked\'e9sr\'f5l van sz\'f3, melyet egym\'e1s k\'f6z\'f6tt folytattok (azonnali kifizet\'e9ssel), akkor nem terhel titeket v\'e9ts\'e9g, ha nem \'edrj\'e1tok le. \'c1
m legyenek jelen tan\'fak, amikor ad\'e1sv\'e9telt v\'e9geztek! Sem \'edrnok, sem tan\'fa ne \'e1rtson (\'e9s \'e1rtalmat se szenvedjen)! \'c1m ha [m\'e9gis] megteszitek, akkor ez engedetlens\'e9g r\'e9szetekr\'f5l, f\'e9lj\'e9tek h\'e1t Allahot, \'e9
s Allah megtan\'edt titeket}{\insrsid679737 !}{\insrsid8013616  \'c9s Allah minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 283. \'c9s ha \'faton vagytok, \'e9s nem tal\'e1ltok \'edrnokot, akkor k\'e9zbe adott z\'e1logot [adjatok]}{\insrsid3883706 !}{\insrsid8013616  \'c1m ha megb\'edztok egym\'e1sban, akkor az, akiben megb\'edztak, teljes\'edtse a bel\'e9
 vetett bizalmat (adja vissza ad\'f3ss\'e1g\'e1t), \'e9s f\'e9lje Allahot, az Ur\'e1t! Ne titkolj\'e1tok el a tan\'fas\'e1got! Aki eltitkolja, annak b\'fbn\'f6s a sz\'edve. \'c9s Allahnak tudom\'e1sa van arr\'f3l, amit cselekszetek.
\par }{\insrsid6491027 
\par }{\insrsid8013616 284. Allah\'e9 mindaz, ami az egekben \'e9s ami a f\'f6ld\'f6n van. Ak\'e1r felfeditek azt, ami magatokban van, ak\'e1r elrejtitek, Allah elsz\'e1moltat \'e9rte titeket. Megbocs\'e1t annak, akinek akar, \'e9s gy\'f6trelemben r\'e9szes
\'edti azt, akit akar. S Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 285. A K\'fcld\'f6tt (Mohamed) hisz abban, ami lebocs\'e1ttatott hozz\'e1 az Ur\'e1t\'f3l, s a h\'edv\'f5k (is), mindegyik\'fck hisz Allahban, az angyalaiban, az \'cdr\'e1saiban, \'e9s a k\'fcld\'f6tteiben. (A h\'edv\'f5k azt mondj\'e1k:) }{
\insrsid3883706 \'84}{\insrsid8013616 Nem tesz\'fcnk k\'fcl\'f6nbs\'e9get a k\'fcld\'f6ttei k\'f6z\'f6tt!}{\insrsid3883706 \'94}{\insrsid8013616  S azt mondj\'e1k: }{\insrsid3883706 \'84}{\insrsid8013616 Hallottuk, s engedelmesked\'fcnk! Bocs\'e1
ss meg nek\'fcnk Urunk, \'e9s N\'e1lad lesz a v\'e9gc\'e9l!}{\insrsid3883706 \'94}{\insrsid8013616 
\par 286. Allah egyetlen embert sem k\'f6telez t\'f6bbre, mint amennyire k\'e9pes. \'d6v\'e9 }{\insrsid3883706 (az ember\'e9) }{\insrsid8013616 az, amit megszerzett [a j\'f3 cselekedetekb\'f5l], \'e9s ellene van az, amire szert tett [a rossz tettekb\'f5
l]. Urunk! Ne k\'e9rj minket sz\'e1mon, ha elfeledkezt\'fcnk vagy t\'e9vedt\'fcnk! Urunk! Ne helyezz r\'e1nk olyan s\'falyos terhet, mint amilyet azokra helyezt\'e9l, akik el\'f5tt\'fcnk \'e9ltek! Urunk! \'c9
s ne terhelj meg minket azzal, amire nem vagyunk k\'e9pesek! L\'e9gy eln\'e9z\'f5 vel\'fcnk, bocs\'e1ss meg nek\'fcnk \'e9s k\'f6ny\'f6r\'fclj rajtunk! Te vagy a p\'e1rtfog\'f3nk, vigy\'e9l h\'e1t minket gy\'f5zelemre a hitetlen n\'e9p ellen!}{
\insrsid12068078 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\insrsid14643188 
\par 
\par 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid14643188 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\f0\fs24\insrsid14643188\charrsid14643188 \page 3. Imr\'e1n nemzets\'e9ge (\'c1li Imr\'e1n) c. sz\'fara
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid14643188\charrsid14643188 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.}{\cf1\insrsid14643188\charrsid14643188 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\cf1\insrsid14643188\charrsid14643188 1. Alif-l\'e1m-m\'edm
\par 2. Allah, nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, csak \'d5. Az \'c9l\'f5, a [saj\'e1t mag\'e1t \'e9s minden l\'e9tez\'f5t] Fenntart\'f3.
\par 3. Lebocs\'e1totta hozz\'e1d [\'f3 Mohamed] az \'cdr\'e1st (a Kor\'e1nt) az igazs\'e1ggal, igazolva annak az igazs\'e1g\'e1t, ami el\'f5tte volt, \'e9s lebocs\'e1totta a T\'f3r\'e1t \'e9s az Evang\'e9liumot
\par 4. Kor\'e1bban, \'fatmutat\'e1sk\'e9nt az embereknek, \'e9s lebocs\'e1totta }{\insrsid14643188\charrsid14643188 a[z igazs\'e1g \'e9s a hamiss\'e1g k\'f6z\'f6tti] Sz\'e9tv\'e1laszt\'f3t.}{\cf1\insrsid14643188\charrsid14643188  Bizony, akik hitetlenn\'e9 v
\'e1ltak Allah jeleivel szemben, azoknak szigor\'fa gy\'f6trelem j\'e1r, \'e9s Allah }{\insrsid14643188\charrsid14643188 M\'e9lt\'f3s\'e1gteljes}{\cf1\insrsid14643188\charrsid14643188 , az el\'e9gt\'e9tel Birtokosa.
\par 5. Bizony Allah el\'f5tt nincsen elrejtve semmi, sem a f\'f6ld\'f6n, sem az \'e9gben.
\par 6. \'d5 az, aki megform\'e1z titeket az anyam\'e9hben, ahogy akarja. Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, csak \'d5, a }{\insrsid14643188\charrsid14643188 M\'e9lt\'f3s\'e1gteljes}{\cf1\insrsid14643188\charrsid14643188 , a B\'f6lcs.}{
\insrsid14643188\charrsid14643188 
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\insrsid14643188\charrsid14643188 7. \'d5 az, aki lebocs\'e1totta neked az \'cdr\'e1st. Vannak benne egy\'e9rtelm\'fb
 jelek (Kor\'e1n-id\'e9zetek) \endash  ezek [adj\'e1k] az \'cdr\'e1s alapjait \endash  m\'e1sok pedig t\'f6bb\'e9rtelm\'fbek. Azok, akiknek sz\'edv\'e9ben ferdes\'e9g lakozik, azt k\'f6vetik, ami t\'f6bb\'e9rtelm\'fb bel\'f5le, a k\'eds\'e9rt\'e9st (k\'e9
tely kelt\'e9st), \'e9s [a maguk sz\'e1ja \'edze szerinti] \'e9rtelmez\'e9s\'e9t keresve, \'e9s annak \'e9rtelmez\'e9s\'e9t nem tudja m\'e1s, csak Allah. \'c9s a tud\'e1sban szil\'e1rdak, azt mondj\'e1k: \'84Hisz\'fcnk benne, mind Urunkt\'f3l val\'f3!\'94
 \'c1m csakis az \'e9rtelemmel b\'edr\'f3k okulnak [ebb\'f5l].
\par 
\par 8. Urunk! Ne ferd\'edtsd el sz\'edv\'fcnket [az igazs\'e1gr\'f3l], miut\'e1n [az igaz] \'fatra vezett\'e9l minket! \'c9s aj\'e1nd\'e9kozz meg minket t\'f5led val\'f3 k\'f6ny\'f6r\'fclettel, bizony te vagy a Megaj\'e1nd\'e9koz\'f3!
\par 9. Urunk! Bizony te gy\'fbjt\'f6d \'f6ssze az embereket egy olyan Napra, amelyhez nem f\'e9r k\'e9ts\'e9g. Allah bizony nem szegi meg az \'edg\'e9ret\'e9t.
\par 
\par 10. Bizony, akik hitetlenn\'e9 v\'e1ltak, azoknak semmit sem haszn\'e1l majd a vagyonuk, sem a gyermekeik Allahhal szemben, \'e9s \'f5k }{\insrsid5725369 bizony }{\insrsid14643188\charrsid14643188 azok, akik a [Pokol-]t\'fbz t\'fczel\'f5je lesznek.
\par 11. [A hozz\'e1\'e1ll\'e1suk] olyan, mint a F\'e1ra\'f3 n\'e9p\'e9nek hozz\'e1\'e1ll\'e1sa, \'e9s azok\'e9, akik el\'f5tt\'fck \'e9ltek. Meghazudtolt\'e1k a jeleinket, Allah pedig elragadta \'f5ket a b\'fbneik miatt. Allah szigor\'fa a b\'fcntet\'e9sben.

\par 12. Mondd [\'f3 Mohamed] azoknak, akik hitetlenn\'e9 v\'e1ltak: \'84Gy\'f5zelmet fognak aratni felettetek, \'e9s a Gyehenn\'e1ba lesztek egybegy\'fbjtve, \'e9s mily nyomor\'fas\'e1gos fekhely az!\'94
\par 13. Bizony jel volt sz\'e1motokra a k\'e9t seregben, amelyek \'f6sszecsaptak. Az egyik sereg Allah \'fatj\'e1n harcolt, m\'edg a m\'e1sik hitetlen volt, \'fagy l\'e1tt\'e1k [a h\'edv\'f5k], hogy a m\'e1sik sereg szeml\'e1tom\'e1st k\'e9
tszer akkora, mint az \'f6v\'e9k. \'c9s Allah azt t\'e1mogatja meg gy\'f5zelm\'e9vel, akit akar. Bizony, ebben tanuls\'e1g van az \'e9les megl\'e1t\'e1ssal b\'edr\'f3knak.
\par 
\par 14. D\'edszess\'e9 t\'e9tetett az emberek sz\'e1m\'e1ra, hogy szeress\'e9k [mindazt, amire] a v\'e1gyak [ir\'e1nyulnak]: a n\'f5ket, a gyermekeket, a tem\'e9rdek halomnyi arany- \'e9s ez\'fcst vagyont, a megjel\'f6lt (teliv\'e9r) lovakat, a j\'f3sz\'e1
gokat \'e9s a vet\'e9st. Ez az evil\'e1gi \'e9let [muland\'f3] \'e9lvezete, \'e1m Allahn\'e1l sz\'e9p helye van a visszat\'e9r\'e9snek!
\par 15. Mondd [\'f3 Mohamed]: \'84Adjak-e h\'edrt nektek arr\'f3l, ami jobb ezekn\'e9l? Az istenf\'e9l\'f5knek az Urukn\'e1l kertjeik lesznek [a Paradicsomban], amelyek alatt foly\'f3k folynak, \'f6r\'f6kk\'e9 abban fognak maradni, tiszt\'e1v\'e1 tett h\'e1
zast\'e1rsaik lesznek, \'e9s el\'e9gedetts\'e9g Allaht\'f3l. \'c9s Allah belel\'e1t a szolg\'e1iba.\'94
\par 16. Akik azt mondj\'e1k: \'84Urunk! Bizony, mi hisz\'fcnk, bocs\'e1sd h\'e1t meg nek\'fcnk a b\'fbneinket, \'e9s \'f3vj meg minket a [Pokol-]t\'fbz gy\'f6trelm\'e9t\'f5l!\'94
\par 17. [\'d5k] a t\'fcrelmesek, az igazak, az al\'e1zatosan engedelmesked\'f5k, az adakoz\'f3k, \'e9s akik megbocs\'e1t\'e1st k\'e9rnek [Allaht\'f3l] az \'e9jszaka v\'e9g\'e9n.
\par 
\par 18. Allah tan\'fas\'edtja, hogy nincs m\'e1s }{\cf1\insrsid14643188\charrsid14643188 [jogosan im\'e1dhat\'f3] isten,}{\insrsid14643188\charrsid14643188  csak \'d5, \'e9s az angyalok, \'e9s a tud\'e1s birtokosai [is tan\'fas\'edtj\'e1
k ezt]. Fenntartja az igazs\'e1goss\'e1got. Nincs m\'e1s }{\cf1\insrsid14643188\charrsid14643188 [jogosan im\'e1dhat\'f3] isten,}{\insrsid14643188\charrsid14643188  csak \'d5, a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 19. Bizony a[z igaz] vall\'e1s Allah el\'f5tt az iszl\'e1m (al\'e1vet\'e9s Allah akarat\'e1nak). \'c9s akiknek az \'cdr\'e1s adatott, nem k\'fcl\'f6nb\'f6ztek \'f6ssze csup\'e1n azut\'e1n, hogy elj\'f6tt a tud\'e1s hozz\'e1juk, az egym\'e1s ir\'e1nt
i irigys\'e9g miatt. \'c9s aki megtagadja Allah jeleit, h\'e1t [azokkal szemben] Allah bizony gyors az elsz\'e1moltat\'e1sban!
\par 20. Ha \'e9rvelve sz\'e1llnak vit\'e1ba veled, akkor mondd: \'84Al\'e1vetettem arcomat (magamat) Allahnak, \'e9s azok [is], akik k\'f6vetnek engem\'94. \'c9s mondd azoknak, akiknek az \'cdr\'e1s adatott, \'e9s az \'edr\'e1studatlanoknak (az \'cdr\'e1
st nem ismer\'f5knek): \'84Al\'e1vetitek-e magatokat (Allahnak)?\'94 Ha al\'e1vetik magukat, akkor az [igaz] \'fatra lelnek. \'c1m ha h\'e1tat ford\'edtanak, \'fagy r\'e1d csak az [\'fczenet-]\'e1tad\'e1s tartozik. \'c9s Allah belel\'e1t a szolg\'e1iba.

\par 
\par 21. Bizony, akik megtagadj\'e1k Allah jeleit, \'e9s jogtalanul meg\'f6lik a pr\'f3f\'e9t\'e1kat, \'e9s meg\'f6lik az emberek k\'f6z\'fcl azokat, akik az igazs\'e1goss\'e1gra sz\'f3l\'edtanak fel, h\'e1t azoknak adj \'f6r\'f6mh\'edrt f\'e1jdalmas gy\'f6
trelemr\'f5l!
\par 22. \'d5k azok, akiknek szertefoszlanak a cselekedetei az evil\'e1gon \'e9s a t\'falvil\'e1gon, \'e9s nem lesz, aki gy\'f5zelemre vinn\'e9 \'f5ket.
\par 
\par 23.Vajon nem jutott tudom\'e1sodra azoknak [a h\'edre], akik egy r\'e9szt kaptak az \'cdr\'e1sb\'f3l? Allah \'cdr\'e1s\'e1hoz h\'edvatnak, hogy \'edt\'e9lkezzen [vit\'e1s k\'e9rd\'e9seikben] k\'f6z\'f6tt\'fck, majd egy csoport k\'f6z\'fcl\'fck h\'e1
tat ford\'edt, mik\'f6zben \'fcgyet sem vet [az igazs\'e1gra].
\par 24. Ez az\'e9rt van, mert azt mondj\'e1k: \'84Nem fog minket \'e9rinteni a [Pokol-]t\'fbz, csak meghat\'e1rozott sz\'e1m\'fa napig!\'94 \'c9s megt\'e9vesztette \'f5ket vall\'e1sukban az, amit kital\'e1ltak.
\par 25. \'c9s hogyan [lesz majd], amikor \'f6sszegy\'fbjtj\'fck \'f5ket egy olyan napra, melyhez nem f\'e9r k\'e9ts\'e9g, \'e9s minden ember [fizets\'e9ge] teljess\'e9 t\'e9tetik az\'e9rt, amit szerzett, \'e9s nem szenvednek el igazs\'e1gtalans\'e1got?
\par 
\par 26. Mondd [\'f3 Mohamed]: \'84\'d3 Allah, a kir\'e1lyi uralom birtokosa! Annak adod a kir\'e1lyi uralmat, akinek akarod, s att\'f3l ragadod el a kir\'e1lyi uralmat, akit\'f5l akarod. M\'e9lt\'f3s\'e1ggal ruh\'e1zod fel azt, akit akarsz \'e9
s megveted azt, akit akarsz. A j\'f3 [csak] a Te kezedben van. Bizony, Te minden dologra kiterjed\'f5 hatalm\'fa vagy.
\par 27. Beleviszed az \'e9jszak\'e1t a nappalba, \'e9s beleviszed a nappalt az \'e9jszak\'e1ba. El\'f5hozod az \'e9l\'f5t a halottb\'f3l, \'e9s el\'f5hozod a halottat az \'e9l\'f5b\'f5l, \'e9s azt l\'e1tsz el, akit akarsz, sz\'e1mad\'e1s n\'e9lk\'fcl.\'94

\par 
\par 28. Ne tegy\'e9k meg a h\'edv\'f5k a hitetleneket p\'e1rtfog\'f3kk\'e1 a h\'edv\'f5k helyett! \'c9s aki \'edgy tesz, annak nincs semmi kapcsolata Allahhal, kiv\'e9ve, ha f\'e9ln\'e9tek t\'f5l\'fck (val\'f3s vesz\'e9ly\'fckt\'f5l). Allah \'f3
va int benneteket mag\'e1t\'f3l (a haragj\'e1t\'f3l)! Allahn\'e1l lesz a v\'e9gc\'e9l.
\par 29. Mondd [\'f3 Mohamed]: \'84Ak\'e1r elrejtitek azt, ami a kebletekben van, ak\'e1r felt\'e1rj\'e1tok, Allah tudja azt. \'c9s tudja mindazt, ami az egekben \'e9s ami a f\'f6ld\'f6n van. S Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 30. Azon a napon, amikor minden ember el\'f5hozva tal\'e1lja maga el\'f5tt mindazt a j\'f3t, amit tett, \'e9s mindazt a rosszat, amit tett. Azt szeretn\'e9, hogyha k\'f6zte \'e9s a [rossz tettei] k\'f6z\'f6tt m\'e9rhetetlen id\'f5 lenne. \'c9s Allah \'f3
va int titeket mag\'e1t\'f3l (a haragj\'e1t\'f3l), \'e9s Allah Egy\'fctt\'e9rz\'f5 a szolg\'e1ival.
\par 
\par 31. Mondd [\'f3 Mohamed]: \'84Ha [val\'f3ban] szeretitek Allahot, akkor k\'f6vessetek engem! Akkor Allah [is] szeretni fog titeket \'e9s megbocs\'e1tja b\'fbneiteket. \'c9s Allah Megbocs\'e1t\'f3, Irgalmas.\'94
\par 32. Mondd [\'f3 Mohamed]: \'84Engedelmeskedjetek Allahnak \'e9s a K\'fcld\'f6ttnek (Mohamednek)!\'94 \'c1m ha h\'e1tat ford\'edtanak, akkor Allah bizony nem szereti a hitetleneket.
\par 
\par 33. Bizony, Allah v\'e1lasztotta \'c1d\'e1mot, No\'e9t, \'c1brah\'e1m nemzets\'e9g\'e9t \'e9s Imr\'e1n nemzets\'e9g\'e9t [az akkor l\'e9tez\'f5] teremtm\'e9nyek f\'f6l\'e9.
\par 34. \'d5k ut\'f3dok, egyik olyan, mint a m\'e1sik! S Allah Mindent Hall\'f3, Mindentud\'f3!
\par 35. [Eml\'edtsd meg,] amikor Imr\'e1n feles\'e9ge azt mondta: \'84Uram! \'c9n bizony felaj\'e1nlom neked azt, ami a hasamban van, neked szentelve, fogadd h\'e1t el t\'f5lem! Bizony te vagy a Mindent hall\'f3, a Mindentud\'f3.\'94
\par 36. Majd miut\'e1n vil\'e1gra hozta \'f5t, azt mondta: \'84Uram, \'e9n bizony le\'e1nyt hoztam vil\'e1gra\'94 \endash  Allah pedig tudja, hogy mit hozott vil\'e1gra \endash  \'84\'e9s a fi\'fa nem ugyanolyan, mint a l\'e1ny! Bizony \'e9n \'f5t M\'e1ri\'e1
nak neveztem el, \'e9s mened\'e9ket k\'e9rek N\'e1lad sz\'e1m\'e1ra \'e9s lesz\'e1rmazottai sz\'e1m\'e1ra a kitasz\'edtott S\'e1t\'e1n el\'f5l!\'94
\par 37. \'c9s az Ura elfogadta \'f5t (M\'e1ri\'e1t) sz\'e9p elfogad\'e1ssal, \'e9s gondos nevel\'e9sben r\'e9szes\'edtette, \'e9s Zakari\'e1s gondoz\'e1sa al\'e1 helyezte \'f5t. Ak\'e1rh\'e1nyszor bement hozz\'e1 Zakari\'e1s a szent\'e9lybe, ell\'e1t\'e1
st tal\'e1lt n\'e1la. Azt mondta neki: \'84\'d3 M\'e1ria, honnan van mindez neked?\'94 Azt mondta: \'84Ez Allaht\'f3l van.\'94 Allah bizony annak ad ell\'e1t\'e1st, akinek akar, sz\'e1mad\'e1s n\'e9lk\'fcl.
\par 
\par 38. Zakari\'e1s ott, akkor az Ur\'e1hoz foh\'e1szkodott [mondv\'e1n]: \'84Uram, aj\'e1nd\'e9kozz meg engem T\'f5led val\'f3 [csoda \'e1ltal] j\'f3lelk\'fb ut\'f3dokkal! Bizony te meghallgatod a foh\'e1szt.\'94
\par 39. Ezut\'e1n megsz\'f3l\'edtott\'e1k \'f5t az angyalok, mik\'f6zben \'e1llva im\'e1dkozott a szent\'e9lyben: \'84Allah bizony \'f6r\'f6mh\'edrt ad neked J\'e1nosr\'f3l, aki igazolja az Allaht\'f3l val\'f3 Sz\'f3 (J\'e9zus) [k\'fcldet\'e9s\'e9
nek igaz volt\'e1t], vezet\'e9sre termett, \'f6nmegtart\'f3ztat\'f3, \'e9s pr\'f3f\'e9ta lesz a j\'f3 emberek k\'f6z\'fcl.
\par 40. Azt mondta: \'84Uram! Hogyan lehetne nekem ifj\'fa gyermekem, holott m\'e1r utol\'e9rt engem az \'f6regkor, a feles\'e9gem pedig medd\'f5?\'94 [Az angyal] azt mondta: \'84Ekk\'e9ppen tesz Allah amit akar!\'94
\par 41. Azt mondta: \'84Uram! Adj nekem egy jelet! Azt mondta: \'84A jeled az, hogy h\'e1rom napig nem fogsz [tudni] besz\'e9lni az emberekhez, csup\'e1n jelbesz\'e9ddel. \'c9s eml\'e9kezz meg gyakran az Uradr\'f3l, \'e9s magasztald [\'d5t] a naplemente el
\'f5tt \'e9s hajnalban!\'94
\par 
\par 42. \'c9s [eml\'edtsd meg,] amikor azt mondt\'e1k az angyalok: \'84\'d3 M\'e1ria! Bizony Allah kiv\'e1lasztott t\'e9ged, tiszt\'e1v\'e1 tett, \'e9s t\'e9ged v\'e1lasztott ki [a hajdan \'e9lt] teremtm\'e9nyek asszonyai k\'f6z\'fcl.
\par 43. \'d3 M\'e1ria! Engedelmeskedj al\'e1zatosan Uradnak, borulj le, \'e9s hajolj meg a meghajl\'f3kkal egy\'fctt!\'94
\par 44. Ez azon h\'edrekb\'f5l val\'f3, ami [el\'f5tted, \'f3 Mohamed] rejtve volt, \'e1m mi [kinyilatkoztat\'e1sk\'e9nt] sugalljuk neked. \'c9s nem volt\'e1l ott vel\'fck, amikor elvetett\'e9k tollaikat (sorsot h\'faztak), hogy melyik\'fck vegye gondoz\'e1s
\'e1ba M\'e1ri\'e1t, \'e9s nem volt\'e1l ott vel\'fck, amikor egym\'e1ssal ezen vitatkoztak.
\par 
\par 45. [Eml\'edtsd meg,] amikor azt mondt\'e1k az angyalok: \'84\'d3 M\'e1ria! Allah bizony \'f6r\'f6mh\'edrt ad neked egy Sz\'f3r\'f3l, mely t\'f5le van, a neve Messi\'e1s, J\'e9zus, M\'e1ria fia, nagy becsben fog \'e1llni az evil\'e1gon \'e9s a t\'falvil
\'e1gon, \'e9s az [Allahhoz] k\'f6zell\'e9v\'f5kh\'f6z fog tartozni.
\par 46. \'c9s besz\'e9lni fog az emberekhez a b\'f6lcs\'f5ben \'e9s meglett f\'e9rfik\'e9nt [is], \'e9s a j\'f3 emberek k\'f6z\'e9 fog tartozni.\'94
\par 47. Azt mondta [M\'e1ria]: \'84Uram! Hogyan is lehetne nekem ifj\'fa gyermekem, holott nem \'e9rintett engem ember?\'94 Azt mondta: \'84Ekk\'e9ppen teremt Allah, amit akar. Amikor elrendel egy dolgot, akkor csup\'e1n azt mondja annak: \'84Legy\'e9l!\'94, 
\'e9s az van.
\par 48. \'c9s [Allah] megtan\'edtja neki az \'cdr\'e1st \'e9s a b\'f6lcsess\'e9get, a T\'f3r\'e1t, \'e9s az Evang\'e9liumot,
\par 49. \'c9s k\'fcld\'f6ttk\'e9nt [k\'fcldi el] Izrael fiaihoz [akikhez \'edgy sz\'f3l:] \'84Bizony, \'e9n elj\'f6ttem hozz\'e1tok az Uratokt\'f3l val\'f3 jellel. Bizony, \'e9n az agyagb\'f3l form\'e1lok nektek egy mad\'e1rform\'e1t, majd belef\'fajok, \'e9
s mad\'e1rr\'e1 lesz \endash  Allah engedelm\'e9vel \endash  \'e9s meggy\'f3gy\'edtom a sz\'fcletett vakot, a lepr\'e1st, \'e9s \'e9letre keltem a halottakat \endash  Allah engedelm\'e9vel \endash  \'e9s h\'edr\'fcl adom nektek, hogy mit esztek, \'e9
s mit rakt\'e1roztok el h\'e1zaitokban. Bizony ebben jel van sz\'e1motokra, ha [val\'f3ban] h\'edv\'f5k vagytok,
\par 50. \'e9s igazolva annak igazs\'e1g\'e1t, ami el\'f5ttem volt a T\'f3r\'e1b\'f3l, \'e9s az\'e9rt, hogy megengedett\'e9 tegyek sz\'e1motokra n\'e9h\'e1nyat azok k\'f6z\'fcl, amelyek tilalmass\'e1 t\'e9tettek nektek. \'c9s az Uratokt\'f3l val\'f3 jellel j
\'f6ttem el hozz\'e1tok. Ez\'e9rt f\'e9lj\'e9tek Allahot, \'e9s engedelmeskedjetek nekem!
\par 51. Bizony, Allah az \'e9n Uram \'e9s a ti Uratok, szolg\'e1lj\'e1tok h\'e1t \'d5t! Ez az egyenes \'fat!\'94
\par 
\par 52. Majd azut\'e1n, hogy J\'e9zus hitetlens\'e9get \'e9rz\'e9kelt a r\'e9sz\'fckr\'f5l, azt mondta: \'84Kik az \'e9n seg\'edt\'f5im az Allahhoz [vezet\'f5 \'faton]?\'94 Azt mondt\'e1k a kiv\'e1lasztott k\'f6vet\'f5k (tan\'edtv\'e1nyok): \'84
Mi vagyunk Allah seg\'edt\'f5i, hisz\'fcnk Allahban, \'e9s tan\'fas\'edtsd azt, hogy mi al\'e1vetj\'fck magunkat [Allahnak]!
\par 53. Urunk! Hisz\'fcnk abban, amit lebocs\'e1tott\'e1l, \'e9s k\'f6vetj\'fck a K\'fcld\'f6ttet, \'edrj h\'e1t minket a [egyistenhitet] tan\'fas\'edt\'f3k k\'f6z\'e9!\'94
\par 
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid7671686 {\insrsid14643188\charrsid14643188 54. \'c9s [a hitetlenek] }{\insrsid7671686 tervet}{\insrsid14643188\charrsid14643188  sz\'f5t}
{\insrsid14643188\charrsid15618338 tek }{\insrsid7671686\charrsid15618338 [}{\insrsid14643188\charrsid15618338 hogy meg\'f6lj\'e9k J\'e9zust}{\insrsid7671686\charrsid15618338 ], \'e1m}{\insrsid14643188\charrsid15618338  Allah is }{
\insrsid7671686\charrsid15618338 tervezett}{\insrsid14643188\charrsid15618338 . \'c9s Allah a legjobb azok k\'f6z\'fcl, akik }{\insrsid7671686\charrsid15618338 tervez}{\insrsid14643188\charrsid15618338 nek.}{\insrsid14643188\charrsid14643188 
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\insrsid14643188\charrsid14643188 55. [Eml\'edtsd meg,] amikor Allah azt mondta: \'84\'d3 J\'e9zus! \'c9n bizony  elsz\'f3l\'ed
talak t\'e9ged, \'e9s Magamhoz emellek, \'e9s megtiszt\'edtalak azokt\'f3l, akik nem hisznek, \'e9s azokat, akik k\'f6vettek t\'e9ged a Felt\'e1mad\'e1s Napj\'e1ig, azok f\'f6l\'e9 helyezem, akik nem hisznek. Azut\'e1n Hozz\'e1m lesz a visszat\'e9r\'e9
setek, \'e9s \'edt\'e9lkezni fogok k\'f6ztetek abban, amiben \'f6sszek\'fcl\'f6nb\'f6ztetek.
\par 56. Nos, ami azokat illeti, akik hitetlenn\'e9 v\'e1ltak, \'f5ket s\'falyos gy\'f6trelemmel fogom megb\'fcntetni az evil\'e1gon \'e9s a t\'falvil\'e1gon, \'e9s nem lesz, aki gy\'f5zelemre vinn\'e9 \'f5ket.
\par 57. \'c9s ami azokat illeti, akik hisznek, \'e9s j\'f3tetteket cselekszenek, azoknak [Allah] teljess\'e9 teszi jutalmaikat, \'e9s Allah nem szereti az igazs\'e1gtalanokat.
\par 58. Ez, amit recit\'e1lunk neked, a [pr\'f3f\'e9tas\'e1godat bizony\'edt\'f3] jelekb\'f5l, \'e9s a B\'f6lcs Eml\'e9keztet\'e9sb\'f5l [val\'f3].\'94
\par 
\par 59. Bizony, J\'e9zus, Allah el\'f5tt hasonlatos \'c1d\'e1mhoz. Porb\'f3l teremtette \'f5t, majd azt mondta neki: \'84Legy\'e9l!\'94 - \'e9s lett. 
\par 60. Ez az igazs\'e1g a te Uradt\'f3l, ne l\'e9gy h\'e1t azok k\'f6z\'fcl val\'f3, akik k\'e9telkednek!
\par 61. \'c9s ha valaki \'e9rvelve sz\'e1ll vit\'e1ba veled \'f5t (J\'e9zust) illet\'f5en, miut\'e1n a tud\'e1s elj\'f6tt hozz\'e1d, akkor mondd: \'84Gyertek, h\'edvjuk el a fiainkat \'e9s a fiaitokat, az asszonyainkat \'e9s az asszonyaitokat, magunkat \'e9
s titeket, majd foh\'e1szkodjunk al\'e1zatosan, \'e9s k\'e9rj\'fck Allah \'e1tk\'e1t a hazugokra!\'94
\par 
\par 62. Bizony, ez az igaz elbesz\'e9l\'e9s (J\'e9zus t\'f6rt\'e9net\'e9r\'f5l)! \'c9s nincs m\'e1s }{\cf1\insrsid14643188\charrsid14643188 [jogosan im\'e1dhat\'f3] isten,}{\insrsid14643188\charrsid14643188  csak Allah, \'e9s Allah bizony, a M\'e9lt\'f3s\'e1
gteljes, a B\'f6lcs.
\par 63. \'c1m ha h\'e1tat ford\'edtanak, bizony, Allahnak tudom\'e1sa van a roml\'e1st okoz\'f3kr\'f3l.
\par 64. Mondd: \'84\'d3 \'cdr\'e1s n\'e9pe! J\'f6jjetek egyezked\'f5 sz\'f3ra k\'f6z\'f6tt\'fcnk \'e9s k\'f6z\'f6ttetek! Egyezz\'fcnk meg abban, hogy nem szolg\'e1lunk m\'e1st, csak Allahot, \'e9s semmit sem \'e1ll\'edtunk t\'e1rsistenk\'e9nt \'d5mell\'e9, 
\'e9s egym\'e1s k\'f6z\'f6tt nem tesz\'fcnk meg egyeseket Allah mellett uraknak! Ha azonban \'f5k h\'e1tat ford\'edtanak, akkor mondj\'e1tok: Tan\'fas\'edts\'e1tok, hogy mi azok vagyunk, akik al\'e1vetik magukat [Allahnak]!\'94
\par 65. \'d3 \'cdr\'e1s n\'e9pe! Mi\'e9rt sz\'e1lltok \'e9rvelve vit\'e1ba vel\'fcnk \'c1brah\'e1mot illet\'f5en, holott a T\'f3ra \'e9s az Evang\'e9lium csak \'f5ut\'e1na lett lebocs\'e1tva? Vajon h\'e1t nem \'e9ltek az eszetekkel?
\par 66. \'cdme, ti \'e9rvelve sz\'e1lltatok vit\'e1ba arr\'f3l, amir\'f5l rendelkeztek tud\'e1ssal. \'c1m mi\'e9rt sz\'e1lltok \'e9rvelve vit\'e1ba arr\'f3l, amir\'f5l nem rendelkeztek tud\'e1ssal? \'c9s Allah tud, de ti nem tudtok.
\par 67. \'c1brah\'e1m nem volt sem zsid\'f3, sem pedig kereszt\'e9ny, hanem han\'edf (egyistenh\'edv\'f5, a hamis vall\'e1sokt\'f3l elhajl\'f3) volt, aki al\'e1vetette mag\'e1t [Allahnak], \'e9s nem tartozott azok k\'f6z\'e9, akik [Allah mell\'e9] t\'e1
rsistent \'e1ll\'edtanak.
\par 68. Bizony, azoknak az embereknek van t\'f6bb joguk \'c1brah\'e1mhoz, akik k\'f6vett\'e9k \'f5t, \'e9s ez a Pr\'f3f\'e9ta (Mohamed), \'e9s akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]. \'c9
s Allah a h\'edv\'f5k p\'e1rtfog\'f3ja.
\par 
\par 69. Az \'cdr\'e1s n\'e9p\'e9b\'f5l egy csoport azt szeretn\'e9, ha t\'e9velyg\'e9sbe vihetne titeket, \'e1m csak magukat viszik t\'e9velyg\'e9sbe, \'e9s \'e9szre sem veszik.
\par 70. \'d3, \'cdr\'e1s n\'e9pe! Mi\'e9rt }{\cf1\insrsid14643188\charrsid14643188 v\'e1ltok hitetlenn\'e9 }{\insrsid14643188\charrsid14643188 Allah jeleivel szemben, holott ti vagytok a tan\'fai?
\par 71. \'d3, \'cdr\'e1s n\'e9pe! Mi\'e9rt teszitek zavaross\'e1 az igazs\'e1got a hamiss\'e1ggal, \'e9s elrejtitek az igazs\'e1got, holott ti tudj\'e1tok [azt]?
\par 72. \'c9s az \'cdr\'e1s n\'e9p\'e9b\'f5l egy csoport azt mondta: \'84Higgyetek a nap kezdet\'e9n abban, ami lebocs\'e1ttatott a h\'edv\'f5knek, \'e9s tagadj\'e1tok meg azt a [nap] v\'e9g\'e9n, h\'e1tha visszat\'e9rnek!
\par 73. \'c9s csup\'e1n azoknak higgyetek, akik a ti vall\'e1sotokat k\'f6vetik!\'94 Mondd [\'f3 Mohamed]: \'84Bizony az [igaz] \'fatmutat\'e1s Allah \'fatmutat\'e1sa.\'94 [\'c9s azt mondt\'e1k:] \'84Nehogy m\'e1
svalakinek is megadasson az, ami nektek megadatott, vagy \'e9rvelve sz\'e1lljanak vit\'e1ba ellenetek az Uratok el\'f5tt\'94. Mondd [\'f3 Mohamed]: \'84A kegy bizony Allah kez\'e9ben van, annak adja, akinek akarja.\'94}{
\lang1038\langfe3073\langfenp3073\insrsid14643188\charrsid14643188  }{\insrsid14643188\charrsid14643188 \'c9s Allah [mindent] \'c1tfog\'f3, Mindentud\'f3.
\par }\pard \qj \fi-454\li454\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin454\itap0\pararsid14643188 {\insrsid14643188\charrsid14643188 74. [Allah] azt t\'fcnteti ki a k\'f6ny\'f6r\'fclet\'e9vel, akit akar. \'c9s Allah\'e9
 a hatalmas kegy.
\par 
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\insrsid14643188\charrsid14643188 75. \'c9s az \'cdr\'e1s n\'e9pe k\'f6z\'fcl van olyan, akire ha halomnyi aranyat b\'ed
zol, visszaadja azt neked, de van k\'f6z\'fcl\'fck olyan, akire ha egy aranyp\'e9nzt b\'edzol, nem adja vissza neked, csak akkor, ha \'e1lland\'f3an a sark\'e1ban vagy. Ez [az\'e9rt van], mert azt mondj\'e1k: \'84Nem lesz\'fcnk felel\'f5ss\'e9
gre vonva az \'edr\'e1studatlanokat (a nem zsid\'f3kat) illet\'f5en [ha elvessz\'fck vagyonukat].\'94 \'c9s [ezzel] hazugs\'e1got mondanak Allahr\'f3l, mik\'f6zben tudj\'e1k [hogy ez a kijelent\'e9s hazugs\'e1g].
\par 76. Dehogynem! Aki teljes\'edti az egyezs\'e9g\'e9t \'e9s istenf\'e9lelmet tan\'fas\'edt [az val\'f3ban istenf\'e9l\'f5], \'e9s Allah bizony szereti az istenf\'e9l\'f5ket!
\par 77. Bizony, akik az Allahhal [k\'f6t\'f6tt] egyezs\'e9get \'e9s az esk\'fciket csek\'e9ly \'e1ron k\'f3tyavety\'e9lik el, azoknak nem lesz semmilyen r\'e9szesed\'e9s\'fck a t\'falvil\'e1gon, Allah nem sz\'f3l majd hozz\'e1juk, \'e9s nem tekint re\'e1
juk a Felt\'e1mad\'e1s napj\'e1n, \'e9s nem tiszt\'edtja meg \'f5ket, \'e9s f\'e1jdalmas gy\'f6trelem j\'e1r nekik.
\par 
\par 78. \'c9s bizony, van k\'f6z\'f6tt\'fck egy csoport, akik elferd\'edtik a nyelv\'fckkel a [n\'e1luk l\'e9v\'f5] \'cdr\'e1st, az\'e9rt hogy azt az \'cdr\'e1s (T\'f3ra) r\'e9sz\'e9nek gondolj\'e1tok, de az nem az \'cdr\'e1s r\'e9sze. \'c9s azt mondj\'e1
k, hogy az Allaht\'f3l val\'f3, \'e1m az nem Allaht\'f3l val\'f3, \'e9s hazugs\'e1got mondanak Allahr\'f3l, mik\'f6zben tudj\'e1k [hogy ez a kijelent\'e9s hazugs\'e1g].
\par 79. Lehetetlen egy olyan embernek, akinek Allah az \'cdr\'e1st, a b\'f6lcsess\'e9ge, \'e9s a pr\'f3f\'e9tas\'e1got adta, hogy ezut\'e1n azt mondja az embereknek: \'84Legyetek az \'e9n szolg\'e1im, ne pedig Allah\'e9!\'94 Ellenkez\'f5
leg, [azt mondja nekik]: \'84Legyetek az \'dar h\'fb szolg\'e1i az\'e1ltal, hogy tan\'edtj\'e1tok az \'cdr\'e1st, \'e9s ti magatok is tanulm\'e1nyozz\'e1tok azt!\'94
\par 80. \'c9s nem sz\'f3l\'edt fel titeket arra, hogy az angyalokat \'e9s a pr\'f3f\'e9t\'e1kat tegy\'e9tek uratokk\'e1. Vajon a hitetlens\'e9gre sz\'f3l\'edtana fel titeket, miut\'e1n ti al\'e1vetett\'e9tek magatokat [Allahnak]?
\par 
\par 81. [Eml\'edtsd meg,] amikor Allah sz\'f6vets\'e9get k\'f6t\'f6tt a pr\'f3f\'e9t\'e1kkal [mondv\'e1n]: \'84Bizony, b\'e1rmit is adok nektek az \'cdr\'e1sb\'f3l \'e9s a b\'f6lcsess\'e9gb\'f5l, \'e9s ezut\'e1n elj\'f6n hozz\'e1tok egy k\'fcld\'f6tt \endash 
 igazolva annak igazs\'e1g\'e1t, ami birtokotokban van \endash  [akkor] higgyetek benne, \'e9s seg\'edts\'e9tek \'f5t!\'94 \'c9s [Allah] azt mondta: \'84Elismeritek vajon \'e9s elfogadj\'e1tok magatokra n\'e9zve k\'f6telez\'f5nek az egyezm\'e9nyemet?\'94
 Azt mondt\'e1k: \'84Elfogadjuk!\'94 Azt mondta: \'84Tan\'fas\'edts\'e1tok h\'e1t, \'e9s \'e9n is veletek vagyok a tan\'fak k\'f6z\'f6tt!\'94
\par 82. \'c1m akik ezut\'e1n h\'e1tat ford\'edtanak, h\'e1t azok }{\insrsid5725369 bizony }{\insrsid14643188\charrsid14643188 az engedetlenek!
\par 83. Vajon Allah vall\'e1sa helyett m\'e1st k\'edv\'e1nnak [k\'f6vetni], holott neki vetette al\'e1 mag\'e1t mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van, \'f6nk\'e9nt \'e9s k\'e9nyszerb\'f5l, \'e9s Hozz\'e1 lesznek visszavitetve?
\par 
\par 84. Mondd [\'f3 Mohamed]: \'84Hisz\'fcnk Allahban \'e9s abban, ami lebocs\'e1ttatott nek\'fcnk, \'e9s abban, ami lebocs\'e1ttatott \'c1brah\'e1mnak, Izmaelnak, Izs\'e1knak, J\'e1kobnak \'e9s a T\'f6rzseknek (J\'e1kob tizenk\'e9t fia lesz\'e1
rmazottainak), \'e9s abban, ami M\'f3zesnek, J\'e9zusnak \'e9s a pr\'f3f\'e9t\'e1knak adatott az Urukt\'f3l. Nem tesz\'fcnk k\'fcl\'f6nbs\'e9get egyik\'fck jav\'e1ra sem k\'f6z\'fcl\'fck, \'e9s mi Neki (Allahnak) vetj\'fck al\'e1 magunkat.\'94
\par 85. \'c9s aki az iszl\'e1m helyett m\'e1s vall\'e1st keres, az nem lesz t\'f5le elfogadva, \'e9s \'f5 a t\'falvil\'e1gon a vesztesek k\'f6z\'e9 fog tartozni.
\par 
\par 86. Hogyan vezetne Allah [az igaz] \'fatra egy olyan n\'e9pet, akik hitetlenn\'e9 v\'e1ltak miut\'e1n hittek, \'e9s [miut\'e1n] tan\'fas\'edtott\'e1k, hogy a K\'fcld\'f6tt igaz, \'e9s [miut\'e1n] elj\'f6ttek hozz\'e1juk a vil\'e1gos bizony\'edt\'e9kok? 
\'c9s Allah nem vezeti [az igaz] \'fatra az igazs\'e1gtalan n\'e9pet.
\par 87. Az \'f5 fizets\'e9g\'fck, hogy Allah \'e1tka van rajtuk, \'e9s az angyalok\'e9 \'e9s az \'f6sszes ember\'e9.
\par 88. \'d6r\'f6kk\'e9 abban (a Pokol-t\'fbzben) fognak maradni, nem enyh\'edttetik sz\'e1mukra a gy\'f6trelem \'e9s halad\'e9kot sem fognak kapni.
\par 89. Kiv\'e9ve azokat, akik ezek ut\'e1n b\'fbnb\'e1natot tan\'fas\'edtanak \'e9s javol\'e1st hoznak. Allah bizony Megbocs\'e1t\'f3, Irgalmas.
\par 90. Bizony, akik hitetlenn\'e9 v\'e1ltak miut\'e1n hittek, majd pedig gyarapodtak hitetlens\'e9gben, azokt\'f3l nem lesz elfogadva a b\'fbnb\'e1natuk, \'e9s \'f5k }{\insrsid5725369 bizony }{\insrsid14643188\charrsid14643188 a t\'e9velyg\'f5k!
\par 91. Bizony, akik hitetlenekk\'e9 v\'e1ltak, \'e9s hitetlenekk\'e9nt haltak meg, egyik\'fckt\'f5l sem lesz elfogadva v\'e1lt\'e1sd\'edjk\'e9nt annyi arany [sem], amennyi bet\'f6lten\'e9 a f\'f6ldet, m\'e9g ha ezt aj\'e1nlan\'e1 [is] fel. Nekik f\'e1
jdalmas gy\'f6trelem j\'e1r, \'e9s nem lesznek seg\'edt\'f5ik.
\par 
\par 92. Nem fogj\'e1tok el\'e9rni a j\'f3s\'e1g [fokozat\'e1t] mindaddig, am\'edg nem adakoztok abb\'f3l, amit szerettek, \'e9s b\'e1rmit [j\'f3t] adakoztok, arr\'f3l Allahnak tudom\'e1sa van.
\par 93. Minden \'e9lelem megengedett volt Izrael fiai sz\'e1m\'e1ra, kiv\'e9ve az, amit Izrael tilalmass\'e1 tett mag\'e1nak \endash  m\'e9g azel\'f5tt, hogy lebocs\'e1ttatott volna a T\'f3ra. Mondd [\'f3 Mohamed]: \'84Hozz\'e1tok el a T\'f3r\'e1t, majd recit
\'e1lj\'e1tok azt, ha val\'f3ban igazmond\'f3k vagytok!\'94
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\insrsid14643188\charrsid14643188 94. \'c1m akik ezek ut\'e1n hazugs\'e1got tal\'e1lnak ki Allah ellen, bizony, azok az igazs\'e1gtalanok.
\par 
\par 95. Mondd [\'f3 Mohamed]: \'84Allah igazat mond. K\'f6vess\'e9tek h\'e1t \'c1brah\'e1m vall\'e1s\'e1t, aki han\'edf (egyistenh\'edv\'f5, a hamis vall\'e1sokt\'f3l elhajl\'f3) volt, \'e9s nem tartozott azok k\'f6z\'e9, akik [Allah mell\'e9] t\'e1rsistent 
\'e1ll\'edtanak!\'94
\par 96. Bizony az els\'f5 h\'e1z, mely az embereknek t\'e9tetett [Allah im\'e1dat\'e1ra], az Bekk\'e1ban (Mekk\'e1ban) volt, \'e1ld\'e1ssal teli \'e9s \'fatmutat\'e1s minden (\'e9rtelmes) teremtm\'e9nynek.
\par 97. Vil\'e1gos jelek (bizony\'edt\'e9kok) vannak ott: \'c1brah\'e1m \'e1ll\'f3helye. Aki bel\'e9p oda, az biztons\'e1gban van. Az emberek k\'f6teless\'e9ge Allah ir\'e1nt a h\'e1zhoz val\'f3 zar\'e1ndoklat, azoknak, akik k\'e9pesek m\'f3dot tal\'e1lni r
\'e1. \'c1m aki megtagadja, h\'e1t Allah bizony nem szorul r\'e1 a teremtm\'e9nyekre.
\par 
\par 98. Mondd [\'f3 Mohamed]: \'84\'d3 ti \'cdr\'e1s n\'e9pe! Mi\'e9rt }{\cf1\insrsid14643188\charrsid14643188 v\'e1ltok hitetlenn\'e9}{\insrsid14643188\charrsid14643188  Allah jeleivel szemben, mik\'f6zben Allah tan\'faja annak, amit cselekszetek?\'94
\par 99. Mondd [\'f3 Mohamed]: \'84\'d3 ti \'cdr\'e1s n\'e9pe! Mi\'e9rt tartj\'e1tok t\'e1vol Allah \'fatj\'e1t\'f3l azokat, akik hisznek, \'e9s k\'edv\'e1nj\'e1tok azt, hogy [Allah \'fatja] ferde legyen, mik\'f6zben ti tan\'fai vagytok [az igazs\'e1
gnak]? S Allah nem hagyja figyelmen k\'edv\'fcl azt, amit cselekszetek.\'94
\par 100. \'d3, ti akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha engedelmeskedtek azok egy r\'e9sz\'e9nek, akiknek az \'cdr\'e1s adatott, azok titeket \endash  miut\'e1n h\'edv\'f5k voltatok \endash 
 hitetlenekk\'e9 t\'e9r\'edtenek vissza.
\par 101. \'c9s hogyan }{\cf1\insrsid14643188\charrsid14643188 v\'e1lhattok hitetlenn\'e9}{\insrsid14643188\charrsid14643188 , holott Allah jeleit (szavait) recit\'e1lj\'e1k nektek, \'e9s k\'f6z\'f6ttetek van a K\'fcld\'f6tte (Mohamed)? \'c9
s aki Allahhoz ragaszkodik, bizony, egyenes \'fatra lett vezetve.
\par 
\par 102. \'d3 ti akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! F\'e9lj\'e9tek Allahot az \'d5t megillet\'f5 f\'e9lelemmel, \'e9s ne haljatok meg csak \'fagy, hogy azok vagytok, akik al\'e1
vetik magukat (Allahnak)!
\par 103. Ragaszkodjatok Allah k\'f6tel\'e9k\'e9hez (a Kor\'e1nhoz) mindannyian, \'e9s ne szakadjatok sz\'e9t [csoportokra]! \'c9s eml\'e9kezettek Allah j\'f3t\'e9tem\'e9ny\'e9re, amiben r\'e9szes\'edtett titeket, amikor egym\'e1s ellens\'e9
gei voltatok, majd egyet\'e9rt\'e9st teremtett a sz\'edvetek k\'f6z\'f6tt, \'e9s a j\'f3t\'e9tem\'e9nye r\'e9v\'e9n testv\'e9rek lettetek! A [Pokol-] t\'fbz g\'f6dr\'e9nek a sz\'e9l\'e9n voltatok, \'e9s \'d5 megmentett titeket att\'f3l. Ekk\'e9
ppen teszi Allah vil\'e1goss\'e1 nektek a jeleit, h\'e1tha [az igaz] \'fatra leltek.
\par 104. Legyen bel\'f5letek egy olyan k\'f6z\'f6ss\'e9g, amely a j\'f3ra h\'edv, felsz\'f3l\'edt a hely\'e9nval\'f3ra, megtiltja az elvetend\'f5t! \'d5k }{\insrsid5725369 bizony }{\insrsid14643188\charrsid14643188 azok, akik boldogulnak.
\par 105. \'c9s ne legyetek olyanok, mint akik sz\'e9tszakadtak (csoportokra), \'e9s \'f6sszek\'fcl\'f6nb\'f6ztek azut\'e1n, hogy elj\'f6ttek hozz\'e1juk a vil\'e1gos bizony\'edt\'e9kok! Azoknak hatalmas gy\'f6trelem j\'e1r,
\par 106. Azon a napon, amelyen [egyesek] arca felragyog, m\'edg [m\'e1sok] arca els\'f6t\'e9t\'fcl. Nos, ami azokat illeti, akiknek els\'f6t\'e9t\'fcl az arcuk [azoknak azt fogj\'e1k mondani]: \'84Vajon hitetlenn\'e9 v\'e1ltatok azut\'e1n, hogy h\'edv\'f5
k voltatok? \'cdzlelj\'e9tek h\'e1t meg a gy\'f6trelmet amiatt, hogy hitetlenek voltatok!\'94
\par 107. Ami azokat illeti, akiknek felragyog az arcuk, azok Allah k\'f6ny\'f6r\'fclet\'e9ben (a Paradicsomban) lesznek, \'f6r\'f6kk\'e9 abban fognak maradni.
\par 108. Ezek Allah jelei (szavai), melyeket az igazs\'e1gnak megfelel\'f5en recit\'e1lunk neked [\'f3 Mohamed]. Allah nem akar igazs\'e1gtalans\'e1got a teremtm\'e9nyeknek.
\par 109. \'c9s Allah\'e9 mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van, \'e9s Allahhoz vitetnek vissza az \'fcgyek [d\'f6nt\'e9sre].
\par 
\par 110. Ti vagytok a legjobb k\'f6z\'f6ss\'e9g, mely az emberek sz\'e1m\'e1ra el\'f5hozatott, felsz\'f3l\'edtotok a hely\'e9nval\'f3ra, \'e9s megtiltj\'e1tok az elvetend\'f5t, \'e9s hisztek Allahban. \'c9s ha az \'cdr\'e1s n\'e9
pe hinne, bizony jobb lenne nekik. Vannak k\'f6zt\'fck h\'edv\'f5k, \'e1m a legt\'f6bbj\'fck engedetlen.
\par 111. Nem fognak \'e1rtani nektek, csup\'e1n kev\'e9s b\'e1ntalommal! \'c9s ha harcolnak ellenetek, h\'e1tukat fogj\'e1k ford\'edtani fel\'e9tek (megfutamodnak), azut\'e1n nem lesznek megseg\'edtve.
\par 112. \'c9s r\'e1juk vettetik a megal\'e1ztat\'e1s, ak\'e1rhol lelnek r\'e1juk, kiv\'e9ve, ha [v\'e9delmezi \'f5ket] Allaht\'f3l \'e9s az emberekt\'f5l val\'f3 k\'f6tel\'e9k (egyezs\'e9g). \'c9s magukra vont\'e1k Allah haragv\'e1s\'e1t, \'e9s nyomor\'fas
\'e1g vettetett r\'e1juk. Ez az\'e9rt volt, mert [sorozatosan] }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak}{\insrsid14643188\charrsid14643188  Allah jeleivel szemben, \'e9s jogtalanul meg\'f6lt\'e9k a pr\'f3f\'e9t\'e1kat, \'e9s az\'e9
rt, mert ellenszeg\'fcltek, \'e9s t\'falkap\'e1sra vetemedtek.
\par 113. \'d5k nem egyform\'e1k: az \'cdr\'e1s n\'e9pe k\'f6z\'f6tt van egyenesen j\'e1r\'f3 k\'f6z\'f6ss\'e9g, akik recit\'e1lj\'e1k Allah jeleit (szavait) az \'e9jszaka \'f3r\'e1iban, \'e9s leborulnak (im\'e1dkoznak).
\par 114. Hisznek Allahban \'e9s az Utols\'f3 Napban, felsz\'f3l\'edtanak a hely\'e9nval\'f3ra, megtiltj\'e1k az elvetend\'f5t, \'e9s sietve  igyekeznek a j\'f3tettekben. \'d5k a j\'f3 emberek k\'f6z\'e9 tartoznak.
\par 115. Ami j\'f3t tesznek, az nem lesz t\'f5l\'fck eltagadva. Allahnak tudom\'e1sa van az istenf\'e9l\'f5kr\'f5l.
\par 
\par 116. Bizony, akik megtagadj\'e1k a hitet, azoknak semmit sem haszn\'e1l majd a vagyonuk, sem a gyermekeik Allahhal szemben, \'e9s azok a [Pokol-] t\'fbz lak\'f3i lesznek, \'f5k \'f6r\'f6kk\'e9 abban fognak maradni.
\par 117. Amit ebben az evil\'e1gi \'e9letben k\'f6ltenek, hasonlatos a jeges sz\'e9lhez, amely les\'fajt egy olyan n\'e9p sz\'e1nt\'f3f\'f6ldj\'e9re, akik igazs\'e1gtalans\'e1got k\'f6vettek el magukkal szemben, \'e9s elpuszt\'edtja [a term\'e9st]. \'c1
m Allah nem k\'f6vetett el ellen\'fck igazs\'e1gtalans\'e1got, hanem saj\'e1t magukkal voltak igazs\'e1gtalanok.
\par 
\par 118. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne tegyetek meg bizalmas tan\'e1csad\'f3kk\'e1 magatokon k\'edv\'fcl [m\'e1sokat], hiszen azok nem sajn\'e1lnak [semmi] f\'e1rads\'e1
got, hogy z\'fbrzavart okozzanak k\'f6z\'f6ttetek, \'e9s azt szeretn\'e9k, ha neh\'e9z helyzetbe ker\'fcln\'e9tek! M\'e1r megnyilv\'e1nult a gy\'fbl\'f6let a sz\'e1jukb\'f3l, \'e9s amit a kebl\'fck rejt [a gy\'fbl\'f6letb\'f5l], m\'e9g nagyobb! M\'e1r vil
\'e1goss\'e1 tett\'fck sz\'e1motokra a jeleket, ha val\'f3ban \'e9ln\'e9tek az eszetekkel.
\par 119. \'cdme, ti vagytok azok, akik szeretitek \'f5ket, de \'f5k nem szeretnek titeket, \'e9s ti hisztek az \'f6sszes \'cdr\'e1sban [ellent\'e9tben vel\'fck]. \'c9s amikor tal\'e1lkoznak veletek, azt mondj\'e1k: \'84Hisz\'fcnk\'94, \'e1m amikor [egym\'e1
s k\'f6zt] egyed\'fcl maradnak, ir\'e1ntatok \'e9rzett d\'fch\'fckben r\'e1harapnak az ujjhegyeikre. Mondd [\'f3 Mohamed]: \'84Haljatok bele a d\'fch\'f6t\'f6kbe!\'94 Bizony, Allahnak tudom\'e1sa van arr\'f3l, amit a keblek rejtenek.
\par 120. Ha valami j\'f3 \'e9r titeket, elszomor\'edtja \'f5ket, \'e1m ha valami rossz s\'fajt titeket, annak \'f6rvendeznek. De ha t\'fcrelmesek \'e9s istenf\'e9l\'f5k vagytok, akkor semmit sem \'e1rt nektek az \'f5 fondorlatuk. Bizony, Allah [a tud\'e1s\'e1
val] k\'f6r\'fclveszi mindazt, amit cselekszenek.
\par 
\par 121. [Eml\'e9kezz arra] amikor kora reggel indult\'e1l el a csal\'e1dodt\'f3l, hogy kijel\'f6ld a h\'edv\'f5knek a [megfelel\'f5] \'e1ll\'e1saikat a harcra (Uhudn\'e1l), \'e9s Allah Mindent Hall\'f3, Mindentud\'f3!
\par 122. Amikor arra hajlott k\'e9t csapat k\'f6z\'fcletek, hogy megh\'e1tr\'e1ljanak, \'e1m Allah a p\'e1rtfog\'f3juk volt [Aki megg\'e1tolta \'f5ket abban, hogy ezt tegy\'e9k], \'e9s Allahra hagyatkozzanak h\'e1t a h\'edv\'f5k!
\par 123. \'c9s bizony, Allah m\'e1r gy\'f5zelemre vitt titeket Bedr-n\'e9l, amikor gyeng\'e9k voltatok. F\'e9lj\'e9tek h\'e1t Allahot, h\'e1tha h\'e1l\'e1sak lesztek!
\par 124. [Eml\'e9kezz, \'f3 Mohamed arra,] amikor azt mondtad a h\'edv\'f5knek: \'84Vajon nem el\'e9g az sz\'e1motokra, ha Uratok h\'e1romezer lek\'fcld\'f6tt angyallal er\'f5s\'edt meg titeket?\'94
\par 125. Bizony, hogy igen! Ha t\'fcrelmesek \'e9s istenf\'e9l\'f5k vagytok, m\'e9g ha azonnal indulnak is ellenetek [hogy r\'e1tok t\'e1madjanak], Uratok meger\'f5s\'edt titeket \'f6tezer megjel\'f6lt angyallal.
\par 126. Allah nem m\'e1s\'e9rt tett \'edgy, mint hogy \'f6r\'f6mh\'edr legyen sz\'e1motokra, \'e9s az\'e9rt, hogy megnyugodjon ez\'e1ltal a sz\'edvetek. \'c1m a gy\'f5zelem csup\'e1n a M\'e9lt\'f3s\'e1gteljes \'e9s a B\'f6lcs Allaht\'f3l j\'f6n.
\par 127. Az\'e9rt, hogy lecsapjon egy csoportra azok k\'f6z\'fcl, akik }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak}{\insrsid14643188\charrsid14643188 , vagy meggyal\'e1zza \'f5ket, \'e9s kudarcot vallva t\'e9rjenek vissza.
\par 128. [\'d3 Mohamed!] Nem r\'e1d tartozik a d\'f6nt\'e9s, [hiszen Allah] vagy kiengesztel\'f5dik ir\'e1ntuk [az\'e1ltal hogy igaz \'fatra vezeti \'f5ket], vagy gy\'f6trelemmel s\'fajtja \'f5ket, mert bizony \'f5k igazs\'e1gtalanok.
\par 129. \'c9s Allah\'e9 mindaz, ami az egekben \'e9s ami a f\'f6ld\'f6n van. Annak bocs\'e1t meg, akinek akar, \'e9s azt s\'fajtja gy\'f6trelemmel akit akar. \'c9s Allah Megbocs\'e1t\'f3 \'e9s Irgalmas.
\par 
\par 130. \'d3 ti akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne falj\'e1tok fel a kamatot, t\'f6bbsz\'f6r\'f6sen sokszorozva! \'c9s f\'e9lj\'e9tek Allahot, h\'e1tha boldogulni fogtok!
\par 131. \'c9s \'f3vj\'e1tok magatokat att\'f3l a [Pokol-]t\'fbzt\'f5l, amely el\'f5 van k\'e9sz\'edtve a hitetlenek sz\'e1m\'e1ra!
\par 132. S engedelmeskedjetek Allahnak \'e9s a K\'fcld\'f6ttnek, h\'e1tha k\'f6ny\'f6r\'fcletre leltek!
\par 
\par 133. \'c9s sietve igyekezzetek Uratok megbocs\'e1t\'e1s\'e1hoz \'e9s a Paradicsomhoz, melynek sz\'e9less\'e9ge olyan, mint az egek \'e9s a f\'f6ld [egy\'fctt], amely el\'f5 van k\'e9sz\'edtve az istenf\'e9l\'f5k sz\'e1m\'e1ra,
\par 134. Akik adakoznak j\'f3l\'e9tben \'e9s bajban, \'e9s akik leplezik d\'fch\'fcket, \'e9s eln\'e9z\'f5ek az emberekkel! Allah szereti a j\'f3tev\'f5ket.
\par 135. \'c9s akik, ha f\'f6rtelmes tettet tesznek, vagy igazs\'e1gtalans\'e1got k\'f6vetnek el magukkal szemben, akkor megeml\'e9keznek Allahr\'f3l, \'e9s megbocs\'e1t\'e1st k\'e9rnek a b\'fbneik\'e9rt \endash  \'e9s ki bocs\'e1tan\'e1 meg a v\'e9
tkeket, ha nem Allah? \endash  \'e9s nem lesznek meg\'e1talkodottak abban [a b\'fbnben], amit tesznek, mik\'f6zben tudj\'e1k [hogy Allah elfogadja b\'fbnb\'e1natukat].
\par 136. Az \'f5 fizets\'e9g\'fck Urukt\'f3l val\'f3 megbocs\'e1t\'e1s lesz, \'e9s Kertek [a Paradicsomban], amelyek al\'f3l foly\'f3k folynak, \'e9s \'f6r\'f6kk\'e9 abban fognak maradni. Milyen kit\'fbn\'f5 a [j\'f3t] cselekv\'f5k jutalma!
\par 
\par 137. M\'e1r el\'f5ttetek is v\'e9gbementek [azok a] t\'f6rv\'e9nyszer\'fbs\'e9gek [ahogyan Allah elj\'e1rt a hitetlenekkel]. J\'e1rj\'e1tok h\'e1t be a f\'f6ldet, \'e9s n\'e9zz\'e9tek meg, milyen v\'e9gre jutottak azok, akik meghazudtolt\'e1k [a k\'fcld
\'f6tteket]!
\par 138. Ez (a Kor\'e1n) vil\'e1gos magyar\'e1zat az embereknek, \'fatmutat\'e1s \'e9s int\'e9s az istenf\'e9l\'f5knek.
\par 139. \'c9s ne lankadjatok [az ellens\'e9ggel szemben], \'e9s ne szomorkodjatok [az uhudi veres\'e9g miatt], \'e9s ti vagytok a fel\'fclkereked\'f5k, ha val\'f3ban h\'edv\'f5k vagytok!
\par 140. Ha sebes\'fcl\'e9s \'e9r titeket, nos, \'e9rte m\'e1r hasonl\'f3 sebes\'fcl\'e9s az [ellens\'e9ges] n\'e9pet is. Ezeket [a j\'f3 \'e9s kev\'e9sb\'e9 j\'f3] napokat forgand\'f3v\'e1 tessz\'fck az emberek k\'f6z\'f6tt, hogy Allah nyilv\'e1nval\'f3v\'e1
 tegye azt, amit m\'e1r tudott azokr\'f3l, akik hisznek, \'e9s hogy v\'e9rtan\'fakat v\'e1lasszon k\'f6z\'fcletek. Allah bizony nem szereti az igazs\'e1gtalanokat.
\par 141. \'c9s hogy megtiszt\'edtsa Allah azokat, akik hisznek, \'e9s megsemmis\'edtse a hitetleneket.
\par 142. Vagy azt gondolt\'e1tok, hogy bel\'e9ptek a Paradicsomba, miel\'f5tt Allah nyilv\'e1nval\'f3 tenn\'e9 azt, amit m\'e1r tudott azokr\'f3l, akik k\'fczdenek [\'c9rte] k\'f6z\'fcletek, \'e9s azokr\'f3l, akik t\'fcrelmesek?
\par 143. \'c9s bizony m\'e1r kor\'e1bban k\'edv\'e1nt\'e1tok a [m\'e1rt\'edr]-hal\'e1lt, m\'e9g miel\'f5tt tal\'e1lkoztatok volna vele. S \'edme, most l\'e1thatt\'e1tok, mik\'f6zben [saj\'e1t szemetekkel] n\'e9zt\'e9tek.
\par 144. Mohamed csup\'e1n egy k\'fcld\'f6tt, m\'e1r el\'f5tte is elt\'e1voztak a k\'fcld\'f6ttek [az \'e9l\'f5k sor\'e1b\'f3l]. H\'e1t, hogyha meghalna, vagy meg\'f6letne, akkor sarkon fordultok? \'c1m aki sarkon fordul, az nem \'e1rt semmiben Allahnak, \'e9
s Allah pedig meg fogja adni a fizets\'e9g\'e9t azoknak, akik h\'e1l\'e1t adnak.
\par 
\par 145. Egyetlen ember sem halhat meg, csakis Allah engedelm\'e9vel, egy \'edr\'e1sban [feljegyzett] meghat\'e1rozott id\'f5pontban. Aki az evil\'e1g jutalm\'e1t akarja, annak adunk abb\'f3l. \'c1m aki a t\'falvil\'e1g jutalm\'e1t akarja, annak abb\'f3
l adunk. Meg fogjuk adni a fizets\'e9g\'e9t azoknak, akik h\'e1l\'e1t adnak!
\par 146. H\'e1ny olyan pr\'f3f\'e9ta volt, aki mellett az \'dar sok h\'fb szolg\'e1ja harcolt, \'e9s nem lankadtak el amiatt, ami Allah \'fatj\'e1n \'e9rte \'f5ket, \'e9s nem gyeng\'fcltek el, \'e9s nem al\'e1zkodtak meg. Allah szereti a t\'fcrelmeseket.

\par 147. Csup\'e1n annyit mondtak: \'84Urunk! Bocs\'e1sd meg a b\'fbneinket, \'e9s a m\'e9rt\'e9ktelens\'e9g\'fcnket az \'fcgyeinkben! \'c9s szil\'e1rd\'edtsd meg a l\'e1bainkat, \'e9s vigy\'e9l minket gy\'f5zelemre a hitetlenek n\'e9p\'e9vel szemben!\'94

\par 148. Allah megadta nekik az evil\'e1g jutalm\'e1t \'e9s a m\'e9g szebb t\'falvil\'e1gi jutalmat. Allah szereti a j\'f3tev\'f5ket.
\par 
\par 149. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha engedelmeskedtek azoknak, akik nem hisznek, akkor \'f5k sarkon ford\'edtanak titeket, \'e9s azt\'e1n vesztesekk\'e9nt fogj\'e1tok v\'e9
gezni.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15618338 {\insrsid14643188\charrsid14643188 150. \'c1m Allah a ti P\'e1rtfog\'f3tok}{\insrsid14643188\charrsid15618338 ! }{\insrsid15618338 \'d5
 a legjobb  a seg\'edt\'f5k k\'f6z\'f6tt}{\insrsid14643188\charrsid15618338 !
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\insrsid14643188\charrsid15618338 151. R\'e9m\'fcletet fogunk vetni azoknak a sz\'edv\'e9be, akik h}{\insrsid14643188\charrsid14643188 itetlenn\'e9
 v\'e1ltak, az\'e9rt, mert Allah mell\'e9 t\'e1rsistent \'e1ll\'edtanak, olyasmit, amellyel kapcsolatban [Allah] nem bocs\'e1tott le bizony\'edt\'f3 \'e9rvet. \'c9s a [Pokol-]t\'fbz lesz a hajl\'e9kuk, milyen nyomor\'fas\'e1gos az igazs\'e1
gtalanok otthona!
\par 
\par 152. \'c9s Allah bizony betartotta a nektek tett \'edg\'e9ret\'e9t, amikor levert\'e9tek \'f5ket az \'d5 enged\'e9ly\'e9vel, [eg\'e9szen] addig, am\'edg meg nem h\'e1tr\'e1ltatok, \'e9s \'f6ssze nem k\'fcl\'f6nb\'f6ztetek a parancsot illet\'f5en, \'e9
s ellen nem szeg\'fcltetek, [veres\'e9get szenvedtetek] azut\'e1n, hogy megmutatta nektek, amit szerettetek volna (a gy\'f5zelmet). Van k\'f6z\'f6ttetek olyan, aki az evil\'e1got akarja \'e9s van olyan, aki a t\'falvil\'e1got. Majd elford\'ed
tott titeket t\'f5l\'fck, hogy pr\'f3b\'e1ra tegyen benneteket. \'c1m [Allah] m\'e1r eln\'e9zte [ezt] nektek. \'c9s Allah kegyes a h\'edv\'f5k ir\'e1nt.
\par 153. [Eml\'e9kezzetek arra] amikor felfel\'e9 mentetek [a hegyre], \'e9s nem tekintettetek vissza senkire, mik\'f6zben a K\'fcld\'f6tt m\'f6g\'f6ttetek [a harct\'e9rr\'f5l] h\'edvott [vissza] titeket, [Allah] akkor b\'e1natra b\'e1
nattal jutalmazott meg titeket, hogy ne szomorkodjatok az\'e9rt, amit elmulasztottatok, sem az\'e9rt, ami \'e9rt titeket. Allah j\'f3l ismeri mindazt, amit cselekszetek.
\par 154. Majd a b\'e1nat ut\'e1n biztons\'e1got bocs\'e1tott le r\'e1tok, egy csoportot k\'f6z\'fcletek \'e1lom bor\'edtott be, \'e1m egy [m\'e1sik] csoport saj\'e1t mag\'e1\'e9rt agg\'f3dott, Allahr\'f3l nem az igazs\'e1gnak megfelel\'f5en v\'e9
lekedett, hanem \'fagy, ahogyan a tudatlans\'e1g kor\'e1ban (az iszl\'e1m el\'f5tti korszakban) volt szok\'e1s v\'e9lekedni. Azt mondj\'e1k: \'84Volt-e b\'e1rmi [belesz\'f3l\'e1sunk] az \'fcgybe?\'94 Mondd [\'f3 Mohamed]: \'84Az \'fcgy eg\'e9sz\'e9
ben Allahra tartozik!\'94 Elrejtik magukban azt, amit nem mutatnak ki neked. Azt mondj\'e1k: \'84Ha lett volna b\'e1rmi [belesz\'f3l\'e1sunk] az \'fcgybe, akkor [egyeseket k\'f6z\'fcl\'fcnk] nem \'f6ltek volna itt meg.\'94 Mondd [\'f3 Mohamed]: \'84Ha a h
\'e1zaitokban maradtatok volna, akkor is megjelentek volna a fekhely\'fck\'f6n (a hal\'e1luk hely\'e9n) azok, akiknek meg\'edratott, hogy el kell esni\'fck [a csat\'e1ban].\'94 Az\'e9rt, hogy Allah pr\'f3b\'e1ra tegye azt, ami a kebletekben van, \'e9
s kisz\'fbrje azt, ami a sz\'edvetekben van. \'c9s Allahnak tudom\'e1sa van arr\'f3l, amit a keblek rejtenek.
\par 155. Bizony azok, akik h\'e1tat ford\'edtottak azon a napon, mikor a k\'e9t sereg tal\'e1lkozott, bizony azokat csup\'e1n a s\'e1t\'e1n k\'e9sztette botl\'e1sra azon dolgok egy r\'e9sz\'e9\'e9rt, amit [kor\'e1bban] szereztek. \'c1m Allah m\'e1r eln\'e9
zte [ezt] nekik. Allah bizony Megbocs\'e1t\'f3 \'e9s B\'e9ket\'fbr\'f5!
\par 
\par 156. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne legyetek olyanok, mint azok, akik nem hisznek, \'e9s akik azt mondj\'e1k testv\'e9reikr\'f5l, amikor azok \'fatra kelnek [a meg\'e9lhet
\'e9s\'e9rt], vagy porty\'e1ban vesznek r\'e9szt [\'e9s meghalnak]: \'84Ha n\'e1lunk maradtak volna, nem haltak volna meg, se nem \'f6lt\'e9k volna meg \'f5ket.\'94 [Mindez] az\'e9rt, hogy Allah ezt [a hiedelmet] b\'e1natt\'e1 tegye a sz\'edv\'fc
kben. Allah az, aki \'e9letre kelt \'e9s aki hal\'e1lba k\'fcld. S Allah l\'e1tja mindazt, amit cselekszetek.
\par 157. \'c9s ha Allah \'fatj\'e1n meg\'f6lnek titeket, vagy [csata k\'f6zben] meghaltok, bizony a megbocs\'e1t\'e1s \'e9s a k\'f6ny\'f6r\'fclet Allaht\'f3l jobb ann\'e1l, [mint] amit [az evil\'e1gi javakb\'f3l] \'f6sszegy\'fbjtenek. 
\par 158. \'c9s ha meghaltok, vagy meg\'f6lnek titeket, bizony Allahn\'e1l lesztek egybegy\'fbjtve.
\par 
\par 159. [\'d3 Mohamed!] Allah k\'f6ny\'f6r\'fclete miatt lett\'e9l l\'e1gysz\'edv\'fb ir\'e1ntuk, \'e1m ha durva besz\'e9d\'fb \'e9s kem\'e9nysz\'edv\'fb lett\'e9l volna, akkor sz\'e9tsz\'e9ledtek volna k\'f6r\'fcl\'f6tted. L\'e9gy h\'e1t eln\'e9z\'f5 ir\'e1
ntuk \'e9s k\'e9rj sz\'e1mukra megbocs\'e1t\'e1st! Tan\'e1cskozz vel\'fck az \'fcgyben, majd ha elsz\'e1ntad magad, hagyatkozz Allahra! Allah bizony szereti azokat, akik R\'e1 hagyatkoznak.
\par 160. Ha Allah gy\'f5zelemre visz titeket, akkor nincs, aki gy\'f5zelmet aratna felettetek! \'c1m ha magatokra hagy titeket, akkor ki lenne az, aki gy\'f5zelemre vinne titeket, miut\'e1n \'d5 [magatokra hagyott]? Allahra hagyatkozzanak h\'e1t a h\'edv\'f5
k!
\par 
\par 161. Egy pr\'f3f\'e9ta sem tulajdon\'edthat el [semmit sem a hadizs\'e1km\'e1nyb\'f3l], aki pedig eltulajdon\'edt valamit, az a Felt\'e1mad\'e1s napj\'e1n mag\'e1val hozza azt, amit eltulajdon\'edtott. Majd minden ember [fizets\'e9ge] teljess\'e9 t\'e9
tetik az\'e9rt, amit szerzett, \'e9s nem szenvednek el igazs\'e1gtalans\'e1got.
\par 162. Vajon az, aki k\'f6veti azt, amivel elnyeri Allah el\'e9gedetts\'e9g\'e9t, olyan-e, mint az, aki Allah haragj\'e1t vonta mag\'e1ra, \'e9s a Gyehenna a hajl\'e9ka? Milyen nyomor\'fas\'e1gos v\'e9gc\'e9l!
\par 163. \'d5k [k\'fcl\'f6nb\'f6z\'f5] fokozatokba [sorol\'f3dnak] Allahn\'e1l. \'c9s Allah l\'e1tja mindazt, amit cselekszetek.
\par 
\par 164. Bizony, Allah kegy\'e9ben r\'e9szes\'edtette a h\'edv\'f5ket, amikor t\'e1masztott k\'f6z\'f6tt\'fck egy k\'f6z\'fcl\'fck val\'f3 k\'fcld\'f6ttet, aki recit\'e1lja nekik a jeleit (a szavait), megtiszt\'edtja \'f5ket, megtan\'edtja nekik az \'cdr\'e1
st (a Kor\'e1nt) \'e9s a b\'f6lcsess\'e9get (a t\'f6rv\'e9ny rejtelmeit), b\'e1r kor\'e1bban nyilv\'e1nval\'f3 t\'e9velyg\'e9sben voltak.
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\insrsid14643188\charrsid14643188 165. Vajon amikor olyan csap\'e1s \'e9rt titeket, amelynek k\'e9tszeres\'e9vel s\'fa
jtottatok kor\'e1bban, azt mondt\'e1tok [csod\'e1lkozva]: Hogyan t\'f6rt\'e9nhetett ez? Mondd [\'f3 Mohamed]: \'84Saj\'e1t magatokt\'f3l van!\'94 Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\insrsid14643188\charrsid14643188 166. Ami titeket s\'fajtott azon a napon, amikor a k\'e9t sereg tal\'e1lkozott egym\'e1ssal, az Allah engedelm
\'e9vel t\'f6rt\'e9nt, \'e9s hogy Allah nyilv\'e1nval\'f3v\'e1 tegye azt, amit m\'e1r tudott a h\'edv\'f5kr\'f5l.
\par 167. \'c9s hogy nyilv\'e1nval\'f3v\'e1 tegye azt, amit m\'e1r tudott azokr\'f3l, akik k\'e9pmutat\'f3k voltak, akiknek az mondatik: \'84J\'f6jjetek, harcoljatok Allah \'fatj\'e1n, vagy tarts\'e1tok t\'e1vol [az ellens\'e9get sokas\'e1gotokkal]!\'94
 [Erre v\'e1laszul] azt mondt\'e1k: \'84Ha [biztosan] tudn\'e1nk arr\'f3l, hogy harc lesz, akkor k\'f6vetn\'e9nk titeket.\'94 Azon a napon \'f5k k\'f6zelebb voltak a hitetlens\'e9ghez, mint a hithez. Olyat mondanak a sz\'e1jukkal, ami nincs a sz\'edv\'fc
kben. Allah tudja azt, amit eltitkolnak.
\par 168. Akik azt mondj\'e1k a testv\'e9reiknek, mik\'f6zben otthonaikban maradtak: \'84Ha engedelmeskedtek volna nek\'fcnk, akkor nem \'f6lettek volna meg!\'94 Mondd [\'f3 Mohamed]: \'84H\'e1r\'edts\'e1tok el a hal\'e1lt saj\'e1t magatokr\'f3l, ha val\'f3
ban igazmond\'f3k vagytok!\'94
\par 
\par 169. Ne gondold azokr\'f3l [\'f3 Mohamed], akik meg\'f6lettek Allah \'fatj\'e1n, azt hogy \'f5k halottak! Dehogy! \'c9l\'f5k \'f5k, ell\'e1t\'e1sban r\'e9szes\'fclnek az Urukn\'e1l.
\par 170. \'d6rvendeznek annak, amit Allah adott nekik az \'d5 kegy\'e9b\'f5l, \'e9s \'f6r\'f6mmel tekintenek azokra, akik m\'e9g nem csatlakoztak hozz\'e1juk, \'e9s akiket maguk m\'f6g\'f6tt hagytak, mert [tudj\'e1k], hogy nem lesz \'farr\'e1 rajtuk a f\'e9
lelem [a T\'falvil\'e1gon], \'e9s nem fognak szomorkodni.
\par 171. \'d6r\'f6mmel tekintenek Allah j\'f3t\'e9tem\'e9ny\'e9re \'e9s kegy\'e9re, \'e9s arra, hogy Allah nem hagyja k\'e1rba veszni a h\'edv\'f5k jutalm\'e1t.
\par 172. Akik hallgattak Allahra \'e9s a K\'fcld\'f6ttre, miut\'e1n sebes\'fcl\'e9s (veres\'e9g) \'e9rte \'f5ket, \'e9s akik helyesen cselekedtek \'e9s istenf\'e9lelmet tan\'fas\'edtottak, azoknak hatalmas jutalom j\'e1r.
\par 173. Akiknek az [ellens\'e9ges] emberek azt mondt\'e1k: \'84Bizony az emberek (csapatokban) gy\'fclekeznek ellenetek, f\'e9ljetek h\'e1t t\'f5l\'fck!\'94 \'c1m ez csak gyarap\'edtotta \'f5ket hitben, \'e9s azt mondt\'e1k: \'84Allah elegend\'f5 sz\'e1
munkra! \'c9s milyen j\'f3 \'d5 v\'e9delmez\'f5nek!\'94
\par 174. \'cdgy h\'e1t Allah j\'f3t\'e9tem\'e9ny\'e9vel \'e9s kegy\'e9vel t\'e9rtek vissza, nem \'e9rte \'f5ket semmi rossz, \'e9s k\'f6vett\'e9k azt, amivel elnyert\'e9k Allah el\'e9gedetts\'e9g\'e9t. \'c9s Allah kegye hatalmas.
\par 175. Bizony, ez csup\'e1n a S\'e1t\'e1n, f\'e9lelmet akar kelteni p\'e1rtfogoltjaiban. Ne f\'e9ljetek h\'e1t t\'f5l\'fck, hanem Engem f\'e9ljetek, ha val\'f3ban h\'edv\'f5k vagytok!
\par 
\par 176. Ne szomor\'edtsanak el [\'f3 Mohamed] azok, akik versengenek a hitetlens\'e9gben! \'d5k semmiben sem lehetnek Allahnak k\'e1r\'e1ra. Allah azt akarja, hogy nekik a t\'falvil\'e1gon ne legyen r\'e9szesed\'e9s\'fck. Hatalmas gy\'f6trelem j\'e1r nekik.

\par 177. Bizony azok, akik megv\'e1s\'e1rolt\'e1k a hitetlens\'e9get a hit\'e9rt cser\'e9be, azok semmiben sem lesznek Allah k\'e1r\'e1ra. F\'e1jdalmas gy\'f6trelem j\'e1r nekik.
\par 178. Ne gondolj\'e1k azok, akik }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak}{\insrsid14643188\charrsid14643188 , hogy mi csup\'e1n az\'e9rt adunk halad\'e9kot nekik, mert az j\'f3 maguk sz\'e1m\'e1ra! [Ellenkez\'f5leg] Mi csup\'e1n az
\'e9rt adunk halad\'e9kot nekik, hogy gyarapodjanak b\'fbnben! \'c9s megal\'e1z\'f3 gy\'f6trelem j\'e1r nekik.
\par 179. Allah nem hagyja a h\'edv\'f5ket abban a helyzetben, amiben [most] ti vagytok (keveredve a k\'e9pmutat\'f3kkal) addig, am\'edg nem teszi [a megpr\'f3b\'e1ltat\'e1sok \'e1ltal] megk\'fcl\'f6nb\'f6ztethet\'f5v\'e9 a hitv\'e1nyat (a k\'e9pmutat\'f3
t) a j\'f3t\'f3l (az igazh\'edv\'f5t\'f5l). Allah sosem fedi fel el\'f5ttetek a rejtett dolgokat, ellenben Allah azt v\'e1lasztja ki a k\'fcld\'f6ttei k\'f6z\'fcl, akit akar. Higgyetek Allahban \'e9s a K\'fcld\'f6tteiben! \'c9s ha hisztek, \'e9s istenf
\'e9lelmet tan\'fas\'edtotok, akkor nektek hatalmas jutalomban lesz r\'e9szetek!
\par 180. Akik fukarkodnak azzal, amit Allah az \'f5 kegy\'e9b\'f5l adott nekik, azok ne gondolj\'e1k, hogy az j\'f3 nekik! Dehogy! Az rossz nekik. A nyakuk k\'f6r\'e9 lesz tekerve a Felt\'e1mad\'e1s Napj\'e1n az, amivel fukarkodtak. Allah\'e9 az egek \'e9
s a f\'f6ld \'f6r\'f6ks\'e9ge. Allah j\'f3l ismeri mindazt, amit cselekszetek.
\par 
\par 181. Allah bizony hallotta azok besz\'e9d\'e9t, akik azt mondt\'e1k: \'84Allah bizony nincstelen, \'e1m mi gazdagok vagyunk!\'94 Feljegyezz\'fck, amit mondtak, \'e9s hogy jogtalanul \'f6lt\'e9k meg a pr\'f3f\'e9t\'e1kat, \'e9s azt mondjuk majd: \'84\'cd
zlelj\'e9tek meg az \'c9get\'f5 [Pokol-]t\'fbz gy\'f6trelm\'e9t!\'94
\par 182. Ez [a fizets\'e9getek] az\'e9rt, amit a kezetek elk\'f6vetett, \'e9s Allah bizony nem igazs\'e1gtalan a szolg\'e1kkal (a teremtm\'e9nyekkel).
\par 183. Azok [besz\'e9d\'e9t is hallotta], akik azt mondt\'e1k: \'84Allah bizony meghagyta nek\'fcnk, hogy ne higgy\'fcnk egyetlen k\'fcld\'f6ttnek sem, am\'edg az nem hoz nek\'fcnk olyan \'e1ldozatot, amelyet felem\'e9szt [az \'e9gb\'f5l al\'e1sz\'e1ll\'f3
] t\'fbz.\'94 Mondd [\'f3 Mohamed]: \'84Imm\'e1r elj\'f6ttek el\'f5ttem k\'fcld\'f6ttek hozz\'e1tok a vil\'e1gos bizony\'edt\'e9kokkal, \'e9s azzal, amit ti mondtatok. H\'e1t mi\'e9rt \'f6lt\'e9tek meg \'f5ket, ha val\'f3ban igazmond\'f3k vagytok?\'94

\par 184. \'c9s ha meghazudtoltak t\'e9ged, h\'e1t m\'e1r meg lettek hazudtolva el\'f5tted m\'e1s k\'fcld\'f6ttek is, akik a vil\'e1gos bizony\'edt\'e9kokkal, a k\'f6nyvekkel \'e9s a vil\'e1goss\'e1got ad\'f3 \'cdr\'e1ssal j\'f6ttek el.
\par 
\par 185. Minden ember meg\'edzleli a hal\'e1lt. \'c9s csup\'e1n a Felt\'e1mad\'e1s Napj\'e1n kapj\'e1tok meg teljes m\'e9rt\'e9kben jutalmaitokat. Akit pedig t\'e1vol tartanak a [Pokol-]t\'fbzt\'f5l \'e9s bebocs\'e1t\'e1
st nyer a Paradicsomba, bizony diadalt arat. Az evil\'e1gi \'e9let csup\'e1n megt\'e9veszt\'f5 [muland\'f3] \'e9lvezet. 
\par 186. Bizony pr\'f3b\'e1ra lesztek t\'e9ve a vagyonotokat \'e9s saj\'e1t magatokat illet\'f5en. \'c9s sok b\'e1nt\'f3 besz\'e9det fogtok hallani azokt\'f3l, akiknek el\'f5ttetek adatott az \'cdr\'e1s, \'e9s azokt\'f3l, akik [Allah mell\'e9] t\'e1rsistent 
\'e1ll\'edtanak. \'c9s ha t\'fcrelmesek \'e9s istenf\'e9l\'f5k vagytok, bizony ezek az elsz\'e1nts\'e1got [k\'f6vetel\'f5] dolgok k\'f6z\'e9 tartoznak [ami\'e9rt megjutalmaztattok].
\par 
\par 187. [Eml\'edtsd meg,] amikor Allah sz\'f6vets\'e9get k\'f6t\'f6tt azokkal, akiknek az \'cdr\'e1s adatott: \'84Tegy\'e9tek vil\'e1goss\'e1 az emberek sz\'e1m\'e1ra, \'e9s ne rejts\'e9tek el!\'94 \'c1m \'f5k a h\'e1tuk m\'f6g\'e9 dobt\'e1k azt, \'e9s elk
\'f3tyavety\'e9lt\'e9k azt csek\'e9ly \'e1ron. Mily nyomor\'fas\'e1gos az, amit vettek!
\par 188. Ne gondold, hogy azok, akik \'f6rvendeznek annak, amit elk\'f6vettek, \'e9s szeretn\'e9k, ha olyan\'e9rt dics\'e9rn\'e9k \'f5ket, amit nem tettek, nos ne gondold, hogy megmenek\'fclhetnek a gy\'f6trelemt\'f5l! \'c9s nekik f\'e1jdalmas gy\'f6
trelemben lesz r\'e9sz\'fck.
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\insrsid14643188\charrsid14643188 189. Allah\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6
ld felett. Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 {\insrsid14643188\charrsid14643188 190. Bizony, az egek \'e9s a f\'f6ld megteremt\'e9s\'e9ben, \'e9s az \'e9jszaka \'e9s a nappal v\'e1ltakoz\'e1s
\'e1ban jelek vannak az \'e9rtelemmel b\'edr\'f3knak. 
\par 191. Akik megeml\'e9keznek Allahr\'f3l \'e1llva, \'fclve \'e9s az oldalukon [fekve], \'e9s elgondolkodnak az egek \'e9s a f\'f6ld teremt\'e9s\'e9n, (\'e9s azt mondj\'e1k:) \'84Urunk! Te nem teremtetted mindezt c\'e9ltalanul! Magasztaltass\'e1l, \'f3vj h
\'e1t meg minket a [Pokol-]t\'fbz gy\'f6trelm\'e9t\'f5l!
\par 192. Urunk! Akit a [Pokol-]t\'fbzbe bocs\'e1tasz be, azt bizony megsz\'e9gyen\'edted, \'e9s az igazs\'e1gtalanoknak nem lesznek seg\'edt\'f5ik!
\par 193. Urunk! Mi hallottunk egy h\'edv\'f3t, aki a hitre h\'edv: \'84Higgyetek Uratokban!\'94 \'c9s mi hitt\'fcnk! Urunk! Bocs\'e1sd meg nek\'fcnk b\'fbneinket, \'e9s t\'f6r\'f6ld el nek\'fcnk [kisebb] rossztetteinket, \'e9s a j\'f3s\'e1gosakkal egy\'fc
tt sz\'f3l\'edts magadhoz!
\par 194. Urunk! Add meg nek\'fcnk azt, amit a k\'fcld\'f6tteid \'e1ltal \'edg\'e9rt\'e9l nek\'fcnk, \'e9s ne sz\'e9gyen\'edts meg minket a Felt\'e1mad\'e1s Napj\'e1n! Bizony Te nem szeged meg az \'edg\'e9retet!\'94
\par 195. Az Uruk pedig meghallgatta \'f5ket: \'84\'c9n nem hagyom k\'e1rba veszni egyetlen cselekv\'f5 cselekedet\'e9t sem k\'f6z\'fcletek, [legyen] ak\'e1r f\'e9rfi, ak\'e1r n\'f5, hiszen egyik\'f5t\'f6k a m\'e1sikt\'f3l (sz\'e1rmazik). \'c9s azok, akik elv
\'e9gezt\'e9k a kiv\'e1ndorl\'e1st (a Hidzsr\'e1t), ki\'fbzettek a lakhelyeikr\'f5l, \'e9s b\'e1ntalmaz\'e1st szenvedtek el az \'e9n Utamon, harcoltak \'e9s meg\'f6lettek, elengedem nekik a rossz tetteiket \'e9s olyan Kertekbe bocs\'e1tom be \'f5
ket, amelyek alatt foly\'f3k folynak. Ezt Allaht\'f3l sz\'e1rmaz\'f3 jutalomk\'e9nt (kapj\'e1k)! \'c9s Allahn\'e1l van a legszebb jutalom!\'94
\par 
\par 196. Ne t\'e9vesszen meg t\'e9ged, hogy azok, akik }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak}{\insrsid14643188\charrsid14643188 , [j\'f3l\'e9t\'fckben] j\'e1rnak-kelnek az orsz\'e1gban!
\par 197. [Ez] csek\'e9ly [muland\'f3] \'e9lvezet. Majd a Gyehenna lesz a hajl\'e9kuk! \'c9s milyen nyomor\'fas\'e1gos fekhely az!
\par 198. \'c1m azoknak, akik f\'e9lik Urukat, kertjeik lesznek (a Paradicsomban), amelyek alatt foly\'f3k folynak, \'f6r\'f6kk\'e9 abban fognak maradni, sz\'e1ll\'e1shely\'fcl Allaht\'f3l. Ami Allahn\'e1l van, az jobb a j\'f3s\'e1gosak sz\'e1m\'e1ra.
\par 
\par 199. \'c9s bizony az \'cdr\'e1s birtokosai k\'f6z\'fcl vannak olyanok, akik hisznek Allahban, \'e9s abban, ami lebocs\'e1ttatott nektek, \'e9s abban is, ami nekik bocs\'e1ttatott le, \'e1h\'edtatosak Allah ir\'e1nt, \'e9s nem k\'f3tyavety\'e9
lik el Allah jeleit csek\'e9ly \'e1ron. Az \'f5 jutalmuk az Urukn\'e1l lesz. Bizony, Allah gyors az elsz\'e1moltat\'e1sban!
\par 200. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Legyetek t\'fcrelmesek, tartsatok ki, \'e9s maradjatok \'f5rhelyeiteken \'e9s f\'e9lj\'e9tek Allahot! H\'e1tha boldogultok.
\par 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid14643188 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\f0\fs24\insrsid14643188\charrsid14643188 \page 4. A n\'f5k [An-Nisz\'e1] c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid14643188\charrsid14643188 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. \'d3, ti emberek! F\'e9lj\'e9tek Uratokat, aki egyetlen emberb\'f5l teremtett meg titeket, \'e9s abb\'f3l megteremtette a p\'e1rj\'e1t, \'e9s kettej\'fckb\'f5l sok f\'e9rfit \'e9s n\'f5t sz\'f3rt sz\'e9t! \'c9s f\'e9lj\'e9tek Allahot, akinek a nev\'e9
ben szokt\'e1tok egym\'e1st k\'e9rni, \'e9s [\'f3vakodjatok] a rokons\'e1gi k\'f6tel\'e9k [megszak\'edt\'e1s\'e1t\'f3l]! Allah bizony figyel titeket.
\par 
\par 2. \'c9s adj\'e1tok meg az \'e1rv\'e1knak [a r\'e1tok b\'edzott] vagyonukat (\'e9rett\'e9 v\'e1l\'e1sukkor), \'e9s ne cser\'e9lj\'e9tek el hitv\'e1ny dolgaitokat j\'f3 dolgaikra! \'c9s ne falj\'e1tok fel az \'f5 vagyonukat a ti vagyonaitokhoz (hozz\'e1
csapva)! Bizony, nagy b\'fbn ez.
\par 3. \'c9s ha att\'f3l f\'e9ltek, hogy nem tudtok igazs\'e1gosan b\'e1nni az \'e1rv\'e1kkal, akkor h\'e1zasodjatok [m\'e1sokkal] a nektek tetsz\'f5 asszonyok k\'f6z\'fcl, kett\'f5vel, h\'e1rommal, vagy n\'e9ggyel. \'c1m ha att\'f3l f\'e9
ltek, hogy nem tudtok igazs\'e1gosak lenni, akkor csak eggyel, vagy azzal, akit a jobb kezetek birtokol! Ez k\'f6zelebb \'e1ll ahhoz, hogy ne legyetek igazs\'e1gtalanok.
\par 4. \'c9s adj\'e1tok oda j\'f3 sz\'edvvel az asszonyoknak n\'e1szaj\'e1nd\'e9kukat! Ha sz\'edvesen [lemondanak] annak egy r\'e9sz\'e9r\'f5l sz\'e1motokra, (akkor) haszn\'e1lj\'e1tok fel eg\'e9szs\'e9ggel \'e9s k\'f6nnyebbs\'e9ggel!
\par 5. \'c9s ne adj\'e1tok oda a korl\'e1tolt \'e9rtelm\'fbeknek [a r\'e1tok b\'edzott] vagyonukat, amelyeket Allah nektek fenntart\'e1s gyan\'e1nt adott! T\'e1pl\'e1lj\'e1tok \'e9s ruh\'e1zz\'e1tok abb\'f3l \'f5ket, \'e9s mondjatok nekik hely\'e9nval\'f3
 szavakat!
\par 6. \'c9s tegy\'e9tek pr\'f3b\'e1ra az \'e1rv\'e1k [\'e9rtelmi k\'e9pess\'e9geit], am\'edg el nem \'e9rik a h\'e1zasod\'e1s [idej\'e9t]! Ha \'e9retts\'e9get tapasztaltok a r\'e9sz\'fckr\'f5l, akkor adj\'e1tok \'e1t nekik a vagyonukat! \'c9s ne falj\'e1tok
 fel pazarl\'f3an \'e9s sietve (att\'f3l f\'e9lve), hogy nagykor\'fav\'e1 v\'e1lnak! Az, aki gazdag, az tart\'f3ztassa meg mag\'e1t [nehogy fel\'e9lje az \'e1rv\'e1k vagyon\'e1t], aki pedig nincstelen, az illend\'f5 m\'f3don haszn\'e1lja! \'c9
s amikor odaadj\'e1tok nekik a vagyonukat, h\'edvjatok tan\'fakat [a vagyon \'e1tad\'e1s\'e1ra]! \'c9s elegend\'f5 Allah elsz\'e1moltat\'f3nak!
\par 
\par 7. A f\'e9rfiaknak j\'e1r egy r\'e9sz abb\'f3l, amit a sz\'fcl\'f5k \'e9s a k\'f6zeli rokonok hagynak h\'e1tra. \'c9s a n\'f5knek [is] j\'e1r egy r\'e9sz abb\'f3l, amit a sz\'fcl\'f5k \'e9s a k\'f6zeli rokonok hagynak h\'e1tra, legyen az kev\'e9
s, avagy sok \endash  el\'f5\'edrt r\'e9szk\'e9nt (j\'e1r nekik).
\par 8. \'c9s ha [az \'f6r\'f6ks\'e9g] eloszt\'e1s\'e1n\'e1l [t\'e1voli] rokonok, \'e1rv\'e1k \'e9s szeg\'e9nyek vannak jelen, l\'e1ss\'e1tok el \'f5ket abb\'f3l, \'e9s mondjatok nekik hely\'e9nval\'f3 szavakat!
\par 9.\'c9s f\'e9ljenek azok (a gy\'e1mok) [az \'e1rv\'e1k megr\'f6vid\'edt\'e9s\'e9nek k\'f6vetkezm\'e9ny\'e9t\'f5l, \'e9s b\'e1njanak j\'f3l vel\'fck, \'fagy ahogyan szeretn\'e9k, hogy b\'e1njanak] a h\'e1trahagyott gyenge (v\'e9delemre szorul\'f3) ut\'f3
daikkal, akiket f\'e9lten\'e9nek! F\'e9lj\'e9k h\'e1t Allahot, \'e9s mondjanak egyenes besz\'e9det!
\par 10. Bizony, akik felfalj\'e1k az \'e1rv\'e1k vagyon\'e1t igazs\'e1gtalanul, azok bizony csup\'e1n t\'fbzzel t\'f6mik a hasukat, \'e9s \'e9gni fognak a L\'e1ngol\'f3 [Pokol-t\'fbzben]!
\par 
\par 11. Allah meghagyja nektek a gyermekeitek [\'f6r\'f6ks\'e9g\'e9vel] kapcsolatban: A fi\'fagyermeket annyi illeti meg, mint amennyi k\'e9t le\'e1nygyermek r\'e9sze. Ha csak n\'f5k (le\'e1nygyermekek) vannak, m\'e9gpedig ketten vagy t\'f6bben, akkor nekik k
\'e9t harmad j\'e1r a hagyat\'e9kb\'f3l; de ha csak egy l\'e1ny van, akkor a fele j\'e1r neki. Mindk\'e9t sz\'fcl\'f5nek egyhatod j\'e1r a hagyat\'e9kb\'f3l, ha [az \'f6r\'f6khagy\'f3nak] van gyermeke. Ha pedig nincs gyermeke, \'e9s a sz\'fclei \'f6r\'f6k
\'f6lnek t\'f5le, akkor az anyj\'e1nak egyharmad j\'e1r (a fennmarad\'f3 r\'e9sz pedig az ap\'e1nak). Ha azonban vannak fiv\'e9rei, akkor az anyj\'e1nak egyhatod j\'e1r (a fennmarad\'f3 r\'e9sz pedig az ap\'e1nak). [Mindez] az [egy\'e9b] v\'e9grendelkez
\'e9s vagy az ad\'f3ss\'e1g rendez\'e9se ut\'e1n [t\'f6rt\'e9nik]. Ap\'e1itok \'e9s gyermekeitek k\'f6z\'fcl ti nem tudhatj\'e1tok, hogy melyik\'fck \'e1ll k\'f6zelebb hozz\'e1tok a hasznoss\'e1gban. Allaht\'f3l sz\'e1rmaz\'f3 el\'f5\'edr\'e1
s ez. Allah Mindentud\'f3, B\'f6lcs.
\par 12. Nektek a feles\'e9getek hagyat\'e9k\'e1nak a fele j\'e1r, ha nem volt nekik gyermek\'fck. Ha pedig van gyermek\'fck, akkor nektek a hagyat\'e9kuk negyede j\'e1r, az [egy\'e9b] v\'e9grendelkez\'e9s vagy az ad\'f3ss\'e1g rendez\'e9se ut\'e1n. \'c9
s nekik (a feles\'e9geknek) a negyede j\'e1r a ti hagyat\'e9kotoknak, ha nincs gyermeketek. Ha van gyermeketek, akkor nekik a nyolcada j\'e1r a ti hagyat\'e9kotoknak, az [egy\'e9b] v\'e9grendelkez\'e9s vagy az ad\'f3ss\'e1g rendez\'e9se ut\'e1n. Ha egy f
\'e9rfi vagy egy n\'f5, akinek nincs se gyermeke, se sz\'fcl\'f5je, de van neki [anyai \'e1gr\'f3l] fiv\'e9re vagy n\'f5v\'e9re, akkor mindegyik\'f5j\'fcknek az egyhatod j\'e1r. Ha enn\'e9l t\'f6bben vannak, akkor osztozzanak egyenl\'f5
en az egyharmadban, az [egy\'e9b] v\'e9grendelkez\'e9s vagy az ad\'f3ss\'e1g rendez\'e9se ut\'e1n, nem \'e1rtva [az \'f6r\'f6k\'f6s\'f6knek]. Allah \'e1ltali rendelkez\'e9s ez. Allah Mindentud\'f3, B\'e9ket\'fbr\'f5.
\par 
\par 13. Ezek az Allah [\'e1ltal kijel\'f6lt] hat\'e1rok. \'c9s aki Allahnak \'e9s az \'d5 K\'fcld\'f6tt\'e9nek engedelmeskedik, azt olyan kertekbe (a Paradicsomba) bocs\'e1tja be, amelyek alatt foly\'f3k folynak. \'d6r\'f6kk\'e9 abban fognak maradni. Ez \'e1
m a hatalmas diadal!
\par 14. Aki pedig ellenszeg\'fcl Allahnak \'e9s az \'d5 K\'fcld\'f6tt\'e9nek, \'e9s \'e1th\'e1gja az [\'d5\'e1ltala kijel\'f6lt] hat\'e1rokat, azt a [Pokol-]t\'fcz\'e9be bocs\'e1tja be. \'d6r\'f6kk\'e9 abban fog maradni, \'e9s megal\'e1z\'f3 gy\'f6
trelemben lesz r\'e9sze.
\par 
\par 15. Akik az asszonyaitok k\'f6z\'fcl f\'f6rtelmes tettet k\'f6vetnek el (par\'e1zn\'e1lkodnak), azokkal szemben h\'edvjatok n\'e9gy tan\'fat magatok k\'f6z\'fcl! \'c9s ha tan\'fas\'e1got tettek, z\'e1rj\'e1tok el (az asszonyokat) a h\'e1zukba, am\'ed
g a hal\'e1l el nem sz\'f3l\'edtja \'f5ket, vagy Allah nem jel\'f6l ki m\'e1s utat (t\'f6rv\'e9nyt) sz\'e1mukra!
\par 16. \'c9s azt a kett\'f5t, akik elk\'f6vetik [a par\'e1znas\'e1got] k\'f6z\'fcletek, b\'e1nts\'e1tok mindkett\'f5j\'fcket [elrettent\'e9s\'fcl]! \'c1m ha b\'fbnb\'e1natot tan\'fas\'edtanak \'e9s javul\'e1st hoznak, forduljatok h\'e1t el t\'f5l\'fck (hagyj
\'e1tok \'f5ket)! Bizony Allah Kiengesztel\'f5d\'f5, Irgalmas.
\par 
\par 17. Bizony, a b\'fbnb\'e1nat elfogad\'e1sa Allah r\'e9sz\'e9r\'f5l csup\'e1n azokat illeti meg, akik tudatlans\'e1gb\'f3l cselekedtek rosszat, \'e1m r\'f6viddel azut\'e1n b\'fbnb\'e1natot tan\'fas\'edtanak. \'c9s Allah kiengesztel\'f5dik azok ir\'e1nt. A
llah Mindentud\'f3, B\'f6lcs.
\par 18. A b\'fbnb\'e1nat elfogad\'e1sa azonban nem illeti meg azokat, akik [meg\'e1talkodottan] rossz tetteket cselekszenek, eg\'e9szen addig, am\'edg el nem j\'f6n valamelyik\'fck\'e9rt a hal\'e1l, [\'e9s csak akkor] mondja: \'84Bizony, most b\'fbnb\'e1
natot tan\'fas\'edtok!\'94 \'c9s azokat sem illeti meg, akik hitetlenk\'e9nt halnak meg. Nekik f\'e1jdalmas gy\'f6trelmet k\'e9sz\'edtett\'fcnk el\'f5!
\par 
\par 19. \'d3, ti akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Nem megengedett a sz\'e1motokra, hogy \'f6r\'f6k\'f6lj\'e9tek [f\'e9rfi rokonaitok] asszonyait akaratuk ellen\'e9re. \'c9s ne akad\'e1lyozz
\'e1tok \'f5ket az \'fajabb h\'e1zass\'e1gban az\'e9rt, hogy elvehessetek valamennyit abb\'f3l, amit kor\'e1bban adtatok nekik. Kiv\'e9ve, ha nyilv\'e1nval\'f3 f\'f6rtelmes tettet k\'f6vettek el (par\'e1zn\'e1lkodtak). \'c9s \'e9ljetek egy\'fctt vel\'fc
k hely\'e9nval\'f3 m\'f3don, \'e9s ha megut\'e1lj\'e1tok \'f5ket, h\'e1t meglehet, hogy olyan dolgot ut\'e1ltok meg, amibe Allah sok j\'f3t helyezett.
\par 20. Ha egy asszony helyett egy m\'e1sik asszonyt akartok feles\'e9g\'fcl venni, \'e9s egyik\'fcknek (az els\'f5nek) m\'e1r adtatok egy halomnyi [n\'e1szaj\'e1nd\'e9kot], ne vegyetek vissza abb\'f3l semmit. Vajon visszavenn\'e9tek azt igazs\'e1gtalanul 
\'e9s nyilv\'e1nval\'f3 b\'fbnk\'e9nt?
\par 21. Hogyan vehetn\'e9tek azt vissza, miut\'e1n egym\'e1ssal h\'e1ltatok, \'e9s \'f5k szil\'e1rd sz\'f6vets\'e9get k\'f6t\'f6ttek veletek?
\par 
\par 22. Ne vegyetek feles\'e9g\'fcl olyan asszonyokat, akiket ap\'e1itok vettek el, kiv\'e9ve, ha [a h\'e1zass\'e1g] a m\'faltban t\'f6rt\'e9nt [mert akkor nem lesztek sz\'e1mon k\'e9rve]! Bizony, ez f\'f6rtelmes tett, [mennyire] gy\'fbl\'f6letes dolog, \'e9
s milyen rossz \'fat!
\par 23. Tilalmass\'e1 t\'e9tettek sz\'e1motokra [h\'e1zast\'e1rsnak] any\'e1itok, l\'e1nyaitok, n\'f5v\'e9reitek, apai nagyn\'e9njeitek, anyai nagyn\'e9njeitek, fiv\'e9reitek l\'e1nyai, \'e9s n\'f5testv\'e9reitek l\'e1nyai, \'e9s any\'e1itok (dajk\'e1
itok), akik szoptattak titeket, \'e9s tejtestv\'e9reitek, asszonyaitok anyjai, \'e9s a gondnoks\'e1gotok al\'e1 ker\'fclt mostohal\'e1nyaitok, akik azokt\'f3l az asszonyaitokt\'f3l sz\'fclettek, akikkel m\'e1r egy\'fctt h\'e1ltatok; \'e1m ha m\'e9g nem h
\'e1ltatok egy\'fctt vel\'fck, akkor [a l\'e1nyukkal val\'f3 h\'e1zass\'e1g miatt] nem terhel titeket v\'e9ts\'e9g. [Tilalmasak tov\'e1bb\'e1] saj\'e1t \'e1gy\'e9kaitokb\'f3l sz\'e1rmaz\'f3 fiaitok feles\'e9gei, tov\'e1bb\'e1 az, hogy h\'e1zass\'e1gban 
\'e9ljetek k\'e9t le\'e1nytestv\'e9rrel egy id\'f5ben, kiv\'e9ve, ha az (a h\'e1zass\'e1g) a m\'faltban t\'f6rt\'e9nt. Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 24. \'c9s [tilalmass\'e1 t\'e9tettek] a tisztess\'e9ges (h\'e1zas) asszonyok, kiv\'e9ve azok, akiket a jobb kezetek birtokol [a fogs\'e1gba esettek k\'f6z\'fcl]}{\cs46\super\insrsid14643188\charrsid14643188 \chftn {\footnote \pard\plain 
\s57\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14643188 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\cs46\super\insrsid7550020 \chftn }{\insrsid7550020 \tab  Olyan f\'e9rjezett n\'f5kr\'f5
l van sz\'f3, akik h\'e1bor\'fa idej\'e9n a muszlimok fogs\'e1g\'e1ba estek, majd felvett\'e9k az iszl\'e1m vall\'e1st \'e9s ezzel megszakadt a nem-muszlim f\'e9rj\'fckkel val\'f3 kapcsolatuk, \'e9s semmiss\'e9 v\'e1lt a kor\'e1bbi h\'e1zass\'e1guk. }}}{
\insrsid14643188\charrsid14643188 . Ez Allah el\'f5\'edr\'e1sa sz\'e1motokra. \'c1m megengedett nektek rajtuk k\'edv\'fcl az, hogy h\'e1zas emberek, nem pedig par\'e1zn\'e1k gyan\'e1nt keressetek [feles\'e9get] vagyonotokkal. Ha egyesekben k\'f6z\'fcl\'fc
k \'e9lvezetet leltek [\'e9rv\'e9nyes h\'e1zass\'e1g \'e1ltal], azoknak adj\'e1tok oda j\'e1rand\'f3s\'e1gukat el\'f5\'edrt [n\'e1szaj\'e1nd\'e9kk\'e9nt]! \'c9s nem terhel titeket v\'e9ts\'e9g azzal kapcsolatban, amiben k\'f6lcs\'f6n\'f6sen meg\'e1
llapodtatok az el\'f5\'edrt n\'e1szaj\'e1nd\'e9kon fel\'fcl. Bizony, Allah Mindentud\'f3, B\'f6lcs.
\par 
\par 25. \'c9s aki k\'f6z\'fcletek nem el\'e9g tehet\'f5s ahhoz, hogy h\'e1zass\'e1got k\'f6ss\'f6n tisztess\'e9ges (szabad) h\'edv\'f5 n\'f5kkel, az [h\'e1zasodjon] azok k\'f6z\'fcl a h\'edv\'f5 szolg\'e1l\'f3le\'e1nyok k\'f6z\'fc
l, akiket a jobb kezetek birtokol! \'c9s Allahnak tudom\'e1sa van a hitetekr\'f5l. Egyik\'f5t\'f6k a m\'e1sikt\'f3l sz\'e1rmazik. K\'f6ssetek h\'e1t vel\'fck h\'e1zass\'e1got a csal\'e1djuk enged\'e9ly\'e9vel, \'e9s adj\'e1tok oda j\'e1rand\'f3s\'e1
gukat (n\'e1szaj\'e1nd\'e9kukat) hely\'e9nval\'f3 m\'f3don [ahogyan az] tisztess\'e9ges asszonyoknak [j\'e1r], nem pedig par\'e1zna n\'f5knek vagy szeret\'f5ket tart\'f3knak! Ha h\'e1zas asszonyokk\'e1 v\'e1lnak, \'e9s azut\'e1n k\'f6vetnek el f\'f6
rtelmes tettet (par\'e1znas\'e1got), akkor r\'e1juk annak a fel\'e9t kell kiszabni a gy\'f6trelemb\'f5l (b\'fcntet\'e9sb\'f5l), amennyi a [szabad] f\'e9rjezett asszonyoknak [j\'e1rna hasonl\'f3 esetben]. Ez (a h\'e1zass\'e1g) azoknak val\'f3, akik f\'e9
lnek k\'f6z\'fcletek att\'f3l, hogy neh\'e9z helyzetbe ker\'fclnek (b\'fbnbe esnek). \'c1m ha t\'fcrelmesek vagytok, az jobb nektek. Allah Megbocs\'e1t\'f3, Irgalmas.
\par 
\par 26. Allah vil\'e1goss\'e1 akarja tenni nektek [a vall\'e1s\'e1nak tan\'edt\'e1sait], \'e9s azoknak az \'fatjait akarja megmutatni nektek, akik el\'f5ttetek \'e9ltek [a pr\'f3f\'e9t\'e1k \'e9s j\'f3 emberek k\'f6z\'fcl], \'e9s ki akar engesztel\'f5dni ir
\'e1ntatok, \'e9s Allah Mindentud\'f3, B\'f6lcs.
\par 27. \'c9s Allah ki akar engesztel\'f5dni ir\'e1ntatok, \'e1m akik a v\'e1gyaikat k\'f6vetik azt akarj\'e1k, hogy hatalmas elhajl\'e1ssal t\'e9rjetek le [az igaz \'fatr\'f3l].
\par 28. Allah k\'f6nny\'edteni akar rajtatok, hiszen az ember gyeng\'e9nek teremtetett.
\par 
\par 29. \'d3, ti akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne falj\'e1tok fel egym\'e1s vagyonait jogtalanul, kiv\'e9ve, ha az olyan (megengedett) keresked\'e9sb\'f5l sz\'e1rmazik, amelyben k\'f6lcs
\'f6n\'f6sen meg\'e1llapodtatok! \'c9s ne \'f6lj\'e9tek meg magatokat (egym\'e1st)! Allah bizony Irgalmas hozz\'e1tok.
\par 30. Aki t\'falkap\'e1sb\'f3l \'e9s igazs\'e1gtalans\'e1gb\'f3l teszi ezt, azt a [Pokol-]t\'fbzben fogjuk \'e9getni. \'c9s ez k\'f6nny\'fb Allahnak.
\par 
\par 31. Ha elker\'fclitek a legnagyobbakat (a f\'f5b\'fbn\'f6ket) azok k\'f6z\'fcl, melyek megtiltatnak nektek, akkor elt\'f6r\'f6lj\'fck nektek [kisebb] rossz tetteiteket, \'e9s nemes bemenetellel bocs\'e1tunk be titeket [a Paradicsomba].
\par 
\par 32. Ne k\'edv\'e1nj\'e1tok azt, amivel Allah egyeseket k\'f6z\'fcletek el\'f5nyben r\'e9szes\'edtett m\'e1sokkal szemben! A f\'e9rfiaknak megvan a r\'e9szesed\'e9s\'fck (a fizets\'e9g\'fck) abb\'f3l, amire szert tettek \'e9s a n\'f5knek is megvan a r\'e9
szesed\'e9s\'fck (fizets\'e9g\'fck) abb\'f3l, amire szert tettek. \'c9s k\'e9rj\'e9tek Allahot [hogy adjon nektek] az \'d5 kegy\'e9b\'f5l! Bizony, Allah minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 33. Mindenkinek rendelt\'fcnk \'f6r\'f6k\'f6s\'f6ket, akik [r\'e9szesednek] abb\'f3l, amit h\'e1trahagytak a sz\'fcl\'f5k \'e9s a k\'f6zeli rokonok. \'c9s azoknak, akikhez esk\'fcvel meger\'f5s\'edtett meg\'e1llapod\'e1s k\'f6t titeket, adj\'e1tok meg az 
\'f5 r\'e9szesed\'e9s\'fcket [az \'f6r\'f6ks\'e9gb\'f5l]! Bizony, Allah mindenre tan\'fa.
\par 
\par 34. A f\'e9rfiak f\'f5s\'e9ggel \'e9s felel\'f5ss\'e9ggel vannak felruh\'e1zva a n\'f5kkel szemben, az\'e1ltal, hogy Allah el\'f5nyben r\'e9szes\'edtett egyeseket k\'f6z\'fcl\'fck a t\'f6bbiekkel szemben, \'e9s az\'e1ltal, amit \'f5k a vagyonukb\'f3l k
\'f6ltenek. A j\'f3raval\'f3 n\'f5k pedig engedelmesek, \'e9s [a f\'e9rj\'fck] t\'e1voll\'e9t\'e9ben meg\'f5rzik [\'f5t \'e9s vagyon\'e1t] az\'e1ltal, hogy Allah meg\'f5rzi (seg\'edti) [\'f5ket]. \'c9s azon feles\'e9geket, akik nyakass\'e1g\'e1t\'f3l (e
ngedetlen, len\'e9z\'f5 viselked\'e9s\'e9t\'f5l) tartotok, ints\'e9tek h\'e1t meg, [ha ez nem haszn\'e1l, akkor] ker\'fclj\'e9tek \'f5ket az \'e1gyakban, \'e9s [v\'e9gs\'f5 esetben] \'fcssetek r\'e1juk [ha ez nem rontana a helyzeten]! Ha [\'fa
jra] engedelmeskednek nektek, akkor ne keressetek m\'f3dot arra, hogy [b\'e1nts\'e1tok] \'f5ket! Bizony, Allah Magass\'e1gos, Nagy.
\par 35. Ha att\'f3l tartotok, hogy kettej\'fck k\'f6z\'f6tt szak\'edt\'e1sra ker\'fcl sor, akkor k\'fcldjetek (v\'e1lasszatok ki) egy d\'f6nt\'f5b\'edr\'f3t a f\'e9rfi csal\'e1dj\'e1b\'f3l \'e9s egy d\'f6nt\'f5b\'edr\'f3t a n\'f5 csal\'e1dj\'e1b\'f3l! Ha \'f5
k ketten (a d\'f6nt\'f5b\'edr\'f3k) a [kapcsolat] jav\'edt\'e1s\'e1t akarj\'e1k, akkor Allah b\'e9k\'e9t hoz k\'f6z\'e9j\'fck. Bizony, Allah Mindentud\'f3, mindent J\'f3l Ismer\'f5.
\par 
\par 36. \'c9s szolg\'e1lj\'e1tok Allahot, \'e9s semmit se \'e1ll\'edtsatok t\'e1rsistenk\'e9nt \'d5mell\'e9, \'e9s b\'e1njatok j\'f3s\'e1gosan a sz\'fcl\'f5kkel, a rokonokkal, az \'e1rv\'e1kkal, a szeg\'e9nyekkel, a k\'f6zeli szomsz\'e9ddal, a t\'e1
voli szomsz\'e9ddal, a veletek tart\'f3 t\'e1rssal, az \'faton l\'e9v\'f5vel \'e9s azzal, akit jobb kezetek birtokol! Bizony, Allah nem szereti azt, aki p\'f6ffeszked\'f5, dicsekv\'f5!
\par 37. [Allah nem szereti azokat] akik fukarkodnak, \'e9s arra sz\'f3l\'edtj\'e1k fel az embereket, hogy fukarok legyenek, \'e9s eltitkolj\'e1k azt, amit Allah adott nekik a kegy\'e9b\'f5l. A hitetleneknek pedig megal\'e1z\'f3 gy\'f6trelmet k\'e9sz\'edtett
\'fcnk el\'f5!
\par 38. \'c9s azokat [sem szereti], akik az\'e9rt k\'f6ltik a vagyonukat, hogy az emberek l\'e1ss\'e1k, mik\'f6zben \'f5k nem hisznek Allahban, sem pedig az Utols\'f3 Napban. S akinek a s\'e1t\'e1n az [\'e1lland\'f3] k\'eds\'e9r\'f5je, az bizony rossz k\'eds
\'e9r\'f5!
\par 39. Mit \'e1rt nekik, ha hisznek Allahban \'e9s az Utols\'f3 Napban, \'e9s adakoznak abb\'f3l, amivel Allah ell\'e1tta \'f5ket? \'c9s Allahnak tudom\'e1sa van r\'f3luk.
\par 40. Bizony, Allah nem k\'f6vet el igazs\'e1gtalans\'e1got, m\'e9g egy porszem-s\'falynyit sem, \'e1m ha az egy j\'f3tett, megt\'f6bbsz\'f6r\'f6zi azt, \'e9s T\'f5le sz\'e1rmaz\'f3 hatalmas jutalmat ad.
\par 
\par 41. \'c9s hogyan [lesz majd], amikor el\'f5hozunk minden k\'f6z\'f6ss\'e9gb\'f5l egy tan\'fat, \'e9s el\'f5hozunk t\'e9ged [\'f3 Mohamed] tan\'fak\'e9nt ezeket (a k\'f6z\'f6ss\'e9gedet) illet\'f5en [hogy te \'e1tadtad az \'fczenetet]?
\par 42. Azon a napon azok, akik }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak}{\insrsid14643188\charrsid14643188  \'e9s ellenszeg\'fcltek a K\'fcld\'f6ttnek azt szeretn\'e9k majd, hogy b\'e1rcsak a f\'f6lddel lenn\'e9nek egyenl\'f5v\'e9. 
\'c9s nem titkolhatnak el Allah el\'f5l semmilyen besz\'e9det.
\par 
\par 43. \'d3, ti akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne k\'f6zel\'edtsetek az im\'e1dkoz\'e1shoz ittasan, [hanem v\'e1rjatok] am\'edg tudj\'e1tok, hogy mit mondtok! \'c9s [ne k\'f6zel\'ed
tsetek] a h\'e1zas\'e9let (vagy mag\'f6ml\'e9s) ut\'e1ni \'e1llapotban \endash  kiv\'e9ve, ha \'e9ppen az \'faton haladtok \'e1t \endash  m\'edg meg nem f\'fcr\'f6dtetek! \'c9s ha betegek vagytok vagy \'faton vagytok, vagy valamelyik\'f5t\'f6
k az illemhelyr\'f5l j\'f6n, vagy asszonyokat \'e9rintettetek, \'e9s nem tal\'e1ltok vizet, akkor folyamodjatok tiszta talajhoz, \'e9s t\'f6r\'f6lj\'e9tek meg [azzal] az arcotokat \'e9s a kezeteket! Bizony, Allah Eln\'e9z\'f5, Megbocs\'e1t\'f3!
\par 
\par 44. Vajon nem jutott tudom\'e1sodra azoknak [a h\'edre], akik egy r\'e9szt kaptak az \'cdr\'e1sb\'f3l, a t\'e9velyg\'e9st v\'e1s\'e1rolt\'e1k meg [cser\'e9be az \'fatmutat\'e1s\'e9rt], \'e9s azt akarj\'e1k, hogy elt\'e9velyedjetek az [igaz] \'fatr\'f3l?

\par 45. Allah ismeri a legjobban az ellens\'e9geiteket. Allah elegend\'f5 P\'e1rtfog\'f3nak \'e9s Allah elegend\'f5 Seg\'edt\'f5nek!
\par 46. Vannak a zsid\'f3k k\'f6z\'f6tt olyanok, akik kiforgatj\'e1k a szavakat a hely\'fckr\'f5l (a jelent\'e9s\'fckb\'f5l), \'e9s azt mondj\'e1k: \'84Halljuk \'e9s ellenszeg\'fcl\'fcnk\'94, \'e9s \'84Halljad (amit mondunk), [b\'e1rcsak] ne hallan\'e1l!\'94
, \'e9s \'84R\'e1in\'e1\'94 (k\'e9t\'e9rtelm\'fb kifejez\'e9s: ostoba vagy \rquote adj id\'f5t, hogy meg\'e9rts\'fck\rquote ) elferd\'edtv\'e9n a nyelv\'fckkel [az \'e9rtelm\'e9t], \'e9s r\'e1galmazv\'e1n ez\'e1ltal a vall\'e1st. \'c9s ha azt mondt\'e1
k volna: \'84Hallottuk \'e9s engedelmesked\'fcnk\'94 \'e9s \'84Halljad\'94 \'e9s \'84Figyelj re\'e1nk!\'94, az bizony jobb lett volna nekik, \'e9s egyenesebb (helyesebb). \'c1m Allah el\'e1tkozta \'f5ket a hitetlens\'e9g\'fck miatt, \'edgy csak kev\'e9ss
\'e9 hisznek.
\par 
\par 47. \'d3 ti, akiknek az \'cdr\'e1s adatott! Higgyetek abban, amit kinyilatkoztattunk (a Kor\'e1nban), igazolva annak az igazs\'e1g\'e1t, ami birtokotokban van, miel\'f5tt m\'e9g elt\'f6r\'f6ln\'e9nk az arcokat, \'e9s a h\'e1takra helyezn\'e9
nk azokat! Vagy (miel\'f5tt) meg\'e1tkozn\'e1nk \'f5ket, ahogyan meg\'e1tkoztuk a szombat [szents\'e9ge] ellen v\'e9t\'f5ket! \'c9s Allah elrendel\'e9se mindig beteljesedik.
\par 48. Allah nem bocs\'e1tja meg azt, hogy t\'e1rsistent \'e1ll\'edtanak \'d5mell\'e9, \'e1m megbocs\'e1tja azt, ami ezen k\'edv\'fcl van, annak, akinek akarja. Aki t\'e1rsistent \'e1ll\'edt Allah mell\'e9, az bizony hatalmas b\'fbnt tal\'e1lt ki.
\par 
\par 49. Vajon nem jutott tudom\'e1sodra [\'f3 Mohamed] azoknak [a h\'edre], akik j\'f3nak \'edt\'e9lik magukat? \'c1m Allah \'edt\'e9l j\'f3nak azt, akit akar, \'e9s annyi igazs\'e1gtalans\'e1got sem fognak elszenvedni, mint a [datolyamagon l\'e9v\'f5] rost.

\par 50. N\'e9zd, hogyan tal\'e1lnak ki hazugs\'e1got Allah ellen! \'c9s ez elegend\'f5 nyilv\'e1nval\'f3 v\'e9teknek!
\par 
\par 51. Vajon nem jutott tudom\'e1sodra azoknak [a h\'edre], akik kaptak egy r\'e9szt az \'cdr\'e1sb\'f3l? \'d5k hisznek a m\'e1gi\'e1ban \'e9s a hamisan isten\'edtettekben [amelyek el\'f5tt le is borultak], \'e9s azt mondj\'e1k azoknak, akik }{
\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak}{\insrsid14643188\charrsid14643188 , hogy \'f5k igazabb \'faton j\'e1rnak, mint azok, aki hisznek.
\par 52. \'d5k azok, akiket Allah meg\'e1tkozott, \'e9s akit Allah meg\'e1tkoz, annak nem tal\'e1lsz seg\'edt\'f5t.
\par 53. Vagy tal\'e1n r\'e9sz\'fck van a kir\'e1lyi uralomban? [Ha \'edgy lenne] akkor nem adn\'e1nak az embereknek annyit sem, mint amennyi [bet\'f6lten\'e9 a datolyamagon l\'e9v\'f5] lyukat.
\par 54. Avagy irigykednek az emberekre amiatt, amit Allah adott nekik az \'d5 kegy\'e9b\'f5l? Bizony \'c1brah\'e1m nemzets\'e9g\'e9nek adtuk az \'cdr\'e1st \'e9s a B\'f6lcsess\'e9get, \'e9s hatalmas kir\'e1lyi uralmat adtunk nekik.
\par 55. Azt\'e1n volt k\'f6z\'f6tt\'fck olyan, aki hitt benne, \'e1m volt k\'f6z\'f6tt\'fck olyan is, aki elfordult t\'f5le [\'e9s t\'e1vol tartott m\'e1sokat], a Gyehenna elegend\'f5 [sz\'e1mukra] L\'e1ngol\'f3 [Pokol-t\'fbznek]!
\par 
\par 56. Bizony azokat, akik nem hisznek a jeleinkben, a [Pokol-]t\'fbzben fogjuk \'e9getni! Ah\'e1nyszor megs\'fcl a b\'f5r\'fck, \'faj b\'f5rre cser\'e9lj\'fck azt nekik, hogy meg\'edzlelj\'e9k a gy\'f6trelmet. Bizony, Allah M\'e9lt\'f3s\'e1gteljes, B\'f6
lcs!
\par 57. \'c1m azokat, akik hisznek, \'e9s j\'f3tetteket cselekszenek olyan kertekbe bocs\'e1tjuk [a Paradicsomban], amelyek alatt foly\'f3k folynak, \'f6r\'f6kk\'f6n-\'f6r\'f6kk\'e9 abban fognak maradni. Ott tiszt\'e1v\'e1 tett h\'e1zast\'e1rsak v\'e1rj\'e1k 
\'f5ket, \'e9s \'e1lland\'f3 \'e1rny\'e9kba bocs\'e1tjuk be \'f5ket.
\par 
\par 58. Bizony, Allah felsz\'f3l\'edt titeket, hogy adj\'e1tok vissza a r\'e1tok b\'edzott let\'e9teket a tulajdonosaiknak. \'c9s ha \'edt\'e9lkeztek az emberek k\'f6z\'f6tt, akkor igazs\'e1gosan \'edt\'e9ljetek! Milyen kit\'fbn\'f5 ez az int\'e9
s, amelyben Allah r\'e9szes\'edt titeket. Bizony, Allah Mindent Hall\'f3 \'e9s Mindent L\'e1t\'f3!
\par 59. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Engedelmeskedjetek Allahnak \'e9s engedelmeskedjetek a K\'fcld\'f6ttnek, \'e9s azoknak, akik jogosultak k\'f6z\'fcletek az \'fcgyek [ir\'e1
ny\'edt\'e1s\'e1ra]! \'c9s ha \'f6sszek\'fcl\'f6nb\'f6zt\'f6k valamiben, vigy\'e9tek azt Allah \'e9s a K\'fcld\'f6tt el\'e9, ha val\'f3ban hisztek Allahban \'e9s az Utols\'f3 Napban! Ez jobb [nektek] \'e9s szebb kimenetel\'fb!
\par 
\par 60. Vajon nem jutott tudom\'e1sodra azoknak [a h\'edre] (az izraelit\'e1k \'e9s a k\'e9pmutat\'f3k k\'f6z\'fcl), akik azt \'e1ll\'edtj\'e1k, hogy hisznek abban, ami lebocs\'e1ttatott neked, \'e9s abban, ami el\'f5tted ker\'fclt lebocs\'e1t\'e1
sra? Ugyanakkor azt akarj\'e1k, hogy [vit\'e1s \'fcgyeikben] a hamisan isten\'edtettekhez forduljanak d\'f6nt\'e9s\'e9rt, holott parancsot kaptak arra, hogy tagadj\'e1k meg azt. \'c9s a s\'e1t\'e1n azt akarja, hogy [az igazs\'e1gt\'f3l] messze j\'e1r\'f3
 t\'e9velyg\'e9ssel t\'e9velyegjenek.
\par 61. \'c9s amikor azt mondj\'e1k nekik: \'84Gyertek ahhoz, amit Allah lebocs\'e1tott, \'e9s gyertek a K\'fcld\'f6tth\'f6z\'94, [akkor] l\'e1tod a k\'e9pmutat\'f3kat viszolyogva elfordulni t\'f5led.
\par 62. \'c9s hogyan [lesz majd], amikor csap\'e1s s\'fajtja \'f5ket amiatt, amit a kez\'fck elk\'f6vetett? Elj\'f6nnek majd hozz\'e1d arra esk\'fcd\'f6zve, hogy mi csak j\'f3t \'e9s b\'e9k\'edt\'e9st akartunk.
\par 63. \'d5k azok, akikr\'f5l Allah tudja, hogy mi van a sz\'edv\'fckben. Fordulj h\'e1t el t\'f5l\'fck, intsd \'f5ket, \'e9s mondj nekik magukkal kapcsolatos hat\'e1sos besz\'e9det!
\par 
\par 64. \'c9s nem k\'fcldt\'fcnk el egyetlen k\'fcld\'f6ttet sem m\'e1s\'e9rt, mint hogy engedelmeskedjenek neki Allah engedelm\'e9vel. Ha \'f5k \endash  j\'f3llehet \'f6nmaguk ellen voltak igazs\'e1gtalanok \endash  elj\'f6nn\'e9nek hozz\'e1d, \'e9s megbocs
\'e1t\'e1st k\'e9rn\'e9nek Allaht\'f3l, \'e9s a K\'fcld\'f6tt is megbocs\'e1t\'e1st k\'e9rne a sz\'e1mukra, bizony Allahot Kiengesztel\'f5d\'f5nek \'e9s Irgalmasnak tal\'e1ln\'e1k.
\par 65. H\'e1t nem! Az Uradra! Nem hisznek addig, am\'edg nem tesznek meg t\'e9ged d\'f6nt\'f5b\'edr\'f3nak, a k\'f6z\'f6tt\'fck t\'e1madt vit\'e1ban, majd nem tal\'e1lnak fesz\'e9lyezetts\'e9get magukban amiatt, amit d\'f6nt\'f6tt\'e9l, \'e9s teljes al\'e1
vet\'e9ssel al\'e1 nem vetik magukat.
\par 
\par 66. \'c9s ha el\'f5\'edrtuk volna nekik, hogy: \'84\'d6lj\'e9tek meg magatokat (egym\'e1st), vagy hagyj\'e1tok el a lakhelyeiteket!\'94, akkor nem tett\'e9k volna meg, csak kevesen k\'f6z\'fcl\'fck. \'c1m ha megtett\'e9k volna azt, amire int\'e9
st kaptak, bizony az jobb lett volna, \'e9s nagyobb megszil\'e1rd\'edt\'e1s lett volna [a hit\'fck sz\'e1m\'e1ra].
\par 67. \'c9s akkor bizony T\'f5l\'fcnk sz\'e1rmaz\'f3 hatalmas jutalmat adn\'e1nk nekik,
\par 68. \'c9s bizony az Egyenes \'fatra vezetn\'e9nk \'f5ket.
\par 69. \'c9s azok, akik engedelmeskednek Allahnak \'e9s a K\'fcld\'f6ttnek, egy\'fctt lesznek [a Paradicsomban] azokkal, akiket Allah a j\'f3t\'e9tem\'e9ny\'e9ben r\'e9szes\'edtett: a pr\'f3f\'e9t\'e1k, az igazak, a v\'e9rtan\'fak, \'e9s a j\'f3 emberek k
\'f6z\'fcl. Milyen j\'f3 t\'e1rsak \'f5k!
\par 70. Ez a kegy Allaht\'f3l val\'f3! \'c9s elegend\'f5 Allah tud\'f3nak!
\par 
\par 71. \'d3 ti akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Legyetek \'f3vatosak! Vonuljatok csat\'e1ba csapatokban vagy mindannyian [egy\'fctt]!
\par 72. Bizony van k\'f6z\'f6ttetek olyan, aki sz\'e1nd\'e9kosan lelass\'edt [hogy lemaradjon a seregt\'f5l], \'e9s ha csap\'e1s s\'fajt titeket, azt mondja: \'84Allah j\'f3t\'e9tem\'e9nyben r\'e9szes\'edtett az\'e1ltal, hogy nem voltam jelen vel\'fc
k [a csatat\'e9ren].\'94
\par 73. \'c1m ha kegy \'e9r titeket Allaht\'f3l, bizony, azt mondja \endash  mintha k\'f6zte \'e9s k\'f6ztetek nem lett volna soha szeretet (k\'f6zeli ismerets\'e9g): \'84\'d3, b\'e1rcsak vel\'fck tarthattam volna, \'e9s hatalmas diadalt arathattam volna!\'94

\par 
\par 74. Harcoljon h\'e1t Allah \'fatj\'e1n az, aki a t\'falvil\'e1got v\'e1s\'e1rolja meg az evil\'e1gi \'e9let\'e9rt cser\'e9be! \'c9s aki Allah \'fatj\'e1n harcol, ak\'e1r meg\'f6letik, ak\'e1r gy\'f5zelmet arat, annak hatalmas jutalmat fogunk adni.
\par 75. Mi lelt h\'e1t titeket, hogy nem harcoltok Allah \'fatj\'e1n, \'e9s az elnyomott f\'e9rfiak\'e9rt, n\'f5k\'e9rt \'e9s gyermekek\'e9rt, akik azt mondj\'e1k: \'84Urunk! Vigy\'e9l ki minket ebb\'f5l a telep\'fcl\'e9sb\'f5l, melynek lak\'f3i igazs\'e1
gtalanok (zsarnokok)! Adj nek\'fcnk T\'f5led val\'f3 p\'e1rtfog\'f3t, \'e9s adj nek\'fcnk T\'f5led val\'f3 seg\'edt\'f5t!\'94?
\par 76. Azok, akik hisznek, Allah \'fatj\'e1n harcolnak. \'c9s azok, akik }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak}{\insrsid14643188\charrsid14643188  a hamisan isten\'edtettek \'fatj\'e1n harcolnak. Harcoljatok h\'e1t a s\'e1t\'e1n p
\'e1rtfogoltjai ellen! Bizony a s\'e1t\'e1n fondorlata gyenge.
\par 
\par 77. Vajon nem jutott tudom\'e1sodra azoknak [a h\'edre], akiknek az mondatott: \'84Tarts\'e1tok vissza a kezeteket (a harct\'f3l)! Tarts\'e1tok meg az im\'e1dkoz\'e1st, \'e9s adj\'e1tok meg a k\'f6telez\'f5 adom\'e1nyt!\'94 \'c1m miut\'e1n el\'f5\'ed
ratott a sz\'e1mukra a harc, \'edme egy csoport k\'f6z\'fcl\'fck \'fagy f\'e9l az emberekt\'f5l, ahogyan Allaht\'f3l kell f\'e9lni, vagy m\'e9g ann\'e1l is jobban. \'c9s azt mondt\'e1k: \'84Urunk! Mi\'e9rt \'edrtad el\'f5 nek\'fcnk a harcot? B\'e1
rcsak adt\'e1l volna nek\'fcnk halad\'e9kot egy k\'f6zeli hat\'e1rid\'f5ig!\'94 Mondd [\'f3 Mohamed]: \'84Az evil\'e1gi \'e9lvezet csek\'e9ly, de a t\'falvil\'e1g jobb annak, aki istenf\'e9l\'f5. \'c9s annyi igazs\'e1gtalans\'e1
got sem fogtok elszenvedni, mint a [datolyamagon l\'e9v\'f5] rost.
\par 78. Ak\'e1rhol is vagytok, utol\'e9r titeket a hal\'e1l, m\'e9g akkor is, ha meger\'f5s\'edtett tornyokban lenn\'e9tek.\'94 \'c9s ha valami j\'f3 \'e9ri \'f5ket azt mondj\'e1k: \'84Ez Allaht\'f3l van!\'94 \'c9s ha valami rossz \'e9ri \'f5ket azt mondj\'e1
k: \'84Ez t\'f5led van!\'94 Mondd [\'f3 Mohamed]: \'84Minden Allaht\'f3l van!\'94 Mi lelte ezt a n\'e9pet, hogy a k\'f6zel\'e9ben sincsenek annak, hogy meg\'e9rts\'e9k a besz\'e9det?
\par 79. Ha valami j\'f3 \'e9r t\'e9ged, az Allaht\'f3l van. \'c1m ha valami rossz s\'fajt t\'e9ged, az magadt\'f3l van. \'c9s elk\'fcldt\'fcnk t\'e9ged az emberekhez k\'fcld\'f6ttk\'e9nt! \'c9s elegend\'f5 Allah tan\'fanak!
\par 
\par 80. Aki engedelmeskedik a K\'fcld\'f6ttnek, az Allahnak engedelmeskedik. Aki pedig h\'e1tat ford\'edt [az az \'f5 dolga]. Nem az\'e9rt k\'fcldt\'fcnk el t\'e9ged, hogy \'f5rz\'f5j\'fck legy\'e9l.
\par 81. [Ha a k\'e9pmutat\'f3k veled vannak] azt mondj\'e1k: \'84Engedelmess\'e9get [tan\'fas\'edtunk]!\'94 \'c1m ha t\'e1voznak t\'f5led, egy r\'e9sz\'fck az \'e9j leple alatt m\'e1st forral, mint amit mondott. \'c1m Allah fel\'edrja azt, amit \'e9
jszaka terveznek. Fordulj h\'e1t el t\'f5l\'fck \'e9s hagyatkozz Allahra! \'c9s elegend\'f5 Allah v\'e9delmez\'f5nek!
\par 82. Vajon h\'e1t nem gondolkodnak el a Kor\'e1non? Ha nem Allaht\'f3l lenne, bizony sok ellentmond\'e1st tal\'e1ln\'e1nak benne.
\par 83. \'c9s ha elj\'f6n hozz\'e1juk (tudom\'e1sukra jut) egy biztons\'e1ggal vagy f\'e9lelemmel kapcsolatos \'fcgy, azt elh\'edresztelik. \'c1m ha [az \'fcgyet] a K\'fcld\'f6tt \'e9s azok el\'e9 vinn\'e9k, akik jogosultak k\'f6z\'fcl\'fck az \'fcgyek [ir
\'e1ny\'edt\'e1s\'e1ra], akkor megtudn\'e1k (hogy mi a teend\'f5 vele) azok, akik k\'f6z\'fcl\'fck [k\'e9pesek] j\'f3l k\'f6vetkeztetni. Ha nem lenne Allah kegye \'e9s k\'f6ny\'f6r\'fclete ir\'e1ntatok, bizony a s\'e1t\'e1nt k\'f6vetn\'e9tek, kev\'e9s kiv
\'e9tellel.
\par 84. Harcolj h\'e1t Allah \'fatj\'e1n [\'f3 Mohamed], csup\'e1n te magad vagy k\'f6telezve erre, \'e9s buzd\'edtsd a h\'edv\'f5ket! H\'e1tha Allah elh\'e1r\'edtja azoknak a harci csap\'e1s\'e1t, akik }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v
\'e1ltak}{\insrsid14643188\charrsid14643188 . Allah er\'f5sebb a csap\'e1sban, \'e9s er\'f5sebb az elrettent\'f5 b\'fcntet\'e9sben.
\par 
\par 85. Aki j\'f3 \'fcgyben j\'e1r k\'f6zben, az r\'e9szes\'fcl annak jutalm\'e1b\'f3l. Aki pedig rossz \'fcgyben j\'e1r k\'f6zben, az r\'e9szes\'fcl annak b\'fcntet\'e9s\'e9b\'f5l. Allah minden dolog felett \'d5rz\'f5 Tan\'fa.
\par 86. \'c9s ha [illend\'f5] k\'f6sz\'f6n\'e9ssel k\'f6sz\'f6nnek nektek, akkor m\'e9g szebben k\'f6sz\'f6njetek vissza, vagy viszonozz\'e1tok (azonosan)! Bizony, Allah minden dolgot sz\'e1mon tart.
\par 87. Allah! Nincs m\'e1s }{\cf1\insrsid14643188\charrsid14643188 [jogosan im\'e1dhat\'f3] isten,}{\insrsid14643188\charrsid14643188  csak \'d5! Bizonyosan \'f6ssze fog gy\'fbjteni titeket a Felt\'e1mad\'e1s Napj\'e1n. Ehhez nem f\'e9r k\'e9ts\'e9g. \'c9
s kinek igazabb a besz\'e9de Allah\'e9n\'e1l?
\par 
\par 88. Mi lelt titeket, hogy a k\'e9pmutat\'f3kkal kapcsolatban k\'e9t csapatra v\'e1ltatok, holott Allah [hitetlens\'e9gbe] tasz\'edtotta vissza \'f5ket, amiatt, amit [a b\'fbneikkel] szereztek? Vajon azokat akarj\'e1tok [az igaz] \'fa
tra vezetni, akiket Allah t\'e9velyg\'e9sbe vitt? Akit Allah t\'e9velyg\'e9sbe visz, annak sz\'e1m\'e1ra nem tal\'e1lsz utat.
\par 89. [A k\'e9pmutat\'f3k] azt szeretn\'e9k, hogy ne higgyetek, ahogyan \'f5k sem hisznek, hogy hasonl\'f3k legyetek hozz\'e1juk. Ne tegyetek meg senkit k\'f6z\'fcl\'fck p\'e1rtfog\'f3v\'e1, am\'edg ki nem v\'e1ndorolnak Allah \'fatj\'e1
n! Ha elfordulnak, ragadj\'e1tok meg \'e9s puszt\'edts\'e1tok el \'f5ket, ahol r\'e1juk tal\'e1ltok! Ne tegyetek meg senkit k\'f6z\'fcl\'fck p\'e1rtfog\'f3v\'e1, sem seg\'edt\'f5v\'e9!
\par 
\par 90. Kiv\'e9ve azokat, akik olyan n\'e9phez csatlakoznak, akik k\'f6zt \'e9s k\'f6z\'f6ttetek sz\'f6vets\'e9g van,  Vagy azok [ellen se harcoljatok], akik \'fagy j\'f6nnek hozz\'e1tok, hogy \'f6sszeszorult a kebl\'fck [mert irt\'f3znak] att\'f3
l, hogy harcolniuk kelljen ellenetek, vagy a saj\'e1t n\'e9p\'fck ellen. Ha Allah akarta volna, akkor hatalmat adott volna nekik felettetek, \'e9s akkor harcoltak volna ellenetek. Ha t\'e1vol tartj\'e1k magukat t\'f5letek, \'e9s nem harcolnak ellenetek, 
\'e9s b\'e9k\'e9t aj\'e1nlanak fel nektek, \'fagy Allah nem ad nektek m\'f3dot [a harcra] ellen\'fck.
\par 91. Tal\'e1lni fogtok m\'e1sokat [a k\'e9pmutat\'f3k k\'f6z\'fcl], akik biztons\'e1gban akarj\'e1k magukat tudni fel\'f5letek \'e9s a n\'e9p\'fck fel\'f5l. Valah\'e1nyszor visszat\'e9rnek a k\'eds\'e9rt\'e9shez (a hitetlens\'e9ghez), m\'e9
g jobban bele lesznek tasz\'edtva. \'c9s ha nem tartj\'e1k magukat t\'e1vol t\'f5letek, \'e9s nem aj\'e1nlanak fel nektek b\'e9k\'e9t, \'e9s nem tartj\'e1k vissza a kez\'fcket [a harct\'f3l], akkor ragadj\'e1tok meg \'f5ket \'e9s \'f6lj\'e9tek \'f5
ket meg ott, ahol r\'e1juk leltek! Azok ellen nyilv\'e1nval\'f3 \'e9rvet adtunk nektek.
\par 
\par 92. Egy h\'edv\'f5 sosem \'f6lhet meg egy m\'e1sik h\'edv\'f5t, csakis t\'e9ved\'e9sb\'f5l! \'c9s aki t\'e9ved\'e9sb\'f5l \'f6lt meg egy h\'edv\'f5t, [annak] egy h\'edv\'f5 rabszolg\'e1t kell felszabad\'edtania, \'e9s v\'e9rd\'edjat \'e1tadnia [az \'e1
ldozat] csal\'e1dj\'e1nak, kiv\'e9ve, ha azt \'f5k adakoz\'e1sk\'e9ppen elengedik. Ha [az \'e1ldozat] veletek ellens\'e9ges n\'e9phez tartozott, de h\'edv\'f5 volt, (akkor) egy h\'edv\'f5 rabszolg\'e1t kell felszabad\'edtani. Ha pedig [a meg\'f6lt h\'edv
\'f5] olyan n\'e9phez tartozott, akik k\'f6z\'f6tt \'e9s k\'f6z\'f6ttetek sz\'f6vets\'e9g van, akkor v\'e9rd\'edjat kell \'e1tadni csal\'e1dj\'e1nak \'e9s egy h\'edv\'f5 rabszolg\'e1t kell felszabad\'edtani. \'c1m akinek nincs erre m\'f3dja, [annak] k\'e9
t egym\'e1st k\'f6vet\'f5 h\'f3napot kell b\'f6jt\'f6lnie, hogy Allah kiengesztel\'f5dj\'f6n [ir\'e1nta]. Allah Mindentud\'f3, B\'f6lcs.
\par 93. \'c1m aki sz\'e1ntsz\'e1nd\'e9kkal \'f6l meg egy h\'edv\'f5t, annak fizets\'e9ge a Gyehenna lesz, \'f6r\'f6kk\'e9 abban fog maradni, \'e9s Allah megharagudott r\'e1, meg\'e1tkozza \'f5t, \'e9s hatalmas gy\'f6trelmet k\'e9sz\'edt el\'f5 neki.
\par 
\par 94. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha felkerekedtek Allah \'fatj\'e1n harcolni, bizonyosodjatok h\'e1t meg [arr\'f3l, hogy kivel \'e1lltok szemben], \'e9s ne mondj\'e1
tok annak, aki b\'e9kess\'e9get int fel\'e9tek [az iszl\'e1mhoz val\'f3 tartoz\'e1s\'e1t jelezve]: \'84Te nem vagy h\'edv\'f5!\'94 \endash  az evil\'e1gi \'e9let muland\'f3 javait keresve! Allahn\'e1l vannak a hatalmas nyeres\'e9
gek. Ilyenek voltatok ti is kor\'e1bban, azt\'e1n Allah kegy\'e9ben r\'e9szes\'edtett titeket. Bizonyosodjatok h\'e1t meg! \'c9s Allah j\'f3l ismeri mindazt, amit cselekszetek.
\par 
\par 95. Nem egyenl\'f5ek a h\'edv\'f5k k\'f6z\'fcli otthonmarad\'f3k \endash  kiv\'e9ve, akik testi fogyat\'e9koss\'e1ggal b\'edrnak \endash  azokkal, akik k\'fczdenek Allah \'fatj\'e1n vagyonukkal \'e9s magukkal (\'e9let\'fcket kock\'e1
ztatva). Azokat, akik vagyonukkal \'e9s magukkal (\'e9let\'fcket kock\'e1ztatva) k\'fczdenek, Allah egy fokkal feljebb emelte azokn\'e1l, akik [fogyat\'e9koss\'e1guk miatt] otthon maradtak. \'c1m Allah mindegyik\'fc
knek a legjobb [jutalomra, a Paradicsomra] tett \'edg\'e9retet, \'e9s Allah el\'f5nyben r\'e9szes\'edtette azokat, akik k\'fczdenek [\'c9rte] az otthonmarad\'f3kkal szemben, hatalmas jutalommal:
\par 96. T\'f5le sz\'e1rmaz\'f3 fokozatokkal \'e9s megbocs\'e1t\'e1ssal \'e9s k\'f6ny\'f6r\'fclettel. \'c9s Allah Megbocs\'e1t\'f3, Irgalmas.
\par 
\par 97. Bizony, akiket elsz\'f3l\'edtanak [a hal\'e1l] angyalai, mik\'f6zben magukkal szemben igazs\'e1gtalanok voltak, azoknak azt mondj\'e1k: \'84Milyen helyzetben voltatok?\'94 Azt felelik: \'84Elnyomottak voltunk a f\'f6ld\'f6n.\'94 Azt mondj\'e1
k [az angyalok]: \'84Nem volt-e Allah f\'f6ldje [el\'e9g] t\'e1gas ahhoz, hogy v\'e1ndoroljatok rajta?\'94 H\'e1t azoknak a Gyehenna lesz a hajl\'e9kuk! Milyen rossz v\'e9gc\'e9l!
\par 98. Kiv\'e9ve az elnyomottakat a f\'e9rfiak, a n\'f5k \'e9s a gyermekek k\'f6z\'fcl, akik nem k\'e9pesek kitervelni valamit, \'e9s nem lelnek \'fatra [a menek\'fcl\'e9shez] sem.
\par 99. H\'e1t azokkal szemben Allah tal\'e1n eln\'e9z\'f5en fog b\'e1nni, hiszen Allah Eln\'e9z\'f5, Megbocs\'e1t\'f3! 
\par 100. \'c9s aki kiv\'e1ndorol Allah\'e9rt, az a f\'f6ld\'f6n sok v\'e1ndorhelyet tal\'e1l, \'e9s b\'f5s\'e9get [az ell\'e1t\'e1sb\'f3l]. Aki pedig kil\'e9p a h\'e1z\'e1b\'f3l kiv\'e1ndorolva Allahhoz \'e9s a K\'fcld\'f6tt\'e9hez, majd el\'e9ri \'f5t a hal
\'e1l, h\'e1t annak jutalm\'e1r\'f3l Allah fog gondoskodni. Allah Megbocs\'e1t\'f3, Irgalmas.
\par 
\par 101. Ha utaztok a f\'f6ld\'f6n, nem terhel titeket v\'e9ts\'e9g, hogy ha ler\'f6vid\'edtitek az im\'e1dkoz\'e1st, amennyiben f\'e9ltek, hogy akik }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak,}{\insrsid14643188\charrsid14643188 
 rosszat forralnak ellenetek. Bizony a hitetlenek nyilv\'e1nval\'f3 ellens\'e9geitek.
\par 102. \'c9s ha te k\'f6z\'f6tt\'fck vagy [a harct\'e9ren], \'e9s neki\'e1llsz [megtartani] vel\'fck az im\'e1dkoz\'e1st, akkor az egyik csoport k\'f6z\'fcl\'fck \'e1lljon fel veled, \'e9s vegye mag\'e1hoz a fegyvereit! \'c9s amikor leborulnak (befejezik k
\'fcl\'f6n az im\'e1dkoz\'e1st), akkor \'e1lljanak m\'f6g\'e9tek (h\'e1tr\'e9bb), \'e9s j\'f6jj\'f6n a m\'e1sik csoport, amelyik m\'e9g nem im\'e1dkozott, \'e9s im\'e1dkozzon veled! \'c9s legyenek r\'e9sen, \'e9s vegy\'e9
k magukhoz a fegyvereiket! Azok, akik hitetlenn\'e9 v\'e1ltak azt szeretn\'e9k, ha nem figyeln\'e9tek a fegyvereitekre, \'e9s a holmijaitokra, hogy egyszerre r\'e1tok t\'e1madhassanak. \'c1m nem terhel titeket v\'e9ts\'e9g, ha leteszitek fegyvereiteket es
\'f5 vagy betegs\'e9g miatt. \'c1m legyetek r\'e9sen! Bizony, Allah megal\'e1z\'f3 gy\'f6trelmet k\'e9sz\'edtett el\'f5 a hitetleneknek.
\par 103. Ha elv\'e9gezt\'e9tek az im\'e1dkoz\'e1st, eml\'e9kezzetek meg Allahr\'f3l \'e1llva, \'fclve \'e9s az oldalaitokon! \'c9s ha biztons\'e1gban vagytok, akkor a [teljes] im\'e1dkoz\'e1st tarts\'e1tok meg! Bizony, az im\'e1dkoz\'e1s meghat\'e1rozott id
\'f5kben megszabott el\'f5\'edr\'e1s a h\'edv\'f5knek.
\par 
\par 104. \'c9s ne lankadjatok az ellens\'e9ges n\'e9p \'fcld\'f6z\'e9s\'e9ben! Ha f\'e1jdalmat \'e9reztek [a harc ok\'e1n], h\'e1t nekik ugyan\'fagy f\'e1j, mint ahogy nektek f\'e1j, \'e1m ti olyasvalamit rem\'e9lhettek Allaht\'f3l, amit \'f5k nem rem\'e9
lhetnek. Bizony, Allah Mindentud\'f3, B\'f6lcs!
\par 
\par 105. Bizony, mi lebocs\'e1tottuk neked az \'cdr\'e1st az Igazs\'e1ggal, hogy azzal \'edt\'e9lj az emberek k\'f6z\'f6tt, amit Allah tett l\'e1that\'f3v\'e1 neked! \'c9s ne legy\'e9l az, aki vit\'e1zik az \'e1rul\'f3k mellett!
\par 
\par 106. \'c9s k\'e9rj megbocs\'e1t\'e1st Allaht\'f3l! Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 107. S ne sz\'e1llj vit\'e1ba azok\'e9rt, akik becsapj\'e1k saj\'e1t magukat! Bizony, Allah nem szereti azt, aki megr\'f6gz\'f6tt \'e1rul\'f3, b\'fbn\'f6s.
\par 108. Elrejt\'f5znek az emberek el\'f5l, ellenben Allah el\'f5l nem rejt\'f5znek el, holott \'d5 vel\'fck van, amint az \'e9j leple alatt olyan besz\'e9det forralnak, amelyet \'d5 nem fogad megel\'e9ged\'e9ssel. Allah [tud\'e1s\'e1val] k\'f6r\'fc
lveszi mindazt, amit cselekszenek.
\par 109. \'cdme, ti vagytok azok, akik vit\'e1ba sz\'e1lltok \'e9rt\'fck az evil\'e1gi \'e9letben, \'e1m ki fog \'e9rt\'fck vit\'e1ba sz\'e1llni Allahn\'e1l a Felt\'e1mad\'e1s napj\'e1n, vagy ki lesz az \'f5 v\'e9delmez\'f5j\'fck?
\par 
\par 110. Aki valami rosszat tesz, vagy maga ellen igazs\'e1gtalans\'e1got k\'f6vet el, de ezut\'e1n megbocs\'e1t\'e1st k\'e9r Allaht\'f3l, Allahot Megbocs\'e1t\'f3nak \'e9s Irgalmasnak fogja tal\'e1lni.
\par 111. Aki pedig b\'fbnt szerez, az mag\'e1nak szerzi meg. Allah Mindentud\'f3, B\'f6lcs.
\par 112. Aki v\'e9tket vagy b\'fbnt szerez, majd megv\'e1dol vele egy \'e1rtatlant, az rettenetes r\'e1galmaz\'e1s \'e9s nyilv\'e1nval\'f3 b\'fbn terh\'e9t veszi mag\'e1ra.
\par 
\par 113. Ha nem lett volna Allah kegye \'e9s k\'f6ny\'f6r\'fclete ir\'e1ntad, akkor egy csoport k\'f6z\'fcl\'fck arra t\'f6rekedett volna, hogy t\'e9velyg\'e9sbe vigyen t\'e9ged, \'e1m csak magukat viszik t\'e9velyg\'e9sbe, semmit sem \'e1rthatnak neked. \'c9
s Allah kinyilatkoztatta neked az \'cdr\'e1st \'e9s a b\'f6lcsess\'e9get (a t\'f6rv\'e9ny rejtelmeit), \'e9s megtan\'edtott t\'e9ged arra, amit nem tudt\'e1l. Allah kegye hatalmas ir\'e1ntad [\'f3 Mohamed].
\par 
\par 114. Nincs semmi j\'f3 a legt\'f6bb bizalmas besz\'e9lget\'e9s\'fckben, kiv\'e9ve annak [a szav\'e1ban], aki adakoz\'e1sra, hely\'e9nval\'f3ra, vagy az emberek k\'f6z\'f6tti b\'e9k\'edt\'e9sre sz\'f3l\'edt fel. Aki ezt megteszi Allah tetsz\'e9s\'e9
t keresve, annak hatalmas jutalmat adunk.
\par 115. Aki viszont szembeszeg\'fcl a K\'fcld\'f6ttel, azut\'e1n, hogy vil\'e1goss\'e1 v\'e1lt sz\'e1m\'e1ra az Igaz \'datmutat\'e1s, \'e9s nem a h\'edv\'f5k \'datj\'e1t k\'f6veti, annak azt adjuk p\'e1rtfog\'f3 gyan\'e1nt, akit \'f5 fogadott p\'e1rtfog\'f3
nak. A Gyehenn\'e1ba fogjuk behelyezni! Milyen rossz v\'e9gc\'e9l!
\par 
\par 116. Bizony, Allah nem bocs\'e1tja meg azt, hogy t\'e1rsistent \'e1ll\'edtanak \'d5mell\'e9, \'e9s ami ezen k\'edv\'fcl van, azt megbocs\'e1tja annak, akinek akarja! Aki t\'e1rsistent \'e1ll\'edt Allah mell\'e9, az bizony [az igazs\'e1gt\'f3l] messzej\'e1
r\'f3 t\'e9velyg\'e9ssel t\'e9velyeg!
\par 
\par 117. Azok nem foh\'e1szkodnak m\'e1shoz, mint n\'f5nem\'fb [b\'e1lv\'e1nyokhoz], \'e9s nem foh\'e1szkodnak m\'e1shoz, csup\'e1n egy l\'e1zad\'f3 s\'e1t\'e1nhoz,
\par 118. Allah meg\'e1tkozta \'f5t (kiz\'e1rta a kegyelm\'e9b\'f5l). \'c9s azt mondta (a s\'e1t\'e1n): \'84Bizony, hatalmamba veszek a szolg\'e1id k\'f6z\'fcl egy meghat\'e1rozott r\'e9szt!
\par 119. S bizony t\'e9velyg\'e9sbe viszem \'f5ket, \'e9s s\'f3v\'e1rg\'e1st \'e9bresztek benn\'fck, \'e9s arra sz\'f3l\'edtom fel \'f5ket, hogy v\'e1gj\'e1k meg az \'e1llatok f\'fcl\'e9t, \'e9s arra, hogy v\'e1ltoztass\'e1k meg Allah teremt\'e9s\'e9t!\'94
 Aki Allah helyett a s\'e1t\'e1nt teszi meg p\'e1rtfog\'f3v\'e1, az bizony nyilv\'e1nval\'f3 vesztes\'e9get fog szenvedni.
\par 120. \'cdg\'e9rget nekik, \'e9s s\'f3v\'e1rg\'e1st \'e9breszt benn\'fck, \'e1m a s\'e1t\'e1n nem \'edg\'e9r nekik m\'e1st, csup\'e1n megt\'e9veszt\'e9st.
\par 121. Ezeknek a Gyehenna lesz a hajl\'e9kuk, \'e9s nem tal\'e1lnak az el\'f5l menek\'fcl\'e9si helyet.
\par 
\par 122. \'c1m akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben], \'e9s j\'f3tetteket cselekszenek, azokat olyan Kertekbe fogjuk bebocs\'e1tani, amelyek alatt foly\'f3k folynak [a Paradicsomban], \'f6r\'f6kk
\'f6n \'f6r\'f6kk\'e9 abban fognak maradni. Ez Allah \'edg\'e9rete, igazs\'e1gk\'e9nt. \'c9s kinek a szava igazabb, mint Allah\'e9?
\par 123. Ez nem a ti \'f3hajaitok szerint, se nem az \'cdr\'e1s n\'e9p\'e9nek \'f3hajai szerint [val\'f3sul meg]! Aki rosszat tesz, annak aszerint lesz megfizetve, \'e9s nem tal\'e1l majd Allah helyett sem p\'e1rtfog\'f3t sem seg\'edt\'f5t.
\par 124. \'c9s aki j\'f3tetteket cselekszik, [legyen] ak\'e1r f\'e9rfi, ak\'e1r n\'f5, \'e9s h\'edv\'f5, az bel\'e9p a Paradicsomba, \'e9s nem \'e9ri \'f5t annyi igazs\'e1gtalans\'e1g sem, mint amennyi [bet\'f6lten\'e9 a datolyamagon l\'e9v\'f5] lyukat.

\par 125. \'c9s kinek lehet szebb vall\'e1sa, mint annak, aki al\'e1veti arc\'e1t (\'f6nmag\'e1t) Allahnak \'e9s j\'f3tev\'f5, \'e9s k\'f6veti \'c1brah\'e1m vall\'e1s\'e1t han\'edfk\'e9nt (egyistenh\'edv\'f5, a hamis vall\'e1sokt\'f3l elhajl\'f3)? \'c9
s Allah k\'f6zeli bar\'e1tj\'e1v\'e1 tette \'c1brah\'e1mot.
\par 126. \'c9s Allah\'e9 mindaz, ami az egekben \'e9s ami a f\'f6ld\'f6n van. Allah minden dolgot k\'f6r\'fclvesz [a tud\'e1s\'e1val].
\par 
\par 127. Felvil\'e1gos\'edt\'e1st k\'e9rnek t\'f5led [\'f3 Mohamed] a n\'f5kre vonatkoz\'f3an. Mondd: \'84Allah ad nektek felvil\'e1gos\'edt\'e1st [vel\'fck kapcsolatban], \'e9s az, ami az \'cdr\'e1sban recit\'e1ltatik nektek a n\'f5i \'e1rv\'e1kr\'f3
l, akiknek nem adj\'e1tok oda azt [a jogos r\'e9szt], ami el\'f5\'edratott nekik, \'e9s akiket [\'e9rdekb\'f5l] szeretn\'e9tek feles\'e9g\'fcl venni, \'e9s a gyenge gyermekekr\'f5l, \'e9s [arr\'f3l], hogy igazs\'e1gosan kell b\'e1nnotok az \'e1rv\'e1kkal.
\'94 \'c9s b\'e1rmi j\'f3t is tesztek, arr\'f3l Allahnak bizony tudom\'e1sa van.
\par 
\par 128. Ha egy asszony a f\'e9rje r\'e9sz\'e9r\'f5l tart a rossz b\'e1n\'e1sm\'f3dt\'f3l vagy att\'f3l hogy elfordul t\'f5le, akkor nem terheli \'f5ket v\'e9ts\'e9g azzal, ha egym\'e1s k\'f6z\'f6tt b\'e9k\'e9s megegyez\'e9sre jutnak. A b\'e9k\'e9s megegyez
\'e9s jobb! Az emberek hajlamosak a f\'f6sv\'e9nys\'e9gre, \'e1m ha j\'f3tev\'f5en cselekedtek \'e9s istenf\'e9l\'f5k vagytok [Allah megjutalmaz titeket \'e9rte], mert bizony Allah j\'f3l ismeri mindazt, amit cselekszetek!
\par 129. Nem lesztek k\'e9pesek arra, hogy igazs\'e1gosak legyetek az asszonyokkal (ami a szeretetet \'e9s a vonzalmat illeti), m\'e9g ha igyekezn\'e9tek is, de ne forduljatok el teljesen [az egyik feles\'e9getek fel\'e9], \'fagy hogy f\'fcgg\'f5ben hagyj\'e1
tok [a m\'e1sikat]! \'c9s ha igazs\'e1gosan j\'e1rtok el \'e9s istenf\'e9l\'f5k vagytok, akkor Allah bizony Megbocs\'e1t\'f3 \'e9s Irgalmas.
\par 130. Ha \'f5k ketten elv\'e1lnak, Allah mindkett\'f5t k\'e1rp\'f3tolni fogja az \'d5 kegy\'e9b\'f5l. Allah a [mindent] \'c1tfog\'f3, B\'f6lcs.
\par 
\par 131. Allah\'e9 mindaz, ami az egekben \'e9s ami a f\'f6ld\'f6n van. \'c9s bizony meghagytuk azoknak, akiknek az \'cdr\'e1s adatott el\'f5ttetek, \'e9s nektek is, hogy f\'e9lj\'e9tek Allahot. Ha azonban hitetlenn\'e9 v\'e1
ltok [akkor tudnotok kell], hogy Allah\'e9 mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van, Allah Gazdag, Dics\'e9retrem\'e9lt\'f3!
\par 132. \'c9s Allah\'e9 mindaz, ami az egekben \'e9s ami a f\'f6ld\'f6n van. \'c9s elegend\'f5 Allah v\'e9delmez\'f5nek!
\par 133. Ha akarja, akkor elt\'e1vol\'edt (elpuszt\'edt) titeket, \'f3 emberek, \'e9s m\'e1sokat hoz el\'f5. \'c9s Allahnak hatalm\'e1ban \'e1ll ez!
\par 134. Aki az evil\'e1g jutalm\'e1t akarja, nos, Allahn\'e1l van az evil\'e1g \'e9s a t\'falvil\'e1g jutalma. Allah a Mindent Hall\'f3, a Mindent L\'e1t\'f3.
\par 
\par 135. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Legyetek az igazs\'e1goss\'e1g fenntart\'f3i, tan\'fakk\'e9nt Allah mellett, m\'e9g ha magatok, vagy a sz\'fcl\'f5
k, vagy a rokonok ellen [tan\'faskodtok] is, legyen [az aki ellen tan\'faskodtok] gazdag vagy nincstelen, Allahnak t\'f6bb joga van vel\'fck szemben, ez\'e9rt ne k\'f6vess\'e9tek a k\'e9nyt, nehogy let\'e9rjetek [az igazs\'e1goss\'e1g \'fatj\'e1r\'f3
l]! De ha elferd\'edtitek, vagy ha elfordultok, h\'e1t Allah j\'f3l ismeri mindazt, amit cselekszetek!
\par 136. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Higgyetek Allahban, az \'d5 K\'fcld\'f6tt\'e9ben, \'e9s abban az \'cdr\'e1sban, amit lebocs\'e1tott az \'d5 k\'fcld\'f6tt\'e9nek, \'e9
s abban az \'cdr\'e1sban, amit kor\'e1bban lebocs\'e1tott! \'c9s aki }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1lik}{\insrsid14643188\charrsid14643188  Allahhal, az angyalaival, az \'cdr\'e1saival, a k\'fcld\'f6tteivel, \'e9s az Utols\'f3
 Nappal szemben, az bizony [az igazs\'e1gt\'f3l] messzej\'e1r\'f3 t\'e9velyg\'e9ssel t\'e9velyeg.
\par 
\par 137. Bizony azok, akik hittek majd hitetlenn\'e9 v\'e1ltak, majd \'fajra hittek, majd pedig \'fajra hitetlenn\'e9 v\'e1ltak, majd gyarapodtak hitetlens\'e9gben, azoknak Allah nem bocs\'e1t meg, se nem vezeti \'f5ket [az igaz] \'fatra.
\par 138. Adj \'f6r\'f6mh\'edrt a k\'e9pmutat\'f3knak arr\'f3l, hogy f\'e1jdalmas gy\'f6trelem j\'e1r nekik!
\par 139. Azok, akik a hitetleneket teszik meg p\'e1rtfog\'f3kk\'e1 a h\'edv\'f5k helyett, vajon m\'e9lt\'f3s\'e1got keresnek n\'e1luk? Bizony, a m\'e9lt\'f3s\'e1g mind Allahot illeti!
\par 
\par 140. \'c9s m\'e1r lebocs\'e1totta nektek az \'cdr\'e1sban: \'84Ha hallj\'e1tok, hogy Allah jeleivel (szavaival) szemben hitetlens\'e9get k\'f6vetnek el, vagy g\'fanyt \'fbznek vel\'fck, akkor ne \'fcljetek le azokkal, m\'edg m\'e1s besz\'e9dbe nem e
legyednek, k\'fcl\'f6nben hasonl\'f3ak lenn\'e9tek hozz\'e1juk!\'94 Allah bizony \'f6sszegy\'fbjti a k\'e9pmutat\'f3kat \'e9s a hitetleneket a Gyehenn\'e1ban, mindannyiukat.
\par 141. \'d5k azok, akik arra v\'e1rakoznak [hogy mi lesz] veletek; ha Allaht\'f3l val\'f3 gy\'f5zelemben van r\'e9szetek, azt mondj\'e1k: \'84Vajon nem voltunk veletek?\'94, ha azonban a hitetleneknek jut r\'e9szesed\'e9s (a gy\'f5zelemb\'f5
l), akkor azt mondj\'e1k nekik: \'84Vajon nem ker\'edtett\'fcnk-e hatalmunkba titeket (\'e9s nem voltunk-e k\'e9pesek a legy\'f5z\'e9setekre), \'e9s nem h\'e1r\'edtottuk-e el t\'f5letek a h\'edv\'f5ket?\'94 Allah \'edt\'e9lkezni fog k\'f6z\'f6tt\'fc
k a Felt\'e1mad\'e1s Napj\'e1n. \'c9s Allah nem fog a hitetleneknek utat adni [a gy\'f5zelemre] a h\'edv\'f5k ellen.
\par 142. Bizony, a k\'e9pmutat\'f3k f\'e9lre akarj\'e1k vezetni Allahot, de \'d5 vezeti \'f5ket f\'e9lre, \'e9s amikor fel\'e1llnak az im\'e1dkoz\'e1shoz, lust\'e1n \'e1llnak fel, [az im\'e1dkoz\'e1suk c\'e9lja] hogy az emberek l\'e1ss\'e1k, \'e9s nem eml\'ed
tik meg Allahot, csak kev\'e9sszer.
\par 143. Ingadoznak a [h\'edv\'f5k \'e9s hitetlenek] k\'f6z\'f6tt. Sem ezekhez, sem azokhoz [nem tartoznak]. Akit Allah t\'e9velyg\'e9sbe vitt, annak te nem fogsz utat tal\'e1lni [az igaz hithez].
\par 
\par 144. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne tegy\'e9tek meg a hitetleneket p\'e1rtfog\'f3kk\'e1 a h\'edv\'f5k helyett! Vajon Allahnak ellenetek sz\'f3l\'f3, nyilv\'e1nval\'f3 \'e9
rvet akartok adni?
\par 145. Bizony a k\'e9pmutat\'f3k a [Pokol-]t\'fbz legals\'f3 m\'e9lys\'e9g\'e9ben lesznek, \'e9s nem tal\'e1lsz nekik seg\'edt\'f5t.
\par 
\par 146. Kiv\'e9ve azokat, akik b\'fbnb\'e1natot tan\'fas\'edtanak, \'e9s javul\'e1st hoznak, \'e9s ragaszkodnak Allahhoz, \'e9s a vall\'e1sukat (tetteiket) \'f5szint\'e9n Allahnak szentelik, azok a h\'edv\'f5kkel lesznek. \'c9s Allah a h\'edv\'f5
knek hatalmas jutalmat fog adni.
\par 147. Mit haszn\'e1lna Allahnak az, hogy ha gy\'f6trelemmel s\'fajtana titeket, ha h\'e1l\'e1sak \'e9s h\'edv\'f5k vagytok? Allah a Megh\'e1l\'e1l\'f3, a Mindentud\'f3!
\par 
\par 148. Allah nem szereti a hangosan kinyilv\'e1n\'edtott rosszat, de [megengedett ez annak], aki igazs\'e1gtalans\'e1got szenvedett. Allah a Mindent Hall\'f3, a Mindentud\'f3.
\par 149. Ha kinyilv\'e1n\'edtotok b\'e1rmi j\'f3t, vagy elrejtitek azt, vagy eln\'e9ztek valami rosszat, h\'e1t Allah bizony Eln\'e9z\'f5, Mindenhat\'f3.
\par 
\par 150. Bizony azok, akik nem hisznek Allahban \'e9s a k\'fcld\'f6tteiben, \'e9s el akarj\'e1k v\'e1lasztani Allahot a k\'fcld\'f6tteit\'f5l, \'e9s azt mondj\'e1k: \'84Hisz\'fcnk egyesekben, \'e9s nem hisz\'fcnk m\'e1sokban\'94, k\'f6ztes utat akarnak v\'e1
lasztani. 
\par 151. Azok }{\insrsid2098041 bizony }{\insrsid14643188\charrsid14643188 az igazi hitetlenek, \'e9s a hitetleneknek megal\'e1z\'f3 gy\'f6trelmet k\'e9sz\'edtett\'fcnk el\'f5.
\par 152. \'c1m azok, akik hisznek Allahban \'e9s a k\'fcld\'f6tteiben, \'e9s nem tesz\'fcnk k\'fcl\'f6nbs\'e9get k\'f6z\'f6tt\'fck, azoknak megfogja adni a jutalmaikat. \'c9s Allah a Megbocs\'e1t\'f3, az Irgalmas.
\par 
\par 153. Az \'cdr\'e1s n\'e9pe azt k\'e9ri t\'f5led [\'f3 Mohamed], hogy k\'fcldess le nekik egy \'cdr\'e1st az \'e9gb\'f5l. Bizony, M\'f3zest\'f5l kor\'e1bban m\'e9g enn\'e9l is nagyobbat k\'e9rtek, hiszen azt mondt\'e1k: \'84Mutasd meg nek\'fc
nk Allahot szemmel l\'e1that\'f3 m\'f3don\'94, akkor a vill\'e1mcsap\'e1s elragadta \'f5ket igazs\'e1gtalans\'e1guk miatt. Majd [isten\'fckk\'e9] tett\'e9k a borj\'fat, azt k\'f6vet\'f5en, hogy a vil\'e1gos bizony\'edt\'e9kok elj\'f6ttek hozz\'e1juk, \'e1
m mi eln\'e9zt\'fck ezt [nekik], \'e9s M\'f3zesnek [a pr\'f3f\'e9tas\'e1g\'e1ra] nyilv\'e1nval\'f3 \'e9rvet adtunk.
\par 154. \'c9s felemelt\'fck felett\'fck a [S\'ednai] hegyet, a vel\'fck k\'f6t\'f6tt sz\'f6vets\'e9g [megszeg\'e9se] miatt, \'e9s azt mondtuk nekik: \'84\'c9s l\'e9pjetek be a kapun al\'e1zattal [\'e9s boruljatok le h\'e1l\'e1san]!\'94 Azt mondtuk nekik: 
\'84Ne h\'e1gj\'e1tok \'e1t a [t\'f6rv\'e9nyt] a szombattal kapcsolatban!\'94 \'c9s mi szil\'e1rd sz\'f6vets\'e9get k\'f6t\'f6tt\'fcnk vel\'fck.
\par 155. \'c9s [hatalmas b\'fcntet\'e9sekkel s\'fajtottuk \'f5ket] mivel megszegt\'e9k a sz\'f6vets\'e9g\'fcket, \'e9s }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak}{\insrsid14643188\charrsid14643188  Allah jeleivel szemben, \'e9s meg\'f6lt
\'e9k a pr\'f3f\'e9t\'e1kat jogtalanul, \'e9s ami\'e9rt azt mondt\'e1k: \'84Burokban van a mi sz\'edv\'fcnk (nem hatja meg Allah szava).\'94 \endash  Dehogy! Allah lepecs\'e9telte azt a hitetlens\'e9g\'fck miatt, ez\'e9rt hisznek oly kev\'e9ss\'e9 
\endash 
\par 156. \'c9s a hitetlens\'e9g\'fck miatt, \'e9s mert M\'e1ri\'e1r\'f3l hatalmas r\'e1galmat \'e1ll\'edtottak,
\par 157. \'c9s mivel azt mondt\'e1k (g\'fanyol\'f3dva): \'84Mi \'f6lt\'fck meg a Messi\'e1st, J\'e9zust, M\'e1ria fi\'e1t, Allah K\'fcld\'f6tt\'e9t\'94 \endash  de [bizony] nem \'f6lt\'e9k meg, \'e9s nem fesz\'edtett\'e9k fel, hanem egy hasonl\'f3
 adatott nekik. Akik elt\'e9r\'f5 v\'e9lem\'e9nyen vannak \'f5t illet\'f5en, azok k\'e9ts\'e9gben vannak fel\'f5le. Nem rendelkeznek r\'f3la tud\'e1ssal, csak a v\'e9leked\'e9st k\'f6vetik, \'e9s bizonyosan nem \'f6lt\'e9k meg.
\par 158. \'c1m Allah felemelte mag\'e1hoz. Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs!
\par 159. Nincs az \'cdr\'e1s n\'e9p\'e9b\'f5l olyan, aki [J\'e9zus] hal\'e1la el\'f5tt ne hinne benne, \'e9s a Felt\'e1mad\'e1s Napj\'e1n pedig tan\'fa lesz ellen\'fck.
\par 160. \'c9s igazs\'e1gtalans\'e1guk miatt azoknak, akik zsid\'f3k, tilalmass\'e1 tett\'fck a j\'f3 dolgokat, amelyek kor\'e1bban megengedettek voltak sz\'e1mukra, \'e9s az\'e9rt, mert sokakat t\'e1vol tartottak Allah \'fatj\'e1t\'f3l,
\par 161. \'c9s az\'e9rt, mert kamatot szedtek, holott kor\'e1bban el lettek tiltva t\'f5le, \'e9s mert felfalt\'e1k az emberek vagyon\'e1t jogtalanul. \'c9s mi a hitetleneknek k\'f6z\'fcl\'fck f\'e1jdalmas gy\'f6trelmet k\'e9sz\'edtett\'fcnk el\'f5.
\par 
\par 162. De a tud\'e1sban szil\'e1rdak k\'f6z\'fcl\'fck, \'e9s a h\'edv\'f5k hisznek abban, ami lebocs\'e1ttatott neked, \'e9s abban, ami el\'f5tted bocs\'e1ttatott le, \'e9s megtartj\'e1k az im\'e1dkoz\'e1st, \'e9s megadj\'e1k a k\'f6telez\'f5 adom\'e1nyt, 
\'e9s hisznek Allahban \'e9s az Utols\'f3 Napban, nekik hatalmas jutalmat fogunk adni.
\par 
\par 163. Bizony, mi [kinyilatkoztat\'e1st] sugalltunk neked [\'f3 Mohamed], ahogyan sugalltunk kor\'e1bban No\'e9nak \'e9s az \'f5ut\'e1na k\'f6vetkez\'f5 pr\'f3f\'e9t\'e1knak, \'e9s sugalltunk \'c1brah\'e1mnak, Izm\'e1elnek, Izs\'e1knak, J\'e1kobnak \'e9s 
a T\'f6rzseknek (J\'e1kob tizenk\'e9t fia lesz\'e1rmazottainak) \'e9s J\'e9zusnak, J\'f3bnak, J\'f3n\'e1snak, \'c1ronnak, Salamonnak. \'c9s D\'e1vidnak zsolt\'e1rt adtunk.
\par 164. N\'e9mely k\'fcld\'f6ttek t\'f6rt\'e9net\'e9t m\'e1r kor\'e1bban elbesz\'e9lt\'fck neked, \'e1m n\'e9mely k\'fcld\'f6ttek t\'f6rt\'e9net\'e9t nem besz\'e9lt\'fck el neked, \'e9s Allah [k\'f6zvetlen\'fcl] sz\'f3lva sz\'f3lt M\'f3zeshez.
\par 165. \'d6r\'f6mh\'edrhoz\'f3 \'e9s figyelmeztet\'f5 k\'fcld\'f6tteket [k\'fcldt\'fcnk el], hogy az embereknek ne lehessen Allahhal szemben \'e9rv\'fck a k\'fcld\'f6ttek [elk\'fcld\'e9se] ut\'e1n. \'c9s Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.
\par 166. Allah azonban tan\'fas\'edtja, hogy amit lebocs\'e1tott neked [\'f3 Mohamed], azt az \'d5 tud\'e1s\'e1val bocs\'e1totta le, \'e9s az angyalok is tan\'fas\'edtj\'e1k ezt. \'c9s elegend\'f5 Allah tan\'fanak.
\par 
\par 167. Bizony, akik }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak}{\insrsid14643188\charrsid14643188  \'e9s t\'e1vol tartanak [m\'e1sokat] Allah \'fatj\'e1t\'f3l, azok bizony messzej\'e1r\'f3 t\'e9velyg\'e9ssel t\'e9velyegnek.
\par 168. Bizony azok, akik }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltak}{\insrsid14643188\charrsid14643188  \'e9s igazs\'e1gtalans\'e1got k\'f6vetnek el, azoknak Allah nem fog megbocs\'e1tani, \'e9s nem vezeti \'f5ket [semmilyen m\'e1s] 
\'fatra,
\par 169. Kiv\'e9ve a Gyehenna \'fatj\'e1ra, \'f6r\'f6kk\'f6n \'f6r\'f6kk\'e9 abban fognak maradni. Ez k\'f6nny\'fb Allah sz\'e1m\'e1ra.
\par 
\par 170. \'d3, emberek! Imm\'e1r elj\'f6tt hozz\'e1tok a k\'fcld\'f6tt (Mohamed) az igazs\'e1ggal az Uratokt\'f3l. Higgyetek h\'e1t, ez jobb nektek! \'c1m ha }{\cf1\insrsid14643188\charrsid14643188 hitetlenn\'e9 v\'e1ltok}{\insrsid14643188\charrsid14643188 
, nos Allah\'e9 mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van. Allah a Mindentud\'f3, a B\'f6lcs.
\par 
\par 171. \'d3, \'cdr\'e1s n\'e9pe! Ne k\'f6vessetek el t\'falz\'e1st a vall\'e1sotokban! \'c9s Allahr\'f3l csak az igazs\'e1got mondj\'e1tok! Bizony, J\'e9zus, a Messi\'e1s, M\'e1ria fia, csup\'e1n Allah k\'fcld\'f6tte, \'e9s az \'d5 szava, melyet M\'e1ri\'e1
ra vetett, \'e9s T\'f5le sz\'e1rmaz\'f3 (\'e1ltala teremtett) l\'e9lek. Higgyetek Allahban \'e9s a k\'fcld\'f6tteiben, \'e9s ne mondj\'e1tok: \'84H\'e1rom!\'94 Hagyj\'e1tok abba! Ez jobb nektek. Bizony, Allah csup\'e1n Egyetlen Isten \endash 
 magasztaltass\'e9k [t\'e1vol \'e1ll T\'f5le], hogy fi\'fagyermeke legyen neki! \'d6v\'e9 mindaz, ami az egekben \'e9s ami a f\'f6ld\'f6n van. \'c9s Allah elegend\'f5 v\'e9delmez\'f5nek!
\par 172. A Messi\'e1s nem tartja al\'e1val\'f3nak, hogy Allah szolg\'e1ja legyen, \'e9s az [Allahoz] k\'f6zell\'e9v\'f5 angyalok sem. Aki al\'e1val\'f3nak tartja az \'d5 szolg\'e1lat\'e1t, \'e9s fennh\'e9j\'e1zik, h\'e1t egybe fogja gy\'fbjteni Mag\'e1hoz 
\'f5ket, mindannyiukat.
\par 
\par 173. \'c1m azok, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben], \'e9s j\'f3tetteket cselekszenek, azoknak teljes m\'e9rt\'e9kben megadja a jutalmaikat, \'e9s \'d5 a kegy\'e9b\'f5l gyarap\'edtja \'f5
ket [jutalomban]. \'c1m azokat, akik al\'e1val\'f3nak tartj\'e1k [az \'d5 szolg\'e1lat\'e1t] \'e9s fennh\'e9j\'e1znak, azokat f\'e1jdalmas gy\'f6trelemmel fogja megb\'fcntetni. \'c9s nem tal\'e1lnak maguknak Allah helyett sem p\'e1rtfog\'f3t, sem seg\'edt
\'f5t.
\par 174. \'d3 ti, emberek! Imm\'e1r bizony\'edt\'e9k (Mohamed Pr\'f3f\'e9ta) j\'f6tt el hozz\'e1tok az Uratokt\'f3l, \'e9s nyilv\'e1nval\'f3 vil\'e1goss\'e1got (a Kor\'e1nt) bocs\'e1tottunk le nektek.
\par 175. Ami azokat illeti, akik hisznek Allahban, \'e9s ragaszkodnak Hozz\'e1, azokat a T\'f5le sz\'e1rmaz\'f3 k\'f6ny\'f6r\'fcletbe \'e9s kegybe fogja bebocs\'e1tani, \'e9s az Egyenes \'faton fogja vezetni \'f5ket Mag\'e1hoz.
\par 
\par 176. Felvil\'e1gos\'edt\'e1st k\'e9rnek t\'f5led [\'f3 Mohamed]. Mondd: \'84Allah felvil\'e1gos\'edt\'e1st ad nektek a gyermektelen \'e1rv\'e1r\'f3l: Ha egy f\'e9rfi \'fagy hal meg, hogy nincs gyermeke [se sz\'fclei], de van egy le\'e1nytestv\'e9
re, akkor neki a fele j\'e1r annak, amit h\'e1trahagyott. [A le\'e1nytestv\'e9re hal\'e1la eset\'e9n], a fi\'fatestv\'e9r [az eg\'e9szet] \'f6r\'f6kli t\'f5le, ha annak nem volt gyermeke. Ha [a gyermektelen \'e1rv\'e1nak] k\'e9t le\'e1nytestv\'e9
re van, akkor nekik a k\'e9tharmada j\'e1r annak, amit h\'e1trahagyott. Ha t\'f6bben vannak testv\'e9rek, f\'e9rfiak \'e9s n\'f5k is, abban az esetben a f\'e9rfinak k\'e9tszer annyi j\'e1r, mint a n\'f5nek. Allah nyilv\'e1nval\'f3v\'e1
 teszi [ezt] nektek, nehogy elt\'e9velyedjetek. \'c9s Allah minden dologr\'f3l tudom\'e1ssal b\'edr.\'94
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\expnd6\expndtw32\insrsid5256501 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid15821247 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid15821247 \page }{
\f0\fs24\insrsid3162389 5. Az asztal (Al-M\'e1}{\f0\fs24\insrsid15821247\charrsid15821247 ida) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid15821247 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 
\par 1. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Teljes\'edts\'e9tek a szerz\'f5d\'e9seket! Meg lettek engedve sz\'e1motokra a n\'e9gyl\'e1b\'fa j\'f3sz\'e1gok, kiv\'e9ve az, ami recit\'e1
ltatik nektek. Ne tegy\'e9tek megengedett\'e9 [magatoknak] a vad\'e1szatot, mik\'f6zben tilalmas \'e1llapotban vagytok! Bizony, Allah azt rendel el, amit akar.
\par 2. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne tegy\'e9tek megengedett\'e9 (megszeghet\'f5v\'e9) az Allah \'e1ltal kijel\'f6lt szertart\'e1sokat, sem a tilalmas h\'f3napot, sem az \'e1
ldozati \'e1llatokat, sem a nyak\'f6rvvel jel\'f6lteket [k\'f6z\'fcl\'fck], sem pedig azokat, akik a Tilalmas H\'e1zhoz tartanak, Uruk kegy\'e9t \'e9s megel\'e9ged\'e9s\'e9t keresve! Ha m\'e1r kil\'e9ptetek a tilalmas \'e1llapotb\'f3l, akkor vad\'e1
szhattok. \'c9s ne ind\'edtson titeket egy n\'e9p ir\'e1nti gy\'fbl\'f6letetek \endash  amiatt, hogy t\'e1vol tartottak titeket a Tilalmas Mecsett\'f5l \endash  arra, hogy t\'falkap\'e1sra vetemedjetek! \'c9s seg\'edts\'e9tek egym\'e1st a j\'f3s\'e1gban 
\'e9s az istenf\'e9lelemben, \'e1m ne seg\'edts\'e9tek egym\'e1st a b\'fbnben \'e9s az ellens\'e9gesked\'e9sben! F\'e9lj\'e9tek Allahot! Bizony, Allah szigor\'fa a b\'fcntet\'e9sben.
\par }{\insrsid12147099 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid6031785 {\insrsid15821247 3. Tilalmass\'e1 t\'e9tetett nektek az elhullott \'e1llat [h\'fasa], a v\'e9r, a diszn\'f3h\'fa}{\insrsid6031785 s, \'e9
s mindaz, amit Allah helyett [t\'e1rsistennek]}{\insrsid15821247  aj\'e1nlottak fel, tov\'e1bb\'e1 a megfojtott, az agyon\'fct\'f6tt, a [zuhan\'e1s miatt] hal\'e1lra z\'faz\'f3dott, a hal\'e1lra \'f6klelt, \'e9s a ragadoz\'f3kt\'f3l sz\'e9tmarcangolt \'e1
llat [h\'fasa], kiv\'e9ve, ha [m\'e9g \'e9lve] v\'e1gj\'e1tok le. \'c9s [tilalmas] mindaz, amit az \'e1ldozati [b\'e1lv\'e1ny] k\'f6v\'f6n v\'e1gtak le. \'c9s [tilalmas] nektek az is, hogy j\'f3sl\'f3-p\'e1lc\'e1kkal hozzatok d\'f6nt\'e9st. Ez engedetlens
\'e9g! A mai napon }{\cf1\insrsid15821247 azok, akik hitetlenn\'e9 v\'e1ltak,}{\insrsid15821247  feladt\'e1k a rem\'e9ny\'fcket vall\'e1sotok kapcs\'e1n [abban, hogy elhagyj\'e1tok], ne f\'e9ljetek h\'e1t t\'f5l\'fck, hanem T\'f5lem f\'e9
ljetek! A mai napon befejezett\'e9 tettem sz\'e1motokra a vall\'e1sotokat, \'e9s kiteljes\'edtettem r\'e1tok a kegyemet, \'e9s az iszl\'e1mot v\'e1lasztottam nektek vall\'e1sul. \'c1m aki \'e9h\'edns\'e9g miatt k\'e9nyszer\'fc
l [megszegni a tilalmat], nem pedig a b\'fbnre val\'f3 hajland\'f3s\'e1gb\'f3l, [akkor] Allah Megbocs\'e1t\'f3, Irgalmas.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid12147099 
\par }{\insrsid15821247 4. K\'e9rdeznek t\'e9ged [\'f3 Mohamed] arr\'f3l, hogy mi lett megengedve nekik [az \'e9telekb\'f5l]. Mondd: \'84Megengedtettek nektek a j\'f3 dolgok, \'e9s a betan\'edtott ragadoz\'f3knak [a zs\'e1km\'e1nya], amelyeket vad\'e1szatra k
\'fcldt\'f6k, megtan\'edtva azokat [a vad\'e1szat fog\'e1saib\'f3l] arra, amire Allah tan\'edtott meg titeket. Egyetek h\'e1t abb\'f3l, amit nektek fogtak, eml\'edts\'e9tek meg Allah nev\'e9t felette, \'e9s f\'e9lj\'e9
tek Allahot! Bizony, Allah gyors az elsz\'e1moltat\'e1sban.\'94
\par 5. A mai napon }{\insrsid15821247\charrsid3292151 meg }{\insrsid15821247\charrsid4813608 lettek}{\insrsid15821247  engedve nektek a j\'f3 dolgok, \'e9s azok \'e9lelme, akiknek az \'cdr\'e1s adatott, megengedett sz\'e1motokra, \'e9s a ti \'e9
lelmetek megengedett az \'f5 sz\'e1mukra. [Megengedett nektek a h\'e1zass\'e1g] a tisztess\'e9ges (szabad) h\'edv\'f5 asszonyokkal, \'e9s a tisztess\'e9ges asszonyokkal }{\insrsid15821247\charrsid13659309 azok k\'f6z\'fcl, akiknek}{\insrsid15821247  az 
\'cdr\'e1s adatott el\'f5ttetek, ha megadj\'e1tok nekik a j\'e1rand\'f3s\'e1gukat (n\'e1szaj\'e1nd\'e9kukat), tisztess\'e9gesekk\'e9nt, nem par\'e1zn\'e1kk\'e9nt, se nem szeret\'f5ket tart\'f3kk\'e9
nt. Aki pedig megtagadja a hitet, annak szertefoszlik a cselekedete, \'e9s \'f5 a t\'falvil\'e1gon a vesztesek k\'f6z\'e9 fog tartozni.
\par }{\insrsid12147099 
\par }{\insrsid15821247 6. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Amikor neki\'e1lltok [megtartani] az im\'e1dkoz\'e1st, moss\'e1tok meg az arcotokat \'e9s mindk\'e9t karotokat k\'f6ny
\'f6kig, \'e9s t\'f6r\'f6lj\'e9tek \'e1t a fejeteket, \'e9s [moss\'e1tok meg] l\'e1batokat bok\'e1ig! Ha pedig h\'e1zas\'e9let [vagy mag\'f6ml\'e9s] ut\'e1ni \'e1llapotban vagytok, akkor tiszt\'e1lkodjatok (f\'fcr\'f6djetek meg)! Ha betegek lenn\'e9
tek, vagy \'faton vagytok, vagy valamelyik\'f5t\'f6k az illemhelyr\'f5l j\'f6n, vagy asszonyokat \'e9rintettetek, \'e9s nem tal\'e1ltok vizet, akkor folyamodjatok a tiszta talajhoz, \'e9s t\'f6r\'f6lj\'e9tek meg azzal az arcotokat \'e9
s a kezeteket! Allah nem akar semmilyen fesz\'e9lyezetts\'e9get okozni nektek, hanem meg akar tiszt\'edtani titeket, \'e9s kiteljes\'edteni r\'e1tok a j\'f3t\'e9tem\'e9ny\'e9t, h\'e1tha h\'e1l\'e1sak lesztek.
\par }{\insrsid12147099 
\par }{\insrsid15821247 7. \'c9s eml\'e9kezzetek Allah j\'f3t\'e9tem\'e9ny\'e9re ir\'e1ntatok, \'e9s a sz\'f6vets\'e9g\'e9re, amit veletek k\'f6t\'f6tt, amikor azt mondt\'e1tok: \'84Halljuk \'e9s engedelmesked\'fcnk.\'94 F\'e9lj\'e9tek h\'e1
t Allahot! Bizony, Allahnak tudom\'e1sa van arr\'f3l, amit a keblek rejtenek.
\par 8. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Legyetek fenntart\'f3i [az igazs\'e1gnak] Allah\'e9rt, tan\'fakk\'e9nt az igazs\'e1goss\'e1g mellett, \'e9s ne ind\'edtson titeket egy n\'e9
p ir\'e1nti gy\'fbl\'f6letetek arra, hogy igazs\'e1gtalanok legyetek! Legyetek h\'e1t igazs\'e1gosak, ez k\'f6zelebb \'e1ll az istenf\'e9lelemhez! \'c9s f\'e9lj\'e9tek Allahot! \'c9s Allah j\'f3l ismeri mindazt, amit cselekszetek.
\par }{\insrsid12147099 
\par }{\insrsid15821247 9. Allah meg\'edg\'e9rte azoknak, akik hisznek, \'e9s j\'f3tetteket cselekszenek, hogy megbocs\'e1t\'e1s \'e9s hatalmas jutalom j\'e1r nekik.
\par 10. \'c9s azok, akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247  \'e9s meghazudtolj\'e1k a jeleinket, \'f5k a Pokol lak\'f3i.
\par }{\insrsid12147099 
\par }{\insrsid15821247 11. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Eml\'e9kezzetek Allah j\'f3t\'e9tem\'e9ny\'e9re ir\'e1ntatok, amikor az emberek arra t\'f6rekedtek, hogy kiny\'fajts\'e1
k a kez\'fcket ellenetek, \'e1m \'d5 t\'e1vol tartotta a kez\'fcket t\'f5letek}{\insrsid15821247\charrsid3292151 ! }{\insrsid15821247\charrsid13659309 \'c9s f\'e9lj\'e9tek}{\insrsid15821247  Allahot, \'e9s Allahra hagyatkozzanak h\'e1t a h\'edv\'f5k!

\par }{\insrsid12147099 
\par }{\insrsid15821247 12. \'c9s bizony Allah m\'e1r sz\'f6vets\'e9get k\'f6t\'f6tt Izrael fiaival, \'e9s tizenk\'e9t k\'e9pvisel\'f5t t\'e1masztottunk k\'f6z\'fcl\'fck. Allah azt mondta: \'84\'c9n veletek vagyok, ha megtartj\'e1tok az im\'e1dkoz\'e1
st, megadj\'e1tok a k\'f6telez\'f5 adom\'e1nyt, hisztek a k\'fcld\'f6tteimben, t\'e1mogatj\'e1tok \'f5ket, }{\insrsid15821247\charrsid3307951 \'e9s sz\'e9p k\'f6lcs\'f6nt adtok Allahnak (a k\'f6telez\'f5n fel\'fcl ad}{\insrsid15821247 akoz}{
\insrsid15821247\charrsid3307951 tok),}{\insrsid15821247  akkor bizony elt\'f6rl\'f6m r\'f3latok a rossz tetteiteket, \'e9s olyan kertekbe bocs\'e1talak be titeket, amelyek alatt foly\'f3k folynak, \'e9s aki ezut\'e1n }{\cf1\insrsid15821247 hitetlenn\'e9
 v\'e1lik}{\insrsid15821247  k\'f6z\'fcletek, az imm\'e1r elt\'e9velyedett az egyenes \'fatt\'f3l.\'94
\par 13. \'c9s mivel megszegt\'e9k a sz\'f6vets\'e9get, meg\'e1tkoztuk \'f5ket, \'e9s kem\'e9nny\'e9 tett\'fck a sz\'edv\'fcket. Kiforgatj\'e1k a szavakat a hely\'fckr\'f5l (jelent\'e9s\'fckb\'f5l), \'e9s elfelejtik egy r\'e9sz\'e9t annak, amire eml\'e9keztet
\'e9st kaptak, \'e9s m\'e9g mindig szembes\'fclsz \'e1rul\'e1ssal a r\'e9sz\'fckr\'f5l, csup\'e1n kevesen [nem ilyenek] k\'f6z\'fcl\'fck. N\'e9zd h\'e1t el nekik, \'e9s hagyj fel [a b\'fcntet\'e9s\'fckkel]! Bizony, Allah szereti a }{
\insrsid15821247\charrsid3307951 j\'f3tev\'f5ket}{\insrsid15821247 .
\par }{\insrsid12147099 
\par }{\insrsid15821247 14. \'c9s sz\'f6vets\'e9get k\'f6t\'f6tt\'fcnk azokkal is, akik azt mondt\'e1k: \'84Mi kereszt\'e9nyek vagyunk\'94, \'e1m elfelejtett\'e9k egy r\'e9sz\'e9t annak, amire eml\'e9keztet\'e9st kaptak, ez\'e9rt ellens\'e9gesked\'e9st \'e9
s gy\'fbl\'f6letet gerjesztett\'fcnk k\'f6z\'f6tt\'fck a Felt\'e1mad\'e1s Napj\'e1ig. }{\insrsid15821247\charrsid7696958 \'c9s}{\insrsid15821247  Allah h\'edr\'fcl fogja adni nekik, amit m\'fbveltek.
\par }{\insrsid12147099 
\par }{\insrsid15821247 15. \'d3 \'cdr\'e1s n\'e9pe! Imm\'e1r elj\'f6tt hozz\'e1tok a k\'fcld\'f6tt\'fcnk (Mohamed), vil\'e1goss\'e1 tesz nektek sokat abb\'f3l, amit elrejtettetek az \'cdr\'e1sb\'f3l, \'e9s eltekint sokt\'f3l [abb\'f3
l, amit elrejtettetek]. Bizony, vil\'e1goss\'e1g j\'f6tt el hozz\'e1tok Allaht\'f3l, \'e9s nyilv\'e1nval\'f3 \'cdr\'e1s (a Kor\'e1n).
\par 16. Allah azokat vezeti \'e1ltala a b\'e9kess\'e9g \'fatjaira, akik k\'f6vetik azt, amivel elnyerik az \'d5 el\'e9gedetts\'e9g\'e9t, \'e9s kihozza \'f5ket a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gekb\'f5l a vil\'e1goss\'e1gra, az \'d5 engedelm\'e9vel, 
\'e9s egyenes \'fatra vezeti \'f5ket.
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 17. Bizony, }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247  azok, akik azt mondj\'e1k: \'84
Bizony, Allah a Messi\'e1s, M\'e1ria fia.\'94 Mondd [\'f3 Mohamed]: \'84Kinek \'e1ll m\'f3dj\'e1ban [b\'e1rmit is tenni] Allahhal szemben, ha \'d5 azt akarja, hogy elpuszt\'edtsa a Messi\'e1st, M\'e1ria fi\'e1t, \'e9s az anyj\'e1t, \'e9
s mindenkit, aki a f\'f6ld\'f6n van?\'94 Allah\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett, \'e9s [afelett] ami k\'f6z\'f6tt\'fck van. Azt teremt, amit akar, \'e9s Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par }{\insrsid12147099 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 18. A zsid\'f3k \'e9s a kereszt\'e9nyek azt mondt\'e1k: \'84Mi Allah gyermekei \'e9s szerettei vagyunk.\'94 Mondd [\'f3 Mohamed]: 
\'84Akkor mi\'e9rt s\'fajt gy\'f6trelemmel titeket a b\'fbneitek miatt?\'94 Dehogy! Ti emberek vagytok, azok k\'f6z\'fcl, akiket teremtett. Annak bocs\'e1t meg, akinek akar, \'e9s azt s\'fajtja gy\'f6trelemmel, akit akar. Allah\'e9 a kir\'e1
lyi uralom az egek \'e9s a f\'f6ld felett, \'e9s [afelett] ami k\'f6z\'f6tt\'fck van. \'c9s N\'e1la lesz a v\'e9gc\'e9l.
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 19. \'d3 \'cdr\'e1s n\'e9pe! Imm\'e1r elj\'f6tt hozz\'e1tok a k\'fcld\'f6tt\'fcnk, hossz\'fa id\'f5 eltelt\'e9
vel a k\'fcld\'f6ttek ut\'e1n, hogy vil\'e1goss\'e1 tegye nektek [az igazs\'e1got], az\'e9rt, hogy ne mondj\'e1tok: \'84Nem j\'f6tt el hozz\'e1nk sem \'f6r\'f6mh\'edrhoz\'f3, sem figyelmeztet\'f5.\'94 Imm\'e1r \'f6r\'f6mh\'edrhoz\'f3 \'e9s figyelmeztet
\'f5 j\'f6tt el hozz\'e1tok, \'e9s Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par }{\insrsid12147099 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 20}{\insrsid15821247\charrsid7696958 . \'c9s [eml\'edtsd meg,]}{\insrsid15821247  amikor M\'f3zes azt mondta a n\'e9p\'e9nek: \'84
\'d3 n\'e9pem! Eml\'e9kezzetek Allah ir\'e1ntatok tan\'fas\'edtott j\'f3t\'e9tem\'e9ny\'e9re, amikor pr\'f3f\'e9t\'e1kat t\'e1masztott k\'f6z\'f6ttetek, \'e9s uralommal ruh\'e1zott fel titeket [\'fcgyeitek felett], \'e9s olya
smit adott nektek, amit az [akkori] teremtm\'e9nyek k\'f6z\'fcl senkinek sem adott (a mann\'e1t \'e9s a f\'fcrjeket)!
\par 21. \'d3 n\'e9pem! L\'e9pjetek be a Szent F\'f6ldre, amit Allah meg\'edrt nektek, \'e9s ne ford\'edtsatok h\'e1tat (ne futamodjatok meg), mert akkor vesztesekk\'e9 v\'e1ltok!\'94
\par 22. Azt mondt\'e1k: \'84\'d3 M\'f3zes! Bizony ott egy hatalmas erej\'fb n\'e9p van (a k\'e1na\'e1nit\'e1k)! Mi addig oda nem l\'e9p\'fcnk be, am\'edg azok onnan ki nem mennek! Ha kimennek onnan, akkor mi bel\'e9p\'fcnk.\'94
\par 23. Azt mondta k\'e9t f\'e9rfi, azok k\'f6z\'fcl, akik f\'e9ltek [Allaht\'f3l] \endash  akiket Allah j\'f3t\'e9tem\'e9nyeiben r\'e9szes\'edtett: \'84L\'e9pjetek be hozz\'e1juk a kapun! Ha m\'e1r bel\'e9ptetek azon, ti lesztek a gy\'f5zelmet arat\'f3
k! Allahra hagyatkozzatok, ha [val\'f3ban] h\'edv\'f5k vagytok!\'94
\par 24. Azt mondt\'e1k: \'84\'d3 M\'f3zes! Mi bizony soha nem fogunk oda bel\'e9pni, am\'edg azok ott vannak. Menj te \'e9s az Urad, \'e9s harcoljatok! Mi addig itt maradunk.\'94
\par 25. Azt mondta: \'84Uram! Nem rendelkezem, csakis magam \'e9s testv\'e9rem (\'c1ron) felett. T\'e9gy h\'e1t igazs\'e1got k\'f6zt\'fcnk \'e9s az engedetlen n\'e9p k\'f6z\'f6tt!\'94
\par 26. [Allah] azt mondta: \'84Ez (a Szent F\'f6ld) tilalmas sz\'e1mukra negyven \'e9vig, bolyongani fognak a f\'f6ld\'f6n. Te azonban ne b\'e1nk\'f3dj az engedetlen n\'e9p miatt!\'94
\par }{\insrsid12147099 
\par }{\insrsid15821247 27. }{\insrsid15821247\charrsid7696958 \'c9s}{\insrsid15821247  recit\'e1ld nekik (az izraelit\'e1knak) \'c1d\'e1m k\'e9t fi\'e1nak (\'c1belnek \'e9s K\'e1innak) h\'edr\'e9t az igazs\'e1gnak megfelel\'f5en! [Eml\'ed
tsd meg,] amikor mindketten \'e1ldozatot aj\'e1nlottak fel [Allahnak], \'e1m az egyik\'f5j\'fckt\'f5l elfogadtatott, m\'edg a m\'e1sikt\'f3l nem fogadtatott el. [K\'e1in] azt mondta: \'84Bizony, meg foglak \'f6lni t\'e9ged!\'94 [\'c1bel] azt mondta: \'84
Bizony, Allah csup\'e1n az istenf\'e9l\'f5kt\'f5l fogad el.
\par 28. Ha kiny\'fajtod fel\'e9m a kezed, hogy meg\'f6lj engem, \'e9n nem fogom kiny\'fajtani a kezem fel\'e9d, hogy meg\'f6ljelek. Bizony, \'e9n f\'e9lek Allaht\'f3l, a teremtm\'e9nyek Ur\'e1t\'f3l,
\par 29. bizony azt akarom, hogy te viseld az ellenem val\'f3 b\'fbn (a meggyilkol\'e1som) [terh\'e9t], [eddigi] b\'fbn\'f6d mellett, \'e9s \'edgy a [Pokol-]t\'fbz lak\'f3i k\'f6z\'e9 tartozz! Ez az igazs\'e1gtalanok fizets\'e9ge.\'94
\par 30. \'c9s mag\'e1ban k\'e9sztet\'e9st \'e9rzett arra, hogy meg\'f6lje a testv\'e9r\'e9t, \'e9s meg is \'f6lte, \'edgy vesztes lett a vesztesek k\'f6z\'f6tt.
\par 31. \'c9s Allah elk\'fcld\'f6tt egy holl\'f3t, amely a f\'f6ld\'f6n keresg\'e9lt, hogy megmutassa neki, hogyan rejtse el testv\'e9re holttest\'e9t. Azt mondta: \'84Jaj nekem! H\'e1t k\'e9ptelen vagyok arra, hogy olyan legyek, mint ez a holl\'f3, \'e9
s elrejtsem testv\'e9rem holttest\'e9t?\'94 \'c9s a megb\'e1n\'f3k k\'f6z\'e9 tartozott.
\par }{\insrsid12147099 
\par }{\insrsid15821247 32. Emiatt \'edrtuk el\'f5 Izrael fiainak: \'84Az, hogy valaki meg\'f6l egy embert \endash  nem ember\'f6l\'e9s vagy a f\'f6ld\'f6n val\'f3 puszt\'edt\'e1s [b\'fcntet\'e9sek\'e9nt] \endash  olyan, mintha meg\'f6ln\'e9 az \'f6
sszes embert, \'e9s az, hogy valaki \'e9letben tartja, olyan mintha az \'f6sszes embert \'e9letben tartan\'e1!\'94 Bizony, elj\'f6ttek hozz\'e1juk a k\'fcld\'f6tteink a vil\'e1gos bizony\'edt\'e9kokkal, \'e1m ezek ut\'e1n sokan k\'f6z\'fcl\'fck m\'e9rt
\'e9ktelenek a f\'f6ld\'f6n.}{\insrsid12147099 
\par }{\insrsid15821247 33}{\insrsid15821247\charrsid3292151 . }{\insrsid15821247\charrsid7352158 Bizony azoknak, akik h\'e1bor\'faznak Allah \'e9s a k\'fcld\'f6tte ellen, \'e9s azon igyekeznek, hogy roml\'e1st okozzanak a f\'f6ld\'f6n [\'faton\'e1ll\'e1
ssal], csup\'e1n az a fizets\'e9g\'fck, hogy meg\'f6letnek, vagy felfesz\'edttetnek, vagy [egym\'e1ssal] ellent\'e9tesen kez\'fck \'e9s l\'e1buk lev\'e1gatik, vagy sz\'e1m\'fbzik \'f5ket a f\'f6ldr\'f5l. Ez megsz\'e9gyen\'edt\'e9s nekik az evil\'e1gon, 
\'e9s a t\'falvil\'e1gon hatalmas gy\'f6trelemben lesz r\'e9sz\'fck.}{\insrsid15821247 
\par 34. Kiv\'e9ve azokat, akik b\'fbnb\'e1natot tan\'fas\'edtanak m\'e9g azel\'f5tt, hogy hatalmatok al\'e1 ker\'fcln\'e9nek (elfogt\'e1tok \'f5ket). H\'e1t tudj\'e1tok meg, hogy Allah bizony Megbocs\'e1t\'f3, Irgalmas.
\par }{\insrsid12147099 
\par }{\insrsid15821247 35. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! F\'e9lj\'e9tek Allahot, \'e9s keress\'e9tek [az istenszolg\'e1latok k\'f6z\'fcl] a Hozz\'e1 val\'f3 k\'f6zeled\'e9s m
\'f3dj\'e1t, \'e9s k\'fczdjetek az \'d5 \'datj\'e1n! H\'e1tha boldogultok.
\par 36. Bizony, azok, akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247 , ha az \'f6v\'e9k lenne mindaz, ami a f\'f6ld\'f6n van, \'e9s azzal egy\'fctt m\'e9g egyszer annyi, hogy megv\'e1lts\'e1k vele magukat a Felt\'e1mad\'e1s napj\'e1
nak gy\'f6trelm\'e9t\'f5l, bizony nem fogadtatik el t\'f5l\'fck [v\'e1lts\'e1gd\'edjk\'e9nt] }{\insrsid15821247\charrsid12083648 \'e9s}{\insrsid15821247  f\'e1jdalmas gy\'f6trelem j\'e1r nekik.
\par 37. Ki akarnak majd j\'f6nni a [Pokol-]t\'fbzb\'f5l, \'e1m \'f5k nem fognak onnan }{\insrsid15821247\charrsid3292151 kij\'f6nni}{\insrsid15821247\charrsid12083648 , \'e9s}{\insrsid15821247  \'f6r\'f6kk\'e9 tart\'f3 gy\'f6trelem j\'e1r nekik.
\par }{\insrsid12147099 
\par }{\insrsid15821247 38. [\'d3 ti, \'edt\'e9let-v\'e9grehajt\'f3k!] A tolvaj f\'e9rfinak \'e9s a tolvaj n\'f5nek v\'e1gj\'e1tok le a kez\'e9t, fizets\'e9gk\'e9nt az\'e9rt, }{\insrsid15821247\charrsid12083648 amit szereztek (elk\'f6vettek)}{
\insrsid15821247\charrsid3292151 ,}{\insrsid15821247  \'e9s elrettent\'f5 b\'fcntet\'e9sk\'e9nt Allaht\'f3l! \'c9s Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs. 
\par 39. Aki }{\insrsid15821247\charrsid12083648 azonban}{\insrsid15821247  b\'fbnb\'e1natot tan\'fas\'edt igazs\'e1gtalans\'e1ga [elk\'f6vet\'e9se] ut\'e1n \'e9s megjavul}{\insrsid15821247\charrsid3292151 , }{\insrsid15821247\charrsid1068747 afel\'e9}{
\insrsid15821247  bizony Allah kiengesztel\'f5dve fordul. Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 40. Vajon nem tudod, hogy Allah\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett? Azt }{
\insrsid15821247\charrsid15821247 s\'fajtj}{\insrsid15821247 a gy\'f6tre}{\insrsid15821247\charrsid15821247 lemmel}{\insrsid15821247 , akit akar, \'e9s annak bocs\'e1t meg, akinek akar. Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par }{\insrsid12147099 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 41. \'d3 te, K\'fcld\'f6tt! Ne szomor\'edtsanak el azok, akik sietve igyekeznek a hitetlens\'e9gben azok k\'f6z\'fcl, akik a sz
\'e1jukkal azt mondj\'e1k: \'84Hisz\'fcnk!\'94, de a sz\'edv\'fck nem hisz. \'c9s azok k\'f6z\'fcl, akik zsid\'f3k, vannak, akik hallgatnak a hazugs\'e1gra, \'e9s hallgatnak m\'e1s n\'e9pekre, akik nem }{\insrsid15821247\charrsid1068747 [is]}{
\insrsid15821247\charrsid3292151  j\'f6ttek el hozz\'e1d. }{\insrsid15821247\charrsid1068747 [Akik]}{\insrsid15821247  kiforgatj\'e1k a szavakat, miut\'e1n a hely\'fckre ker\'fcltek (r\'f6gz\'edtve lettek), \'e9s azt mondj\'e1k: \'84Ha ez (az \'edr\'e1
stud\'f3k \'e1ltal kiforgatott \'edt\'e9let) adatik meg nektek, akkor fogadj\'e1tok el, \'e1m ha nem adatik meg nektek, akkor \'f3vakodjatok}{\insrsid15821247\charrsid10818958 !}{\insrsid15821247 \'94}{\insrsid15821247\charrsid10818958  \'c1m akit Allah k
\'eds\'e9rt\'e9sbe (t\'e9velyg\'e9sbe) akar vinni, annak \'e9rdek\'e9ben nem \'e1ll m\'f3dodban [b\'e1rmit is tenni] Allahhal szemben.}{\insrsid15821247\charrsid3292151  \'d5k azok,}{\insrsid15821247  akiknek Allah nem akarta megtiszt\'edtani a sz\'edv
\'e9t, sz\'e9gyen j\'e1r nekik az evil\'e1gon, \'e9s a t\'falvil\'e1gon hatalmas gy\'f6trelemben lesz r\'e9sz\'fck.
\par 42. Hallgatnak a hazugs\'e1gra, \'e9s buzg\'f3n felfalj\'e1k a jogtalanul szerzett vagyont. Ha elj\'f6nnek hozz\'e1d [\'edt\'e9lkez\'e9s\'e9rt], akkor \'edt\'e9lkezz k\'f6z\'f6tt\'fck vagy fordulj el t\'f5l\'fck! \'c9s ha elfordulsz t\'f5l\'fc
k, akkor semmiben sem \'e1rthatnak neked. \'c1m ha \'edt\'e9lkezel k\'f6z\'f6tt\'fck, \'edt\'e9lkezz k\'f6z\'f6tt\'fck igazs\'e1ggal! Allah szereti az igazs\'e1gosakat.
\par 43}{\insrsid15821247\charrsid3292151 . }{\insrsid15821247\charrsid1068747 \'c9s hogyan}{\insrsid15821247  tehetnek meg t\'e9ged d\'f6nt\'f5b\'edr\'f3nak, mik\'f6zben n\'e1luk van a T\'f3ra, amelyben ott van Allah \'edt\'e9lete! Majd azut\'e1n (az \'edt
\'e9leted ut\'e1n) elfordulnak. \'c9s \'f5k nem h\'edv\'f5k!
\par }{\insrsid12147099 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13315891 {\insrsid15821247 44. Bizony, mi lebocs\'e1tottuk a T\'f3r\'e1t \endash  amiben \'fatmutat\'e1s \'e9s vil\'e1goss\'e1g van \endash  amely \'e1
ltal a Pr\'f3f\'e9t\'e1k, akik al\'e1vetett\'e9k magukat [Allahnak], azok k\'f6z\'f6tt \'edt\'e9lkeztek, akik zsid\'f3k. \'c9s az \'dar h\'fb szolg\'e1i \'e9s az \'edr\'e1stud\'f3k aszerint [\'edt\'e9lkeztek], ami Allah \'cdr\'e1s\'e1b\'f3l meg\'f5rz\'e9
sre r\'e1juk lett b\'edzva}{\insrsid15821247\charrsid1068747 ,}{\insrsid15821247  \'e9s \'f5k erre tan\'fak voltak. H\'e1t }{\insrsid13315891 [ti zsid\'f3 \'edr\'e1stud\'f3sok] }{\insrsid15821247 ne f\'e9ljetek az emberekt\'f5l, hanem T\'f5lem f\'e9
ljetek! }{\insrsid3162389 \'c9s n}{\insrsid15821247 e k\'f3tyavety\'e9lj\'e9tek el csek\'e9ly \'e1ron a jeleimet (a szavaimat}{\insrsid15821247\charrsid3162389 )! \'c9s akik nem aszerint \'edt\'e9lke}{\insrsid2372136\charrsid3162389 znek, amit 
Allah lebocs\'e1tott, azok }{\insrsid15207594\charrsid3162389 bizony}{\insrsid15821247\charrsid3162389  a hitetlenek.}{\insrsid15821247 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 45. }{\insrsid15821247\charrsid1068747 \'c9s m}{\insrsid15821247\charrsid3292151 eg\'edrtuk}{\insrsid15821247  nekik abban}{
\insrsid3162389  azt}{\insrsid15821247 , hogy az \'e9letet az \'e9let\'e9rt, a szemet a szem\'e9rt, az orrot az orr\'e9rt, a f\'fclet a f\'fcl\'e9rt, a fogat a fog\'e9rt, \'e9s a sebes\'fcl\'e9sek a kiegyenl\'edt\'e9s [t\'f6rv\'e9nye] al\'e1
 esnek. Ha valaki }{\insrsid15821247\charrsid13315891 adakoz\'e1sk\'e9ppen mond le ezekr\'f5l (a t\'f6rv\'e9ny adta jogair\'f3l), az elt\'f6rl\'e9s sz\'e1m\'e1ra [a b\'fbnei egy r\'e9sz\'e9re n\'e9zve]. \'c9s akik nem aszerint \'edt\'e9
lkeznek, amit Allah lebocs\'e1tott, }{\insrsid2372136\charrsid13315891 azok bizony}{\insrsid15821247\charrsid13315891  az igazs\'e1gtalanok.
\par 46. \'c9s ut\'e1nuk k\'fcldt\'fck, az \'f5 nyomdokaikba, J\'e9zust, M\'e1ria fi\'e1t, igazolva annak az igazs\'e1g\'e1t, ami el\'f5tte volt a T\'f3r\'e1b\'f3l, \'e9s odaadtuk neki az Evang\'e9liumot, amelyben \'fatmutat\'e1s \'e9s vil\'e1goss\'e1
g van, igazolva annak az igazs\'e1g\'e1t, ami el\'f5tte volt a T\'f3r\'e1b\'f3l, \'fatmutat\'e1sk\'e9nt \'e9s int\'e9sk\'e9nt az istenf\'e9l\'f5knek.
\par 47. \'c9s \'edt\'e9lkezzen az Evang\'e9lium n\'e9pe aszerint, amit Allah lebocs\'e1tott abban, \'e9s akik nem aszerint \'edt\'e9lkez}{\insrsid2372136\charrsid13315891 nek, amit Allah lebocs\'e1tott, azok bizony }{\insrsid15821247\charrsid13315891 
az engedetlenek.}{\insrsid15821247 
\par }{\insrsid12147099 
\par }{\insrsid15821247 48. \'c9s lebocs\'e1tottuk hozz\'e1d [\'f3 K\'fcld\'f6tt] az \'cdr\'e1st (a Kor\'e1nt) az igazs\'e1ggal, igazolv\'e1n annak az igazs\'e1g\'e1t ami el\'f5tte volt az }{\insrsid15821247\charrsid9658347 \'cdr\'e1sb\'f3l}{\insrsid15821247  
\'e9s d\'f6nt\'f5 tan\'fak\'e9nt vele szemben. \'cdt\'e9lkezz h\'e1t k\'f6z\'f6tt\'fck aszerint, amit Allah lebocs\'e1tott, \'e9s ne k\'f6vesd az \'f5 k\'e9nyeiket att\'f3l }{\insrsid15821247\charrsid13974238 [elfordulva vagy elt\'e9rve],}{
\insrsid15821247  ami elj\'f6tt hozz\'e1d az igazs\'e1gb\'f3l! }{\insrsid15821247\charrsid13974238 Mindenkinek t\'f6rv\'e9nyt \'e9s vil\'e1gos utat \'edrtunk el\'f5}{\insrsid15821247\charrsid3292151 . }{\insrsid15821247\charrsid13974238 \'c9s ha}{
\insrsid15821247  Allah \'fagy akarta volna, egyetlen k\'f6z\'f6ss\'e9gg\'e9 tett volna titeket, \'e1m [sz\'e9tv\'e1lasztott benneteket], hogy pr\'f3b\'e1ra tegyen titeket az\'e1ltal, amit nektek adott. Igyekezzetek h\'e1t el\'f6l j\'e1rni a j\'f3
tettekben! Mindny\'e1jatoknak Allahhoz lesz a visszat\'e9r\'e9se, \'e9s \'d5 tudatni fogja veletek azt, amiben k\'fcl\'f6nb\'f6ztetek.
\par 49. \'c9s \'edt\'e9lkezz k\'f6z\'f6tt\'fck aszerint, amit Allah lebocs\'e1tott, \'e9s ne k\'f6vesd az \'f5 k\'e9ny\'fcket! \'c9s \'f3vakodj t\'f5l\'fck, nehogy k\'eds\'e9rt\'e9sbe vigyenek (elt\'e9r\'edtsenek t\'e9ged) annak egy r\'e9sz\'e9t\'f5
l, amit Allah lebocs\'e1tott neked! Ha elfordulnak, \'fagy tudnod kell, hogy bizony, Allah csup\'e1n a b\'fbneik egy r\'e9sze miatt akar les\'fajtani r\'e1juk. Bizony, az emberek k\'f6z\'fcl sokan engedetlenek.}{\insrsid12147099 
\par }{\insrsid15821247 50. Vajon a tudatlans\'e1g kora (az iszl\'e1m el\'f5tti korszak) \'edt\'e9lkez\'e9s\'e9t k\'edv\'e1nj\'e1k [k\'f6vetni]? \'c9s ki jobb \'edt\'e9lkez\'f5 Allahn\'e1l egy olyan n\'e9p sz\'e1m\'e1ra, akik teljes bizonyoss\'e1ggal hisznek?

\par }{\insrsid12147099 
\par }{\insrsid15821247 51. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne tegy\'e9tek a zsid\'f3kat \'e9s a kereszt\'e9nyeket }{\insrsid15821247\charrsid3292151 p\'e1rtfog\'f3kk\'e1! Egyik
\'fck a m\'e1sik p\'e1rtfog\'f3ja. Aki }{\insrsid15821247\charrsid13974238 azonban}{\insrsid15821247\charrsid3292151  k\'f6z\'fcletek p\'e1rtfog\'f3nak fogadja \'f5ket, }{\insrsid15821247\charrsid13974238 az bizony}{\insrsid15821247  k\'f6z\'fcl\'fck val
\'f3! Bizony, Allah nem vezeti [az igaz] \'fatra az igazs\'e1gtalan n\'e9pet.
\par 52. L\'e1thatod azokat, akiknek a sz\'edv\'e9ben betegs\'e9g lakozik (a k\'e9pmutat\'f3k), amint sietve igyekeznek \'e9rt\'fck (megel\'e9ged\'e9s\'fck\'e9rt), azt mondv\'e1n: \'84F\'e9l\'fcnk att\'f3l, hogy valami sorsfordulat s\'fajt majd minket!\'94 
\'c1m lehet, hogy Allah gy\'f5zelmet vagy T\'f5le sz\'e1rmaz\'f3 parancsot hoz [a k\'e9pmutat\'f3k leleplez\'e9s\'e9r\'f5l], \'e9s akkor megb\'e1nj\'e1k majd azt, amit magukban titkoltak.
\par 53. Azt mondj\'e1k azok, akik hisznek: \'84Vajon \'f5k azok, akik a leger\'f5teljesebb esk\'fcj\'fckkel esk\'fcdtek Allahra, hogy bizony \'f5k veletek vannak?\'94 Bizony szertefoszlanak a cselekedeteik, \'e9s vesztesekk\'e9 v\'e1ltak.
\par }{\insrsid12147099 
\par }{\insrsid15821247 54. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Aki hitehagyott lesz, nos Allah olyan n\'e9pet fog el\'f5hozni, akiket szeret, \'e9s akik szeretik \'d5t, al\'e1
zattal vannak a h\'edv\'f5k ir\'e1nt, kem\'e9nyek a hitetlenekkel szemben. K\'fczdenek Allah \'datj\'e1n, \'e9s nem f\'e9lnek egyetlen szemreh\'e1ny\'f3 szemreh\'e1ny\'e1s\'e1t\'f3l sem. Ez Allah kegye, amit annak ad, akinek akar. Allah [mindent] \'c1tfog
\'f3, Mindentud\'f3.
\par 55. Bizony, a ti p\'e1rtfog\'f3tok csup\'e1n Allah, \'e9s a k\'fcld\'f6tte, \'e9s azok, akik hisznek, akik megtartj\'e1k az im\'e1dkoz\'e1st, megadj\'e1k a }{\insrsid15821247\charrsid13974238 k\'f6telez\'f5 adom\'e1nyt}{\insrsid15821247 , mik\'f6
zben meghajolnak (al\'e1zatot tan\'fas\'edtanak).
\par 56. Aki p\'e1rtfog\'f3nak fogadja Allahot, a K\'fcld\'f6tt\'e9t, \'e9s azokat, akik hisznek, nos bizony Allah sz\'f6vets\'e9gesei }{\insrsid15821247\charrsid13974238 a gy\'f5zelmet arat\'f3k!}{\insrsid15821247 
\par }{\insrsid12147099 
\par }{\insrsid15821247 57. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne tegy\'e9tek p\'e1rtfog\'f3itokk\'e1 azokat, akik vall\'e1sotokat g\'fany \'e9s j\'e1t\'e9k t\'e1rgy\'e1v\'e1
 teszik, azok k\'f6z\'fcl, akik megkapt\'e1k az \'cdr\'e1st el\'f5ttetek, \'e9s a hitetleneket sem! }{\insrsid15821247\charrsid7945400 \'c9s f\'e9lj\'e9tek}{\insrsid15821247  Allahot, ha val\'f3ban h\'edv\'f5k vagytok!
\par 58. Ha im\'e1dkoz\'e1sra h\'edvtok fel, \'f5k azt g\'fany \'e9s j\'e1t\'e9k t\'e1rgy\'e1v\'e1 teszik. Ez az\'e9rt van, mert \'f5k egy olyan n\'e9p, akik nem \'e9lnek az esz\'fckkel.
\par }{\insrsid12147099 
\par }{\insrsid15821247 59. Mondd [\'f3 Mohamed]: \'84\'d3 \'cdr\'e1s n\'e9pe! Csup\'e1n azt kifog\'e1solj\'e1tok benn\'fcnk, hogy mi hisz\'fcnk Allahban, \'e9s abban, ami lebocs\'e1ttatott nek\'fcnk, \'e9s abban is, ami kor\'e1bban lett lebocs\'e1tva, \'e9
s azt, hogy [}{\insrsid15821247\charrsid13450772 hisz\'fcnk abban, hogy] a legt\'f6bb k\'f6z\'fcletek engedetlen?\'94
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13315891 {\insrsid15821247\charrsid13450772 60. Mondd [\'f3 Mohamed]: \'84Vajon h\'edrt adjak-e nektek arr\'f3}{\insrsid13315891\charrsid13450772 l, ami ann
\'e1l is (az engedetlenek fizets\'e9g\'e9n\'e9l) rosszabb fizets\'e9g }{\insrsid15821247\charrsid13450772 Allaht\'f3l? }{\insrsid13315891\charrsid13450772 [}{\insrsid15821247\charrsid13450772 Azok}{\insrsid13315891\charrsid13450772 nak}{
\insrsid15821247\charrsid13450772  fizets\'e9ge], akiket Allah meg\'e1tkozott, \'e9s megharagudott r\'e1juk \endash  egyeseket k\'f6z\'fcl\'fck majmokk\'e1 \'e9s diszn\'f3kk\'e1 tett \endash  \'e9s akik a hamisan isten\'edtetteket (T\'e1gh\'fat) szolg\'e1
lt\'e1k, \'f5k a legrosszabb helyzet\'fbek, \'e9s a legjobban elt\'e9velyedtek az egyenes \'fatt\'f3l.\'94}{\insrsid15821247 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid11434367 
\par }{\insrsid15821247 61. \'c9s amikor elj\'f6nnek hozz\'e1tok, azt mondj\'e1k: \'84Hisz\'fcnk!\'94 \'c1m hitetlens\'e9ggel l\'e9pnek be, \'e9s \'f5k azzal is l\'e9pnek ki. \'c9s Allah jobban tudja azt, amit rejtenek.
\par 62. \'c9s l\'e1thatsz sokakat k\'f6z\'fcl\'fck, amint sietve igyekeznek a b\'fbnben, az ellens\'e9gesked\'e9sben, \'e9s a jogtalanul szerzett vagyon felfal\'e1s\'e1ban. Mily nyomor\'fas\'e1gos dolgot cselekszenek.
\par 63. H\'e1t mi\'e9rt nem tiltott\'e1k meg nekik az \'dar h\'fb szolg\'e1i \'e9s az \'edr\'e1stud\'f3k b\'fbn\'f6s besz\'e9d\'fcket \'e9s a jogtalanul szerzett vagyon felfal\'e1s\'e1t? Mily nyomor\'fas\'e1gos dolgot m\'fbvelnek!
\par 64. A zsid\'f3k azt mondj\'e1k: \'84Allah keze meg van bilincselve!\'94 Legyen az \'f5 kez\'fck bilincsbe verve, \'e9s legyenek meg\'e1tkozva az\'e9rt, amit mondtak! Dehogy! Az \'d5 k\'e9t keze ki van t\'e1rva, \'e9s \'d5 \'fa
gy ad, ahogyan akar. Bizony az, ami lebocs\'e1ttatott neked az Uradt\'f3l, sokakat k\'f6z\'fcl\'fck gyarap\'edt t\'falkap\'e1sban \'e9s hitetlens\'e9gben. \'c9s ellens\'e9gesked\'e9st \'e9s gy\'fbl\'f6lk\'f6d\'e9st vetett\'fcnk k\'f6z\'e9j\'fck a Felt\'e1
mad\'e1s napj\'e1ig. Valah\'e1nyszor a h\'e1bor\'fa t\'fcz\'e9t sz\'edtj\'e1k, Allah eloltja azt, \'e9s azon igyekeznek a f\'f6ld\'f6n, hogy roml\'e1st okozzanak, \'e1m Allah nem szereti a roml\'e1st okoz\'f3kat!
\par }{\insrsid12147099 
\par }{\insrsid15821247 65. \'c9s ha az \'cdr\'e1s n\'e9pe hinne, \'e9s istenf\'e9l\'f5 lenne, akkor elengedn\'e9nk nekik a rossz tetteiket, \'e9s bebocs\'e1tan\'e1nk \'f5ket a gy\'f6ny\'f6r\'fbs\'e9g kertjeibe [a Paradicsomban].
\par 66. \'c9s ha \'f5k betartan\'e1k a T\'f3r\'e1t \'e9s az Evang\'e9liumot, \'e9s azt, ami az Urukt\'f3l lebocs\'e1ttatott hozz\'e1juk, akkor ehetn\'e9nek fel\'fclr\'f5l \'e9s a l\'e1buk al\'f3l is. Van k\'f6z\'f6tt\'fck egy m\'e9rt\'e9ktart\'f3 k\'f6z\'f6ss
\'e9g. \'c1m milyen sokan vannak k\'f6z\'fcl\'fck, akik rosszul cselekszenek.
\par }{\insrsid12147099 
\par }{\insrsid15821247 67. \'d3 te K\'fcld\'f6tt! Add \'e1t azt, ami lebocs\'e1ttatott neked az Uradt\'f3l! Ha ezt nem teszed meg, akkor nem adtad \'e1t az \'d5 \'fczenet\'e9t. Allah v\'e9delmezni fog t\'e9
ged az emberekkel szemben. Allah nem vezeti [az igaz] \'fatra a hitetlen n\'e9pet.
\par 68. Mondd [\'f3 Mohamed]: \'84\'d3 \'cdr\'e1s n\'e9pe! Addig nem rendelkeztek semmivel sem [a vall\'e1sb\'f3l], am\'edg nem tartj\'e1tok be a T\'f3r\'e1t \'e9s az Evang\'e9liumot, \'e9s azt, ami lebocs\'e1ttatott nektek az Uratokt\'f3l }{
\insrsid15821247\charrsid3812097 (a Kor\'e1nt)!\'94}{\insrsid15821247  Bizony az, ami lebocs\'e1ttatott neked az Uradt\'f3l, sokakat k\'f6z\'fcl\'fck gyarap\'edt t\'falkap\'e1sban \'e9s hitetlens\'e9gben. Ne szomorkodj h\'e1t a hitetlen n\'e9
p [meghazudtol\'e1sa] miatt!
\par 69. Bizony azok, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben] \'e9s azok, akik zsid\'f3k, \'e9s a sz\'e1beit\'e1k \'e9s a kereszt\'e9nyek, akik hisznek Allahban, \'e9s az Utols\'f3 Napban, \'e9s j
\'f3 tetteket cselekszenek, h\'e1t rajtuk nem lesz \'farr\'e1 a f\'e9lelem, \'e9s nem fognak szomorkodni.
\par }{\insrsid12147099 
\par }{\insrsid15821247 70. Bizony, sz\'f6vets\'e9get k\'f6t\'f6tt\'fcnk Izrael fiaival, \'e9s k\'fcld\'f6tteket k\'fcldt\'fcnk hozz\'e1juk. Ah\'e1nyszor elj\'f6tt hozz\'e1juk egy k\'fcld\'f6tt olyasvalamivel, amely nem a maguk kedv\'e9re v
olt, egy csoportot meghazudtoltak, \'e9s egy m\'e1sik csoportot meg\'f6ltek.
\par 71. \'c9s azt gondolt\'e1k, hogy nem lesz k\'eds\'e9rt\'e9s (ellenszeg\'fcl\'e9s\'fck miatti b\'fcntet\'e9s), \'e9s vakok \'e9s s\'fcketek lettek. Azut\'e1n Allah kiengesztel\'f5d\'f6tt ir\'e1ntuk, majd sokan k\'f6z\'fcl\'fck [\'fajra] vakok \'e9s s\'fc
ketek lettek. \'c9s Allah l\'e1tja mindazt, amit cselekszenek.
\par }{\insrsid12147099 
\par }{\insrsid15821247 72. Bizony, }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247  azok, akik azt mondj\'e1k: \'84Bizony, Allah a Messi\'e1s, M\'e1ria fia!\'94 Holott a Messi\'e1s azt mondta: \'84\'d3, Izrael fiai! Szolg\'e1lj\'e1
tok Allahot, az \'e9n Uramat \'e9s a ti Uratokat!\'94 Aki t\'e1rsistent \'e1ll\'edt Allah mell\'e9, bizony Allah tilalmass\'e1 tette sz\'e1m\'e1ra a Paradicsomot, \'e9s a [Pokol-]t\'fbz lesz a hajl\'e9ka. \'c9s az igazs\'e1gtalanoknak nem lesznek seg\'edt
\'f5ik.
\par 73. Bizony, }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247  azok, akik azt mondj\'e1k: \'84Bizony, Allah a harmadik a h\'e1rom k\'f6z\'fcl!\'94 Holott nincs [t\'f6bb] isten, csak egyetlen egy Isten! \'c9s ha nem \'e1llnak el att\'f3
l, amit mondanak, akkor azokat, akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247  k\'f6z\'fcl\'fck, f\'e1jdalmas gy\'f6trelem fogja \'e9rni.
\par }{\insrsid12147099 
\par }{\insrsid15821247 74. Vajon nem fordulnak Allahhoz b\'fbnb\'e1nattal, \'e9s k\'e9rnek T\'f5le megbocs\'e1t\'e1st? Allah Megbocs\'e1t\'f3, Irgalmas.
\par 75. A Messi\'e1s, M\'e1ria fia, nem m\'e1s, mint egy k\'fcld\'f6tt. M\'e1r el\'f5tte is elt\'e1voztak a k\'fcld\'f6ttek [az \'e9l\'f5k sor\'e1b\'f3l], \'e9s az \'e9desanyja igaz asszony. }{\insrsid15821247\charrsid2712278 \'d5k ketten \'e9
lelmet ettek [mint minden ember]}{\insrsid15821247\charrsid3292151 .}{\insrsid15821247  N\'e9zd meg, hogyan tessz\'fck vil\'e1goss\'e1 nekik a jeleket! Majd n\'e9zd meg, hogyan lehetnek elt\'e9r\'edtve [az igazs\'e1gt\'f3l]!
\par 76. Mondd [\'f3 Mohamed]: \'84Vajon Allah helyett olyat szolg\'e1ltok, amelynek nem \'e1ll m\'f3dj\'e1ban sz\'e1motokra hasznot [hozni], sem \'e1rtalmat [elt\'e1vol\'edtani]? \'c9s Allah a mindent Hall\'f3, a mindent L\'e1t\'f3.\'94
\par 77. Mondd [\'f3 Mohamed]: \'84\'d3 \'cdr\'e1s n\'e9pe! Ne essetek t\'falz\'e1sba a vall\'e1sotokban az igazs\'e1gon k\'edv\'fcl [m\'e1st k\'f6vetv\'e9n]! \'c9s ne k\'f6vess\'e9tek azon n\'e9p k\'e9nyeit, akik m\'e1r kor\'e1bban elt\'e9velyedtek, \'e9
s sokakat t\'e9velyg\'e9sbe vittek, \'e9s \'f5k maguk is elt\'e9velyedtek az egyenes \'fatt\'f3l!\'94
\par }{\insrsid12147099 
\par }{\insrsid15821247 78. \'c1tkozottak lettek azok, akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247  Izrael fiai k\'f6z\'fcl, D\'e1vid \'e9s J\'e9zus, M\'e1ria fia szava \'e1ltal. Ez az\'e9rt van, mert ellenszeg\'fcltek, \'e9s t\'fa
lkap\'e1sra vetemedtek.
\par 79. Nem tiltott\'e1k meg egym\'e1snak az elvetend\'f5t, amit elk\'f6vettek. Milyen nyomor\'fas\'e1gos az, amit tettek!
\par 80. L\'e1tod, hogy sokan k\'f6z\'fcl\'fck p\'e1rtfog\'f3nak fogadj\'e1k azokat, akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247 . Milyen nyomor\'fas\'e1gos az, amit \'f5k maguk k\'fcldtek el\'f5re [a t\'falvil\'e1gra a tetteikb\'f5l 
\'f6nmaguknak], ami\'e9rt Allah megharagudott r\'e1juk. \'c9s \'f5k a gy\'f6trelemben fognak maradni \'f6r\'f6kk\'e9.
\par 81. \'c9s ha hittek volna Allahban \'e9s a Pr\'f3f\'e9t\'e1ban, \'e9s abban, }{\insrsid15821247\charrsid3292151 ami }{\insrsid15821247\charrsid2712278 lebocs\'e1ttatott}{\insrsid15821247  neki, akkor nem tett\'e9k volna \'f5ket p\'e1rtfog\'f3ikk\'e1. \'c1
m sokan k\'f6z\'fcl\'fck engedetlenek.
\par }{\insrsid12147099 
\par }{\insrsid15821247 82. Bizony, a legellens\'e9gesebbnek az emberek k\'f6z\'fcl, azokkal szemben, akik hisznek, a zsid\'f3kat tal\'e1lod \'e9s azokat, akik t\'e1rsistent \'e1ll\'edtanak [Allah mell\'e9]. \'c9s bizony a szeretetben legk\'f6
zelebbinek azokhoz, akik hisznek, azokat tal\'e1lod, akik azt mondj\'e1k: \'84Mi kereszt\'e9nyek vagyunk.\'94 Ez az\'e9rt van \'edgy, mert k\'f6z\'f6tt\'fck papok \'e9s szerzetesek vannak, \'e9s \'f5k nem fennh\'e9j\'e1znak.
\par 83. \'c9s ha meghallj\'e1k azt, ami lebocs\'e1ttatott a K\'fcld\'f6ttnek, l\'e1tod, amint k\'f6nnybe l\'e1bad a szem\'fck amiatt, amit m\'e1r ismertek az igazs\'e1gb\'f3l. Azt mondj\'e1k: \'84Urunk! Hisz\'fcnk! \'cdrj h\'e1t minket azok k\'f6z\'e9
, akik tan\'fas\'edtj\'e1k [az igazs\'e1got]!
\par 84. \'c9s mi\'e9rt ne hinn\'e9nk Allahban, \'e9s abban, ami elj\'f6tt hozz\'e1nk az igazs\'e1gb\'f3l? \'c9s arra v\'e1gyunk, hogy Urunk bebocs\'e1sson minket [a Paradicsomba] }{\insrsid15821247\charrsid2712278 a j\'f3}{\insrsid15821247  n\'e9ppel egy\'fc
tt.\'94
\par 85. }{\insrsid15821247\charrsid2712278 Allah pedig az\'e9rt, amit mondtak, megjutalmazta}{\insrsid15821247\charrsid3292151  \'f5ket kertekkel [a Paradicsomban], amelyek alatt foly\'f3k folynak, \'f6r\'f6kk\'e9 abban fognak maradni. }{
\insrsid15821247\charrsid2712278 \'c9s ez a j\'f3tev\'f5k jutalma}{\insrsid15821247\charrsid3292151 .}{\insrsid15821247 
\par 86. \'c1m akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247  \'e9s meghazudtolj\'e1k a jeleinket, azok a Pokol lak\'f3i.
\par }{\insrsid12147099 
\par }{\insrsid15821247 87. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne tegy\'e9tek tilalmass\'e1 a j\'f3 dolgokat, amelyeket Allah megengedett nektek, \'e9s ne vetemedjetek t\'falkap\'e1
sra! Allah bizony nem szereti a t\'falkap\'e1sra vetemed\'f5ket.
\par 88. }{\insrsid15821247\charrsid2712278 \'c9s egyetek}{\insrsid15821247  abb\'f3l, amivel Allah ell\'e1tott titeket, megengedett \'e9s j\'f3 [t\'e1pl\'e1l\'e9k] gyan\'e1nt! \'c9s f\'e9lj\'e9tek Allahot, akiben hisztek!
\par }{\insrsid12147099 
\par }{\insrsid15821247 89. Allah nem k\'e9ri sz\'e1mon rajtatok a nem sz\'e1nd\'e9kos esk\'fciteket, azonban sz\'e1mon k\'e9ri rajtatok a [hazug] esk\'fct, amit sz\'e1nt sz\'e1nd\'e9kkal k\'f6t\'f6ttetek. Annak j\'f3v\'e1t\'e9tele t\'edz szeg\'e9ny t\'e1pl
\'e1l\'e1sa \'fagy, ahogyan \'e1ltal\'e1ban a csal\'e1dotokat t\'e1pl\'e1lj\'e1tok, vagy az \'f5 felruh\'e1z\'e1suk, vagy egy rabszolga felszabad\'edt\'e1sa. Aki nem tal\'e1l [erre m\'f3dot], annak h\'e1romnapi b\'f6jt\'f6l\'e9s [a feladata]. Ez a ti esk
\'fcitek j\'f3v\'e1t\'e9tele, ha esk\'fct tesztek. \'d5rizz\'e9tek esk\'fciteket [a megszeg\'e9st\'f5l]! \'cdgy teszi Allah vil\'e1goss\'e1 a jeleit. H\'e1tha h\'e1l\'e1sak lesztek.
\par }{\insrsid12147099 
\par }{\insrsid15821247 90. \'d3 ti, akik hisztek! Bizony a szeszes ital, a szerencsej\'e1t\'e9k, az \'e1ldozati [b\'e1lv\'e1ny] k\'f6vek, a j\'f3sl\'f3p\'e1lc\'e1k [mind] f\'f6rtelmess\'e9g, amely a s\'e1t\'e1n munk\'e1lkod\'e1s\'e1b\'f3l sz\'e1rmazik, ker
\'fclj\'e9tek h\'e1t el, h\'e1tha boldogultok!
\par 91. Bizony, a s\'e1t\'e1n az ellens\'e9gesked\'e9st \'e9s a gy\'fbl\'f6letet akarja k\'f6z\'e9tek vetni a szeszes ital \'e9s a szerencsej\'e1t\'e9k \'e1ltal, \'e9s akad\'e1lyozni akar titeket az Allahr\'f3l val\'f3 megeml\'e9kez\'e9sben, \'e9s az im\'e1
dkoz\'e1sban. Vajon abbahagyj\'e1tok?
\par 92. Engedelmeskedjetek Allahnak \'e9s engedelmeskedjetek a K\'fcld\'f6ttnek, \'e9s \'f3vakodjatok! Ha elfordultok, akkor tudnotok kell, hogy a K\'fcld\'f6ttre csup\'e1n a vil\'e1gos [\'fczenet-]\'e1tad\'e1s tartozik.
\par 93}{\insrsid15821247\charrsid4262360 . Nem terheli v\'e9ts\'e9g azokat, akik hisznek \'e9s j\'f3tetteket cselekszenek az\'e9rt, amit [a tilalom el\'f5tt] ettek, ha istenf\'e9lelmet tan\'fas\'edtanak, hisznek \'e9s j\'f3
tetteket cselekszenek, majd [nagyobb] istenf\'e9lelmet tan\'fas\'edtanak \'e9s hisznek, azut\'e1n [m\'e9g nagyobb] istenf\'e9lelmet tan\'fas\'edtanak \'e9s helyesen cselekszenek.}{\insrsid15821247  \'c9s Allah szereti a }{\insrsid15821247\charrsid3812097 
j\'f3tev\'f5ket}{\insrsid15821247\charrsid3292151 .}{\insrsid15821247 
\par }{\insrsid12147099 
\par }{\insrsid15821247 94. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Allah pr\'f3b\'e1ra tesz titeket [k\'fcl\'f6nb\'f6z\'f5 fajta] vaddal, amit kezetek \'e9s l\'e1ndzs\'e1
tok ejt el, hogy Allah nyilv\'e1nval\'f3v\'e1 tegye [az embereknek] azt, amit m\'e1r tudott arr\'f3l}{\insrsid15821247\charrsid3292151 , }{\insrsid15821247\charrsid3812097 aki f\'e9l T\'f5le an\'e9lk\'fcl, hogy l\'e1tn\'e1 \'d5t. A}{
\insrsid15821247\charrsid3292151 ki p}{\insrsid15821247 edig ezut\'e1n t\'falkap\'e1sra vetemedik, annak f\'e1jdalmas gy\'f6trelemben lesz r\'e9sze.
\par 95. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne \'f6ljetek vadat, amikor tilalmas \'e1llapotban vagytok! Ha k\'f6z\'fcletek valaki sz\'e1nd\'e9kosan \'f6li meg, akkor ellent\'e9telez
\'e9s [terheli \'f5t] a j\'f3sz\'e1gokb\'f3l, ami egyen\'e9rt\'e9k\'fb azzal, amit meg\'f6lt. Err\'f5l k\'e9t igazs\'e1gos ember d\'f6nt k\'f6z\'fcletek. }{\insrsid15821247\charrsid3812097 [A j\'f3sz\'e1g] \'e1ldozati \'e1llatk\'e9nt \'e9rjen a K\'e1b\'e1
hoz [a szeg\'e9nyek jav\'e1ra]!}{\insrsid15821247  Vagy pedig j\'f3v\'e1t\'e9telez\'e9s szeg\'e9nyek \'e9lelmez\'e9sek\'e9nt, vagy ezzel egyen\'e9rt\'e9k\'fb b\'f6jt\'f6l\'e9s, hogy meg\'edzlelhesse tette s\'falyos k\'f6vetkezm\'e9ny\'e9t. Allah eln\'e9z
\'f5 azzal szemben, ami kor\'e1bban t\'f6rt\'e9nt, aki pedig visszat\'e9r, azon Allah el\'e9gt\'e9telt vesz. \'c9s Allah M\'e9lt\'f3s\'e1gteljes, az el\'e9gt\'e9tel Birtokosa.
\par }{\insrsid12147099 
\par }{\insrsid15821247 96. Meg lett engedve nektek [a zar\'e1ndoklat idej\'e9n is] az, amit a tengerb\'f5l hal\'e1sztok \'e9s az \'e9lelem [amit partra vet a tenger], ell\'e1t\'e1sk\'e9nt sz\'e1motokra \'e9s az \'faton l\'e9v\'f5knek. \'c1m tilalmass\'e1 t
\'e9tetett nektek a sz\'e1razf\'f6ldi vad\'e1szat mindaddig, am\'edg tilalmas \'e1llapotban vagytok}{\insrsid15821247\charrsid3812097 . \'c9s}{\insrsid15821247\charrsid3292151  f\'e9lj\'e9tek}{\insrsid15821247  Allahot, akihez egybe lesztek gy\'fbjtve!

\par 97. Allah a K\'e1b\'e1t, a Tilalmas H\'e1zat, a tilalmas h\'f3napot, az \'e1ldoz\'e1sra felaj\'e1nlott \'e1llatot, \'e9s a nyak\'f6rvvel jel\'f6lteket fenntart\'e1s \'e9s biztons\'e1g forr\'e1s\'e1v\'e1 tette az embereknek. Ez az\'e9rt van, hogy tudhass
\'e1tok, Allah tudja mindazt, ami az egekben \'e9s mindazt ami a f\'f6ld\'f6n van, \'e9s azt, hogy Allah minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 98. Tudnotok kell, hogy Allah szigor\'fa a b\'fcntet\'e9sben, \'e9s hogy Allah Megbocs\'e1t\'f3, Irgalmas.
\par 99. Nem tartozik a K\'fcld\'f6ttre m\'e1s, mint az [\'fczenet-]\'e1tad\'e1s. \'c9s Allah tudja, amit felfedtek, \'e9s azt, amit elrejtetek.
\par 100. Mondd [\'f3 Mohamed]: \'84Nem egyenl\'f5 a hitv\'e1ny a j\'f3val, akkor sem, ha a hitv\'e1ny sokas\'e1ga tetszene neked [\'f3 ember].\'94 F\'e9lj\'e9tek h\'e1t Allahot, ti \'e9rtelemmel b\'edr\'f3k! H\'e1tha boldogultok.
\par }{\insrsid12147099 
\par }{\insrsid15821247 101. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne k\'e9rdez\'f5sk\'f6djetek olyan dolgok fel\'f5l, amelyek, ha nyilv\'e1nval\'f3v\'e1 v\'e1ln\'e1
nak nektek, akkor rosszul \'e9rinten\'e9nek titeket (neh\'e9zs\'e9ggel j\'e1rna)! \'c1m ha akkor k\'e9rdez\'f5sk\'f6dt\'f6k fel\'f5l\'fck, amikor lebocs\'e1ttatik a Kor\'e1n, \'fagy nyilv\'e1nval\'f3v\'e1 v\'e1lnak }{\insrsid15821247\charrsid3292151 
nektek}{\insrsid15821247\charrsid4262360 , pedig Allah eln\'e9zte ez}{\insrsid15821247 eke}{\insrsid15821247\charrsid4262360 t [nektek].}{\insrsid15821247  \'c9s Allah Megbocs\'e1t\'f3, B\'e9ket\'fbr\'f5.
\par 102. K\'e9rdezett m\'e1r [hasonl\'f3kat] egy el\'f5ttetek \'e9lt n\'e9p, majd [m\'e9gis] hitetlenn\'e9 v\'e1ltak azokkal [a v\'e1laszokkal szemben amiket kaptak].
\par }{\insrsid12147099 
\par }{\insrsid15821247 103. Allah nem rendelte el [hogy ne legyenek hasznos\'edtva] a bev\'e1gott f\'fcl\'fb t\'f6bbsz\'f6r ellett, sem a }{\insrsid15821247\charrsid15945362 [b\'e1lv\'e1nyoknak]}{\insrsid15821247  szabadon engedett, sem pedig a k\'e9
tszer egym\'e1s ut\'e1n n\'f5st\'e9ny tevecsik\'f3t ell\'f5 n\'f5st\'e9nytev\'e9k, sem a sok ut\'f3dot nemz\'f5 cs\'f5d\'f6rtev\'e9k. \'c1m azok, akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak,}{\insrsid15821247  hazugs\'e1got tal\'e1
lnak ki Allah ellen. \'c1m a legt\'f6bbj\'fck nem \'e9l az esz\'e9vel.
\par 104. Ha azt mondj\'e1k nekik: \'84Gyertek ahhoz, amit Allah lebocs\'e1tott \'e9s gyertek a K\'fcld\'f6tth\'f6z\'94, akkor \'f5k azt mondj\'e1k: \'84Elegend\'f5 nek\'fcnk az, amin aty}{\insrsid15821247\charrsid12258675 \'e1inkat}{\insrsid15821247  tal\'e1
ltuk.\'94 Vajon akkor is, ha aty\'e1ik nem tudnak semmit, \'e9s nem lelnek [az igaz] \'fatra?
\par 105. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! T\'f6r\'f5djetek magatok [javul\'e1s\'e1val]! Nem fog a k\'e1rotokra lenni az, aki elt\'e9velyedett, ha k\'f6zben ti r\'e1
leltek [az igaz] \'fatra. Allahhoz lesz mindny\'e1jatok visszat\'e9r\'e9se, \'e9s \'d5 tudatni fogja veletek, hogy ti mit tettetek.
\par }{\insrsid12147099 
\par }{\insrsid15821247 106. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha elj\'f6n valamelyik\'f5t\'f6k\'e9rt a hal\'e1l, a v\'e9grendelkez\'e9skor tan\'faskodjon k\'e9t igazs\'e1
gos [ember] k\'f6z\'fcletek, vagy m\'e1sik kett\'f5, nem k\'f6z\'fcletek val\'f3 (nem muszlimok), ha ti a f\'f6ldet j\'e1rj\'e1tok [utaz\'e1skor], \'e9s akkor s\'fajt le re\'e1tok a hal\'e1l csap\'e1sa! Tarts\'e1tok vissza kettej\'fcket a [d\'e9lut\'e1
ni] im\'e1dkoz\'e1s ut\'e1n, ha k\'e9ts\'e9getek t\'e1mad [szavahihet\'f5s\'e9g\'fcket }{\insrsid15821247\charrsid661878 illet\'f5en}{\insrsid15821247 ], hogy esk\'fcdjenek meg Allahra \endash  mondv\'e1n: \'84Nem k\'f3tyavety\'e9lj\'fck el [a tan\'fas
\'e1got] }{\insrsid15821247\charrsid13649126 semmilyen}{\insrsid15821247  \'e1ron, m\'e9g akkor sem, ha k\'f6zeli rokonr\'f3l van sz\'f3! Nem titkoljuk el az Allah el\'f5tt tett tan\'fas\'e1got, k\'fcl\'f6nben bizony a v\'e9tkesek k\'f6z\'e9 tartozn\'e1
nk!\'94
\par 107. \'c9s ha kider\'fcl, hogy \'f5k ketten b\'fbnnel fel\'e9r\'f5 [dolgot cselekedtek], akkor l\'e9pjenek ketten a hely\'fckbe azok k\'f6z\'fcl, akiket megillet az el\'f5jog [az \'f6r\'f6khagy\'f3 legk\'f6zelebbi rokonai]! \'d5k ketten esk\'fc
djenek meg Allahra: \'84A }{\insrsid15821247\charrsid3292151 mi }{\insrsid15821247\charrsid13649126 tan\'favallom\'e1sunk}{\insrsid15821247  igazabb, mint az \'f5 tan\'favallom\'e1suk! Mi nem vetemed\'fcnk t\'falkap\'e1sra, k\'fcl\'f6nben bizony az igazs
\'e1gtalanok k\'f6z\'e9 tartozn\'e1nk!\'94
\par 108. Ez [a rendelkez\'e9s] \'e1ll a legk\'f6zelebb ahhoz, hogy az igazs\'e1gnak megfelel\'f5en tegyenek tan\'fas\'e1got, vagy hogy att\'f3l tartsanak, visszautas\'edttatik [a hamis] esk\'fcj\'fck, miut\'e1n esk\'fct tettek. F\'e9lj\'e9tek h\'e1t Allahot 
\'e9s engedelmeskedjetek! Allah nem vezeti [az igaz \'fatra] az engedetlen n\'e9pet!
\par }{\insrsid12147099 
\par }{\insrsid15821247 109. [Az Utols\'f3 \'cdt\'e9let] napj\'e1n, amikor Allah \'f6sszegy\'fbjti a K\'fcld\'f6tteket, majd azt mondja [nekik]: \'84}{\insrsid15821247\charrsid11475737 Mit felelt nektek}{\insrsid15821247  [a n\'e9petek az egyistenhitre val\'f3
 h\'edv\'e1sotokra]?\'94 Azt mondj\'e1k: \'84Nincs nek\'fcnk tud\'e1sunk [arr\'f3l]! Bizony, Te vagy a rejtett dolgok Tud\'f3ja!\'94
\par }{\insrsid12147099 
\par }{\insrsid15821247 110. [Eml\'edtsd meg,] amikor Allah azt fogja mondani [az \'cdt\'e9let napj\'e1n]: \'84\'d3 J\'e9zus, M\'e1ria fia! Eml\'e9kezz a kegyeimre ir\'e1ntad \'e9s \'e9desany\'e1d ir\'e1nt, amikor meger\'f5s\'edtettelek a Szent L\'e9lekkel (G
\'e1briel angyallal), \'e9s amikor besz\'e9lt\'e9l }{\insrsid15821247\charrsid11475737 az emberekhez}{\insrsid15821247\charrsid3292151  a b\'f6lcs\'f5ben, \'e9s }{\insrsid15821247\charrsid11475737 meglett f\'e9rfik\'e9nt}{\insrsid15821247 ! \'c9s [eml\'e9
kezz arra] amikor megtan\'edtottam neked az \'edr\'e1st \'e9s a b\'f6lcsess\'e9get, a T\'f3r\'e1t \'e9s az Evang\'e9liumot, \'e9s amikor agyagb\'f3l az \'c9n engedelmemmel olyan form\'e1t teremtett\'e9l, mint a mad\'e1r, majd belef\'fajt\'e1l, \'e9s [\'e9
l\'f5] mad\'e1rr\'e1 lett az \'c9n engedelmemmel, \'e9s meggy\'f3gy\'edtottad a sz\'fclet\'e9s\'e9t\'f5l fogva vil\'e1gtalant \'e9s a lepr\'e1st az \'c9n engedelmemmel, \'e9s amikor felt\'e1masztottad a halottakat az \'c9n engedelmemmel! [Eml\'e9
kezz arra,] amikor t\'e1vol tartottam t\'f5led Izrael fiait, mikor vil\'e1gos bizony\'edt\'e9kokkal j\'f6tt\'e9l el hozz\'e1juk, \'e9s azt mondt\'e1k azok, akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247  k\'f6z\'fcl\'fck: \rquote 
Ez bizony nyilv\'e1nval\'f3 var\'e1zslat!\rquote \'94
\par 111. [Eml\'edtsd meg,] amikor azt sugalltam a kiv\'e1lasztott k\'f6vet\'f5knek (a tan\'edtv\'e1nyoknak), hogy higgyenek Bennem \'e9s a K\'fcld\'f6ttemben! Azt mondt\'e1k: \'84Hisz\'fcnk! Tan\'fas\'edtsd, hogy mi }{\insrsid15821247\charrsid11475737 
muszlimok vagyunk (al\'e1vetj\'fck magunkat Allahnak)!\'94}{\insrsid15821247 
\par }{\insrsid12147099 
\par }{\insrsid15821247 112. [Eml\'edtsd meg,] amikor a kiv\'e1lasztott k\'f6vet\'f5k (a tan\'edtv\'e1nyok) azt mondt\'e1k: \'84\'d3 J\'e9zus, M\'e1ria fia! Vajon le tud-e bocs\'e1tani az Urad nek\'fcnk [egy \'e9tellel] ter\'edtett asztalt az \'e9gb\'f5l?\'94
 Azt mondta: \'84F\'e9lj\'e9tek Allahot, ha val\'f3ban h\'edv\'f5k vagytok!\'94
\par 113. Azt mondt\'e1k: \'84Az\'e9rt szeretn\'e9nk, hogy egy\'fcnk r\'f3la, \'e9s hogy megnyugodjon a sz\'edv\'fcnk, \'e9s hogy megtudjuk, hogy te az igazat mondtad nek\'fcnk, \'e9s hogy azok k\'f6z\'e9 tartozzunk, akik tan\'fak r\'e1.\'94
\par 114. J\'e9zus, M\'e1ria fia, azt mondta: \'84\'d3 Allah! Urunk! Bocs\'e1ss le nek\'fcnk [egy \'e9tellel] ter\'edtett asztalt az \'e9gb\'f5l, hogy [az a nap] \'fcnnep legyen sz\'e1munkra, az els\'f5nek (a jelenl\'e9v\'f5knek) \'e9s az utols\'f3nak (a k\'e9
s\'f5bbi nemzed\'e9knek) k\'f6z\'fcl\'fcnk, \'e9s hogy T\'f5led val\'f3 jel legyen! L\'e1ss el minket, hiszen Te vagy a legjobb [Ell\'e1t\'f3] az ell\'e1t\'f3k k\'f6z\'f6tt!\'94
\par 115. Allah azt mondta: \'84Bizony, \'e9n le fogom bocs\'e1tani nektek [amit k\'e9rtetek]. Aki pedig ezut\'e1n hitetlenn\'e9 v\'e1lik k\'f6z\'fcletek, azt bizony olyan gy\'f6trelemmel fogom s\'fajtani, amilyen gy\'f6trelemmel m\'e9g senkit sem s\'fa
jtottam a teremtm\'e9nyek k\'f6z\'fcl!\'94
\par }{\insrsid12147099 
\par }{\insrsid15821247 116. [Eml\'edtsd meg,] amikor Allah azt fogja mondani [az \'cdt\'e9let napj\'e1n]: \'84\'d3 J\'e9zus, M\'e1ria fia! Vajon te mondtad az embereknek: \rquote Tegyetek engem \'e9s any\'e1mat istens\'e9geitekk\'e9, Allah helyett?\rquote 
\'94 Azt mondta: }{\insrsid15821247\charrsid4263386 \'84}{\insrsid15821247 Magasztaltass\'e1l! Hogyan mondhatn\'e9k \'e9n olyat, amihez nincs jogom? Ha \'e9n mondtam volna, bizonyosan tudn\'e1l arr\'f3l. Tudod mindazt, amit magamban rejtek, \'e1m \'e9
n nem tudom azt, }{\insrsid15821247\charrsid3292151 amit }{\insrsid15821247\charrsid4263386 Te }{\insrsid15821247\charrsid3292151 rejtesz}{\insrsid15821247\charrsid4263386  Magadban}{\insrsid15821247 . Bizony, Te vagy a rejtett dolgok Tud\'f3ja!
\par 117. Csak azt mondtam nekik, amit Te parancsolt\'e1l meg nekem, [azt,] hogy Allahot szolg\'e1lj\'e1tok, az \'e9n Uramat \'e9s a ti Uratokat! Tan\'fa voltam cselekedeteikre, am\'edg k\'f6z\'f6tt\'fck voltam, \'e1m miut\'e1n elsz\'f3l\'edtott\'e1l (felemelt
\'e9l Magadhoz), [}{\insrsid15821247\charrsid3292151 egyed\'fcl] }{\insrsid15821247\charrsid4263386 Te volt\'e1l az, Aki figyelte}{\insrsid15821247\charrsid3292151  \'f5ke}{\insrsid15821247\charrsid12998138 t. Te minden dologra tan\'fa vagy!}{
\insrsid15821247 
\par 118. Ha gy\'f6trelemmel s\'fajtod \'f5ket, h\'e1t \'f5k a szolg\'e1id, \'e1m ha megbocs\'e1tasz nekik, nos Te vagy a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs!}{\insrsid15821247\charrsid10163920 \'94}{\insrsid15821247 
\par 119. Allah azt mondta: \'84Ez az a nap, amelyen}{\insrsid15821247\charrsid10966338  }{\insrsid15821247\charrsid11475737 az igaz}{\insrsid15821247 mond\'f3k}{\insrsid15821247\charrsid11475737  haszn\'e1ra lesz az igazmond\'e1suk.}{\insrsid15821247 \'94
 Nekik olyan kertjeik lesznek [a Paradicsomban], amelyek alatt foly\'f3k folynak, \'f6r\'f6kk\'f6n \'f6r\'f6kk\'e9 abban fognak maradni. }{\insrsid15821247\charrsid15945362 Allah el\'e9gedett [lesz] vel\'fck, \'e9s \'f5k is el\'e9
gedettek [lesznek] Vele (a T\'f5le kapott jutalommal).}{\insrsid15821247  Ez a hatalmas diadal.
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 120. Allah\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett, \'e9s [afelett] ami e kett\'f5 k\'f6z\'f6
tt van, \'e9s \'d5 minden dologra kiterjed\'f5 hatalm\'fa.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 
\par }{\fs28\insrsid15821247 
\par 
\par }\pard\plain \s1\qj \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid15821247 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\f0\fs24\insrsid12147099 \page }{
\f0\fs24\insrsid15821247\charrsid15821247 6. A j\'f3sz\'e1gok (Al-An\rquote \'e1m) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid15821247 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. A h\'e1latelt dics\'e9ret Allahot illeti, aki megteremtette az egeket \'e9s a f\'f6ldet, \'e9s megalkotta a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9geket \'e9s a vil\'e1goss\'e1got. Ezek ut\'e1n, akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{
\insrsid15821247 , Urukkal egyenl\'f5nek tartanak [m\'e1sokat].
\par 2. \'d5 az, aki megteremtett titeket agyagb\'f3l, azut\'e1n hat\'e1rid\'f5t rendelt el [az \'e9leteteknek], \'e9s N\'e1la megszabott hat\'e1rideje van [az evil\'e1gnak]. \'c1m ezut\'e1n ti k\'e9telkedtek [a felt\'e1mad\'e1sban].
\par 3. \'c9s \'d5 Allah [aki meg\'e9rdemli az im\'e1datot] az egekben \'e9s a f\'f6ld\'f6n. Tudja a titkotokat \'e9s a nyilv\'e1nos dolgaitokat, \'e9s tudja azt, amit szereztetek.
\par }{\insrsid6625152 
\par }{\insrsid15821247 4. \'c9s nem j\'f6n hozz\'e1juk egyetlen jel sem az Uruk jelei k\'f6z\'fcl csak \'fagy, hogy \'fcgyet sem vetnek r\'e1.
\par 5. \'c9s bizony, meghazudtolt\'e1k az igazs\'e1got (a Kor\'e1nt), amikor elj\'f6tt hozz\'e1juk. \'c1m elj\'f6nnek majd hozz\'e1juk a h\'edrek arr\'f3l, amin g\'fanyol\'f3dtak.
\par 6. Vajon nem gondolkodtak-e el azon, h\'e1ny el\'f5tt\'fck \'e9lt nemzed\'e9ket puszt\'edtottunk el, akiknek nagyobb hatalmat adtunk a f\'f6ld\'f6n, mint amilyen hatalmat adtunk nektek, \'e9s b\'f5s\'e9ges es\'f5t k\'fcldt\'fcnk le az \'e9gb\'f5l, \'e9
s azt rendelt\'fck el, hogy a foly\'f3k folyjanak alattuk, azut\'e1n elpuszt\'edtottuk \'f5ket a b\'fbneik miatt, \'e9s m\'e1s nemzed\'e9keket hoztunk l\'e9tre ut\'e1nuk?}{\insrsid6625152 
\par }{\insrsid15821247 7. \'c9s ha lebocs\'e1tan\'e1nk neked [\'f3 Mohamed] egy \'cdr\'e1st papiruszon, s meg\'e9rinten\'e9k azt a kez\'fckkel, akkor azt mondan\'e1k azok, akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247 : \'84Ez csup\'e1
n nyilv\'e1nval\'f3 var\'e1zslat!\'94
\par }{\insrsid6625152 
\par }{\insrsid15821247 8}{\insrsid15821247\charrsid3292151 . }{\insrsid15821247\charrsid4390918 \'c9s azt mondt\'e1k: \'84Mi\'e9rt nem bocs\'e1ttatott le hozz\'e1 egy angyal [igazolva \'f5t]?\'94 Ha angyalt bocs\'e1tottunk volna le, akkor az \'fcgy (a b\'fc
ntet\'e9s) m\'e1r eld\'f6ntetett volna, azut\'e1n nem kaptak volna halad\'e9kot.}{\insrsid15821247 
\par 9. \'c9s ha \'f5t (a k\'fcld\'f6ttet) angyalnak tett\'fck volna meg, akkor f\'e9rfinak tett\'fck volna meg, \'e9s bizony\'e1ra zavaross\'e1 tett\'fck volna nekik azt [a helyzetet], amivel kapcsolatban [eleve] \'f6ssze vannak zavarodva.
\par 10. \'c9s bizony g\'fany \'fbztek m\'e1r k\'fcld\'f6ttekkel teel\'f5tted is}{\insrsid15821247\charrsid3292151 , }{\insrsid15821247\charrsid4390918 \'e1m k\'f6rbeker\'edtette azokat, akik g\'fanyol\'f3dtak, az [a b\'fcntet\'e9s], amib\'f5l g\'fanyt \'fb
ztek.}{\insrsid15821247  
\par 11. Mondd: \'84J\'e1rj\'e1tok be a f\'f6ldet, majd n\'e9zz\'e9tek meg, milyen }{\insrsid15821247\charrsid4390918 v\'e9gre jutottak}{\insrsid15821247  azok, akik meghazudtolt\'e1k [a k\'fcld\'f6tteket]!\'94
\par }{\insrsid6625152 
\par }{\insrsid15821247 12. Mondd: \'84Ki\'e9 mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van?\'94 Mondd: \'84Allah\'e9!\'94. El\'f5\'edrta maga sz\'e1m\'e1ra a k\'f6ny\'f6r\'fcletet. Bizony \'f6ssze fog gy\'fbjteni titeket a Felt\'e1mad\'e1s napj\'e1ra, mely
hez nem f\'e9r k\'e9ts\'e9g! Akik elvesz\'edtik (k\'e1rhozatba tasz\'edtj\'e1k) magukat, azok nem hisznek.
\par 13. \'c9s \'d6v\'e9 mindaz, ami nyugszik [\'e9s mozog] az \'e9jszaka alatt \'e9s nappal. \'d5 a Mindent Hall\'f3, a Mindentud\'f3.
\par 14. Mondd: \'84Vajon m\'e1st tegyek p\'e1rtfog\'f3mm\'e1, Allah, az egek \'e9s a f\'f6ld l\'e9trehoz\'f3ja helyett, holott \'f5 \'e9lelmez [mindent], \'e9s \'f5t nem \'e9lelmezi [senki]?\'94 Mondd: \'84Bizony arra lettem felsz\'f3l\'edtva, hogy \'e9
n legyek az els\'f5, aki al\'e1veti mag\'e1t [Allahnak], \'e9s [arra, hogy] ne tartozz azok k\'f6z\'e9, akik t\'e1rsistent \'e1ll\'edtanak [Allah mell\'e9]!\'94
\par 15. Mondd: \'84Bizony, \'e9n f\'e9lek \endash  ha ellenszeg\'fcl\'f6k Uramnak \endash  egy hatalmas nap gy\'f6trelm\'e9t\'f5l!\'94
\par 16. Akit\'f5l azon a napon [a b\'fcntet\'e9s] elford\'edttatik, azon bizony megk\'f6ny\'f6r\'fclt [Allah], \'e9s az lesz a nyilv\'e1nval\'f3 diadal.
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 17. \'c9s ha Allah valami \'e1rtalommal illet t\'e9ged, azt senki el nem h\'e1r\'edthatja, csak \'d5! \'c9
s ha pedig valami j\'f3 \'e9r t\'e9ged, h\'e1t \'d5 minden dologra kiterjed\'f5 hatalm\'fa.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 18. \'c9s \'d5 az, Aki legy\'f5zhetetlen [hatalommal b\'edr] szolg\'e1i felett, \'e9s \'f5 a B\'f6lcs, a [mindent] j\'f3l Ismer
\'f5.
\par }{\insrsid6625152 
\par }{\insrsid15821247 19. Mondd: \'84Melyik dolog b\'edr a legnagyobb tan\'faskod\'e1ssal?\'94 Mondd: \'84Allah tan\'fa k\'f6ztem \'e9s k\'f6ztetek, \'e9s [kinyilatkoztat\'e1sk\'e9nt] sugalltatott nekem ez a Kor\'e1n, hogy figyelmeztesselek titeket \'e1
ltala, \'e9s azt, akihez eljut. Vajon, val\'f3ban azt tan\'fas\'edtj\'e1tok, hogy Allah mellett m\'e1s istens\'e9gek is vannak?\'94 Mondd: \'84\'c9n nem tan\'fas\'edtom!\'94 Mondd: \'84Bizony, \'d5 csup\'e1n egyetlen egy Isten! \'c9s \'e9n elhat\'e1rol
\'f3dok att\'f3l, amit t\'e1rsistenk\'e9nt \'e1ll\'edtotok [Allah mell\'e9]!\'94
\par 20. Akiknek az \'cdr\'e1st (a T\'f3r\'e1t \'e9s az Evang\'e9liumot) adtuk, \'fagy ismerik \'f5t (Mohamedet), ahogyan saj\'e1t fiaikat. Akik elvesz\'edtik (k\'e1rhozatba tasz\'edtj\'e1k) magukat, azok nem hisznek.
\par 21. Ki lehet igazs\'e1gtalanabb ann\'e1l, mint aki hazugs\'e1got tal\'e1l ki Allah ellen, vagy meghazudtolja az \'f5 jeleit? Az igazs\'e1gtalanok bizony nem boldogulnak.
\par }{\insrsid6625152 
\par }{\insrsid15821247 22. Azon a napon, amikor egybegy\'fbjtj\'fck \'f5ket, mindannyiukat, majd azt mondjuk azoknak, akik t\'e1rsistent \'e1ll\'edtottak [Allah mell\'e9]: \'84Hol vannak azok, akiket t\'e1rsistenn\'e9 nyilv\'e1n\'edtottatok, akikr\'f5l azt 
\'e1ll\'edtott\'e1tok [hogy Allah vet\'e9lyt\'e1rsai lenn\'e9nek]?\'94
\par 23. Ezut\'e1n nem lesz m\'e1s [v\'e1laszuk] k\'eds\'e9rt\'e9s\'fckkor (kik\'e9rdez\'e9s\'fckkor), mint hogy azt mondj\'e1k: \'84Allahra, Urunkra esk\'fcsz\'fcnk, hogy nem voltunk azok, akik t\'e1rsistent \'e1ll\'edtottak [Allah mell\'e9]!\'94
\par 24. N\'e9zd meg, hogyan hazudnak maguk ellen, \'e9s mik\'e9nt t\'fbnt el mell\'f5l\'fck az, amit kital\'e1ltak!
\par 25. \'c9s van k\'f6z\'f6tt\'fck olyan, aki hallgat t\'e9ged [amikor a Kor\'e1nt recit\'e1lod], \'e1m a sz\'edv\'fckre leplet tesz\'fcnk, hogy ne \'e9rthess\'e9k meg azt, a f\'fcl\'fckbe pedig s\'fckets\'e9get. Ha az \'f6sszes jelet l\'e1tn\'e1k, nem hinn
\'e9nek azokban. Amikor elj\'f6nnek hozz\'e1d azok, akik }{\cf1\insrsid15821247 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247 , vit\'e1ba sz\'e1llnak veled mondv\'e1n: \'84Ezek csup\'e1n a hajdanvoltak legend\'e1i!\'94
\par 26. \'c9s \'f5k eltiltanak [m\'e1sokat] att\'f3l, \'e9s \'f5k maguk is t\'e1vol maradnak t\'f5le, \'e9s csup\'e1n magukat puszt\'edtj\'e1k el, \'e9s \'e9szre sem veszik.
\par }{\insrsid6625152 
\par }{\insrsid15821247 27. \'c9s ha l\'e1tn\'e1d, amikor a [Pokol-]t\'fbz el\'e9 \'e1ll\'edttatnak, \'e9s azt mondj\'e1k: \'84\'d3 b\'e1rcsak visszavitetn\'e9nk [az evil\'e1gba], nem hazudtoln\'e1nk meg Urunk jeleit, \'e9s a h\'edv\'f5k k\'f6z\'e9 tartozn\'e1
nk!\'94
\par 28. Dehogy! Megnyilv\'e1nult sz\'e1mukra az, amit kor\'e1bban elrejtettek. Ha visszavitetn\'e9nek, \'fajra visszat\'e9rn\'e9nek ahhoz, amit\'f5l eltiltattak}{\insrsid15821247\charrsid3292151 . }{\insrsid15821247\charrsid3421819 \'c9s bizony hazugok \'f5k!
}{\insrsid15821247 
\par 29. \'c9s azt mondj\'e1k: \'84Nincs m\'e1s, csak az evil\'e1gi \'e9let\'fcnk, \'e9s nem lesz\'fcnk felt\'e1masztva!\'94
\par 30. \'c9s ha l\'e1tn\'e1d, amikor az Uruk el\'e9 lesznek \'e1ll\'edtva! \'d5 azt mondja: \'84Vajon ez nem az igazs\'e1g?\'94 Azt mondj\'e1k: \'84}{\insrsid15821247\charrsid3421819 De igen}{\insrsid15821247 ! [Megesk\'fcsz\'fcnk] az Urunkra!\'94
 Azt mondja: }{\insrsid15821247\charrsid3292151 \'84}{\insrsid15821247\charrsid9383152 K\'f3stolj\'e1tok h\'e1t meg a gy\'f6trelmet amiatt, hogy }{\cf1\insrsid15821247\charrsid9383152 hitetlenn\'e9 v\'e1ltatok}{\insrsid15821247\charrsid9383152 !}{
\insrsid15821247\charrsid3292151 \'94}{\insrsid15821247 
\par 31. Bizony, vesztesek azok, akik meghazudtolt\'e1k az Allahhal val\'f3 tal\'e1lkoz\'e1st. Amikor pedig v\'e1ratlanul j\'f6n el hozz\'e1juk az \'d3ra (a Felt\'e1mad\'e1s}{\insrsid15821247\charrsid3292151 ), azt mondj\'e1k: \'84Mily nagy a b\'e1
natunk amiatt }{\insrsid15821247\charrsid9383152 a hanyags\'e1g miatt [amit elk\'f6vett\'fcnk] benne (az evil\'e1gon)!\'94}{\insrsid15821247\charrsid3292151  \'d5k hordozni fogj\'e1k ter}{\insrsid15821247 heiket (b\'fbneiket) a h\'e1tukon. }{
\cf1\insrsid15821247 L\'e1m, mily rossz az, amit teherk\'e9nt hordoznak!}{\insrsid15821247 
\par 32. Az evil\'e1gi \'e9let csup\'e1n j\'e1tszadoz\'e1s \'e9s sz\'f3rakoz\'e1s, \'e1m a t\'falvil\'e1gi lakhely jobb azoknak, akik istenf\'e9l\'f5k. Vajon nem \'e9ltek az eszetekkel?
\par }{\insrsid6625152 
\par }{\insrsid15821247 33. Bizony, mi tudjuk, hogy elszomor\'edt t\'e9ged az, amit mondanak [a hitetlenek]. \'c1m \'f5k nem t\'e9ged hazudtolnak meg, hanem Allah jeleit tagadj\'e1k az igazs\'e1gtalanok!
\par 34. \'c9s bizony meg lettek hazudtolva k\'fcld\'f6ttek teel\'f5tted, \'e1m \'f5k t\'fcrelemmel viselt\'e9k azt, hogy meghazudtolt\'e1k \'e9s b\'e1ntalmazt\'e1k \'f5ket, am\'edg el nem j\'f6tt hozz\'e1juk a mi seg\'edts\'e9g\'fcnk. \'c9s nincs, aki megv
\'e1ltoztathatn\'e1 Allah szavait (\'edg\'e9ret\'e9t}{\insrsid15821247\charrsid3292151 ). }{\insrsid15821247\charrsid13398771 \'c9s bizony, m\'e1r elj\'f6tt hozz\'e1d [n\'e9h\'e1ny] a [kor\'e1bbi] k\'fcld\'f6ttek h\'edreib\'f5l.}{\insrsid15821247 
\par 35. \'c9s ha nehezen viseln\'e9d az elfordul\'e1sukat, \'e9s k\'e9pes lenn\'e9l alag\'fatra lelni a f\'f6ldben, vagy }{\insrsid15821247\charrsid12008781 l\'e9tr\'e1ra}{\insrsid15821247  lelni az \'e9
gben, hogy egy jelet hozz nekik [akkor tedd meg!] Ha Allah \'fagy akarta volna, akkor mindny\'e1jukat az Igaz \'fatra terelte volna! Ne tartozz h\'e1t a tudatlanok k\'f6z\'e9!
\par }{\insrsid6625152 
\par }{\insrsid15821247 36. Csup\'e1n azok hallgatnak [a Pr\'f3f\'e9ta h\'edv\'f3 szav\'e1ra], akik hallanak. A halottakat pedig Allah t\'e1masztja fel}{\insrsid15821247\charrsid3292151 , }{\insrsid15821247\charrsid9383152 majd}{\insrsid15821247  Hozz\'e1
 lesznek visszavitetve.
\par 37. \'c9s azt mondt\'e1k: \'84H\'e1t mi\'e9rt nem bocs\'e1ttatott le hozz\'e1 [k\'fcldet\'e9se bizony\'edt\'e9kak\'e9nt] egy jel az Ur\'e1t\'f3l?\'94 Mondd: \'84Allah bizony k\'e9pes arra, hogy jelet bocs\'e1sson le, \'e1m a legt\'f6bbj\'fc
k nem rendelkezik tud\'e1ssal.\'94
\par 38. \'c9s nincs egyetlen mozg\'f3 [\'e9l\'f5l\'e9ny] a f\'f6ld\'f6n, sem pedig mad\'e1r, amely a k\'e9t sz\'e1rny\'e1val rep\'fcl, amelyek ne lenn\'e9nek k\'f6z\'f6ss\'e9gek hozz\'e1tok hasonl\'f3an. Semmit sem hanyagoltunk el az \'cdr\'e1sban (az \'d5rz
\'f6tt T\'e1bl\'e1n). Majd az Uruk el\'e9 lesznek egybegy\'fbjtve.
\par 39. \'c9s azok, akik meghazudtolt\'e1k jeleinket, \'f5k s\'fcketek, n\'e9m\'e1k a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gekben. Akit Allah akar, t\'e9velyg\'e9sbe visz, \'e9s akit akar, az Egyenes \'fatra helyez.
\par 40. Mondd: \'84Vajon mit gondoltok, ha elj\'f6n az Allah [\'e1ltal les\'fajt\'f3] gy\'f6trelem, vagy el\'e9r hozz\'e1tok az \'d3ra (a Felt\'e1mad\'e1s napja), vajon Allahon k\'edv\'fcl m\'e1st h\'edvtok-e [seg\'edts\'e9g\'fcl] majd, }{
\insrsid15821247\charrsid3292151 ha }{\insrsid15821247\charrsid7895598 val\'f3ban}{\insrsid15821247  igazmond\'f3k vagytok?\'94
\par 41. Dehogy! Egyed\'fcl \'d5t fogj\'e1tok h\'edvni \'e9s \'d5 elh\'e1r\'edtja azt, ami miatt \'d5t h\'edvj\'e1tok [seg\'edts\'e9g\'fcl], ha \'fagy akarja, \'e9s el fogj\'e1tok felejteni azt, amit t\'e1rsistenk\'e9nt \'e1ll\'edtottatok [Allah mell\'e9].

\par }{\insrsid6625152 
\par }{\insrsid15821247 42. \'c9s bizony, m\'e1r az el\'f5tted \'e9lt k\'f6z\'f6ss\'e9gekhez is k\'fcldt\'fcnk [k\'fcld\'f6tteket], [\'e1m meghazudtolt\'e1k \'f5ket,] ez\'e9rt megragadtuk \'f5ket nyomor\'fas\'e1ggal \'e9s bajjal, h\'e1tha al\'e1zatosan foh\'e1
szkodnak.
\par 43. H\'e1t mi\'e9rt nem foh\'e1szkodtak al\'e1zatosan akkor, amikor elj\'f6tt hozz\'e1juk a csap\'e1sunk? \'c1m a sz\'edv\'fck megkem\'e9nyedett, \'e9s a s\'e1t\'e1n d\'edszess\'e9 tette nekik azt, amit cselekedtek.
\par 44. Amikor pedig elfeledt\'e9k azt, amire eml\'e9keztetve lettek, kinyitottuk nekik minden dolog kapuit, mikor azt\'e1n \'f6rvendeztek annak, amit kaptak, akkor v\'e1ratlanul megragadtuk \'f5ket, \'e9s l\'e1m, \'f5k k\'e9ts\'e9gbe estek.
\par 45. }{\insrsid15821247\charrsid7895598 Kiirtatott az utols\'f3 marad\'e9ka annak a n\'e9pnek}{\insrsid15821247\charrsid3292151 , akik igazs\'e1gtalans\'e1got k\'f6vettek el. A h\'e1latelt dics\'e9ret }{\insrsid15821247\charrsid7895598 pedig}{
\insrsid15821247\charrsid3292151  Allahot illeti, a teremtm\'e9nyek}{\insrsid15821247  Ur\'e1t!
\par }{\insrsid6625152 
\par }{\insrsid15821247 46. Mondd: \'84Vajon mit gondoltok, ha Allah elveszi a hall\'e1sotokat \'e9s a l\'e1t\'e1sotokat, \'e9s lepecs\'e9teli a sz\'edveteket, van-e Allahon k\'edv\'fcl m\'e1s isten, aki visszaadhatn\'e1 azt nektek? N\'e9
zd, hogyan sorakoztatunk fel k\'fcl\'f6nb\'f6z\'f5 jeleket (bizony\'edt\'e9kokat), \'f5k m\'e9gis elfordulnak!\'94
\par 47. Mondd: \'84Vajon mit gondoltok, ha v\'e1ratlanul vagy szemmel l\'e1that\'f3 m\'f3don \'e9r el titeket az Allaht\'f3l sz\'e1rmaz\'f3 gy\'f6trelem, elpusztul-e m\'e1s, mint az igazs\'e1gtalan n\'e9p?
\par 48. Nem k\'fcldj\'fck el a k\'fcld\'f6tteket, csak \'f6r\'f6mh\'edrhoz\'f3kk\'e9nt \'e9s figyelmeztet\'f5kk\'e9nt. Akik hisznek \'e9s megjavulnak, azokon nem lesz \'farr\'e1 a f\'e9lelem, \'e9s nem fognak szomorkodni.
\par 49. }{\insrsid15821247\charrsid11028060 Akik pedig meghazudtolt\'e1k a jeleinket, azokat gy\'f6trelem \'e9ri amiatt, hogy engedetlenek voltak.}{\insrsid15821247 
\par 50. Mondd: \'84\'c9n nem mondom nektek, hogy n\'e1lam vannak Allah t\'e1rh\'e1zai, \'e9s azt sem, hogy ismerem a rejtett dolgokat, \'e9s azt sem mondom nektek, hogy \'e9n angyal vagyok. \'c9n csup\'e1n azt k\'f6vetem, ami sugalltatott nekem.\'94 Mondd: 
\'84Vajon egyenl\'f5-e a vak \'e9s a l\'e1t\'f3? Vajon nem gondolkodtok el?\'94
\par }{\insrsid6625152 
\par }{\insrsid15821247 51. \'c9s figyelmeztesd vele (a Kor\'e1nnal) azokat, akik f\'e9lnek att\'f3l, hogy az Urukhoz lesznek egybegy\'fbjtve, nem lesz nekik rajta k\'edv\'fcl p\'e1rtfog\'f3juk, se k\'f6zbenj\'e1r\'f3juk [az \'d5 enged\'e9lye n\'e9lk\'fcl], h
\'e1tha istenf\'e9l\'f5k lesznek!
\par 52. \'c9s ne tasz\'edtsd ki azokat, akik Urukhoz foh\'e1szkodnak a napkelte el\'f5tt \'e9s a naplemente el\'f5tt, az \'d5 arc\'e1t \'e1h\'edtozva! Nem r\'e1d tartozik az \'f5 elsz\'e1moltat\'e1suk b\'e1rmit illet\'f5en [hanem Allahra], \'e9s r\'e1
juk sem tartozik a te elsz\'e1moltat\'e1sod b\'e1rmit illet\'f5en, \'e9s ha kitasz\'edtan\'e1d \'f5ket, akkor az igazs\'e1gtalanok k\'f6z\'e9 tartozn\'e1l.
\par }{\insrsid6625152 
\par }{\insrsid15821247 53. \'c9s ekk\'e9ppen tett\'fcnk pr\'f3b\'e1ra egyeseket k\'f6z\'fcl\'fck m\'e1sok \'e1ltal, az\'e9rt, hogy azt mondj\'e1k [g\'fanyol\'f3dva]: \'84Vajon ezek azok, akiket Allah kegy\'e9ben r\'e9szes\'edtett k\'f6z\'fcl\'fcnk?\'94
 Vajon nem Allah az, aki jobban tudja, hogy kik a h\'e1l\'e1sak?
\par 54. \'c9s ha elj\'f6nnek hozz\'e1d azok, akik hisznek a mi jeleinkben (a Kor\'e1nban), mondd nekik: \'84B\'e9kess\'e9g re\'e1tok!\'94 A ti Uratok el\'f5\'edrta mag\'e1nak a k\'f6ny\'f6r\'fcletess\'e9get, ha valaki k\'f6z\'fcletek b\'fbnt k\'f6
vet el tudatlans\'e1gb\'f3l, majd azt k\'f6vet\'f5en b\'fbnb\'e1natot tan\'fas\'edt, \'e9s megjavul}{\insrsid15821247\charrsid11028060 , h\'e1t \'d5 bizony Megbocs\'e1t\'f3, Irgalmas.}{\insrsid15821247 
\par 55. \'c9s ekk\'e9ppen fejtj\'fck ki r\'e9szletesen a jeleket (bizony\'edt\'e9kokat), az\'e9rt is, hogy nyilv\'e1nval\'f3v\'e1 v\'e1ljon a gonosztev\'f5k \'fatja.
\par 56. Mondd: \'84Bizony, \'e9n eltiltattam att\'f3l, hogy azokat szolg\'e1ljam, akikhez ti Allah helyett foh\'e1szkodtok.\'94 Mondd: \'84Nem k\'f6vetem a k\'e9nyeteket, mert [ha k\'f6vetn\'e9m], akkor bizony elt\'e9velyedn\'e9k, \'e9s nem tartozn\'e9
k azok k\'f6z\'e9, akik az [igaz] \'fatra leltek.\'94
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14695147 {\insrsid15821247 57. Mondd: \'84Bizony, vil\'e1gos }{\insrsid15821247\charrsid14695147 bizony\'edt\'e9kom van Uramt\'f3l, \'e1m ti meghazudtolt\'e1
tok azt. Nem rendelkezem azzal [a b\'fcntet\'e9ssel]. Az \'edt\'e9lkez\'e9s csup\'e1n Allahot illeti! \'d5 az igazat besz\'e9li el, \'e9s \'d5 a legjobb }{\insrsid14695147\charrsid14695147 [az igazat a hamist\'f3l]}{\insrsid14695147  }{
\insrsid15821247\charrsid14695147 sz\'e9tv\'e1laszt}{\insrsid14695147\charrsid14695147 \'f3}{\insrsid15821247\charrsid14695147 k}{\insrsid14695147\charrsid14695147  k\'f6z\'f6tt}{\insrsid15821247\charrsid14695147 .\'94}{\insrsid15821247 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 58. Mondd: }{\insrsid15821247\charrsid13064541 \'84}{\insrsid15821247\charrsid16609500 Ha rendelkezn\'e9k azzal}{\insrsid15821247 
 [a b\'fcntet\'e9ssel]}{\insrsid15821247\charrsid16609500 , amit siettetni akartok}{\insrsid15821247\charrsid13064541 ,}{\insrsid15821247  akkor m\'e1r eld\'f6ntetett volna az \'fcgy k\'f6ztem \'e9s k\'f6ztetek. Allah tudja a legjobban, kik az igazs\'e1
gtalanok.\'94
\par }{\insrsid6625152 
\par }{\insrsid15821247 59. }{\lang1038\langfe3073\langfenp3073\insrsid15821247 N\'e1la vannak a rejtett dolgok kulcsai (a megismer\'e9s\'fckh\'f6z vezet\'f5 utak), ezekr\'f5l csak \'d5 tud. \'c9s \'d5 tudja, mi van a sz\'e1razf\'f6ld\'f6n \'e9s a tengerben, 
\'e9s nem esik le egy lev\'e9l sem an\'e9lk\'fcl, hogy \'d5 ne tudna r\'f3la. \'c9s nincs egy mag sem a f\'f6ld m\'e9ly\'e9n, sem nedves vagy sz\'e1raz, ami ne lenne egy nyilv\'e1nval\'f3 }{\insrsid15821247 \'cdr\'e1sban (az \'d5rz\'f6tt T\'e1bl\'e1n).

\par }{\insrsid6625152 
\par }{\insrsid15821247 60. \'c9s \'d5 az, aki mag\'e1hoz sz\'f3l\'edt titeket \'e9jjel, \'e9s tudja, hogy mit k\'f6vettetek el nappal, azut\'e1n }{\insrsid15821247\charrsid9327102 felt\'e1maszt titeket benne}{\insrsid15821247  (a nap folyam\'e1
n), hogy beteljesedjen a megszabott hat\'e1rid\'f5. Majd hozz\'e1 t\'e9rtek vissza, \'e9s tudatni fogja veletek mit tettetek.
\par 61. \'c9s \'d5 az, Aki legy\'f5zhetetlen [hatalommal b\'edr] szolg\'e1i felett, \'e9s f\'f6l\'e9tek \'f5rz\'f5ket (angyalokat) k\'fcld. V\'e9g\'fcl, ha elj\'f6n valamelyik\'f5t\'f6kh\'f6z a hal\'e1l, elsz\'f3l\'edtj\'e1k [Hozz\'e1nk] a k\'fcld\'f6tteink, 
\'e9s \'f5k nem k\'f6vetnek el hanyags\'e1got [feladatuk elv\'e9gz\'e9s\'e9ben].
\par 62. Majd visszavitetnek Allahhoz, Igaz Urukhoz \endash  l\'e1m, bizony az \'edt\'e9lkez\'e9s \'d5t illeti \endash  \'d5 a leggyorsabb elsz\'e1moltat\'f3!
\par }{\insrsid6625152 
\par }{\insrsid15821247 63. Mondd: \'84Ki ment meg titeket a sz\'e1razf\'f6ld \'e9s a }{\insrsid15821247\charrsid13064541 tenger }{\insrsid15821247\charrsid4417030 [k\'fcl\'f6nb\'f6z\'f5]}{\insrsid15821247  s\'f6t\'e9ts\'e9geit\'f5l, amikor is al\'e1zatosan 
\'e9s rejtetten foh\'e1szkodtok [mondv\'e1n]: \'84Bizony, ha \'d5 (Allah) megment minket ett\'f5l, akkor a h\'e1l\'e1sak k\'f6z\'e9 fogunk tartozni!\'94
\par 64. Mondd: \'84[Egyed\'fcl] Allah ment meg titeket ezekt\'f5l, \'e9s minden szorongattat\'e1st\'f3l, azut\'e1n ti t\'e1rsistent \'e1ll\'edtotok [Allah mell\'e9].
\par 65. Mondd: \'84\'d5 az, Akinek hatalm\'e1ban \'e1ll, hogy gy\'f6trelmet k\'fcldj\'f6n r\'e1tok fejetek f\'f6l\'fcl, vagy a l\'e1baitok al\'f3l, vagy hogy zavarodotts\'e1got bocs\'e1sson r\'e1tok [ellens\'e9ges] p\'e1rtokk\'e1 osztva titeket, hogy meg\'ed
zleltesse egyesekkel k\'f6z\'fcletek a m\'e1sik harci csap\'e1s\'e1t.\'94 N\'e9zd, hogyan }{\insrsid15821247\charrsid9327102 sorakoztatjuk}{\insrsid15821247  fel a jeleket (bizony\'edt\'e9kokat), h\'e1tha meg\'e9rtik!
\par 66. \'c9s a n\'e9ped meghazudtolta [a Kor\'e1nt], holott az az igazs\'e1g! Mondd: \'84Nem vagyok a ti v\'e9delmez\'f5t\'f6k!\'94
\par 67. Minden h\'edrnek megvan a beteljesed\'e9si ideje, \'e9s meg fogj\'e1tok tudni [amikor bek\'f6vetkezik]!
\par }{\insrsid6625152 
\par }{\insrsid15821247 68. Ha l\'e1tod azokat, akik [g\'fanyt \'fbzve] sz\'f3ba elegyednek a jeleinkr\'f5l, akkor fordulj el t\'f5l\'fck, am\'edg valami m\'e1s besz\'e9dbe nem elegyednek, \'e9s ha a s\'e1t\'e1n elfeledteti (ezt) veled, akkor az eml\'e9kez\'e9
s ut\'e1n ne \'fclj az igazs\'e1gtalan n\'e9p k\'f6z\'e9!
\par 69. \'c9s az \'f5 elsz\'e1moltat\'e1suk semmiben sem tartozik azokra, akik istenf\'e9l\'f5k, hanem az eml\'e9keztet\'e9s [az \'f5 feladatuk], h\'e1tha azok istenf\'e9l\'f5k lesznek.
\par 70. \'c9s hagyd azokat, akik a vall\'e1sukat j\'e1tszadoz\'e1s \'e9s sz\'f3rakoz\'e1s t\'e1rgy\'e1v\'e1 tett\'e9k, \'e9s megt\'e9vesztette \'f5ket az evil\'e1gi \'e9let! \'c9s eml\'e9keztess vele (a Kor\'e1nnal), nehogy pusztul\'e1snak legyen kit\'e9
ve az ember amiatt, amit szerzett (elk\'f6vetett)! Nem lesz neki Allahon k\'edv\'fcl p\'e1rtfog\'f3ja, se k\'f6zbenj\'e1r\'f3ja, \'e9s ha b\'e1rmit ad v\'e1lts\'e1gul, nem lesz elfogadva t\'f5le. \'d5k azok, akik ki lesznek t\'e9ve a pusztul\'e1snak a
miatt, amit szereztek. Azoknak forr\'e1sban l\'e9v\'f5 v\'edzb\'f5l lesz az italuk \'e9s f\'e1jdalmas gy\'f6trelemben lesz r\'e9sz\'fck }{\insrsid15821247\charrsid9327102 amiatt, hogy }{\cf1\insrsid15821247\charrsid9327102 hitetlenn\'e9 v\'e1ltak}{
\insrsid15821247\charrsid13064541 .}{\insrsid15821247 
\par }{\insrsid6625152 
\par }{\insrsid15821247 71. Mondd: \'84Vajon Allahon k\'edv\'fcl olyanhoz foh\'e1szkodjunk, ami nem lehet hasznunkra, se \'e1rtalmunkra? Sarkon forduljunk (t\'e9rj\'fcnk vissza a t\'e9velyg\'e9sbe), miut\'e1n Allah igaz \'fatra vezetett minket?\'94
 Mint az [olyan], }{\insrsid15821247\charrsid1121133 akit a s\'e1t\'e1nok t\'e9v\'fatra vittek a [a puszta] f\'f6ld\'f6n tan\'e1cstalans\'e1gban [hagyva]?}{\insrsid15821247\charrsid13064541  V}{\insrsid15821247 annak neki t\'e1rsai, akik az igaz \'fatra h
\'edvj\'e1k \'f5t [mondv\'e1n]: \'84Tarts vel\'fcnk!\'94 Mondd: \'84Bizony, Allah \'fatmutat\'e1sa az [igaz] \'fatmutat\'e1s! \'c9s az parancsoltatott nek\'fcnk, hogy vess\'fck al\'e1 magunkat a teremtm\'e9nyek Ur\'e1nak!\'94
\par 72. \'c9s [parancsot kaptatok arra], }{\insrsid15821247\charrsid13064541 hogy }{\insrsid15821247\charrsid1121133 tarts\'e1tok meg az im\'e1dkoz\'e1st}{\insrsid15821247\charrsid13064541 ,}{\insrsid15821247  \'e9s f\'e9lj\'e9tek \'d5t! \'d5
 az, akihez egybe lesztek gy\'fbjtve.
\par 73. \'c9s \'d5 az, aki megteremtette az egeket \'e9s a f\'f6ldet az igazs\'e1ggal (c\'e9llal). \'c9s [eml\'edtsd meg] azt a napot (a Felt\'e1mad\'e1s napj\'e1t), amikor azt mondja: \'84Legy\'e9l!\'94, \'e9s az lesz, az \'d5 szava az igazs\'e1g, \'e9s \'d6
v\'e9 a kir\'e1lyi uralom azon a napon, amikor meg lesz f\'fajva a k\'fcrt! A rejtett \'e9s a l\'e1that\'f3 [dolgok] Tud\'f3ja! \'d5 a B\'f6lcs \'e9s j\'f3l ismer mindent.
\par }{\insrsid6625152 
\par }{\insrsid15821247 74. \'c9s }{\insrsid15821247\charrsid13064541 [}{\insrsid15821247\charrsid8537037 eml\'edtsd meg azt], amikor}{\insrsid15821247  \'c1brah\'e1m azt mondta apj\'e1nak, \'c1zarnak: \'84Vajon b\'e1lv\'e1nyokat teszel istenekk\'e9? Bizony, l
\'e1tom, hogy te \'e9s a n\'e9ped nyilv\'e1nval\'f3 t\'e9velyg\'e9sben vagytok.\'94
\par 75. \'c9s ekk\'e9ppen mutattuk meg \'c1brah\'e1mnak az egek \'e9s a f\'f6ld birodalm\'e1t, \'e9s hogy azok k\'f6z\'e9 tartozzon, akiknek szil\'e1rd bizonyoss\'e1guk van.
\par 76. Amikor betakarta \'f5t az \'e9jszaka, megl\'e1tott egy \'e9gitestet. Azt mondta: \'84Ez az \'e9n Uram!\'94 De amikor elt\'fbnt, azt mondta: \'84\'c9n nem szeretem az elt\'fbn\'f5 [isteneket]!\'94
\par 77. Amikor pedig l\'e1tta a holdat felkel\'f5ben, azt mondta: \'84Ez az \'e9n Uram!\'94 \'c1m amikor az elt\'fbnt, azt mondta: \'84Ha az \'e9n Uram nem vezet igaz \'fatra engem, akkor bizony a t\'e9velyg\'f5 n\'e9phez fogok tartozni.\'94
\par 78. Amikor pedig l\'e1tta a Napot felkel\'f5ben, azt mondta: \'84Ez az \'e9n Uram! Ez nagyobb!\'94 \'c1m mikor az elt\'fbnt, azt mondta: \'84\'d3 n\'e9pem, bizony \'e9n elhat\'e1rol\'f3dok att\'f3l, ami t\'e1rsistent \'e1ll\'edtotok [Allah mell\'e9]!

\par 79. Arcomat afel\'e9 ford\'edtom, aki l\'e9trehozta az egeket \'e9s a f\'f6ldet, han\'edfk\'e9nt (egyistenh\'edv\'f5k\'e9nt, a hamis vall\'e1sokt\'f3l elhajl\'f3k\'e9nt), \'e9s nem tartozom azok k\'f6z\'e9, akik t\'e1rsistent \'e1ll\'edtanak [Allah mell
\'e9].\'94
\par }{\insrsid6625152 
\par }{\insrsid15821247 80. \'c9s \'e9rvelve sz\'e1llt vit\'e1ba vele a n\'e9pe. Azt mondta: \'84Vajon \'e9rvelve sz\'e1lltok vit\'e1ba velem Allahr\'f3l, holott m\'e1r az igaz \'fatra vezetett? \'c9n nem f\'e9lek azokt\'f3l, akiket ti t\'e1rsistenk\'e9nt \'e1
ll\'edtotok [Allah mell\'e9], kiv\'e9ve ha Uram akarja, hogy valami [csap\'e1s \'e9rjen]. Az Uram mindent \'e1tfog tud\'e1ssal. Vajon nem okultok [az int\'e9sb\'f5l]?
\par 81. \'c9s hogyan f\'e9ln\'e9k azokt\'f3l, akiket ti t\'e1rsistenn\'e9 nyilv\'e1n\'edtottatok, mik\'f6zben ti nem f\'e9ltek att\'f3l, hogy t\'e1rsistent \'e1ll\'edtsatok Allah mell\'e9, olyasmit, amellyel kapcsolatban [Allah] nem bocs\'e1
tott le nektek bizony\'edt\'f3 \'e9rvet. Vajon a k\'e9t csoport k\'f6z\'fcl melyiket illeti meg legink\'e1bb a biztons\'e1g, ha val\'f3ban rendelkeztek tud\'e1ssal?\'94
\par 82. Akik hisznek, \'e9s nem tett\'e9k zavaross\'e1 hit\'fcket igazs\'e1gtalans\'e1ggal (t\'e1rsistent \'e1ll\'edtv\'e1n Allah mell\'e9), azoknak biztons\'e1g j\'e1r, \'e9s \'f5k az [igaz] \'fatra leltek.
\par 83. \'c9s ez a mi \'e9rv\'fcnk, amelyet \'c1brah\'e1mnak adtunk a n\'e9p\'e9vel szemben. Fokozatokkal emelj\'fck fel azokat, akiket akarunk. Bizony, a te Urad B\'f6lcs, Mindentud\'f3.
\par }{\insrsid6625152 
\par }{\insrsid15821247 84. \'c9s neki aj\'e1nd\'e9koztuk Izs\'e1kot \'e9s J\'e1kobot [unokak\'e9nt]. Mindegyik\'fcket az igaz \'fatra vezett\'fck, \'e9s kor\'e1bban vezett\'fck No\'e9t, \'e9s ut\'f3djai k\'f6z\'fcl: D\'e1vidot, Salamont, J\'f3bot, J\'f3
zsefet, M\'f3zest, \'e9s \'c1ront \endash  Mi ekk\'e9ppen adjuk meg a fizets\'e9g\'e9t }{\insrsid15821247\charrsid13064541 a }{\insrsid15821247\charrsid8537037 j\'f3tev\'f5knek}{\insrsid15821247  \endash  
\par 85. Tov\'e1bb\'e1 Zakari\'e1st, J\'e1nost, J\'e9zust, Ill\'e9st \endash  mind a j\'f3 emberek k\'f6z\'e9 tartoznak \endash  
\par 86. Izm\'e1elt, Elizeust, J\'f3n\'e1st, \'e9s L\'f3tot \endash  mindet el\'f5nyben r\'e9szes\'edtett\'fck }{\insrsid15821247\charrsid12991388 [a maguk kor\'e1ban]}{\insrsid15821247  a teremtm\'e9nyekkel szemben \endash  
\par 87. \'e9s [m\'e1sokat is vezett\'fcnk] aty\'e1ik, ut\'f3daik \'e9s testv\'e9reik k\'f6z\'fcl. Kiv\'e1lasztottuk \'f5ket, \'e9s az Egyenes \'fatra vezett\'fck \'f5ket.
\par 88. Ez Allah \'fatmutat\'e1sa, amely \'e1ltal azt vezet az igaz \'fatra, akit akar az \'d5 szolg\'e1i k\'f6z\'fcl}{\insrsid15821247\charrsid7355858 . \'c1m ha t\'e1rsistent \'e1ll\'edtottak volna [Allah mell\'e9], akkor szertefoszlana sz\'e1
mukra mindaz, amit cselekedtek.}{\insrsid15821247 
\par 89. \'d5k azok, akiknek az \'cdr\'e1st adtuk, \'e9s a b\'f6lcsess\'e9get \'e9s a pr\'f3f\'e9tas\'e1got. Azonban, ha \'f5k (a mekkaiak) tagadj\'e1k ezeket, akkor bizony olyan n\'e9pre b\'edzzuk, akik nem tagadj\'e1k.
\par 90. \'d5k azok, akiket Allah az igaz \'fatra vezetett, k\'f6vesd h\'e1t az \'f5 \'fatmutat\'e1sukat! Mondd: \'84Nem k\'e9rek }{\insrsid15821247\charrsid2693855 t\'f5letek ez\'e9rt fizets\'e9get.\'94 Ez csup\'e1n eml\'e9keztet\'f5 a teremtm\'e9nyeknek.

\par }{\insrsid6625152\charrsid2693855 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10836342 {\insrsid15821247\charrsid2693855 91. Nem becs\'fclt\'e9k nagyra Allah [hatalm\'e1t], az \'d5t megillet\'f5 nagyrabecs\'fcl\'e9
s szerint, amikor azt mondt\'e1k: \'84Allah embernek nem bocs\'e1tott le semmit.\'94 Mondd: \'84[Akkor] ki bocs\'e1totta le az \'cdr\'e1st, amelyet M\'f3zes vil\'e1goss\'e1gk\'e9nt \'e9s \'fatmutat\'e1sk\'e9nt hozott el az embereknek? [K\'fcl\'f6nb\'f6z
\'f5] lapokra teszitek, amelyek [egy r\'e9sz\'e9t] megmutatj\'e1tok, \'e1m sokat elrejtetek. \'c9s meg lettetek tan\'edtva [a Kor\'e1n}{\insrsid15821247  \'e1ltal] olyanra, amit nem tudtatok, sem ti, sem ap\'e1itok. Mondd: \'84Allah!\'94 majd hagyd \'f5
ket [alaptalan] besz\'e9d\'fckbe elegyedve j\'e1tszadozni!
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 92. \'c9s ez [a Kor\'e1n] egy \'e1ldott \'cdr\'e1s, amelyet lebocs\'e1tottunk, igazolva annak az igazs\'e1g\'e1t, ami el\'f5
tte volt. \'c9s hogy figyelmeztesd a telep\'fcl\'e9sek anyav\'e1ros\'e1t (Mekk\'e1t), \'e9s akik k\'f6r\'fcl\'f6tte vannak. \'c9s akik hisznek a T\'falvil\'e1gban, azok hisznek benne, \'e9s \'f5k az im\'e1dkoz\'e1sukra gondosan \'fcgyelnek.
\par }{\insrsid6625152 
\par }{\insrsid15821247 93. \'c9s ki igazs\'e1gtalanabb ann\'e1l, mint aki hazugs\'e1got tal\'e1l ki Allah ellen, vagy azt mondja: \'84[Kinyilatkoztat\'e1s] sugalltatott nekem\'94 \endash  mik\'f6zben semmi sem sugalltatott neki, vagy mint aki azt mondta: \'84
Olyat fogok lebocs\'e1tani, mint amit Allah bocs\'e1t le!\'94 \'c9s b\'e1rcsak l\'e1tn\'e1d, amint az igazs\'e1gtalanok a hal\'e1l \'f6rv\'e9nyeiben [verg\'f5dnek], mik\'f6zben az angyalok a karjukat kiny\'fajtva [azt mondj\'e1k]: }{
\insrsid15821247\charrsid13064541 \'84}{\insrsid15821247\charrsid1013314 Adj\'e1tok ki a lelketeket!}{\insrsid15821247  Ma a megal\'e1ztat\'e1s gy\'f6trelm\'e9t kapj\'e1tok fizets\'e9g\'fcl az\'e9rt, mert Allahr\'f3l m\'e1st mondtatok, mint az igazs\'e1
got, \'e9s a jeleit\'f5l fennh\'e9j\'e1zva [fordultok el]!\'94
\par 94. \'c9s bizony egyenk\'e9nt j\'f6tt\'f6k el Hozz\'e1nk [a Felt\'e1mad\'e1s napj\'e1n], ahogyan els\'f5 alkalommal teremtett\'fcnk meg titeket. \'c9s a h\'e1tatok m\'f6g\'f6tt hagyj\'e1tok azt, amivel felruh\'e1ztunk titeket. \'c9s nem l\'e1
tjuk veletek a k\'f6zbenj\'e1r\'f3itokat (a hamis isteneiteket), akikr\'f5l azt \'e1ll\'edtott\'e1tok, hogy [szolg\'e1lataitokb\'f3l r\'e9szesed\'f5] t\'e1rsistenek}{\insrsid15821247\charrsid2187889  }{\insrsid15821247 
[Allah mellett]. Bizony, elszakadtak [a k\'f6tel\'e9kek] k\'f6z\'f6ttetek, \'e9s elt\'fbnik mell\'f5letek az, amit \'e1ll\'edtottatok.
\par }{\insrsid6625152 
\par }{\insrsid15821247 95. Bizony, Allah has\'edtja meg a [gabona-]szemet \'e9s a [datolya] magot. \'d5 hozza el\'f5 az \'e9l\'f5t a holtb\'f3l, \'e9s \'d5 az el\'f5hoz\'f3ja a holtnak az \'e9l\'f5b\'f5l. \'cdme, \'d5 Allah! Hogyan lehettek h\'e1t elt\'e9r
\'edtve [az igazs\'e1gt\'f3l]?
\par 96. \'d5 a hajnal meghas\'edt\'f3ja, \'e9s \'d5 tette nyugalomm\'e1 az \'e9jszak\'e1t, valamint a Napot \'e9s a Holdat [az id\'f5] sz\'e1m\'edt\'e1s\'e1nak [eszk\'f6z\'e9v\'e9]. Ez a M\'e9lt\'f3s\'e1gteljes, a Mindentud\'f3 elrendel\'e9se.
\par 97. \'d5 az, aki [jelekk\'e9] tette sz\'e1motokra a csillagokat, hogy r\'e1tal\'e1ljatok a helyes \'fatra a sz\'e1razf\'f6ld \'e9s a tenger s\'f6t\'e9ts\'e9geiben. Bizony, r\'e9szletesen kifejtett\'fck a jeleket egy olyan n\'e9p sz\'e1m\'e1
ra, akik rendelkeznek tud\'e1ssal.
\par 98. \'d5 az, aki egyetlen emberb\'f5l hozott l\'e9tre titeket, majd nyugv\'f3helyet \'e9s \'f5rz\'f5helyet [jel\'f6lt ki nektek]. Bizony, r\'e9szletesen kifejtett\'fck a jeleket egy olyan n\'e9pnek, akik \'e9rtenek.
\par 99. \'c9s \'f5 az, aki vizet bocs\'e1tott le az \'e9gb\'f5l. \'c9s azzal ind\'edtjuk el minden dolog bimb\'f3z\'e1s\'e1t. Abb\'f3l [azt\'e1n] z\'f6ld hajt\'e1sokat sarjasztottunk, azokb\'f3l pedig s\'fbr\'fbn egym\'e1sra sorakoz\'f3
 [gabona-]szemeket fakasztunk. \'c9s a datolyap\'e1lm\'e1kb\'f3l, azok vir\'e1gzat\'e1b\'f3l m\'e9lyen al\'e1cs\'fcng\'f5 f\'fcrt\'f6k [teremnek]. \'c9s [sarjasztunk] sz\'f5l\'f5t\'f5k\'e9kb\'f5l \'e1ll\'f3 kerteket, \'e9s olajf\'e1kat \'e9s gr\'e1n\'e1
talmaf\'e1kat, amelyek [term\'e9sei k\'f6z\'fcl vannak] hasonl\'f3ak \'e9s k\'fcl\'f6nb\'f6z\'f5ek. Figyelj\'e9tek meg a term\'e9s\'e9t, amikor terem, \'e9s az \'e9r\'e9s\'e9t is! Bizony, ebben jelek vannak egy olyan n\'e9pnek, akik hisznek.
\par }{\insrsid6625152 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10836342 {\insrsid15821247 100. \'c9s Allah [mell\'e9] t\'e1rsistenekk\'e9 tett\'e9k meg a dzsinneket, holott \'d5 teremtette \'f5ket. Fiakat \'e9s l\'e1
nyokat tulajdon\'edtottak Neki hazug m\'f3don, tud\'e1s n\'e9lk\'fcl. Magasztaltass\'e9k \'d5! \'c9s }{\insrsid16331266\charrsid2638912 \'d5 felette van }{\insrsid10836342\charrsid2638912 [}{\insrsid16331266\charrsid2638912 annak, mint], ahogy le\'edrj
\'e1k [\'d5t].}{\insrsid15821247 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 101. Az egek \'e9s a f\'f6ld Megalkot\'f3ja! Hogyan is lenne neki }{\insrsid15821247\charrsid8612075 gyereke}{
\insrsid15821247\charrsid13064541 ,}{\insrsid15821247  holott soha nem volt hitvest\'e1rsa? \'c9s megteremtett minden dolgot, \'e9s Allah minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 102. \'cdme, \'d5 Allah, az Uratok! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, csak \'d5. Minden dolog Teremt\'f5je, szolg\'e1lj\'e1tok h\'e1t \'d5t! \'c9s \'d5 mindennek a v\'e9delmez\'f5je.
\par 103. Nem \'e9szlelik \'d5t a tekintetek, \'d5 azonban \'e9szleli a tekinteteket. \'c9s \'d5 a K\'edm\'e9letes, a [mindent] j\'f3l Ismer\'f5.
\par 104. Imm\'e1r tiszt\'e1nl\'e1t\'e1st ad\'f3 bizony\'edt\'e9kok j\'f6ttek hozz\'e1tok Uratokt\'f3l. \'c9s aki l\'e1tja, az a maga haszn\'e1ra teszi, aki pedig vakk\'e1 v\'e1lik, az a maga k\'e1r\'e1ra teszi. [Mondd:] \'84\'c9n nem vagyok felettetek \'f5rz
\'f5.\'94
\par 105. Ekk\'e9ppen sorakoztatjuk fel a jeleket }{\insrsid15821247\charrsid13064541 [}{\insrsid15821247\charrsid1573780 tan\'fas\'e1gk\'e9nt}{\insrsid15821247\charrsid13064541 ],}{\insrsid15821247  \'e9s [m\'e9gis a hitetlenek]  azt mondj\'e1k: \'84
Tanultad [az el\'f5z\'f5 \'cdr\'e1sokb\'f3l]\'94, pedig az\'e9rt [tessz\'fck ezt], hogy nyilv\'e1nval\'f3v\'e1 tegy\'fck egy olyan n\'e9pnek, akik rendelkeznek tud\'e1ssal.
\par }{\insrsid6625152 
\par }{\insrsid15821247 106. K\'f6vesd azt, ami [kinyilatkoztat\'e1sk\'e9nt] sugalltatott neked az Uradt\'f3l! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, csak \'d5, \'e9s fordulj el azokt\'f3l, akik t\'e1rsisteneket \'e1ll\'edtanak [Allah mell\'e9]!
\par 107. Ha Allah akarta volna, nem \'e1ll\'edtottak volna [Allah }{\insrsid15821247\charrsid4010012 mell\'e9}{\insrsid15821247 ] t\'e1rsisteneket. Nem tett\'fcnk t\'e9ged \'f5rz\'f5\'fcl f\'f6l\'e9j\'fck, \'e9s te nem vagy az \'f5 v\'e9delmez\'f5j\'fck.

\par 108. Ne szidalmazz\'e1tok azokat, akikhez [a hitetlenek] Allah helyett foh\'e1szkodnak, nehogy Allahot szidalmazz\'e1k ellens\'e9gesked\'e9sb\'f5l, tud\'e1s n\'e9lk\'fcl! Ekk\'e9ppen d\'edszess\'e9 tett\'fck minden k\'f6z\'f6ss\'e9g sz\'e1m\'e1
ra a maguk cselekedet\'e9t. Majd az Urukhoz lesz a visszat\'e9r\'e9s\'fck, \'e9s h\'edr\'fcl adja nekik mindazt, amit tettek.
\par }{\insrsid6625152 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid2638912 {\insrsid15821247 109. \'c9s Allahra esk\'fcdtek meg a leger\'f5teljesebb esk\'fcikkel, hogy ha elj\'f6n hozz\'e1
juk egy jel, akkor hinni fognak abban. Mondd: \'84Bizony, a jelek csup\'e1n Allahra tartoznak!\'94 \'c9s honnan is tudhatn\'e1tok [ti h\'edv\'f5k, hogy }{\insrsid2638912 hinni }{\insrsid15821247 fognak], ha elj\'f6nnek ezek [a jelek]? Nem fognak hinni!

\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 110. \'c9s elford\'edtjuk a sz\'edv\'fcket \'e9s a tekintet\'fcket [az Igazs\'e1gt\'f3l], ahogyan els\'f5
 alkalommal sem hittek abban, \'e9s ott hagyjuk \'f5ket t\'falkap\'e1saikban vakon bolyongani.
\par 111. \'c9s ha lebocs\'e1tan\'e1nk hozz\'e1juk az angyalokat, \'e9s a halottak besz\'e9ln\'e9nek hozz\'e1juk, \'e9s egybegy\'fbjten\'e9nk nekik mindent [amit k\'e9rnek], szemmel l\'e1that\'f3an el\'e9j\'fck t\'e1rva, akkor sem hinn\'e9nek \endash  kiv\'e9
ve, ha Allah akarja. \'c1m a legt\'f6bbj\'fck tudatlan.
\par }{\insrsid6625152 
\par }{\insrsid15821247 112. \'c9s ekk\'e9ppen rendelt\'fcnk minden pr\'f3f\'e9t\'e1nak ellens\'e9get: s\'e1t\'e1nokat az emberek \'e9s a dzsinnek k\'f6z\'fcl, egyik\'fck a m\'e1siknak sugallja az \'e9kes besz\'e9det megt\'e9veszt\'e9s\'fcl, \'e1
m ha Urad akarta volna, nem tett\'e9k volna ezt. Hagyd h\'e1t \'f5ket, \'e9s azt, amit kital\'e1lnak!
\par 113. \'c9s az\'e9rt, hogy afel\'e9 (az \'e9kes besz\'e9d fel\'e9) hajoljon azoknak a sz\'edve, akik nem hisznek a t\'falvil\'e1gban, \'e9s az\'e9rt, hogy el\'e9gedettek legyenek azzal, \'e9s hogy elk\'f6vess\'e9k azt, amit [k\'e9sz\'fclnek] elk\'f6vetni.

\par }{\insrsid6625152 
\par }{\insrsid15821247 114. Vajon h\'e1t Allah helyett m\'e1st keressek \'edt\'e9lkez\'f5nek? Holott \'d5 az, aki lebocs\'e1totta nektek az \'cdr\'e1st (a Kor\'e1nt), r\'e9szletesen kifejtve. \'c9s akiknek [m\'e1r kor\'e1bban] \'cdr\'e1st adtunk, azok tudj
\'e1k, hogy az az Uradt\'f3l bocs\'e1ttatott le az igazs\'e1ggal. Ne tartozz h\'e1t a k\'e9telked\'f5k k\'f6z\'e9!
\par 115. \'c9s teljess\'e9 v\'e1lt az Urad szava az igazmond\'e1s \'e9s az igazs\'e1goss\'e1g jegy\'e9ben. Nincs [senki], aki megv\'e1ltoztathatn\'e1 az \'d5 [kinyilatkoztatott] szavait, \'e9s \'d5 a Mindent Hall\'f3, a Mindentud\'f3.
\par 116. Ha pedig engedelmeskedn\'e9l a legt\'f6bbnek azok k\'f6z\'fcl, akik a f\'f6ld\'f6n vannak, akkor elt\'e9vely\'edten\'e9nek Allah \'fatj\'e1t\'f3l. \'d5k csup\'e1n a v\'e9leked\'e9st k\'f6vetik, \'e9s csak tal\'e1lgatnak.
\par 117. Bizony, a te Urad tudja a legjobban, hogy ki t\'e9velyedik el az \'d5 \'fatj\'e1t\'f3l, \'e9s \'d5 tudja a legjobban, hogy kik leltek az [igaz] \'fatra.
\par }{\insrsid6625152 
\par }{\insrsid15821247 118. Egyetek h\'e1t abb\'f3l [a megengedett j\'f3sz\'e1g h\'fas\'e1b\'f3l], ami felett megeml\'edttetik Allah neve [v\'e1g\'e1skor], ha }{\insrsid15821247\charrsid16670807 val\'f3ban}{\insrsid15821247\charrsid13064541  }{
\insrsid15821247\charrsid16670807 hisztek a jeleiben}{\insrsid15821247\charrsid9247181 !}{\insrsid15821247 
\par 119. Mi lelt h\'e1t titeket, hogy nem esztek abb\'f3l, ami felett megeml\'edttetett Allah neve, miut\'e1n \'d5 m\'e1r r\'e9szletesen kifejtette nektek mindazt, amit tilalmass\'e1 tett nektek \endash  kiv\'e9ve, ha k\'e9nyszer visz r\'e1
 titeket? Bizony sokan elt\'e9vely\'edtenek [m\'e1sokat] a k\'e9ny\'fckkel, tud\'e1s n\'e9lk\'fcl. Bizony a te Urad tudja a legjobban, hogy kik a t\'falkap\'e1sra vetemed\'f5k.
\par 120. Hagyj\'e1tok el a nyilv\'e1nos b\'fbnt \'e9s a rejtettet is! Bizony azok, akik b\'fbnt szereznek, fizets\'e9get fognak kapni az\'e9rt, amit elk\'f6vettek.
\par 121. \'c9s ne egyetek abb\'f3l [a h\'fasb\'f3l], ami felett nem eml\'edttetik meg Allah neve! Bizony engedetlens\'e9g az! \'c9s bizony, a s\'e1t\'e1nok sugallnak az }{\insrsid15821247\charrsid13064541 \'f5 }{\insrsid15821247\charrsid11762109 p\'e1
rtfogoltjaiknak}{\insrsid15821247 , hogy vit\'e1ba sz\'e1lljanak veletek [a tilalmakr\'f3l]. Ha engedelmeskedn\'e9tek nekik, akkor bizony olyann\'e1 v\'e1ln\'e1tok, akik t\'e1rsisteneket \'e1ll\'edtanak [Allah mell\'e9].
\par }{\insrsid6625152 
\par }{\insrsid15821247 122. Az, aki holt volt \'e9s mi \'e9letre keltett\'fck, s olyan vil\'e1goss\'e1got adtunk neki, ami \'e1ltal az emberek k\'f6z\'f6tt j\'e1r, olyan-e, mint az, aki [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gekben van, \'e9s abb\'f3
l nem jut ki? Ekk\'e9ppen }{\insrsid15821247\charrsid9247181 t\'e9tetett}{\insrsid15821247  d\'edszess\'e9 a hitetleneknek az, amit cselekedtek.
\par 123. \'c9s ekk\'e9ppen tett\'fck minden telep\'fcl\'e9sen azok gonosztev\'f5it vezet\'f5kk\'e9, hogy azokban tervet sz\'f5jenek. \'c1m csup\'e1n maguk ellen sz\'f5nek tervet, \'e9s \'e9szre sem veszik.
\par 124. \'c9s ha elj\'f6n hozz\'e1juk egy jel, azt mondj\'e1k: \'84Nem hisz\'fcnk addig, am\'edg olyat nem kapunk, amelyet Allah k\'fcld\'f6ttei kaptak (pr\'f3f\'e9tas\'e1got).\'94 Allah jobban tudja, hova teszi (kinek adja) az \'fczenet\'e9
t. Azokat, akik gonosztetteket cselekedtek, Allahn\'e1l megal\'e1zotts\'e1g fogja s\'fajtani \'e9s szigor\'fa gy\'f6trelem, amiatt, hogy [gonosz] tervet sz\'f5ttek.
\par }{\insrsid6625152 
\par }{\insrsid15821247 125. \'c9s akit Allah [az igaz] \'fatra akar vezetni, annak kebl\'e9t kit\'e1rja az iszl\'e1mnak. \'c9s akit t\'e9velyg\'e9sbe akar vezetni, annak kebl\'e9t sz\'fbkk\'e9 \'e9s fesz\'e9lyezetts\'e9ggel teliv\'e9 teszi \'fagy, mintha az 
\'e9gbe emelkedne. Ekk\'e9ppen teszi Allah a f\'f6rtelmes [b\'fcntet\'e9st] azokra, akik nem hisznek.
\par 126}{\insrsid15821247\charrsid13064541 . }{\insrsid15821247\charrsid9247181 \'c9s ez [a vall\'e1s}{\insrsid15821247\charrsid13064541 ]}{\insrsid15821247  az Urad \'fatja, amely egyenesen [Hozz\'e1 vezet]. Bizony r\'e9szletesen kifejtett\'fc
k a jeleket egy olyan n\'e9pnek, akik okulnak [az int\'e9sb\'f5l].
\par 127. Nekik a B\'e9kess\'e9g Lakhelye (a Paradicsom) j\'e1r az \'f5 Urukn\'e1l, \'e9s \'d5 a P\'e1rtfog\'f3juk [jutalmul] az\'e9rt, amit cselekedtek.
\par }{\insrsid6625152 
\par }{\insrsid15821247 128. \'c9s azon a napon, amikor mindannyiukat egybegy\'fbjti, [azt mondja:] \'84\'d3 dzsinnek gy\'fclekezete! Sok embert szereztetek meg (vittetek t\'e9velyg\'e9sbe)!\'94 \'c9s azt mondj\'e1k a p\'e1rtfog\'f3ik [a hitetlen emberek k\'f6
z\'fcl]: \'84Urunk! Egyik\'fcnk a m\'e1sik haszn\'e1ra volt, most pedig el\'e9rt\'fck a megszabott hat\'e1rid\'f5nket, amit Te hat\'e1rozt\'e1l meg nek\'fcnk.\'94 Azt mondja [Allah]: \'84A [Pokol-]t\'fbz az otthonotok, \'f6r\'f6kk\'e9
 abban fogtok maradni \endash  kiv\'e9ve azt, amit Allah akar.\'94 Bizony a te Urad B\'f6lcs, Mindentud\'f3!
\par 129. \'c9s ekk\'e9ppen ruh\'e1zunk fel egyeseket az igazs\'e1gtalanok k\'f6z\'fcl hatalommal m\'e1sok felett, az\'e9rt, amit szereztek.
\par 130. \'84\'d3 dzsinnek \'e9s emberek gy\'fclekezete! Vajon nem j\'f6ttek-e k\'fcld\'f6ttek hozz\'e1tok, magatok k\'f6z\'fcl, akik elbesz\'e9lt\'e9k jeleimet nektek, \'e9s figyelmeztettek titeket e nappal val\'f3 tal\'e1lkoz\'e1sotokra?\'94 Azt mondj\'e1
k majd: \'84Tan\'faskodunk magunk ellen!\'94 \'c9s megt\'e9vesztette \'f5ket az evil\'e1gi \'e9let, \'e9s tan\'faskodtak \'f6nmaguk ellen arr\'f3l, hogy hitetlenek voltak.
\par 131. Ez az\'e9rt van, mert Urad nem puszt\'edtja el a telep\'fcl\'e9seket [az \'e1ltaluk elk\'f6vetett] igazs\'e1gtalans\'e1g miatt, mik\'f6zben lak\'f3i nem lettek figyelmeztetve.
\par }{\insrsid6625152 
\par }{\insrsid15821247 132. Mindenkinek megvannak a fokozatai aszerint, }{\insrsid15821247\charrsid13064541 amit }{\insrsid15821247\charrsid4474081 cselekedett}{\insrsid15821247\charrsid13064541 .}{\insrsid15821247  \'c9s az Urad nem hagyja figyelmen k\'edv
\'fcl azt, amit cselekszenek.
\par 133. \'c9s a te Urad a Gazdag (aki nem szorul senkire), \'d6v\'e9 a k\'f6ny\'f6r\'fclet. Ha akarja elt\'e1vol\'edt (elpuszt\'edt) titeket, \'e9s ut\'e1natok azt l\'e9ptet a helyetekbe ut\'f3dk\'e9nt, akit akar, \'fagy ahogyan l\'e9trehozott titeket [is] m
\'e1s n\'e9pek ut\'f3daib\'f3l.
\par 134. Amire \'edg\'e9retet kaptatok, az bizony be fog k\'f6vetkezni, \'e9s ti nem fogj\'e1tok [Allahot] megakad\'e1lyozni [semmiben]!
\par 135. Mondd: \'84\'d3 n\'e9pem! Cselekedjetek helyzetetek (m\'f3dszeretek) szerint! Bizony, \'e9n is cselekedni fogok [a m\'f3dszerem szerint]. Meg fogj\'e1tok tudni, ki\'e9 lesz a v\'e9gs\'f5 lakhely! Bizony, az igazs\'e1gtalanok nem fognak boldogulni!
\'94
\par }{\insrsid6625152 
\par }{\insrsid15821247 136. \'c9s kijel\'f6ltek Allahnak egy r\'e9szt abb\'f3l, amit sz\'e9tsz\'f3rt a vet\'e9sb\'f5l \'e9s a j\'f3sz\'e1gokb\'f3l. S azt mondt\'e1k, }{\insrsid15821247\charrsid16670807 az \'f5 \'e1ll\'edt\'e1suk szerint}{
\insrsid15821247\charrsid13064541 : \'84Ez Allah\'e9 }{\insrsid15821247\charrsid16670807 \endash }{\strike\insrsid15821247\charrsid16670807  az \'f5 \'e1ll\'edt\'e1suk szerint }{\insrsid15821247\charrsid16670807 \endash }{\insrsid15821247  amaz pedig azok
\'e9, akiket [Allah mell\'e9] t\'e1rsistenekk\'e9nt \'e1ll\'edtottunk.\'94 \'c9s amib\'f5l \'f5k a t\'e1rsisteneiket r\'e9szes\'edtik az nem jut el Allahhoz, ami pedig Allah\'e9, az eljut a t\'e1rsisteneikhez! Milyen rossz az, ahogyan \'edt\'e9lkeznek!

\par 137. Ekk\'e9ppen tett\'e9k a t\'e1rsisteneik d\'edszess\'e9 sokaknak - [az Allah mell\'e9] t\'e1rsisteneket \'e1ll\'edt\'f3k k\'f6z\'fcl - gyermekeik meg\'f6l\'e9s\'e9t, hogy pusztul\'e1sba vezess\'e9k \'f5ket, \'e9s zavaross\'e1 tegy\'e9k sz\'e1
mukra a vall\'e1sukat. Ha Allah \'fagy akarta volna, nem tett\'e9k volna ezt! H\'e1t hagyd \'f5ket \'e9s azt, amit kital\'e1lnak!
\par }{\insrsid6625152 
\par }{\insrsid15821247 138. \'c9s azt mondt\'e1k: \'84Ezek [a] j\'f3sz\'e1gok \'e9s vet\'e9s [term\'e9sei] kiz\'e1r\'f3lagosak [a b\'e1lv\'e1nyaink sz\'e1m\'e1ra], nem ehet m\'e1s bel\'f5l\'fck, csup\'e1n az, akit mi akarunk\'94, \'e1ll\'edt\'e1suk szerint, 
\'e9s vannak j\'f3sz\'e1gok, amelyek h\'e1ta tilalmass\'e1 t\'e9tetett (nem terhelhet\'f5k), \'e9s vannak [m\'e1s] j\'f3sz\'e1gok, amelyek felett [lev\'e1g\'e1sukkor] nem eml\'edtik Allah nev\'e9t, kital\'e1lva [ezt a hazugs\'e1
got] ellene. Meg fogja nekik adni fizets\'e9g\'fcket az\'e9rt, amit kital\'e1ltak.
\par 139. \'c9s azt mondt\'e1k: \'84Ami e j\'f3sz\'e1gok has\'e1ban van [\'e9s \'e9lve sz\'fcletik], az teljess\'e9gben a mi f\'e9rfiaink\'e9, \'e9s tilalmas h\'e1zast\'e1rsainknak (asszonyainknak).\'94 \'c1m ha holtan sz\'fcletik, akkor [r\'e9szesed\'f5] t
\'e1rsak benne. Megadja majd nekik a fizets\'e9g\'fcket, ami\'e9rt [tilalmasnak vagy megengedettnek] min\'f5s\'edtik a dolgokat. Bizony, \'d5 B\'f6lcs, }{\insrsid15821247\charrsid16670807 Mindent}{\insrsid15821247 ud\'f3!
\par 140. Bizony, vesztesek azok, akik meg\'f6lik gyermekeiket ostob\'e1n, tud\'e1s n\'e9lk\'fcl, \'e9s tilalmass\'e1 teszik azt, amivel Allah ell\'e1tta \'f5ket, kital\'e1lva [ezt a hazugs\'e1got] Allah ellen. Bizony elt\'e9velyedtek \'e9
s nem leltek az [igaz] \'fatra.
\par }{\insrsid6625152 
\par }{\insrsid15821247 141. \'d5 az, aki kerteket hozott l\'e9tre lugassal \'e9s lugas n\'e9lk\'fcl, \'e9s datolyap\'e1lm\'e1t \'e9s gabon\'e1t, amelyek term\'e9sei k\'fcl\'f6nb\'f6z\'f5ek, \'e9s olaj- \'e9s gr\'e1n\'e1talmaf\'e1t, amelyek [term\'e9
sei] hasonl\'f3ak, \'e9s [\'edzben] k\'fcl\'f6nb\'f6z\'f5ek. Egyetek azok term\'e9seib\'f5l, amikor term\'e9st hoznak, \'e9s adj\'e1tok meg a [szeg\'e9nyek] jogos r\'e9sz\'e9t az arat\'e1s napj\'e1n, \'e9s ne legyetek m\'e9rt\'e9ktelenek! Bizony, \'d5
 nem szereti a m\'e9rt\'e9kteleneket!
\par 142. \'c9s [Allah teremtett] a j\'f3sz\'e1gok k\'f6z\'fcl teherhord\'f3 \'e9s egy\'e9b haszon\'e1llatot. Egyetek abb\'f3l, amivel Allah ell\'e1tott titeket, \'e9s ne k\'f6vess\'e9tek a s\'e1t\'e1n l\'e9pteit! Bizony, \'f5 nyilv\'e1nval\'f3 ellens\'e9
getek!
\par }{\insrsid6625152 
\par }{\insrsid15821247 143. Nyolcat }{\insrsid15821247\charrsid801075 [teremtett nektek]}{\insrsid15821247  p\'e1ros\'e1val. A juhb\'f3l kett\'f5t (h\'edmet \'e9s n\'f5st\'e9nyt), \'e9s a kecsk\'e9b\'f5l kett\'f5t (h\'edmet \'e9s n\'f5st\'e9nyt). Mondd: \'84
Vajon [Allah] a k\'e9t h\'edmet tette-e tilalmass\'e1, vagy a k\'e9t n\'f5st\'e9nyt, vagy pedig azt, amit a k\'e9t n\'f5st\'e9ny m\'e9he mag\'e1ban foglal? Adj\'e1tok h\'edr\'fcl nekem [val\'f3di] tud\'e1s alapj\'e1n}{\insrsid15821247\charrsid13064541 
, ha }{\insrsid15821247\charrsid801075 val\'f3ban}{\insrsid15821247  igazmond\'f3k vagytok!
\par 144. \'c9s a tev\'e9b\'f5l kett\'f5t (h\'edmet \'e9s n\'f5st\'e9nyt), \'e9s a marh\'e1b\'f3l kett\'f5t (h\'edmet \'e9s n\'f5st\'e9nyt). Mondd: \'84Vajon [Allah] a k\'e9t h\'edmet tette-e tilalmass\'e1, vagy a k\'e9t n\'f5st\'e9
nyt, vagy pedig azt, amit a k\'e9t n\'f5st\'e9ny m\'e9he mag\'e1ban foglal? Vagy pedig tan\'fai voltatok annak, amikor Allah ezt meghagyta nektek?\'94 Ki lehetne igazs\'e1gtalanabb ann\'e1l, mint aki hazugs\'e1got tal\'e1l ki Allah ellen, hogy t\'e9velyg
\'e9sbe vigye az embereket tud\'e1s n\'e9lk\'fcl? Allah nem vezeti igaz \'fatra az igazs\'e1gtalan n\'e9pet.
\par }{\insrsid6625152 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid15821247 145. Mondd: \'84Nem tal\'e1lok abban, ami [kinyilatkoztat\'e1sk\'e9nt] sugalltatott nekem, olyan tilalmas [\'e9lelmet], amit egy t
\'e1pl\'e1lkoz\'f3 megenne, kiv\'e9ve azt, hogy elhullott \'e1llat [h\'fasa] legyen, vagy kifolyatott v\'e9r, vagy diszn\'f3h\'fas \endash  ez bizony f\'f6rtelmess\'e9g \endash  vagy [olyan \'e1llat, amelyet }{\insrsid3161635 a }{\insrsid15821247 lev\'e1g
\'e1skor] engedetlens\'e9gk\'e9ppen }{\insrsid15821247\charrsid13064541 Allah helyett }{\insrsid6031785 [t\'e1rsistennek]}{\insrsid15821247\charrsid13064541  aj\'e1nlanak fel.}{\insrsid15821247  \'c1m aki r\'e1k\'e9nyszer\'fcl [ezek fogyaszt\'e1s\'e1
ra], an\'e9lk\'fcl, hogy v\'e1gyakozna [az engedetlens\'e9gre], vagy t\'falkap\'e1sra vetemedne [}{\insrsid16674381 ezek fogyaszt\'e1s\'e1ban, }{\insrsid15821247 azt nem terheli b\'fbn]. Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 146. \'c9s azoknak, akik zsid\'f3k, tilalmass\'e1 tett\'fcnk minden el nem k\'fcl\'f6n\'fcl\'f5 ujjakkal rendelkez\'f5 [\'e1
llatot]. \'c9s tilalmass\'e1 tett\'fck a marha \'e9s }{\insrsid15821247\charrsid3547626 a juh faggy\'faj\'e1t, kiv\'e9ve azt}{\insrsid15821247 , amit a h\'e1tuk hordoz, vagy amit a belek tartalmaznak, vagy ami csonttal keveredett. Ekk\'e9ppen fizett\'fc
nk meg nekik zsarnoks\'e1guk\'e9rt. Mi bizony igazmond\'f3k vagyunk.
\par 147. Ha meghazudtolnak t\'e9ged, akkor mondd: \'84Uratok a [mindent] \'e1tfog\'f3 k\'f6ny\'f6r\'fclet birtokosa, \'e9s csap\'e1sa nem h\'e1r\'edthat\'f3 el a gonosztev\'f5 n\'e9pr\'f5l.\'94
\par }{\insrsid6625152 
\par }{\insrsid15821247 148. Azt mondj\'e1k majd azok, akik [Allah mell\'e9] t\'e1rsisteneket \'e1ll\'edtanak: \'84Ha Allah \'fagy akarta volna, nem \'e1ll\'edtottunk volna [mell\'e9] t\'e1rsisteneket, \'e9s ap\'e1ink sem, \'e9s semmit }{
\insrsid15821247\charrsid3547626 sem tett\'fcnk}{\insrsid15821247  volna tilalmass\'e1. Ekk\'e9ppen k\'f6vettek el meghazudtol\'e1st azok, akik el\'f5tt\'fck \'e9ltek, eg\'e9szen addig, am\'edg meg nem \'edzlelt\'e9k csap\'e1sunkat. Mondd: \'84
Vajon birtokoltok-e tud\'e1st, amit el\'f5hozhatn\'e1tok nek\'fcnk? Nem k\'f6vettek m\'e1st, csak v\'e9leked\'e9st, \'e9s ti csup\'e1n tal\'e1lgattok.\'94
\par 149. Mondd: \'84Allah\'e9 a d\'f6nt\'f5 \'e9rv! Ha akarta volna, akkor mindny\'e1jatokat az igaz \'fatra vezetett volna.\'94
\par 150. Mondd: \'84Nosza ide a tan\'faitokkal, akik tan\'fas\'edtj\'e1k, hogy Allah tilalmass\'e1 tette ezt [amit ti \'e1ll\'edtotok]!\'94 Ha azok tan\'faskodnak, te ne tan\'faskodj vel\'fck! \'c9s ne k\'f6vesd azok v\'e1gyait, akik meghazudtolj\'e1
k a jeleinket, \'e9s akik nem hisznek a T\'falvil\'e1gban, mik\'f6zben Urukkal egyenl\'f5nek tartanak [m\'e1sokat]!
\par }{\insrsid6625152 
\par }{\insrsid15821247 151. Mondd: \'84Gyertek! Recit\'e1lni fogom azt, amit Uratok tilalmass\'e1 tett nektek. [Allah azt parancsolja nektek] hogy semmit se \'e1ll\'edtsatok \'d5mell\'e9 t\'e1rsistenekk\'e9nt; [legyetek] j\'f3s\'e1gosak a sz\'fcl\'f5kkel; ne 
\'f6lj\'e9tek meg gyermekeiteket szeg\'e9nys\'e9g miatt \endash  Mi l\'e1tunk el titeket \'e9s \'f5ket is; ne k\'f6vessetek el f\'f6rtelmess\'e9geket, ak\'e1r nyilv\'e1nosan, ak\'e1r titokban; ne \'f6lj\'e9tek meg azt az embert, akinek [\'e9let\'e9
t] Allah tilalmass\'e1 tette, csakis jogosan (ember\'f6l\'e9s vagy a f\'f6ld\'f6n val\'f3 puszt\'edt\'e1s b\'fcntet\'e9sek\'e9nt)! Ezt hagyja meg nektek, h\'e1tha \'e9ltek az eszetekkel.
\par 152. Ne k\'f6zel\'edtsetek az \'e1rva vagyon\'e1hoz, csak a legm\'e9lt\'f3bb m\'f3don, am\'edg el nem \'e9ri \'e9rett kor\'e1t; tegy\'e9tek teljess\'e9 a kim\'e9r\'e9st \'e9s [haszn\'e1lj\'e1tok] a m\'e9rleget igazs\'e1gosan \endash  senkit sem k\'f6telez
\'fcnk t\'f6bbre, mint amennyire k\'e9pes \endash , ha besz\'e9ltek, akkor legyetek igazs\'e1gosak, m\'e9g ha k\'f6zeli rokonr\'f3l van is sz\'f3; teljes\'edts\'e9tek az Allahhal [k\'f6t\'f6tt] egyezs\'e9get! Ezt hagyja meg nektek, h\'e1
tha okultok [az int\'e9sb\'f5l]. }{\insrsid6625152 
\par }{\insrsid15821247 153. \'c9s bizony ez az \'c9n egyenes utam, k\'f6vess\'e9tek h\'e1t! \'c9s ne k\'f6vessetek [m\'e1s] utakat, mert azok k\'fcl\'f6nb\'f6z\'f5 ir\'e1nyba t\'e9r\'edtenek el az \'d5 \'fatj\'e1t\'f3l! Ezt hagyja meg nektek, h\'e1tha istenf
\'e9l\'f5k lesztek.
\par }{\insrsid6625152 
\par }{\insrsid15821247 154. Azut\'e1n [mondd:] Mi adtuk M\'f3zesnek az \'cdr\'e1st (T\'f3r\'e1t), kiteljes\'edtve [kegy\'fcnket] annak sz\'e1m\'e1ra, aki j\'f3t cselekedett, \'e9s r\'e9szletes magyar\'e1zatk\'e9nt minden dologra, \'fatmutat\'e1sk\'e9nt \'e9
s k\'f6ny\'f6r\'fcletk\'e9nt, h\'e1tha hinni fognak az Urukkal val\'f3 tal\'e1lkoz\'e1sban.
\par 155. \'c9s ez (a Kor\'e1n) egy \'e1ldott \'cdr\'e1s, amelyet lebocs\'e1tottunk. K\'f6vess\'e9tek h\'e1t azt, \'e9s legyetek istenf\'e9l\'f5k, h\'e1tha }{\insrsid15821247\charrsid6187264 k\'f6ny\'f6r\'fcletre leltek}{\insrsid15821247 !
\par 156. [Az\'e9rt bocs\'e1tottuk le], hogy ne mondhass\'e1tok: \'84Az \'cdr\'e1s csup\'e1n k\'e9t [vall\'e1si] csoportnak lett lebocs\'e1tva el\'f5tt\'fcnk, \'e9s mi figyelmen k\'edv\'fcl hagytuk }{\insrsid15821247\charrsid6187264 tanulm\'e1nyoz\'e1sukat.
\'94}{\insrsid15821247 
\par 157. Vagy [hogy ne] mondhass\'e1tok: \'84Ha lebocs\'e1ttatott volna nek\'fcnk az \'cdr\'e1s, akkor mi jobban k\'f6vett\'fck volna az \'fatmutat\'e1s\'e1t, mint \'f5k.\'94 Imm\'e1r j\'f6n hozz\'e1tok a vil\'e1gos bizony\'edt\'e9k (a Kor\'e1n) az Uratokt
\'f3l, \'fatmutat\'e1sk\'e9nt \'e9s k\'f6ny\'f6r\'fcletk\'e9nt. \'c9s ki igazs\'e1gtalanabb ann\'e1l}{\insrsid15821247\charrsid12991388 , mint}{\insrsid15821247  aki meghazudtolja Allah jeleit, \'e9s elz\'e1rk\'f3zik azokt\'f3l? Akik elz\'e1rk\'f3
znak a jeleinkt\'f5l, azoknak sz\'f6rny\'fb gy\'f6trelmet fogunk adni fizets\'e9gk\'e9nt az\'e9rt, mert elz\'e1rk\'f3ztak.
\par 158. Vajon v\'e1rnak-e m\'e1sra, mint hogy elj\'f6jjenek hozz\'e1juk az angyalok [a hal\'e1lukkor], vagy hogy elj\'f6jj\'f6n az Urad [az \'edt\'e9lkez\'e9sre], vagy hogy elj\'f6jj\'f6n Urad n\'e9mely jele [a V\'e9gs\'f5 \'d3r\'e1ra vonatkoz\'f3
an]? Azon a napon, amikor elj\'f6n Urad n\'e9h\'e1ny jele, nem fog egyetlen embernek sem haszn\'e1lni a hite, aki nem hitt kor\'e1bban, vagy a hite \'e1ltal nem cselekedett j\'f3t. Mondd: \'84V\'e1rakozzatok csak! Bizony, mi is v\'e1rakozunk.\'94
\par }{\insrsid6625152 
\par }{\insrsid15821247 159. Bizony, akik szakad\'e1st okoztak a vall\'e1sukban, \'e9s p\'e1rtokk\'e1 v\'e1ltak, azokhoz te nem tartozol semmiben. Az \'f5 \'fcgy\'fck Allahra tartozik. Majd elmondja nekik mindazt, amit tettek.
\par 160. Aki egy j\'f3tettel j\'f6n majd el, annak t\'edzszer annyi j\'e1r. Aki pedig egy rossz tettel j\'f6n majd el, azt nem illeti m\'e1s fizets\'e9g, csup\'e1n ugyanannyi, \'e9s \'f5ket nem \'e9ri igazs\'e1gtalans\'e1g.
\par }{\insrsid6625152 
\par }{\insrsid15821247 161. Mondd [\'f3 Mohamed:] \'84Az \'e9n Uram Egyenes \'datra vezetett engem, a szil\'e1rd [alapokon \'e1ll\'f3] vall\'e1shoz; \'c1brah\'e1mnak, a han\'edfnak (egyistenh\'edv\'f5, a hamis vall\'e1sokt\'f3l elhajl\'f3) vall\'e1s\'e1hoz, 
\'e9s nem tartozott [az Allah mell\'e9] t\'e1rsisteneket \'e1ll\'edt\'f3k k\'f6z\'e9.\'94
\par 162. Mondd: \'84Bizony az im\'e1dkoz\'e1som \'e9s az \'e1ldoz\'e1si r\'edtusom, \'e9letem \'e9s hal\'e1lom Allah\'e9, a teremtm\'e9nyek Ur\'e1\'e9, 
\par 163. Nincs \'d5mellette t\'e1rsisten! Ennek a megvall\'e1s\'e1ra lettem felsz\'f3l\'edtva, \'e9s \'e9n vagyok az els\'f5 azok k\'f6z\'f6tt, akik al\'e1vetik magukat [Allahnak].\'94
\par }{\insrsid6625152 
\par }{\insrsid15821247 164. Mondd: \'84Vajon Allahon k\'edv\'fcl m\'e1s urat keressek, holott \'d5 mindennek az Ura?\'94 \'c9s nem tesz szert [a rosszra] egy ember sem, csakis a maga k\'e1r\'e1ra. \'c9s egyetlen terhet cipel\'f5 sem cipeli egy m\'e1
siknak a terh\'e9t. Majd Uratok el\'e9 lesz a visszat\'e9r\'e9setek, \'e9s \'d5 tudatni fogja veletek azt, amiben \'f6sszek\'fcl\'f6nb\'f6ztetek.
\par 165. \'c9s \'d5 az, aki ut\'f3dokk\'e1 (egym\'e1s hely\'e9be l\'e9p\'f5 nemzed\'e9kekk\'e9) tett titeket a f\'f6ld\'f6n, \'e9s egyik\'f5t\'f6ket a m\'e1sik f\'f6l\'e9 emelte fokozatokkal, hogy pr\'f3b\'e1ra tegyen titeket az\'e1
ltal, amit nektek adott. A te Urad bizony gyors a b\'fcntet\'e9sben, \'e9s \'d5 bizony Megbocs\'e1t\'f3, Irgalmas.
\par 
\par }{\cf6\insrsid15821247 
\par 
\par }\pard\plain \s1\qj \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid15821247 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\f0\fs24\insrsid6625152 \page }{
\f0\fs24\insrsid16543947 7. }{\f0\fs24\insrsid15821247\charrsid15821247 A Magaslatok (al-A'r\'e1f) c. sz\'fara}{\f0\fs24\cf6\insrsid15821247\charrsid15821247 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\cf6\insrsid15821247 
\par }{\insrsid15821247 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. Alif-l\'e1m-m\'edm-szad.
\par 2. \'cdr\'e1s [ez], amely lebocs\'e1ttatott neked \endash  ne \'e9rezz h\'e1t kebledben fesz\'e9lyezetts\'e9get miatta \endash , hogy figyelmeztess vele. \'c9s eml\'e9keztet\'f5 a h\'edv\'f5knek.
\par 3. [\'d3 emberek!] K\'f6vess\'e9tek azt, ami lebocs\'e1ttatott nektek az Uratokt\'f3l! \'c9s ne k\'f6vessetek helyette m\'e1s p\'e1rtfog\'f3t! Mily kev\'e9ss\'e9 okultok [az int\'e9sb\'f5l]!
\par }{\insrsid10886557 
\par }{\insrsid15821247 4. \'c9s h\'e1ny telep\'fcl\'e9st puszt\'edtottunk el, \'e9s a mi csap\'e1sunk [hirtelen] j\'f6tt el hozz\'e1juk \'e9jjel, vagy mik\'f6zben d\'e9lben lepihentek.
\par 5. \'c9s nem volt m\'e1s ki\'e1lt\'e1suk, amikor a csap\'e1sunk elj\'f6tt hozz\'e1juk, csup\'e1n az, hogy azt mondt\'e1k: \'84Mi bizony igazs\'e1gtalanok voltunk!\'94
\par 6. Mi bizony megk\'e9rdezz\'fck azokat [a n\'e9peket], }{\insrsid15821247\charrsid9769361 akikhez elk\'fcldettek, \'e9s meg fogjuk k\'e9rdezni a k\'fcld\'f6tteket [is].}{\insrsid15821247 
\par 7. \'c9s bizony tud\'e1s alapj\'e1n besz\'e9lj\'fck el nekik [a tetteiket], \'e9s nem voltunk t\'e1vol [azokt\'f3l].
\par }{\insrsid10886557 
\par }{\insrsid15821247 8. Azon a napon [a tettek] m\'e9r\'e9se az igazs\'e1gnak megfelel\'f5 lesz. Akiknek s\'falyosak lesznek a m\'e9rend\'f5ik [a j\'f3tettekb\'f5l], nos \'f5k }{\insrsid7996197 bizony }{\insrsid15821247 azok, akik boldogulnak.}{
\insrsid10886557 
\par }{\insrsid15821247 9. \'c1m akiknek k\'f6nny\'fbek lesznek a m\'e9rend\'f5ik [a j\'f3tetteikb\'f5l], azok elveszejtik magukat, amiatt, hogy igazs\'e1gtalanok voltak a jeleinkkel szemben.
\par 10. \'c9s bizony hatalmat adtunk nektek a f\'f6ld\'f6n, \'e9s meg\'e9lhet\'e9st rendelt\'fcnk nektek ott. Mily kev\'e9ss\'e9 adtok h\'e1l\'e1t.
\par }{\insrsid10886557 
\par }{\insrsid15821247 11. \'c9s bizony mi teremtett\'fcnk titeket, majd meg}{\cf1\insrsid15821247 form\'e1ztunk benneteket.}{\insrsid15821247  Azt\'e1n azt mondtuk az angyaloknak, hogy boruljanak le \'c1d\'e1m el\'f5tt, s [\'f5k azon nyomban] leborultak, kiv
\'e9ve Ibl\'edszt, \'f5 nem tartozott azok k\'f6z\'e9, akik leborultak.
\par 12. Azt mondta [Allah]: \'84Mi tartott vissza t\'e9ged att\'f3l, hogy leborulj, amikor megparancsoltam?\'94 Azt mondta [Ibl\'edsz]: \'84\'c9n jobb vagyok n\'e1la (\'c1d\'e1mn\'e1l)! Engem t\'fbzb\'f5l teremtett\'e9l, \'f5t pedig agyagb\'f3l teremtetted.
\'94
\par 13. [Allah] azt mondta: \'84Menj h\'e1t le innen! Nem teheted meg, hogy fennh\'e9j\'e1zz itt! Menj h\'e1t ki! A lealacsony\'edtottak k\'f6z\'e9 tartozol!\'94
\par 14. Azt mondta [Ibl\'edsz]: \'84Uram adj nekem halad\'e9kot, addig a napig, amikor felt\'e1masztatnak [a halottak]!\'94
\par 15. [Allah] azt mondta: \'84Bizony, azok k\'f6z\'e9 tartozol, akiknek halad\'e9k adatott.\'94
\par 16. Azt mondta [Ibl\'edsz]: \'84Ami\'e9rt t\'e9v\'fatra vitt\'e9l engem, \'fatj\'e1t fogom \'e1llni [az embereknek] a Te egyenes Utadon,}{\insrsid15821247\charrsid9136287 
\par }{\insrsid15821247 17}{\insrsid15821247\charrsid9769361 . }{\insrsid15821247 Azut\'e1n j\'f6v\'f6k hozz\'e1juk el\'f6lr\'f5l \'e9s a h\'e1tuk m\'f6g\'fcl, \'e9s a jobbjukr\'f3l \'e9s a baljukr\'f3l, \'e9s legt\'f6bbj\'fcket nem fogod h\'e1l\'e1snak tal
\'e1lni.\'94
\par 18. [Allah] azt mondta: \'84Menj ki innen megvetetten \'e9s ki\'fbzve! Aki pedig k\'f6vet t\'e9ged k\'f6z\'fcl\'fck, bizony megt\'f6lt\'f6m a Gyehenn\'e1t veletek, mindny\'e1jatokkal!
\par }{\insrsid10886557 
\par }{\insrsid15821247 19. \'d3 \'c1d\'e1m! Te \'e9s a feles\'e9ged lakjatok a Paradicsomban, egyetek ti ketten abb\'f3l, amit akartok, \'e1m ehhez a f\'e1hoz ne k\'f6zeledjetek, mert akkor az igazs\'e1gtalanok k\'f6z\'e9 fogtok tartozni!\'94
\par 20. \'c9s a s\'e1t\'e1n sugdosott nekik, hogy felfedje nekik azt, ami eddig rejtve volt a szem\'e9rm\'fckb\'f5l, \'e9s azt mondta: \'84A ti Uratok csup\'e1n az\'e9rt tiltotta meg nektek ezt a f\'e1t, nehogy angyalok vagy \'f6r\'f6kl\'e9t\'fbek legyetek!
\'94
\par 21. \'c9s megesk\'fcd\'f6tt kettej\'fcknek: \'84\'c9n bizony \'f5szinte tan\'e1csad\'f3tok vagyok.\'94
\par 22. Megt\'e9veszt\'f5 m\'f3don m\'e9lys\'e9gbe tasz\'edtotta \'f5ket. \'c9s amikor meg\'edzlelt\'e9k a fa [term\'e9s\'e9t], l\'e1that\'f3v\'e1 v\'e1lt kettej\'fck sz\'e1m\'e1ra a szem\'e9rm\'fck, \'e9s elkezdt\'e9k elfedni magukat a Paradicsom [f\'e1
inak] leveleivel. \'c9s [ekkor] Uruk sz\'f3l\'edtotta \'f5ket: \'84Nem tiltottam-e meg nektek azt a f\'e1t, \'e9s nem mondtam-e nektek, hogy a s\'e1t\'e1n kett\'f5t\'f6k nyilv\'e1nval\'f3 ellens\'e9ge?\'94
\par 23. Azt mondt\'e1k: \'84Urunk! Igazs\'e1gtalans\'e1got k\'f6vett\'fcnk el magunk ellen, \'e9s ha nem bocs\'e1tasz meg nek\'fcnk \'e9s nem k\'f6ny\'f6r\'fclsz rajtunk, akkor bizony a vesztesek k\'f6z\'e9 fogunk tartozni!\'94
\par 24. Azt mondta [Allah]: \'84Menjetek le [a Paradicsomb\'f3l]! Egyik\'f5t\'f6k a m\'e1siknak ellens\'e9ge, \'e9s a f\'f6ld\'f6n sz\'e1ll\'e1shely \'e9s \'e9lvezet lesz sz\'e1motokra egy [meghat\'e1rozott] ideig.\'94
\par 25. Azt mondta [Allah]: \'84Ott fogtok \'e9lni, \'e9s ott fogtok meghalni, \'e9s onnan lesztek el\'f5hozatva.\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 26. \'d3 \'c1d\'e1m fiai! Lebocs\'e1tottunk nektek \'f6lt\'f6z\'e9ket, amely elrejti a szem\'e9rmeteket, \'e9s [m\'e1s \'f6lt\'f6z\'e9ket] d\'edsz\'edt\'e9sk\'e9nt. \'c1m az istenf\'e9lelem \'f6lt\'f6z\'e9ke jobb! Ez Allah jelei k\'f6z
\'fcl val\'f3, h\'e1tha }{\insrsid15821247\charrsid5465322 okulnak}{\insrsid15821247  [az int\'e9sb\'f5l].
\par 27. \'d3 \'c1d\'e1m fiai! Ne vigyen k\'eds\'e9rt\'e9sbe titeket a s\'e1t\'e1n \'fagy, ahogyan a sz\'fcleiteket [k\'eds\'e9rt\'e9se \'e1ltal] kihozta a Paradicsomb\'f3l, lev\'e9ve r\'f3luk az \'f6lt\'f6z\'e9k\'fcket, hogy l\'e1that\'f3v\'e1 tegye sz\'e1
mukra a szem\'e9rm\'fcket! Bizony, \'f5 l\'e1t titeket, \'e9s az \'f5 csapata is, onnan, ahonnan ti nem l\'e1thatj\'e1tok \'f5ket.  Bizony, mi a s\'e1t\'e1nokat azok p\'e1rtfog\'f3iv\'e1 tett\'fck, akik nem hisznek.
\par }{\insrsid10886557 
\par }{\insrsid15821247 28. Amikor f\'f6rtelmes tettet k\'f6vetnek el, azt mondj\'e1k: \'84Aty\'e1inkat is ezen tal\'e1ltuk, \'e9s Allah parancsolta meg ezt nek\'fcnk.\'94 Bizony, Allah nem parancsolja meg a f\'f6rtelmess\'e9get. Vajon olyat \'e1ll\'ed
totok Allahr\'f3l, amit nem tudtok?
\par 29. Mondd [\'f3 Mohamed]: \'84Az Uram az igazs\'e1goss\'e1got parancsolta meg \'e9s azt, hogy ford\'edts\'e1tok arcotokat [Allah h\'e1za fel\'e9] minden imahelyen. \'c9s foh\'e1szkodjatok \'d5hozz\'e1, \'f5szinte odaad\'e1ssal, Neki szentelve a vall\'e1
s [gyakorl\'e1s\'e1t]! Ahogyan a kezdetben teremtett titeket, \'fagy fogtok visszat\'e9rni [Hozz\'e1].
\par 30. Egy csoportot az igaz \'fatra vezetett, \'e9s egy m\'e1sik csoportra n\'e9zve jogoss\'e1 v\'e1lt a t\'e9velyg\'e9s. Bizony, \'f5k a s\'e1t\'e1nokat tett\'e9k p\'e1rtfog\'f3ikk\'e1 Allah helyett, \'e9s azt gondolj\'e1k, hogy az [igaz] \'fatra leltek.

\par }{\insrsid10886557 
\par }{\insrsid15821247 31. \'d3 \'c1d\'e1m fiai! Vegy\'e9tek fel a d\'edszeteket (ruh\'e1tokat) minden im\'e1dkoz\'e1sn\'e1l, \'e9s egyetek, \'e9s igyatok, \'e1m ne legyetek m\'e9rt\'e9ktelenek! Bizony, \'d5 nem szereti a m\'e9rt\'e9kteleneket!
\par 32. Mondd [\'f3 Mohamed]: \'84Ki tette tilalmass\'e1 Allah d\'edsz\'e9t, amelyet a szolg\'e1i sz\'e1m\'e1ra hozott el\'f5, \'e9s a j\'f3 dolgokat abb\'f3l, amit ell\'e1t\'e1sk\'e9nt adott?\'94 Mondd [\'f3 Mohamed]: \'84Ez azoknak j\'e1r az evil\'e1gi \'e9
letben, akik hisznek, \'e1m kiz\'e1r\'f3lag \'f5ket illeti meg a Felt\'e1mad\'e1s napj\'e1n.\'94 Ekk\'e9ppen fejtj\'fck ki r\'e9szletesen jeleinket egy olyan n\'e9pnek, akik rendelkeznek tud\'e1ssal.
\par 33. Mondd: \'84Az \'e9n Uram csup\'e1n a f\'f6rtelmess\'e9geket tette tilalmass\'e1, ak\'e1r nyilv\'e1nosak azok, ak\'e1r rejtettek, \'e9s a b\'fbnt, \'e9s a jogtalan zsarnoks\'e1got \'e9s azt, hogy Allah mell\'e9 t\'e1rsistent \'e1ll\'ed
tsatok, amivel kapcsolatban [Allah] nem bocs\'e1tott le bizony\'edt\'f3 \'e9rvet, \'e9s azt, hogy olyat mondjatok Allahr\'f3l, amir\'f5l nincs tud\'e1sotok.\'94
\par 34. \'c9s minden k\'f6z\'f6ss\'e9gnek [megszabott] hat\'e1rideje van. Amikor elj\'f6n a hat\'e1ridej\'fck, nem k\'e9sleltethetik azt egy \'f3r\'e1val sem, \'e9s nem hozhatj\'e1k el\'f5re [sem].
\par }{\insrsid10886557 
\par }{\insrsid15821247 35. \'d3 \'c1d\'e1m fiai! Ha k\'fcld\'f6ttek j\'f6nnek el hozz\'e1tok k\'f6z\'fcletek, akik elbesz\'e9lik nektek a jeleimet, akkor akik istenf\'e9l\'f5k \'e9s megjavulnak, azokon nem lesz \'farr\'e1 a f\'e9lelem, \'e9
s nem fognak szomorkodni.
\par 36. \'c9s akik meghazudtolt\'e1k a jeleinket \'e9s fennh\'e9j\'e1z\'f3an fordultak el azokt\'f3l, azok a [Pokol-]t\'fbz lak\'f3i! \'d5k abban fognak maradni \'f6r\'f6kk\'e9.
\par 37. \'c9s ki igazs\'e1gtalanabb ann\'e1l}{\insrsid15821247\charrsid7166906 , mint}{\insrsid15821247  aki hazugs\'e1got tal\'e1lt ki Allah ellen, vagy meghazudtolta a jeleit? El fogja \'e9rni azokat a kijel\'f6lt r\'e9sz\'fck az \'cdr\'e1sb\'f3
l. Amikor pedig elj\'f6nnek \'e9rt\'fck a k\'fcld\'f6tteink (a hal\'e1l angyalai), hogy elsz\'f3l\'edts\'e1k \'f5ket, azt mondj\'e1k: \'84Hol vannak azok, akikhez Allah helyett foh\'e1szkodtatok?\'94 Azt mondj\'e1k: \'84Elt\'fbntek mell\'f5l\'fcnk!\'94 
\'c9s tan\'fas\'e1got tesznek magukkal szemben arr\'f3l, hogy \'f5k hitetlenek.
\par }{\insrsid10886557 
\par }{\insrsid15821247 38. [Allah] azt fogja mondani [nekik]: \'84L\'e9pjetek be az el\'f5ttetek [az \'e9l\'f5k sor\'e1b\'f3l] elt\'e1vozott k\'f6z\'f6ss\'e9gekkel a dzsinnek \'e9s az emberek k\'f6z\'fcl a [Pokol-]t\'fbzbe!\'94 Ah\'e1nyszor bel\'e9p egy k\'f6
z\'f6ss\'e9g, meg\'e1tkozza a testv\'e9r\'e9t. \'c9s amikor mind meg\'e9rkeztek oda, az utols\'f3 [k\'f6z\'f6ss\'e9g] k\'f6z\'fcl\'fck azt fogja mondani az els\'f5 [k\'f6z\'f6ss\'e9gnek}{\insrsid15821247\charrsid8328127 ]: \'84Urunk! \'d5k vittek t\'e9
velyg\'e9sbe minket. Adj nekik k\'e9tszeres gy\'f6trelmet a [Pokol-]t\'fbzb\'f5l!\'94 Azt fogja mondani [Allah]: \'84Mindnek k\'e9tszeres j\'e1r, \'e1m ti nem tudj\'e1tok.\'94
\par 39. Az utols\'f3 [k\'f6z\'f6ss\'e9g] k\'f6z\'fcl\'fck azt fogja mondani az els\'f5 [k\'f6z\'f6ss\'e9gnek]:}{\insrsid15821247  \'84Nem voltatok k\'fcl\'f6nbek n\'e1lunk.\'94 \'cdzlelj\'e9tek h\'e1t meg a gy\'f6trelmet az\'e9rt, amit szereztetek!
\par 40. Bizony, akik meghazudtolt\'e1k a jeleinket \'e9s fennh\'e9j\'e1z\'f3an fordultak el azokt\'f3l, nem nyittatnak meg nekik az \'e9g kapui, \'e9s nem fognak a Paradicsomba l\'e9pni addig, am\'edg a teve \'e1t nem megy a t\'fb fok\'e1n. Mi ekk\'e9
ppen fizet\'fcnk meg a gonosztev\'f5knek.
\par 41. A Gyehenna lesz a fekv\'f5hely\'fck \'e9s f\'f6l\'f6tt\'fck [t\'fbz-]takar\'f3k lesznek. Mi ekk\'e9ppen fizet\'fcnk meg az igazs\'e1gtalanoknak.
\par }{\insrsid10886557 
\par }{\insrsid15821247 42. \'c9s azok, akik hisznek \'e9s j\'f3tetteket cselekszenek \endash  senkit sem k\'f6telez\'fcnk t\'f6bbre, mint amire k\'e9pes \endash , \'f5k lesznek a Paradicsom lak\'f3i, \'f5k abban fognak maradni \'f6r\'f6kk\'e9.
\par 43. \'c9s kiragadjuk azt, ami a kebl\'fckben volt [az evil\'e1gi] gy\'fbl\'f6letb\'f5l, alattuk foly\'f3k folynak, \'e9s azt mondj\'e1k: \'84A h\'e1latelt dics\'e9ret Allahot illeti, aki ehhez vezetett minket. \'c9s nem lett\'fcnk volna az Igaz \'fa
tra vezetve, ha Allah nem vezetett volna minket. Az Urunk k\'fcld\'f6ttei az igazs\'e1ggal j\'f6ttek el.\'94 \'c9s [\'edgy] fogj\'e1k \'f5ket sz\'f3l\'edtani: \'84Ez a Paradicsom [amely] \'f6r\'f6k\'fcl adatott nektek az\'e9rt, amit cselekedtetek.\'94

\par }{\insrsid10886557 
\par }{\insrsid15821247 44. \'c9s megsz\'f3l\'edtj\'e1k a Paradicsom lak\'f3i a [Pokol-]t\'fbz lak\'f3it: \'84Mi igaznak tal\'e1ltuk azt, amit Urunk \'edg\'e9rt, \'e9s ti vajon igaznak tal\'e1lt\'e1tok-e azt, amit Uratok \'edg\'e9rt?\'94 Azt mondj\'e1k: \'84
Igen!\'94 S egy kihirdet\'f5 hangos sz\'f3val hirdeti k\'f6z\'f6tt\'fck: \'84Allah \'e1tka az igazs\'e1gtalanokra!\'94
\par 45. [Azokra] akik t\'e1vol tartanak [m\'e1sokat] Allah \'datj\'e1t\'f3l, \'e9s azt k\'edv\'e1nj\'e1k, hogy az ferde legyen, mik\'f6zben \'f5k nem hisznek a t\'falvil\'e1gban.
\par }{\insrsid10886557 
\par }{\insrsid15821247 46. \'c9s a kett\'f5 [csoport] k\'f6z\'f6tt v\'e1laszfal van, \'e9s a Magaslatokon pedig f\'e9rfiak vannak, akik felismernek mindenkit az ismertet\'f5jel\'fckr\'f5l. \'c9s \'edgy fogj\'e1k sz\'f3l\'edtani a Paradicsom lak\'f3it: \'84B
\'e9kess\'e9g re\'e1tok!\'94 \endash  \'d5k nem l\'e9ptek be oda, \'e1m v\'e1gyakoznak arra.
\par 47. S ha a szem\'fck a [Pokol-]t\'fbz lak\'f3i fel\'e9 fordul, azt fogj\'e1k mondani: \'84Urunk! Ne t\'e9gy minket az igazs\'e1gtalan n\'e9p k\'f6z\'e9!\'94
\par 48. \'c9s a Magaslatok lak\'f3i megsz\'f3l\'edtj\'e1k azokat a f\'e9rfiakat, akiket felismernek az ismertet\'f5jel\'fckr\'f5l. Azt mondj\'e1k nekik: \'84Nem v\'e1lt hasznotokra az, amit gy\'fbjt\'f6ttetek, sem az, hogy fennh\'e9j\'e1ztatok.\'94
\par 49. Vajon \'f5k lenn\'e9nek azok, akikr\'f5l megesk\'fcdtetek, hogy Allah nem juttat nekik k\'f6ny\'f6r\'fcletet? L\'e9pjetek h\'e1t be a Paradicsomba! Nem lesz \'farr\'e1 rajtatok a f\'e9lelem, \'e9s nem fogtok szomorkodni.
\par }{\insrsid10886557 
\par }{\insrsid15821247 50. A [Pokol-]t\'fbz lak\'f3i megsz\'f3l\'edtj\'e1k majd a [paradicsomi] Kert lak\'f3it: \'84\'d6ntsetek r\'e1nk b\'f5s\'e9ges vizet, vagy }{\insrsid15821247\charrsid15553009 [adjatok] abb\'f3l}{\insrsid15821247 , amivel Allah ell\'e1
tott titeket!\'94 Azt fogj\'e1k mondani: \'84Bizony, Allah mindkett\'f5t tilalmass\'e1 tette a hitetleneknek\'94,
\par 51. Akik a vall\'e1sukat j\'e1tszadoz\'e1s \'e9s sz\'f3rakoz\'e1s t\'e1rgy\'e1v\'e1 tett\'e9k, \'e9s megt\'e9vesztette \'f5ket az evil\'e1gi \'e9let. Nos, ma elfelejtj\'fck \'f5ket, ahogyan \'f5k elfelejtett\'e9k e nappal val\'f3 tal\'e1lkoz\'e1sukat, 
\'e9s amiatt, hogy tagadt\'e1k a jeleinket.
\par }{\insrsid10886557 
\par }{\insrsid15821247 52. \'c9s bizony \'cdr\'e1st hoztunk nekik, amit r\'e9szletesen }{\insrsid15821247\charrsid15553009 kifejtett\'fcnk,}{\insrsid15821247  \'fatmutat\'e1sk\'e9nt \'e9s k\'f6ny\'f6r\'fcletk\'e9nt egy olyan n\'e9pnek, akik hisznek.
\par 53. Vajon m\'e1sra v\'e1rnak, mint [az \'cdr\'e1sban \'edg\'e9rt b\'fcntet\'e9s] bek\'f6vetkez\'e9s\'e9re? Azon a napon, amikor elj\'f6n a [a meg\'edg\'e9rt b\'fcntet\'e9s] bek\'f6vetkez\'e9se, azok, akik kor\'e1bban elfelejtett\'e9k, azt fogj\'e1
k mondani: \'84Urunk k\'fcld\'f6ttei az igazs\'e1ggal j\'f6ttek el. Vannak-e vajon sz\'e1munkra k\'f6zbenj\'e1r\'f3k, akik k\'f6zbenj\'e1rhatnak \'e9rt\'fcnk? Vagy visszavitethet\'fcnk-e (az evil\'e1gba), hogy m\'e1st cselekedj\'fcnk, mint amit cselekedt
\'fcnk?\'94 Bizony, elvesztett\'e9k magukat, \'e9s elt\'fbnik mell\'f5l\'fck az, amit kital\'e1ltak.
\par }{\insrsid10886557 
\par }{\insrsid15821247 54. Bizony, az Uratok Allah, aki megteremtette az egeket \'e9s a f\'f6ldet hat nap alatt, azut\'e1n elhelyezkedett (Hozz\'e1 m\'e9lt\'f3an) a Tr\'f3nuson. Bebor\'edtja [egym\'e1ssal] az \'e9jszak\'e1t \'e9s a nappalt, sietve k\'f6
vetik egym\'e1st szakadatlanul, \'e9s [megteremtette] a napot \'e9s a holdat, s a csillagokat; mind az \'d5 parancsa \'e1ltal van szolg\'e1latra rendelve. L\'e1m, \'d5t illeti meg a teremt\'e9s \'e9s a parancs. \'c1ldass\'e9k Allah, a teremtm\'e9nyek Ura!

\par 55. Foh\'e1szkodjatok az Uratokhoz, al\'e1zatosan \'e9s rejtetten! \'d5 bizony nem szereti a t\'falkap\'e1sokra vetemed\'f5ket.
\par 56. \'c9s ne okozzatok roml\'e1st [puszt\'edt\'e1st] a f\'f6ld\'f6n, annak megjav\'edt\'e1sa ut\'e1n! \'c9s hozz\'e1 foh\'e1szkodjatok f\'e9lve \'e9s rem\'e9lve! Bizony, Allah k\'f6ny\'f6r\'fclete k\'f6zel van }{\insrsid15821247\charrsid15553009 a j\'f3
tev\'f5kh\'f6z}{\insrsid15821247 !
\par }{\insrsid10886557 
\par }{\insrsid15821247 57. \'c9s \'d5 az, aki elk\'fcldi a szeleket \'f6r\'f6mh\'edrk\'e9nt, a k\'f6ny\'f6r\'fclete (az es\'f5) el\'f5tt. \'c9s amikor s\'falyos felh\'f5ket hordanak, akkor ezeket egy [sz\'e1razs\'e1gt\'f3l] halott helys\'e9gre hajtjuk, \'e9
s lebocs\'e1tjuk arra a vizet, \'e9s mindenf\'e9le term\'e9st hozunk el\'f5 \'e1ltala. Ekk\'e9ppen hozzuk el\'f5 a halottakat, h\'e1tha okultok [az int\'e9sb\'f5l].
\par 58. \'c9s a j\'f3 helys\'e9g n\'f6v\'e9nye [d\'fasan] j\'f6n el\'f5 Ura engedelm\'e9vel. \'c1m azon [a vid\'e9ken], amely rossz, ott csup\'e1n haszontalan gy\'e9r [n\'f6v\'e9nyzet] j\'f6n el\'f5. \'cdgy sorakoztatjuk fel a jeleket egy olyan n\'e9pnek,
 akik h\'e1l\'e1sak.
\par }{\insrsid10886557 
\par }{\insrsid15821247 59. Bizony, elk\'fcldt\'fck No\'e9t a n\'e9p\'e9hez, \'e9s azt mondta: \'84\'d3 n\'e9pem! Szolg\'e1lj\'e1tok Allahot! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten sz\'e1motokra Rajta k\'edv\'fcl! Bizony, \'e9n f\'e9
ltelek titeket egy hatalmas nap gy\'f6trelm\'e9t\'f5l.\'94
\par 60. Azt mondt\'e1k az el\'f5kel\'f5k a n\'e9p\'e9b\'f5l: \'84Bizony, mi azt l\'e1tjuk, hogy nyilv\'e1nval\'f3 t\'e9velyg\'e9sben vagy!\'94
\par 61. Azt mondta [No\'e9]: \'84\'d3 n\'e9pem! Egy\'e1ltal\'e1n nem vagyok t\'e9velyg\'e9sben, hanem \'e9n egy k\'fcld\'f6tt vagyok a teremtm\'e9nyek Ur\'e1t\'f3l.
\par 62. \'c1tadom nektek Uram \'fczeneteit, \'e9s tan\'e1csot adok nektek, \'e9s \'e9n tudom Allaht\'f3l azt, amit ti nem tudtok.
\par 63. }{\insrsid15821247\charrsid3674339 Vajon csod\'e1lkoztok azon, hogy eml\'e9keztet\'f5 j\'f6tt el hozz\'e1tok Uratokt\'f3l egy f\'e9rfi \'e1ltal k\'f6z\'fcletek az\'e9rt, hogy figyelmeztessen titeket, \'e9s hogy istenf\'e9l\'f5k legyetek, \'e9s h\'e1
tha k\'f6ny\'f6r\'fcletre leltek?}{\insrsid15821247 \'94
\par 64. \'c1m meghazudtolt\'e1k \'f5t, mi pedig megmentett\'fck \'f5t \'e9s azokat, akik vele voltak a b\'e1rk\'e1ban. \'c9s v\'edzbe fullasztottuk azokat, akik meghazudtolt\'e1k a jeleinket. Bizony, \'f5k egy vak n\'e9p voltak.
\par }{\insrsid10886557 
\par }{\insrsid15821247 65. \'c9s \'c1dhoz, az \'f5 testv\'e9r\'fcket, H\'fadot [k\'fcldt\'fck el]. Azt mondta: \'84\'d3, n\'e9pem! Szolg\'e1lj\'e1tok Allahot! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten sz\'e1motokra Rajta k\'edv\'fcl! Vajon h\'e1
t nem akartok istenf\'e9l\'f5k lenni?\'94
\par 66. }{\insrsid15821247\charrsid7166906 Azt mondt\'e1k az el\'f5kel\'f5k, akik }{\cf1\insrsid15821247\charrsid7166906 hitetlenn\'e9 v\'e1ltak}{\insrsid15821247\charrsid7166906  a n\'e9p\'e9b\'f5l:}{\insrsid15821247  \'84Bizony, mi azt l\'e1
tjuk, hogy te ostobas\'e1gban vagy, \'e9s mi bizony \'fagy v\'e9lj\'fck, hogy a hazugok k\'f6z\'fcl val\'f3 vagy!\'94
\par 67. Azt mondta [H\'fad]: \'84\'d3 n\'e9pem! Nincs bennem ostobas\'e1g, hanem k\'fcld\'f6tt vagyok \'e9n a teremtm\'e9nyek Ur\'e1t\'f3l.
\par 68. \'c1tadom nektek Uram \'fczeneteit, \'e9s megb\'edzhat\'f3 tan\'e1csad\'f3 vagyok a sz\'e1motokra.\'94
\par 69. H\'e1t vajon azon csod\'e1lkoztok, hogy eml\'e9keztet\'e9s j\'f6tt el hozz\'e1tok az Uratokt\'f3l egy k\'f6z\'fcletek val\'f3 f\'e9rfi \'e1ltal, hogy figyelmeztessen titeket? \'c9s eml\'e9kezzetek arra, amikor ut\'f3dokk\'e1 tett titeket No\'e9 n\'e9
pe ut\'e1n, \'e9s gyarap\'edtott titeket alkatban termetess\'e9ggel! S eml\'e9kezzetek Allah j\'f3t\'e9tem\'e9nyeire, h\'e1tha boldogultok!\'94
\par 70. Azt mondt\'e1k: \'84Vajon az\'e9rt j\'f6tt\'e9l el hozz\'e1nk, hogy egyed\'fcl Allahot szolg\'e1ljuk, \'e9s elhagyjuk azt, amit ap\'e1ink szolg\'e1ltak? Hozd h\'e1t ide azt [a b\'fcntet\'e9st], amit meg\'edg\'e9rt\'e9l nek\'fcnk, }{
\insrsid15821247\charrsid13044178 ha val\'f3ban az}{\insrsid15821247  igazmond\'f3k k\'f6z\'fcl val\'f3 vagy!\'94
\par 71. Azt mondta [H\'fad]: \'84Bizony, Uratokt\'f3l sz\'e1rmaz\'f3 b\'fcntet\'e9s \'e9s haragv\'e1s fog les\'fajtani r\'e1tok! Vajon vit\'e1ba akartok sz\'e1llni velem olyan nevekr\'f5l - amelyeket ti \'e9s aty\'e1
itok adtatok -, amelyekkel kapcsolatban Allah nem bocs\'e1tott le semmilyen bizony\'edt\'f3 \'e9rvet? V\'e1rakozzatok csak! Bizony, \'e9n is veletek vagyok a v\'e1rakoz\'f3k k\'f6z\'f6tt.\'94
\par 72. S megmentett\'fck \'f5t \'e9s azokat, akik vele voltak \endash  T\'f5l\'fcnk val\'f3 k\'f6ny\'f6r\'fclet \'e1ltal \endash  \'e9s kiirtottuk az utols\'f3 marad\'e9k\'e1t azoknak, akik meghazudtolt\'e1k a jeleinket, \'e9s nem voltak h\'edv\'f5k.
\par }{\insrsid10886557 
\par }{\insrsid15821247 73. \'c9s Tam\'fadhoz az \'f5 testv\'e9r\'fcket Sz\'e1lehot [k\'fcldt\'fck el]. Azt mondta: \'84\'d3 n\'e9pem! Szolg\'e1lj\'e1tok Allahot! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten sz\'e1motokra Rajta k\'edv\'fcl! Bizony, vil\'e1
gos bizony\'edt\'e9k j\'f6tt el hozz\'e1tok Uratokt\'f3l. Allahnak eme n\'f5st\'e9nytev\'e9je jel sz\'e1motokra! Engedj\'e9tek h\'e1t enni Allah f\'f6ldj\'e9n, \'e9s ne illess\'e9tek rosszal, mert akkor f\'e1jdalmas gy\'f6trelem ragad el titeket!
\par 74. \'c9s eml\'e9kezzetek, amikor ut\'f3dokk\'e1 tett titeket \'c1d [n\'e9pe] ut\'e1n, \'e9s lak\'f3helyet jel\'f6lt ki nektek a f\'f6ld\'f6n, melynek s\'edks\'e1gaib\'f3l palot\'e1kat k\'e9peztek, \'e9s a hegyekb\'f5l h\'e1zakat faragtatok ki! Eml\'e9
kezzetek Allah j\'f3t\'e9tem\'e9nyire, \'e9s ne j\'e1rjatok [gonoszul] a f\'f6ld\'f6n, roml\'e1st okozva!\'94
\par 75. Az el\'f5kel\'f5k, akik fennh\'e9j\'e1ztak a n\'e9p\'e9b\'f5l, azt mondt\'e1k azoknak, akik elnyom\'e1st szenvedtek \endash  k\'f6z\'fcl\'fck is azoknak, akik h\'edv\'f5k lettek: \'84Tudj\'e1tok-e, hogy Sz\'e1leh egy k\'fcld\'f6tt az \'f5 Ur\'e1t\'f3
l?\'94 Azt mondt\'e1k: \'84Mi bizony hisz\'fcnk abban, amivel elk\'fcldetett!\'94
\par 76. Azok, akik fennh\'e9j\'e1ztak, azt mondt\'e1k: \'84Mi bizony nem hisz\'fcnk abban, amiben ti hisztek!\'94
\par 77. Azt\'e1n elv\'e1gt\'e1k a n\'f5st\'e9nyteve l\'e1bin\'e1t, \'e9s g\'f5g\'f6sek voltak Uruk parancs\'e1val szemben. \'c9s azt mondt\'e1k: \'84\'d3 Sz\'e1leh! Hozd el\'f5 azt [a b\'fcntet\'e9st], amit meg\'edg\'e9rt\'e9l nek\'fcnk, }{
\insrsid15821247\charrsid4000812 ha val\'f3ban a}{\insrsid15821247  k\'fcld\'f6ttek k\'f6z\'fcl val\'f3 vagy!\'94
\par 78. \'c9s elragadta \'f5ket a f\'f6ldreng\'e9s, \'e9s reggelre t\'e9rd\'fckre esve fek\'fcdtek [holtan] a lakhely\'fck\'f6n.
\par 79. \'c9s elfordult t\'f5l\'fck \'e9s azt mondta: \'84\'d3 n\'e9pem! Bizony \'e1tadtam nektek Uram \'fczenet\'e9t, \'e9s tan\'e1csot adtam nektek, \'e1m ti nem szeretitek a tan\'e1csad\'f3kat.\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 80. \'c9s [eml\'edtsd meg] L\'f3tot, amikor azt mondta: \'84\'d3 n\'e9pem! Vajon [azt] a f\'f6rtelmes tettet k\'f6vetitek el, amelyben nem el\'f5z\'f6tt meg titeket senki sem a teremtm\'e9nyek k\'f6z\'fcl?
\par 81. Ti bizony [nemi] v\'e1gyt\'f3l hajtva k\'f6zeledtek a f\'e9rfiakhoz az asszonyok helyett! De ti egy m\'e9rt\'e9ktelen n\'e9p vagytok!\'94
\par 82. \'c9s nem volt a n\'e9p\'e9nek m\'e1s v\'e1lasza, csup\'e1n az, hogy \'edgy sz\'f3ltak: \'84\'dbzz\'e9tek ki \'f5ket a telep\'fcl\'e9setekr\'f5l! \'d5k olyan emberek, akik \'fcgyelnek a [b\'fbn\'f6kt\'f5l val\'f3] tisztas\'e1gukra.\'94
\par 83. \'c9s megmentett\'fck \'f5t \'e9s a csal\'e1dj\'e1t, kiv\'e9ve a feles\'e9g\'e9t. \'d5 azok k\'f6z\'fcl val\'f3 volt, akik h\'e1tramaradtak.
\par 84. [K\'f5-]es\'f5t z\'fad\'edtottunk r\'e1juk. N\'e9zd h\'e1t meg, milyen v\'e9gre jutottak a gonosztev\'f5k!
\par }{\insrsid10886557 
\par }{\insrsid15821247 85. \'c9s Midi\'e1nhoz testv\'e9r\'fcket Suajbot [k\'fcldt\'fck el]. Azt mondta: \'84\'d3 n\'e9pem! Szolg\'e1lj\'e1tok Allahot! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten sz\'e1motokra Rajta k\'edv\'fcl! Imm\'e1r vil\'e1gos bizony\'edt
\'e9k j\'f6tt el hozz\'e1tok Uratokt\'f3l! Tegy\'e9tek teljess\'e9 a kim\'e9r\'e9st \'e9s [haszn\'e1lj\'e1tok igazs\'e1gosan] a m\'e9rleget, \'e9s ne r\'f6vid\'edts\'e9tek meg az embereket a dolgaikban, \'e9s ne okozzatok roml\'e1st a f\'f6ld\'f6
n, annak megjav\'edt\'e1sa ut\'e1n! Ez jobb nektek}{\insrsid15821247\charrsid3489474 , ha val\'f3ban h\'edv\'f5k}{\insrsid15821247  vagytok!
\par 86. \'c9s ne \'fcljetek lesben minden \'faton fenyegetve [az emberek \'e9let\'e9t] \'e9s t\'e1vol tartva Allah \'datj\'e1t\'f3l azokat, akik hisznek abban, azt k\'edv\'e1nv\'e1n, hogy [az az \'fat] ferde legyen! \'c9s eml\'e9
kezzetek arra, amikor kevesen voltatok, \'e9s \'d5 megsokas\'edtott titeket. N\'e9zz\'e9tek h\'e1t meg, milyen v\'e9gre jutottak a roml\'e1st okoz\'f3k!
\par 87. \'c9s ha egy csoport k\'f6z\'fcletek hisz abban, amivel elk\'fcldettem, m\'edg egy m\'e1sik csoport nem hisz benne, akkor legyetek t\'fcrelemmel, am\'edg Allah \'edt\'e9lkezik k\'f6z\'f6tt\'fcnk! \'c9s \'d5 a legjobb az \'edt\'e9lkez\'f5k k\'f6z\'f6
tt!\'94
\par 88. Az el\'f5kel\'f5k, akik fennh\'e9j\'e1ztak a n\'e9p\'e9b\'f5l, azt mondt\'e1k: \'84\'d3 Suajb! Bizony, mi ki\'fbz\'fcnk t\'e9ged a }{\insrsid15821247\charrsid7166906 telep\'fcl\'e9s\'fcnkb\'f5l}{\insrsid15821247 , \'e9
s azokat is, akik hisznek veled egy\'fctt, vagy pedig visszat\'e9rsz a vall\'e1sunkba.\'94 Azt mondta [Suajb]: \'84Vajon akkor is, ha ut\'e1ljuk [azt]?
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15695841 {\insrsid15821247 89. Bizony, hazugs\'e1got tal\'e1ln\'e1nk ki Allah ellen, ha visszat\'e9rn\'e9nk a vall\'e1sotokba, miut\'e1
n Allah kimentett minket abb\'f3l. Mi pedig nem t\'e9rhet\'fcnk vissza abba, kiv\'e9ve [akkor], ha Allah, az Urunk [azt] akarja. Urunk \'e1tfog mindent tud\'e1ssal. Allahra hagyatkozunk. Urunk! D\'f6nts k\'f6zt\'fcnk \'e9s a n\'e9p\'fcnk k\'f6z\'f6
tt az igazs\'e1g }{\insrsid15821247\charrsid15695841 szerint! \'c9s Te vagy a legjobb a}{\insrsid10301723\charrsid15695841  d\'f6nt\'f5k k\'f6z\'f6tt}{\insrsid15821247\charrsid15695841 !\'94}{\insrsid15821247 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15821247 {\insrsid15821247 90. \'c9s az el\'f5kel\'f5k, akik hitetlenn\'e9 v\'e1ltak az \'f5 n\'e9p\'e9b\'f5l azt mondt\'e1k: \'84Ha Suajbot k\'f6
vetitek, akkor bizony vesztesek lesztek!\'94
\par 91. \'c9s elragadta \'f5ket a f\'f6ldreng\'e9s, \'e9s reggelre t\'e9rd\'fckre esve fek\'fcdtek [holtan] a lakhely\'fck\'f6n.
\par 92. Akik meghazudtolt\'e1k Suajbot [\'fagy pusztultak el], mintha soha sem lakoztak volna ott j\'f3l\'e9tben. Akik meghazudtolt\'e1k Suajbot, bizony \'f5k a vesztesek.}{\insrsid10886557 
\par }{\insrsid15821247 93. \'c9s elfordult t\'f5l\'fck \'e9s azt mondta: \'84\'d3 n\'e9pem! Bizony, \'e9n \'e1tadtam nektek Uram \'fczeneteit, \'e9s tan\'e1csot adtam nektek. H\'e1t hogyan sajn\'e1lkozhatn\'e9k egy hitetlen n\'e9p miatt?\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 94. \'c9s nem k\'fcldt\'fcnk el egyetlen telep\'fcl\'e9sre sem pr\'f3f\'e9t\'e1t an\'e9lk\'fcl, hogy ne ragadtuk volna el lak\'f3it nyomor\'fas\'e1ggal \'e9s bajjal, h\'e1tha al\'e1zatosan foh\'e1szkodnak.
\par 95. Ezut\'e1n a rossz [\'e1llapot] hely\'e9be j\'f3t cser\'e9lt\'fcnk, addig am\'edg nem b\'f5velkedtek [vagyonban \'e9s gyermekekben]. \'c1m azt mondt\'e1k: \'84Ap\'e1inkat is \'e9rte m\'e1r baj \'e9s j\'f3l\'e9t is!\'94, \'edgy v\'e1
ratlanul ragadtuk el \'f5ket, mik\'f6zben \'f5k \'e9szre sem vett\'e9k.
\par }{\insrsid10886557 
\par }{\insrsid15821247 96. \'c9s ha a telep\'fcl\'e9sek lak\'f3i hittek volna, \'e9s istenf\'e9l\'f5k lettek volna, akkor \'e1ld\'e1sokat \'e1rasztottunk volna r\'e1juk az \'e9gb\'f5l \'e9s a f\'f6ldb\'f5l. \'c1m \'f5k meghazudtolt\'e1k [a k\'fcld\'f6
tteket], s elragadtuk \'f5ket az\'e9rt, amit szereztek.
\par 97. Vajon biztons\'e1gban \'e9rzik magukat a telep\'fcl\'e9sek lak\'f3i azzal szemben, hogy elj\'f6n hozz\'e1juk a csap\'e1sunk \'e9jszaka, mialatt alszanak?
\par 98. Vagy vajon biztons\'e1gban \'e9rzik magukat a telep\'fcl\'e9sek lak\'f3i azzal szemben, hogy elj\'f6n hozz\'e1juk a csap\'e1sunk d\'e9lel\'f5tt, mialatt j\'e1tszadoznak?
\par 99. Vajon biztons\'e1gban \'e9rzik magukat }{\insrsid15821247\charrsid7287338 Allah terv\'e9vel szemben? Nem \'e9rzi mag\'e1t biztons\'e1gban Allah te}{\insrsid15821247 rv\'e9vel szemben, csup\'e1n a vesztes n\'e9p.
\par 100. H\'e1t vajon nem lett vil\'e1gos azok sz\'e1m\'e1ra, akik a f\'f6ldet \'f6r\'f6k\'f6lt\'e9k \endash  az el\'f5z\'f5 lak\'f3i ut\'e1n \endash  hogy ha akarjuk, akkor [b\'fcntet\'e9s\'fcnkkel] s\'fajtan\'e1nk \'f5ket a b\'fbneik [miatt]? \'c1m lepecs
\'e9telj\'fck a sz\'edv\'fcket, \'e9s \'edgy \'f5k nem hallj\'e1k meg [az int\'f5 sz\'f3t].}{\cf1\insrsid15821247 
\par 101. \'cdme, ezek a telep\'fcl\'e9sek, amelyek h\'edreib\'f5l n\'e9h\'e1nyat elbesz\'e9l\'fcnk neked}{\cf1\insrsid15821247\charrsid8145152 . \'c9s bizony m\'e1r elj\'f6ttek}{\cf1\insrsid15821247  hozz\'e1juk az \'f5 k\'fcld\'f6tteik a vil\'e1gos bizony
\'edt\'e9kokkal, \'e1m \'f5k soha nem hittek volna abban, amit kor\'e1bban [m\'e1r] meghazudtoltak. Ekk\'e9ppen pecs\'e9teli le Allah a hitetlenek sz\'edv\'e9t.}{\insrsid15821247 
\par 102. \'c9s nem tal\'e1ltuk a legt\'f6bbj\'fcket [h\'fbs\'e9gesnek] az egyezs\'e9g\'fckh\'f6z, \'e9s bizony legt\'f6bbj\'fcket engedetlennek tal\'e1ltuk.
\par }{\insrsid10886557 
\par }{\insrsid15821247 103}{\insrsid15821247\charrsid8328127 . Majd}{\insrsid15821247  elk\'fcldt\'fck ut\'e1nuk M\'f3zest a jeleinkkel a F\'e1ra\'f3hoz \'e9s az el\'f5kel\'f5ihez, \'f5k pedig igazs\'e1gtalanul megtagadt\'e1k azokat. N\'e9zd h\'e1
t meg, milyen v\'e9gre jutottak a roml\'e1st okoz\'f3k!
\par 104. \'c9s azt mondta M\'f3zes: \'84\'d3 F\'e1ra\'f3! Bizony \'e9n k\'fcld\'f6tt vagyok a teremtm\'e9nyek Ur\'e1t\'f3l!
\par 105. Az a m\'e9lt\'f3 hozz\'e1m, hogy ne mondjak m\'e1st Allahr\'f3l, csup\'e1n az igazs\'e1got. Bizony, nyilv\'e1nval\'f3 bizony\'edt\'e9kkal j\'f6ttem el hozz\'e1tok Uratokt\'f3l. K\'fcldd h\'e1t el velem Izrael fiait!\'94
\par 106. Azt mondta [a F\'e1ra\'f3]: \'84Ha jellel j\'f6tt\'e9l el [ahogyan \'e1ll\'edtod], akkor hozd el\'f5, }{\insrsid15821247\charrsid8145152 ha val\'f3ban}{\insrsid15821247  az igazmond\'f3k k\'f6z\'fcl val\'f3 vagy!\'94
\par 107. \'c9s [M\'f3zes] eldobta a botj\'e1t, \'e9s \'edme, az egy nyilv\'e1nval\'f3 (val\'f3s\'e1gos) k\'edgy\'f3 lett.
\par 108. \'c9s kih\'fazta a kez\'e9t, \'e9s \'edme, az feh\'e9r lett azok el\'f5tt, akik n\'e9zt\'e9k.
\par }{\insrsid10886557 
\par }{\insrsid15821247 109. Az el\'f5kel\'f5k a F\'e1ra\'f3 n\'e9p\'e9b\'f5l azt mondt\'e1k: \'84Bizony, ez egy nagy tud\'e1s\'fa var\'e1zsl\'f3!
\par 110. Ki akar \'fbzni titeket a f\'f6ldetekr\'f5l.\'94 [A F\'e1ra\'f3 azt mondta:] \'84Mit tan\'e1csoltok h\'e1t?\'94
\par 111. Azt mondt\'e1k: \'84Halaszd el az \'f5 \'e9s a testv\'e9re \'fcgy\'e9t! \'c9s k\'fcldj a v\'e1rosokba toboroz\'f3kat,
\par 112. Hogy el\'e9d hozz\'e1k az \'f6sszes nagy tud\'e1s\'fa var\'e1zsl\'f3t!\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 113. \'c9s elj\'f6ttek a var\'e1zsl\'f3k a F\'e1ra\'f3hoz. Azt mondt\'e1k: \'84Vajon lesz-e fizets\'e9g\'fcnk, ha mi lesz\'fcnk a gy\'f5zelmet arat\'f3k?\'94
\par 114. Azt mondta [a F\'e1ra\'f3]: \'84Igen! \'c9s ti bizony a [hozz\'e1nk] k\'f6zel\'e1ll\'f3k k\'f6z\'e9 fogtok tartozni.\'94
\par 115. Azt mondt\'e1k [a var\'e1zsl\'f3k]: \'84\'d3 M\'f3zes! Vagy te dobsz, vagy mi lesz\'fcnk azok, akik dobnak!\'94
\par 116. Azt mondta [M\'f3zes]: \'84Dobjatok!\'94 \'c9s miut\'e1n dobtak, megb\'fbv\'f6lt\'e9k az emberek szem\'e9t, \'e9s f\'e9lelmet keltettek benn\'fck, \'e9s hatalmas var\'e1zslattal j\'f6ttek el\'f5.
\par 117. \'c9s azt sugalltuk M\'f3zesnek: \'84Dobd el a botodat!\'94 S \'edme, az m\'e1r el is nyelte azt, ami hazugs\'e1got kital\'e1ltak.
\par 118. \'c9s bek\'f6vetkezett az igazs\'e1g, \'e9s semmiv\'e9 v\'e1lt, amit \'f5k cselekedtek.
\par 119. Legy\'f5zettek ott [a var\'e1zsl\'f3k], \'e9s megal\'e1zottan vonultak vissza [a F\'e1ra\'f3 \'e9s a k\'f6vet\'f5i].
\par 120. A var\'e1zsl\'f3k pedig leborulva vetett\'e9k [magukat] a f\'f6ldre,
\par 121. Azt mondv\'e1n: \'84Hisz\'fcnk a teremtm\'e9nyek Ur\'e1ban,
\par 122. M\'f3zes \'e9s \'c1ron Ur\'e1ban!\'94
\par 123. A F\'e1ra\'f3 azt mondta: \'84Hittetek benne, miel\'f5tt enged\'e9lyt adtam volna r\'e1 nektek? Bizony cselsz\'f6v\'e9s ez, amit a v\'e1rosban eszeltetek ki, hogy ki\'fbzz\'e9tek abb\'f3l a lak\'f3it. Meg fogj\'e1tok tudni!
\par 124. Bizony lev\'e1gom a kezeteket \'e9s a l\'e1batokat [egym\'e1ssal] ellent\'e9tesen, majd bizony felfesz\'edtelek titeket, mindny\'e1jatokat!
\par 125. Azt mondt\'e1k: \'84Bizony, mi az Urunkhoz t\'e9r\'fcnk vissza!
\par 126. \'c9s te }{\insrsid15821247\charrsid8328127 csup\'e1n az\'e9rt \'e1llsz bossz\'fat rajtunk, mert mi h}{\insrsid15821247 itt\'fcnk Urunk jeleiben, miut\'e1n azok elj\'f6ttek hozz\'e1nk. Urunk! T\'f6lts el minket t\'fcrelemmel \'e9s [Neked] al\'e1
vetettekk\'e9nt sz\'f3l\'edts magadhoz minket!\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 127. \'c9s azt mondt\'e1k az el\'f6lj\'e1r\'f3k a F\'e1ra\'f3 n\'e9p\'e9b\'f5l: \'84Vajon hagyod, hogy M\'f3zes \'e9s a n\'e9pe roml\'e1st okozzon a f\'f6ld\'f6n, \'e9s elhagyjon t\'e9ged \'e9s az isteneidet?\'94 Azt mondta [a F\'e1ra
\'f3]: \'84Meg\'f6lj\'fck fiaikat \'e9s \'e9letben hagyjuk asszonyaikat, \'e9s bizony, mi legy\'f5zhetetlen [hatalommal b\'edrunk] felett\'fck!\'94
\par 128. M\'f3zes [pedig] azt mondta n\'e9p\'e9nek: \'84Allahot k\'e9rj\'e9tek seg\'edts\'e9g\'fcl, \'e9s legyetek kitart\'f3ak! Bizony, a f\'f6ld Allah\'e9, annak adja \'f6r\'f6k\'fcl, akinek akarja az \'d5 szolg\'e1i k\'f6z\'fcl. \'c9s a [j\'f3] v\'e9
g az istenf\'e9l\'f5k\'e9.\'94
\par 129. \'d5k azt mondt\'e1k: \'84B\'e1ntalmaz\'e1s \'e9rt minket, miel\'f5tt elj\'f6tt\'e9l hozz\'e1nk, \'e9s azut\'e1n is, hogy meg\'e9rkezt\'e9l.\'94 Azt mondta [M\'f3zes]: \'84Lehet, hogy Uratok elpuszt\'edtja az ellens\'e9geiteket, \'e9s titeket l\'e9
ptet a hely\'fckbe ut\'f3dk\'e9nt a f\'f6ld\'f6n, \'e9s megn\'e9zi, }{\insrsid15821247\charrsid8145152 hogyan cselekszetek.\'94}{\insrsid15821247 
\par }{\insrsid10886557 
\par }{\insrsid15821247 130. \'c9s bizony les\'fajtottunk a F\'e1ra\'f3 n\'e9p\'e9re sz\'e1razs\'e1ggal \'e9s a term\'e9sek hi\'e1ny\'e1val, h\'e1tha okulnak [az int\'e9sb\'f5l].
\par 131. \'c9s amikor j\'f3 j\'f6tt el hozz\'e1juk, azt mondt\'e1k: \'84Ez kij\'e1r nek\'fcnk.\'94 Ha pedig rossz \'e9rte \'f5ket, akkor M\'f3zesben \'e9s azokban, akik vele voltak, rossz el\'f5jelet l\'e1ttak. L\'e1m, bizony a rossz el\'f5jel\'fck [ami \'e9
rte \'f5ket] csup\'e1n Allaht\'f3l van (az \'d5 elrendel\'e9s\'e9b\'f5l), de a legt\'f6bbj\'fck nem rendelkezik tud\'e1ssal.
\par 132. \'c9s azt mondt\'e1k: \'84B\'e1rmilyen jelet is hozol el nek\'fcnk, hogy megb\'fbv\'f6lj \'e1ltala minket, h\'e1t akkor sem hisz\'fcnk neked!\'94
\par 133. \'c9s [ezut\'e1n] elk\'fcldt\'fck r\'e1juk az \'f6z\'f6nvizet, a s\'e1sk\'e1kat, a tetveket, a b\'e9k\'e1kat \'e9s a v\'e9rt jelekk\'e9nt, egym\'e1st\'f3l megk\'fcl\'f6nb\'f6ztetve, \'e1m \'f5k fennh\'e9j\'e1ztak, \'e9s gonosztev\'f5 n\'e9p voltak.

\par 134. Miut\'e1n pedig b\'fcntet\'e9s \'e9rte \'f5ket, azt mondt\'e1k: \'84\'d3 M\'f3zes! Foh\'e1szkodj \'e9rt\'fcnk az Uradhoz a sz\'f6vets\'e9g alapj\'e1n, amelyet veled k\'f6t\'f6tt! Ha elh\'e1r\'edtod r\'f3lunk a b\'fcntet\'e9st, mi hinni fogunk neked 
\'e9s el fogjuk k\'fcldeni veled Izrael fiait.\'94
\par 135. \'c1m miut\'e1n elh\'e1r\'edtottuk r\'f3luk a b\'fcntet\'e9st egy hat\'e1rid\'f5ig, amit el kellett \'e9rni\'fck, \'edme \'f5k megszegt\'e9k [az \'edg\'e9retet].
\par 136. \'c9s el\'e9gt\'e9telt vett\'fcnk rajtuk \'e9s a tengerbe fullasztottuk \'f5ket, mivel meghazudtolt\'e1k a jeleinket, \'e9s figyelmen k\'edv\'fcl hagyt\'e1k azokat.
\par }{\insrsid10886557 
\par }{\insrsid15821247 137. \'c9s annak a n\'e9pnek, akik elnyom\'e1st szenvedtek, \'f6r\'f6k\'fcl adtuk a f\'f6ld keleti \'e9s nyugati t\'e1jait, amelyeket meg\'e1ldottunk. \'c9s az Urad legszebb szava teljesedett be Izrael fiain amiatt, hogy t\'fc
relmesek voltak. \'c9s romba d\'f6nt\'f6tt\'fck azt, amit a F\'e1ra\'f3 \'e9s a n\'e9pe m\'fbvelt, \'e9s azt, ami [\'e9p\'edtm\'e9nyeket] a magasba emeltek.
\par }{\insrsid10886557 
\par }{\insrsid15821247 138. \'c9s \'e1tvezett\'fck Izrael fiait a tengeren. Egy olyan n\'e9phez \'e9rtek el}{\insrsid15821247\charrsid14025172 , akik b\'e1lv\'e1nyaiknak adt\'e1k \'e1t magukat.}{\insrsid15821247  Azt mondt\'e1k: \'84\'d3 M\'f3zes! K\'e9sz\'ed
ts nek\'fcnk istens\'e9get, ahogyan nekik is vannak istens\'e9geik!\'94 Azt mondta [M\'f3zes]: \'84Bizony, ti egy olyan n\'e9p vagytok, akik tudatlanok!
\par 139. Bizony pusztul\'e1sra van \'edt\'e9lve az, amiben \'f5k vannak \'e9s hi\'e1baval\'f3 az, amit cselekszenek.\'94
\par 140. Azt mondta [M\'f3zes]: \'84Vajon ne Allahot, hanem m\'e1s istent keressek nektek, mik\'f6zben \'d5 el\'f5nyben r\'e9szes\'edtett titeket a teremtm\'e9nyekkel szemben?\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 141. \'c9s [eml\'e9kezzetek arra], amikor megmentett\'fcnk titeket a F\'e1ra\'f3 embereit\'f5l, [akik] sz\'f6rny\'fb gy\'f6trelemmel s\'fajtottak titeket, meg\'f6lt\'e9k a fiaitokat \'e9s \'e9letben hagyt\'e1
k asszonyaitokat! Bizony ebben hatalmas megpr\'f3b\'e1ltat\'e1s van sz\'e1motokra az Uratokt\'f3l.
\par }{\insrsid10886557 
\par }{\insrsid15821247 142. \'c9s M\'f3zesnek harminc \'e9jszak\'e1t jel\'f6lt\'fcnk ki [a Vel\'fcnk val\'f3 tal\'e1lkoz\'e1sra], amit kieg\'e9sz\'edtett\'fcnk t\'edzzel, \'e9s \'edgy az Ura \'e1ltal kiszabott id\'f5 negyven \'e9jszaka lett. \'c9
s azt mondta M\'f3zes a testv\'e9r\'e9nek, \'c1ronnak: \'84Legy\'e9l a helyettesem a n\'e9pem k\'f6z\'f6tt, \'e9s tereld [\'f5ket] a javul\'e1s fel\'e9, \'e9s ne k\'f6vesd a roml\'e1st okoz\'f3k \'fatj\'e1t!\'94
\par 143. Miut\'e1n M\'f3zes elj\'f6tt az \'e1ltalunk kijel\'f6lt id\'f5pontban [hogy tal\'e1lkozzon Vel\'fcnk], \'e9s besz\'e9lt hozz\'e1 az Ura, azt mondta [M\'f3zes]: \'84Uram! Mutasd meg nekem [Magad], hadd n\'e9zhessek R\'e1d!\'94 [Allah] azt mondta: \'84
Nem l\'e1thatsz Engem, de n\'e9zz a hegyre, ha szil\'e1rdan a hely\'e9n marad, akkor l\'e1tni fogsz Engem!\'94 \'c1m amikor az Ura felfedte mag\'e1t a hegynek, porr\'e1 z\'fazta azt, \'e9s M\'f3zes a f\'f6ldre rogyott \'e1jultan. Miut\'e1n mag\'e1hoz t
\'e9rt, azt mondta: \'84Magasztaltass\'e1l! B\'fbnb\'e1nattal fordulok Hozz\'e1d, \'e9s \'e9n vagyok az els\'f5, aki h\'edv\'f5 lett.\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 144. Azt mondta [Allah]: \'84\'d3 M\'f3zes! Bizony, \'e9n t\'e9ged v\'e1lasztottalak az emberek f\'f6l\'e9 az \'fczeneteimmel, \'e9s a [hozz\'e1d val\'f3] besz\'e9demmel. Vedd h\'e1t, amit adtam neked, \'e9s tartozz a h\'e1l\'e1sak k
\'f6z\'e9!\'94
\par 145. \'c9s a t\'e1bl\'e1kra \'edrtunk neki int\'e9st minden dologgal kapcsolatban \'e9s r\'e9szletes magyar\'e1zatot minden dologra [ami sz\'fcks\'e9ges]. Ragadd h\'e1t meg er\'f5sen, \'e9s parancsold meg a n\'e9pednek, hogy a legjobbat tegy\'e9k meg abb
\'f3l! Meg fogom mutatni nektek az engedetlenek lakhely\'e9t.
\par }{\insrsid10886557 
\par }{\insrsid15821247 146. El fogom ford\'edtani a jeleimt\'f5l azokat, akik jogtalanul fennh\'e9j\'e1znak a f\'f6ld\'f6n. Ha megl\'e1tnak minden jelet, nem hisznek azokban. \'c9s ha megl\'e1tj\'e1k a helyes utat, nem v\'e1lasztj\'e1k azt \'fatnak a maguk sz
\'e1m\'e1ra. \'c1m ha megl\'e1tj\'e1k a t\'e9velyg\'e9s \'fatj\'e1t, azt v\'e1lasztj\'e1k \'fatnak maguknak. Ez az\'e9rt van, mert \'f5k meghazudtolt\'e1k a jeleinket, \'e9s figyelmen k\'edv\'fcl hagyt\'e1k azokat.
\par 147. \'c9s azok, akik meghazudtolt\'e1k a jeleinket \'e9s a tal\'e1lkoz\'e1st a T\'falvil\'e1gon, azoknak szertefoszlanak a tetteik. Vajon [mi m\'e1s\'e9rt] kapnak fizets\'e9get, mint amit cselekedtek?
\par }{\insrsid10886557 
\par }{\insrsid15821247 148. \'c9s M\'f3zes n\'e9pe \endash  az \'f5 t\'e1voll\'e9t\'e9ben \endash  [isten\'fckk\'e9] tettek egy, az \'e9kszereikb\'f5l [k\'e9sz\'edtett] testtel b\'edr\'f3 borj\'fat, amelynek b\'f5g\'f5
 [hangja] volt. Vajon nem gondolkodtak-e el azon, hogy az nem besz\'e9l hozz\'e1juk, \'e9s nem vezeti semmilyen \'faton \'f5ket? \'c1m [isten\'fckk\'e9] tett\'e9k azt \'e9s igazs\'e1gtalanok voltak.
\par 149. Amikor pedig megb\'e1nt\'e1k, \'e9s l\'e1tt\'e1k, hogy elt\'e9velyedtek, azt mondt\'e1k: \'84Ha nem k\'f6ny\'f6r\'fcl meg rajtunk az Urunk \'e9s nem bocs\'e1t meg nek\'fcnk, akkor mi a vesztesek k\'f6z\'e9 fogunk tartozni.\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 150. \'c9s miut\'e1n M\'f3zes haragosan \'e9s szomor\'faan ment vissza a n\'e9p\'e9hez, azt mondta: \'84Milyen rossz az, ahogyan helyettes\'edtettetek engem a t\'e1voll\'e9temben! Vajon s\'fcrgetni akart\'e1tok Uratok d\'f6nt\'e9s\'e9
t? \'c9s ledobta a t\'e1bl\'e1kat \'e9s megragadta testv\'e9re (\'c1ron) fej\'e9t, mag\'e1hoz h\'fazv\'e1n. [\'c1ron] azt mondta: \'84Any\'e1m fia! Bizony, a n\'e9p elnyomott engem \'e9s majdnem meg\'f6lt. \'c9s ne hagyd, hogy az ellens\'e9gek k\'e1r\'f6
rvendezzenek rajtam, \'e9s ne helyezz engem [a haragv\'e1soddal s\'fajtott] igazs\'e1gtalan n\'e9p k\'f6z\'e9!\'94
\par 151. Azt mondta [M\'f3zes]: \'84Uram! Bocs\'e1ss meg nekem \'e9s a testv\'e9remnek! Bocs\'e1ss be minket a Te k\'f6ny\'f6r\'fcletess\'e9gedbe! Hiszen Te vagy a legk\'f6ny\'f6r\'fcletesebb a k\'f6ny\'f6r\'fcletesek k\'f6z\'f6tt.\'94
\par 152. Bizony azok, akik [isten\'fckk\'e9] tett\'e9k a borj\'fat, azokat haragv\'e1s fogja s\'fajtani az Urukt\'f3l \'e9s megal\'e1ztat\'e1s az evil\'e1gi \'e9letben. \'c9s mi ekk\'e9ppen fizet\'fcnk meg azoknak, akik [hazugs\'e1got] tal\'e1lnak ki [ellen
\'fcnk].
\par 153. \'c1m azok, akik rossz tetteket k\'f6vettek el, majd azok ut\'e1n b\'fbnb\'e1natot tan\'fas\'edtottak \'e9s hittek, bizony azut\'e1n az Urad Megbocs\'e1t\'f3, Irgalmas.
\par }{\insrsid10886557 
\par }{\insrsid15821247 154. Miut\'e1n lecsillapodott M\'f3zes haragja, felvette a t\'e1bl\'e1kat. \'c9s azok sz\'f6veg\'e9ben \'fatmutat\'e1s \'e9s k\'f6ny\'f6r\'fclet volt azok sz\'e1m\'e1ra, akik az Urukt\'f3l rettegnek.
\par 155. \'c9s M\'f3zes kiv\'e1lasztott hetven f\'e9rfit a n\'e9p\'e9b\'f5l az \'e1ltalunk kijel\'f6lt id\'f5pontban [hogy tal\'e1lkozzanak Vel\'fcnk]. \'c9s miut\'e1n elragadta \'f5ket a f\'f6ldreng\'e9s, azt mondta [M\'f3zes]: \'84
Uram! Ha akartad volna, akkor m\'e1r kor\'e1bban elpuszt\'edtottad volna \'f5ket \'e9s engem is. Vajon elpuszt\'edtan\'e1l minket amiatt, amit az ostob\'e1k tettek k\'f6z\'fcl\'fcnk? Ez bizony csup\'e1n a te k\'eds\'e9rt\'e9sed, azt viszed \'e1ltala t\'e9
velyg\'e9sbe, akit akarsz, \'e9s azt vezetsz igaz \'fatra, akit akarsz. Te vagy a mi p\'e1rtfog\'f3nk. Bocs\'e1ss h\'e1t meg nek\'fcnk, \'e9s k\'f6ny\'f6r\'fclj rajtunk! }{\insrsid15821247\charrsid14025172 Te vagy a legjobb a megbocs\'e1t\'f3k k\'f6z\'f6
tt!}{\insrsid15821247 
\par 156. \'c9s \'edrj meg nek\'fcnk j\'f3t ezen a vil\'e1gon \'e9s a t\'falvil\'e1gon! Bizony, Hozz\'e1d t\'e9r\'fcnk vissza [b\'fbnb\'e1nattal]!\'94 [Allah] azt mondta: \'84A gy\'f6trelmemmel azt s\'fajtom, akit akarok. \'c9s a k\'f6ny\'f6r\'fc
letem minden dolgot \'e1tfog. \'c9s azoknak fogom meg\'edrni, akik istenf\'e9lelmet tan\'fas\'edtanak \'e9s megadj\'e1k a k\'f6telez\'f5 adom\'e1nyt, \'e9s akik hisznek jeleinkben.\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 157. Akik k\'f6vetik a k\'fcld\'f6ttet, az \'edr\'e1studatlan pr\'f3f\'e9t\'e1t, akit meg\'edrva tal\'e1lnak \'f5n\'e1luk a T\'f3r\'e1ban \'e9s az Evang\'e9liumban, aki felsz\'f3l\'edtja \'f5ket a hely\'e9nval\'f3
ra, megtiltja nekik az elvetend\'f5t, \'e9s megengedi nekik a j\'f3 dolgokat \'e9s tilalmass\'e1 teszi nekik a rosszakat, \'e9s leveszi r\'f3luk a terheiket \'e9s a bilincseket, amelyek rajtuk voltak. \'c9s akik hisznek benne, t\'e1mogatj\'e1k, megseg\'ed
tik \'e9s k\'f6vetik a vil\'e1goss\'e1got (a Kor\'e1nt), ami lebocs\'e1ttatott vele, \'f5k }{\insrsid12204078 bizony }{\insrsid15821247 azok, akik boldogulnak!
\par 158. Mondd [\'f3 Mohamed]: \'84\'d3 emberek! Bizony, \'e9n Allah K\'fcld\'f6tte vagyok hozz\'e1tok, mindny\'e1jatokhoz, annak [a k\'fcld\'f6tte], aki\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett. Nincs m\'e1s [jogosan im\'e1dhat\'f3
] isten, csak \'d5! \'d5 kelt \'e9letre \'e9s \'d5 k\'fcld hal\'e1lba. Higgyetek Allahban \'e9s a k\'fcld\'f6tt\'e9ben \endash  az \'edr\'e1studatlan pr\'f3f\'e9t\'e1ban \endash  aki hisz Allahban \'e9s az \'d5 szavaiban, \'e9s k\'f6vess\'e9tek \'f5t, h
\'e1tha az igaz \'fatra leltek!
\par }{\insrsid10886557 
\par }{\insrsid15821247 159. M\'f3zes n\'e9pe k\'f6z\'f6tt van egy k\'f6z\'f6ss\'e9g, akik az igazs\'e1gnak megfelel\'f5en vezetnek az igaz \'fatra \'e9s aszerint \'edt\'e9lkeznek.
\par 160. \'c9s felosztottuk \'f5ket tizenk\'e9t t\'f6rzsre \endash  k\'f6z\'f6ss\'e9gekre \endash  \'e9s azt sugalltuk M\'f3zesnek, amikor n\'e9pe v\'edz\'e9rt folyamodott hozz\'e1: \'84\'dcss a botoddal a k\'f5re!\'94 Akkor tizenk\'e9t forr\'e1s fakadt abb
\'f3l, \'e9s tudta m\'e1r minden embercsoport, hol van az iv\'f3helye, majd \'e1rny\'e9kot bor\'edtottunk r\'e1juk a felh\'f5kkel, \'e9s mann\'e1t \'e9s f\'fcrjeket bocs\'e1tottuk le nekik [mondv\'e1n]: \'84Egyetek azokb\'f3l a j\'f3 dolgokb\'f3
l, amelyekkel ell\'e1ttunk titeket!\'94 \'c1m nem ellen\'fcnk k\'f6vettek el igazs\'e1gtalans\'e1got, hanem \'f6nmagukkal voltak igazs\'e1gtalanok.
\par 161. \'c9s }{\insrsid15821247\charrsid14025172 [eml\'edtsd}{\insrsid15821247  meg], amikor az mondatott nekik: \'84Lakjatok ezen a telep\'fcl\'e9sen (Jeruzs\'e1lemben) \'e9s ahol csak akartok, egyetek abb\'f3l (a term\'e9seib\'f5l), s mondj\'e1tok: \'84
Vedd le [r\'f3lunk a v\'e9tkeinket]!\'94}{\cf6\insrsid15821247  }{\insrsid15821247 \'e9s l\'e9pjetek be a kapun al\'e1zattal [\'e9s boruljatok le al\'e1zattal]! Megbocs\'e1tjuk nektek v\'e9tkeiteket \'e9s t\'f6bbet fogunk adni }{
\insrsid15821247\charrsid15749051 a j\'f3tev\'f5knek}{\insrsid15821247 .\'94
\par 162. \'c1m akik igazs\'e1gtalans\'e1got k\'f6vettek el, m\'e1s besz\'e9dre cser\'e9lt\'e9k azt, ami mondva lett nekik. \'c9s b\'fcntet\'e9st k\'fcldt\'fcnk le r\'e1juk az \'e9gb\'f5l amiatt, hogy igazs\'e1gtalanok voltak.
\par }{\insrsid10886557 
\par }{\insrsid15821247 163. K\'e9rdezd h\'e1t meg \'f5ket arr\'f3l a telep\'fcl\'e9sr\'f5l, amely a tenger mellett fek\'fcdt, [hogy mi t\'f6rt\'e9nt vel\'fck], amikor t\'falkap\'e1sra vetemedtek a szombattal kapcsolatban! [Eml\'edtsd meg], amikor a halak a v
\'edz sz\'edn\'e9n nagy sz\'e1mban megjelenve j\'f6ttek el hozz\'e1juk azon a napon, amikor }{\insrsid15821247\charrsid15749051 szombatot tartottak. \'c1m azon a napon, amikor}{\insrsid15821247  nem tartottak szombatot, nem j\'f6ttek el hozz\'e1juk. Ekk
\'e9ppen tessz\'fck \'f5ket pr\'f3b\'e1ra amiatt, hogy engedetlenek voltak.
\par }{\insrsid10886557 
\par }{\insrsid15821247 164. \'c9s }{\insrsid15821247\charrsid14025172 [eml\'edtsd}{\insrsid15821247  meg,] amikor egy k\'f6z\'f6ss\'e9g (csoport) k\'f6z\'fcl\'fck azt mondta: \'84Mi\'e9rt intetek egy olyan n\'e9pet, akiket Allah el fog puszt\'ed
tani, vagy meg fog b\'fcntetni s\'falyos gy\'f6trelemmel?\'94 Azt mondt\'e1k: \'84Hogy legyen ments\'e9g\'fcnk az Uratokn\'e1l, \'e9s h\'e1tha istenf\'e9l\'f5k lesznek.\'94
\par 165. \'c1m amikor elfeledt\'e9k azt, amire eml\'e9keztetve lettek, megmentett\'fck azokat, akik megtiltott\'e1k a rossz tettet, \'e9s nyomor\'fas\'e1gos gy\'f6trelemmel [s\'fajtva] ragadtuk el azokat, akik igazs\'e1gtalans\'e1got k\'f6
vettek el, amiatt, hogy engedetlenek voltak.
\par 166. \'c9s miut\'e1n g\'f5g\'f6sen [ragaszkodtak] ahhoz, ami megtiltatott nekik, azt mondtuk nekik: \'84Legyetek megvetett majmok!\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 167. \'c9s }{\insrsid15821247\charrsid15210570 [eml\'edtsd}{\insrsid15821247  meg,] amikor az Urad kihirdette, hogy a Felt\'e1mad\'e1s napj\'e1ig olyanokat t\'e1maszt ellen\'fck, akik sz\'f6rny\'fb gy\'f6trelemmel s\'fajtj\'e1k majd 
\'f5ket! Bizony, a te Urad gyors a b\'fcntet\'e9sben, \'e9s \'d5 bizony Megbocs\'e1t\'f3, Irgalmas.
\par 168. \'c9s felosztottuk \'f5ket a f\'f6ld\'f6n k\'f6z\'f6ss\'e9gekre. Vannak k\'f6z\'f6tt\'fck j\'f3 emberek, \'e9s vannak k\'f6z\'f6tt\'fck m\'e1smilyenek. \'c9s pr\'f3b\'e1ra tett\'fck \'f5ket j\'f3 \'e9s rossz dolgokkal, }{
\insrsid15821247\charrsid15210570 h\'e1tha visszat\'e9rnek.}{\insrsid15821247 
\par 169. \'c1m olyan ut\'f3dok k\'f6vetkeztek ut\'e1nuk, akik \'f6r\'f6k\'f6lt\'e9k az \'cdr\'e1st, \'e9s ennek [a vil\'e1gnak] az alantas javait veszik el, \'e9s azt mondj\'e1k: \'84Meg lesz nek\'fcnk bocs\'e1tva!\'94 \'c9s ha ugyanolyan javak j\'f6nnek hozz
\'e1juk, azt is elveszik. Vajon nem k\'f6ttetett meg vel\'fck az \'cdr\'e1s sz\'f6vets\'e9ge arr\'f3l, hogy Allahr\'f3l csakis az igazs\'e1got fogj\'e1k mondani, \'e9s tanulm\'e1nyozt\'e1k azt, ami abban van [az \'cdr\'e1sukban]? \'c1m az t\'falvil\'e1
gi lakhely jobb azoknak, akik istenf\'e9l\'f5k. H\'e1t vajon nem \'e9ltek az eszetekkel?
\par 170. \'c9s akik er\'f5sen ragaszkodnak az \'cdr\'e1shoz, \'e9s megtartj\'e1k az im\'e1dkoz\'e1st, [azoknak] - a javul\'e1st hoz\'f3knak - bizony, nem hagyjuk k\'e1rba veszni jutalm\'e1t.
\par 171. \'c9s [}{\insrsid15821247\charrsid15210570 eml\'edtsd}{\insrsid15821247  meg,] amikor felemelt\'fck f\'f6l\'e9j\'fck a hegyet, mintha \'e1rny\'e9kot ad\'f3 felh\'f5zet lenne, \'e9s \'f5k azt v\'e9lt\'e9k, hogy r\'e1
juk fog esni! [Allah] azt mondta nekik: \'84Er\'f5sen ragadj\'e1tok meg azt, amit adtunk nektek (a T\'f3r\'e1t), \'e9s eml\'e9kezzetek arra, ami abban van, h\'e1tha istenf\'e9l\'f5k lesztek!\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 172. \'c9s }{\insrsid15821247\charrsid15210570 [eml\'edtsd}{\insrsid15821247  meg,] amikor a te Urad kivette \'c1d\'e1m fiainak \'e1gy\'e9k\'e1b\'f3l az \'f5 ut\'f3daikat, \'e9s saj\'e1t magukkal szemben t\'e9tetett vel\'fck tan\'fas
\'e1got: \'84Vajon nem \'e9n vagyok a ti Uratok?\'94Azt mondt\'e1k: \'84Dehogynem! Tan\'fas\'e1got tesz\'fcnk [a Te egyed\'fclval\'f3s\'e1godr\'f3l]!\'94 - nehogy azt mondj\'e1tok a Felt\'e1mad\'e1s Napj\'e1n: \'84Bizony mi figyelmen k\'edv\'fc
l hagytuk ezt.\'94
\par 173. Vagy [nehogy] azt mondj\'e1tok: \'84M\'e1r aty\'e1ink is t\'e1rsat \'e1ll\'edtottak [Allah mell\'e9] kor\'e1bban, \'e9s mi csup\'e1n ut\'e1nuk k\'f6vetkez\'f5 ut\'f3dok voltunk. Vajon amiatt puszt\'edtan\'e1l el minket, amit a hamiss\'e1got k\'f6vet
\'f5k tettek?\'94
\par 174. Ekk\'e9ppen fejtj\'fck ki r\'e9szletesen a jeleket, \'e9s h\'e1tha visszat\'e9rnek.
\par }{\insrsid10886557 
\par }{\insrsid15821247 175. \'c9s recit\'e1ld el nekik annak a h\'edr\'e9t, akinek odaadtuk a jeleinket (B\'e1l\'e1mnak), \'e1m \'f5 f\'e9lrevetette azokat, \'e9s a s\'e1t\'e1n a k\'f6vet\'f5j\'e9v\'e9 tette \'f5t, \'e9s azok k\'f6z\'e9 tartozott, akik t\'e9v
\'fatra ker\'fcltek!
\par 176. Ha akartuk volna, felemelt\'fck volna \'e1ltaluk (a jeleink \'e1ltal), \'e1m \'f5 a f\'f6ldh\'f6z ragadt, \'e9s a k\'e9ny\'e9t k\'f6vette. Hasonlatos \'f5 a kuty\'e1hoz: ha elkergeted, liheg, de ha b\'e9k\'e9n hagyod, akkor is liheg. Ez a p\'e9ld\'e1
zata annak a n\'e9pnek, akik meghazudtolt\'e1k a mi jeleinket. Besz\'e9ld h\'e1t el a t\'f6rt\'e9neteket, h\'e1tha elgondolkodnak!
\par 177. Milyen rossz a p\'e9ld\'e1zata annak a n\'e9pnek, akik meghazudtolt\'e1k a jeleinket, \'e9s saj\'e1t maguk ellen k\'f6vettek el igazs\'e1gtalans\'e1got!
\par 178. Akit Allah vezet, az lel az [igaz] \'fatra, \'e9s akiket pedig t\'e9velyg\'e9sbe visz, nos \'f5k }{\insrsid12204078 bizony }{\insrsid15821247 a vesztesek.
\par }{\insrsid10886557 
\par }{\insrsid15821247 179. \'c9s bizony, sz\'e9tsz\'f3rtunk m\'e1r a Gyehenn\'e1nak sok dzsinnt \'e9s embert [akir\'f5l el\'f5z\'f5leg tudtuk, hogy rossz tettei miatt oda ker\'fclnek]. Van sz\'edv\'fck, amellyel nem \'e9rtenek, van szem\'fck, amellyel nem l
\'e1tnak, van f\'fcl\'fck, amellyel nem hallanak. \'d5k olyanok, ak\'e1r a j\'f3sz\'e1gok, de nem, m\'e9g [ann\'e1l is] t\'e9velyg\'f5bbek. \'d5k azok, akik figyelmen k\'edv\'fcl hagyt\'e1k [az egyistenhitet \'e9s az Allahnak val\'f3 engedelmess\'e9get].

\par }{\insrsid10886557 
\par }{\insrsid15821247 180. Allahot illetik meg a legszebb nevek, foh\'e1szkodjatok h\'e1t ezek \'e1ltal Hozz\'e1! \'c9s hagyj\'e1tok azokat, akik gyal\'e1zattal illetik az \'d5 neveit! Meg fogj\'e1k kapni a fizets\'e9g\'fcket [az\'e9rt], amit cselekedtek.

\par }{\insrsid10886557 
\par }{\insrsid15821247 181. Azok k\'f6z\'f6tt, akiket teremtett\'fcnk, van egy k\'f6z\'f6ss\'e9g, amely az igazs\'e1g alapj\'e1n vezet [m\'e1sokat], \'e9s aszerint \'edt\'e9lkezik.
\par 182. \'c9s akik meghazudtolj\'e1k a jeleinket, azokra fokozatosan m\'e9rj\'fck [a b\'fcntet\'e9st] olyan helyr\'f5l, amelyr\'f5l nem is tudnak.
\par 183. Halad\'e9kot adok nekik [egy ideig]. Bizony, er\'f5s az \'e9n tervem!
\par 184. H\'e1t vajon nem gondolkodtak el? Nincs az \'f5 t\'e1rsukban (Mohamed Pr\'f3f\'e9t\'e1ban) \'f5r\'fclts\'e9g. Bizony, \'f5 egy nyilv\'e1nval\'f3 figyelmeztet\'f5!
\par 185. H\'e1t vajon nem n\'e9ztek az egek \'e9s a f\'f6ld birodalm\'e1ra, \'e9s mindarra, amit Allah teremtett? Tal\'e1n m\'e1r k\'f6zeleg az \'f5 hat\'e1ridej\'fck. Vajon h\'e1t milyen besz\'e9dben akarnak hinni ez (a Kor\'e1n) ut\'e1n?
\par 186. Akit Allah visz a t\'e9velyg\'e9sbe, annak nincs vezet\'f5je, \'e9s magukra hagyja \'f5ket t\'falkap\'e1saikban vakon bolyongani.
\par }{\insrsid10886557 
\par }{\insrsid15821247 187. K\'e9rdeznek t\'e9ged az \'d3r\'e1r\'f3l (a Felt\'e1mad\'e1s idej\'e9r\'f5l), [hogy] mikor lesz annak az el\'e9rkez\'e9se. Mondd [\'f3 Mohamed]: \'84Annak tud\'e1sa csak az Uramn\'e1l van.\'94 Senki sem fedheti }{
\insrsid15821247\charrsid15210570 fel}{\insrsid15821247  annak idej\'e9t, csak \'d5. Ott s\'falyosodik az egekben \'e9s a f\'f6ld\'f6n. Nem fog [m\'e1sk\'e9nt] \'e9rni titeket csak v\'e1ratlanul. \'dagy k\'e9rdeznek t\'e9ged, }{
\insrsid15821247\charrsid7891678 mintha te tudn\'e1l arr\'f3l.}{\insrsid15821247  Mondd [\'f3 Mohamed]: \'84Annak tud\'e1sa csak Allahn\'e1l van!\'94 \'c1m a legt\'f6bb ember nem rendelkezik tud\'e1ssal.
\par }{\insrsid10886557 
\par }{\insrsid15821247 188. Mondd [\'f3 Mohamed]: \'84Nem \'e1ll m\'f3domban magamnak hasznot [hozni], sem \'e1rtalmat [elt\'e1vol\'edtani], kiv\'e9ve ha Allah \'fagy akarja. Ha ismern\'e9m a rejtett dolgokat, akkor sok j\'f3ra tenn\'e9k szert, \'e9s nem \'e9
rne engem semmi rossz. Nem vagyok \'e9n m\'e1s, csup\'e1n egy figyelmeztet\'f5 \'e9s \'f6r\'f6mh\'edrhoz\'f3 egy olyan n\'e9p sz\'e1m\'e1ra, akik hisznek.\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 189. \'d5 (Allah) az, aki megteremtett titeket egyetlen emberb\'f5l, \'e9s l\'e9tre hozta abb\'f3l a p\'e1rj\'e1t, hogy nyugalomra leljen n\'e1la. \'c9s miut\'e1n vele h\'e1lt, k\'f6nny\'fb teherrel esett teherbe, \'e9s j\'e1
rt-kelt vele. Miut\'e1n elnehez\'fclt, mindketten Allahhoz, az Urukhoz foh\'e1szkodtak [mondv\'e1n]: \'84Ha egy eg\'e9szs\'e9ges \'e9s er\'e9nyes [gyermeket] adsz nek\'fcnk, akkor a h\'e1l\'e1sak k\'f6z\'e9 fogunk tartozni.\'94
\par 190. Amikor azonban eg\'e9szs\'e9ges \'e9s er\'e9nyes [gyermeket] adott nekik, \'f5k ketten t\'e1rsistent \'e1ll\'edtottak [Allah] mell\'e9 abban, amit nekik adott. \'c9s Allah afelett van, amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [\'d5mell\'e9].
\par 191. Vajon olyat \'e1ll\'edtanak t\'e1rsistenk\'e9nt [Allah mell\'e9], ami semmit sem teremt, hanem \'f5k maguk is teremtve lettek?
\par 192. \'c9s akik nem k\'e9pesek rajtuk seg\'edteni, \'e9s saj\'e1t magukon sem k\'e9pesek seg\'edteni?
\par 193. \'c9s ha az igaz \'fatmutat\'e1sra h\'edvj\'e1tok \'f5ket, nem k\'f6vetnek titeket. Egyre megy nektek, hogy h\'edvj\'e1tok-e \'f5ket vagy hallgattok.
\par 194. Azok, akikhez foh\'e1szkodtok Allah helyett, szolg\'e1k, tihozz\'e1tok hasonl\'f3an. Foh\'e1szkodjatok csak hozz\'e1juk, hadd adjanak v\'e1laszt nektek, }{\insrsid15821247\charrsid291208 ha val\'f3ban igazmond\'f3k}{\insrsid15821247  vagytok!
\par 195. Van-e nekik l\'e1buk, amin j\'e1rnak? Vagy van-e nekik kez\'fck, amivel csap\'e1st m\'e9rnek? Vagy van-e nekik szem\'fck, amivel l\'e1tnak? Vagy van-e nekik f\'fcl\'fck, amivel hallanak? Mondd [\'f3 Mohamed]: \'84H\'edvj\'e1tok [seg\'edts\'e9g\'fc
l] azokat, akiket [Allah mell\'e9] t\'e1rsistenk\'e9nt \'e1ll\'edtottatok, majd sz\'f5jetek tervet ellenem, \'e9s ne adjatok halad\'e9kot!
\par }{\insrsid10886557 
\par }{\insrsid15821247 196. Bizony, Allah }{\insrsid15821247\charrsid291208 a p\'e1rtfog\'f3m, aki lebocs\'e1totta az \'cdr\'e1st (a Kor\'e1nt), \'e9s \'d5 gy\'e1mol\'edtja a j\'f3 ember}{\insrsid153759 e}{\insrsid15821247\charrsid291208 ket.
\par 197. \'c9s azok, akikhez foh\'e1szkodtok Rajta k\'edv\'fcl, nem k\'e9pesek}{\insrsid15821247  seg\'edteni rajtatok, \'e9s magukon sem k\'e9pesek seg\'edteni.
\par 198. \'c9s ha foh\'e1szkodtok hozz\'e1juk \'fatmutat\'e1s\'e9rt, nem hallgatj\'e1k meg.\'94 \'c9s l\'e1thatod \'f5ket, amint r\'e1d n\'e9znek, holott nem l\'e1tnak.
\par }{\insrsid10886557 
\par }{\insrsid15821247 199. Fogadd el a felesleget [amit vagyonukb\'f3l adakoznak], utas\'edts a hely\'e9nval\'f3ra, \'e9s fordulj el a tudatlanokt\'f3l!
\par 200. \'c9s ha gonosz sugallat sugalltatik neked a s\'e1t\'e1n r\'e9sz\'e9r\'f5l, akkor k\'e9rj mened\'e9ket Allaht\'f3l! Bizony, \'d5 mindent Hall\'f3 \'e9s Mindentud\'f3.
\par 201. Bizony, azok, akik istenf\'e9lelmet tan\'fas\'edtanak, amikor megk\'f6rny\'e9kez\'e9s \'e9ri \'f5ket a s\'e1t\'e1nt\'f3l, \'e9szbe kapnak, \'e9s \'edme, \'f5k [tiszt\'e1n] l\'e1tnak.
\par 202. \'c1m a testv\'e9reik (a s\'e1t\'e1nok testv\'e9rei) hagyj\'e1k beles\'fcllyedni \'f5ket (a hitetleneket) a t\'e9velyg\'e9sbe, \'e9s soha sem hagynak fel vele.
\par 203. \'c9s amikor nem hozol nekik jelet, akkor azt mondj\'e1k: \'84H\'e1t mi\'e9rt nem v\'e1lasztasz ki valamit [magadt\'f3l]?\'94 Mondd [\'f3 Mohamed]: \'84\'c9n csup\'e1n azt k\'f6vetem, ami sugalltatott nekem az Uramt\'f3l. Ezek tiszt\'e1nl\'e1t\'e1
st ad\'f3 bizony\'edt\'e9kok az Uratokt\'f3l, \'fatmutat\'e1s \'e9s k\'f6ny\'f6r\'fclet egy olyan n\'e9pnek, akik hisznek.\'94
\par }{\insrsid10886557 
\par }{\insrsid15821247 204. \'c9s amikor a Kor\'e1n recit\'e1ltatik, hallgass\'e1tok \'e9s figyeljetek csendben! H\'e1tha }{\insrsid15821247\charrsid15210570 k\'f6ny\'f6r\'fcletre leltek}{\insrsid15821247 !
\par 205. \'c9s eml\'e9kezz meg Uradr\'f3l magadban, al\'e1zatosan \'e9s f\'e9lve, hangos besz\'e9d n\'e9lk\'fcl, kora reggel \'e9s k\'e9s\'f5 d\'e9lut\'e1n! \'c9s ne tartozz azok k\'f6z\'e9, akik figyelmen k\'edv\'fcl hagyj\'e1k [az istenemleget\'e9st]!

\par 206. Bizony azok, akik az Uradn\'e1l vannak, nem [fordulnak el] fennh\'e9j\'e1z\'f3an a Neki val\'f3 szolg\'e1latt\'f3l, \'d5t magasztalj\'e1k \'e9s El\'f5tte borulnak le.
\par }\pard \qj \fi-30\li30\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin30\itap0\pararsid15821247 {\expnd6\expndtw32\insrsid5256501 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid3161635 {\b\insrsid6910555\charrsid7550020 \page }{\b\insrsid3161635\charrsid7550020 8. A hadizs\'e1km\'e1ny (al-Anfal) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid9993762 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid9993762 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid9993762 
\par 1. K\'e9rdeznek t\'e9ged a hadizs\'e1km\'e1nyr\'f3l. Mondd [\'f3 Mohamed]: \'84A hadizs\'e1km\'e1ny [eloszt\'e1sa] Allahra \'e9s a K\'fcld\'f6ttre tartozik.\'94 F\'e9lj\'e9tek h\'e1t Allahot \'e9s jav\'edts\'e1tok az egym\'e1s k\'f6z\'f6tt
i [viszonyaitokat]! Engedelmeskedjetek Allahnak \'e9s az \'d5 K\'fcld\'f6tt\'e9nek, ha [val\'f3ban] h\'edv\'f5k vagytok!
\par 2. A h\'edv\'f5k csup\'e1n azok, akiknek f\'e9lelemmel telik el a sz\'edv\'fck, amikor Allah megeml\'edttetik, \'e9s amikor recit\'e1ltatnak nekik a jelei (szavai), gyarap\'edtja \'f5ket hitben, \'e9s Urukra hagyatkoznak.
\par 3. Akik megtartj\'e1k az im\'e1dkoz\'e1st, \'e9s adakoznak abb\'f3l, amivel ell\'e1ttuk \'f5ket.
\par 4. \'d5k az igazi h\'edv\'f5k, fokozatok illetik meg \'f5ket az Urukn\'e1l, \'e9s megbocs\'e1t\'e1s \'e9s nemes ell\'e1t\'e1s.
\par 
\par 5. [A hadizs\'e1km\'e1ny eloszt\'e1s\'e1val szembeni nemtetsz\'e9s] olyan, mint amikor az Urad kivonul\'e1sra k\'e9sztetett t\'e9ged a h\'e1zadb\'f3l az igazs\'e1gnak megfelel\'f5en, \'e1m egy csoport a h\'edv\'f5k k\'f6z\'fcl ut\'e1lta ezt.
\par 6. Vit\'e1ba sz\'e1llnak veled az igazs\'e1ggal kapcsolatban, miut\'e1n [az] vil\'e1goss\'e1 v\'e1lt, mintha csak a hal\'e1lba hajtan\'e1k \'f5ket, mik\'f6zben n\'e9znek.
\par 7. \'c9s [eml\'e9kezzetek arra] amikor Allah meg\'edg\'e9rte nektek, hogy a k\'e9t csapat k\'f6z\'fcl az egyik a ti kezetekre ker\'fcl! Ti pedig azt k\'edv\'e1nt\'e1tok, hogy ne a fegyvert forgat\'f3 ker\'fclj\'f6n a kezetekre, \'e1m Allah val\'f3
ra akarta v\'e1ltani az igazs\'e1got a szava \'e1ltal, \'e9s kiirtottuk az utols\'f3 marad\'e9k\'e1t a hitetleneknek.
\par 8. Az\'e9rt, hogy val\'f3ra v\'e1ltsa az igazs\'e1got, \'e9s semmiv\'e9 tegye a hamiss\'e1got, m\'e9g ha ez ut\'e1latos is a gonosztev\'f5knek.
\par 
\par 9. \'c9s [eml\'e9kezzetek arra] amikor az Uratokt\'f3l seg\'edts\'e9get k\'e9rtetek \'e9s \'d5 meghallgatott titeket: \'84Bizony, meger\'f5s\'edtelek titeket ezer angyallal, szorosan egym\'e1s m\'f6g\'f6tt!\'94
\par 10. \'c9s Allah ezt nem tette m\'e1s\'e9rt, minthogy \'f6r\'f6mh\'edrr\'e9 legyen, \'e9s hogy megnyugodjon \'e1ltala a sz\'edvetek. \'c9s a gy\'f5zelem csup\'e1n Allaht\'f3l sz\'e1rmazik. Bizony, Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.
\par 11. \'c9s [eml\'e9kezzetek arra] amikor \'e1lmot bor\'edtott re\'e1tok T\'f5le val\'f3 biztons\'e1g gyan\'e1nt, \'e9s vizet bocs\'e1tott le nektek az \'e9gb\'f5l, hogy megtiszt\'edtson \'e1ltala titeket, \'e9s hogy elt\'e1vol\'edtsa r\'f3latok a s\'e1t
\'e1n f\'f6rtelmess\'e9g\'e9t, \'e9s hogy meger\'f5s\'edtse vele a sz\'edveteket, \'e9s szil\'e1rdd\'e1 tegye \'e1ltala a l\'e1batokat!
\par 12. \'c9s [eml\'e9kezzetek arra] amikor Urad azt sugallta az angyaloknak: \'84Bizony, \'e9n veletek vagyok! Er\'f5s\'edts\'e9tek h\'e1t meg azokat, akik hisznek! R\'e9m\'fcletet fogok vetni azok sz\'edv\'e9be, akik hitetlenn\'e9 v\'e1ltak. \'dcssetek h
\'e1t [a bedri csat\'e1n jelenl\'e9v\'f5 hitetlenek] nyaka f\'f6l\'e9, \'e9s \'fcss\'e9tek az \'f6sszes ujjbegy\'fcket!\'94
\par 13. Az\'e9rt van ez, mert szembeszeg\'fcltek Allahhal \'e9s a K\'fcld\'f6tt\'e9vel. \'c9s aki szembeszeg\'fcl Allahhal \'e9s a K\'fcld\'f6tt\'e9vel, h\'e1t bizony, Allah szigor\'fa a b\'fcntet\'e9sben.
\par 14. Ez a ti [b\'fcntet\'e9setek], \'edzlelj\'e9tek h\'e1t meg! \'c9s bizony, a hitetleneknek a [Pokol-]t\'fbz gy\'f6trelme j\'e1r.
\par 
\par 15. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha tal\'e1lkoztok }{\cf1\insrsid3161635\charrsid9993762 azokkal, akik hitetlenn\'e9 v\'e1ltak,}{\insrsid3161635\charrsid9993762  el\'f5
renyomulva, akkor ne ford\'edtsatok h\'e1tat nekik [menek\'fclve]!
\par 16. \'c9s aki azon a napon h\'e1tat ford\'edt [az ellens\'e9gnek] \endash  kiv\'e9ve hadicselk\'e9nt vagy egy [m\'e1sik] csapathoz csatlakozva \endash  az bizony Allah haragv\'e1s\'e1t vonja mag\'e1ra, \'e9s hajl\'e9ka a Gyehenna lesz. Milyen nyomor\'fas
\'e1gos v\'e9gc\'e9l!
\par 
\par 17. \'c1m nem ti \'f6lt\'e9tek meg \'f5ket, hanem Allah \'f6lte meg \'f5ket, \'e9s nem te dobt\'e1l, amikor dobt\'e1l, hanem Allah dobott [az\'e9rt, hogy legy\'f5zze a hitetleneket] \'e9s az\'e9rt, hogy T\'f5le val\'f3 sz\'e9p pr\'f3bat\'e9tellel tegye pr
\'f3b\'e1ra a h\'edv\'f5ket. Bizony, Allah Mindent Hall\'f3, Mindentud\'f3.
\par 18. Ez [Allah kegye] sz\'e1motokra! \'c9s bizony, Allah meggyeng\'edti a hitetlenek fondorlat\'e1t.
\par 19. Ha a d\'f6nt\'e9st k\'e9ritek, h\'e1t a d\'f6nt\'e9s elj\'f6tt m\'e1r hozz\'e1tok. Ha abbahagyj\'e1tok [a harcot], az jobb nektek! \'c9s ha visszat\'e9rtek [az ellens\'e9gesked\'e9shez], akkor mi is visszat\'e9r\'fcnk [a megb\'fcntet\'e9setekhez]. 
\'c9s semmit sem fog nektek haszn\'e1lni a csapatotok, b\'e1rmilyen sok is legyen. \'c9s bizony, Allah a h\'edv\'f5kkel van!
\par 
\par 20. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Engedelmeskedjetek Allahnak \'e9s a K\'fcld\'f6tt\'e9nek, \'e9s ne forduljatok el t\'f5le, mik\'f6zben hallgatj\'e1tok!
\par 21. \'c9s ne legyetek olyanok, mint azok, akik azt mondj\'e1k: \'84Halljuk!\'94 holott \'f5k nem hallj\'e1k.
\par 22. Bizony, Allah el\'f5tt a legrosszabb f\'f6ld\'f6n mozg\'f3 [\'e9l\'f5l\'e9nyek] a s\'fcketek \'e9s a n\'e9m\'e1k, akik nem \'e9lnek az esz\'fckkel.
\par 23. \'c9s ha Allah b\'e1rmi j\'f3r\'f3l tudott volna benn\'fck, [\'e9rt\'f5] hall\'e1st adott volna nekik. \'c9s ha hall\'e1st adott volna nekik, akkor h\'e1tat ford\'edtottak volna, mik\'f6zben \'fcgyet sem vetettek volna [az igazs\'e1gra].
\par 24. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Hallgassatok Allahra \'e9s a K\'fcld\'f6ttre (engedelmeskedjetek), amikor valami olyanra sz\'f3l\'edt titeket, ami \'e9letet ad nektek! 
\'c9s tudj\'e1tok meg, hogy Allah az ember \'e9s annak sz\'edve k\'f6z\'e9 \'e1ll (megakad\'e1lyozza, hogy b\'e1rmit tegyen), \'e9s hogy Hozz\'e1 lesztek egybegy\'fbjtve!
\par 25. \'c9s f\'e9ljetek egy olyan k\'eds\'e9rt\'e9st\'f5l (megpr\'f3b\'e1ltat\'e1st\'f3l), amely nem csak azokat s\'fajtja majd k\'f6z\'fcletek, akik igazs\'e1gtalans\'e1got k\'f6vettek el! \'c9s tudj\'e1tok meg, hogy Allah szigor\'fa a b\'fcntet\'e9sben!

\par 26. \'c9s eml\'e9kezzetek arra, amikor m\'e9g kevesen voltatok \'e9s elnyomtak benneteket a f\'f6ld\'f6n, \'e9s att\'f3l f\'e9ltetek, hogy az emberek elragadnak titeket! \'d5 pedig mened\'e9ket ny\'fajtott nektek \'e9s meger\'f5s\'edtett titeket a gy\'f5
zelm\'e9vel \'e9s ell\'e1tott titeket a j\'f3 dolgokb\'f3l, h\'e1tha h\'e1l\'e1sak lesztek.
\par 
\par 27. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne \'e1rulj\'e1tok el Allahot \'e9s a K\'fcld\'f6ttet, \'e9s ne \'e1rulj\'e1tok el a r\'e1tok b\'edzott dolgokat, mik\'f6zben ti tudj\'e1
tok!
\par 28. \'c9s tudj\'e1tok meg, hogy a vagyonotok \'e9s a gyermekeitek csup\'e1n k\'eds\'e9rt\'e9s (megpr\'f3b\'e1ltat\'e1s) sz\'e1motokra, \'e9s hogy Allahn\'e1l hatalmas jutalom van!
\par 29. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha f\'e9litek Allahot, \'f5 Sz\'e9tv\'e1laszt\'f3t ad nektek [hogy k\'fcl\'f6nbs\'e9get tegyetek igazs\'e1g \'e9s hamiss\'e1g k\'f6z\'f6
tt], elt\'f6rli a rossz tetteiteket, \'e9s megbocs\'e1t nektek. \'c9s Allah\'e9 a hatalmas kegy.
\par 
\par 30. \'c9s [eml\'e9kezz arra] amikor [gonosz] tervet sz\'f5ttek ellened azok, akik }{\cf1\insrsid3161635\charrsid9993762 hitetlenn\'e9 v\'e1ltak}{\insrsid3161635\charrsid9993762 , az\'e9rt hogy g\'fazsba k\'f6ssenek, vagy meg\'f6ljenek vagy el\'fbzzenek t
\'e9ged! \'c9s [gonosz] tervet sz\'f5ttek, \'e1m Allah is tervezett. \'c9s Allah a legjobb a tervez\'f5k k\'f6z\'f6tt.
\par 31. \'c9s amikor recit\'e1ltatnak nekik a jeleink (szavaink), azt mondj\'e1k: \'84Hallottuk m\'e1r! Ha akarn\'e1nk, mi is mondhatn\'e1nk ehhez hasonl\'f3t. Bizony ez nem m\'e1s, mint a hajdanvoltak legend\'e1i.\'94
\par 32. \'c9s [eml\'e9kezz arra] amikor azt mondt\'e1k: \'84\'d3 Allah! Ha ez (a Kor\'e1n) val\'f3ban a T\'f5led val\'f3 igazs\'e1g, akkor z\'fad\'edts r\'e1nk k\'f5[-es\'f5t] az \'e9gb\'f5l, vagy hozz r\'e1nk f\'e1jdalmas gy\'f6trelmet!\'94
\par 33. \'c1m Allah nem s\'fajtja gy\'f6trelemmel \'f5ket, am\'edg te k\'f6z\'f6tt\'fck vagy, \'e9s Allah nem b\'fcnteti meg \'f5ket, am\'edg megbocs\'e1t\'e1st k\'e9rnek [T\'f5le].
\par 34. \'c9s mi\'e9rt ne s\'fajtan\'e1 Allah gy\'f6trelemmel \'f5ket, mik\'f6zben \'f5k t\'e1vol tartj\'e1k [a h\'edv\'f5ket] a Tilalmas Mecsett\'f5l, \'e9s \'f5k sosem voltak a v\'e9delmez\'f5i? Bizony, a v\'e9delmez\'f5i csup\'e1n az istenf\'e9l\'f5k, \'e1
m a legt\'f6bbj\'fck nem rendelkezik tud\'e1ssal.
\par 35. \'c9s az \'f5 im\'e1juk a H\'e1zn\'e1l nem volt m\'e1s, mint f\'fcty\'fcl\'e9s \'e9s taps. K\'f3stolj\'e1tok h\'e1t meg a gy\'f6trelmet, ami\'e9rt nem hittetek!
\par 36. Bizony azok, akik }{\cf1\insrsid3161635\charrsid9993762 hitetlenn\'e9 v\'e1ltak}{\insrsid3161635\charrsid9993762 , arra k\'f6ltik a vagyonukat, hogy t\'e1vol tarts\'e1k [a h\'edv\'f5ket] Allah \'fatj\'e1t\'f3l. El fogj\'e1k k\'f6lteni, majd b\'e1natt
\'e1 v\'e1lik sz\'e1mukra, azut\'e1n gy\'f5zelmet aratnak f\'f6l\'f6tt\'fck. Azok, akik }{\cf1\insrsid3161635\charrsid9993762 hitetlenn\'e9 v\'e1ltak}{\insrsid3161635\charrsid9993762 , a Gyehenn\'e1hoz lesznek egybegy\'fbjtve.
\par 37. Az\'e9rt, hogy elv\'e1lassza Allah a hitv\'e1nyat a j\'f3t\'f3l, \'e9s hogy  a hitv\'e1nyakat egym\'e1s f\'f6l\'e9 rakja, majd egy halomba gy\'fbjtse az \'f6sszeset \'e9s a Gyehenn\'e1ba vesse. \'d5k a vesztesek.38. Mondd [\'f3 Mohamed] azoknak, akik 
}{\cf1\insrsid3161635\charrsid9993762 hitetlenn\'e9 v\'e1ltak}{\insrsid3161635\charrsid9993762 : \'84Ha abbahagyj\'e1tok [a hitetlens\'e9get \'e9s az ellens\'e9gesked\'e9st], megbocs\'e1t\'e1sban r\'e9szes\'fclt\'f6k arra n\'e9zve, ami azel\'f5tt volt!
\'94 Ha azonban visszat\'e9rnek [a hitetlens\'e9ghez], h\'e1t [akkor vegy\'e9k figyelmeztet\'e9s\'fcl azt, ami] t\'f6rv\'e9nyszer\'fbs\'e9g m\'e1r v\'e9gbement a hajdanvoltakat illet\'f5en!
\par 39. \'c9s harcoljatok h\'e1t ellen\'fck, hogy ne legyen k\'eds\'e9rt\'e9s (\'fcld\'f6ztet\'e9s) \'e9s hogy a vall\'e1s (az istenszolg\'e1lat) teljess\'e9g\'e9ben Allah\'e9 legyen! Ha abbahagyj\'e1k, h\'e1t Allah bizony l\'e1tja mindazt, amit cselekszenek.

\par 40. Ha azonban h\'e1tat ford\'edtanak, h\'e1t tudj\'e1tok meg, hogy Allah a ti p\'e1rtfog\'f3tok! Milyen j\'f3 p\'e1rtfog\'f3, \'e9s milyen j\'f3 seg\'edt\'f5!
\par 
\par }\pard \qj \li0\ri0\sl300\slmult0\nowidctlpar\tx0\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid9993762 41. \'c9s tudj\'e1tok meg, hogy b\'e1rmit zs\'e1km\'e1nyoltok, annak egy\'f6t\'f6de Allah\'e9
, a K\'fcld\'f6tt\'e9, a k\'f6zeli rokonok\'e9, az \'e1rv\'e1k\'e9, a szeg\'e9nyek\'e9, \'e9s az utaz\'f3k\'e9 (a t\'f6bbi a katon\'e1kat illeti meg), ha [val\'f3ban] hisztek Allahban \'e9s abban, amit lebocs\'e1tottunk a mi szolg\'e1nknak a Sz\'e9tv\'e1
laszt\'e1s napj\'e1n, azon a napon, amikor a k\'e9t sereg \'f6sszetal\'e1lkozott! \'c9s Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 
\par 42. [Eml\'e9kezzetek arra] amikor a v\'f6lgy k\'f6zelebb es\'f5 oldal\'e1n voltatok, \'f5k [az ellens\'e9gek] a v\'f6lgy t\'e1volabbi oldal\'e1n, a karav\'e1n pedig t\'f5letek lentebb! Ha meg\'e1llapodtatok volna arr\'f3l, hogy tal\'e1
lkozzatok, akkor bizonnyal elv\'e9tett\'e9tek volna a tal\'e1lkoz\'f3t. \'c1m [az\'e9rt t\'f6rt\'e9nt \'edgy] hogy Allah bev\'e9gezzen egy olyan \'fcgyet, amelynek be kellett teljesednie [az\'e9rt], hogy aki elpusztul, az vil\'e1gos bizony\'edt\'e9k alapj
\'e1n pusztuljon el, \'e9s aki \'e9letben marad, az is vil\'e1gos bizony\'edt\'e9k alapj\'e1n maradjon \'e9letben. \'c9s bizony, Allah Mindent Hall\'f3, Mindentud\'f3!
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid9993762 43. [Eml\'e9kezz arra] amikor Allah kev\'e9snek mutatta \'f5ket neked az \'e1lmodban! Ha soknak mutatta volna neked 
\'f5ket, akkor kudarcot vallottatok volna, \'e9s \'f6sszek\'fcl\'f6nb\'f6ztetek volna az \'fcgy\'f6n (a haditerven). Allah azonban megmentett [titeket]. Bizony, \'d5neki (Allahnak) tudom\'e1sa van arr\'f3l, amit a keblek rejtenek.
\par 44. \'c9s [eml\'e9kezzetek arra] amikor kev\'e9snek mutatta \'f5ket a szemetekben, amikor tal\'e1lkoztatok egym\'e1ssal [az \'fctk\'f6zetn\'e9l] \endash  \'e9s kev\'e9snek mutatott titeket is az \'f5 szem\'fckben! [Az\'e9rt t\'f6rt\'e9nt \'ed
gy] hogy Allah bev\'e9gezzen egy olyan \'fcgyet, amelynek be kellett teljesednie, \'e9s Allahhoz vitetnek vissza a dolgok [d\'f6nt\'e9sre].
\par 
\par 45. \'d3 ti, kik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha [ellens\'e9ges] csapattal tal\'e1lkoztok [a harct\'e9ren], akkor tartsatok ki szil\'e1rdan, \'e9s eml\'e9kezzetek meg sokszor Allahr\'f3
l, h\'e1tha boldogultok!
\par 46. \'c9s engedelmeskedjetek Allahnak \'e9s a K\'fcld\'f6tt\'e9nek, \'e9s ne k\'fcl\'f6nb\'f6zzetek \'f6ssze egym\'e1ssal, k\'fcl\'f6nben kudarcot vallotok \'e9s elhagy titeket az er\'f5t\'f6k! \'c9s legyetek t\'fcrelmesek! Bizony, Allah a t\'fc
relmesekkel van.
\par 47. \'c9s ne legyetek olyanok, mint akik hivalkodva vonultak ki lakhelyeikr\'f5l, \'e9s \'fagy, hogy l\'e1ss\'e1k \'f5ket az emberek! T\'e1vol akarnak tartani Allah \'datj\'e1t\'f3l. Allah [tud\'e1sa] k\'f6r\'fclveszi mindazt, amit cselekszenek.
\par 48. \'c9s [eml\'e9kezz arra] amikor a s\'e1t\'e1n d\'edszess\'e9 tette sz\'e1mukra cselekedeteiket, \'e9s azt mondta: \'84Nincs ma az emberek k\'f6z\'f6tt olyan, aki gy\'f5zelmet aratna f\'f6l\'f6ttetek! Bizony, \'e9n mened\'e9ket adok nektek!\'94
 Amikor azonban a k\'e9t sereg szembeker\'fclt egym\'e1ssal, sarkon fordult, \'e9s azt mondta [a b\'e1lv\'e1nyim\'e1d\'f3knak]: \'84Elhat\'e1rol\'f3dok t\'f5letek! Bizony, \'e9n l\'e1tom azt, amit ti nem l\'e1ttok. Bizony, \'e9n f\'e9lem Allahot! \'c9
s Allah szigor\'fa a b\'fcntet\'e9sben.\'94
\par 49. [Eml\'e9kezzetek arra] amikor a k\'e9pmutat\'f3k, \'e9s azok, akiknek a sz\'edv\'e9ben betegs\'e9g van, azt mondt\'e1k: \'84Megt\'e9vesztette ezeket a vall\'e1suk!\'94 \'c9s aki Allahra hagyatkozik, h\'e1t bizony Allah M\'e9lt\'f3s\'e1gteljes, B\'f6
lcs!
\par 
\par 50. \'c9s b\'e1rcsak l\'e1tn\'e1d, amikor elsz\'f3l\'edtj\'e1k [a hal\'e1l] angyalai azokat, akik hitetlenn\'e9 v\'e1ltak, mik\'f6zben \'fctik az arcukat \'e9s a h\'e1tukat [azt mondv\'e1n:] \'84\'cdzlelj\'e9tek meg az \'c9get\'f5 [Pokol-]t\'fbz gy\'f6
trelm\'e9t!
\par 51. Ez [a fizets\'e9getek] az\'e9rt, amit a kezetek k\'f6vetett el, \'e9s Allah bizony nem igazs\'e1gtalan a szolg\'e1kkal.\'94
\par 
\par 52. [A hozz\'e1\'e1ll\'e1suk] olyan, mint a F\'e1ra\'f3 n\'e9p\'e9nek hozz\'e1\'e1ll\'e1sa, \'e9s azok\'e9, akik el\'f5tt\'fck \'e9ltek. }{\cf1\insrsid3161635\charrsid9993762 Hitetlenn\'e9 v\'e1ltak}{\insrsid3161635\charrsid9993762 
 Allah jeleivel szemben, Allah pedig elragadta \'f5ket b\'fbneik miatt. Bizony, Allah Er\'f5s \'e9s szigor\'fa a b\'fcntet\'e9sben.
\par 53. Az\'e9rt van ez, mivel Allah nem v\'e1ltoztatja meg a j\'f3t\'e9tem\'e9ny\'e9t, amelyben r\'e9szes\'edtett valamely n\'e9pet, am\'edg [\'f5k] nem v\'e1ltoztatj\'e1k meg azt, ami magukban van. Bizony, Allah Mindent Hall\'f3, Mindentud\'f3.
\par 54. [A hozz\'e1\'e1ll\'e1suk] olyan, mint a F\'e1ra\'f3 n\'e9p\'e9nek a hozz\'e1\'e1ll\'e1sa, \'e9s azok\'e9, akik el\'f5tt\'fck \'e9ltek. Meghazudtolt\'e1k Uruk jeleit, mi pedig elpuszt\'edtottuk \'f5ket a b\'fbneik miatt, \'e9s v\'ed
zbe fullasztottuk a F\'e1ra\'f3 n\'e9p\'e9t. \'c9s mindannyian igazs\'e1gtalanok voltak.
\par 
\par 55. Bizony, Allahn\'e1l a legrosszabb mozg\'f3 [\'e9l\'f5l\'e9nyek] azok, akik }{\cf1\insrsid3161635\charrsid9993762 hitetlenn\'e9 v\'e1ltak}{\insrsid3161635\charrsid9993762 , \'e9s nem fognak hinni.
\par 56. Azok, akikkel egyezs\'e9get k\'f6t\'f6tt\'e9l k\'f6z\'fcl\'fck, azt\'e1n minden alkalommal megszegik az egyezs\'e9g\'fcket, mik\'f6zben nem tan\'fas\'edtanak istenf\'e9lelmet.
\par 57. \'c9s ha szembe tal\'e1lod magad vel\'fck a h\'e1bor\'faban, akkor oszlasd sz\'e9t \'e1ltaluk azokat, akik m\'f6g\'f6tt\'fck \'e1llnak, h\'e1tha okulnak [az int\'e9sb\'f5l]!
\par 58. \'c9s ha egy n\'e9p r\'e9sz\'e9r\'f5l \'e1rul\'e1st\'f3l tartasz, akkor haj\'edtsd vissza nekik [a b\'e9keszerz\'f5d\'e9st], hogy egyform\'e1k legyetek [a felmond\'e1sr\'f3l val\'f3 tud\'e1sban]! Bizony, Allah nem szereti az \'e1rul\'f3kat.
\par 59. \'c9s ne gondolj\'e1k azok, akik }{\cf1\insrsid3161635\charrsid9993762 hitetlenn\'e9 v\'e1ltak}{\insrsid3161635\charrsid9993762 , hogy megmenek\'fclhetnek [Allah b\'fcntet\'e9se el\'f5l]! Bizony, \'f5k nem fogj\'e1k [Allahot] megakad\'e1
lyozni [semmiben].
\par 60. \'c9s k\'e9sz\'edtsetek fel  ellen\'fck, amit a [fegyveres] er\'f5b\'f5l \'e9s a csatam\'e9nekb\'f5l k\'e9pesek vagytok [megszerezni], hogy retteg\'e9st keltsetek \'e1ltaluk Allah ellens\'e9geiben \'e9s a ti ellens\'e9geitekben \'e9s rajtuk k\'edv\'fc
l m\'e1sokban is, akiket ti nem ismertek, \'e1m Allah ismeri \'f5ket! B\'e1rmit adakoztok Allah \'fatj\'e1n, teljes m\'e9rt\'e9kben visszakapj\'e1tok \'e9s nem szenvedtek igazs\'e1gtalans\'e1got.
\par 61. \'c9s ha hajlanak a b\'e9k\'e9re, akkor te is hajolj arra \'e9s hagyatkozz Allahra! \'d5 bizony a mindent Hall\'f3, a Mindentud\'f3.
\par 
\par 62. \'c9s ha f\'e9lre akarnak vezetni, akkor bizony Allah elegend\'f5 sz\'e1modra [az ellens\'e9ged ellen]. \'d5 az, aki meger\'f5s\'edtett t\'e9ged a gy\'f5zelm\'e9vel \'e9s a h\'edv\'f5kkel.
\par 63. \'c9s egyet\'e9rt\'e9st teremtett a sz\'edveik k\'f6z\'f6tt. Ha mindazt, ami a f\'f6ld\'f6n van, arra k\'f6lt\'f6tted volna, akkor sem tudt\'e1l volna egyet\'e9rt\'e9s teremteni a sz\'edveik k\'f6z\'f6tt. Allah azonban egyet\'e9rt\'e9s teremtett k\'f6
z\'f6tt\'fck. Bizony, \'d5 M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.
\par 64. \'d3 Pr\'f3f\'e9ta! Allah elegend\'f5 neked \'e9s azoknak, akik k\'f6vetnek t\'e9ged a h\'edv\'f5k k\'f6z\'fcl.
\par 65. \'d3 Pr\'f3f\'e9ta! Buzd\'edtsd a h\'edv\'f5ket a harcra! Ha van k\'f6ztetek h\'fasz kitart\'f3 [harcos], gy\'f5zelmet aratnak k\'e9tsz\'e1z f\'f6l\'f6tt. Ha pedig van k\'f6ztetek sz\'e1z, azok gy\'f5zelmet aratnak ezer f\'f6l\'f6tt azok k\'f6z\'fc
l, akik }{\cf1\insrsid3161635\charrsid9993762 hitetlenn\'e9 v\'e1ltak}{\insrsid3161635\charrsid9993762 , mivel \'f5k egy olyan n\'e9p, akik nem \'e9rtenek.
\par 66. Most [azonban] Allah megk\'f6nny\'edtette nektek, \'e9s tudja, hogy gyenges\'e9g van bennetek. Ha teh\'e1t van k\'f6ztetek sz\'e1z kitart\'f3 [harcos], azok gy\'f5zelmet aratnak k\'e9tsz\'e1z f\'f6l\'f6tt, ha pedig van k\'f6ztetek ezer, azok gy\'f5
zelmet aratnak k\'e9tezer f\'f6l\'f6tt Allah engedelm\'e9vel. \'c9s Allah a kitart\'f3kkal van.
\par 
\par 67. Egy pr\'f3f\'e9ta nem ejthet foglyokat mindaddig, am\'edg nem m\'e9rt v\'e9gleges csap\'e1st [az ellens\'e9geire] a f\'f6ld\'f6n. Ti az evil\'e1g javait akarj\'e1tok, \'e1m Allah a t\'falvil\'e1got akarja [sz\'e1motokra]. \'c9s Allah M\'e9lt\'f3s\'e1
gteljes, B\'f6lcs.
\par 68. Ha nem lett volna kor\'e1bban egy \'edr\'e1s (elrendel\'e9s) Allaht\'f3l, akkor bizony hatalmas gy\'f6trelem \'e9rne titeket az\'e9rt, amit elvettetek [zs\'e1km\'e1nyk\'e9nt \'e9s v\'e1lts\'e1gd\'edjk\'e9nt]!
\par 69. Egyetek h\'e1t abb\'f3l, ami zs\'e1km\'e1nyt szereztetek! Az megengedett \'e9s j\'f3 [sz\'e1motokra]! \'c9s f\'e9lj\'e9tek Allahot! Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 70. \'d3 Pr\'f3f\'e9ta! Mondd a foglyoknak, akik a kezetekben vannak: \'84Ha Allah tud valami j\'f3r\'f3l (igaz hitr\'f5l) a sz\'edvetekben, akkor jobbat ad nektek, mint az, ami elv\'e9tetett t\'f5letek [v\'e1lts\'e1gd\'edjk\'e9nt], \'e9s megbocs\'e1
t nektek!\'94 \'c9s Allah Megbocs\'e1t\'f3, Irgalmas.
\par 71. \'c9s ha [a szabadon engedett foglyok] az el\'e1rul\'e1sodat akarj\'e1k, h\'e1t [ne b\'e1nk\'f3dj, hiszen] m\'e1r kor\'e1bban el\'e1rult\'e1k Allahot, \'e9s \'d5 hatalmat adott [a h\'edv\'f5knek] felett\'fck! \'c9s Allah Mindentud\'f3, B\'f6lcs.

\par 
\par 72. Bizony azok, akik hisznek, kiv\'e1ndoroltak (Mekk\'e1b\'f3l Medin\'e1ba), \'e9s k\'fczd\'f6ttek a vagyonukkal \'e9s magukkal (\'e9let\'fcket kock\'e1ztatva) Allah \'datj\'e1n, \'e9s azok, akik befogadtak \'e9s seg\'edtettek, egyik\'fck a m\'e1sik p
\'e1rtfog\'f3ja. \'c1m azokhoz, akik hisznek, de nem v\'e1ndoroltak ki, semmif\'e9le p\'e1rtfog\'e1s nem k\'f6t titeket, am\'edg el nem v\'e9gzik a kiv\'e1ndorl\'e1st. Ha azonban a vall\'e1s miatt k\'e9rnek t\'f5letek seg\'edts\'e9get, akkor k\'f6telez
\'f5 a seg\'edts\'e9gad\'e1s r\'e1tok n\'e9zve, kiv\'e9ve olyan n\'e9p ellen, akik k\'f6z\'f6tt \'e9s k\'f6z\'f6ttetek sz\'f6vets\'e9g van. \'c9s Allah \'e1tl\'e1tja azt, amit cselekszetek.
\par 73. \'c9s akik }{\cf1\insrsid3161635\charrsid9993762 hitetlenn\'e9 v\'e1ltak}{\insrsid3161635\charrsid9993762 , egyik\'fck a m\'e1sik p\'e1rtfog\'f3ja. Ha nem cselekedtek \'fagy [hogy a h\'edv\'f5ket fogadj\'e1tok p\'e1rtfog\'f3itokk\'e1], akkor k\'eds
\'e9rt\'e9s lesz a f\'f6ld\'f6n \'e9s nagy roml\'e1s!
\par 74. \'c9s azok, akik hisznek, kiv\'e1ndoroltak, \'e9s k\'fczd\'f6ttek Allah \'datj\'e1n, \'e9s azok, akik befogadtak \'e9s seg\'edtettek, \'f5k a h\'edv\'f5k val\'f3j\'e1ban. Nekik megbocs\'e1t\'e1s \'e9s nemes ell\'e1t\'e1s j\'e1r.
\par 75. \'c9s akik k\'e9s\'f5bb lettek h\'edv\'f5k, kiv\'e1ndoroltak \'e9s k\'fczd\'f6ttek veletek egy\'fctt, azok k\'f6z\'fcletek val\'f3k! \'c1m a v\'e9rrokonok el\'f5bbre val\'f3k egym\'e1s sz\'e1m\'e1ra [az \'f6r\'f6k\'f6s\'f6d\'e9st illet\'f5en] Allah 
\'cdr\'e1s\'e1ban. Bizony, Allah minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid7550020 \page }{\b\insrsid3161635\charrsid7550020 9. A b\'fbnb\'e1nat (at-Tauba) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid9993762 
\par 1. Elhat\'e1rol\'f3d\'e1s [ez] Allah \'e9s a K\'fcld\'f6tte r\'e9sz\'e9r\'f5l azokt\'f3l, akikkel egyezs\'e9get k\'f6t\'f6ttetek [az Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3k k\'f6z\'fcl.
\par 2. J\'e1rjatok h\'e1t szabadon a f\'f6ld\'f6n n\'e9gy h\'f3napig, \'e1m tudj\'e1tok meg, hogy nem fogj\'e1tok megakad\'e1lyozni Allahot [semmiben], \'e9s [hogy] Allah bizony a hitetlenek megsz\'e9gyen\'edt\'f5je!
\par 3. \'c9s kihirdet\'e9s [ez] Allaht\'f3l \'e9s a K\'fcld\'f6tt\'e9t\'f5l az emberekhez a Nagy Zar\'e1ndoklat napj\'e1n, hogy Allah elhat\'e1rol\'f3dik [az Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3kt\'f3l, \'e9s a K\'fcld\'f6tte is. \'c1m ha b\'fbnb\'e1
natot tan\'fas\'edtotok, az jobb nektek! \'c1m ha h\'e1tat ford\'edtotok, akkor tudj\'e1tok meg, hogy nem fogj\'e1tok megakad\'e1lyozni Allahot [semmiben]! \'c9s adj h\'edrt azoknak, akik }{\cf1\insrsid3161635\charrsid9993762 hitetlenn\'e9 v\'e1ltak,}{
\insrsid3161635\charrsid9993762  egy f\'e1jdalmas gy\'f6trelemr\'f5l!
\par 4. Kiv\'e9ve azokat [az Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3k k\'f6z\'fcl, akikkel egyezs\'e9get k\'f6t\'f6ttetek, s \'f5k azt k\'f6vet\'f5en nem r\'f6vid\'edtettek meg benneteket semmiben, \'e9s nem seg\'edtettek ellenetek senkit. Vel\'fc
k szemben tarts\'e1tok be az egyezs\'e9get annak lej\'e1rt\'e1ig! Bizony, Allah szereti az istenf\'e9l\'f5ket.
\par 5. \'c1m ha leteltek a tilalmas h\'f3napok (a n\'e9gy h\'f3napnyi halad\'e9k id\'f5tartama), akkor \'f6lj\'e9tek meg [az Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3kat ott, ahol r\'e1juk tal\'e1ltok! Fogj\'e1tok el \'f5ket! Ostromolj\'e1tok \'f5ket! 
\'c1ll\'edtsatok csapd\'e1t nekik minden leshelyr\'f5l! Ha azonban b\'fbnb\'e1natot tan\'fas\'edtanak, megtartj\'e1k az im\'e1dkoz\'e1st \'e9s megadj\'e1k a k\'f6telez\'f5 adom\'e1nyt, akkor engedj\'e9tek \'f5ket \'fatjukra! Bizony, Allah Megbocs\'e1t\'f3
, Irgalmas.
\par 6. Ha pedig a b\'e1lv\'e1nyim\'e1d\'f3k k\'f6z\'fcl valamelyik v\'e9delmet k\'e9r t\'f5led, akkor adj neki v\'e9delmet, hogy meghallhassa Allah szav\'e1t, majd vezesd el a sz\'e1m\'e1ra biztons\'e1gos helyre!ban van Ez az\'e9rt van \'edgy, mivel \'f5
k egy olyan n\'e9p, akik nem rendelkeznek tud\'e1ssal.
\par 
\par 7. Hogyan is lehetne [az Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3knak egyezs\'e9ge Allahhal \'e9s a K\'fcld\'f6tt\'e9vel? Kiv\'e9ve azokat, akikkel a Tilalmas Mecsetn\'e9l k\'f6t\'f6ttetek egyezs\'e9get. Am\'edg betartj\'e1k a veletek [k\'f6t\'f6
tt egyezs\'e9get], addig ti is tarts\'e1tok be a vel\'fck [k\'f6t\'f6tt egyezs\'e9get]! Bizony, Allah szereti az istenf\'e9l\'f5ket.
\par 8. Hogyan is [lehetne egyezs\'e9g\'fck], hiszen ha f\'f6l\'e9tek kerekedn\'e9nek, nem venn\'e9nek figyelembe veletek kapcsolatban sem rokoni k\'f6tel\'e9ket, sem meg\'e1llapod\'e1st. A sz\'e1jukkal elnyerik el\'e9gedetts\'e9geteket, \'e1m a sz\'edv\'fc
k visszautas\'edtja, \'e9s a legt\'f6bbj\'fck engedetlen.
\par 9. Csek\'e9ly \'e1ron k\'f3tyavety\'e9lt\'e9k el Allah jeleit, \'e9s t\'e1vol tartj\'e1k [az embereket] az \'d5 \'datj\'e1t\'f3l. Bizony, milyen rossz az, amit \'f5k cselekedtek!
\par 10. Egy h\'edv\'f5vel kapcsolatban sem vesznek figyelembe rokoni k\'f6tel\'e9ket, sem meg\'e1llapod\'e1st. \'c9s \'f5k a t\'falkap\'e1sra vetemed\'f5k.
\par 11. \'c1m ha b\'fbnb\'e1natot tan\'fas\'edtanak, megtartj\'e1k az im\'e1dkoz\'e1st \'e9s megadj\'e1k a k\'f6telez\'f5 adom\'e1nyt, akkor testv\'e9reitek a vall\'e1sban. \'c9s r\'e9szletesen fejtj\'fck ki a jeleket egy olyan n\'e9
pnek, akik rendelkeznek tud\'e1ssal.
\par 
\par 12. \'c9s ha megszegik esk\'fciket azt k\'f6vet\'f5en, hogy egyezs\'e9get k\'f6t\'f6ttek, \'e9s t\'e1madj\'e1k a vall\'e1sotokat, akkor harcoljatok a hitetlens\'e9g vezet\'f5i ellen - bizony azoknak nincsenek esk\'fcik (sz\'e1mukra a
z nem jelent semmit) - h\'e1tha abbahagyj\'e1k!
\par 13. Vajon nem harcoltok egy olyan n\'e9p ellen, akik megszegt\'e9k esk\'fciket, \'e9s arra t\'f6rekedtek, hogy ki\'fbzz\'e9k a K\'fcld\'f6ttet, \'e9s \'f5k voltak azok, akik az els\'f5 alkalommal kezdt\'e9k [a b\'e1ntalmaz\'e1st] ellenetek? Vajon t\'f5l
\'fck f\'e9ltek, holott Allahot illeti meg legink\'e1bb az, hogy f\'e9lj\'e9tek t\'f5le, ha val\'f3ban h\'edv\'f5k vagytok?
\par 14. Harcoljatok ellen\'fck! Allah gy\'f6trelemmel s\'fajtja \'f5ket a ti kezetek \'e1ltal \'e9s megsz\'e9gyen\'edti \'f5ket, titeket pedig gy\'f5zelemre visz vel\'fck szemben, \'e9s meggy\'f3gy\'edtja a h\'edv\'f5 n\'e9p kebl\'e9t (sz\'edv\'e9t),
\par 15. \'c9s elt\'e1vol\'edtja sz\'edv\'fck d\'fch\'e9t. \'c9s Allah kiengesztel\'f5dik azok ir\'e1nt, akik [ir\'e1nt] akar. \'c9s Allah Mindentud\'f3, B\'f6lcs.
\par 16. Vagy tal\'e1n azt gondolt\'e1tok, hogy [pr\'f3bat\'e9tel n\'e9lk\'fcl] lesztek hagyatva, an\'e9lk\'fcl, hogy Allah nyilv\'e1nval\'f3v\'e1 tenn\'e9 [az embereknek] azt, amit m\'e1r tudott azokr\'f3l, akik k\'fczdenek k\'f6z\'fcletek, \'e9s azokr\'f3
l, akik nem fogadtak Allahon, a K\'fcld\'f6tt\'e9n \'e9s a h\'edv\'f5k\'f6n k\'edv\'fcl senkit bizalmasnak? \'c9s Allah j\'f3l ismeri azt, amit cselekszetek.
\par 
\par 17. [Az Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3k nem tarthatj\'e1k fenn Allah mecseteit, hitetlens\'e9gr\'f5l tan\'faskodva maguk ellen! Azoknak szertefoszlanak a tetteik, \'e9s \'f5k a [Pokol-]t\'fbzben fognak maradni \'f6r\'f6kk\'e9.
\par 18. Allah mecseteinek a fenntart\'e1s\'e1t csak azok v\'e9gezhetik, akik hisznek Allahban \'e9s az Utols\'f3 Napban, megtartj\'e1k az im\'e1dkoz\'e1st \'e9s megadj\'e1k a k\'f6telez\'f5 adom\'e1nyt, \'e9s nem f\'e9lnek m\'e1st\'f3l, csak Allaht\'f3l. Tal
\'e1n azok k\'f6z\'e9 fognak tartozni, akik az [igaz] \'fatra lelnek.
\par 
\par 19. Vajon ugyanolyan [szintre] helyezt\'e9tek a zar\'e1ndokok itat\'e1s\'e1t \'e9s a Tilalmas Mecset fenntart\'e1s\'e1t, mint [annak a hit\'e9t,] aki hisz Allahban \'e9s az Utols\'f3 Napban \'e9s k\'fczd Allah \'fatj\'e1n? Allahn\'e1l ezek nem egyenl\'f5
k. \'c9s Allah nem vezeti igaz \'fatra az igazs\'e1gtalan n\'e9pet.
\par 20. Akik hisznek, kiv\'e1ndoroltak \'e9s k\'fczd\'f6ttek Allah \'datj\'e1n vagyonukkal \'e9s magukkal (\'e9let\'fcket kock\'e1ztatva), azok hatalmasabb fokozaton vannak Allahn\'e1l, \'e9s \'f5k a diadalmasak.
\par 21. \'d6r\'f6mh\'edrt ad nekik az Uruk T\'f5le sz\'e1rmaz\'f3 k\'f6ny\'f6r\'fcletr\'f5l, megel\'e9ged\'e9sr\'f5l, \'e9s kertekr\'f5l [a Paradicsomban], amelyekben \'f6r\'f6kk\'e9 tart\'f3 gy\'f6ny\'f6r\'fbs\'e9g j\'e1r nekik.
\par 22. \'d6r\'f6kk\'f6n-\'f6r\'f6kk\'e9 azokban fognak maradni. Bizony, Allahn\'e1l hatalmas jutalom van!
\par 
\par 23. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne tegy\'e9tek meg ap\'e1itokat \'e9s testv\'e9reiteket p\'e1rtfog\'f3nak, ha \'f5k el\'f5nyben r\'e9szes\'edtik a hitetlens\'e9
get a hittel szemben! Akik p\'e1rtfog\'f3nak teszik meg \'f5ket k\'f6z\'fcletek, h\'e1t azok az igazs\'e1gtalanok.
\par 24. Mondd [\'f3 Mohamed]: \'84Ha az ap\'e1itok, a fiaitok, a testv\'e9reitek, a h\'e1zast\'e1rsaitok, a nemzets\'e9getek, a vagyonok, melyekre szert tettetek, a keresked\'e9s, amelynek pang\'e1s\'e1t\'f3l f\'e9ltek, \'e9s a lakhelyei
tek, amelyekkel meg vagytok el\'e9gedve, kedvesebbek nektek Allahn\'e1l \'e9s a K\'fcld\'f6tt\'e9n\'e9l \'e9s az \'d5 \'fatj\'e1n val\'f3 k\'fczdelemn\'e9l, akkor v\'e1rjatok, m\'edg Allah el nem hozza a parancs\'e1t [a b\'fcntet\'e9sr\'f5l]! \'c9
s Allah nem vezeti igaz \'fatra az engedetlen n\'e9pet!\'94
\par 
\par 25. Bizony, Allah m\'e1r sz\'e1mos csatamez\'f5n vitt titeket gy\'f5zelemre, \'e9s Hunajn napj\'e1n [is]. Amikor tetszett nektek a sokas\'e1gotok, \'e1m az mit sem haszn\'e1lt nektek, a t\'e1gas f\'f6ld pedig sz\'fbk\'f6ss\'e9 v\'e1lt sz\'e1motokra, azut
\'e1n h\'e1tat ford\'edtottatok menek\'fclve.
\par 26. Azut\'e1n Allah T\'f5le val\'f3 nyugalmat bocs\'e1tott le a K\'fcld\'f6tt\'e9re \'e9s a h\'edv\'f5kre, \'e9s olyan katon\'e1kat bocs\'e1tott le, amelyeket nem l\'e1ttatok, \'e9s gy\'f6trelemmel s\'fajtotta azokat, akik hitetlenn\'e9 v\'e1ltak. \'c9
s ez a hitetlenek fizets\'e9ge.
\par 27. Majd azut\'e1n Allah kiengesztel\'f5dik azok ir\'e1nt, akik [ir\'e1nt] akar. \'c9s Allah Megbocs\'e1t\'f3, Irgalmas.
\par 
\par 28. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! A t\'e1rsistent \'e1ll\'edt\'f3k tiszt\'e1talanok, \'edgy h\'e1t ne k\'f6zel\'edts\'e9k a Tilalmas Mecsetet ez ut\'e1n az \'e9v ut\'e1
n! Ha pedig szeg\'e9nys\'e9gt\'f5l f\'e9ltek, h\'e1t Allah gazdagg\'e1 fog tenni titeket az \'f5 kegy\'e9b\'f5l, ha \'fagy akarja. Bizony, Allah Mindentud\'f3, B\'f6lcs!
\par 29. Harcoljatok azok ellen, akik nem hisznek Allahban, sem az Utols\'f3 Napban, \'e9s nem tartj\'e1k tilalmasnak azt, amit Allah \'e9s a k\'fcld\'f6tte tilalmass\'e1 tett, \'e9s nem vallj\'e1k az Igazs\'e1g vall\'e1s\'e1t (az iszl\'e1mot) azok k\'f6z\'fc
l [az ellenetek harcol\'f3k k\'f6z\'fcl], akiknek az \'cdr\'e1s adatott \endash  addig, am\'edg meg nem adj\'e1k a fejad\'f3t a kez\'fckkel (szem\'e9lyesen), mik\'f6zben al\'e1vetettek!
\par 
\par 30. \'c9s azt mondt\'e1k a zsid\'f3k: \'84Uzair Allah fia!\'94 A kereszt\'e9nyek pedig azt mondt\'e1k: \'84A Messi\'e1s Allah fia!\'94 Ez csak a sz\'e1jukkal val\'f3 mond\'e1suk. Ut\'e1nozz\'e1k azok besz\'e9d\'e9t, akik hitetlenn\'e9 v\'e1ltak kor\'e1
bban. Allah \'e1tka legyen rajtuk! Hogyan lehetnek h\'e1t elt\'e9r\'edtve [az igazs\'e1gt\'f3l]?
\par 31. \'cdr\'e1stud\'f3ikat \'e9s szerzeteseiket [im\'e1dott] uraikk\'e1 tett\'e9k Allah helyett, \'e9s M\'e1ria fi\'e1t, a Messi\'e1st. \'c1m \'f5k nem kaptak parancsot m\'e1sra, mint hogy Egy Istent szolg\'e1ljanak. Nincs m\'e1s [jogosan im\'e1dhat\'f3
] isten Rajta k\'edv\'fcl! Magasztaltass\'e9k \'d5! [\'d5 afelett van], amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [\'d5mell\'e9].
\par 
\par 32. El akarj\'e1k oltani a sz\'e1jukkal Allah vil\'e1goss\'e1g\'e1t, \'e1m Allah rend\'edthetetlen abban, hogy kiteljes\'edtse a vil\'e1goss\'e1g\'e1t, m\'e9g ha ez ut\'e1latos is a hitetleneknek.
\par 33. \'d5 az, aki elk\'fcldte a K\'fcld\'f6tt\'e9t az \'fatmutat\'e1ssal \'e9s az igaz vall\'e1ssal, hogy azt a t\'f6bbi vall\'e1s f\'f6l\'e9 helyezze, m\'e9g ha ez ut\'e1latos is a t\'e1rsistent \'e1ll\'edt\'f3knak.
\par 
\par 34. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Bizony, sok \'edr\'e1stud\'f3 \'e9s szerzetes falja fel jogtalanul az emberek vagyon\'e1t, \'e9s t\'e1vol tartanak [m\'e1sokat] Allah \'fa
tj\'e1t\'f3l. \'c9s azoknak, akik felhalmozz\'e1k az aranyat \'e9s az ez\'fcst\'f6t, \'e9s nem k\'f6ltik el Allah \'fatj\'e1n, adj h\'e1t h\'edrt nekik f\'e1jdalmas gy\'f6trelemr\'f5l!
\par 35. Azon a napon, amikor felhev\'edttetnek [a felhalmozott kincsek] a Gyehenna t\'fcz\'e9ben, \'e9s a homlokukat, az oldalukat \'e9s a h\'e1tukat megb\'e9lyegzik azokkal, [az lesz nekik mondva:] \'84Ezt halmozt\'e1tok fel magatoknak, \'edzlelj\'e9tek h
\'e1t meg azt, mit felhalmoztatok!\'94
\par 
\par 36. Bizony, a h\'f3napok sz\'e1ma Allahn\'e1l tizenk\'e9t h\'f3nap Allah \'cdr\'e1s\'e1ban (az \'d5rz\'f6tt T\'e1bl\'e1n), [amelyet] azon a napon [rendelt el], amikor megteremtette az egeket \'e9s a f\'f6ldet, ezek k\'f6z\'fcl n\'e9gy tilalmas [h\'f3
nap]. Ez az egyenes (szil\'e1rd al}{\cs89\insrsid3161635\charrsid9993762 apokon nyugv\'f3) }{\insrsid3161635\charrsid9993762 vall\'e1s! Ne tegyetek h\'e1t azokban igazs\'e1gtalans\'e1got magatok ellen! \'c9s harcoljatok mindannyian a t\'e1rsistent \'e1ll
\'edt\'f3k ellen, ahogyan azok is harcolnak ellenetek valamennyien! \'c9s tudj\'e1tok meg, hogy Allah az istenf\'e9l\'f5kkel van!
\par 37. Az elhalaszt\'e1sa [a tilalmas h\'f3napnak] csup\'e1n gyarapod\'e1s a hitetlens\'e9gben. \'c1ltala ker\'fclnek t\'e9velyg\'e9sbe azok, akik hitetlenn\'e9 v\'e1ltak. Az egyik \'e9vben megengedett\'e9 teszik azt, a m\'e1sikban tilalmass\'e1 teszik az
\'e9rt, hogy kiegyenl\'edts\'e9k a sz\'e1m\'e1t azoknak [a h\'f3napoknak], amelyeket Allah tilalmass\'e1 tett, \'e9s \'edgy megengedett\'e9 teszik azt, amit Allah tilalmass\'e1 tett. D\'edszess\'e9 t\'e9tettek sz\'e1
mukra rossz tetteik. Allah azonban nem vezeti igaz \'fatra a hitetlen n\'e9pet.
\par 
\par 38. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Mi lelt titeket, hogy a f\'f6ldh\'f6z tapadtok, amikor az mondatott nektek: \'84Vonuljatok harcba Allah \'datj\'e1n!\'94 Vajon el\'e9
gedettek vagytok az evil\'e1gi \'e9lettel, szemben a t\'falvil\'e1ggal? \'c1m az evil\'e1g [muland\'f3] \'e9lvezete csek\'e9ly a t\'falvil\'e1g\'e9hoz k\'e9pest.
\par 39. Ha nem vonultok harcba, f\'e1jdalmas gy\'f6trelemmel fog b\'fcntetni titeket, \'e9s egy m\'e1sik n\'e9ppel cser\'e9l fel benneteket. Ti nem lehettek az \'d5 \'e1rtalm\'e1ra semmiben, \'e9s Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 40. Ha ti nem seg\'edtetek neki (Mohamednek), [akkor Allah seg\'edteni fog]. Hiszen Allah m\'e1r seg\'edtett neki, amikor azok, akik hitetlenn\'e9 v\'e1ltak el\'fbzt\'e9k \'f5t m\'e1sodmag\'e1val, akkor, amikor \'f5k ketten a barlangban voltak, s mikor 
\'f5 azt mondta a t\'e1rs\'e1nak: \'84Ne l\'e9gy szomor\'fa! Bizony, Allah vel\'fcnk van!\'94 Allah akkor lebocs\'e1totta r\'e1 a T\'f5le val\'f3 nyugalmat, \'e9s seg\'edtett neki [angyali] katon\'e1kkal, amelyeket nem l\'e1thattatok. Azok szav\'e1
t pedig, akik hitetlenn\'e9 v\'e1ltak a legalantasabb\'e1 tette. \'c9s Allah szava pedig a legmagasztosabb. \'c9s Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.
\par 
\par 41. Vonuljatok h\'e1t harcba k\'f6nnyen (fiatalon) \'e9s nehezen (id\'f5sen)! K\'fczdjetek h\'e1t vagyonotokkal \'e9s magatokkal (\'e9leteteket kock\'e1ztatva) Allah \'fatj\'e1n! Ez jobb nektek, ha val\'f3ban rendelkeztek tud\'e1ssal.
\par 
\par 42. Ha k\'f6zeli haszonr\'f3l, \'e9s k\'f6nnyed utaz\'e1sr\'f3l lenne sz\'f3, bizony k\'f6vetn\'e9nek t\'e9ged. \'c1m t\'e1volinak t\'fbnt nekik a messzes\'e9g. \'c9s meg fognak esk\'fcdni Allahra: \'84Ha lett volna k\'e9pess\'e9g\'fc
nk, bizony kivonultunk volna veletek.\'94 Pusztul\'e1sba vetik magukat! \'c9s Allah tudja, hogy \'f5k bizony hazugok.
\par 43. Bocs\'e1sson meg Allah neked! Mi\'e9rt adt\'e1l enged\'e9lyt nekik, am\'edg nem v\'e1lt vil\'e1goss\'e1 sz\'e1modra, hogy kik azok, akik igazat sz\'f3ltak, \'e9s megismerted a hazugokat?
\par 44. Nem k\'e9rnek t\'f5led enged\'e9lyt (felment\'e9st) azok, akik hisznek Allahban, \'e9s az Utols\'f3 napban, az al\'f3l, hogy k\'fczdjenek vagyonukkal \'e9s magukkal (\'e9let\'fcket kock\'e1ztatva). Allahnak tudom\'e1sa van az istenf\'e9l\'f5kr\'f5l.

\par 45. Csup\'e1n azok k\'e9rnek t\'f5led enged\'e9lyt (felment\'e9st a harc al\'f3l), akik nem hisznek Allahban \'e9s az Utols\'f3 Napban. \'c9s k\'e9ts\'e9g gy\'f6tri a sz\'edv\'fcket, \'edgy \'f5k a k\'e9ts\'e9g\'fckben ingadoznak.
\par 46. \'c9s ha ki akartak volna vonulni, akkor bizony el\'f5k\'e9sz\'fcltek volna el\'f5k\'e9sz\'fclettel. \'c1m Allahnak ut\'e1latos volt az \'f5 felkereked\'e9s\'fck, ez\'e9rt elkedvetlen\'edtette \'f5ket, \'e9s az mondatott nekik: \'84
Maradjatok otthon az [otthon-] marad\'f3kkal!\'94
\par 47. Ha kivonultak volna veletek, nem gyarap\'edtottak volna titeket, csup\'e1n z\'fbrzavarban \'e9s [pletyk\'e1lkodva] j\'e1rk\'e1ltak volna k\'f6z\'f6ttetek a a k\'eds\'e9rt\'e9st (a sz\'e9th\'faz\'e1st) k\'edv\'e1nv\'e1n nektek. \'c9s vannak k\'f6z\'f6
ttetek olyanok, akik hallgatnak r\'e1juk. \'c9s Allahnak tudom\'e1sa van az igazs\'e1gtalanokr\'f3l.
\par 48. M\'e1r kor\'e1bban is a a k\'eds\'e9rt\'e9st (a sz\'e9th\'faz\'e1st) kerest\'e9k, \'e9s felforgatt\'e1k neked a dolgokat [hogy c\'e1folj\'e1k azt, amit elhozt\'e1l], m\'edgnem elj\'f6tt az igazs\'e1g, \'e9s l\'e1that\'f3v\'e1 v\'e1
lt Allah parancsa, mik\'f6zben \'f5k ut\'e1lj\'e1k ezt.
\par 49. \'c9s van k\'f6z\'f6tt\'fck olyan, aki azt mondja: \'84Adj nekem enged\'e9lyt (felment\'e9st a harc al\'f3l), \'e9s ne tegy\'e9l ki engem k\'eds\'e9rt\'e9snek!\'94 L\'e1m, m\'e1r k\'eds\'e9rt\'e9sbe estek! \'c9s bizony, a Gyehenna k\'f6r\'fc
lveszi a hitetleneket.
\par 
\par 50. Ha valami j\'f3 \'e9r t\'e9ged, az elszomor\'edtja \'f5ket, \'e1m ha csap\'e1s s\'fajt t\'e9ged, akkor azt mondj\'e1k: \'84M\'e1r gondoskodtunk az \'fcgy\'fcnkr\'f5l kor\'e1bban.\'94 \'c9s h\'e1tat ford\'edtanak, mik\'f6zben \'f6rvendeznek.
\par 51. Mondd [\'f3 Mohamed]: \'84Csup\'e1n az fog \'e9rni minket, amit Allah meg\'edrt a sz\'e1munkra. \'d5 a mi P\'e1rtfog\'f3nk! \'c9s Allahra hagyatkozzanak h\'e1t a h\'edv\'f5k!\'94
\par 52. Mondd [\'f3 Mohamed]: \'84Vajon mi m\'e1st v\'e1rtok nek\'fcnk, mint a k\'e9t legszebb dolog k\'f6z\'fcl az egyiket? \'c9s mi a sz\'e1motokra azt v\'e1rjuk, hogy Allah T\'f5le sz\'e1rmaz\'f3 vagy a mi kez\'fcnk \'e1ltali gy\'f6trelemmel s\'fa
jtson titeket! V\'e1rjatok h\'e1t, bizony mi is veletek v\'e1runk!\'94
\par 
\par 53. Mondd [\'f3 Mohamed]: \'84Adakozzatok \'f6nk\'e9nt \'e9s k\'e9nyszerb\'f5l, \'fagysem fogadtatik el t\'f5letek! Bizony, ti engedetlen n\'e9p vagytok!\'94
\par 54. Nem volt m\'e1s akad\'e1lya annak, hogy adom\'e1nyuk elfogadtasson, csup\'e1n az, hogy hitetlenn\'e9 v\'e1ltak Allahhal \'e9s a K\'fcld\'f6tt\'e9vel szemben. Nem mennek im\'e1dkozni csup\'e1n lust\'e1n, \'e9s nem adakoznak m\'e1sk\'e9nt, csak ut\'e1
lattal.
\par 55. H\'e1t ne tetsszen neked a vagyonuk \'e9s a gyermekeik! Allah csup\'e1n azt akarja, hogy megb\'fcntesse \'f5ket az evil\'e1gi \'e9letben \'e1ltaluk, \'e9s hogy hitetlenk\'e9nt sz\'e1lljon el a lelk\'fck.
\par 
\par 56. \'c9s megesk\'fcsznek [a k\'e9pmutat\'f3k] Allahra, hogy \'f5k hozz\'e1tok tartoznak, \'e1m \'f5k val\'f3j\'e1ban nem tartoznak hozz\'e1tok. \'d5k egy olyan n\'e9p, akik f\'e9lelemb\'f5l cselekszenek.
\par 57. Ha valami mened\'e9khelyet tal\'e1ln\'e1nak, vagy \'fcregeket, vagy rejtekhelyet, akkor oda forduln\'e1nak, mik\'f6zben rohanva menek\'fclnek.
\par 58. \'c9s van k\'f6z\'f6tt\'fck olyan, aki r\'e1galmaz t\'e9ged az adom\'e1nyokkal (azok eloszt\'e1s\'e1val) kapcsolatban. Ha \'f5k is kapnak bel\'f5le, akkor el\'e9gedettek, \'e1m ha nem kapnak bel\'f5le, akkor \'edme, \'f5k feld\'fch\'f6dnek.
\par 59. \'c9s [jobb lett volna,] ha el\'e9gedettek lettek volna azzal, amit Allah \'e9s a K\'fcld\'f6tte adott nekik \'e9s azt mondan\'e1k: \'84Allah elegend\'f5 sz\'e1munkra! Allah a kegy\'e9b\'f5l fog majd adni nek\'fcnk, \'e9s a K\'fcld\'f6
tte is. Mi bizony Allah [kegyei] ut\'e1n v\'e1gyakozunk.\'94
\par 
\par 60. Az adom\'e1nyok csup\'e1n a nincstelenek\'e9, a szeg\'e9nyek\'e9, azok\'e9, akik az \'f6sszegy\'fbjt\'e9s\'e9vel meg vannak b\'edzva, azok\'e9, akik sz\'edv\'e9t meg kell nyerni. \'c9s [ford\'edtand\'f3] a rabszolg\'e1kra (azok felszabad\'edt\'e1s\'e1
ra), az elad\'f3sodottakra (terheik enyh\'edt\'e9s\'e9re), Allah \'datj\'e1ra \'e9s az utaz\'f3kra. El\'f5\'edr\'e1sk\'e9nt Allaht\'f3l! \'c9s Allah Mindentud\'f3, B\'f6lcs!
\par 61. \'c9s vannak k\'f6z\'f6tt\'fck olyanok, akik megb\'e1ntj\'e1k a Pr\'f3f\'e9t\'e1t, \'e9s azt mondj\'e1k [r\'f3la]: \'84\'d5 [mindenkire] hallgat!\'94 Mondd [\'f3 Mohamed]: \'84[a Pr\'f3f\'e9ta, olyasvalaki, aki] minden j\'f3ra hallgat [ami kedvez\'f5
] sz\'e1motokra, hisz Allahban \'e9s hisz a h\'edv\'f5knek, \'e9s k\'f6ny\'f6r\'fclet azoknak, akik hisznek k\'f6z\'fcletek.\'94 \'c1m akik megb\'e1ntj\'e1k Allah K\'fcld\'f6tt\'e9t, azoknak f\'e1jdalmas gy\'f6trelem j\'e1r!
\par 
\par 62. Megesk\'fcsznek nektek Allahra, hogy elnyerj\'e9k a megel\'e9ged\'e9seteket. \'c1m Allahot \'e9s a K\'fcld\'f6tt\'e9t illeti meg legink\'e1bb az, hogy a megel\'e9ged\'e9s\'fcket elnyerj\'e9k, ha \'f5k [val\'f3ban] h\'edv\'f5k.
\par 63. Vajon nem tudj\'e1k, hogy annak, aki szembesz\'e1ll Allahhal \'e9s a K\'fcld\'f6tt\'e9vel, bizony a Gyehenna t\'fcze j\'e1r, [\'e9s] \'f6r\'f6kk\'e9 abban fognak maradni? Ez a hatalmas megsz\'e9gyen\'edt\'e9s.
\par 64. A k\'e9pmutat\'f3k att\'f3l tartanak, hogy lebocs\'e1ttatik vel\'fck kapcsolatban egy sz\'fara, mely h\'edr\'fcl adja azt, ami a sz\'edv\'fckben van. Mondd [\'f3 Mohamed]: \'84G\'fanyol\'f3djatok csak! Allah felsz\'ednre hozza azt, amit\'f5l tartotok.
\'94
\par 65. \'c9s bizony, ha megk\'e9rdezed \'f5ket [err\'f5l], biztosan azt mondj\'e1k: \'84Mi csup\'e1n [\'fcres fecseg\'e9sbe] elegyedt\'fcnk \'e9s sz\'f3rakoztunk!\'94 Mondd [\'f3 Mohamed]: \'84Vajon Allahon, az \'d5 jelein \'e9s a K\'fcld\'f6tt\'e9n g\'fa
nyol\'f3dtatok?\'94
\par 66. Ne menteget\'f5zzetek! M\'e1r hitetlenn\'e9 v\'e1ltatok, miut\'e1n hittetek. Ha megbocs\'e1tunk egy csoportnak k\'f6z\'fcletek, gy\'f6trelemmel s\'fajtunk egy m\'e1sik csoportot, mivel \'f5k gonosztev\'f5k voltak.
\par 
\par 67. A k\'e9pmutat\'f3 f\'e9rfiak \'e9s a k\'e9pmutat\'f3 n\'f5k \endash  egyik olyan mint a m\'e1sik \endash  felsz\'f3l\'edtanak az elvetend\'f5re \'e9s megtiltj\'e1k a hely\'e9nval\'f3t. \'d6sszeszor\'edtj\'e1k a kez\'fc
ket (nem adakoznak). Elfeledkeztek Allahr\'f3l, \'edgy \'d5 is elfeledkezett r\'f3luk. Bizony, a k\'e9pmutat\'f3k az engedetlenek.
\par 68. Allah \'edg\'e9retet tett a k\'e9pmutat\'f3 f\'e9rfiaknak \'e9s a k\'e9pmutat\'f3 n\'f5knek \'e9s a hitetleneknek a Gyehenna t\'fcz\'e9re, [hogy] \'f5k \'f6r\'f6kk\'e9 abban fognak maradni. Ez elegend\'f5 lesz sz\'e1mukra! \'c9s Allah [kor\'e1bban m
\'e1r] meg\'e1tkozta \'f5ket, \'e9s nekik \'f6r\'f6kk\'e9 tart\'f3 gy\'f6trelem j\'e1r.
\par 
\par 69. [\'d3 ti, k\'e9pmutat\'f3k \'e9s hitetlenek] olyanok [vagytok], mint azok, akik el\'f5ttetek \'e9ltek. Er\'f5sebbek voltak, mint ti, nagyobb vagyonnal \'e9s t\'f6bb gyermekkel rendelkeztek, \'e9s \'e9lvezt\'e9k r\'e9szes\'fcl\'e9s\'fcket [az evil\'e1
gb\'f3l]. Ti is \'e9lvezitek a r\'e9szes\'fcl\'e9seteket, ahogyan azok is \'e9lvezt\'e9k a r\'e9szes\'fcl\'e9s\'fcket, akik el\'f5ttetek \'e9ltek. Ti is hazug besz\'e9dbe elegyedtetek, ahogyan \'f5k is hazug besz\'e9
dbe elegyedtek. Azoknak szertefoszlanak a cselekedeteik evil\'e1gon \'e9s t\'falvil\'e1gon. \'c9s \'f5k bizony a vesztesek.
\par 70. Vajon nem \'e9rkezett el hozz\'e1juk azoknak a h\'edre, akik el\'f5tt\'fck \'e9ltek: No\'e9 n\'e9p\'e9\'e9, \'c1d-\'e9, Tam\'fad\'e9, \'e9s \'c1brah\'e1m n\'e9p\'e9\'e9 \'e9s Midi\'e1n lak\'f3i\'e9 \'e9s az elpuszt\'edtott v\'e1rosok [lak\'f3i\'e9
]? Elj\'f6ttek hozz\'e1juk a k\'fcld\'f6tteik a vil\'e1gos bizony\'edt\'e9kokkal. Allah sosem volt igazs\'e1gtalan vel\'fck, hanem \'f5k voltak \'f6nmagukkal igazs\'e1gtalanok.
\par 
\par 71. \'c9s a h\'edv\'f5 f\'e9rfiak \'e9s a h\'edv\'f5 n\'f5k, egyik\'fck a m\'e1sik p\'e1rtfog\'f3ja. Felsz\'f3l\'edtanak a hely\'e9nval\'f3ra \'e9s megtiltj\'e1k az elvetend\'f5t, \'e9s megtartj\'e1k az im\'e1dkoz\'e1st, \'e9s megadj\'e1k a k\'f6telez\'f5
 adom\'e1nyt, \'e9s engedelmeskednek Allahnak \'e9s a K\'fcld\'f6tt\'e9nek. Azokon Allah meg fog k\'f6ny\'f6r\'fclni. Bizony, Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.
\par 72. Allah \'edg\'e9retet tett a h\'edv\'f5 f\'e9rfiaknak \'e9s a h\'edv\'f5 n\'f5knek kertekr\'f5l [a Paradicsomban] - amelyek al\'f3l foly\'f3k folynak \endash ,  \'f6r\'f6kk\'e9 abban fognak maradni, \'e9s j\'f3 lakhelyekr\'f5l \'f6r\'f6kk\'e9 tart\'f3
 kertekben. \'c9s az Allaht\'f3l sz\'e1rmaz\'f3 megel\'e9ged\'e9s [m\'e9g ann\'e1l is] nagyobb! Ez a hatalmas diadal!
\par 
\par 73. \'d3 Pr\'f3f\'e9ta! K\'fczdj a hitetlenek \'e9s a k\'e9pmutat\'f3k ellen, \'e9s legy\'e9l kem\'e9ny vel\'fck! \'c9s a Gyehenna lesz a hajl\'e9kuk, \'e9s milyen nyomor\'fas\'e1gos v\'e9gc\'e9l!
\par 74. Megesk\'fcsznek Allahra, hogy nem mondtak [semmit], \'e1m bizony kimondt\'e1k m\'e1r a hitetlens\'e9g szav\'e1t. Hitetlenn\'e9 v\'e1ltak miut\'e1n az iszl\'e1mot k\'f6vett\'e9k, \'e9s arra t\'f6rekedtek, amit nem tudtak el\'e9rni. \'c1m csup\'e1
n az bosszantotta \'f5ket, hogy Allah \'e9s a K\'fcld\'f6tte gazdagg\'e1 tette azokat (a muszlimokat) az \'d5 kegy\'e9b\'f5l. Ha b\'fbnb\'e1natot tan\'fas\'edtanak, az jobb nekik. \'c1m ha h\'e1tat ford\'edtanak, Allah f\'e1jdalmas gy\'f6
trelemmel fogja megb\'fcnteti \'f5ket az evil\'e1gon \'e9s a t\'falvil\'e1gon. \'c9s nem lesz nekik a f\'f6ld\'f6n sem p\'e1rtfog\'f3juk, sem seg\'edt\'f5j\'fck.
\par 
\par 75. Vannak k\'f6z\'f6tt\'fck olyanok, akik egyezs\'e9get k\'f6t\'f6ttek Allahhal: \'84Ha ad nek\'fcnk az \'d5 kegy\'e9b\'f5l, akkor mi bizony adakozni fogunk, \'e9s a j\'f3 emberek k\'f6z\'e9 fogunk tartozni.\'94
\par 76. \'c1m miut\'e1n adott nekik az \'d5 kegy\'e9b\'f5l, \'f5k fukarkodtak azzal \'e9s h\'e1tat ford\'edtottak, mik\'f6zben \'fcgyet sem vetnek [a j\'f3t\'e9konykod\'e1sra].
\par 77. Ezut\'e1n [b\'fcntet\'e9s\'fcl m\'e9g nagyobb] k\'e9pmutat\'e1st helyezett a sz\'edv\'fckbe addig a napig, mikor tal\'e1lkozni fognak Vele, amiatt, hogy megszegt\'e9k azt, amit Allahnak \'edg\'e9rtek, \'e9s az\'e9rt is, mert hazugok voltak.
\par 78. Vajon nem tudj\'e1k, hogy Allah tudja az \'f5 titkukat \'e9s bizalmas besz\'e9lget\'e9s\'fcket? \'c9s Allah bizony a rejtett dolgok ismer\'f5je!
\par 79. Azok, akik r\'e1galmazz\'e1k a h\'edv\'f5ket, [azokat] akik \'f6nk\'e9nt adnak adom\'e1nyt, \'e9s azokat, akik nem tal\'e1lnak m\'e1st, csak az igyekezet\'fcket, \'e9s g\'fanyol\'f3dnak rajtuk, azokon Allah fog g\'fanyol\'f3dni, \'e9s nekik f\'e1
jdalmas gy\'f6trelem j\'e1r!
\par 80. K\'e9rj megbocs\'e1t\'e1st sz\'e1mukra, vagy ne k\'e9rj megbocs\'e1t\'e1st sz\'e1mukra; m\'e9g ha hetvenszer is k\'e9rsz megbocs\'e1t\'e1st sz\'e1mukra, Allah akkor sem fog nekik megbocs\'e1tani! Ez az\'e9rt van \'edgy, mert hitetlenn\'e9 v\'e1ltak A
llahhal \'e9s a K\'fcld\'f6tt\'e9vel szemben. \'c9s Allah nem vezeti igaz \'fatra az engedetlen n\'e9pet!
\par 
\par 81. Akik h\'e1trahagyattak [a tab\'faki csata idej\'e9n] \'f6rvendeztek}{\insrsid3161635\delrsid13722256\charrsid9993762  }{\insrsid3161635\charrsid9993762 annak, hogy Allah K\'fcld\'f6tt\'e9vel ellent\'e9tben otthon maradtak, \'e9s ut\'e1lt\'e1
k azt, hogy k\'fczdjenek a vagyonukkal \'e9s magukkal (\'e9let\'fcket kock\'e1ztatva) Allah \'fatj\'e1n, \'e9s azt mondt\'e1k: \'84Ne vonuljatok harcba a h\'f5s\'e9gben!\'94 Mondd [\'f3 Mohamed]: \'84A Gyehenna t\'fcze forr\'f3bb!\'94 B\'e1rcsak \'e9rten
\'e9nek!
\par 82. Nevessenek h\'e1t egy keveset [az evil\'e1gon], \'e9s s\'edrjanak majd sokat [a t\'falvil\'e1gon], fizets\'e9g\'fcl az\'e9rt, amit szereztek!
\par 83. Ha Allah visszavisz t\'e9ged egy csoporthoz k\'f6z\'fcl\'fck, \'e9s \'f5k enged\'e9lyt fognak k\'e9rni t\'f5led a kivonul\'e1sra, akkor mondd [\'f3 Mohamed]: \'84Ti soha nem fogtok kivonulni velem, \'e9s nem fogtok velem egy\'fctt az ellens\'e9
ggel szemben harcolni. Ti bizony megel\'e9gedtetek az otthon\'fcl\'e9ssel az els\'f5 alkalommal, \'fcljetek csak otthon azokkal, akik h\'e1tra maradtak!\'94
\par 84. \'c9s ha valaki meghal k\'f6z\'fcl\'fck, soha ne im\'e1dkozz \'e9rte, s ne \'e1llj meg a s\'edrj\'e1n\'e1l! Bizony, \'f5k hitetlenn\'e9 v\'e1ltak Allahhal \'e9s a K\'fcld\'f6tt\'e9vel szemben, \'e9s \'fagy haltak meg, hogy engedetlenek voltak.
\par 85. \'c9s ne tetsszen neked a vagyonuk \'e9s a gyermekeik! Allah csup\'e1n azt akarja, hogy megb\'fcntesse \'f5ket \'e1ltaluk az evil\'e1gon, \'e9s hogy hitetlenk\'e9nt sz\'e1lljon el a lelk\'fck.
\par 
\par 86. \'c9s ha lebocs\'e1ttatik egy sz\'fara azzal, hogy: \'84Higgyetek Allahban \'e9s k\'fczdjetek az \'d5 k\'fcld\'f6tte mellett!\'94, a tehet\'f5sek k\'f6z\'fcl\'fck enged\'e9lyt k\'e9rnek t\'f5led, \'e9s azt mondj\'e1k: \'84Hadd legy\'fcnk az otthon\'fc
l\'f5kkel!\'94
\par 87. Megel\'e9gedtek azzal, hogy azokkal legyenek, akik h\'e1tra maradtak. Lepecs\'e9teltetett a sz\'edv\'fck, \'e9s [\'edme] \'f5k nem \'e9rtenek.
\par 
\par 88. A K\'fcld\'f6tt azonban \'e9s akik vele egy\'fctt hisznek, k\'fczdenek a vagyonukkal \'e9s magukkal (\'e9let\'fcket kock\'e1ztatva). \'c9s azokat illetik meg a j\'f3 dolgok, \'e9s \'f5k azok, akik boldogulnak.
\par 89. Allah kerteket k\'e9sz\'edtett el\'f5 a sz\'e1mukra [a Paradicsomban], amelyek al\'f3l foly\'f3k folynak, \'f6r\'f6kk\'e9 abban fognak maradni. Ez a hatalmas diadal!
\par 
\par 90. \'c9s elj\'f6ttek azok, akik menteget\'f5ztek a beduinok k\'f6z\'fcl, az\'e9rt hogy enged\'e9lyt kapjanak (felment\'e9st a harc al\'f3l), \'e9s [indok n\'e9lk\'fcl] otthon \'fcltek azok, akik hazudtak Allahnak \'e9s a K\'fcld\'f6tt\'e9nek. F\'e1
jdalmas gy\'f6trelem fogja \'e9rni azokat, akik hitetlenn\'e9 v\'e1ltak k\'f6z\'fcl\'fck.
\par 91. Ne \'e9rezzenek fesz\'e9lyezetts\'e9get [az otthonmarad\'e1s miatt] a gyeng\'e9k, sem a betegek, sem azok, akik nem tal\'e1lnak semmit, amit k\'f6lthetn\'e9nek, ha \'f5szint\'e9n engedelmeskednek Allahnak \'e9s az \'d5 k\'fcld\'f6tt\'e9nek! A j\'f3tev
\'f5kkel szemben nincs m\'f3d [a szemreh\'e1ny\'e1sra]. \'c9s Allah Megbocs\'e1t\'f3, Irgalmas.
\par 92. \'c9s azok se, akiknek \endash  mikor elj\'f6ttek hozz\'e1d, hogy [harcba] vidd \'f5ket [magaddal] \endash  azt mondtad: \'84Nem tal\'e1lok semmit, amin elvihetn\'e9lek titeket\'94, akkor h\'e1tat ford\'edtottak, mik\'f6zben k\'f6nnybe l\'e1
badt a szem\'fck a szomor\'fas\'e1gt\'f3l amiatt, hogy nem tal\'e1lnak semmit, amit k\'f6lthetnek.
\par 93. Csup\'e1n azok ellen van m\'f3d [a szemreh\'e1ny\'e1sra], akik enged\'e9lyt k\'e9rnek t\'f5led, holott \'f5k gazdagok. Megel\'e9gedtek azzal, hogy a h\'e1tramarad\'f3kkal legyenek. \'c9s Allah lepecs\'e9telte a sz\'edv\'fcket \'e9s [\'edme] \'f5
k nem rendelkeznek tud\'e1ssal.
\par 94. Menteget\'f5zni fognak nektek, amikor visszat\'e9rtek hozz\'e1juk. Mondd [\'f3 Mohamed]: \'84Ne menteget\'f5zzetek! Nem fogunk hinni nektek! Allah m\'e1r h\'edr\'fcl adott nek\'fcnk [n\'e9melyeket] a r\'f3latok sz\'f3l\'f3 h\'edrekb\'f5l. \'c9
s Allah l\'e1tni fogja a tetteiteket \'e9s az \'d5 k\'fcld\'f6tte is. Azut\'e1n a rejtett \'e9s a l\'e1that\'f3 [dolgok] Tud\'f3ja el\'e9 vitettek, \'e9s \'d5 h\'edr\'fcl fogja majd adni nektek, amit cselekedtetek.\'94
\par 95. Megesk\'fcsznek nektek Allahra, amikor visszat\'e9rtek [a harcb\'f3l] hozz\'e1juk az\'e9rt, hogy [sz\'e1monk\'e9r\'e9s n\'e9lk\'fcl] forduljatok el t\'f5l\'fck. Forduljatok h\'e1t el t\'f5l\'fck! Bizony, \'f5k [maguk a] f\'f6rtelmess\'e9
g! A Gyehenna lesz a hajl\'e9kuk, fizets\'e9g\'fcl az\'e9rt, amit szereztek!
\par 96. Megesk\'fcsznek nektek, hogy el\'e9gedettek legyetek vel\'fck. \'c1m ha el\'e9gedettek vagytok vel\'fck, h\'e1t Allah bizony nem el\'e9gedett az engedetlen n\'e9ppel.
\par 
\par 97. A beduinok meg\'e1talkodottabbak a hitetlens\'e9gben \'e9s a k\'e9pmutat\'e1sban, \'e9s hajlamosabbak arra, hogy ne rendelkezzenek tud\'e1ssal a hat\'e1rair\'f3l annak, amit Allah bocs\'e1tott le a K\'fcld\'f6tt\'e9nek. \'c9s Allah Mindentud\'f3, B
\'f6lcs.
\par 98. \'c9s a beduinok k\'f6z\'f6tt vannak olyanok, akik ad\'f3ss\'e1gnak (vesztes\'e9gnek) tekintik azt, amit k\'f6lt\'f6ttek, \'e9s arra v\'e1rnak, hogy [rosszra] forduljon a sorsotok. Azonban \'f5ket veszi majd k\'f6rbe a rossz sorsfordulat! \'c9
s Allah mindent Hall\'f3, Mindentud\'f3.
\par 99. \'c9s a beduinok k\'f6z\'f6tt vannak olyanok, akik hisznek Allahban \'e9s az Utols\'f3 Napban, \'e9s amit k\'f6ltenek, azt Allahhoz val\'f3 k\'f6zeled\'e9s eszk\'f6zeinek, \'e9s a K\'fcld\'f6tt [\'e9rt\'fck val\'f3] foh\'e1szkod\'e1sa [elnyer\'e9s\'e9
nek] veszik. L\'e1m, bizony ez k\'f6zeled\'e9s sz\'e1mukra. Allah be fogja \'f5ket bocs\'e1tani a k\'f6ny\'f6r\'fclet\'e9be. Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 
\par 100. \'c9s akik els\'f5k\'e9nt el\'f5ztek meg [m\'e1sokat az iszl\'e1m felv\'e9tel\'e9ben] a [Mekk\'e1b\'f3l] kiv\'e1ndorl\'f3k \'e9s a [Medin\'e1ban] seg\'edt\'f5k k\'f6z\'fcl, \'e9s akik j\'f3tev\'f5en k\'f6vett\'e9k \'f5ket [j\'f3 cselekedeteket t\'e9
ve], azokkal Allah el\'e9gedett [lesz], \'e9s \'f5k is el\'e9gedettek [lesznek] Vele (a T\'f5le kapott jutalommal). \'c9s [Allah a Paradicsomban] kerteket k\'e9sz\'edtett el\'f5 sz\'e1mukra, amelyek alatt foly\'f3k folynak, \'f6r\'f6kk\'f6n-\'f6r\'f6kk
\'e9 abban fognak maradni. Ez a hatalmas diadal!
\par 
\par 101. \'c9s azok k\'f6z\'f6tt a beduinok k\'f6z\'f6tt, akik k\'f6r\'fcl\'f6ttetek vannak, k\'e9pmutat\'f3k vannak. \'c9s Medina lak\'f3i k\'f6z\'f6tt [is] vannak hajthatatlanok a k\'e9pmutat\'e1sban. Nem tudsz r\'f3luk [\'f3 Mohamed], \'e1m Mi tudunk r\'f3
luk. K\'e9tszer fogjuk \'f5ket gy\'f6trelemmel s\'fajtani, majd [Teremt\'f5j\'fckh\'f6z] vitetnek vissza [\'e9s] hatalmas gy\'f6trelemmel [lesznek s\'fajtva].
\par 102. \'c9s vannak m\'e1sok, akik beismert\'e9k a b\'fbneiket. \'d5k j\'f3 cselekedetet kevertek m\'e1ssal, [olyannal,] ami rossz. Allah tal\'e1n kiengesztel\'f5dik ir\'e1ntuk. Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 103. Vegy\'e9l el a vagyonukb\'f3l adom\'e1nyt, hogy tiszt\'e1talans\'e1gukat megsz\'fcntesd \'e9s megtiszt\'edtsd \'f5ket \'e1ltala! \'c9s im\'e1dkozz \'e9rt\'fck! Bizony, az im\'e1ds\'e1god nyugalom sz\'e1mukra! \'c9s Allah mindent Hall\'f3, Mindentud
\'f3.
\par 104. Vajon nem tudj\'e1k, hogy Allah bizony elfogadja a b\'fbnb\'e1natot a szolg\'e1it\'f3l \'e9s \'e1tveszi az adom\'e1nyokat [\'e9s megjutalmazza \'f5ket \'e9rte], \'e9s hogy Allah a Kiengesztel\'f5d\'f5, az Irgalmas?
\par 105. \'c9s mondd [\'f3 Mohamed]: \'84Cselekedjetek! Allah l\'e1tni fogja a tetteiteket \'e9s az \'d5 K\'fcld\'f6tte is \'e9s a h\'edv\'f5k is. Majd a rejtett \'e9s a l\'e1that\'f3 [dolgok] Tud\'f3ja el\'e9 vitettek, \'d5 pedig h\'edr\'fc
l fogja adni nektek, amit cselekedtetek.\'94
\par 106. \'c9s m\'e1soknak [m\'e9g] v\'e1rniuk kell Allah parancs\'e1ra (d\'f6nt\'e9s\'e9re): vagy gy\'f6trelemmel s\'fajtja \'f5ket, vagy kiengesztel\'f5dik ir\'e1ntuk. \'c9s Allah Mindentud\'f3, B\'f6lcs.
\par 
\par 107. \'c9s azok, akik mecsetet emeltek [maguknak], hogy \'e1rtsanak [a h\'edv\'f5knek], er\'f5s\'edts\'e9k a hitetlens\'e9get, \'e9s hogy megosztotts\'e1got okozzanak a h\'edv\'f5k k\'f6z\'f6tt, \'e9s leshely\'fcl azok sz\'e1m\'e1ra, akik h\'e1bor\'fa
ztak Allah \'e9s a K\'fcld\'f6tte ellen kor\'e1bban. \'c9s bizony [m\'e9gis] megesk\'fcsznek: \'84Mi nem akartunk m\'e1st, csup\'e1n a legjobbat.\'94 Allah pedig tan\'fas\'edtja, hogy bizony \'f5k hazugok.
\par 108. Soha ne \'e1llj fel abban [im\'e1dkozni]! Azt a mecsetet illeti meg legink\'e1bb az, hogy abban \'e1llj fel [im\'e1dkozni], amely az els\'f5 napt\'f3l az istenf\'e9lelemre alap\'edttatott. Abban olyan f\'e9rfiak vannak, akik szeretnek megtisztulni. 
\'c9s Allah szereti a megtisztul\'f3kat.
\par 109. Vajon az jobb-e, aki istenf\'e9lelemre alapozta az \'e9p\'edtm\'e9ny\'e9t \'e9s arra, amivel elnyeri Allah el\'e9gedetts\'e9g\'e9t, vagy az, aki egy leoml\'f3 hegyoldal sz\'e9l\'e9re alapozta az \'e9p\'edtm\'e9ny\'e9t, amely vele egy\'fc
tt a Gyehenna t\'fcz\'e9be omlik? \'c9s Allah nem vezeti igaz \'fatra az igazs\'e1gtalan n\'e9pet.
\par 110. Az \'e9p\'edtm\'e9ny, amit \'e9p\'edtettek meg nem sz\'fbn\'f5 k\'e9ts\'e9g lesz a sz\'edv\'fckben, am\'edg darabokra nem szakad a sz\'edv\'fck. \'c9s Allah Mindentud\'f3, B\'f6lcs.
\par 
\par 111. Bizony, Allah megv\'e1s\'e1rolta a h\'edv\'f5kt\'f5l magukat \'e9s vagyonukat, cser\'e9be az\'e9rt, hogy \'f6v\'e9k legyen a Paradicsom. Harcolnak Allah \'fatj\'e1n, majd \'f6lnek \'e9s meg\'f6letnek, T\'f5le val\'f3 igaz \'edg\'e9retk\'e9nt a T\'f3r
\'e1ban, az Evang\'e9liumban \'e9s a Kor\'e1nban. Ki az, aki h\'fbs\'e9gesebb Allahn\'e1l az egyezs\'e9g\'e9hez? Fogadj\'e1tok \'f6r\'f6mh\'edr\'e9t az ad\'e1sv\'e9teleteknek, amit k\'f6t\'f6ttetek! \'c9s ez a hatalmas diadal!
\par 112. [Akik] b\'fbnb\'e1natot tan\'fas\'edtanak, [Allahot] szolg\'e1lj\'e1k, h\'e1l\'e1t adnak, [Allah\'e9rt] \'fatra kelnek, meghajolnak, leborulnak, a hely\'e9nval\'f3ra felsz\'f3l\'edtanak, az elvetend\'f5t megtiltj\'e1k, \'e9s akik meg\'f5
rzik az Allah [\'e1ltal kijel\'f6lt] hat\'e1rokat, [azok az igazh\'edv\'f5k]. \'c9s adj \'f6r\'f6mh\'edrt a h\'edv\'f5knek!
\par 
\par 113. A Pr\'f3f\'e9ta \'e9s azok, akik hisznek, nem k\'e9rhetnek megbocs\'e1t\'e1st [az Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3k sz\'e1m\'e1ra, m\'e9g akkor sem, ha rokonokr\'f3l lenne sz\'f3, miut\'e1n nyilv\'e1nval\'f3 lett sz\'e1mukra, hogy \'f5
k a Pokol lak\'f3i!
\par 114. \'c9s \'c1brah\'e1m bocs\'e1natk\'e9r\'e9se az apja sz\'e1m\'e1ra csup\'e1n egy \'edg\'e9ret miatt volt, amelyet kor\'e1bban \'edg\'e9rt neki. \'c1m miut\'e1n nyilv\'e1nval\'f3 lett sz\'e1m\'e1ra, hogy \'f5 Allah ellens\'e9ge, elhat\'e1rol\'f3dott t
\'f5le. Bizony, \'c1brah\'e1m al\'e1zatosan \'e9s gyakran foh\'e1szkod\'f3, b\'e9ket\'fbr\'f5.
\par 115. \'c9s Allah nem visz t\'e9velyg\'e9sbe egy n\'e9pet azt k\'f6vet\'f5en, hogy m\'e1r igaz \'fatra vezette \'f5ket, m\'edg nyilv\'e1nval\'f3v\'e1 nem teszi nekik, mit\'f5l kell \'f3vakodniuk. Bizony, Allah minden dologr\'f3l tudom\'e1ssal b\'edr.

\par 116. Bizony, Allah\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett, \'e9letre kelt \'e9s hal\'e1lba k\'fcld. \'c9s nincs nektek Allah helyett m\'e1s p\'e1rtfog\'f3tok, sem seg\'edt\'f5t\'f6k.
\par 
\par 117. Bizony, Allah m\'e1r kiengesztel\'f5d\'f6tt a Pr\'f3f\'e9ta, a kiv\'e1ndorl\'f3k \'e9s a seg\'edt\'f5k ir\'e1nt, akik k\'f6vett\'e9k \'f5t (Mohamed Pr\'f3f\'e9t\'e1t) a neh\'e9zs\'e9g \'f3r\'e1j\'e1ban, azut\'e1n, hogy egy csoportnak k\'f6z\'fcl\'fc
k majdnem elferd\'fclt a sz\'edve. Ezut\'e1n kiengesztel\'f5d\'f6tt ir\'e1ntuk. Bizony, \'d5 ir\'e1ntuk Egy\'fctt\'e9rz\'f5, Irgalmas.
\par 118. \'c9s azon h\'e1rom ir\'e1nt, akik h\'e1tra lettek hagyva [a Tab\'fak csat\'e1ban], m\'edg a f\'f6ld b\'e1rmilyen t\'e1gas is, sz\'fbk lett sz\'e1mukra \'e9s a lelk\'fck \'f6sszeszorult, \'e9s \'fagy v\'e9lt\'e9k nincs mened\'e9k Allaht\'f3l, csak N
\'e1la. Azut\'e1n kiengesztel\'f5d\'f6tt ir\'e1ntuk, az\'e9rt hogy b\'fbnb\'e1natot tan\'fas\'edtsanak. Bizony, Allah Kiengesztel\'f5d\'f5, Irgalmas.
\par 119. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! F\'e9lj\'e9tek Allahot \'e9s legyetek az igazmond\'f3kkal!
\par 120. Nem lett volna szabad Medina lak\'f3inak \'e9s azoknak, akik k\'f6r\'fcl\'f6tt\'fck vannak a beduinok k\'f6z\'fcl, hogy h\'e1tramaradjanak Allah k\'fcld\'f6tt\'e9t\'f5l, \'e9s nem lett volna szabad t\'f6bbre tartaniuk magukat n\'e1la! Ez az\'e9
rt [van \'edgy], mert \'f5k nem szenvednek sem szomj\'fas\'e1gt\'f3l, sem kimer\'fclts\'e9gt\'f5l, sem pedig \'e9hs\'e9gt\'f5l Allah \'datj\'e1n, \'e9s nem tesznek egyetlen l\'e9p\'e9st sem, amely a hitetleneket haragra gerjeszti, \'e9
s nem szereznek az ellens\'e9ggel szemben egyetlen gy\'f5zelmet sem an\'e9lk\'fcl, hogy az ne lenne az fel\'edrva sz\'e1mukra j\'f3 cselekedetk\'e9nt. Bizony, Allah nem hagyja k\'e1rba veszni a j\'f3tev\'f5k jutalm\'e1t.
\par 121. \'c9s nem adnak adom\'e1nyt, sem kicsit, sem nagyot, \'e9s nem v\'e1gnak \'e1t egyetlen v\'f6lgy\'f6n sem an\'e9lk\'fcl, hogy ne lenne fel\'edrva az nekik [jutalomk\'e9nt] az\'e9rt, hogy Allah fizets\'e9gk\'e9nt adja meg nekik annak a legjobbj\'e1
t, amit cselekedtek.
\par 
\par 122. \'c9s nem kell a h\'edv\'f5knek, hogy mind egy\'fctt vonuljanak ki harcolni. H\'e1t mi\'e9rt ne vonulna ki [tanulni] minden csapatukb\'f3l egy csoport az\'e9rt, hogy tud\'e1st szerezhessenek a vall\'e1sban, \'e9s hogy figyelmeztess\'e9k n\'e9p\'fc
ket, h\'e1tha \'f3vakodnak [mindatt\'f3l, ami tilalmas]?
\par 123. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Harcoljatok azon hitetlenek ellen, akik hozz\'e1tok a legk\'f6zelebb vannak, \'e9s tal\'e1ljanak kem\'e9nynek titeket! \'c9s tudj\'e1
tok meg, hogy Allah az istenf\'e9l\'f5kkel van!
\par 
\par 124. \'c9s amikor lebocs\'e1ttatik egy sz\'fara, van olyan k\'f6z\'f6tt\'fck (a k\'e9pmutat\'f3k k\'f6z\'f6tt), aki azt mondja: \'84Melyik\'f5t\'f6ket gyarap\'edtotta ez hitben?\'94 \'c9s ami azokat illeti, akik hisznek, \'f5ket ez gyarap\'ed
totta a hitben, \'e9s \'f5k \'f6r\'f6mmel tekintenek [Allah adom\'e1ny\'e1ra].
\par 125. Azonban, akiknek sz\'edv\'e9ben betegs\'e9g lakozik, azoknak f\'f6rtelmess\'e9g\'e9t f\'f6rtelmess\'e9ggel tet\'e9zi, \'e9s \'fagy halnak meg, hogy hitetlenek.
\par 126. Vajon nem l\'e1tj\'e1k, hogy minden \'e9vben egyszer vagy k\'e9tszer pr\'f3b\'e1nak vettetnek al\'e1? Ezut\'e1n m\'e9gsem tan\'fas\'edtanak b\'fbnb\'e1natot \'e9s nem okulnak [az int\'e9sb\'f5l].
\par 127. \'c9s ha lebocs\'e1ttatik egy sz\'fara, [a k\'e9pmutat\'f3k k\'f6z\'fcl] az egyik a m\'e1sikra n\'e9z [azt \'fczenv\'e9n]: \'84Vajon l\'e1t titeket valaki?\'94, majd [h\'e1tat ford\'edtva] elosonnak. Allah ford\'edtotta el a sz\'edv\'fcket, mivel 
\'f5k olyan n\'e9p, akik nem \'e9rtenek.
\par 
\par 128. Bizony, elj\'f6tt m\'e1r hozz\'e1tok egy k\'fcld\'f6tt magatok k\'f6z\'fcl, keserves neki, ha neh\'e9z helyzetbe ker\'fclt\'f6k, t\'f6r\'f5dik veletek, a h\'edv\'f5k ir\'e1nt egy\'fctt\'e9rz\'f5, irgalmas.
\par 129. \'c9s ha h\'e1tat ford\'edtanak, akkor mondd [\'f3 Mohamed]: \'84Allah el\'e9gs\'e9ges a sz\'e1momra, nincs m\'e1s isten csak \'d5, \'d5r\'e1 hagyatkozom. \'c9s \'d5 a Hatalmas Tr\'f3n Ura.\'94}{\insrsid3161635 
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid3161635 {\b\insrsid7550020 \page }{\b\insrsid16543947 10. }{\b\insrsid3161635\charrsid2715885 J\'f3n\'e1s (J\'fanusz) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635 
\par 1. Alif-l\'e1m-ra. Ezek a B\'f6lcs \'cdr\'e1s jelei (id\'e9zetei).
\par 2. Mi csod\'e1lkozni val\'f3ja van az embereknek azon, hogy egy k\'f6z\'fcl\'fck val\'f3 f\'e9rfinak azt sugalltuk, hogy: \'84Figyelmeztesd az embereket, \'e9s adj \'f6r\'f6mh\'edrt azoknak, akik hisznek, hogy igaz tetteik\'e9rt ki\'e9
rdemelt jutalmuk lesz Urukn\'e1l!\'94 Azt mondt\'e1k a hitetlenek: \'84Ez bizony nyilv\'e1nval\'f3 var\'e1zsl\'f3!\'94
\par 
\par 3. Bizony, az Uratok Allah, aki megteremtette az egeket \'e9s a f\'f6ldet hat nap alatt, azut\'e1n elhelyezkedett [Hozz\'e1 m\'e9lt\'f3an] a Tr\'f3nuson. [Egyed\'fcl \'d5] rendezi a [teremtm\'e9nyeinek] \'fcgyeit. Nincs k\'f6zbenj\'e1r\'f3 csak az \'d5
 engedelme ut\'e1n. \'cdme, \'d5 Allah, az Uratok! Szolg\'e1lj\'e1tok h\'e1t \'d5t! Vajon nem okultok [az int\'e9sb\'f5l]?
\par 4. Hozz\'e1 lesz a visszat\'e9r\'e9setek, mindny\'e1jatoknak. }{\insrsid3161635\charrsid6953464 Allah \'edg\'e9rete igaz.}{\insrsid3161635  Bizony, \'d5 viszi v\'e9ghez a teremt\'e9st kezdetben, majd [a hal\'e1l ut\'e1n] megism\'e9tli azt, hogy igazs\'e1
gosan fizessen meg azoknak, akik hisznek \'e9s j\'f3tetteket cselekszenek. \'c9s akik pedig hitetlenn\'e9 v\'e1ltak, azoknak forr\'e1sban l\'e9v\'f5 v\'edzb\'f5l lesz az italuk \'e9s f\'e1jdalmas gy\'f6trelemben lesz r\'e9sz\'fc
k amiatt, hogy hitetlenek voltak.
\par 5. \'d5 az, aki a Napot f\'e9nyess\'e9gg\'e9 \'e9s a Holdat vil\'e1goss\'e1gg\'e1 tette meg, \'e9s \'e1llom\'e1sokat rendelt el [a hold] sz\'e1m\'e1ra, hogy megtudj\'e1tok az \'e9vek sz\'e1m\'e1t \'e9s az [id\'f5-]sz\'e1m\'edt\'e1
st. Allah nem teremtette meg ezt, csakis az igazs\'e1ggal (c\'e9llal). \'d5 r\'e9szletesen fejti ki a jeleket egy olyan n\'e9pnek, akik tud\'e1ssal b\'edrnak.
\par 6. Bizony, az \'e9jszaka \'e9s a nappal v\'e1ltakoz\'e1s\'e1ban, \'e9s [mind-]abban, }{\insrsid3161635\charrsid12391230 amit}{\insrsid3161635  Allah az egekben \'e9s a f\'f6ld\'f6n teremtett, jelek vannak egy olyan n\'e9pnek, akik istenf\'e9l\'f5k.
\par 
\par 7. Bizony azok, akik nem rem\'e9lik a Vel\'fcnk val\'f3 tal\'e1lkoz\'e1st \'e9s el\'e9gedettek az evil\'e1gi \'e9lettel \'e9s belenyugszanak abba, \'e9s azok, akik figyelmen k\'edv\'fcl hagyj\'e1k jeleinket,
\par 8. Azoknak a [Pokol-]t\'fbz lesz a hajl\'e9kuk amiatt, amit szereznek.
\par 9. Bizony, akik hisznek \'e9s j\'f3tetteket cselekszenek, azokat az Uruk a hit\'fck miatt vezeti az igaz \'fatra. Alattuk foly\'f3k folynak a gy\'f6ny\'f6r\'fbs\'e9g kertjeiben [a Paradicsomban].
\par 10. Az \'f5 foh\'e1szuk abban: \'84Magasztaltass\'e1l, \'f3 Allah!\'94, \'e9s a k\'f6sz\'f6nt\'e9s\'fck abban: \'84B\'e9kess\'e9g!\'94, \'e9s az utols\'f3 foh\'e1szuk pedig: \'84A h\'e1latelt dics\'e9ret Allahot illeti, a teremtm\'e9nyek Ur\'e1t!\'94

\par 
\par 11. \'c9s ha Allah \'fagy siettetn\'e9 az embereknek a rosszat [amit maguk ellen foh\'e1szkodnak], ahogy \'f5k siettetik a j\'f3t, akkor beteljes\'fclt volna a hat\'e1ridej\'fck (elpusztultak volna). \'c1m azokat, akik nem rem\'e9lik a Vel\'fcnk val\'f3
 tal\'e1lkoz\'e1st, magukra hagyjuk a t\'falkap\'e1saikban vakon bolyongani.
\par 12. Ha az embert \'e1rtalom \'e9ri, akkor foh\'e1szkodik Hozz\'e1nk az oldal\'e1n (fekve), \'fclve vagy \'e1llva. \'c1m amikor elh\'e1r\'edtjuk r\'f3la az \'f5t \'e9rt \'e1rtalmat, tov\'e1bbmegy, mintha nem is foh\'e1szkodott volna Hozz\'e1nk egy \'e1
rtalom miatt, ami [kor\'e1bban] \'e9rte. Ekk\'e9ppen d\'edsz\'edtetett a }{\insrsid3161635\charrsid12391230 m\'e9rt\'e9kteleneknek az}{\insrsid3161635 , amit cselekedtek.
\par 13. \'c9s m\'e1r elpuszt\'edtottunk el\'f5ttetek \'e9lt nemzed\'e9keket, amikor igazs\'e1gtalans\'e1got k\'f6vettek el, \'e9s elj\'f6ttek hozz\'e1juk a k\'fcld\'f6tteik a nyilv\'e1nval\'f3 bizony\'edt\'e9kokkal, \'e1m \'f5k soha nem hittek volna. Ekk\'e9
ppen fizet\'fcnk meg a gonosztev\'f5 n\'e9pnek.
\par 14. Azt\'e1n ut\'f3dokk\'e1 (egym\'e1s hely\'e9be l\'e9p\'f5 nemzed\'e9kekk\'e9) tett\'fcnk meg titeket ut\'e1nuk a f\'f6ld\'f6n, hogy megn\'e9zz\'fck, ti hogyan cselekedtek.
\par 
\par 15. \'c9s amikor a jeleink (id\'e9zeteink) nyilv\'e1nval\'f3 bizony\'edt\'e9kokk\'e9nt recit\'e1ltatnak nekik, azt mondj\'e1k azok, akik nem rem\'e9lik a Vel\'fcnk val\'f3 tal\'e1lkoz\'e1st: }{\insrsid3161635\charrsid2108781 \'84Hozz el\'f5
 egy [olyan] Kor\'e1nt, ami m\'e1s, mint ez, vagy v\'e1ltoztasd meg!\'94}{\insrsid3161635  Mondd [\'f3 Mohamed]: \'84T\'e1vol \'e1ll t\'f5lem az, hogy megv\'e1ltoztassam azt saj\'e1t magamt\'f3l. \'c9n csup\'e1n azt k\'f6
vetem, ami sugalltatott nekem. Bizony, ha ellenszeg\'fcln\'e9k Uramnak, \'e9n }{\insrsid3161635\charrsid12391230 f\'e9ln\'e9k}{\insrsid3161635  egy hatalmas Nap gy\'f6trelm\'e9t\'f5l.\'94
\par 16. Mondd [\'f3 Mohamed]: \'84Ha Allah \'fagy akarta volna, akkor nem recit\'e1ltam volna nektek azt, \'e9s nem [is] tudatta volna [Allah] azt veletek. Hiszen el\'f5tte m\'e1r egy \'e9leten \'e1t id\'f5ztem k\'f6ztetek. H\'e1t vajon nem \'e9
ltek az eszetekkel?\'94
\par 17. H\'e1t ki igazs\'e1gtalanabb ann\'e1l, mint az, aki hazugs\'e1got tal\'e1l ki Allahr\'f3l, vagy meghazudtolja az \'d5 }{\insrsid3161635\charrsid12391230 jeleit (szavait)?}{\insrsid3161635  Bizony a gonosztev\'f5k nem boldogulnak.
\par 
\par 18. \'c9s Allah helyett olyannak szolg\'e1lnak, ami nem \'e1rt nekik, \'e9s nem [is] haszn\'e1l nekik, \'e9s azt mondj\'e1k: \'84Ezek a mi k\'f6zbenj\'e1r\'f3ink Allahn\'e1l!\'94 Mondd [\'f3 Mohamed]: \'84Vajon olyanr\'f3l akartok h\'edrt adni Allahnak, }
{\insrsid3161635\charrsid12391230 amir\'f5l \'d5 nem tud}{\insrsid3161635 , sem az egekben, sem a f\'f6ld\'f6n?\'94 Magasztaltass\'e9k \'d5! \'c9s [\'d5] afelett van, amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [\'d5mell\'e9].
\par 19. \'c9s az emberek [kezdetben] csup\'e1n egyetlen k\'f6z\'f6ss\'e9get alkottak, majd \'f6sszek\'fcl\'f6nb\'f6ztek. \'c9s ha nem lett volna kor\'e1bban [a b\'fcntet\'e9s k\'e9sleltet\'e9s\'e9r\'f5l] egy sz\'f3 Uradt\'f3l, akkor bizony d\'f6nt\'e9
s hozatott volna k\'f6z\'f6tt\'fck abban, amiben \'f6sszek\'fcl\'f6nb\'f6ztek.
\par 20. Azt mondj\'e1k: \'84H\'e1t mi\'e9rt nem bocs\'e1ttatott le re\'e1 egy jel az Ur\'e1t\'f3l?\'94 \'c9s mondd [\'f3 Mohamed]: \'84A rejtett dolgok [tud\'e1sa] csup\'e1n Allah\'e9! H\'e1t v\'e1rakozzatok [Allah \'edt\'e9lkez\'e9s\'e9re]! Bizony, \'e9
n is veletek vagyok a v\'e1rakoz\'f3k k\'f6z\'f6tt!\'94
\par 
\par 21. \'c9s ha k\'f6ny\'f6r\'fcletet \'edzleltet\'fcnk meg az emberekkel, miut\'e1n csap\'e1s \'e9rte }{\insrsid3161635\charrsid4330924 \'f5ket, \'edme \'f5k [gonosz] tervet sz\'f5nek a jeleink ellen. Mondd [\'f3 Mohamed]: \'84Allah gyorsabb a tervez\'e9
sben. Bizony, k\'fcld\'f6tteink (az angyalok) fel\'edrj\'e1k azt, ami [gonosz] tervet sz\'f5t\'f6k!\'94}{\insrsid3161635 
\par 22. \'d5 az, aki lehet\'f5v\'e9 teszi nektek az utaz\'e1st a sz\'e1razf\'f6ld\'f6n \'e9s a tengeren. Amikor pedig [egyszer] a haj\'f3kon vagytok, \'e9s azok j\'f3 (kedvez\'f5) sz\'e9llel haladnak vel\'fck (az utasokkal), \'e9s \'f5k \'f6
rvendeznek annak, [majd] viharos sz\'e9l j\'f6n el azokhoz [a haj\'f3khoz], \'e9s hull\'e1mok j\'f6nnek el hozz\'e1juk minden fel\'f5l, \'e9s azt v\'e9lik, hogy k\'f6r\'fcl lettek v\'e9ve [a pusztul\'e1s \'e1ltal], [l\'e1m, akkor] Allahhoz foh\'e1
szkodnak, \'f5szinte odaad\'e1ssal Neki szentelve a vall\'e1s [gyakorl\'e1s\'e1t], [mondv\'e1n]: \'84Ha Te megmentesz minket ett\'f5l, akkor bizony a h\'e1l\'e1sak k\'f6z\'e9 fogunk tartozni!\'94
\par 23. Amikor pedig megmenti \'f5ket, \'edme \'f5k zsarnoks\'e1got k\'f6vetnek el a f\'f6ld\'f6n jogtalanul. \'d3, emberek! Zsarnoks\'e1gotok csup\'e1n \'f6nmagatok ellen van, [aminek el\'f5nyei] az evil\'e1gi \'e9let [muland\'f3] \'e9lvezete. Azut\'e1n Hozz
\'e1nk lesz a visszat\'e9r\'e9setek, \'e9s h\'edr\'fcl fogjuk adni nektek azt, amit cselekedtetek.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\pnrauth1\pnrdate1201896257\pnrnot1\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635 24. Az evil\'e1gi \'e9let hasonlatos }{\insrsid3161635\charrsid6168180 a v\'edzhez, amelyet lebocs\'e1tottunk az \'e9gb\'f5l, majd 
\'f6sszekeveredett vele a f\'f6ld n\'f6v\'e9nyzete, amelyb\'f5l esznek az emberek \'e9s a j\'f3sz\'e1gok. Amikor pedig a f\'f6ld mag\'e1ra \'f6lt\'f6tte \'e9kess\'e9g\'e9t \'e9s feld\'edsz\'edtette mag\'e1t, \'e9s lak\'f3i azt gondolj\'e1
k, hogy hatalmuk van felette, elj\'f6n hozz\'e1 a parancsunk [az elpuszt\'edt\'e1s\'e1ra] \'e9jjel vagy nappal \'e9s learatott\'e1 tessz\'fck, mintha nem lett volna term\'e9se a k\'f6zelm\'faltban. Ekk\'e9ppen fejtj\'fck ki r\'e9
szletesen a jeleket egy olyan n\'e9pnek, akik elgondolkodnak.
\par 25. \'c9s Allah a B\'e9kess\'e9g Lakhely\'e9hez (a Paradicsomhoz) h\'edv, \'e9s azt vezeti az Egyenes \'fatra, akit akar.
\par 
\par 26. Azoknak, akik j\'f3tev\'f5en cselekszenek, a legjobb [jutalom] (a Paradicsom) j\'e1r \'e9s m\'e9g [enn\'e9l is] t\'f6bb. \'c9s nem fogja bor\'edtani arcukat sem fekete por, sem pedig megal\'e1ztat\'e1s. \'d5k a Paradicsom lak\'f3i. \'d5k \'f6r\'f6kk
\'e9 abban fognak maradni.
\par 27. Azoknak, akik rossz tetteket szereztek maguknak, [nos] a rossz tett fizets\'e9ge ahhoz hasonl\'f3 [t\'falvil\'e1gi b\'fcntet\'e9s] \'e9s megal\'e1ztat\'e1s fogja \'f5ket bor\'edtani. Senki sem v\'e9delmezheti meg \'f5ket Allaht\'f3
l. Arcukat mintha az \'e9jszaka s\'f6t\'e9t r\'e9sze fedn\'e9 be. Azok a [Pokol-]t\'fbz lak\'f3i, \'f5k \'f6r\'f6kk\'e9 abban fognak maradni.}{\insrsid3161635 
\par 
\par 28. Azon a napon, amikor egybegy\'fbjtj\'fck mindny\'e1jukat, azut\'e1n azt mondjuk azoknak, akik [Allah mell\'e9] t\'e1rsistent \'e1ll\'edtottak: \'84[Maradjatok] a helyeteken, ti \'e9s azok, akiket [Allah mell\'e9] t\'e1rsistenk\'e9nt \'e1ll\'ed
tottatok!\'94 Majd elv\'e1lasztjuk \'f5ket egym\'e1st\'f3l, \'e9s azt mondj\'e1k azok, akiket [Allah mell\'e9] t\'e1rsistenk\'e9nt \'e1ll\'edtottak: \'84Ti nem minket szolg\'e1ltatok.
\par 29. \'c9s elegend\'f5 Allah tan\'fanak k\'f6zt\'fcnk \'e9s k\'f6ztetek, bizony mi \'e9szre sem vett\'fck [az ir\'e1ntunk tan\'fas\'edtott] szolg\'e1latotokat.\'94
\par 30. Ott minden ember megtapasztalja azt, amit kor\'e1bban tett, \'e9s visszavitetnek Allahhoz, Igaz P\'e1rtfog\'f3jukhoz [hogy \'edt\'e9lkezzen felett\'fck], \'e9s elt\'fbnik mell\'f5l\'fck mindaz, amit hazugs\'e1gk\'e9nt kital\'e1ltak.
\par 
\par 31. Mondd [\'f3 Mohamed]: \'84Ki l\'e1t el titeket az \'e9gb\'f5l \'e9s a f\'f6ldb\'f5l? Vagy ki rendelkezik a hall\'e1s \'e9s a l\'e1t\'e1s felett? \'c9s ki hozza el\'f5 az \'e9l\'f5t a halottb\'f3l \'e9s hozza el\'f5 a halottat az \'e9l\'f5b\'f5l? \'c9
s ki rendezi az \'fcgyet?\'94 \'c9s azt fogj\'e1k mondani: \'84Allah!\'94 Mondd [\'f3 Mohamed]: \'84Vajon [ezek ut\'e1n] nem vagytok istenf\'e9l\'f5k?\'94
\par 32. \'cdme, \'d5 Allah, az Igaz Uratok! Mi m\'e1s lehetne az igazs\'e1gon t\'fal, mint a t\'e9velyg\'e9s? Hogyan ford\'edthatnak h\'e1t el titeket [Allah szolg\'e1lat\'e1t\'f3l]?
\par 33. Ekk\'e9ppen igazol\'f3dott be Urad szava (\'edt\'e9lete) azokkal szemben, akik engedetlenek voltak, hogy \'f5k bizony nem fognak hinni.
\par 
\par 34. Mondd [\'f3 Mohamed]: \'84Vajon van azok k\'f6z\'f6tt, akiket [Allah mell\'e9] t\'e1rsistenk\'e9nt \'e1ll\'edtottatok, olyan, aki v\'e9ghezviszi a teremt\'e9st kezdetben, majd [a hal\'e1l ut\'e1n] megism\'e9teli azt?\'94 Mondd: \'84Allah viszi v\'e9
ghez a teremt\'e9st, majd megism\'e9tli azt. Hogyan lehettek h\'e1t elt\'e9r\'edtve [az igazs\'e1gt\'f3l]?\'94
\par 35. Mondd [\'f3 Mohamed]: \'84Vajon van azok k\'f6z\'f6tt, akiket [Allah mell\'e9] t\'e1rsistenk\'e9nt \'e1ll\'edtottatok, olyan, aki az Igazs\'e1gra vezet?\'94 Mondd [\'f3 Mohamed]: \'84Allah vezet az Igazs\'e1gra. \'c9s vajon azt illeti meg legink\'e1
bb hogy k\'f6vess\'e9k, aki az Igazs\'e1gra vezet, vagy azt, aki nem lel r\'e1 az igaz \'fatra, hacsak r\'e1 nem vezettetik [Allah \'e1ltal]? Mi lelt h\'e1t titeket? Hogyan \'edt\'e9lkeztek?\'94
\par 36. \'c9s a legt\'f6bbj\'fck nem k\'f6vet m\'e1st, csup\'e1n v\'e9leked\'e9st. Bizony a v\'e9leked\'e9s semmit sem haszn\'e1l az igazs\'e1ggal szemben. Bizony, Allahnak tudom\'e1sa van arr\'f3l, amit tesznek.
\par 
\par 37. T\'e1vol \'e1ll ett\'f5l a Kor\'e1nt\'f3l, hogy kital\'e1lhat\'f3 lenne Allahnak tulajdon\'edtva. Azonban igazol\'e1sa annak, ami el\'f5tte volt [a kor\'e1bbi kinyilatkoztat\'e1sokb\'f3l] \'e9s az \'cdr\'e1s r\'e9szletes magyar\'e1zata \endash  nem f
\'e9r k\'e9ts\'e9g hozz\'e1 \endash  a teremtm\'e9nyek Ur\'e1t\'f3l.
\par 38. Vagy azt mondj\'e1k: \'84\'d5 maga tal\'e1lta ki!\'94 Mondd [\'f3 Mohamed]: \'84Hozzatok h\'e1t el\'f5 egy hozz\'e1 }{\insrsid3161635\charrsid14177145 hasonl\'f3 sz\'far\'e1t,}{\insrsid3161635  \'e9s h\'edvj\'e1tok [seg\'edts\'e9g\'fc
l] Allah helyett azt, akit csak k\'e9pesek vagytok, ha }{\insrsid3161635\charrsid14177145 val\'f3ban i}{\insrsid3161635 gazmond\'f3k vagytok!\'94
\par 39. Ellenkez\'f5leg! Meghazudtolt\'e1k azt, aminek a tud\'e1s\'e1t nem fogt\'e1k fel \'e9s aminek a magyar\'e1zata m\'e9g nem j\'f6tt el hozz\'e1juk. Ekk\'e9ppen k\'f6vettek el meghazudtol\'e1st azok is, akik el\'f5tt\'fck \'e9ltek. N\'e9zd h\'e1
t meg, milyen v\'e9g\'fck lett az igazs\'e1gtalanoknak!
\par 40. \'c9s van k\'f6z\'f6tt\'fck olyan, aki hisz benne, \'e9s van k\'f6z\'f6tt\'fck olyan, aki nem hisz benne. \'c9s Urad jobban tudja, kik a roml\'e1st okoz\'f3k.
\par 41. \'c9s ha meghazudtolnak t\'e9ged, akkor mondd [\'f3 Mohamed]: \'84Nekem megvan a magam cselekedete, \'e9s nektek is megvan a magatok cselekedete. Ti elhat\'e1rol\'f3dtok att\'f3l, amit \'e9n cselekszem, \'e9s \'e9n is elhat\'e1rol\'f3dok att\'f3l, am
it ti cselekszetek.\'94
\par 42. \'c9s vannak k\'f6z\'f6tt\'fck olyanok, akik meghallgatnak t\'e9ged [an\'e9lk\'fcl, hogy \'e9rten\'e9nek]. Vajon te hall\'f3v\'e1 teheted a s\'fcketeket, m\'e9g akkor is, ha nem \'e9lnek az esz\'fckkel?
\par 43. Vannak k\'f6z\'f6tt\'fck olyanok, akik r\'e1d n\'e9znek [an\'e9lk\'fcl, hogy k\'f6vetn\'e9nek]. Vajon te vezetheted a vakokat, m\'e9g akkor is, ha nem l\'e1tnak?
\par 44. Bizony, Allah semmiben sem k\'f6vet el igazs\'e1gtalans\'e1got az emberekkel szemben, azonban az emberek saj\'e1t magukkal szemben k\'f6vetnek el igazs\'e1gtalans\'e1got.
\par 
\par 45. \'c9s azon a napon (a Felt\'e1mad\'e1s napj\'e1n), amikor majd egybegy\'fbjti \'f5ket, olyan lesz, mintha [az evil\'e1gon] a napb\'f3l csak egyetlen \'f3r\'e1t id\'f5ztek volna, ismerkedve egym\'e1ssal. Bizony, vesztesek lettek azok, akik meghazudtolt
\'e1k az Allahhal val\'f3 tal\'e1lkoz\'e1st, \'e9s nem leltek [az igaz] \'fatra.
\par 46. \'c9s ak\'e1r megmutatjuk neked egy r\'e9sz\'e9t annak, amit \'edg\'e9r\'fcnk nekik, ak\'e1r [m\'e9g el\'f5tte] magunkhoz sz\'f3l\'edtunk t\'e9ged, Hozz\'e1nk lesz a visszat\'e9r\'e9s\'fck, ut\'e1na pedig Allah a tan\'faja annak, amit tesznek [\'e9
s aszerint b\'fcnteti meg \'f5ket].
\par 47. \'c9s minden k\'f6z\'f6ss\'e9gnek van k\'fcld\'f6tte. \'c9s amikor elj\'f6n a k\'fcld\'f6tt\'fck [az \'cdt\'e9let napj\'e1n], akkor igazs\'e1gosan lesz d\'f6ntve k\'f6z\'f6tt\'fck, \'e9s nem fognak igazs\'e1gtalans\'e1got szenvedni.
\par 48. \'c9s azt mondj\'e1k: \'84Mikor [k\'f6vetkezik be] ez az \'edg\'e9ret, }{\insrsid3161635\charrsid869118 ha val\'f3ban igazmond\'f3k}{\insrsid3161635  vagytok?\'94
\par 49. Mondd [\'f3 Mohamed]: \'84Nem \'e1ll m\'f3domban magamnak hasznot [hozni], sem \'e1rtalmat [elt\'e1vol\'edtani], kiv\'e9ve ha Allah \'fagy akarja. Minden k\'f6z\'f6ss\'e9gnek [megszabott] hat\'e1rideje van. Amikor elj\'f6n a hat\'e1ridej\'fck, nem k
\'e9sleltethetik azt egy \'f3r\'e1val sem, \'e9s nem [is] hozhatj\'e1k el\'f5re.\'94
\par }{\insrsid3161635\charrsid869118 50. Mondd [\'f3 Mohamed]: \'84Vajon mit gondoltok, ha elj\'f6nne hozz\'e1tok az \'d5 gy\'f6trelme az \'e9j leple alatt vagy nappal, [nos] mit siettetnek abb\'f3l a gonosztev\'f5k?
\par 51. Vajon azut\'e1n hisztek csak benne, hogy m\'e1r bek\'f6vetkezett? Vajon csak most, mik\'f6zben}{\insrsid3161635  kor\'e1bban siettett\'e9tek?\'94
\par 52. Azut\'e1n az lesz mondva azoknak, akik igazs\'e1gtalans\'e1got k\'f6vettek el: \'84\'cdzlelj\'e9tek meg az \'f6r\'f6kk\'e9 tart\'f3 gy\'f6trelmet! Vajon mi m\'e1s\'e9rt kaptok fizets\'e9get, mint amit megszereztetek?\'94
\par 53. \'c9s k\'e9rik, hogy adj h\'edrt nekik: \'84Vajon ez igaz?\'94 Mondd [\'f3 Mohamed]: \'84Igen, az Uramra [esk\'fcsz\'f6m], hogy bizony igaz! \'c9s ti nem fogj\'e1tok [Allahot] }{\insrsid3161635\charrsid3107015 megakad\'e1lyozni [semmiben].\'94
\par 
\par 54. \'c9s ha minden igazs\'e1gtalans\'e1got elk\'f6vet\'f5 ember\'e9 lenne mindaz, ami a f\'f6ld\'f6n van, bizony akkor meg akarn\'e1 v\'e1ltani mag\'e1t az\'e1ltal [a b\'fcntet\'e9st\'f5l]. Magukba rejtik a megb\'e1n\'e1st, amikor megl\'e1tj\'e1k a gy
\'f6trelmet. \'c9s igazs\'e1gosan lesz d\'f6ntve k\'f6z\'f6tt\'fck, \'e9s nem fognak igazs\'e1gtalans\'e1got szenvedni.
\par 55. L\'e1m, bizony Allah\'e9 mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van! L\'e1m bizony, Allah \'edg\'e9rete igaz! \'c1m a legt\'f6bbj\'fck nem rendelkezik tud\'e1ssal.
\par 56. \'d5 kelt \'e9letre \'e9s bocs\'e1t [a] hal\'e1lba. \'c9s Hozz\'e1 lesztek visszavitetve.
\par 
\par 57. \'d3 ti, emberek! Imm\'e1r int\'e9s j\'f6tt el hozz\'e1tok az Uratokt\'f3l \'e9s gy\'f3gy\'edr arra, ami a keblekben (a sz\'edvetekben) van, \'e9s \'fatmutat\'e1s \'e9s k\'f6ny\'f6r\'fclet a h\'edv\'f5knek.
\par 58. Mondd [\'f3 Mohamed]: \'84Allah kegy\'e9nek \'e9s k\'f6ny\'f6r\'fclet\'e9ben \endash  h\'e1t ezeknek \'f6rvendezzenek! Ez jobb, mint az, amit \'f6sszegy\'fbjtenek [az evil\'e1gi javakb\'f3l].\'94
\par 59. Mondd [\'f3 Mohamed]: \'84Vajon mit gondoltok arr\'f3l, amit Allah bocs\'e1tott le nektek az ell\'e1t\'e1sb\'f3l, majd ti abb\'f3l [egy r\'e9szt] tilalmasnak tesztek meg \'e9s [m\'e1s r\'e9szt] megengedettnek?\'94 Mondd [\'f3 Mohamed]: \'84
Vajon Allah adott nektek enged\'e9lyt, vagy ti Allah ellen hazugs\'e1got tal\'e1ltok ki?\'94
\par 60. \'c9s mi lesz a v\'e9leked\'e9se azoknak, akik hazugs\'e1got tal\'e1lnak ki Allah ellen, a Felt\'e1mad\'e1s Napj\'e1n? \'c9s Allah kegyes az emberek ir\'e1nt, \'e1m a legt\'f6bbj\'fck nem h\'e1l\'e1s.
\par 
\par 61. \'c9s nem lehetsz egy foglalatoss\'e1gban sem, \'e9s nem recit\'e1lhatsz arr\'f3l Kor\'e1nt, \'e9s nem tehettek semmilyen cselekedetet an\'e9lk\'fcl, hogy ne lenn\'e9nk tan\'fak felettetek, amikor hozz\'e1l\'e1ttok. \'c9s az Urad el\'f5
tt egy porszemnyi s\'faly\'fa [dolog] sem marad rejtve a f\'f6ld\'f6n, sem az \'e9gben, sem enn\'e9l kisebb, sem nagyobb an\'e9lk\'fcl, hogy ne lenne benne egy nyilv\'e1nval\'f3 \'edr\'e1sban [az \'d5rz\'f6tt T\'e1bl\'e1n].
\par 
\par 62. L\'e1m, bizony Allah p\'e1rtfogoltjain nem lesz \'farr\'e1 a f\'e9lelem, \'e9s nem fognak szomorkodni.
\par 63. [\'d5k azok] akik hittek \'e9s istenf\'e9lelmet tan\'fas\'edtottak.
\par 64. Nekik \'f6r\'f6mh\'edr j\'e1r az evil\'e1gon \'e9s a T\'falvil\'e1gon. Allah szavait nem lehet megv\'e1ltoztatni. Ez a hatalmas diadal!
\par 
\par 65. \'c9s ne szomor\'edtson el t\'e9ged [\'f3 Mohamed] az \'f5 besz\'e9d\'fck! Bizony, a m\'e9lt\'f3s\'e1g mind Allahot illeti! \'d5 a mindent Hall\'f3, a mindent L\'e1t\'f3.
\par 66. L\'e1m, bizony Allah\'e9 mindenki, aki az egekben van \'e9s mindenki, aki a f\'f6ld\'f6n van! \'c9s mit k\'f6vetnek azok, akik Allah helyett t\'e1rsistenekhez foh\'e1szkodnak? \'d5k csup\'e1n v\'e9leked\'e9st k\'f6vetnek, \'e9s \'f5k csak tal\'e1
lgatnak.
\par 67. \'d5 az, aki arra rendelte nektek az \'e9jszak\'e1t, hogy nyugalomra leljetek benne, \'e9s a nappalt arra, hogy l\'e1that\'f3v\'e1 tegye [a dolgokat]. Bizony, ebben jelek vannak egy olyan n\'e9p sz\'e1m\'e1ra, akik hallanak.
\par 68. \'c9s azt mondj\'e1k: \'84Allah gyermek\'e9v\'e9 tett [valakit].\'94 Magasztaltass\'e9k! \'d5 a Gazdag! Az \'d6v\'e9 mindaz, ami az egekben \'e9s mindaz, ami a f\'f6ld\'f6n van. Nincs nektek erre egyetlen bizony\'edt\'f3 \'e9
rvetek sem. Vajon olyat mondtok Allahr\'f3l, amir\'f5l nem tudtok?
\par 69. Mondd [\'f3 Mohamed]: \'84Bizony azok, akik Allah ellen hazugs\'e1got tal\'e1lnak ki, nem fognak boldogulni.\'94
\par 70. [Muland\'f3] \'e9lvezet [az \'f6v\'e9k] az evil\'e1gon, azut\'e1n Hozz\'e1nk lesz a visszat\'e9r\'e9s\'fck, azt\'e1n meg\'edzleltetj\'fck vel\'fck a s\'falyos gy\'f6trelmet, amiatt, hogy hitetlenn\'e9 v\'e1ltak.
\par 
\par 71. \'c9s recit\'e1ld el nekik No\'e9 h\'edr\'e9t (t\'f6rt\'e9net\'e9t), amikor azt mondta a n\'e9p\'e9nek: \'84\'d3 n\'e9pem! Ha nehezen viselitek [a k\'f6ztetek val\'f3] tart\'f3zkod\'e1som \'e9s [a nektek sz\'f3l\'f3] eml\'e9keztet\'e9
sem Allah jeleire, akkor \'e9n Allahra hagyatkozom! Egyes\'edts\'e9tek terveiteket \'e9s [h\'edvj\'e1tok seg\'edts\'e9g\'fcl] azokat, akiket [Allah mell\'e9] t\'e1rsistenk\'e9nt \'e1ll\'edtottatok, majd pedig ne legyen k\'e9ts\'e9ges sz\'e1
motokra a tervetek, azt\'e1n hajts\'e1tok v\'e9gre [a terveteket] ellenem, \'e9s ne adjatok halad\'e9kot!
\par 72. \'c9s ha h\'e1tat ford\'edtotok, h\'e1t \'e9n nem k\'e9rtem t\'f5letek semmilyen fizets\'e9get. Az \'e9n fizets\'e9gem csup\'e1n Allahra tartozik, \'e9s arra lettem felsz\'f3l\'edtva, hogy azokhoz tartozzam, akik al\'e1vetik magukat [Allahnak].\'94

\par 73. \'c1m meghazudtolt\'e1k \'f5t, mi pedig megmentett\'fck \'f5t \'e9s azokat, akik vele voltak a b\'e1rk\'e1n, \'e9s ut\'f3dokk\'e1 (m\'e1sok hely\'e9be l\'e9p\'f5 nemzed\'e9kekk\'e9) tett\'fck meg \'f5ket, \'e9s v\'ed
zbe fullasztottuk azokat, akik meghazudtolt\'e1k a jeleinket. N\'e9zd h\'e1t meg milyen v\'e9gre jutottak azok, akik figyelmeztetve lettek!
\par 
\par 74. Azut\'e1n k\'fcld\'f6tteket k\'fcldt\'fcnk \'f5ut\'e1na a n\'e9p\'fckh\'f6z, \'f5k pedig vil\'e1gos bizony\'edt\'e9kokat hoztak el nekik, \'e1m \'f5k nem hittek volna abban, amit meghazudtoltak kor\'e1bban. Mi \'edgy pecs\'e9telj\'fck le azok sz\'edv
\'e9t, akik t\'falkap\'e1sra vetemednek.
\par 75. Azut\'e1n elk\'fcldt\'fck ut\'e1nuk M\'f3zest \'e9s \'c1ront a F\'e1ra\'f3hoz \'e9s az el\'f5kel\'f5ihez a jeleinkkel. \'c1m azok fennh\'e9j\'e1ztak, \'e9s gonosztev\'f5 n\'e9p voltak.
\par 76. Miut\'e1n elj\'f6tt hozz\'e1juk az igazs\'e1g T\'f5l\'fcnk, azt mondt\'e1k: \'84Bizony ez nyilv\'e1nval\'f3 var\'e1zslat!\'94
\par 77. Azt mondta M\'f3zes: \'84Vajon azt mondj\'e1tok az igazs\'e1gr\'f3l, miut\'e1n elj\'f6tt hozz\'e1tok: \'84Vajon var\'e1zslat ez? \'c1m nem boldogulnak a var\'e1zsl\'f3k!\'94
\par 78. Azt mondt\'e1k: \'84Vajon az\'e9rt j\'f6tt\'e9l el hozz\'e1nk, hogy elford\'edts minket att\'f3l, amin ap\'e1inkat tal\'e1ltuk, \'e9s hogy kett\'f5t\'f6k nagys\'e1gra [\'e9s hatalomra] tehessen szert [Egyiptom] f\'f6ldj\'e9n? \'c1m mi nem hisz\'fc
nk kett\'f5t\'f6knek.\'94}{\insrsid3161635 
\par 
\par }{\insrsid3161635\charrsid3107015 79. Azt mondta a F\'e1ra\'f3: \'84Hozz\'e1tok el hozz\'e1m az \'f6sszes tud\'f3s var\'e1zsl\'f3t!\'94
\par 80. Amikor elj\'f6ttek a var\'e1zsl\'f3k, azt mondta nekik M\'f3zes: \'84Dobj\'e1tok azt, amit el akartok dobni!\'94
\par 81. Miut\'e1n pedig eldobt\'e1k [botjaikat \'e9s k\'f6teleiket], M\'f3zes azt mondta: \'84Amivel j\'f6ttetek, az maga a var\'e1zslat! Allah semmiv\'e9 fogja tenni azt. Bizony, Allah nem viszi sikerre azoknak a cselekedeteit, akik roml\'e1st okoznak.

\par 82. \'c9s Allah val\'f3ra v\'e1ltja az igazs\'e1got a szavai \'e1ltal, m\'e9g ha ez ut\'e1latos is a gonosztev\'f5knek.\'94
\par 83. \'c9s n\'e9p\'e9nek csup\'e1n [kev\'e9s] lesz\'e1rmazottja hitt M\'f3zesnek, f\'e9lve a F\'e1ra\'f3t\'f3l \'e9s az el\'f5kel\'f5ikt\'f5l, hogy pr\'f3b\'e1nak veti majd \'f5ket al\'e1. \'c9s bizony a F\'e1ra\'f3 fennh\'e9j\'e1z\'f3 volt a f\'f6ld\'f6n 
\'e9s bizony \'f5 a t\'falz\'f3k k\'f6z\'e9 tartozott.
\par 84. \'c9s azt mondta M\'f3zes: \'84\'d3 n\'e9pem! Ha val\'f3ban hisztek Allahban, akkor Re\'e1 hagyatkozzatok, ha val\'f3ban azok vagytok, akik al\'e1vetik magukat [Neki]!\'94
\par 85. \'c9s azt mondt\'e1k: \'84Allahra hagyatkozunk. Urunk! Ne t\'e9gy minket k\'eds\'e9rt\'e9ss\'e9 az igazs\'e1gtalan n\'e9p sz\'e1m\'e1ra,
\par 86. \'c9s ments meg minket k\'f6ny\'f6r\'fcleted \'e1ltal a hitetlen n\'e9pt\'f5l!\'94
\par 
\par 87. \'c9s azt sugalltuk M\'f3zesnek \'e9s a testv\'e9r\'e9nek, hogy: \'84Jel\'f6ljetek ki a n\'e9peteknek Egyiptomban h\'e1zakat lak\'f3hely\'fcl, \'e9s tegy\'e9tek meg a h\'e1zaitokat imahelyekk\'e9, \'e9s tarts\'e1tok meg az im\'e1dkoz\'e1st! \'c9
s adj [\'f3 M\'f3zes] \'f6r\'f6mh\'edrt a h\'edv\'f5knek!\'94
\par 88. \'c9s azt mondta M\'f3zes: \'84Urunk! Bizony, a F\'e1ra\'f3nak \'e9s az el\'f5kel\'f5inek d\'edszeket \'e9s vagyont adt\'e1l az evil\'e1gi \'e9letben, \'e1m - \'f3 Urunk! - \'f5k elt\'e9vely\'edtettek [m\'e1sokat] az Utadr\'f3l. Urunk, puszt\'ed
tsd a vagyonukat \'e9s kem\'e9ny\'edtsd meg sz\'edv\'fcket, hogy ne higgyenek addig, am\'edg meg nem l\'e1tj\'e1k a f\'e1jdalmas gy\'f6trelmet!\'94
\par 89. Azt mondta [Allah]: \'84Kett\'f5t\'f6k foh\'e1sza meghallgattatott, j\'e1rjatok h\'e1t az Egyenes \'faton, \'e9s ne k\'f6vess\'e9tek azoknak az \'fatj\'e1t, akik nem rendelkeznek tud\'e1ssal!\'94
\par 
\par 90. \'c9s \'e1tvezett\'fck Izrael fiait a tengeren, \'e9s k\'f6vette \'f5ket a F\'e1ra\'f3 \'e9s a katon\'e1i zsarnoks\'e1gb\'f3l \'e9s ellens\'e9gesked\'e9sb\'f5l. Amikor pedig utol\'e9rte a v\'edzbe fullad\'e1s, azt mondta [a F\'e1ra\'f3]: \'84
Hiszem, hogy nincs m\'e1s isten csak az, akiben Izrael fiai hisznek, \'e9s \'e9n azok k\'f6z\'e9 tartozom, akik al\'e1vetik magukat [Neki].\'94
\par 91. Vajon [csak] most, holott kor\'e1bban m\'e1r ellenszeg\'fclt\'e9l \'e9s a roml\'e1st okoz\'f3k k\'f6z\'e9 tartozt\'e1l?
\par 92. \'c9s a mai napon megment\'fcnk t\'e9ged a testedet illet\'f5en, hogy jel legy\'e9l azok sz\'e1m\'e1ra, akik ut\'e1nad [j\'f6nnek]. \'c1m bizony sokan az emberek k\'f6z\'fcl figyelmen k\'edv\'fcl hagyj\'e1k a jeleinket.
\par 93. \'c9s Izrael fiainak bizony [rem\'e9nyeiket] beigazol\'f3 lak\'f3helyet jel\'f6lt\'fcnk ki, \'e9s j\'f3 dolgokkal l\'e1ttuk el \'f5ket. \'c1m nem k\'fcl\'f6nb\'f6ztek \'f6ssze, csak miut\'e1n elj\'f6tt hozz\'e1juk a tud\'e1s. Bizony, Urad d\'f6
nteni fog k\'f6z\'f6tt\'fck a Felt\'e1mad\'e1s Napj\'e1n abban, amiben \'f6sszek\'fcl\'f6nb\'f6ztek.
\par 
\par 94. \'c9s ha k\'e9ts\'e9gben lenn\'e9l afel\'f5l, ami lebocs\'e1ttatott neked, akkor k\'e9rdezd meg azokat, akik olvass\'e1k az \'cdr\'e1st [amelyet] el\'f5tted [kaptak meg]! \'c9s bizony elj\'f6tt hozz\'e1d az Igazs\'e1g a te Uradt\'f3l. Ne tartozz h\'e1
t a k\'e9telked\'f5k k\'f6z\'e9!
\par 95. \'c9s ne tartozz azok k\'f6z\'e9, akik meghazudtolt\'e1k Allah jeleit, mert akkor a vesztesek k\'f6z\'e9 fogsz tartozni!
\par 96. Bizony akikkel szemben beteljesedett az Urad szava, azok nem hisznek [addig],
\par 97. M\'e9g ha elj\'f6nne minden jel is hozz\'e1juk, am\'edg meg nem l\'e1tj\'e1k a f\'e1jdalmas gy\'f6trelmet.
\par 
\par 98. \'c9s egyetlen telep\'fcl\'e9s sem volt, amely hitt volna, \'e9s haszn\'e1ra lett volna a hite [a b\'fcntet\'e9s l\'e1tt\'e1n], kiv\'e9ve J\'f3n\'e1s n\'e9p\'e9t. Miut\'e1n hittek, elh\'e1r\'edtottuk r\'f3luk a megsz\'e9gyen\'edt\'e9s gy\'f6trelm\'e9
t az evil\'e1gon \'e9s \'e9lvezetekben r\'e9szes\'edtett\'fck \'f5ket egy ideig.
\par 99. \'c9s ha Urad \'fagy akarta volna, akkor hinne mindenki, aki a f\'f6ld\'f6n van, mindny\'e1jan. H\'e1t vajon arra k\'e9nyszer\'edten\'e9d az embereket [\'f3 Mohamed], hogy h\'edv\'f5k legyenek?
\par 100. Egyetlen ember sem lehet h\'edv\'f5, csak Allah engedelm\'e9vel. \'c9s ekk\'e9ppen teszi Allah a f\'f6rtelmes b\'fcntet\'e9st azokra, akik nem \'e9lnek az esz\'fckkel.
\par 101. Mondd [\'f3 Mohamed]: \'84N\'e9zz\'e9tek meg mindazt, ami az egekben \'e9s a f\'f6ld\'f6n van!\'94 \'c1m a jelek \'e9s a figyelmeztet\'e9sek nem haszn\'e1lnak egy olyan n\'e9pnek, amely nem hisz.
\par 102. Vajon mi m\'e1sra v\'e1rnak, mint azok [b\'fcntet\'e9s-]napjaihoz hasonl\'f3 [napra], akik el\'f5tt\'fck t\'e1voztak el [az \'e9l\'f5k sor\'e1b\'f3l]? Mondd [\'f3 Mohamed]: \'84V\'e1rakozzatok csak! Bizony, \'e9n is veletek vagyok a v\'e1rakoz\'f3k k
\'f6z\'f6tt!\'94
\par 103. Azut\'e1n megmentj\'fck a k\'fcld\'f6tteinket \'e9s azokat, akik hisznek. Ekk\'e9ppen, a mi k\'f6teless\'e9g\'fcnk, hogy megments\'fck a h\'edv\'f5ket.
\par 
\par 104. Mondd [\'f3 Mohamed]: \'d3 ti, emberek! Ha k\'e9ts\'e9gben vagytok az \'e9n vall\'e1som fel\'f5l [tudnotok kell], hogy \'e9n nem szolg\'e1lom azt, amiket ti szolg\'e1ltok Allah helyett, hanem \'e9n Allahot szolg\'e1lom, aki mag\'e1hoz sz\'f3l\'ed
t majd titeket. \'c9s arra lettem felsz\'f3l\'edtva, hogy a h\'edv\'f5k k\'f6z\'e9 tartozzak.
\par 105. \'c9s [arra,] hogy han\'edfk\'e9nt (egyistenh\'edv\'f5k\'e9nt, a hamis vall\'e1sokt\'f3l elhajl\'f3k\'e9nt) tartsd magad a vall\'e1shoz, \'e9s ne tartozz azok k\'f6z\'e9, akik [Allah mell\'e9] t\'e1rsistent \'e1ll\'edtanak!
\par 106. \'c9s [arra, hogy] ne foh\'e1szkodj Allah helyett olyanhoz, ami nem haszn\'e1l \'e9s nem \'e1rt neked! Ha m\'e9gis megtenn\'e9d, akkor bizony az igazs\'e1gtalanok k\'f6z\'f6tt lenn\'e9l.\'94
\par 
\par 107. \'c9s ha Allah valami \'e1rtalommal illet t\'e9ged, azt nem h\'e1r\'edthatja el, csak \'d5! Ha pedig valami j\'f3t akar a sz\'e1modra, akkor semmi sem tarthatja vissza a kegy\'e9t, azt \'e9ri el vele a szolg\'e1i k\'f6z\'fcl, akit akar. \'c9s \'d5
 a Megbocs\'e1t\'f3, az Irgalmas.
\par 108. Mondd [\'f3 Mohamed]: \'84\'d3 ti, emberek! Elj\'f6tt m\'e1r hozz\'e1tok az Igazs\'e1g az Uratokt\'f3l. Aki az igaz \'fatra lel, az a maga sz\'e1m\'e1ra lel igaz \'fatra. Aki pedig elt\'e9velyedik, az csup\'e1n a maga k\'e1r\'e1ra t\'e9velyedik el. 
\'c9s \'e9n nem vagyok a ti v\'e9delmez\'f5t\'f6k.\'94
\par 109. \'c9s k\'f6vesd azt [\'f3 Mohamed], ami sugalltatott neked!}{\insrsid3161635  \'c9s l}{\insrsid3161635\charrsid3107015 egy\'e9l t\'fcrelmes [addig], am\'edg Allah [nem] \'edt\'e9lkezik! \'c9s \'d5 a legjobb az \'edt\'e9lkez\'f5k k\'f6z\'f6tt!
\par }{\insrsid3161635 
\par 
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid3161635 {\b\insrsid7550020 \page }{\b\insrsid16543947 11. }{\b\insrsid3161635\charrsid2715885 H\'fad c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid2715885 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid2715885 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid2715885 
\par 1. Alif-l\'e1m-r\'e1. \'cdr\'e1s ez, amelynek jelei (id\'e9zetei) egy\'e9rtelm\'fbv\'e9 t\'e9tettek, azut\'e1n r\'e9szletesen ki lettek fejtve az \'e1ltal, aki B\'f6lcs, [mindent] j\'f3l Ismer\'f5.
\par 2. Az\'e9rt, hogy ne szolg\'e1ljatok m\'e1st, csak Allahot. Bizony, \'e9n \'d5 \'e1ltala [k\'fcldettem] sz\'e1motokra figyelmeztet\'f5nek \'e9s \'f6r\'f6mh\'edrhoz\'f3nak.
\par 3. \'c9s hogy k\'e9rjetek megbocs\'e1t\'e1st Uratokt\'f3l, majd forduljatok Hozz\'e1 b\'fbnb\'e1nattal! [Fizets\'e9g\'fcl] egy megszabott hat\'e1rid\'f5ig sz\'e9p \'e9lvezetekben r\'e9szes\'edt titeket, \'e9s kegy\'e9ben r\'e9szes\'edt mindenkit, akinek 
\'e9rdeme van. \'c1m ha h\'e1tat ford\'edtotok, h\'e1t \'e9n f\'e9ltelek titeket egy nagy nap gy\'f6trelm\'e9t\'f5l.
\par 4. Allahhoz lesz a visszat\'e9r\'e9setek. \'c9s \'d5 minden dologra kiterjed\'f5 hatalm\'fa.
\par 5. L\'e1m, bizony, \'f5k \'f6sszez\'e1rj\'e1k a kebl\'fcket (a sz\'edv\'fcket), hogy elrejt\'f5zzenek El\'f5le. L\'e1m, amikor ruh\'e1ikkal takarj\'e1k el magukat, \'d5 tudja azt, amit eltitkolnak \'e9s amit kinyilv\'e1n\'edtanak. Bizony, Neki tudom\'e1
sa van arr\'f3l, amit a keblek rejtenek.
\par 
\par 6. \'c9s nincs egyetlen mozg\'f3 [\'e9l\'f5l\'e9ny] a f\'f6ld\'f6n, amelynek ell\'e1t\'e1sa ne tartozna Allahra, \'e9s \'d5 tudja annak nyugv\'f3hely\'e9t \'e9s \'f5rz\'f5hely\'e9t. Minden egy nyilv\'e1nval\'f3 \'cdr\'e1sban (feljegyz\'e9sben) van.
\par 7. \'c9s \'d5 az, aki megteremtette az egeket \'e9s a f\'f6ldet hat nap alatt, \'e9s a Tr\'f3nja [kor\'e1bban] a v\'edzen volt, az\'e9rt, hogy pr\'f3b\'e1ra tegyen titeket, melyik\'f5t\'f6k cselekedete helyesebb. \'c9s ha azt mondod: \'84Ti fel lesztek t
\'e1masztva a hal\'e1l ut\'e1n!\'94, akkor azok, akik hitetlenek azt mondj\'e1k: \'84Bizony ez nyilv\'e1nval\'f3 var\'e1zslat!\'94
\par 
\par 8. \'c9s ha k\'e9sleltetn\'e9nk a gy\'f6trelmet vel\'fck szemben egy megsz\'e1ml\'e1lt ideig, azt mondan\'e1k: \'84Mi tart\'f3ztatja fel [azt]?\'94 L\'e1m, azon a napon, amikor el\'e9rkezik hozz\'e1juk, nem lesz elford\'edtva t\'f5l\'fck. \'c9s k\'f6
rbeker\'edtette \'f5ket az [a b\'fcntet\'e9s], amib\'f5l g\'fanyt \'fbztek.
\par 9. \'c9s ha T\'f5l\'fcnk sz\'e1rmaz\'f3 k\'f6ny\'f6r\'fcletet \'edzleltet\'fcnk meg az emberrel, majd elragadjuk t\'f5le, akkor \'f5 bizony rem\'e9nyvesztett \'e9s h\'e1l\'e1tlan.
\par 10. \'c1m ha j\'f3t\'e9tem\'e9nyt \'edzleltet\'fcnk meg vele egy \'e1rtalom ut\'e1n, amely \'e9rte \'f5t, akkor bizony azt mondja: \'84Elm\'faltak a rossz dolgok t\'f5lem!\'94 \'d5 bizony \'f6rvendez\'f5, dicsekv\'f5.
\par 11. Kiv\'e9ve azokat, akik t\'fcrelmesek \'e9s j\'f3tetteket cselekszenek, Azoknak megbocs\'e1t\'e1s \'e9s nagy jutalom j\'e1r.
\par 
\par 12. \'c9s lehet, hogy elhagyn\'e1d egy r\'e9sz\'e9t annak, ami sugalltatott neked, \'e9s \'f6sszeszorul a sz\'edved, ami\'e9rt azt mondj\'e1k: \'84Mi\'e9rt nem bocs\'e1ttatott le neki valami kincs, vagy j\'f6tt le vele egy angyal?\'94 Bizony, te csup\'e1
n figyelmeztet\'f5 vagy! \'c9s Allah mindennek a v\'e9delmez\'f5je.
\par 
\par 13. Vagy azt mondj\'e1k: \'84\'d5 maga tal\'e1lta ki!\'94 Mondd [\'f3 Mohamed]: \'84Hozzatok h\'e1t t\'edz ehhez hasonl\'f3, kital\'e1lt sz\'far\'e1t! \'c9s foh\'e1szkodjatok ahhoz, akihez csak tudtok Allahon k\'edv\'fcl, ha val\'f3ban igazmond\'f3
k vagytok!\'94
\par 14. Ha pedig nem hallgatnak re\'e1tok, akkor tudj\'e1tok meg, hogy [a Kor\'e1n] csup\'e1n Allah tud\'e1s\'e1val [T\'f5le] bocs\'e1ttatott le, \'e9s [tudj\'e1tok meg] hogy nincs m\'e1s [jogosan im\'e1dhat\'f3] isten csak \'d5! Vajon h\'e1t al\'e1
vetitek magatokat [Neki]?
\par 
\par 15. Aki az evil\'e1gi \'e9letet \'e9s annak d\'edszeit akarja, azoknak m\'e1r abban teljess\'e9 tessz\'fck a tetteik\'e9rt [j\'e1r\'f3 fizets\'e9get] \'e9s nem lesznek ott megr\'f6vid\'edtve.
\par 16. \'d5k azok, akiknek nem lesz m\'e1s a T\'falvil\'e1gon, csak a [Pokol-]t\'fbz. Szertefoszlik az, amit abban (az evil\'e1gon) m\'fbveltek, \'e9s hi\'e1baval\'f3 az, amit cselekedtek.
\par 17. Vajon [hozz\'e1juk lenne hasonl\'f3] az, akinek Ur\'e1t\'f3l sz\'e1rmaz\'f3 vil\'e1gos bizony\'edt\'e9ka van, \'e9s [amellett] azt recit\'e1lja egy T\'f5le sz\'e1rmaz\'f3 tan\'fa, \'e9s [azon fel\'fcl] ott volt kor\'e1bban M\'f3zes \'cdr\'e1sa ir\'e1
nyad\'f3k\'e9nt \'e9s k\'f6ny\'f6r\'fcletk\'e9nt? \'d5k hisznek benne, \'e9s aki pedig hitetlenn\'e9 v\'e1lik azzal szemben a csoportok k\'f6z\'fcl, annak a [Pokol-]t\'fbz a meg\'edg\'e9rt helye. Ne legyen h\'e1t k\'e9ts\'e9ged fel\'f5le! Ez az Uradt\'f3
l sz\'e1rmaz\'f3 igazs\'e1g! \'c1m a legt\'f6bb ember nem hisz.
\par 
\par 18. \'c9s ki igazs\'e1gtalanabb ann\'e1l, [mint] aki hazugs\'e1got tal\'e1l ki Allah ellen? \'d5k majd az Uruk el\'e9 lesznek \'e1ll\'edtva \'e9s a tan\'fak azt mondj\'e1k majd: \'84\'d5k azok, akik hazudtak Allahr\'f3l. L\'e1m, Allah \'e1
tka legyen az igazs\'e1gtalanokon!\'94
\par 19. [\'d5k azok], akik t\'e1vol tartanak [m\'e1sokat] Allah \'datj\'e1t\'f3l, \'e9s azt k\'edv\'e1nj\'e1k, hogy az elhajl\'f3 legyen, \'e9s \'f5k [azok, akik] nem hisznek a t\'falvil\'e1gban.
\par 20. \'d5k nem fogj\'e1k [Allahot] megakad\'e1lyozni a f\'f6ld\'f6n [semmiben], \'e9s nincs nekik Allah helyett p\'e1rtfog\'f3juk. Megt\'f6bbsz\'f6r\'f6z\'f5dik nekik a gy\'f6trelem. Nem voltak k\'e9pesek a hall\'e1sra, \'e9s nem voltak olyanok, akik l\'e1
tnak.}{\insrsid3161635 
\par 21. \'d5k azok, akik elvesztett\'e9k magukat, \'e9s elt\'fbnt mell\'f5l\'fck az, amit kital\'e1ltak.
\par 22. Nem k\'e9ts\'e9ges, hogy bizony a t\'falvil\'e1gon \'f5k a }{\insrsid3161635\charrsid1196382 [legnagyobb] vesztesek.}{\insrsid3161635 
\par 23. Bizony azok, akik hisznek \'e9s j\'f3tetteket cselekszenek, \'e9s belenyugodtak Uruk [elrendel\'e9s\'e9be], \'f5k a Paradicsom lak\'f3i! \'d6r\'f6kk\'e9 abban fognak maradni.
\par 24. A k\'e9t csoport hasonlatos a vakhoz \'e9s a s\'fckethez, valamint a l\'e1t\'f3hoz \'e9s a hall\'f3hoz. Vajon egyenl\'f5k-e ezek? Vajon h\'e1t nem okultok [az int\'e9sb\'f5l]?
\par 
\par 25. \'c9s bizony elk\'fcldt\'fck No\'e9t az \'f5 n\'e9p\'e9hez [\'e9s \'f5 azt mondta nekik]: \'84\'c9n bizony nyilv\'e1nval\'f3 figyelmeztet\'f5 vagyok sz\'e1motokra!
\par 26. [Mondv\'e1n]: Ne szolg\'e1ljatok m\'e1st, kiv\'e9ve Allahot! \'c9n f\'e9ltelek titeket egy f\'e1jdalmas nap gy\'f6trelm\'e9t\'f5l.\'94
\par 27. \'c9s azt mondt\'e1k az el\'f5kel\'f5k, akik hitetlenn\'e9 v\'e1ltak az \'f5 n\'e9p\'e9b\'f5l: \'84Mi t\'e9ged nem l\'e1tunk m\'e1snak, csup\'e1n egy hozz\'e1nk hasonl\'f3 embernek, \'e9s azt l\'e1tjuk, hogy csak az al\'e1val\'f3k k\'f6vetnek t\'e9
ged k\'f6z\'fcl\'fcnk, meggondolatlans\'e1gb\'f3l. Nem l\'e1tunk bennetek semmi kiv\'e1lts\'e1got vel\'fcnk szemben. S\'f5t, \'fagy v\'e9lj\'fck, hogy hazugok vagytok.\'94
\par 28. Azt mondta [No\'e9]: \'84\'d3 n\'e9pem! Vajon mit gondoltok, ha Uramt\'f3l sz\'e1rmaz\'f3 vil\'e1gos bizony\'edt\'e9kom van, \'e9s T\'f5le sz\'e1rmaz\'f3 k\'f6ny\'f6r\'fcletben r\'e9szes\'edt engem, \'e1m az el lett fedve el\'f5ttetek? Er\'f5ltess\'fc
nk-e arra titeket, mik\'f6zben ti ut\'e1lj\'e1tok azt?
\par 29. \'c9s \'f3 n\'e9pem! Nem k\'e9rek t\'f5letek vagyont \'e9rte, az \'e9n fizets\'e9gem egyed\'fcl Allahra tartozik. \'c9s \'e9n nem tasz\'edtom ki azokat, akik hisznek. Bizony \'f5k tal\'e1lkozni fognak Urukkal. \'c1m bizony, \'fagy l\'e1
tom, hogy ti tudatlan n\'e9p vagytok!
\par 30. \'c9s \'f3 n\'e9pem! Ki seg\'edtene meg engem Allahhal szemben, ha kitasz\'edtan\'e1m \'f5ket? Vajon h\'e1t nem okultok [az int\'e9sb\'f5l]?
\par 31. Nem mondom nektek, hogy n\'e1lam vannak Allah t\'e1rh\'e1zai, sem azt, hogy tudom a rejtett dolgokat, \'e9s azt sem mondom, hogy \'e9n angyal vagyok, \'e9s nem mondom azokr\'f3l, akik szemetekben megvetettek, hogy Allah nem fogja \'f5ket semmi j\'f3
ban r\'e9szes\'edteni. Allah jobban tudja azt, amit magukban [tartanak]. Bizony [ha ezeket \'e1ll\'edtan\'e1m] akkor \'e9n az igazs\'e1gtalanok k\'f6z\'e9 tartozn\'e9k.\'94
\par 
\par 32. Azt mondt\'e1k: \'84\'d3 No\'e9! Bizony, vit\'e1ba sz\'e1llt\'e1l vel\'fcnk, \'e9s sokat (eleget) vit\'e1zt\'e1l vel\'fcnk, hozd h\'e1t el\'f5 azt [a b\'fcntet\'e9st], amit meg\'edg\'e9rt\'e9l nek\'fcnk, ha }{
\highlight7\insrsid3161635\charrsid6968353 val\'f3ban}{\insrsid3161635  az igazmond\'f3k k\'f6z\'fcl val\'f3 vagy!\'94
\par 33. Azt mondta [No\'e9]: \'84Egyed\'fcl Allah hozhatja el\'f5 azt nektek, ha \'d5 \'fagy akarja. \'c9s ti nem nem fogj\'e1tok [Allahot] megakad\'e1lyozni [semmiben].
\par 34. \'c9s a tan\'e1csom \endash  ha tan\'e1csot akarn\'e9k adni nektek \endash  nem fog haszn\'e1lni nektek, ha Allah t\'e9v\'fatra akar vinni titeket. \'d5 a ti Uratok, \'e9s Hozz\'e1 lesztek visszavitetve.\'94
\par 35. Vagy azt mondj\'e1k [a mekkaiak a Pr\'f3f\'e9t\'e1r\'f3l]: \'84\'d5 tal\'e1lta ki azt!\'94 Mondd [\'f3 Mohamed]: \'84Ha \'e9n tal\'e1ltam volna ki, akkor a gonosztettem engem terhel, \'e9s \'e9n elhat\'e1rol\'f3dok att\'f3l, ami gonosztettet elk\'f6
vettek.\'94
\par 
\par 36. \'c9s az sugalltatott No\'e9nak: \'84Senki sem fog hinni a n\'e9pedb\'f5l, csak azok, akik m\'e1r hittek. \'c9s ne b\'e1nk\'f3dj amiatt, amit \'f5k tesznek!
\par 37. \'c9s k\'e9sz\'edtsd el a b\'e1rk\'e1t a szem\'fcnk el\'f5tt \'e9s a sugallatunk szerint, \'e9s ne sz\'f3l\'edts Engem azok \'e9rdek\'e9ben, akik igazs\'e1gtalans\'e1got k\'f6vettek el! Bizony, \'f5k v\'edzbe lesznek fullasztva!\'94
\par 
\par 38. \'c9s elk\'e9sz\'edtette a b\'e1rk\'e1t, \'e9s valah\'e1nyszor el\'f5kel\'f5k haladtak el mellette az \'f5 n\'e9p\'e9b\'f5l, }{\insrsid3161635\charrsid10750998 g\'fanyol\'f3dtak rajta}{\insrsid3161635 . Azt mondta: \'84Ha ti g\'fanyol\'f3
dtok rajtunk, h\'e1t mi is g\'fanyol\'f3dni fogunk rajtatok, ahogyan [most] ti g\'fanyol\'f3dtok.
\par 39. \'c9s meg fogj\'e1tok tudni, hogy kit s\'fajt olyan gy\'f6trelem, amely megsz\'e9gyen\'edti, \'e9s kire telepszik \'f6r\'f6kk\'e9 tart\'f3 gy\'f6trelem.\'94
\par }\pard \qj \li0\ri0\widctlpar\tx7797\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635 40. Azt\'e1n, amikor elj\'f6tt a Mi parancsunk \'e9s [jelk\'e9nt] felforrt a katlan (el\'f5t\'f6rt a forr\'f3 v\'edz a f\'f6
ldfelsz\'ednb\'f5l), azt mondtuk: \'84Vigy\'e9l bele [a b\'e1rk\'e1ba] minden [fajt\'e1b\'f3l] egy p\'e1rt, kett\'f5t (h\'edmet \'e9s n\'f5st\'e9nyt) \'e9s a csal\'e1dodat \endash  kiv\'e9ve azt, akivel szemben m\'e1r elhangzott a szavunk \endash  \'e9
s azokat, akik hisznek!\'94 \'c1m kevesen voltak, akik vele egy\'fctt hittek.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635 
\par 41. \'c9s azt mondta [No\'e9]: \'84Sz\'e1lljatok fel r\'e1! Allah nev\'e9ben legyen a halad\'e1sa \'e9s a kik\'f6t\'e9se! Bizony az \'e9n Uram Megbocs\'e1t\'f3, Irgalmas.\'94
\par 42. \'c9s [a b\'e1rka] a hegyekhez hasonl\'f3 hull\'e1mokon haladt vel\'fck, \'e9s No\'e9 sz\'f3l\'edtotta a fi\'e1t, aki egy f\'e9lrees\'f5 helyen volt: \'84\'d3 fiacsk\'e1m! Sz\'e1llj fel vel\'fcnk, \'e9s ne l\'e9gy a hitetlenekkel!\'94
\par 43. Azt mondta [a fia]: \'84Mened\'e9khelyet fogok keresni a hegyen, amely megv\'e9d engem a v\'edzt\'f5l.\'94 Azt mondta [No\'e9]: \'84Nincs ma v\'e9delmez\'f5 [aki megv\'e9dene] Allah parancs\'e1t\'f3l, kiv\'e9ve azt, akin megk\'f6ny\'f6r\'fcl.\'94 \'c9
s a hull\'e1m elv\'e1lasztotta \'f5ket egym\'e1st\'f3l, \'e9s [No\'e9 fia] a v\'edzbefullasztottak k\'f6z\'fcl val\'f3 volt.
\par 44. Az mondatott: \'84\'d3 f\'f6ld! Nyeld el a vizedet! \'c9s \'f3, \'c9g! Hagyj fel [az es\'f5z\'e9ssel]!\'94 A v\'edz leapadt \'e9s eld\'f6ntetett az \'fcgy. \'c9s [a b\'e1rka] a Dzs\'fad\'edj [hegyen] helyezkedett el, \'e9s az mondatott: \'84
Pusztuljon az igazs\'e1gtalan n\'e9p!\'94
\par 
\par 45. \'c9s No\'e9 sz\'f3l\'edtotta az \'f5 Ur\'e1t, \'e9s azt mondta: \'84Uram! A fiam a csal\'e1domhoz tartozik, \'e9s bizony a Te \'edg\'e9reted igaz! \'c9s Te vagy a legb\'f6lcsebb az \'edt\'e9lkez\'f5k k\'f6z\'f6tt!\'94
\par 46. [Allah] azt mondta: \'84\'d3 No\'e9! Bizony \'f5 nem tartozik a csal\'e1dodhoz. Bizony, az [\'f5 cselekedete] nem helyes cselekedet! Ne k\'e9rj h\'e1t olyat, amir\'f5l nem rendelkezel tud\'e1ssal! Bizony, \'f3va intelek att\'f3l, hogy a tudatlanok k
\'f6z\'f6tt legy\'e9l!\'94
\par 47. Azt mondta [No\'e9]: \'84Uram! Mened\'e9ket k\'e9rek T\'f5led [az ellen], hogy olyat k\'e9rjek T\'f5led, amir\'f5l }{\insrsid3161635\charrsid13073271 nem rendelkezem tud\'e1ssal}{\insrsid3161635 . \'c9s ha nem bocs\'e1tasz meg nekem \'e9s [nem] k\'f6
ny\'f6r\'fclsz rajtam, akkor \'e9n a vesztesek k\'f6z\'f6tt leszek!\'94
\par 48. Az mondatott: \'84\'d3 No\'e9! Menj le a T\'f5l\'fcnk sz\'e1rmaz\'f3 b\'e9kess\'e9ggel \'e9s \'e1ld\'e1sokkal, rajtad \'e9s azon k\'f6z\'f6ss\'e9geken, akik veled vannak [\'e9s azokon a h\'edv\'f5k\'f6n, akik t\'f5l\'fck fognak sz\'e1rmazni]! \'c1
m [lesznek m\'e1s] k\'f6z\'f6ss\'e9gek [is], akiket \'e9lvezetekben r\'e9szes\'edt\'fcnk [egy ideig], majd f\'e1jdalmas gy\'f6trelem \'e9ri el \'f5ket T\'f5l\'fcnk.\'94
\par 
\par 49. Ezek azon h\'edrekb\'f5l val\'f3k, amelyek [el\'f5tted, \'f3 Mohamed,] rejtve voltak, \'e1m mi [kinyilatkoztat\'e1sk\'e9nt] sugalljuk neked. Nem tudt\'e1l r\'f3luk, sem a te n\'e9ped kor\'e1bban. Legy\'e9l h\'e1t t\'fcrelmes! Bizony, a [j\'f3] v\'e9
g az istenf\'e9l\'f5k\'e9!
\par 
\par 50. \'c9s \'c1dhoz a testv\'e9r\'fcket H\'fadot [}{\insrsid3161635\charrsid14055177 k\'fcldt\'fck el], aki azt mondta: \'84\'d3 n\'e9pem! Szolg\'e1lj\'e1tok Allahot! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten a sz\'e1motokra Rajta k\'edv\'fcl! Ti csup
\'e1n hazugs\'e1got tal\'e1ltok ki.
\par 51. \'d3 n\'e9pem! Nem k\'e9rek t\'f5letek ez\'e9rt fizets\'e9get. Az \'e9n fizets\'e9gem egyed\'fcl arra tartozik, aki l\'e9trehozott engem. Vajon h\'e1t nem \'e9ltek az eszetekkel?
\par 52. \'d3 n\'e9pem! K\'e9rjetek megbocs\'e1t\'e1st Uratokt\'f3l, majd forduljatok Hozz\'e1 b\'fbnb\'e1nattal! \'d5 b\'f5s\'e9gesen \'e1rad\'f3 eget k\'fcld nektek, \'e9s er\'f5t\'f6ket [tov\'e1bbi] er\'f5vel gyarap\'edtja. \'c9s ne ford\'edtsatok h\'e1
tat gonosztev\'f5k\'e9nt!\'94
\par 53. \'d5k azt mondt\'e1k: \'84\'d3 H\'fad! Te nem j\'f6tt\'e9l hozz\'e1nk nyilv\'e1nval\'f3 bizony\'edt\'e9kkal. \'c9s mi nem hagyjuk el az isteneinket a te szavad alapj\'e1n, \'e9s mi nem hisz\'fcnk neked!
\par 54. Mi nem mondunk m\'e1st, csak azt, hogy valamely isten\'fcnk rosszal illetett t\'e9ged.\'94 Azt mondta [H\'fad]: \'84Allahot h\'edvom tan\'fak\'e9nt \'e9s tan\'faskodjatok ti is arr\'f3l, hogy \'e9n elhat\'e1rol\'f3dom att\'f3l, amit ti t\'e1rsistenk
\'e9nt \'e1ll\'edtotok,
\par 55. [Allah] mell\'e9! Sz\'f5jetek csak fondorlatot ellenem mindannyian, majd ne adjatok halad\'e9kot!
\par 56. Bizony, \'e9n Allahra, az \'e9n Uramra \'e9s a ti Uratokra hagyatkozom! Nincs egyetlen mozg\'f3 [\'e9l\'f5l\'e9ny], amelynek ne ragadn\'e1 meg az \'fcst\'f6k\'e9t. Bizony, az \'e9n Uram az Egyenes \'faton van!
\par 57. Ha h\'e1tat ford\'edtotok, bizony \'e9n \'e1tadtam azt, amivel elk\'fcldettem hozz\'e1tok. Az \'e9n Uram m\'e1s n\'e9pet fog a helyetekbe l\'e9ptetni ut\'f3dk\'e9nt. \'c9s ti semmiben sem fogtok \'e1rtani Neki. Bizony, az \'e9n Uram mindenek felett 
\'d5rz\'f5.\'94
\par 58. \'c9s miut\'e1n elj\'f6tt a mi parancsunk, a T\'f5l\'fcnk val\'f3 k\'f6ny\'f6r\'fclet \'e1ltal megmentett\'fck H\'fadot \'e9s azokat, akik hittek vele egy\'fctt. S\'falyos gy\'f6trelemt\'f5l mentett\'fck meg \'f5ket.
\par 59. \'c9s ez volt \'c1d! Tagadt\'e1k Uruk jeleit \'e9s ellenszeg\'fcltek a k\'fcld\'f6tteinek \'e9s k\'f6vett\'e9k minden hatalmaskod\'f3, makacs parancs\'e1t.
\par 60. Az evil\'e1gon \'e1tok k\'fcldetett a nyomukba \'e9s a Felt\'e1mad\'e1s Napj\'e1n is. L\'e1m, bizony \'c1d hitetlenn\'e9 v\'e1lt Ur\'e1val szemben. L\'e1m, pusztuljon \'c1d, H\'fad n\'e9pe!
\par 
\par 61. \'c9s Tam\'fadhoz a testv\'e9r\'fcket, Sz\'e1lehot [k\'fcldt\'fck el]. Azt mondta: \'84\'d3 n\'e9pem! Allahot szolg\'e1lj\'e1tok! Nincs sz\'e1motokra m\'e1s [jogosan im\'e1dhat\'f3] isten Rajta k\'edv\'fcl! \'d5 hozott l\'e9tre titeket a f\'f6ldb\'f5
l, \'e9s r\'e1tok b\'edzta annak felvir\'e1goztat\'e1s\'e1t. K\'e9rjetek h\'e1t megbocs\'e1t\'e1st T\'f5le, majd forduljatok Hozz\'e1 b\'fbnb\'e1nattal! Bizony, az \'e9n Uram K\'f6zeli, Meghallgat\'f3.\'94
\par 62. Azt mondt\'e1k: \'84\'d3 Sz\'e1leh! Bizony, ezel\'f5tt te volt\'e1l k\'f6z\'f6tt\'fcnk az, akihez nagy rem\'e9nyeket f\'fbzt\'fcnk. Vajon azt akarod megtiltani nek\'fcnk, hogy azt szolg\'e1ljuk, amit ap\'e1ink is szolg\'e1ltak? \'c9
s bizony, mi elbizonytalan\'edt\'f3 k\'e9ts\'e9gben vagyunk azzal kapcsolatban, amire h\'edvsz minket.\'94
\par 63. Azt mondta: \'84\'d3 n\'e9pem! Vajon mit gondoltok, ha Uramt\'f3l sz\'e1rmaz\'f3 vil\'e1gos bizony\'edt\'e9kom van, \'e9s T\'f5le sz\'e1rmaz\'f3 k\'f6ny\'f6r\'fcletben r\'e9szes\'edt engem? Ki fog engem megseg\'edteni Allahhal szemben, ha ellenszeg
\'fcl\'f6k Neki? \'c9s nem gyarap\'edtotok engem m\'e1sban, csak vesztes\'e9gben.
\par 64. \'c9s \'f3 n\'e9pem! Allah eme n\'f5st\'e9nytev\'e9je jel sz\'e1motokra! Engedj\'e9tek h\'e1t enni Allah f\'f6ldj\'e9n, \'e9s ne illess\'e9tek rosszal, mert akkor k\'f6zeli gy\'f6trelem ragad el titeket!\'94
\par 65. Azt\'e1n elv\'e1gt\'e1k a n\'f5st\'e9nyteve l\'e1bin\'e1t. Azt mondta [Sz\'e1leh]: \'84\'c9lvezz\'e9tek [az evil\'e1gi \'e9letet m\'e9g] h\'e1rom napig lakhelyeiteken! Ez olyan \'edg\'e9ret, amely nem hazudtoltatik meg!\'94
\par 66. \'c9s miut\'e1n elj\'f6tt a mi parancsunk [a b\'fcntet\'e9sr\'f5l], megmentett\'fck Sz\'e1lehot \'e9s azokat, akik hittek vele egy\'fctt T\'f5l\'fcnk val\'f3 k\'f6ny\'f6r\'fclet \'e1ltal, \'e9s [megmentett\'fck \'f5ket] ama napnak a megsz\'e9gyen\'edt
\'e9s\'e9t\'f5l. Bizony, Urad az Er\'f5s, a M\'e9lt\'f3s\'e1gteljes.
\par 67. \'c9s elragadta a ki\'e1lt\'e1s azokat, akik igazs\'e1gtalans\'e1got k\'f6vettek el, \'e9s reggelre t\'e9rd\'fckre esve [holtan] fek\'fcdtek a lakhely\'fck\'f6n.
\par 68. Mintha soha nem lakoztak volna ott. L\'e1m, bizony Tam\'fad hitetlenn\'e9 v\'e1lt Ur\'e1val szemben. L\'e1m, pusztuljon Tam\'fad!
\par 
\par 69. \'c9s bizony elj\'f6ttek a k\'fcld\'f6tteink \'c1brah\'e1mhoz az \'f6r\'f6mh\'edrrel. Azt mondt\'e1k [az angyalok]: \'84B\'e9kess\'e9g!\'94 Azt mondta [\'c1brah\'e1m]: \'84B\'e9kess\'e9g!\'94 \'c9s nem id\'f5z\'f6tt [sok\'e1ig] azzal, hogy egy s\'fc
lt borj\'fat hozzon el\'f5 [vend\'e9gl\'e1t\'e1sul].
\par 70. \'c9s amikor pedig l\'e1tta, hogy kez\'fck nem \'e9r hozz\'e1, viszolygott t\'f5l\'fck, \'e9s f\'e9lelmet \'e9rzett miattuk. Azt mondt\'e1k: \'84Ne f\'e9lj! Bizony, mi L\'f3t n\'e9p\'e9hez k\'fcldett\'fcnk el!\'94
\par 71. \'c9s a feles\'e9ge ott \'e1llt, s nevetett [\'f6r\'f6m\'e9ben]. Mi pedig \'f6r\'f6mh\'edrt adtunk neki Izs\'e1k [sz\'fclet\'e9s\'e9r\'f5l] \'e9s Izs\'e1k ut\'e1n [annak fi\'e1r\'f3l] J\'e1kobr\'f3l.
\par 72. Azt mondta: \'84Jaj nekem! Vajon sz\'fclni fogok, mik\'f6zben \'f6regasszony vagyok, \'e9s a f\'e9rjem is aggasty\'e1n? Bizony csod\'e1lkoz\'e1sra okot ad\'f3 dolog ez!\'94
\par 73. Azt mondt\'e1k: \'84Vajon csod\'e1lkozol Allah parancs\'e1n? Allah k\'f6ny\'f6r\'fclete \'e9s \'e1ld\'e1sai re\'e1tok, \'f3 [\'c1brah\'e1m] h\'e1zn\'e9pe! Bizony, \'d5 Dics\'e9retrem\'e9lt\'f3, Dics\'f5s\'e9ges!\'94
\par 74. \'c9s miut\'e1n elt\'e1vozott \'c1brah\'e1mr\'f3l a f\'e9lelem, \'e9s elj\'f6tt hozz\'e1 az \'f6r\'f6mh\'edr, vit\'e1ba sz\'e1llt Vel\'fcnk (a Mi angyalainkkal) L\'f3t n\'e9p\'e9t illet\'f5en.
\par 75. Bizony, \'c1brah\'e1m b\'e9ket\'fbr\'f5, [Allahhoz] al\'e1zatosan \'e9s gyakran foh\'e1szkod\'f3, [b\'fbnb\'e1n\'f3an] visszat\'e9r\'f5 [volt].
\par 76. [Az angyalok azt mondt\'e1k:] \'84\'d3 \'c1brah\'e1m! Fordulj el ett\'f5l! Bizony, imm\'e1r elj\'f6tt Urad parancsa \'e9s bizony olyan gy\'f6trelem j\'f6n el hozz\'e1juk, amely nem h\'e1r\'edthat\'f3 el.\'94
\par 
\par 77. \'c9s amikor elj\'f6ttek a k\'fcld\'f6tteink L\'f3thoz, elszomorodott \'e9s gondterhelt lett miattuk. \'c9s azt mondta: \'84Ez egy iszony\'fa nap.\'94
\par 78. \'c9s rohanva j\'f6tt hozz\'e1 a n\'e9pe [t\'fclekedve], \'e9s \'f5k rossz tetteket cselekedtek kor\'e1bban. Azt mondta: \'84\'d3 n\'e9pem! Itt vannak a l\'e1nyaim (a feles\'e9geitek), \'f5k tiszt\'e1bbak a sz\'e1motokra. \'c9s f\'e9lj\'e9
tek Allahot, \'e9s ne sz\'e9gyen\'edtsetek meg a vend\'e9geimet illet\'f5en! Vajon nincs k\'f6z\'f6ttetek helyesen gondolkod\'f3 f\'e9rfi?\'94
\par 79. Azt mondt\'e1k: \'84Te tudod, hogy nincs a l\'e1nyaidra (az asszonyokra) sz\'fcks\'e9g\'fcnk, \'e9s bizony, azt is tudod, hogy mit akarunk.\'94
\par 80. Azt mondta [L\'f3t]: \'84B\'e1rcsak lenne er\'f5m veletek szemben, vagy szil\'e1rd t\'e1maszt\'e9khoz menek\'fclhetn\'e9k!\'94
\par }\pard \qj \li0\ri0\widctlpar\tx6120\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid14055177 81. Azt mondt\'e1k [az angyalok]: \'84\'d3 L\'f3t! Bizony, mi Urad k\'fcld\'f6ttei vagyunk! \'d5k nem \'e9
rhetnek el hozz\'e1d. \'c9s indulj el \'e9jszaka a csal\'e1doddal az \'e9jjel egy r\'e9sze alatt \endash  senki meg ne forduljon k\'f6z\'fcletek \endash  kiv\'e9ve a feles\'e9ged [aki meg fog fordulni]! Bizony, \'f5t az fogja s\'fajtani, ami a t\'f6
bbieket (a gonosztev\'f5ket) s\'fajtja. Bizony, a reggel lesz az meg\'edg\'e9rt idej\'fck. Vajon nincs-e k\'f6zel a reggel?\'94
\par 82. \'c9s amikor meg\'e9rkezett a parancsunk, feje tetej\'e9re \'e1ll\'edtottuk (elpuszt\'edtottuk) [a v\'e1rost], \'e9s egym\'e1sra r\'e9tegzett, \'e9getett agyagb\'f3l val\'f3 k\'f6veket z\'fad\'edtottunk r\'e1juk,
\par 83. [Amelyek] meg vannak jel\'f6lve Uradn\'e1l. \'c9s ez [a b\'fcntet\'e9s] nem \'e1ll messze az igazs\'e1gtalanokt\'f3l.}{\insrsid3161635 
\par 
\par 84. \'c9s Midi\'e1nhoz testv\'e9r\'fcket, Suajbot [k\'fcldt\'fck el]. Azt mondta: \'84\'d3 n\'e9pem! Szolg\'e1lj\'e1tok Allahot! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten sz\'e1motokra Rajta k\'edv\'fcl! \'c9s ne cs\'f6kkents\'e9tek a kim\'e9r\'e9st 
\'e9s a m\'e9rleggel val\'f3 m\'e9r\'e9st! Bizony, \'e9n azt l\'e1tom, hogy j\'f3l megy a sorotok. \'c9s bizony, \'e9n f\'e9ltelek titek egy mindent k\'f6r\'fclvev\'f5 nap gy\'f6trelm\'e9t\'f5l!
\par 85. \'c9s \'f3 n\'e9pem! Tegy\'e9tek teljess\'e9 a kim\'e9r\'e9st \'e9s [haszn\'e1lj\'e1tok] a m\'e9rleget igazs\'e1gosan, \'e9s ne r\'f6vid\'edts\'e9tek meg az embereket semmiben, \'e9s ne j\'e1rjatok [gonoszul] a f\'f6ld\'f6n roml\'e1st okozva!
\par 86. A megmarad\'f3 [}{\insrsid3161635\charrsid14055177 tisztess\'e9ges ell\'e1t\'e1s] Allaht\'f3l jobb nektek, [mint a csal\'e1ssal szerzett vagyon,] ha val\'f3ban h\'edv\'f5k vagytok. \'c9s \'e9n nem vagyok felettetek \'f5rz\'f5.\'94
\par 87. Azt mondt\'e1k: \'84\'d3 Suajb! Vajon im\'e1dkoz\'e1said sz\'f3l\'edtanak fel t\'e9ged arra, hogy elhagyjuk azt, amit ap\'e1ink szolg\'e1ltak, vagy azt, hogy a javainkkal ne azt tegy\'fck, amit akarunk? [Pedig] te bizony a b\'e9ket\'fbr\'f5
, a helyesen gondolkod\'f3 vagy!\'94
\par 88. Azt mondta [Suajb]: \'84\'d3 n\'e9pem! Vajon mit gondoltok, ha vil\'e1gos bizony\'edt\'e9kom van Uramt\'f3l, aki sz\'e9p ell\'e1t\'e1ssal l\'e1tott el engem? \'c9s nem akarok azzal ellent\'e9tesen cselekedni, amit megtiltok nektek. Nem }{
\insrsid3161635\charrsid14495132 akarok m\'e1st, csup\'e1n a javul\'e1st [hozni], amennyire csak k\'e9pes vagyok. \'c1m nem lehet sikerem, csak Allah \'e1ltal, \'d5r\'e1 hagyatkozom \'e9s Hozz\'e1 t\'e9rek vissza megb\'e1n\'e1ssal.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid14495132 89. \'c9s \'f3 n\'e9pem! A velem val\'f3 szak\'edt\'e1sotok ne ind\'edtson titeket [a hitetlens\'e9
g melletti kitart\'e1sra], nehogy ahhoz hasonl\'f3 s\'fajtson titeket, mint ami No\'e9 n\'e9p\'e9t vagy H\'fad n\'e9p\'e9t vagy Sz\'e1leh n\'e9p\'e9t s\'fajtotta! \'c9s L\'f3t n\'e9pe nincs messze t\'f5letek.
\par 90. \'c9s k\'e9rjetek megbocs\'e1t\'e1st az Uratokt\'f3l, majd forduljatok Hozz\'e1 b\'fbnb\'e1nattal! Bizony az \'e9n Uram Irgalmas, Szeretetteljes.\'94
\par 91. Azt mondt\'e1k: \'84\'d3 Suajb! Nem sokat \'e9rt\'fcnk mi abb\'f3l, amit te mondasz, \'e9s mi gyeng\'e9nek l\'e1tunk t\'e9ged magunk k\'f6z\'f6tt. \'c9s ha nem a kl\'e1nod lenne, akkor bizony megk\'f6vezn\'e9nk t\'e9ged. \'c9s neked nincs tekint\'e9
lyed el\'f5tt\'fcnk.\'94
\par 92. Azt mondta [Suajb]: \'84\'d3 n\'e9pem! Vajon a kl\'e1nod nagyobb tekint\'e9llyel b\'edr el\'f5ttetek, mint Allah? \'c9s az \'d5 [parancsait] a h\'e1tatok m\'f6g\'e9 helyezt\'e9tek. Bizony, Allah [tud\'e1sa] k\'f6r\'fclveszi mindazt, amit cselekszenek.

\par 93. \'c9s \'f3 n\'e9pem! Cselekedjetek helyzetetek (m\'f3dszeretek) szerint! Bizony, \'e9n is cselekedni fogok [a m\'f3dszerem szerint]. \'c9s meg fogj\'e1tok tudni, hogy kit s\'fajt az a gy\'f6trelem, amely megsz\'e9gyen\'edti, \'e9
s azt, hogy ki a hazug! \'c9s figyeljetek csak, bizony \'e9n is veletek egy\'fctt figyelek!\'94}{\insrsid3161635 
\par }{\insrsid3161635\charrsid14495132 94. \'c9s amikor elj\'f6tt a Mi parancsunk [a b\'fcntet\'e9sr\'f5l], megmentett\'fck Suajbot \'e9s azokat, akik vele egy\'fctt hittek, T\'f5l\'fcnk val\'f3 k\'f6ny\'f6r\'fclet \'e1ltal, \'e9s elragadta a ki\'e1lt\'e1
s azokat, akik igazs\'e1gtalans\'e1got k\'f6vettek el, \'e9s reggelre t\'e9rd\'fckre esve [holtan] fek\'fcdtek a lakhely\'fck\'f6n.
\par 95. Mintha soha nem lakoztak volna ott. Pusztuljon Midi\'e1n, amik\'e9nt elpusztult Tam\'fad is!
\par 
\par 96. \'c9s bizony elk\'fcldt\'fck kor\'e1bban M\'f3zest a jeleinkkel \'e9s nyilv\'e1nval\'f3 bizony\'edt\'e9kkal,
\par 97. A F\'e1ra\'f3hoz \'e9s az el\'f5kel\'f5ihez. \'c9s \'f5k a F\'e1ra\'f3 parancs\'e1t k\'f6vett\'e9k, \'e1m a F\'e1ra\'f3 parancsa nem vezet helyes \'fatra.
\par 98. A n\'e9pe \'e9l\'e9n halad majd a Felt\'e1mad\'e1s napj\'e1n, \'e9s itat\'f3helyre vezeti \'f5ket, a [Pokol-]t\'fbzh\'f6z. Milyen nyomor\'fas\'e1gos itat\'f3hely, amelyhez vezettetnek!
\par 99. \'c9s ebben (az evil\'e1gon) \'e1tok k\'f6vette \'f5ket \'e9s [\'e1tok lesz rajtuk] a Felt\'e1mad\'e1s napj\'e1n. Milyen nyomor\'fas\'e1gos segedelem az, amely nekik adatott!
\par 
\par 100. Ez a telep\'fcl\'e9sek h\'edrei k\'f6z\'fcl val\'f3, amelyet elbesz\'e9l\'fcnk neked. Van k\'f6z\'fcl\'fck olyan, amelynek [romjai] \'e1llnak, \'e9s olyanok, amelyek learattattak (elt\'fbntek).
\par 101. \'c9s nem k\'f6vett\'fcnk el vel\'fck szemben igazs\'e1gtalans\'e1got, hanem \'f5k k\'f6vettek el igazs\'e1gtalans\'e1got magukkal. \'c9s nem v\'e1ltak hasznukra az \'f5 isteneik, amelyekhez Allah helyett foh\'e1szkodtak, miut\'e1n el\'e9
rkezett Urad parancsa. \'c9s nem gyarap\'edtott\'e1k \'f5ket m\'e1sban, csak vesztes\'e9gben.
\par 102. \'c9s ilyen Urad megragad\'e1sa, amikor megragadja a telep\'fcl\'e9seket, amelyek igazs\'e1gtalanok. Bizony a megragad\'e1sa f\'e1jdalmas, kem\'e9ny.
\par 
\par 103. Bizony, ebben jel van annak, aki f\'e9li a T\'falvil\'e1g gy\'f6trelm\'e9t. Ez egy olyan nap lesz, amelyre \'f6sszegy\'fbjtetnek az emberek, \'e9s olyan nap lesz, amelynek tan\'faja lesz [minden teremtm\'e9ny].
\par 104. \'c9s nem fogjuk k\'e9sleltetni, csak egy kisz\'e1m\'edtott (pontosan meghat\'e1rozott) ideig.
\par 105. Azon a napon, amikor elj\'f6n, egy ember sem besz\'e9lhet, csak az \'d5 engedelm\'e9vel. Lesz k\'f6z\'f6tt\'fck boldogtalan \'e9s boldog.
\par 106. \'c9s ami azokat illeti, akik boldogtalanok, azok a [Pokol-]t\'fbzben lesznek, [sz\'f6rny\'fb hangon] fognak s\'f3hajtani \'e9s leveg\'f5t venni.
\par 107. \'d6r\'f6kk\'e9 abban fognak maradni, addig, am\'edg az egek \'e9s a f\'f6ld megmaradnak, kiv\'e9ve azokat, akiket az Urad akar. Bizony, a te Urad azt tesz, amit akar.
\par 108. \'c9s ami pedig azokat illeti, akik boldogg\'e1 t\'e9tettek, a Paradicsomban lesznek, \'f6r\'f6kk\'e9 abban fognak maradni, addig am\'edg az egek \'e9s a f\'f6ld megmaradnak, kiv\'e9ve azokat, akiket Urad akar. Meg nem szakad\'f3 (folyamatos) aj\'e1
nd\'e9kk\'e9nt!
\par 
\par 109. Ne legyen h\'e1t k\'e9ts\'e9ged afel\'f5l, hogy mit szolg\'e1lnak ezek [a b\'e1lv\'e1nyim\'e1d\'f3k]. Nem szolg\'e1lnak egyebet, csak azt, amit ap\'e1ik szolg\'e1ltak kor\'e1bban. Bizony mi teljess\'e9 tessz\'fck r\'e9szesed\'e9s\'fcket [a t\'falvil
\'e1gi b\'fcntet\'e9sb\'f5l] megr\'f6vid\'edt\'e9s n\'e9lk\'fcl.
\par 110. \'c9s bizony, odaadtuk M\'f3zesnek az \'cdr\'e1st (a T\'f3r\'e1t), majd \'f6sszek\'fcl\'f6nb\'f6ztek abban. \'c9s ha nem lett volna kor\'e1bban [a b\'fcntet\'e9s k\'e9sleltet\'e9s\'e9r\'f5l] egy sz\'f3 Uradt\'f3l, akkor bizony d\'f6nt\'e9
s hozatott volna k\'f6z\'f6tt\'fck. \'c9s bizony \'f5k elbizonytalan\'edt\'f3 k\'e9ts\'e9gben vannak azzal (a Kor\'e1nnal) kapcsolatban.
\par 111. \'c9s bizony, Urad mindegyik\'fcknek teljess\'e9 teszi [a fizets\'e9get] a cselekedeteik\'e9rt. Bizony, \'d5 j\'f3l ismeri azt, amit cselekszenek.
\par 
\par }{\insrsid3161635\charrsid6227369 112. J\'e1rj h\'e1t az Egyenes \'faton, mik\'e9ppen parancsot kapt\'e1l, \'e9s veled egy\'fctt az is, aki b\'fbnb\'e1natot tan\'fas\'edtott! \'c9s ne k\'f6vessetek el t\'falkap\'e1sokat! Bizony, \'d5 \'e1tl\'e1
tja azt, amit cselekszetek.
\par 113. \'c9s ne hajoljatok azok fel\'e9, akik igazs\'e1gtalans\'e1got k\'f6vetnek el, nehogy titeket is \'e9rintsen a [Pokol-]t\'fbz! Nincs nektek Allahon k\'edv\'fcl [m\'e1s] p\'e1rtfog\'f3tok, \'e9s nem seg\'edt rajtatok senki [m\'e1s].
\par 114. Tartsd h\'e1t meg az im\'e1dkoz\'e1st a nappal k\'e9t v\'e9g\'e9n, \'e9s az \'e9jszaka k\'f6zeli r\'e9sz\'e9ben! A j\'f3tettek bizony elt\'e1vol\'edtj\'e1k a rossz tetteket. Ez eml\'e9keztet\'e9s az eml\'e9kez\'f5knek.
\par 115. \'c9s legy\'e9l t\'fcrelmes! Bizony Allah nem hagyja k\'e1rba veszni a j\'f3tev\'f5k jutalm\'e1t.
\par 
\par 116. \'c9s mi\'e9rt nem voltak az el\'f5ttetek \'e9lt nemzed\'e9kek k\'f6z\'fcl [j\'f3zan \'e9sz \'e9s erk\'f6lcs] marad\'e9k\'e1val felruh\'e1zottak, akik megtiltott\'e1k volna a roml\'e1s terjeszt\'e9s\'e9t a f\'f6ld\'f6n - kiv\'e9
ve egy keveset, akiket megmentett\'fcnk k\'f6z\'fcl\'fck? \'c1m azok, akik igazs\'e1gtalanok voltak, hajszolt\'e1k a nekik juttatott t\'fal\'e1rad\'f3 j\'f3l\'e9tet \'e9s gonosztev\'f5k voltak.
\par 117. \'c9s az Urad nem olyan, hogy elpuszt\'edtja a telep\'fcl\'e9seket igazs\'e1gtalanul, mik\'f6zben azok lak\'f3i olyanok, akik javul\'e1st hoznak.
\par 
\par 118. Ha az Urad \'fagy akarta volna, akkor az embereket egyetlen k\'f6z\'f6ss\'e9gg\'e9 tette volna. \'c1m \'f5k nem sz\'fbnnek meg k\'fcl\'f6nb\'f6z\'f5k lenni,
\par 119. Kiv\'e9ve azokat, akiket el\'e9rt Urad kegyelme. Hiszen erre teremtette \'f5ket. \'c9s beteljesedett Urad szava: \'84Bizony megt\'f6lt\'f6m a Gyehenn\'e1t a dzsinnekkel \'e9s az emberekkel, egy\'fcttesen!\'94
\par 
\par 120. \'c9s az\'e9rt besz\'e9lj\'fck el neked mindezt a k\'fcld\'f6ttek h\'edreib\'f5l (t\'f6rt\'e9neteib\'f5l), hogy meger\'f5s\'edts\'fck \'e1ltaluk a sz\'edvedet. \'c9s elj\'f6tt hozz\'e1d ezekben az igazs\'e1g, \'e9s az intelem \'e9s az eml\'e9keztet
\'e9s a h\'edv\'f5knek.
\par 121. Mondd [\'f3 Mohamed] azoknak, akik nem hisznek: \'84Cselekedjetek helyzetetek (m\'f3dszeretek) szerint! Bizony, mi is cselekedni fogunk [a m\'f3dszer\'fcnk szerint].
\par 122. \'c9s v\'e1rakozzatok csak! Bizony, mi is v\'e1rakozunk!\'94
\par 123. \'c9s Allahot illetik meg az egek \'e9s a f\'f6ld rejtett dolgai. \'c9s minden \'fcgy Hozz\'e1 vitetik vissza. H\'e1t \'d5t szolg\'e1ld, \'e9s Re\'e1 hagyatkozz! \'c9s az Urad nem hagyja figyelmen k\'edv\'fcl azt, amit cselekszetek.}{\insrsid3161635 

\par }\pard\plain \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid3161635 
\par 
\par 
\par 
\par }\pard \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid3161635 {\b\insrsid16543947 {\*\bkmkstart h_60duu3585a7l}{\*\bkmkend h_60duu3585a7l}12. }{\b\insrsid3161635\charrsid13324019 J\'f3zsef (J
\'faszuf) c. sz\'fara
\par }\pard \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid11423618 
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid3161635\charrsid11423618 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev
\'e9ben.
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid3161635\charrsid11423618 
\par 1. Alif-l\'e1m-ra. Ezek a nyilv\'e1nval\'f3 \'cdr\'e1s jelei (id\'e9zetei).
\par 2. Mi bizony arab [nyelv\'fb] Kor\'e1nk\'e9nt bocs\'e1tottuk le, h\'e1tha }{\insrsid3161635\charrsid11034251 \'e9ltek az eszetekkel.
\par 3. Mi a legszebb t\'f6rt\'e9neteket besz\'e9lj\'fck el neked [\'f3 Mohamed] az\'e1ltal, hogy sugalltuk neked ezt a Kor\'e1nt, noha ez el\'f5tt azok k\'f6z\'e9 tartozt\'e1l, akik figyelmen k\'edv\'fcl hagyt\'e1k [e t\'f6rt\'e9neteket]!
\par 
\par 4. [Eml\'edtsd meg,] amikor J\'f3zsef azt mondta az apj\'e1nak: \'84\'d3 ap\'e1m! Bizony, l\'e1ttam [\'e1lmomban] tizenegy \'e9gitestet, \'e9s a Napot \'e9s a Holdat. L\'e1ttam azokat, amint leborulnak el\'f5ttem.\'94
\par 5. Azt mondta [J\'e1kob]: \'84\'d3 fiacsk\'e1m! Ne besz\'e9ld el a l\'e1tom\'e1sodat a testv\'e9reidnek, mert akkor fondorlattal sz\'f5nek [gonosz] tervet ellened! Bizony, a s\'e1t\'e1n az embernek nyilv\'e1nval\'f3 ellens\'e9ge.
\par 6. \'c9s ekk\'e9ppen v\'e1laszt ki t\'e9ged az Urad, \'e9s tan\'edtja meg neked az elbesz\'e9l\'e9sek (az elmondott \'e1lmok) \'e9rtelmez\'e9s\'e9t, \'e9s teljes\'edti ki a j\'f3t\'e9tem\'e9ny\'e9t ir\'e1ntad \'e9s J\'e1kob h\'e1zan\'e9pe ir\'e1nt, mik
\'e9ppen kiteljes\'edtette kor\'e1bban aty\'e1id, \'c1brah\'e1m \'e9s Izs\'e1k ir\'e1nt. Bizony, a te Urad Mindentud\'f3, B\'f6lcs.
\par 
\par 7. Bizony, J\'f3zsef \'e9s a testv\'e9rei [t\'f6rt\'e9net\'e9ben] jelek vannak a [r\'f3luk] k\'e9rdez\'f5k sz\'e1m\'e1ra.
\par 8. Amikor azt mondt\'e1k [J\'f3zsef testv\'e9rei]: \'84Bizony, J\'f3zsef \'e9s az \'f6ccse (Benj\'e1min) kedvesebbek ap\'e1nk sz\'e1m\'e1ra, mint mi, holott mi er\'f5s csoport vagyunk. Bizony, ap\'e1nk nyilv\'e1nval\'f3 t\'e9velyg\'e9sben van!
\par 9. \'d6lj\'e9tek meg J\'f3zsefet, vagy vess\'e9tek egy [ismeretlen] f\'f6ldre, hogy ap\'e1tok arca (szeretete, t\'f6r\'f5d\'e9se) egyed\'fcl fel\'e9tek forduljon, \'e9s [a t\'f5le val\'f3 megszabadul\'e1s] ut\'e1n j\'f3 n\'e9pp\'e9 v\'e1lhattok [mivel b
\'fbnb\'e1natot tartotok]!\'94
\par 10. Egyik\'f5j\'fck azt mondta: \'84Ne \'f6lj\'e9tek meg J\'f3zsefet, hanem dobj\'e1tok a k\'fat m\'e9ly\'e9re, hadd vegye fel valamely karav\'e1n, ha mindenk\'e9ppen akartok tenni [valamit ellene]!\'94
\par 
\par 11. Azt mondt\'e1k: \'84\'d3 ap\'e1nk! Mi lelt t\'e9ged, hogy nem b\'edzod r\'e1nk J\'f3zsefet? \'c9s bizony, mi j\'f3akar\'f3i vagyunk.
\par 12. K\'fcldd el \'f5t vel\'fcnk holnap, hadd egyen \'e9s j\'e1tssz\'e9k [kedv\'e9re]! \'c9s bizony, mi \'f5rz\'f5i lesz\'fcnk neki!\'94
\par 13. Azt mondta [J\'e1kob]: \'84Bizony, elszomor\'edt engem, hogy elviszitek \'f5t [magatokkal], \'e9s att\'f3l f\'e9lek, hogy felfalja a farkas, mik\'f6zben nem figyeltek r\'e1.\'94
\par 14. Azt mondt\'e1k: \'84Ha a farkas felfaln\'e1 \'f5t, holott mi \'f6sszetart\'f3 csoport vagyunk, akkor bizony vesztesek lenn\'e9nk!\'94
\par 15. \'cdgy, amikor magukkal vitt\'e9k, \'e9s megegyeztek abban, hogy a k\'fat m\'e9ly\'e9be helyezik \'f5t [\'e9s miut\'e1n v\'e9grehajtott\'e1k aljas terv\'fcket], azt sugalltuk neki (J\'f3zsefnek): \'84Bizony, h\'edr\'fcl fogod adni nekik ezen \'fcgy
\'fcket, mik\'f6zben \'f5k \'e9szre sem veszik (nem ismernek fel t\'e9ged).\'94
\par 
\par 16. \'c9s s\'edrva j\'f6ttek el apjukhoz kora este.
\par 17. Azt mondt\'e1k: \'84\'d3 ap\'e1nk! Bizony, mi elment\'fcnk versenyt futni, \'e9s ott hagytuk J\'f3zsefet a holmijainkn\'e1l, \'e9s akkor felfalta \'f5t a farkas. \'c1m te nem hiszel nek\'fcnk, m\'e9g ha igazmond\'f3k is vagyunk.\'94
\par 18. \'c9s elhozt\'e1k az ing\'e9t, rajta hamis v\'e9rrel. Azt mondta [J\'e1kob]: \'84Dehogyis! Saj\'e1t magatok csalt l\'e9pre titeket egy [gonosz] dologgal! H\'e1t sz\'e9p t\'fcrelmet [fogok tan\'fas\'edtani], \'e9s Allah a seg\'edts\'e9g\'fcl k\'e9rt [t
\'e1maszom] az ellen, ami [t\'f6rt\'e9netet] le\'edrtok.\'94
\par 
\par 19. \'c9s j\'f6ttek karav\'e1nnal utaz\'f3k, \'e9s el\'f5re k\'fcldt\'e9k a v\'edzhord\'f3jukat, \'e9s leengedte a v\'f6dr\'e9t, [\'e9s] azt mondta: \'84Mily \'f6r\'f6mh\'edr! Ez egy ifj\'fa!\'94 Ezut\'e1n elrejtett\'e9k \'f5t, mint valami \'e1rut. \'c9
s Allahnak tudom\'e1sa van arr\'f3l, amit cselekszenek.
\par 20. \'c9s potom \'e1ron adt\'e1k el, n\'e9h\'e1ny ez\'fcstp\'e9nz\'e9rt, \'e9s olyanok voltak, akik nem akart\'e1k megtartani.
\par 21. \'c9s aki megv\'e1s\'e1rolta \'f5t Egyiptomb\'f3l, azt mondta a feles\'e9g\'e9nek: \'84Gondoskodj tisztes otthonr\'f3l sz\'e1m\'e1ra! Lehet, hogy m\'e9g hasznunkra v\'e1lik, vagy gyermek\'fcnkk\'e9 fogadjuk!\'94 \'c9s ekk\'e9ppen adtunk hatalmat J\'f3
zsefnek a f\'f6ld\'f6n (Egyiptomban), hogy megtan\'edtsuk neki az elbesz\'e9l\'e9sek (az elmondott \'e1lmok) \'e9rtelmez\'e9s\'e9t. \'c9s Allahnak teljhatalma van az \'d5 \'fcgy\'e9ben, \'e1m a legt\'f6bb ember nem rendelkezik tud\'e1ssal.
\par 22. \'c9s miut\'e1n el\'e9rte az \'e9rett kort, b\'f6lcsess\'e9get \'e9s tud\'e1st adtunk neki. \'c9s Mi ekk\'e9ppen adjuk meg a fizets\'e9g\'e9t a j\'f3tev\'f5knek.
\par 
\par 23. \'c9s az asszony, akinek a h\'e1z\'e1ban volt, megpr\'f3b\'e1lta \'f5t r\'e1venni [a b\'fbnre], \'e9s bez\'e1rta az ajt\'f3kat \'e9s azt mondta: \'84Gyere ide!\'94 Azt mondta [J\'f3zsef]: \'84Allah mentsen [ett\'f5l]! Bizony, \'f5 (a f\'e9
rjed) az uram, \'f5 sz\'e9p otthont adott nekem. Bizony, az igazs\'e1gtalanok nem boldogulnak.\'94
\par 24. \'c9s bizony, az asszony akarta \'f5t, \'e9s [J\'f3zsef] is akarta volna \'f5t, ha nem l\'e1tta volna az Ura bizony\'edt\'e9k\'e1t. Ekk\'e9ppen [t\'f6rt\'e9nt], hogy elford\'edtsuk t\'f5le a rosszat \'e9s a f\'f6rtelmess\'e9get. Bizony, \'f5 a Mi kiv
\'e1lasztott szolg\'e1ink k\'f6z\'fcl val\'f3.
\par 25. \'c9s egym\'e1st megel\'f5zni igyekezv\'e9n futottak az ajt\'f3hoz, \'e9s az asszony sz\'e9tszak\'edtotta az ing\'e9t h\'e1tulr\'f3l, az ajt\'f3n\'e1l pedig ott tal\'e1lt\'e1k az asszony ur\'e1t. Az asszony azt mondta: \'84Mi [m\'e1s] a fizets\'e9
ge annak, aki rosszat akart tenni a h\'e1zn\'e9peddel, minthogy beb\'f6rt\'f6n\'f6zz\'e9k vagy f\'e1jdalmas gy\'f6trelemmel [s\'fajtass\'e9k]!\'94
\par 26. Azt mondta [J\'f3zsef]: \'84\'d5 akart engem r\'e1venni [a b\'fbnre].\'94 \'c9s az asszony csal\'e1dj\'e1b\'f3l egy tan\'fa azt tan\'fas\'edtotta: \'84Ha az inge el\'f6lr\'f5l lett sz\'e9tszak\'edtva, akkor az asszony mond igazat, \'e9s \'f5
 a hazugok k\'f6z\'e9 tartozik.
\par 27. \'c1m ha az inge h\'e1tulr\'f3l lett sz\'e9tszak\'edtva, akkor az asszony hazudik, \'e9s \'f5 az igazmond\'f3k k\'f6z\'e9 tartozik.\'94
\par 28. \'c9s amikor [a f\'e9rje] l\'e1tta, hogy az inge h\'e1tulr\'f3l van sz\'e9tszak\'edtva, azt mondta: \'84Ez a ti n\'f5i fondorlataitok k\'f6z\'fcl val\'f3. Bizony a ti fondorlatotok hatalmas.
\par 29. J\'f3zsef! Fordulj el ett\'f5l! Te pedig [asszony], k\'e9rj megbocs\'e1t\'e1st a b\'fbn\'f6d\'e9rt! Bizony te a v\'e9tkesek k\'f6z\'e9 tartozol!\'94}{\insrsid3161635 
\par 
\par }{\insrsid3161635\charrsid11034251 30. \'c9s a n\'f5k azt mondt\'e1k a v\'e1rosban: \'84A m\'e9lt\'f3s\'e1gteljesnek a feles\'e9ge megpr\'f3b\'e1lja r\'e1venni [a b\'fbnre] a leg\'e9ny\'e9t (szolg\'e1j\'e1t)! [Ez a szolga] bizony heves szerelemre gy\'fa
jtotta \'f5t. Bizony, mi azt l\'e1tjuk, hogy \'f5 nyilv\'e1nval\'f3 t\'e9velyg\'e9sben van.\'94
\par 31. Majd amikor az asszony hallom\'e1st szerzett a cselsz\'f6v\'e9s\'fckr\'f5l (pletyk\'e1lkod\'e1sr\'f3l), elk\'fcld\'f6tt \'e9rt\'fck \'e9s \'fcl\'f5helyet k\'e9sz\'edtett el\'f5 nekik [a lakom\'e1hoz], \'e9s mindegyik\'fcknek egy k\'e9st adott, \'e9
s azt mondta [J\'f3zsefnek]: \'84Gyere ki el\'e9j\'fck!\'94 Amikor pedig megl\'e1tt\'e1k, magasztalt\'e1k \'f5t \'e9s megv\'e1gt\'e1k a kez\'fcket. \'c9s azt mondt\'e1k: \'84Allah \'f5rizzen, ez nem is ember! Nem m\'e1s ez, mint egy nemes angyal!\'94

\par 32. Azt mondta [az asszony]: \'84\'cdme, h\'e1t ez az, aki miatt szemreh\'e1ny\'e1st tettetek nekem! \'c9s megpr\'f3b\'e1ltam r\'e1venni [a b\'fbnre], \'e1m \'f5 ellen\'e1llt. \'c9s bizony, ha nem fogja megtenni azt, amit parancsolok neki, akkor beb\'f6rt
\'f6n\'f6ztetik \'e9s a megvetettek k\'f6z\'e9 fog tartozni!\'94
\par 
\par 33. Azt mondta [J\'f3zsef]: \'84Uram! A b\'f6rt\'f6n jobb nekem, mint az, amire h\'edvnak engem! \'c9s ha nem ford\'edtod el a fondorlatukat t\'f5lem, akkor fel\'e9j\'fck fogok hajolni [engedelmeskedve], \'e9s a tudatlanok k\'f6z\'e9 fogok tartozni!\'94

\par 34. \'c9s meghallgatta \'f5t az Ura, \'e9s elford\'edtotta t\'f5le a fondorlatukat. Bizony, \'d5 a mindent Hall\'f3, a Mindentud\'f3.
\par 35. Majd miut\'e1n l\'e1tt\'e1k a jeleket (a bizony\'edt\'e9kokat J\'f3zsef \'e1rtatlans\'e1g\'e1ra), j\'f3nak tetszett sz\'e1mukra, hogy beb\'f6rt\'f6n\'f6zz\'e9k egy id\'f5re.
\par 
\par 36. \'c9s vele egy\'fctt k\'e9t leg\'e9ny is b\'f6rt\'f6nbe ker\'fclt. Az egyik\'fck azt mondta: \'84Bizony, \'e9n l\'e1ttam magam [\'e1lmomban], amint szeszes italt pr\'e9selek.\'94 \'c9s azt mondta a m\'e1sik: \'84Bizony, \'e9n l\'e1ttam magam [\'e1
lmomban], amint kenyeret viszek a fejemen, amib\'f5l a madarak esznek. Add h\'edr\'fcl nek\'fcnk ennek az \'e9rtelmez\'e9s\'e9t! Bizony, mi }{\insrsid3161635\charrsid13324019 l\'e1tjuk, hogy te a j\'f3tev\'f5k k\'f6z\'e9 tartozol.\'94
\par 37. Azt mondta [J\'f3zsef]: \'84Nem j\'f6n el hozz\'e1tok egyetlen olyan \'e9lelem sem, amit ell\'e1t\'e1sk\'e9nt kaptok, an\'e9lk\'fcl, hogy [azel\'f5tt] ne adn\'e1m h\'edr\'fcl nektek annak \'e9rtelmez\'e9s\'e9t, miel\'f5tt elj\'f6nne hozz\'e1
tok. Ez, ami mindkett\'f5t\'f6knek [el lesz mondva] annak r\'e9sze, amit az Uram tan\'edtott nekem. Bizony, \'e9n elhagytam annak a n\'e9pnek a vall\'e1s\'e1t, akik nem hisznek Allahban \'e9s hitetlenek a t\'falvil\'e1ggal szemben.
\par 38. \'c9s k\'f6vetem aty\'e1im \'c1brah\'e1m, Izs\'e1k \'e9s J\'e1kob vall\'e1s\'e1t. Mi nem \'e1ll\'edthatunk semmit se t\'e1rsistenk\'e9nt Allah mell\'e9. Ez Allahnak ir\'e1ntunk \'e9s az emberek ir\'e1nt val\'f3 kegy\'e9b\'f5l adatott. \'c1m a legt\'f6
bb ember nem h\'e1l\'e1s.
\par 39. \'d3 k\'e9t b\'f6rt\'f6nt\'e1rs! Vajon a k\'fcl\'f6nb\'f6z\'f5 urak (istenek) jobbak, avagy Allah, az Egy, a Legy\'f5zhetetlen?
\par 40. Nem szolg\'e1ltok Rajta k\'edv\'fcl m\'e1st, csup\'e1n neveket - amelyeket ti \'e9s az aty\'e1itok adtatok - amelyekkel kapcsolatban Allah nem bocs\'e1tott le semmilyen bizony\'edt\'f3 \'e9rvet. Bizony, az \'edt\'e9lkez\'e9s csup\'e1
n Allahot illeti, azt parancsolta, hogy ne szolg\'e1ljatok m\'e1st, csak \'d5t. Ez az egyenesen (szil\'e1rd alapokon) \'e1ll\'f3 vall\'e1s! \'c1m a legt\'f6bb ember nem rendelkezik tud\'e1ssal.
\par 41. \'d3 k\'e9t b\'f6rt\'f6nt\'e1rs! Ami az egyik\'f5t\'f6ket illeti, \'f5 szeszes itallal fogja itatni az ur\'e1t, a m\'e1sik pedig fel lesz fesz\'edtve \'e9s enni fognak a madarak a fej\'e9b\'f5l. Eld\'f6ntetett m\'e1r az \'fc
gy, amivel kapcsolatban felvil\'e1gos\'edt\'e1st k\'e9rtetek.\'94
\par 42. \'c9s azt mondta annak, akir\'f5l \'fagy v\'e9lte, hogy meg fog menek\'fclni kettej\'fck k\'f6z\'fcl: \'84Eml\'edts meg engem az uradn\'e1l!\'94 \'c1m a s\'e1t\'e1n elfeledtette vele, hogy eml\'edt\'e9st tegyen [J\'f3zsefr\'f5l] az ur\'e1n\'e1l, \'e9
s \'edgy m\'e9g n\'e9h\'e1ny \'e9vig a b\'f6rt\'f6nben id\'f5z\'f6tt.
\par 
\par 43. \'c9s azt mondta az [egyiptomi] kir\'e1ly: \'84Bizony, l\'e1ttam [\'e1lmomban] h\'e9t k\'f6v\'e9r tehenet, amiket h\'e9t sov\'e1ny falt fel, \'e9s l\'e1ttam h\'e9t z\'f6ld kal\'e1szt \'e9s m\'e1sik [h\'e9t] sz\'e1razat. \'d3 ti, el\'f5kel\'f5k! Vil
\'e1gos\'edtsatok fel a l\'e1tom\'e1somr\'f3l, ha val\'f3ban [tudtok] l\'e1tom\'e1sokat fejteni!\'94
\par 44. Azt mondt\'e1k: \'84Zavaros \'e1lmok [ezek]! \'c9s nincs tud\'e1sunk [ezen] \'e1lmok \'e9rtelmez\'e9s\'e9r\'f5l.\'94
\par 45. \'c9s azt mondta az, aki megmenek\'fclt a kettej\'fck k\'f6z\'fcl \endash  amikor egy id\'f5 ut\'e1n esz\'e9be jutott [J\'f3zsef]: \'84\'c9n h\'edr\'fcl adom nektek az \'e9rtelmez\'e9s\'e9t! K\'fcldjetek h\'e1t el engem!\'94
\par 46. [Amikor elment a b\'f6rt\'f6nbe J\'f3zsefhez, \'edgy sz\'f3lt hozz\'e1:] \'84J\'f3zsef, te igaz ember! Vil\'e1gos\'edts fel minket h\'e9t k\'f6v\'e9r teh\'e9nr\'f5l, amiket h\'e9t sov\'e1ny falt fel, \'e9s h\'e9t z\'f6ld kal\'e1szr\'f3l \'e9s [h\'e9
t] m\'e1sikr\'f3l, [amelyek] sz\'e1razak! H\'e1tha visszat\'e9rek az emberekhez [\'fagy], hogy tal\'e1n megtudj\'e1k [az \'e9rtelm\'e9t].\'94
\par 47. [Azt mondta J\'f3zsef:] \'84H\'e9t \'e9vig vetni fogtok sz\'fcnet n\'e9lk\'fcl (a szok\'e1sos m\'f3don), \'e9s amit learattok, hagyj\'e1tok meg a kal\'e1sz\'e1ban, kiv\'e9ve egy keveset, amib\'f5l esztek!
\par 48. Majd, ezut\'e1n h\'e9t neh\'e9z }{\insrsid3161635 [}{\insrsid3161635\charrsid13324019 \'e9v}{\insrsid3161635 ]}{\insrsid3161635\charrsid13324019  j\'f6n, amelyek felfalj\'e1k azt [a term\'e9st], amit ezen [\'e9vek] sz\'e1m\'e1ra k\'fcldtetek el\'f5
re (tettetek el), kiv\'e9ve egy keveset, amit elrakt\'e1roztok (vet\'e9sre).
\par 49. Majd, ezut\'e1n j\'f6n egy esztend\'f5, amelyben az emberek [es\'f5t] kapnak seg\'edts\'e9g\'fcl, \'e9s amelyben pr\'e9selni fognak.\'94
\par 
\par 50. \'c9s azt mondta az [egyiptomi] kir\'e1ly: \'84Hozz\'e1tok \'f5t el\'e9m!\'94 S miut\'e1n a k\'fcld\'f6tt elment hozz\'e1, [J\'f3zsef] azt mondta: \'84T\'e9rj vissza uradhoz \'e9s k\'e9rdezd meg \'f5t, mi a helyzet azokkal az asszonyokkal, akik elv
\'e1gt\'e1k a kez\'fcket! Bizony, az Uramnak tudom\'e1sa van a fondorlatukr\'f3l.\'94
\par 51. Azt mondta [a kir\'e1ly]: \'84Milyen s\'falyos \'fcgy miatt pr\'f3b\'e1lt\'e1tok r\'e1venni J\'f3zsefet [a b\'fbnre]?\'94 Azt mondt\'e1k: \'84Allah \'f5rizzen! Mi semmi rosszat nem tudunk r\'f3la.\'94 A m\'e9lt\'f3s\'e1gteljesnek a feles\'e9
ge azt mondta: \'84Most f\'e9ny der\'fcl az igazs\'e1gra! \'c9n pr\'f3b\'e1ltam r\'e1venni \'f5t [a b\'fbnre], \'e9s \'f5 bizony az igazmond\'f3k k\'f6z\'fcl val\'f3!
\par 52. Ezt az\'e9rt [mondtam \'e9s ismertem el], hogy [a m\'e9lt\'f3s\'e1gteljes] megtudja, hogy \'e9n nem \'e1rultam el \'f5t a t\'e1voll\'e9t\'e9ben. Bizony, Allah nem vezeti [c\'e9lra] az \'e1rul\'f3k fondorlat\'e1t.
\par 53. \'c9s \'e9n nem \'e1ll\'edtom \'e1rtatlannak magamat [a b\'fbnt\'f5l]. Bizony, az emberi l\'e9lek folyton rosszra utas\'edt, kiv\'e9ve, akin az Uram megk\'f6ny\'f6r\'fclt. Bizony, az Uram Megbocs\'e1t\'f3, Irgalmas.\'94
\par 54. \'c9s azt mondta az [egyiptomi] kir\'e1ly: \'84Hozz\'e1tok \'f5t el\'e9m, hogy kiv\'e1laszthassam \'f5t magamnak!\'94 \'c9s miut\'e1n besz\'e9lt vele, azt mondta neki: \'84Bizony, m\'e1t\'f3l [kezdve] te hatalmat \'e9s bizalmat \'e9lvezel n\'e1lunk.
\'94
\par 55. Azt mondta [J\'f3zsef]: \'84Tegy\'e9l engem a f\'f6ld t\'e1rh\'e1zainak [\'e9l\'e9re]! Bizony, \'e9n tud\'e1ssal b\'edr\'f3, \'f5rz\'f5 vagyok.\'94
\par 56. \'c9s \'edgy adtunk J\'f3zsefnek hatalmat a f\'f6ld\'f6n, ott jel\'f6lhet ki lak\'f3helyet mag\'e1nak, ahol csak akar. Azt r\'e9szes\'edtj\'fck a k\'f6ny\'f6r\'fclet\'fcnkben, akit akarunk, mi nem hagyjuk k\'e1rba veszni a j\'f3tev\'f5k jutalm\'e1t.

\par 57. \'c1m a t\'falvil\'e1gi jutalom jobb azoknak, akik hittek \'e9s istenf\'e9lelmet tan\'fas\'edtottak.}{\insrsid3161635 
\par 
\par }{\insrsid3161635\charrsid13324019 58. \'c9s elj\'f6ttek J\'f3zsef testv\'e9rei, s bementek hozz\'e1, \'e9s \'f5 felismerte \'f5ket, \'e1m azok nem ismert\'e9k fel.
\par 59. \'c9s miut\'e1n felszerelte \'f5ket a nekik j\'e1r\'f3 felszerel\'e9ssel, azt mondta: \'84Hozz\'e1tok el\'e9m testv\'e9reteket, aki az ap\'e1tokt\'f3l val\'f3! H\'e1t nem l\'e1tj\'e1tok, hogy teljess\'e9 teszem a kim\'e9r\'e9st, \'e9s \'e9
n vagyok a legjobb a sz\'e1ll\'e1sad\'f3k k\'f6z\'f6tt.
\par 60. \'c1m ha nem hozz\'e1tok \'f5t el\'e9m, akkor nem lesz sz\'e1motokra kim\'e9r\'e9s n\'e1lam, \'e9s ne is gyertek k\'f6zel!\'94
\par 61. Azt mondt\'e1k: \'84Mi megpr\'f3b\'e1ljuk r\'e1venni ap\'e1nkat erre. \'c9s bizony, mi megtessz\'fck [ezt].\'94
\par 62. \'c9s azt mondta [J\'f3zsef] az ifj\'fa szolg\'e1inak: \'84Tegy\'e9tek [csere-] \'e1rujukat a m\'e1lh\'e1jukba, h\'e1tha felismerik, amikor elindulnak a csal\'e1djukhoz, h\'e1tha visszat\'e9rnek.\'94
\par 
\par 63. Amikor visszat\'e9rtek apjukhoz, azt mondt\'e1k: \'84\'d3 ap\'e1nk! Megtagadtatott t\'f5l\'fcnk a kim\'e9r\'e9s! K\'fcldd h\'e1t el vel\'fcnk a testv\'e9r\'fcnket (Benj\'e1mint), hogy kim\'e9rjenek nek\'fcnk! \'c9s bizony, mi \'f5rz\'f5i lesz\'fcnk.
\'94
\par 64. Azt mondta [J\'e1kob]: \'84Vajon r\'e1tok b\'edzhatom-e \'f5t \'fagy, ahogyan r\'e1tok b\'edztam a testv\'e9r\'e9t kor\'e1bban? Allah a legjobb \'d5rz\'f5! \'d5 a Legk\'f6ny\'f6r\'fcletesebb a k\'f6ny\'f6r\'fcletesek k\'f6z\'f6tt.\'94
\par 65. \'c9s amikor kinyitott\'e1k a holmijukat, \'e9s megtal\'e1lt\'e1k a [csere-] \'e1rujukat, amely visszaadatott nekik, azt mondt\'e1k: \'84\'d3 ap\'e1nk! Mi m\'e1st k\'edv\'e1nhatn\'e1nk m\'e9g? Itt van a [csere-] \'e1runk, visszaadatott nek\'fcnk, ell
\'e1tjuk bel\'f5le a csal\'e1dunkat, \'f5rizz\'fck a testv\'e9r\'fcnket, \'e9s [az \'f5 r\'e9v\'e9n] egy teverakom\'e1ny m\'e9rt\'e9k\'e9vel gyarapodunk. K\'f6nny\'fb kim\'e9r\'e9s ez!\'94
\par 66. Azt mondta [J\'e1kob]: \'84Nem fogom elk\'fcldeni \'f5t veletek, m\'edg fogadalmat nem tesztek nekem Allahra [esk\'fcdve], hogy visszahozz\'e1tok \'f5t nekem - kiv\'e9ve, hacsak k\'f6r\'fcl nem vesznek titeket [az ellens\'e9gek].\'94 Miut\'e1n megtett
\'e9k neki a fogadalmukat, azt mondta: \'84\'c9s Allah a fel\'fcgyel\'f5je annak, amit mondunk!\'94
\par 
\par 67. \'c9s azt mondta [J\'e1kob]: \'84\'d3 fiaim! Ne l\'e9pjetek be egyetlen kapun, hanem k\'fcl\'f6nb\'f6z\'f5 kapukon l\'e9pjetek be! \'c9s semmiben sem lehetek hasznotokra Allah [elrendel\'e9se] ellen. Az \'edt\'e9lkez\'e9s csup\'e1n Allahot illeti. 
\'d5r\'e1 hagyatkozom. \'c9s \'d5r\'e1 hagyatkozzanak a hagyatkoz\'f3k!\'94
\par 68. \'c9s amikor bel\'e9ptek \'fagy, ahogy apjuk parancsolta nekik, az semmiben sem volt hasznukra Allah [elrendel\'e9se] ellen. Csup\'e1n J\'e1kob lelk\'e9ben [\'e9rzett] sz\'fcks\'e9g volt az, amelynek eleget tett. \'c9s bizony \'f5 tud\'e1ssal b\'ed
r, amire mi tan\'edtottuk \'f5t. \'c1m a legt\'f6bb ember nem rendelkezik tud\'e1ssal.
\par 
\par 69. \'c9s miut\'e1n bementek J\'f3zsefhez, mag\'e1hoz vette a testv\'e9r\'e9t. Azt mondta [J\'f3zsef]: \'84Bizony \'e9n a testv\'e9red vagyok, ne b\'e1nk\'f3dj h\'e1t amiatt, amit \'f5k cselekedtek!\'94
\par 70. \'c9s miut\'e1n felszerelte \'f5ket a nekik j\'e1r\'f3 felszerel\'e9ssel, beletette az iv\'f3serleget a testv\'e9re m\'e1lh\'e1j\'e1ba. Majd egy hirdet\'f5 hangos sz\'f3val hirdette: \'84Ti, a karav\'e1n [utasai]! Bizony ti tolvajok vagytok!\'94

\par 71. [J\'f3zsef testv\'e9rei] fel\'e9j\'fck fordulva azt mondt\'e1k: \'84Mit hi\'e1nyoltok?\'94
\par 72. Azt mondt\'e1k: \'84Mi a kir\'e1ly m\'e9r\'f5serleg\'e9t hi\'e1nyoljuk. \'c9s annak, aki visszahozza azt, egy teverakom\'e1ny j\'e1r, \'e9s \'e9n vagyok a kezes \'e9rte.\'94
\par 73. Azt mondt\'e1k [J\'f3zsef testv\'e9rei]: \'84Allahra! Ti tudj\'e1tok, hogy nem az\'e9rt j\'f6tt\'fcnk, hogy roml\'e1st okozzunk a f\'f6ld\'f6n, \'e9s hogy nem vagyunk tolvajok.\'94
\par 74. Azt mondt\'e1k: \'84Mi legyen h\'e1t annak [a tolvajnak] a fizets\'e9ge, ha [kider\'fcl, hogy] hazugok vagytok?\'94
\par 75. Azt mondt\'e1k [J\'f3zsef testv\'e9rei]: \'84A fizets\'e9ge annak, akinek a m\'e1lh\'e1j\'e1ban tal\'e1ltatik, hogy \'f5 maga lesz a fizets\'e9g. Mi \'edgy fizetj\'fck meg az igazs\'e1gtalanokat.\'94
\par 76. A [b\'e1tyjai] zs\'e1kjaival kezdte a testv\'e9re zs\'e1kja el\'f5tt, majd el\'f5vette a testv\'e9re zs\'e1kj\'e1b\'f3l. Mi \'edgy mutattunk fondorlatot J\'f3zsefnek. A kir\'e1ly vall\'e1sa (t\'f6rv\'e9nye) szerint nem vehette volna mag\'e1hoz testv
\'e9r\'e9t - kiv\'e9ve, ha Allah \'fagy akarja. Mi fokozatokkal magasabbra emelj\'fck azokat, akiket akarunk, \'e9s minden tud\'e1ssal b\'edr\'f3 felett van, aki m\'e9g t\'f6bbet tud.
\par 
\par 77. Azt mondt\'e1k [J\'f3zsef testv\'e9rei]: \'84Ha lop, h\'e1t egy testv\'e9re m\'e1r lopott kor\'e1bban.\'94 Ezt J\'f3zsef titokban tartotta mag\'e1ban, \'e9s nem fedte fel nekik. Azt mondta [mag\'e1ban]: \'84Ti rosszabb helyzetben vagytok, \'e9
s Allah jobban tudja azt, amit }{\insrsid3161635\charrsid5078441 le\'edrtok.\'94
\par 78. Azt mondt\'e1k: \'84\'d3 te m\'e9lt\'f3s\'e1gteljes! Bizony, van neki egy apja, aki hajlott kor\'fa aggasty\'e1n. Vidd h\'e1t el egyik\'fcnket helyette! Bizony, mi l\'e1tjuk, hogy te a j\'f3tev\'f5k k\'f6z\'e9 tartozol.\'94
\par 79. Azt mondta [J\'f3zsef]: \'84Allah mentsen minket att\'f3l, hogy m\'e1st vigy\'fcnk el, mint akin\'e9l megtal\'e1ltuk a holminkat, k\'fcl\'f6nben bizony mi igazs\'e1gtalanok lenn\'e9nk.\'94
\par 
\par 80. \'c9s miut\'e1n rem\'e9ny\'fcket vesztett\'e9k vele kapcsolatban, bizalmas tan\'e1cskoz\'e1sra vonultak f\'e9lre. A legid\'f5sebb k\'f6z\'f6tt\'fck azt mondta: \'84Vajon nem tudj\'e1tok azt, hogy ap\'e1tok fogadalmat vett t\'f5
letek Allahra [esketve titeket]? \'c9s [ti tudj\'e1tok] azt, amit kor\'e1bban elmulasztottatok J\'f3zseffel kapcsolatban. H\'e1t \'e9n addig nem hagyom el a f\'f6ldet (Egyiptomot), am\'edg ap\'e1m nem ad enged\'e9lyt nekem, vagy Allah nem \'edt\'e9
lkezik a javamra, \'e9s \'d5 a legjobb az \'edt\'e9lkez\'f5k k\'f6z\'f6tt.
\par 
\par 81. T\'e9rjetek vissza ap\'e1tokhoz \'e9s mondj\'e1tok: \'84Ap\'e1nk, bizony a fiad lopott! Mi csak arr\'f3l tehet\'fcnk tan\'fas\'e1got, amir\'f5l tudunk, \'e9s mi nem vagyunk a rejtett dolgok \'f5rz\'f5i (tud\'f3i).\'94
\par 82. [\'c9s mondj\'e1tok neki:] \'84K\'e9rdezd meg a telep\'fcl\'e9s [lak\'f3it], ahol voltunk \'e9s a karav\'e1nt, amellyel \'e9rkezt\'fcnk! \'c9s bizony mi igazmond\'f3k vagyunk.\'94
\par 83. Azt mondta [J\'e1kob]: \'84Dehogyis! Saj\'e1t magatok csalt l\'e9pre titeket egy [gonosz] dologgal! \'c1m sz\'e9p t\'fcrelem [amelyet tan\'fas\'edtok], Allah tal\'e1n elhozza nekem mindny\'e1jukat. Bizony, \'d5 a Mindentud\'f3, az \'cdt\'e9lkez\'f5.
\'94
\par 84. \'c9s h\'e1tat ford\'edtott nekik \'e9s azt mondta: \'84Mily nagy b\'e1nat t\'f6lt el engem J\'f3zsef miatt!\'94 Majd pedig elvesztette a szeme vil\'e1g\'e1t a szomor\'fas\'e1gt\'f3l, pedig \'f5 leplezte nagy b\'e1nat\'e1t.
\par 85. Azt mondt\'e1k: \'84Allahra! Nem hagysz fel a J\'f3zsefr\'f5l val\'f3 eml\'e9kez\'e9ssel, m\'edg k\'f6zel nem leszel a hal\'e1lhoz, vagy azok k\'f6z\'e9 nem ker\'fclsz, akik elpusztulnak!\'94
\par 86. Azt mondta: \'84A b\'e1natomat \'e9s a szomor\'fas\'e1gomat csup\'e1n Allahnak panaszolom el. \'c9s tudom azt Allaht\'f3l, amit ti nem tudtok.
\par 87. \'d3 fiaim! Menjetek \'e9s k\'e9rdez\'f5sk\'f6djetek J\'f3zsefr\'f5l \'e9s a testv\'e9r\'e9r\'f5l, \'e9s ne vesz\'edts\'e9tek el a rem\'e9nyt Allah k\'f6ny\'f6r\'fclet\'e9t illet\'f5en, hiszen csak a hitetlen n\'e9p vesz\'edti el a rem\'e9nyt Allah k
\'f6ny\'f6r\'fclet\'e9t illet\'f5en!\'94
\par 
\par 88. \'c9s miut\'e1n bementek hozz\'e1 (J\'f3zsefhez), azt mondt\'e1k: \'84\'d3 te m\'e9lt\'f3s\'e1gteljes! \'c1rtalom \'e9rt minket \'e9s a csal\'e1dunkat, \'e9s szedett-vedett [csere-] \'e1ruval j\'f6tt\'fcnk el. Tedd h\'e1t teljess\'e9 nek\'fcnk a kim
\'e9r\'e9st, \'e9s l\'e9gy adakoz\'f3 (eln\'e9z\'f5) vel\'fcnk! Bizony, Allah megfizeti az adakoz\'f3kat.\'94
\par 89. Azt mondta [J\'f3zsef]: \'84Vajon tudj\'e1tok, hogy mit tettetek J\'f3zseffel \'e9s a testv\'e9r\'e9vel, amikor tudatlanok voltatok [a k\'f6vetkezm\'e9nyeket illet\'f5en]?\'94
\par 90. Azt mondt\'e1k: \'84H\'e1t vajon val\'f3ban te vagy J\'f3zsef?\'94 Azt mondta: \'84\'c9n vagyok J\'f3zsef, \'e9s ez itt a testv\'e9rem. Allah kegy\'e9ben r\'e9szes\'edtett minket. Bizony, aki istenf\'e9l\'f5 \'e9s t\'fcrelmes, nos Allah nem hagyja k
\'e1rba veszni a j\'f3tev\'f5k jutalm\'e1t.\'94
\par 91. Azt mondt\'e1k: \'84Allahra! Bizony, Allah el\'f5nyben r\'e9szes\'edtett t\'e9ged vel\'fcnk szemben \'e9s bizony mi v\'e9tkesek voltunk.\'94
\par 92. Azt mondta: \'84Ma nem \'e9r titeket szemreh\'e1ny\'e1s [az\'e9rt, amit elk\'f6vettetek]. Bocs\'e1sson meg Allah nektek! \'c9s \'d5 a Legk\'f6ny\'f6r\'fcletesebb a k\'f6ny\'f6r\'fcletesek k\'f6z\'f6tt!
\par 
\par 93. Menjetek el ezzel az ingemmel, \'e9s bor\'edts\'e1tok azt ap\'e1m arc\'e1ra, akkor visszanyeri l\'e1t\'e1s\'e1t! \'c9s hozz\'e1tok el hozz\'e1m a csal\'e1dotokat, mindannyiukat!\'94
\par 94. \'c9s amikor a karav\'e1n elhagyta [Egyiptomot], azt mondta az apjuk: \'84Bizony, \'e9n J\'f3zsef illat\'e1t \'e9rzem. B\'e1rcsak ne tartan\'e1tok r\'e9vedez\'f5nek!\'94
\par 95. Azt mondt\'e1k [azok, akik k\'f6r\'fcl\'f6tte voltak]: \'84Allahra! Bizony, te a r\'e9gi t\'e9velyg\'e9sedben vagy!\'94
\par 96. \'c9s miut\'e1n meg\'e9rkezett az \'f6r\'f6mh\'edrhoz\'f3, az arc\'e1ra bor\'edtotta az inget, \'e9s \'edme visszanyerte l\'e1t\'e1s\'e1t. Azt mondta [J\'e1kob]: \'84Nem mondtam-e nektek, hogy \'e9n olyat tudok Allaht\'f3l, amit ti nem tudtok?\'94

\par 
\par 97. Azt mondt\'e1k: \'84\'d3 ap\'e1nk! K\'e9rj sz\'e1munkra megbocs\'e1t\'e1st b\'fbneink\'e9rt! Bizony, mi v\'e9tkesek voltunk.\'94
\par 98. Azt mondta: \'84Megbocs\'e1t\'e1st fogok majd k\'e9rni sz\'e1motokra az Uramt\'f3l, hiszen \'d5 a Megbocs\'e1t\'f3, az Irgalmas.\'94
\par 99. \'c9s miut\'e1n bel\'e9ptek J\'f3zsefhez, mag\'e1hoz vette a sz\'fcleit, \'e9s azt mondta: \'84L\'e9pjetek be Egyiptomba \endash  ha Allah is akarja \endash  biztons\'e1gban!\'94
\par 100. \'c9s felemelte mag\'e1hoz a sz\'fcleit a tr\'f3nra, \'e9s \'f5k f\'f6ldre rogytak el\'f5tte leborulva. Azt mondta [J\'f3zsef]: \'84\'d3 ap\'e1m! Ez a kor\'e1bbi l\'e1tom\'e1som \'e9rtelmez\'e9se. Uram imm\'e1r val\'f3s\'e1gg\'e1 tette azt. \'c9s j
\'f3t tett velem akkor, amikor kihozott a b\'f6rt\'f6nb\'f5l, \'e9s elhozott titeket a pusztas\'e1gb\'f3l, azut\'e1n, hogy a s\'e1t\'e1n visz\'e1lyt sz\'edtott k\'f6ztem \'e9s a testv\'e9reim k\'f6z\'f6tt. Bizony, Uram k\'edm\'e9
letes abban, amit akar. Bizony, \'d5 a Mindentud\'f3, a B\'f6lcs!
\par 101. Uram! Te adt\'e1l nekem az [egyiptomi] kir\'e1lyi uralomb\'f3l \'e9s tan\'edtottad meg nekem az elbesz\'e9l\'e9sek (elmondott \'e1lmok) \'e9rtelmez\'e9s\'e9t. Te vagy az egek \'e9s a f\'f6ld l\'e9trehoz\'f3ja! Te vagy az \'e9n p\'e1rtfog\'f3m az evil
\'e1gon \'e9s a T\'falvil\'e1gon. Sz\'f3l\'edts magadhoz Neked al\'e1vet\'f5k\'e9nt \'e9s csatlakoztass engem a j\'f3 emberekhez!\'94
\par 
\par 102. Ez azon h\'edrekb\'f5l val\'f3, ami [el\'f5tted, \'f3 Mohamed] rejtve volt, \'e1m mi [kinyilatkoztat\'e1sk\'e9nt] sugalltuk neked. \'c9s nem volt\'e1l ott vel\'fck, amikor megegyeztek \'fcgy\'fckben, mik\'f6zben [gonosz] tervet sz\'f5ttek.
\par 103. \'c9s a legt\'f6bb ember, b\'e1rmennyire igyekezn\'e9l [is], nem lesz h\'edv\'f5.
\par 104. \'c9s te nem k\'e9rsz \'e9rte semmilyen fizets\'e9get t\'f5l\'fck. Ez csup\'e1n eml\'e9keztet\'e9s a teremtm\'e9nyeknek.
\par 105. \'c9s h\'e1ny olyan jel van az egekben \'e9s a f\'f6ld\'f6n, amelyek mellett elhaladnak, mik\'f6zben elfordulnak t\'f5le!
\par 106. \'c9s a legt\'f6bbj\'fck nem hisz Allahban, csak \'fagy, hogy [Allah mell\'e9] t\'e1rsistent \'e1ll\'edt.
\par 107. Vajon biztons\'e1gban \'e9rzik magukat azzal szemben, hogy elj\'f6n hozz\'e1juk valami Allah gy\'f6trelm\'e9b\'f5l, amely mindent elbor\'edt, vagy hogy elj\'f6n hozz\'e1juk az \'d3ra (a Felt\'e1mad\'e1s) v\'e1ratlanul, mik\'f6zben \'f5k \'e9
szre sem veszik?
\par 
\par 108. Mondd [\'f3 Mohamed]: \'84Ez az \'e9n Utam! Allahhoz h\'edvok tiszt\'e1nl\'e1t\'e1st ad\'f3 bizony\'edt\'e9k alapj\'e1n, \'e9n \'e9s [azok] akik engem k\'f6vetnek. \'c9s magasztaltass\'e9k Allah! \'c9s \'e9n nem tartozom azok k\'f6z\'e9, akik t\'e1
rsistent \'e1ll\'edtanak [Allah mell\'e9].\'94
\par 109. \'c9s nem k\'fcldt\'fcnk el el\'f5tted, csup\'e1n olyan f\'e9rfiakat a telep\'fcl\'e9sek lak\'f3i k\'f6z\'fcl, akiknek [kinyilatkoztat\'e1st] sugalltunk. H\'e1t vajon nem j\'e1rt\'e1k be a f\'f6ldet, \'e9s nem n\'e9zt\'e9k meg, milyen v\'e9
gre jutottak azok, akik el\'f5tt\'fck \'e9ltek? \'c9s bizony a t\'falvil\'e1gi lakhely jobb azoknak, akik istenf\'e9l\'f5k voltak. Vajon h\'e1t nem \'e9ltek az eszetekkel?
\par 110. Amikor pedig a k\'fcld\'f6ttek m\'e1r elvesztett\'e9k a rem\'e9nyt [abban, hogy h\'edv\'f5 lesz a n\'e9p\'fck] \'e9s [teljes bizonyoss\'e1ggal] azt v\'e9lt\'e9k, hogy hazugnak tartj\'e1k \'f5ket, akkor elj\'f6tt hozz\'e1juk a Mi seg\'edts\'e9g\'fc
nk, \'e9s megmenek\'edttetett az, akit akartunk. \'c9s a Mi csap\'e1sunk nem h\'e1r\'edthat\'f3 el a gonosztev\'f5 n\'e9pr\'f5l.
\par 111. Az \'f5 t\'f6rt\'e9neteikben bizony tanuls\'e1g van az \'e9rtelemmel b\'edr\'f3k sz\'e1m\'e1ra. Ez nem kital\'e1lt besz\'e9d volt, hanem igazol\'e1sa annak, ami el\'f5tte volt [a kor\'e1bbi kinyilatkoztat\'e1sokb\'f3l] \'e9s minden dolog r\'e9
szletes magyar\'e1zata, \'e9s \'fatmutat\'e1s \'e9s k\'f6ny\'f6r\'fclet egy olyan n\'e9pnek, akik hisznek.}{\insrsid3161635 
\par 
\par 
\par 
\par }\pard \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid3161635 {\b\insrsid7550020 \page }{\b\insrsid16543947 13. }{\b\insrsid3161635\charrsid5078441 A mennyd\'f6rg\'e9s (ar-R'ad) c. sz\'fara

\par }\pard \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid5078441 
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid3161635\charrsid5078441 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev
\'e9ben.
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid3161635\charrsid5078441 
\par 1. Alif-l\'e1m-m\'edm-ra. Ezek az \'cdr\'e1s jelei (id\'e9zetei). \'c9s ami lebocs\'e1ttatott neked Uradt\'f3l az az Igazs\'e1g, \'e1m a legt\'f6bb ember nem hisz.
\par 2. Allah az, aki felemelte az egeket oszlopok n\'e9lk\'fcl, ahogy l\'e1tj\'e1tok. Azut\'e1n elhelyezkedett [Hozz\'e1 m\'e9lt\'f3an] a Tr\'f3nuson, \'e9s szolg\'e1latra rendelte a Napot \'e9s a Holdat, mindegyik megszabott hat\'e1rid\'f5
ig fut. Elrendezi az [evil\'e1g \'e9s a t\'falvil\'e1g] \'fcgyeit. R\'e9szletesen fejti ki a jeleket, h\'e1tha az Uratokkal val\'f3 tal\'e1lkoz\'e1sban szil\'e1rd bizonyoss\'e1gotok lesz.
\par 3. \'c9s \'d5 az, aki kiter\'edtette a f\'f6ldet, \'e9s azon szil\'e1rdan r\'f6gz\'edtetteket (hegyeket) helyezett el \'e9s foly\'f3kat. \'c9s ott minden term\'e9sb\'f5l egy p\'e1rt, kett\'f5t teremtett meg. Bebor\'edtja [egym\'e1ssal] az \'e9jszak\'e1t 
\'e9s a nappalt. Bizony, ebben jelek vannak egy olyan n\'e9p sz\'e1m\'e1ra, akik elgondolkodnak.
\par 4. \'c9s a f\'f6ld\'f6n egym\'e1ssal szomsz\'e9dos [k\'fcl\'f6nb\'f6z\'f5 term\'e9szet\'fb] ter\'fcletek vannak, \'e9s sz\'f5l\'f5skertek \'e9s gabon\'e1k, \'e9s [egy gy\'f6k\'e9rb\'f5l] csoportosan sarjad\'f3 vagy mag\'e1nyosan sarjad\'f3 datolyap\'e1lm
\'e1k, egyazon v\'edzzel \'f6nt\'f6zve. \'c9s Mi egyiket a m\'e1sik f\'f6l\'e9 helyezt\'fck az \'edzeket illet\'f5en. Bizony, ebben jelek vannak egy olyan n\'e9p sz\'e1m\'e1ra, akik \'e9lnek az esz\'fckkel.
\par 
\par 5. \'c9s ha csod\'e1lkozol [\'f3 Mohamed], h\'e1t csod\'e1lkoz\'e1sra val\'f3 az \'f5 besz\'e9d\'fck: \'84Vajon ha m\'e1r porr\'e1 lett\'fcnk, val\'f3ban \'faj teremt\'e9sben lesz\'fcnk [felt\'e1masztva]?\'94 \'d5k azok, akik hitetlenn\'e9 v\'e1
ltak az Urukkal szemben. \'c9s azok nyak\'e1ban bilincsek lesznek. \'c9s azok a [Pokol-]t\'fbz lak\'f3i! \'d6r\'f6kk\'e9 abban fognak maradni.
\par 6. Siettetnek t\'e9ged a rosszal (a b\'fcntet\'e9s elhoz\'e1s\'e1val) a j\'f3 el\'f5tt, pedig m\'e1r elm\'faltak (megt\'f6rt\'e9ntek) el\'f5tt\'fck a p\'e9ld\'e1s b\'fcntet\'e9sek. \'c1m Urad megbocs\'e1t\'e1ssal teljes az emberek ir\'e1nt, igazs\'e1gt
alans\'e1guk ellen\'e9re. Bizony, Urad szigor\'fa a b\'fcntet\'e9sben.
\par 7. \'c9s azt mondj\'e1k azok, akik hitetlenn\'e9 v\'e1ltak: \'84H\'e1t mi\'e9rt nem bocs\'e1ttatott le re\'e1 egy jel az Ur\'e1t\'f3l?\'94 Te csup\'e1n figyelmeztet\'f5 vagy! \'c9s minden n\'e9p sz\'e1m\'e1ra van egy [igaz \'fatra] vezet\'f5.
\par 
\par 8. Allah tudja mit hordoz [a m\'e9h\'e9ben] minden n\'f5nem\'fb [l\'e9ny], \'e9s azt is, hogy mennyivel fogyatkoznak az anyam\'e9hek \'e9s mennyivel gyarapodnak. \'c9s N\'e1la minden dolognak [meghat\'e1rozott] m\'e9rt\'e9ke van.
\par 9. \'d5 a rejtett \'e9s a l\'e1that\'f3 [dolgok] Tud\'f3ja, a Nagy, a Magass\'e1gos!
\par 10. [Allah el\'f5tt] egyre megy, hogy ki titkolja k\'f6z\'fcletek a mondanival\'f3j\'e1t \'e9s ki mondja ki ny\'edltan, \'e9s ki rejt\'f5zik el \'e9jjel \'e9s ki jelenik meg nappal.
\par 11. Szorosan a sark\'e1ban l\'e9v\'f5 [angyalok] vannak el\'f5tte \'e9s m\'f6g\'f6tte, akik \'f5rzik \'f5t \endash  Allah parancs\'e1b\'f3l fakad\'f3an. Bizony, Allah nem v\'e1ltoztatja meg azt, amely valamely n\'e9pben van, ameddig \'f5k meg nem v\'e1
ltoztatj\'e1k azt, ami magukban van. \'c9s amikor Allah valami rosszat (pr\'f3bat\'e9telt) akar egy n\'e9pnek, annak nincs elh\'e1r\'edt\'f3ja. \'c9s nincs nekik Rajta k\'edv\'fcl p\'e1rtfog\'f3juk.
\par 
\par 12. \'d5 az, aki megmutatja nektek a vill\'e1mot, f\'e9lelmet \'e9s v\'e1gyakoz\'e1st [keltve \'e1ltala], \'e9s l\'e9trehozza a neh\'e9z felh\'f5ket.
\par 13. \'c9s \'d5t magasztalja az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel a mennyd\'f6rg\'e9s, \'e9s az angyalok is a T\'f5le val\'f3 f\'e9lelm\'fckben. \'c9s elk\'fcldi a vill\'e1mcsap\'e1sokat, s azt s\'fajtja vel\'fck, akit akar. \'c1m \'f5k vit\'e1
ba sz\'e1llnak Allahr\'f3l, mik\'f6zben \'d5 er\'f5s a b\'fcntet\'e9sben.
\par 
\par 14. \'d5t illeti az Igaz h\'edv\'e1s (az \'f5szinte foh\'e1sz). \'c9s azok, akikhez Rajta k\'edv\'fcl foh\'e1szkodnak, nem adnak nekik v\'e1laszt semmiben, csak \'fagy, mint aki kiny\'fajtja a tenyer\'e9t a v\'edz fel\'e9, hogy eljusson a sz\'e1j\'e1
hoz, de az sosem jut el od\'e1ig. \'c9s a hitetlenek foh\'e1sza nincs m\'e1shol, mint t\'e9v\'faton!
\par 15. \'c9s Allah el\'f5tt borul le mindenki az egekben \'e9s a f\'f6ld\'f6n, \'f6nk\'e9nt \'e9s k\'e9nyszerb\'f5l, \'e9s az \'e1rny\'e9kuk is reggel \'e9s k\'e9s\'f5 d\'e9lut\'e1n.
\par 16. Mondd: \'84Ki az egek \'e9s a f\'f6ld Ura?\'94 Mondd: \'84Allah!\'94 Mondd: \'84Vajon h\'e1t Rajta k\'edv\'fcl olyanokat tesztek p\'e1rtfog\'f3itokk\'e1, akiknek nem \'e1ll m\'f3djukban maguknak hasznot [hozni], sem \'e1rtalmat [elt\'e1vol\'ed
tani]? Mondd: \'84Vajon egyenl\'f5-e a vak a l\'e1t\'f3val? Vagy egyenl\'f5k-e a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gek \'e9s a f\'e9ny? Vagy Allah mell\'e9 olyan t\'e1rsisteneket \'e1ll\'edtanak, akik az \'d5 teremt\'e9s\'e9
hez hasonlatosat teremtettek, \'edgy egyforma lett a teremt\'e9s sz\'e1mukra?\'94 Mondd: \'84Allah minden dolog Teremt\'f5je! \'c9s \'d5 az Egy, a Legy\'f5zhetetlen!\'94
\par 17. Az \'e9gb\'f5l vizet bocs\'e1tott le, amellyel meg\'e1radtak a foly\'f3v\'f6lgyek a m\'e9rt\'e9k\'fck szerint. Az \'e1radat tajt\'e9kot visz a felsz\'ednen. \'c9s abb\'f3l a [f\'e9mb\'f5l], amit a t\'fbzben hev\'edtenek, \'e9kszert \'e9s holmit \'e1h
\'edtozv\'e1n k\'e9sz\'edteni, ahhoz hasonl\'f3 tajt\'e9k marad. Allah ekk\'e9ppen ad p\'e9ld\'e1zatot az igazs\'e1gr\'f3l \'e9s a hamiss\'e1gr\'f3l. Ami pedig a tajt\'e9kot illeti, az hordal\'e9kk\'e9nt t\'fb
nik el. Ami pedig hasznos az embereknek, az megmarad a f\'f6ld\'f6n. Allah ekk\'e9ppen ad p\'e9ld\'e1zatokat.
\par 
\par 18. Akik hallgatnak Urukra, azoknak a legjobb [jutalom] (a Paradicsom) j\'e1r. \'c9s akik nem hallgatnak r\'e1, ha mindaz, ami a f\'f6ld\'f6n van az \'f6v\'e9k is lenne, \'e9s azzal egy\'fctt m\'e9g egyszer annyi, azok szeretn\'e9k megv\'e1
ltani azzal magukat. Azok\'e9 lesz a legrosszabb elsz\'e1moltat\'e1s, \'e9s a hajl\'e9kuk a Gyehenna lesz. \'c9s milyen sz\'f6rny\'fb fekhely az!
\par 19. \'c9s vajon az, aki tudja, hogy ami lebocs\'e1ttatott hozz\'e1d Uradt\'f3l, az az igazs\'e1g, olyan-e, mint aki vak? Bizony, csak az \'e9rtelemmel b\'edr\'f3k okulnak [az int\'e9sb\'f5l].
\par 20. Akik teljes\'edtik az Allahhal [k\'f6t\'f6tt] egyezs\'e9get \'e9s nem szegik meg a sz\'f6vets\'e9get,
\par 21. \'c9s akik egybek\'f6tik azt, amire Allah parancsot adott, hogy egybek\'f6ttessen, \'e9s f\'e9lnek Urukt\'f3l, \'e9s f\'e9lnek a rossz elsz\'e1moltat\'e1st\'f3l,
\par 22. \'c9s akik t\'fcrelmesek voltak, \'e1h\'edtozv\'e1n Uruk arc\'e1t (megel\'e9ged\'e9s\'e9t), \'e9s akik megtartott\'e1k az im\'e1dkoz\'e1st, \'e9s adakoztak abb\'f3l, amivel ell\'e1ttuk \'f5ket, titokban \'e9s nyilv\'e1nosan, \'e9s a rosszat j\'f3val h
\'e1r\'edtj\'e1k el, azok\'e9 lesz a v\'e9gs\'f5 lakhely.
\par 23. \'d6r\'f6kk\'e9 tart\'f3 kertek, amelyekbe bel\'e9pnek \'f5k, \'e9s azok, akik j\'f3raval\'f3k voltak az aty\'e1ik \'e9s a h\'e1zast\'e1rsaik \'e9s a lesz\'e1rmazottaik k\'f6z\'fcl. \'c9s az angyalok bel\'e9pnek hozz\'e1juk minden kapun,
\par 24. [Azt mondv\'e1n:] \'84B\'e9kess\'e9g re\'e1tok, az\'e9rt ami\'e9rt t\'fcrelmesek voltatok!\'94 Milyen nagyszer\'fb v\'e9gs\'f5 lakhely!
\par 
\par 25. \'c9s akik megszegik az Allahhal [k\'f6t\'f6tt] egyezs\'e9get, miut\'e1n megk\'f6t\'f6tt\'e9k azt, \'e9s megszak\'edtj\'e1k azt, amire Allah parancsot adott, hogy egybek\'f6ttessen, \'e9s roml\'e1st okoznak a f\'f6ld\'f6n, azoknak \'e1tok j\'e1r \'e9
s a legrosszabb lakhely illeti \'f5ket.
\par 26. Allah kiterjeszti az ell\'e1t\'e1st annak, akinek akarja, \'e9s sz\'fbk\'f6ss\'e9 teszi [m\'e1soknak]. \'c9s \'f6rvendeznek az evil\'e1gi \'e9letnek, \'e1m az evil\'e1gi \'e9let a t\'falvil\'e1gi \'e9lethez k\'e9pest csak [muland\'f3] \'e9lvezet.

\par 27. \'c9s azt mondj\'e1k azok, akik hitetlenn\'e9 v\'e1ltak: \'84H\'e1t mi\'e9rt nem bocs\'e1ttatott le hozz\'e1 egy jel az Ur\'e1t\'f3l?\'94 Mondd [\'f3 Mohamed]: \'84Allah azt viszi t\'e9velyg\'e9sbe, akit akar, \'e9s Mag\'e1hoz vezeti azt, aki b\'fbnb
\'e1nattal t\'e9r vissza [Hozz\'e1].\'94
\par 
\par 28. Akik hisznek \'e9s megnyugszik a sz\'edv\'fck az Allahr\'f3l val\'f3 megeml\'e9kez\'e9st\'f5l \endash  l\'e1m az Allahr\'f3l val\'f3 megeml\'e9kez\'e9st\'f5l nyugszanak meg a sz\'edvek!
\par 29. Akik hisznek \'e9s j\'f3tetteket cselekszenek, azoknak boldogs\'e1g j\'e1r \'e9s sz\'e9p [t\'falvil\'e1gi] hely a visszat\'e9r\'e9shez!
\par 
\par 30. Ekk\'e9ppen k\'fcldt\'fcnk el t\'e9ged egy k\'f6z\'f6ss\'e9gbe, amely el\'f5tt m\'e1r m\'e1s k\'f6z\'f6ss\'e9gek is elt\'e1voztak [az \'e9l\'f5k sor\'e1b\'f3l], hogy recit\'e1ld nekik azt, amit sugalltunk neked, mik\'f6zben \'f5k nem hisznek a K\'f6ny
\'f6r\'fcletesben! Mondd: \'84\'d5 az \'e9n Uram! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten csak \'d5! \'d5r\'e1 hagyatkozom \'e9s Hozz\'e1 fordulok b\'fbnb\'e1nattal!\'94
\par 31. \'c9s ha lenne olyan Kor\'e1n-r\'e9sz, amely \'e1ltal elmozd\'edttatn\'e1nak a hegyek, vagy darabokra szak\'edttatna a f\'f6ld, vagy megsz\'f3laltatn\'e1nak \'e1ltala a halottak [akkor sem hinn\'e9nek]. De nem! Allahra tartozik az \'f6sszes \'fc
gy [eld\'f6nt\'e9se]! H\'e1t vajon nem vesz\'edtett\'e9k el a rem\'e9nyt, akik hisznek abban, hogy ha Allah akarta volna, [az igaz \'fatra] vezette volna az \'f6sszes embert? \'c9s akik hitetlenn\'e9 v\'e1ltak, azokat [sz\'fcntelen\'fcl] les\'fajt\'f3
 csap\'e1s fogja \'e9rni az\'e9rt, amit m\'fbveltek, vagy a lakhely\'fckh\'f6z k\'f6zel fog les\'fajtani, am\'edg be nem teljesedik Allah \'edg\'e9rete. Bizony, Allah nem szegi meg az \'edg\'e9retet.
\par 32. \'c9s m\'e1r g\'fanyt \'fbztek egyes k\'fcld\'f6ttekb\'f5l teel\'f5tted is, \'e1m halad\'e9kot adtam azoknak, akik hitetlenn\'e9 v\'e1ltak, majd elragadtam \'f5ket. \'c9s milyen volt a b\'fcntet\'e9sem?}{\insrsid3161635 
\par 33. H\'e1t vajon az, aki fel\'fcgyel minden embert [\'e9s tudja] amit szereztek [olyan lenne, mint aki nem]? \'c9s Allah mell\'e9 }{\insrsid3161635\charrsid11041801 t\'e1rsisteneket \'e1ll\'edtottak. Mondd [\'f3 Mohamed]: \'84Nevezz\'e9tek meg \'f5
ket! Vagy olyasmir\'f5l akartok h\'edrt adni Neki, amir\'f5l \'d5 nem tud a f\'f6ld\'f6n, vagy [ezek a t\'e1rsistenek] csak val\'f3s\'e1g n\'e9lk\'fcli mond\'e1s}{\insrsid3161635 ok (}{\insrsid3161635\charrsid11041801 nevek)?\'94 \'c1
m azoknak, akik hitetlenn\'e9 v\'e1ltak, d\'edszess\'e9 t\'e9tetett a [gonosz]}{\insrsid3161635  t}{\insrsid3161635\charrsid11041801 ervez\'e9s\'fck, \'e9s t\'e1vol voltak tartva az \'datt\'f3l, \'e9s akit Allah t\'e9velyg\'e9sbe visz, annak nincs vezet
\'f5je [az igaz \'fatra].
\par 34. Gy\'f6trelem j\'e1r nekik az evil\'e1gi \'e9letben \'e9s a t\'falvil\'e1gi gy\'f6trelem m\'e9g nehezebb. \'c9s nem lesz sz\'e1mukra [v\'e9delmez\'f5], aki meg\'f3vn\'e1 \'f5ket Allaht\'f3l.
\par 
\par 35. A Paradicsom le\'edr\'e1sa, amelyre \'edg\'e9retet kaptak az istenf\'e9l\'f5k: foly\'f3k folynak al\'f3la, \'e9lelme \'f6r\'f6kk\'e9 tart\'f3, \'e9s az \'e1rny\'e9ka is. Ez lesz a v\'e9g azoknak, akik istenf\'e9l\'f5k. \'c9s a v\'e9
g a hitetleneknek a [Pokol-]t\'fbz.
\par 
\par 36. \'c9s azok, akiknek az \'cdr\'e1st adtuk, \'f6rvendeznek amiatt, ami lebocs\'e1ttatott neked [\'f3 Mohamed], \'e9s a csoportok k\'f6z\'f6tt vannak olyanok, akik tagadj\'e1k [annak] egy r\'e9sz\'e9t. Mondd: \'84\'c9n csup\'e1
n arra kaptam parancsot, hogy Allahot szolg\'e1ljam, \'e9s ne \'e1ll\'edtsak \'d5mell\'e9 t\'e1rsistent! Hozz\'e1 h\'edvok, \'e9s N\'e1la lesz [a v\'e9gs\'f5] visszat\'e9r\'f5 helyem!\'94
\par 37. \'c9s ekk\'e9ppen bocs\'e1tottuk le azt [a Kor\'e1nt] arab nyelv\'fb \'edt\'e9lkez\'e9s [forr\'e1sak\'e9nt]. \'c9s ha}{\insrsid3161635  az \'f5 k\'e9nyeiket k\'f6vetn\'e9d azut\'e1n,}{\insrsid3161635\charrsid11041801  hogy tud\'e1s j\'f6tt el hozz\'e1
d [Uradt\'f3l], akkor nem lesz neked Allahhal szemben sem p\'e1rtfog\'f3d, sem olyasvalaki, aki meg\'f3vna.
\par 
\par 38. \'c9s bizony k\'fcldt\'fcnk k\'fcld\'f6tteket m\'e1r el\'f5tted is [\'f3 Mohamed], \'e9s adtunk nekik h\'e1zast\'e1rsakat \'e9s lesz\'e1rmazottakat. Egy k\'fcld\'f6tt sem hozhat jelet, csakis Allah engedelm\'e9vel. Minden [dolog] hat\'e1
rideje meg van \'edrva [az \'d5rz\'f6tt T\'e1bl\'e1n].
\par 39. Allah elt\'f6rli azt, amit akar, \'e9s megtart [amit akar], \'e9s N\'e1la van az \'d5s-\'cdr\'e1s (az \'d5rz\'f6tt T\'e1bla).
\par 40. \'c9s ak\'e1r megmutatjuk neked egy r\'e9sz\'e9t annak, amit meg\'edg\'e9rt\'fcnk nekik, ak\'e1r [m\'e9g el\'f5tte] magunkhoz sz\'f3l\'edtunk t\'e9ged, r\'e1d csup\'e1n az [\'fczenet-]\'e1tad\'e1s tartozik, \'e9s R\'e1nk tartozik az elsz\'e1moltat\'e1
s.
\par 41. H\'e1t vajon nem l\'e1tt\'e1k, hogy el\'f5vessz\'fck a f\'f6ldet \'e9s lesz\'fbk\'edtj\'fck azt a sz\'e9lei fel\'f5l? \'c9s Allah \'edt\'e9lkezik, senki sem \'e9rv\'e9nytelen\'edtheti az \'edt\'e9let\'e9t. \'c9s \'d5 gyors az elsz\'e1moltat\'e1sban.

\par 42. \'c9s [gonosz] tervet sz\'f5ttek m\'e1r azok [is], akik el\'f5tt\'fck \'e9ltek, \'e1m Allahn\'e1l van az \'f6sszes tervez\'e9s, tudja, hogy mit szerez minden ember, \'e9s a hitetlenek meg fogj\'e1k tudni ki\'e9 lesz a v\'e9gs\'f5 lakhely.}{
\insrsid3161635 
\par 43. \'c9s azok, akik hitetlenn\'e9 v\'e1ltak azt mondj\'e1k [neked, \'f3 Mohamed]: \'84Te nem vagy k\'fcld\'f6tt!\'94 Mondd: \'84Allah el\'e9gs\'e9ges tan\'fa k\'f6ztem \'e9s k\'f6ztetek, \'e9s azok is, akikn\'e9l az \'cdr\'e1s tud\'e1sa van.\'94
\par 
\par 
\par 
\par 
\par }\pard \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid3161635 {\b\insrsid7550020 \page }{\b\insrsid16543947 14.}{\b\insrsid3161635\charrsid15492590  \'c1brah\'e1m (Ibrahim) c. sz\'fara

\par }\pard \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635 
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid3161635\charrsid7817722 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev
\'e9ben.
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid3161635\charrsid7817722 
\par 1. Alif-l\'e1m-ra. \'cdr\'e1s [ez], amelyet lebocs\'e1tottunk hozz\'e1d, hogy kivezesd az embereket a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gekb\'f5l a vil\'e1goss\'e1gra, Urad engedelm\'e9vel a M\'e9lt\'f3s\'e1gteljes \'e9s a Dics\'e9retrem\'e9lt\'f3 
\'fatj\'e1ra.
\par 2. Allah [\'fatj\'e1ra], aki\'e9 mindaz, ami az egekben \'e9s ami a f\'f6ld\'f6n van. \'c9s jaj a hitetleneknek [a r\'e1juk v\'e1r\'f3] s\'falyos gy\'f6trelem miatt!
\par 3. Akik el\'f5nyben r\'e9szes\'edtik az evil\'e1gi \'e9letet a t\'falvil\'e1ggal szemben \'e9s t\'e1vol tartanak [m\'e1sokat] Allah \'datj\'e1t\'f3l, \'e9s azt k\'edv\'e1nj\'e1k, hogy az ferde legyen, azok [az igazs\'e1gt\'f3l] messzej\'e1r\'f3 t\'e9velyg
\'e9sben vannak.
\par 4. \'c9s nem k\'fcldt\'fcnk el egy k\'fcld\'f6ttet sem, csak olyat, aki n\'e9pe nyelv\'e9n [besz\'e9lt], hogy nyilv\'e1nval\'f3v\'e1 tegye azt (az \'fczenetet) nekik. Allah pedig azt visz t\'e9velyg\'e9sbe, akit akar, \'e9s azt vezet [az igaz \'fa
tra], akit akar, \'e9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 
\par 5. \'c9s elk\'fcldt\'fck kor\'e1bban M\'f3zest a jeleinkkel, hogy: \'84Hozd ki n\'e9ped a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gekb\'f5l a vil\'e1goss\'e1gra \'e9s eml\'e9keztesd \'f5ket Allah napjaira!\'94 Bizony, ebben jelek vannak mindenkinek, aki t
\'fcrelmes \'e9s h\'e1l\'e1s.
\par 6. \'c9s [eml\'edtsd meg,] amikor azt mondta M\'f3zes a n\'e9p\'e9nek: \'84Eml\'e9kezzetek Allah j\'f3t\'e9tem\'e9ny\'e9re ir\'e1ntatok, amikor megmentett titeket a F\'e1ra\'f3 n\'e9p\'e9t\'f5l, [akik] sz\'f6rny\'fb gy\'f6trelemmel s\'fajtottak titeket, 
\'e9s lem\'e9sz\'e1rolt\'e1k fiaitokat \'e9s asszonyaitokat \'e9letben hagyt\'e1k! \'c9s ebben hatalmas pr\'f3bat\'e9tel volt sz\'e1motokra Uratokt\'f3l.\'94
\par 7. \'c9s [eml\'edtsd meg,] amikor az Uratok kihirdette: \'84Ha h\'e1l\'e1sak vagytok, akkor m\'e9g t\'f6bbet adunk nektek, \'e1m ha hitetlenn\'e9 v\'e1ltok [kegyeimmel szemben], bizony s\'falyos a gy\'f6trelmem!\'94
\par 8. \'c9s azt mondta M\'f3zes: \'84Ha hitetlenn\'e9 v\'e1ltok, ti \'e9s mindenki, aki csak a f\'f6ld\'f6n van [azzal nem \'e1rtotok Allahnak]. Bizony, Allah Gazdag, Dics\'e9retrem\'e9lt\'f3.\'94
\par 
\par 9. Nem j\'f6tt-e el hozz\'e1tok azok h\'edre, akik el\'f5ttetek [\'e9ltek]: No\'e9 \'e9s \'c1d \'e9s Tam\'fad n\'e9p\'e9\'e9, \'e9s azok\'e9, akik ut\'e1nuk [\'e9ltek], [akikr\'f5l] nem tudnak [m\'e1sok] csak Allah? A k\'fcld\'f6tteik vil\'e1gos bizony
\'edt\'e9kokkal j\'f6ttek el hozz\'e1juk, de \'f5k a kez\'fcket a sz\'e1jukra tett\'e9k \'e9s azt mondt\'e1k: \'84Mi hitetlenn\'e9 v\'e1ltunk azzal szemben, amivel ti elk\'fcldettetek, \'e9s bizony, mi elbizonytalan\'edt\'f3 k\'e9ts\'e9
gben vagyunk azzal szemben, amire ti sz\'f3l\'edtotok fel titeket.\'94
\par 10. Azt mondt\'e1k a k\'fcld\'f6tteik: \'84Lehet-e k\'e9ts\'e9g Allahot, az egek \'e9s a f\'f6ld l\'e9trehoz\'f3j\'e1t illet\'f5en? Az\'e9rt h\'edv titeket, hogy megbocs\'e1sson nektek a b\'fbneitekb\'f5l, \'e9s halad\'e9
kot adjon nektek egy megszabott hat\'e1rid\'f5ig.\'94 Azt mondt\'e1k: \'84Bizony, ti nem vagytok m\'e1sok, mint hozz\'e1nk hasonl\'f3 emberek, t\'e1vol akartok tartani minket att\'f3l, amit ap\'e1ink szolg\'e1ltak. Hozzatok h\'e1t nek\'fcnk nyilv\'e1nval
\'f3 bizony\'edt\'e9kot!\'94
\par 11. Azt mondt\'e1k nekik a k\'fcld\'f6tteik: \'84Bizony, mi csup\'e1n hozz\'e1tok hasonl\'f3 emberek vagyunk! Allah azonban azt r\'e9szes\'edti a szolg\'e1i k\'f6z\'fcl az \'f5 kegy\'e9b\'f5l akit akar. \'c9s mi nem hozhatunk bizony\'edt\'e9
kot nektek, csak Allah engedelm\'e9vel. \'c9s Allahra hagyatkozzanak a h\'edv\'f5k!
\par 12. \'c9s mi\'e9rt ne hagyatkozn\'e1nk Allahra, holott \'d5 vezetett minket \'fatjainkra. \'c9s bizony t\'fcrelmesek lesz\'fcnk azzal szemben, ami b\'e1ntalmat okoztok nek\'fcnk. \'c9s Allahra hagyatkozzanak a hagyatkoz\'f3k!\'94
\par 
\par 13. \'c9s azok, akik hitetlenn\'e9 v\'e1ltak, azt mondt\'e1k a k\'fcld\'f6tteiknek: \'84Bizony mi ki\'fbz\'fcnk titeket a f\'f6ld\'fcnkr\'f5l, vagy pedig visszat\'e9rtek a vall\'e1sunkra.\'94 \'c9s Uruk azt sugallta nekik (a k\'fcld\'f6tteknek): \'84
Bizony, mi elpuszt\'edtjuk az igazs\'e1gtalanokat!
\par 14. \'c9s bizony lak\'f3helyetekk\'e9 tessz\'fck [az ellens\'e9g] f\'f6ldj\'e9t \'f5ut\'e1nuk. Ez annak [j\'e1r], aki f\'e9l att\'f3l, hogy [majd] El\'f5ttem \'e1ll [az elsz\'e1moltat\'e1sra az \'cdt\'e9let napj\'e1n], \'e9s f\'e9l a fenyeget\'e9semt\'f5
l.\'94}{\insrsid3161635 
\par 15. \'c9s gy\'f5zelmet k\'e9rtek [a k\'fcld\'f6ttek Allaht\'f3l], \'e9s kudarcot vallott minden hatalmaskod\'f3, makacs.
\par 16. Azut\'e1n a Gyehenna [v\'e1rja], \'e9s gennyes v\'edzzel fogj\'e1k itatni.
\par 17. Kelletlen\'fcl }{\insrsid3161635\charrsid7817722 kortyolgatja, \'e9s alig tudja lenyelni, \'e9s a hal\'e1l j\'f6n el hozz\'e1 minden helyr\'f5l, \'e1m \'f5 nem hal meg. \'c9s s\'falyos gy\'f6trelem van m\'f6g\'f6tte.
\par 18. Akik Urukkal szemben hitetlenn\'e9 v\'e1ltak, azoknak a cselekedetei olyanok, mint a hamu, amelyet er\'f5s sz\'e9l f\'faj egy viharos napon. Nincs hatalmuk semmi felett abb\'f3l, amit szereztek [az evil\'e1gon]. Ez messzej\'e1r\'f3 t\'e9velyg\'e9
s [az igazs\'e1gt\'f3l].
\par 
\par 19. Vajon nem gondolkodt\'e1l el azon, hogy Allah igazs\'e1ggal (c\'e9llal) teremtette az egeket \'e9s a f\'f6ldet? Ha \'fagy akarja, elt\'e1vol\'edt (elpuszt\'edt) titeket, \'e9s \'faj teremt\'e9st hoz.
\par 20. \'c9s ez Allahnak nem lehetetlen.
\par 
\par 21. \'c9s meg fog jelennek [\'edt\'e9lkez\'e9sre] Allah el\'f5tt mindannyian, \'e9s azt mondj\'e1k az elnyomottak azoknak, akik fennh\'e9j\'e1ztak: \'84Bizony, mi a ti k\'f6vet\'f5itek voltunk, h\'e1t el tudtok-e h\'e1r\'edtani b\'e1rmit is r\'f3
lunk Allah gy\'f6trelm\'e9b\'f5l?\'94 Azt mondt\'e1k: \'84Ha Allah [igaz \'fatra] vezetett volna minket, akkor bizony mi is vezett\'fcnk volna titeket! Egyre megy nek\'fcnk, hogy f\'e9l\'fcnk vagy t\'fcrelmet tan\'fas\'edtunk, nincs sz\'e1munkra menek\'fc
l\'e9si hely.\'94
\par 22. \'c9s majd a s\'e1t\'e1n azt mondja, miut\'e1n eld\'f6ntetik  az}{\insrsid3161635  \'fcgy: \'84Bizony, Allah}{\insrsid3161635\charrsid7817722  igaz \'edg\'e9retet  \'edg\'e9rt nektek, \'e9s \'e9n is \'edg\'e9rtem nektek, de}{\insrsid3161635  }{
\insrsid3161635\charrsid7817722 \'e9n megszegtem azt! \'c9s nem rendelkeztem hatalommal felettetek, kiv\'e9ve hogy h\'edvtalak titeket, ti pedig hallgattatok r\'e1m. Ne nekem tegyetek szemreh\'e1ny\'e1st, hanem magatoknak tegyetek szemreh\'e1ny\'e1
st! Nem lehetek a seg\'edts\'e9getekre \'e9s ti sem lehettek az \'e9n seg\'edts\'e9gemre. Bizony, \'e9n tagadom azt, hogy ti engem kor\'e1bban t\'e1rsistennek \'e1ll\'edtottatok [Allah mell\'e9]. Bizony, az igazs\'e1gtalanoknak f\'e1jdalmas gy\'f6trelem j
\'e1r.\'94
\par 23. \'c9s akik hisznek \'e9s j\'f3tetteket cselekszenek, azokat olyan kertekbe l\'e9ptetik be [a Paradicsomban], amelyek al\'f3l foly\'f3k folynak, \'f6r\'f6kk\'e9 abban fognak maradni, Allah engedelm\'e9vel. A k\'f6sz\'f6nt\'e9s\'fck ott: \'84B\'e9kess
\'e9g!\'94
\par 
\par 24. }{\lang1038\langfe255\langfenp255\insrsid3161635\charrsid7817722 Vajon n}{\lang255\langfe255\langnp255\langfenp255\insrsid3161635\charrsid7817722 em }{\lang1038\langfe255\langfenp255\insrsid3161635\charrsid7817722 gondolkodt\'e1l el azon}{
\lang255\langfe255\langnp255\langfenp255\insrsid3161635\charrsid7817722 , }{\insrsid3161635\charrsid7817722 milyen [csod\'e1s] p\'e9ld\'e1zatot adott Allah egy j\'f3 sz\'f3r\'f3l, amely olyan, mint egy j\'f3 fa, amelynek a gy\'f6kere szil\'e1rd, \'e9s az 
\'e1gai az \'e9gbe ny\'falnak?}{\lang1038\langfe255\langfenp255\insrsid3161635 
\par }{\insrsid3161635 25. Megadja term\'e9s\'e9t minden id\'f5ben, Ura engedelm\'e9vel. Allah p\'e9ld\'e1zatokat ad az embereknek, hogy }{\insrsid3161635\charrsid7817722 okulhassanak [az int\'e9sb\'f5l].
\par 26. A hitv\'e1ny sz\'f3 pedig hasonlatos egy hitv\'e1ny f\'e1hoz, amely ki lett t\'e9pve a f\'f6ld felsz\'edn\'e9r\'f5l, \'e9s nincs neki semmilyen szil\'e1rds\'e1ga.
\par 27. Allah a szil\'e1rd sz\'f3val er\'f5s\'edti meg azokat, akik hisznek, az evil\'e1gon \'e9s a t\'falvil\'e1gon. \'c9s Allah t\'e9velyg\'e9sbe viszi az igazs\'e1gtalanokat. \'c9s Allah azt tesz, amit akar.
\par 
\par 28. }{\lang1038\langfe255\langfenp255\insrsid3161635\charrsid7817722 Vajon n}{\lang255\langfe255\langnp255\langfenp255\insrsid3161635\charrsid7817722 em }{\lang1038\langfe255\langfenp255\insrsid3161635\charrsid7817722 gondolkodt\'e1l-e el }{
\insrsid3161635\charrsid7817722 azoknak [a h\'edr\'e9n], akik Allah j\'f3t\'e9tem\'e9ny\'e9t hitetlens\'e9gre cser\'e9lt\'e9k, \'e9s n\'e9p\'fcket a veszedelmes lakhelyre telep\'edtett\'e9k?
\par 29. A Gyehenn\'e1ba! Ott fognak \'e9gni. \'c9s milyen nyomor\'fas\'e1gos tart\'f3zkod\'e1si hely.
\par 30. \'c9s Allah mell\'e9 vet\'e9lyt\'e1rsakat tettek, hogy elt\'e9vely\'edtsenek [m\'e1sokat] az \'d5 \'fatj\'e1t\'f3l. Mondd: \'84\'c9lvezz\'e9tek [az evil\'e1gi \'e9leteteket]! Bizony, a v\'e9gzetetek a Pokol-t\'fbzben lesz.\'94}{\insrsid3161635 
\par 
\par 31. Mondd [\'f3 Mohamed] a szolg\'e1imnak, akik hisznek, hogy tarts\'e1k meg az im\'e1dkoz\'e1st, \'e9s adakozzanak titokban vagy nyilv\'e1nosan abb\'f3l, amivel ell\'e1ttuk \'f5ket, m\'e9g azel\'f5tt, hogy elj\'f6n egy olyan nap, amelyen nem lesz sem ad
\'e1s-v\'e9tel, sem bar\'e1ts\'e1g!
\par 32. Allah az, }{\insrsid3161635\charrsid7817722 aki teremtette az egeket \'e9s a f\'f6ldet, \'e9s vizet bocs\'e1tott le az \'e9gb\'f5l, s az\'e1ltal term\'e9seket hozott el\'f5 ell\'e1t\'e1sul nektek, \'e9s szolg\'e1latotokra rendelte a haj\'f3
kat, hogy a tengeren haladjanak az \'d5 parancsa \'e1ltal, \'e9s a szolg\'e1latotokra rendelte a foly\'f3kat [is].
\par 33. \'c9s szolg\'e1latotokra rendelte a Napot \'e9s a Holdat, amelyek f\'e1radhatatlanul haladnak [a p\'e1ly\'e1jukon], \'e9s szolg\'e1latotokra rendelte az \'e9jszak\'e1t \'e9s a nappalt.
\par 34. \'c9s adott nektek mindenb\'f5l, amit k\'e9rtetek T\'f5le. \'c9s ha megpr\'f3b\'e1ln\'e1tok megsz\'e1molni Allah j\'f3t\'e9tem\'e9ny\'e9t, nem lenn\'e9tek k\'e9pesek megsz\'e1ml\'e1lni azt. Bizony, az ember t\'falzottan igazs\'e1gtalan, megr\'f6gz\'f6
tt h\'e1l\'e1tlan.
\par 
\par 35. \'c9s [eml\'edtsd meg,] amikor \'c1brah\'e1m azt mondta: \'84Uram! Tedd ezt a helys\'e9get (Mekk\'e1t) biztons\'e1goss\'e1, \'e9s tarts t\'e1vol engem \'e9s a gyermekeimet att\'f3l, hogy a b\'e1lv\'e1nyokat szolg\'e1ljuk!
\par 36. Uram! Bizony, azok sokakat t\'e9velyg\'e9sbe vittek az emberek k\'f6z\'fcl. \'c1m aki engem k\'f6vet, az hozz\'e1m tartozik, aki pedig ellenszeg\'fcl nekem [annak az \'fcgye R\'e1d tartozik], bizony, te Megbocs\'e1t\'f3, Irgalmas vagy.}{
\insrsid3161635 
\par 37. Urunk! Bizony [n\'e9melyeket] a lesz\'e1rmazottaim k\'f6z\'fcl egy term\'e9ketlen v\'f6lgyben telep\'edtettem le, a Tilalmas H\'e1zadn\'e1l (a Ka\rquote ba szent\'e9lyn\'e9l Mekk\'e1ban) - Urunk! - hogy megtarts\'e1k az im\'e1dkoz\'e1
st! Add, hogy az emberek egy r\'e9sz\'e9nek a sz\'edve szeretettel hajoljon fel\'e9j\'fck, \'e9s l\'e1sd el \'f5ket term\'e9sekkel, h\'e1tha h\'e1l\'e1sak lesznek!
\par 38. Urunk! Bizony, Te tudod, mi az, amit elrejt\'fcnk \'e9s mi az, amit kinyilv\'e1n\'edtunk. Allah el\'f5tt nem marad semmi rejtve, sem a f\'f6ld\'f6n, sem az \'e9gben.
\par 39. A h\'e1latelt dics\'e9ret Allahot illeti, aki nekem aj\'e1nd\'e9kozta \'f6regkorom ellen\'e9re Izmaelt \'e9s Izs\'e1kot. Bizony, Uram meghallgatja a foh\'e1szt.
\par 40. Uram! Tegy\'e9l olyann\'e1, aki megtartja az im\'e1dkoz\'e1st, \'e9s [n\'e9melyeket] a lesz\'e1rmazottaim k\'f6z\'fcl - Urunk! - \'e9s fogadd el a foh\'e1szomat!
\par 41. Urunk! Bocs\'e1ss meg nekem \'e9s a sz\'fcleimnek \'e9s a h\'edv\'f5knek azon a napon, amikor bek\'f6vetkezik az elsz\'e1moltat\'e1s!\'94
\par 
\par 42. \'c9s ne gondold, hogy Allah figyelmen k\'edv\'fcl hagyja azt, amit tesznek az igazs\'e1gtalanok. \'d5 csup\'e1n halad\'e9kot ad nekik addig a napig, amikor kimerednek a tekintetek.
\par 43. [Megal\'e1zottan] sietnek el\'f5, fej\'fcket felfel\'e9 emelve, pillant\'e1suk nem t\'e9r vissza egym\'e1sra, \'e9s a sz\'edv\'fck \'fcres.
\par 44. \'c9s figyelmeztesd [\'f3 Mohamed] az embereket arra a napra, amikor elj\'f6n hozz\'e1juk a gy\'f6trelem, s azt mondj\'e1k azok, akik igazs\'e1gtalanok: \'84Urunk! Adj nek\'fcnk halad\'e9kot egy k\'f6zeli hat\'e1rid\'f5ig, hogy }{
\insrsid3161635\charrsid8002077 felelj\'fcnk a h\'edv\'e1sodra \'e9s k\'f6vess\'fck a k\'fcld\'f6tteket!\'94 H\'e1t vajon nem esk\'fcdtetek meg kor\'e1bban, hogy nem lesz elm\'fal\'e1s sz\'e1motokra?
\par 45. Azoknak a lakhelyein laktatok, akik igazs\'e1gtalans\'e1got k\'f6vettek el maguk ellen, \'e9s nyilv\'e1nval\'f3v\'e1 v\'e1lt sz\'e1motokra az, ahogyan cselekedt\'fcnk vel\'fck, \'e9s p\'e9ld\'e1zatokat adtunk nektek.
\par 46. \'c9s sz\'f5tt\'e9k [gonosz] terveiket, \'e1m a cselsz\'f6v\'e9s\'fck Allahn\'e1l van (tud r\'f3la), [akkor is] ha a cselsz\'f6v\'e9s\'fck [el\'e9g lenne ahhoz, hogy] elm\'faljanak att\'f3l a hegyek.
\par 
\par 47. Ne gondold h\'e1t, hogy Allah megszegi az \'edg\'e9ret\'e9t, amit a k\'fcld\'f6tteinek tett! Bizony, Allah M\'e9lt\'f3s\'e1gteljes, az el\'e9gt\'e9tel Birtokosa.
\par 48. Azon a napon, amikor a f\'f6ld m\'e1sik f\'f6ldd\'e9 cser\'e9l\'f5dik, \'e9s az egek is, \'e9s az Egy \'e9s Legy\'f5zhetetlen Allah el\'e9 j\'e1ruljanak.
\par 49. \'c9s l\'e1tod majd a gonosztev\'f5ket azon a napon, bilincsekben egym\'e1shoz k\'f6t\'f6zve.
\par 50. Az ing\'fck szurokb\'f3l lesz \'e9s a [Pokol-]t\'fbz bor\'edtja be az arcukat.
\par 51. Hogy Allah megadja minden embernek a fizets\'e9get az\'e9rt, amire szert tett. Bizony, Allah gyors a sz\'e1monk\'e9r\'e9sben.
\par 52. Ez [a Kor\'e1n] \'fczenet az emberek sz\'e1m\'e1ra, \'e9s hogy figyelmeztetve legyenek \'e1ltala, \'e9s hogy megtudj\'e1k, csup\'e1n \'d5 az egy Isten, \'e9s hogy okuljanak [az int\'e9sb\'f5l] az \'e9sszel b\'edr\'f3k!}{\insrsid3161635 
\par }\pard \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid3161635 {\b\insrsid7550020 \page }{\b\insrsid16543947\charrsid16543947 15.}{\b\insrsid3161635\charrsid16543947  A szikl\'e1s v\'f6
lgy (al-Hidzsr) c. sz\'fara
\par }\pard \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635 
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid16543947 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid3161635 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid3161635 
\par 1. Alif-l\'e1m-ra. }{\insrsid3161635\charrsid15497108 Ezek az \'cdr\'e1s}{\insrsid3161635  }{\insrsid3161635\charrsid15497108 jelei (id\'e9zetei)}{\insrsid3161635 , egy }{\insrsid3161635\charrsid15497108 nyilv\'e1nval\'f3 Kor\'e1n}{\insrsid3161635 \'e9}{
\insrsid3161635\charrsid15497108  }{\insrsid3161635 
\par 2. Akik hitetlenn\'e9 v\'e1ltak, gyakran fogj\'e1k azt k\'edv\'e1nni, hogy [b\'e1rcsak] olyanok lettek volna, akik al\'e1vetik magukat [Allahnak].
\par 3. Hagyd \'f5ket, hadd egyenek \'e9s \'e9lvezz\'e9k [az evil\'e1gi \'e9let muland\'f3 \'f6r\'f6meit] \'e9s hadd vonja el a figyelm\'fcket a [hamis] rem\'e9ny. Majd meg fogj\'e1k tudni.
\par 4. \'c9s egyetlen telep\'fcl\'e9st sem puszt\'edtottunk el, csak \'fagy, hogy annak megszabott \'edr\'e1sa (hat\'e1rideje) volt.
\par 5. Egyetlen k\'f6z\'f6ss\'e9g sem hozhatja el\'f5re [pusztul\'e1s\'e1nak] hat\'e1ridej\'e9t, se nem k\'e9sleltetheti.
\par 6. \'c9s azt mondt\'e1k: \'84\'d3 te, akinek lebocs\'e1ttatott az Eml\'e9keztet\'e9s (a Kor\'e1n)! Bizony, te \'f5r\'fclt vagy!
\par 7. H\'e1t mi\'e9rt nem hozod el nek\'fcnk az angyalokat, ha }{\insrsid3161635\charrsid6031682 val\'f3ban}{\insrsid3161635  az igazmond\'f3k k\'f6z\'fcl val\'f3 vagy?\'94
\par 8. Nem bocs\'e1tjuk le az angyalokat, csak az igazs\'e1ggal [megegyez\'f5 b\'fcntet\'e9ssel], \'e1m akkor [m\'e1r] nem lesznek azok k\'f6z\'f6tt, akik halad\'e9kot kapnak.
\par 9. Bizony, mi bocs\'e1tottuk le az Eml\'e9keztet\'e9st (a Kor\'e1nt), \'e9s bizony, mi vagyunk annak \'d5rz\'f5i.
\par 
\par 10. \'c9s bizony el\'f5tted is k\'fcldt\'fcnk m\'e1r el [k\'fcld\'f6tteket] a hajdanvoltak p\'e1rtjai k\'f6z\'e9.
\par 11. \'c9s nem j\'f6tt el hozz\'e1juk egyetlen k\'fcld\'f6tt sem an\'e9lk\'fcl, hogy ne \'fbztek volna g\'fanyt bel\'f5le.
\par 12. Ekk\'e9ppen engedj\'fck bel\'e9pni [a hitetlens\'e9get] a gonosztev\'f5k sz\'edv\'e9be.
\par 13. Nem hisznek abban (a Kor\'e1nban), pedig [figyelmeztet\'e9s\'fcl vehetn\'e9k azt, ami] t\'f6rv\'e9nyszer\'fbs\'e9g m\'e1r v\'e9gbement a hajdanvoltak [eset\'e9ben].
\par 14. \'c9s ha kaput nyitn\'e1nk is felett\'fck az \'e9gen, \'e9s azon folyamatosan felemelkedhetn\'e9nek,
\par 15. Azt mondan\'e1k: \'84Csup\'e1n zavaros lett a l\'e1t\'e1sunk! S\'f5t, var\'e1zslattal s\'fajtott n\'e9p vagyunk.\'94
\par 
\par 16. Bizony, az \'e9gen tornyokat (hatalmas csillagokat) helyezt\'fcnk el, \'e9s d\'edszess\'e9 tett\'fck azt a szeml\'e9l\'f5k sz\'e1m\'e1ra.
\par 17. \'c9s meg\'f5rizt\'fck azt minden kitasz\'edtott s\'e1t\'e1nt\'f3l.
\par 18. Kiv\'e9ve azt, aki lopva hallgat\'f3zik, azt nyilv\'e1nval\'f3 \'fcst\'f6k\'f6s k\'f6veti.
\par 19. \'c9s a f\'f6ldet kiter\'edtett\'fck, \'e9s szil\'e1rdan r\'f6gz\'edtetteket (hegyeket) vetett\'fcnk bele, \'e9s mindenf\'e9le dolgot sarjasztottunk abban, megfelel\'f5 m\'e9rt\'e9kben.
\par 20. \'c9s a }{\insrsid3161635\charrsid8002077 meg\'e9lhet\'e9s eszk\'f6zeit helyezt\'fck el nektek benne \'e9s [hasznotokra teremtett\'fck] azokat, akiknek nem ti vagytok az ell\'e1t\'f3i.
\par 21. Nincs olyan dolog, amelynek ne lenne N\'e1lunk a t\'e1rh\'e1za! \'c9s nem bocs\'e1tjuk le azt, csak megszabott m\'e9rt\'e9kben.}{\insrsid3161635 
\par 22. \'c9s elk\'fcldt\'fck a szeleket term\'e9keny\'edt\'f5kk\'e9nt (es\'f5felh\'f5ket hoz\'f3kk\'e9nt), \'e9s az \'e9gb\'f5l vizet bocs\'e1tottunk le, \'e9s itattunk titeket azzal, \'e9s ti nem vagytok annak t\'e1rol\'f3i.
\par 23. \'c9s bizony, mi kelt\'fcnk \'e9letre \'e9s mi k\'fcld\'fcnk hal\'e1lba, \'e9s Mi vagyunk az \'f6r\'f6kl\'f5k.
\par 24. \'c9s bizony, ismerj\'fck az el\'f5re men\'f5ket k\'f6z\'fcletek (az elt\'e1vozottakat), \'e9s bizony ismerj\'fck a h\'e1tramarad\'f3kat.
\par }{\insrsid3161635\charrsid8002077 25. \'c9s bizony, Urad az, aki egybegy\'fbjti \'f5ket. Bizony, \'d5 B\'f6lcs, Mindentud\'f3.
\par 
\par 26. \'c9s bizony megfeketedett s\'e1rb\'f3l form\'e1lt sz\'e1raz agyagb\'f3l teremtett\'fck az embert.
\par 27. \'c9s a dzsinneket azel\'f5tt teremtett\'fck meg a perzsel\'f5 t\'fbz [f\'fcsttelen] l\'e1ngj\'e1b\'f3l.
\par 28. \'c9s [eml\'edtsd meg,] amikor az Urad azt mondta az angyaloknak: \'84Bizony, megfeketedett s\'e1rb\'f3l form\'e1lt sz\'e1raz agyagb\'f3l fogok embert teremteni,
\par 29. \'c9s ha megform\'e1ltam, \'e9s belef\'fajtam [az \'e1ltalam teremtett] l\'e9lekb\'f5l, akkor vess\'e9tek le magatokat el\'f5tte leborulva!\'94
\par 30. S az angyalok mind leborultak, valamennyien.
\par 31. Kiv\'e9ve Ibl\'edszt, aki visszautas\'edtotta azt, hogy a leborul\'f3kkal legyen.
\par 32. Azt mondta [Allah]: \'84\'d3 Ibl\'edsz! Mi lelt t\'e9ged, hogy nem vagy a leborul\'f3k k\'f6z\'f6tt?\'94
\par 33. Azt mondta [Ibl\'edsz]: \'84Nem val\'f3 hozz\'e1m, hogy leboruljak egy ember el\'f5tt, akit Te teremtett\'e9l megfeketedett s\'e1rb\'f3l form\'e1lt sz\'e1raz agyagb\'f3l.\'94
\par 34. Azt mondta [Allah]: \'84Menj h\'e1t ki innen! Bizony, kitasz\'edtott vagy!
\par 35. \'c9s bizony, az \'e1tok rajtad lesz az \'cdt\'e9let Napj\'e1ig!\'94
\par 36. Azt mondta [Ibl\'edsz]: \'84Uram adj nekem halad\'e9kot, addig a napig, amikor felt\'e1masztatnak [a halottak]!\'94
\par 37. Azt mondta [Allah]: \'84Bizony, azok k\'f6z\'e9 tartozol, akik halad\'e9kot kapnak,
\par 38. A megszabott id\'f5 napj\'e1ig.\'94
\par 39. Azt mondta [Ibl\'edsz]: \'84Uram! Ami\'e9rt t\'e9v\'fatra vitt\'e9l engem, d\'edszess\'e9 teszem sz\'e1mukra [a rossz tetteket] a f\'f6ld\'f6n, \'e9s mindannyiukat t\'e9v\'fatra vezetem,
\par 40. Kiv\'e9ve a Te kiv\'e1lasztott (\'f5szinte hit\'fb) szolg\'e1idat k\'f6z\'fcl\'fck!\'94
\par 41. Azt mondta [Allah]: \'84Ez egy Egyenes \'fat, amely Hozz\'e1m [vezet].
\par 42. Bizony, az \'c9n szolg\'e1im felett nincs neked hatalmad, kiv\'e9ve azokat, akik k\'f6vetnek t\'e9ged azok k\'f6z\'fcl, akik t\'e9v\'fatra ker\'fcltek.
\par 43. \'c9s bizony a Gyehenna lesz a meg\'edg\'e9rt helye mindannyiuknak.\'94
\par 44. H\'e9t kapuja van annak, mindegyik kapu sz\'e1m\'e1ra lesz k\'f6z\'fcl\'fck (a b\'fbn\'f6s\'f6k k\'f6z\'fcl) egy elk\'fcl\'f6n\'edtett r\'e9sz.
\par 
\par 45. Bizony, az istenf\'e9l\'f5k kertekben \'e9s forr\'e1sokn\'e1l lesznek [a Paradicsomban].
\par 46. [Az lesz mondva nekik:] \'84L\'e9pjetek be oda b\'e9kess\'e9ggel, biztons\'e1gban!\'94
\par 47. \'c9s kiragadjuk azt, ami a kebl\'fckben volt [az evil\'e1gi] gy\'fbl\'f6letb\'f5l, testv\'e9rekk\'e9nt, kereveteken [\'fclnek] egym\'e1ssal szemben.
\par 48. Nem \'e9ri ott \'f5ket kimer\'fclts\'e9g, \'e9s nem lesznek onnan ki\'fbzve.
\par 49. Add h\'edr\'fcl [\'f3 Mohamed] a szolg\'e1imnak, hogy bizony, \'e9n vagyok a Megbocs\'e1t\'f3, az Irgalmas!
\par 50. \'c9s hogy a gy\'f6trelmem [amivel les\'fajtok,] az a f\'e1jdalmas gy\'f6trelem.
\par 
\par 51. \'c9s adj h\'edrt nekik \'c1brah\'e1m vend\'e9geir\'f5l!
\par 52. [Eml\'edtsd meg,] amikor bel\'e9ptek hozz\'e1, s azt mondt\'e1k: \'84B\'e9kess\'e9g!\'94, azt mondta [\'c1brah\'e1m]: \'84Bizony, mi f\'e9l\'fcnk t\'f5letek.\'94
\par 53. Azt mondt\'e1k [az angyalok]: \'84Ne f\'e9lj! Bizony, \'f6r\'f6mh\'edrt adunk neked egy nagy tud\'e1s\'fa ifj\'far\'f3l!\'94
\par 54. Azt mondta: \'84\'d6r\'f6mh\'edrt adtok-e nekem [egy fi\'fagyermekr\'f5l], holott utol\'e9rt engem az \'f6regkor? H\'e1t mir\'f5l adtok \'f6r\'f6mh\'edrt?\'94
\par 55. Azt mondt\'e1k: \'84Az igazs\'e1ggal [megegyez\'f5en] adtunk neked \'f6r\'f6mh\'edrt. Ne tartozz h\'e1t a cs\'fcgged\'f5k k\'f6z\'e9!\'94
\par 56. Azt mondta: \'84\'c9s ki cs\'fcggedne el Ura k\'f6ny\'f6r\'fclete fel\'f5l, ha csak nem a t\'e9velyg\'f5k?\'94
\par 57. [Ezut\'e1n] azt mondta: \'84H\'e1t milyen s\'falyos \'fcgyben [vagytok itt], \'f3 ti k\'fcld\'f6ttek?\'94
\par 58. Azt mondt\'e1k: \'84Bizony, egy gonosztev\'f5 n\'e9phez k\'fcldett\'fcnk el,
\par 59. Kiv\'e9ve L\'f3t csal\'e1dj\'e1t. Mi meg fogjuk \'f5ket menteni [a pusztul\'e1st\'f3l], mindannyiukat,
\par 60. Kiv\'e9ve a feles\'e9g\'e9t.\'94 [\'dagy] rendelt\'fck el, hogy azok k\'f6z\'fcl val\'f3 lesz, akik h\'e1tramaradnak.
\par 
\par 61. \'c9s miut\'e1n elj\'f6ttek L\'f3t csal\'e1dj\'e1hoz a k\'fcld\'f6ttek,
\par 62. Azt mondta [L\'f3t]: \'84Bizony, ti ismeretlen emberek vagytok.\'94
\par 63. Azt mondt\'e1k: \'84Dehogy! Mi azt hoztuk el neked, amiben \'f5k k\'e9telkedtek.
\par 64. \'c9s mi az Igazs\'e1got hoztuk el neked, }{\insrsid3161635\charrsid13980179 bizony, mi igazmond\'f3k vagyunk.
\par 65. Indulj h\'e1t \'fatra \'e9jszaka a csal\'e1doddal az \'e9jjel egy r\'e9sze alatt, \'e9s k\'f6vesd a nyomukat, \'e9s senki meg ne forduljon k\'f6z\'fcletek! \'c9s oda menjetek, ahov\'e1 parancsot kaptatok!\'94
\par 66. \'c9s elrendelt\'fck (sugalltuk) neki azt a parancsot, hogy azok (a b\'fbn\'f6s\'f6k) utols\'f3 marad\'e9ka ki lesz irtva reggelre kelve.
\par 67. \'c9s [a vend\'e9gek \'e9rkez\'e9s\'e9nek h\'edr\'e9re] elj\'f6ttek a v\'e1ros lak\'f3i, \'f6rvendezve [a h\'edrnek].
\par 68. Azt mondta [L\'f3t]: \'84Bizony, ezek az \'e9n vend\'e9geim, ne gyal\'e1zzatok h\'e1t meg!
\par 69. \'c9s f\'e9lj\'e9tek Allahot, \'e9s ne sz\'e9gyen\'edtsetek meg!\'94
\par 70. Azt mondt\'e1k: \'84H\'e1t vajon nem tiltottunk-e el a teremtm\'e9nyekt\'f5l (az emberek befogad\'e1s\'e1t\'f3l)?\'94
\par 71. Azt mondta [L\'f3t]: \'84Ezek a l\'e1nyaim (a n\'f5k a k\'f6z\'f6ss\'e9gb\'f5l) [vel\'fck h\'e1zasodjatok], ha val\'f3ban megteszitek [akkor az jobb nektek]!\'94
\par 72. [Esk\'fcsz\'f6m] az \'e9letedre [\'f3 Mohamed]! Bizony, \'f5k r\'e9szegs\'e9g\'fckben vakon bolyongnak.
\par 73. \'c9s elragadta \'f5ket a ki\'e1lt\'e1s napkeltekor.
\par 74. Feje tetej\'e9re \'e1ll\'edtottuk (elpuszt\'edtottuk) [a v\'e1rost], \'e9s \'e9getett agyagb\'f3l val\'f3 k\'f6veket z\'fad\'edtottunk r\'e1juk.
\par 75. Bizony, ebben jelek vannak a [tanuls\'e1gokat] kik\'f6vetkeztet\'f5knek.
\par 76. \'c9s bizony, ez [a v\'e1ros] egy fenn\'e1ll\'f3 \'faton van [amelyen haladnak a karav\'e1nok].
\par 77. Bizony, ebben jel van a h\'edv\'f5k sz\'e1m\'e1ra!}{\insrsid3161635 
\par 
\par 78. \'c9s bizony, a cserj\'e9s [erd\'f5] lak\'f3i igazs\'e1gtalanok voltak.
\par 79. El\'e9gt\'e9telt vett\'fcnk h\'e1t rajtuk, \'e9s bizony, mindkett\'f5 [telep\'fcl\'e9s] nyilv\'e1nval\'f3 \'faton van [amelyet k\'f6vetnek az utaz\'f3k].
\par 
\par 80. \'c9s bizony, a szikl\'e1s v\'f6lgy lak\'f3i meghazudtolt\'e1k a k\'fcld\'f6tteket.
\par 81. \'c9s elhoztuk nekik a jeleinket, \'e1m \'f5k elfordultak azokt\'f3l.
\par 82. \'c9s a hegyekb\'f5l h\'e1zakat faragtak ki, biztons\'e1gban [\'e9rezve magukat].
\par 83. \'c9s elragadta \'f5ket a ki\'e1lt\'e1s reggelre kelve.
\par 84. \'c9s nem v\'e1lt a hasznukra az, amire szert tettek.
\par 
\par }{\insrsid3161635\charrsid13980179 85. \'c9s nem teremtett\'fck meg az egeket \'e9s a f\'f6ldet, \'e9s mindazt, ami k\'f6z\'f6tt\'fck van, csakis az igazs\'e1ggal (c\'e9llal). \'c9s bizony, az \'d3ra el fog j\'f6nni. Legy\'e9l h\'e1t eln\'e9z\'f5, sz\'e9
p eln\'e9z\'e9ssel!
\par 86. Bizony, Urad az, aki [mindenek] Teremt\'f5je, a Mindentud\'f3.
\par 
\par 87. \'c9s bizony, neked adtuk a h\'e9t ism\'e9telten [recit\'e1lt \'e1j\'e1t] \'e9s a Hatalmas Kor\'e1nt.
\par 88. Ne mereszd a szemed [s\'f3v\'e1rogva] arra, amit \'e9lvezet\'fcl adtunk egyes csoportoknak k\'f6z\'fcl\'fck, \'e9s ne l\'e9gy szomor\'fa [a hitetlens\'e9g\'fck] miatt! \'c9s ereszd le [v\'e9d\'f5}{\insrsid3161635 -}{\insrsid3161635\charrsid13980179 
]sz\'e1rnyaidat a h\'edv\'f5kre!
\par 89. \'c9s mondd [\'f3 Mohamed]: \'84Bizony, \'e9n vagyok a nyilv\'e1nval\'f3 figyelmeztet\'f5!\'94}{\insrsid3161635 
\par 
\par 90. [Figyelmeztet\'fcnk titeket a b\'fcntet\'e9sre] ahogyan lebocs\'e1tottunk [azt] a sz\'e9toszt\'f3kra,
\par 91. Akik a Kor\'e1nt tagoltt\'e1 tett\'e9k (az egyik r\'e9sz\'e9ben hittek, a m\'e1sikat pedig tagadt\'e1k).
\par 92. \'c9s [esk\'fcsz\'f6m] Uradra! Bizony, meg fogjuk k\'e9rdezni \'f5ket, mindannyiukat!
\par 93. Arr\'f3l, amit cselekedtek.
\par 94. Hirdesd h\'e1t ki azt, amire parancsot kapt\'e1l, \'e9s fordulj el az [Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3kt\'f3l!
\par 95. Bizony, Mi elegend\'f5ek vagyunk sz\'e1modra a g\'fanyol\'f3d\'f3kkal szemben,
\par 96. Akik Allah mell\'e9 m\'e1s istent tesznek meg [t\'e1rsistennek]. H\'e1t meg fogj\'e1k tudni!
\par 97. \'c9s bizony, Mi tudjuk, hogy a kebled \'f6sszeszorul amiatt, amit mondanak.
\par 98. Magasztald h\'e1t Urad az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, s tartozz a leborul\'f3k k\'f6z\'e9!
\par 99. \'c9s szolg\'e1ld Urad, am\'edg el nem j\'f6n hozz\'e1d a bizonyoss\'e1g (a hal\'e1l)!
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid16543947 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\f0\fs24\insrsid3161635\charrsid16543947 \page 16.}{\f0\fs24\insrsid16543947  }{\f0\fs24\insrsid3161635\charrsid16543947 A m\'e9hek (an-Nahl) c. sz\'fara
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid3161635 
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid16543947 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid3161635 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid3161635 
\par 1. El\'e9rkezett Allah parancsa, ne siettess\'e9tek h\'e1t azt! Magasztaltass\'e9k \'d5! \'c9s [\'d5] afelett van, amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [\'d5mell\'e9].
\par 2. Lebocs\'e1tja az angyalokat a l\'e9lekkel (a kinyilatkoztat\'e1ssal) az \'d5 parancs\'e1b\'f3l arra, akire akarja az \'d5 szolg\'e1i k\'f6z\'fcl, [mondv\'e1n] hogy: \'84Figyelmeztess\'e9tek az embereket arra, hogy nincs m\'e1s [jogosan im\'e1dhat\'f3
] isten csak \'c9n! H\'e1t engem f\'e9ljetek!\'94
\par 3. Megteremtette az egeket \'e9s a f\'f6ldet az igazs\'e1ggal (c\'e9llal). [\'d5] afelett van, amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [\'d5mell\'e9].
\par 4. Megteremtette az embert egy cseppb\'f5l (megterm\'e9keny\'fclt ivarsejtb\'f5l), \'e9s \'edme, \'f5 [m\'e9gis] nyilv\'e1nval\'f3 vit\'e1z\'f3.
\par 5. \'c9s a j\'f3sz\'e1gokat is megteremtette, azokb\'f3l sz\'e1motokra meleged\'e9s \'e9s haszon van, \'e9s azokb\'f3l esztek.
\par 6. \'c9s sz\'e9ps\'e9g van azokban nektek, amikor este hazahajtj\'e1tok, \'e9s amikor reggel kihajtj\'e1tok [legelni \'f5ket].
\par 7. \'c9s hordozz\'e1k a terheiteket olyan helys\'e9g fel\'e9, amelyet nem \'e9rhetn\'e9tek el, csak nagy f\'e1rads\'e1ggal. Bizony, Uratok Egy\'fctt\'e9rz\'f5, Irgalmas.
\par 8. [\'c9s teremtette] a lovakat, az \'f6szv\'e9reket \'e9s a szamarakat, hogy utazzanak rajtuk \'e9s d\'edsz\'fcl sz\'e1motokra, \'e9s olyan dolgokat is teremt, amikr\'f5l ti nem tudtok.
\par 9. \'c9s Allahra tartozik az egyenes \'fat [kijel\'f6l\'e9se], \'e9s vannak elhajl\'f3 [utak]. \'c9s ha akarta volna, mindannyi\'f3tokat [igaz \'fatra] vezetett volna.
\par 
\par 10. \'d5 az, aki vizet bocs\'e1t le az \'e9gb\'f5l, abb\'f3l nektek ital [sz\'e1rmazik], \'e9s [sarjad] \'e1ltala n\'f6v\'e9nyzet, amelyben [a j\'f3sz\'e1gaitokat] legeltetitek.
\par 11. Sarjasztja \'e1ltala nektek a gabon\'e1kat, az olajf\'e1kat, a datolyap\'e1lm\'e1kat, \'e9s a sz\'f5l\'f5t\'f5k\'e9ket, \'e9s [sarjaszt] mindenf\'e9le term\'e9st. Bizony, ebben jel van egy olyan n\'e9p sz\'e1m\'e1ra, akik elgondolkodnak.
\par 12. \'c9s szolg\'e1latotokra rendelte az \'e9jszak\'e1t \'e9s a nappalt, a Napot \'e9s a Holdat \'e9s a csillagokat, amelyek az \'d5 parancsa \'e1ltal vannak szolg\'e1latra rendelve. Bizony, ebben jelek vannak egy olyan n\'e9p sz\'e1m\'e1ra, akik \'e9
lnek az esz\'fckkel.
\par 13. \'c9s [szolg\'e1latotokra lett rendelve] mindaz, amit a f\'f6ld\'f6n sz\'e9tsz\'f3rt nektek k\'fcl\'f6nb\'f6z\'f5 sz\'ednekben. Bizony ebben jelek vannak egy olyan n\'e9p sz\'e1m\'e1ra, akik okulnak [az int\'e9sb\'f5l].
\par 
\par 14. \'c9s \'d5 az, aki szolg\'e1latra rendelte a tengert, hogy friss h\'fast egyetek abb\'f3l, \'e9s hogy \'e9kszereket hozzatok fel bel\'f5le, melyeket magatokra \'f6lt\'f6t\'f6k. \'c9s l\'e1thatod a haj\'f3kat, amint \'e1tszelik azt [utasokat sz\'e1ll
\'edtva], \'e9s hogy az \'d5 kegy\'e9t keress\'e9tek [az \'e1rusz\'e1ll\'edt\'e1ssal], \'e9s h\'e1tha h\'e1l\'e1sak lesztek.
\par 
\par 15. \'c9s szil\'e1rdan r\'f6gz\'edtetteket (hegyeket) vetett a f\'f6ldbe \endash  hogy [ne] r\'e1zk\'f3djon veletek \endash  \'e9s foly\'f3kat \'e9s utakat. H\'e1tha igaz \'fatra leltek.
\par 16. \'c9s [\'fatba igaz\'edt\'f3] jeleket, \'e9s a csillagok \'e1ltal \'f5k helyes \'fatra lelnek.
\par 17. H\'e1t vajon, aki teremt, olyan lenne, mint aki nem teremt? H\'e1t vajon nem okultok [az int\'e9sb\'f5l]?
\par 18. \'c9s ha megpr\'f3b\'e1ln\'e1tok megsz\'e1molni Allah j\'f3t\'e9tem\'e9ny\'e9t, nem lenn\'e9tek k\'e9pesek megsz\'e1ml\'e1lni azt. Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 
\par 19. \'c9s Allah tudja azt, amit elrejtetek \'e9s azt [is] amit kinyilv\'e1n\'edtotok.
\par 20. \'c9s akikhez Allah helyett foh\'e1szkodnak, azok nem teremtenek semmit, \'e9s \'f5k maguk is teremtve lettek.
\par }{\insrsid3161635\charrsid13980179 21. Halottak \'f5k, nem \'e9l\'f5k. \'c9s \'e9szre sem veszik, hogy mikor t\'e1masztatnak fel.
\par 22. A ti istenetek egy Isten! \'c9s akik nem hisznek a t\'falvil\'e1gban, azoknak a sz\'edve tagadja [a felt\'e1mad\'e1st], mik\'f6zben \'f5k fennh\'e9j\'e1z\'f3k.
\par 23. Nem k\'e9ts\'e9ges, hogy Allah tudja azt, amit eltitkolnak \'e9s azt [is], amit kinyilv\'e1n\'edtanak. Bizony, \'d5 nem szereti a fennh\'e9j\'e1z\'f3kat.
\par 
\par 24. \'c9s ha az mondatik nekik: \'84Mit bocs\'e1tott le az Uratok?\'94 Azt mondj\'e1k: \'93[Ezek] a hajdanvoltak legend\'e1i\'94,
\par 25. Hogy azt\'e1n hordozz\'e1k a terheiket (b\'fbneiket) teljes eg\'e9sz\'e9ben a Felt\'e1mad\'e1s Napj\'e1n, \'e9s azok terh\'e9nek egy r\'e9sz\'e9t is, akiket tud\'e1s n\'e9lk\'fcl visznek t\'e9velyg\'e9sbe. L\'e1m, mily rossz az, amit teherk\'e9
nt hordoznak!
\par 26. M\'e1r [gonosz] tervet sz\'f5ttek azok [is], akik el\'f5tt\'fck \'e9ltek, \'e1m elj\'f6tt Allah [puszt\'edt\'e1sa] az \'e9p\'edtm\'e9ny\'fckre az alapok fel\'f5l, \'e9s a tet\'f5 f\'f6l\'f6tt\'fck r\'e1juk roskadt, \'e9s onnan j\'f6tt el hozz\'e1
juk a gy\'f6trelem, ahonnan \'e9szre sem vett\'e9k [az elj\'f6vetel\'e9t].
\par 27. Majd a Felt\'e1mad\'e1s napj\'e1n [Allah] megsz\'e9gyen\'edti \'f5ket \'e9s azt mondja [nekik]: \'84Hol vannak azok, akiket \'c9n mell\'e9m t\'e1rsistenk\'e9nt \'e1ll\'edtottatok, akik miatt szembeszeg\'fcltetek [Velem]?\'94 Azok, akiknek a tud\'e1
s adatott, azt mondj\'e1k: \'84Bizony, ma a sz\'e9gyen \'e9s a rossz [s\'fajt le] a hitetlenekre.\'94
\par 28. Akiket elsz\'f3l\'edtanak [a hal\'e1l] angyalai, mik\'f6zben magukkal szemben igazs\'e1gtalanok voltak, azok akkor teljes megad\'e1st mutatnak [mondv\'e1n:] \'84Nem cselekedt\'fcnk semmi rosszat!\'94 [Az lesz nekik mondva:] \'84
Dehogynem! Bizony, Allahnak tudom\'e1sa van arr\'f3l, amit cselekedtetek.
\par 29. L\'e9pjetek h\'e1t be a Gyehenna kapuin, \'f6r\'f6kk\'e9 abban fogtok maradni! Milyen nyomor\'fas\'e1gos a fennh\'e9j\'e1z\'f3k otthona!\'94
\par 
\par 30. \'c9s az mondatik azoknak, akik istenf\'e9l\'f5k voltak: \'84Mit bocs\'e1tott le az Uratok?\'94 Azt mondj\'e1k: \'84J\'f3t!\'94 Akik j\'f3tev\'f5en cselekedtek, azoknak az evil\'e1gon j\'f3 j\'e1r. \'c1m a t\'falvil\'e1gi lakhely jobb! \'c9
s milyen kit\'fbn\'f5 az istenf\'e9l\'f5k lakhelye!
\par 31. \'d6r\'f6kk\'e9 tart\'f3 kertekbe l\'e9phetnek majd be [a Paradicsomban], amelyek al\'f3l foly\'f3k folynak. Abban sz\'e1mukra az lesz, amit csak akarnak. Allah ekk\'e9ppen adja meg a fizets\'e9g\'e9t az istenf\'e9l\'f5knek.
\par 32. Akiket elsz\'f3l\'edtanak [a hal\'e1l] angyalai, mik\'f6zben j\'f3k voltak, azoknak azt mondj\'e1k [az angyalok]: \'84B\'e9kess\'e9g re\'e1tok! L\'e9pjetek be a Paradicsomba az\'e9rt, amit cselekedtetek!\'94
\par 
\par 33. Vajon v\'e1rnak-e m\'e1sra, mint hogy elj\'f6jjenek hozz\'e1juk [a hal\'e1l] angyalai, vagy hogy elj\'f6jj\'f6n az Urad parancsa? Ekk\'e9ppen tettek azok is, akik el\'f5tt\'fck \'e9ltek. \'c1m Allah nem k\'f6vetett el igazs\'e1gtalans\'e1got vel\'fc
k szemben, hanem \'f5k voltak saj\'e1t magukkal szemben igazs\'e1gtalanok.
\par 34. \'c9s les\'fajtott r\'e1juk azon rossz tettek [fizets\'e9ge], amit cselekedtek, \'e9s k\'f6rbeker\'edtette \'f5ket az [a b\'fcntet\'e9s], amib\'f5l g\'fanyt \'fbztek.
\par 
\par 35. \'c9s azok, akik t\'e1rsistent \'e1ll\'edtottak [Allah] mell\'e9, azt mondt\'e1k: \'84Ha Allah \'fagy akarta volna, akkor nem szolg\'e1ltunk volna Rajta k\'edv\'fcl semmit, }{\insrsid3161635\charrsid12727531 sem mi, sem aty\'e1ink, \'e9
s semmit sem tett\'fcnk volna tilalmasnak [az \'d5 parancsa] n\'e9lk\'fcl.\'94 Ekk\'e9ppen tettek azok [is], akik el\'f5tt\'fck \'e9ltek. \'c9s vajon tartozik-e m\'e1s a k\'fcld\'f6ttekre, mint a vil\'e1gos [\'fczenet-]\'e1tad\'e1s?
\par 36. \'c9s bizony minden k\'f6z\'f6ss\'e9gben t\'e1masztottunk k\'fcld\'f6ttet [aki azt hirdette]: \'84Szolg\'e1lj\'e1tok Allahot \'e9s ker\'fclj\'e9tek el a hamisan isten\'edtetteket!\'94 \'c9s volt k\'f6z\'f6tt\'fck olyan [k\'f6z\'f6ss\'e9
g], akit Allah [az igaz \'fatra] vezetett, \'e9s volt k\'f6z\'f6tt\'fck olyan [k\'f6z\'f6ss\'e9g], akire n\'e9zve jogoss\'e1 v\'e1lt a t\'e9velyg\'e9s. J\'e1rj\'e1tok h\'e1t be a f\'f6ldet, \'e9s n\'e9zz\'e9tek meg, milyen v\'e9
gre jutottak azok, akik meghazudtolt\'e1k [a k\'fcld\'f6tteket]!
\par 37. Ha b\'e1rmennyire is \'fcgyelsz az \'f5 [igaz \'fatra] vezet\'e9s\'fckre, Allah nem vezeti [igaz \'fatra] azt, akit t\'e9velyg\'e9sbe vitt, \'e9s nem lesz, aki gy\'f5zelemre vinn\'e9 \'f5ket.
\par 38. Allahra esk\'fcdtek meg a leger\'f5teljesebb esk\'fcikkel, hogy Allah nem t\'e1masztja fel azt, aki meghalt. Dehogynem, [ez] T\'f5le val\'f3 igaz \'edg\'e9ret! \'c1m a legt\'f6bb ember [ezt] nem tudja.
\par 39. [Felt\'e1masztja \'f5ket] az\'e9rt, hogy nyilv\'e1nval\'f3v\'e1 tegye sz\'e1mukra azt, amiben \'f6sszek\'fcl\'f6nb\'f6ztek, s hogy megtudhass\'e1k azok, akik hitetlenn\'e9 v\'e1ltak, hogy hazugok voltak.
\par 40. Bizony, a Mi szavunk valamit illet\'f5en \endash  ha akarjuk [hogy legyen] \endash  csup\'e1n az, hogy azt mondjuk annak: \'84Legy\'e9l!\'94, \'e9s az van.
\par 
\par 41. \'c9s akik elv\'e9gezt\'e9k Allah\'e9rt a kiv\'e1ndorl\'e1st, azut\'e1n, hogy igazs\'e1gtalans\'e1got szenvedtek el, azoknak bizony az evil\'e1gon j\'f3 lak\'f3helyet fogunk kijel\'f6lni. \'c1m a T\'falvil\'e1gon nagyobb a jutalom. B\'e1rcsa
k rendelkeztek volna tud\'e1ssal!
\par 42. [\'d5k azok] akik t\'fcrelmesek voltak \'e9s az Urukra hagyatkoznak.
\par 
\par 43. \'c9s nem k\'fcldt\'fcnk el el\'f5tted [\'f3 Mohamed,] csup\'e1n f\'e9rfiakat, akiknek [kinyilatkoztat\'e1st] sugalltunk. K\'e9rdezz\'e9tek h\'e1t meg az Eml\'e9keztet\'e9s (az \'cdr\'e1s) birtokosait, ha nem tudj\'e1tok [azt]!
\par 44. [Elk\'fcldt\'fck \'f5ket] a nyilv\'e1nval\'f3 bizony\'edt\'e9kokkal \'e9s a K\'f6nyvekkel. \'c9s lebocs\'e1tottuk neked az Eml\'e9keztet\'e9st (a Kor\'e1nt) az\'e9rt, hogy nyilv\'e1nval\'f3v\'e1 tedd az embereknek azt, ami lebocs\'e1ttatott nekik, 
\'e9s h\'e1tha elgondolkodnak.
\par 45. Vajon h\'e1t azok, akik gonosz terveket sz\'f5ttek, biztons\'e1gban \'e9rzik magukat azzal szemben, hogy Allah egyszer csak les\'fcllyeszti vel\'fck a f\'f6ldet, vagy hogy onnan j\'f6n el hozz\'e1juk a gy\'f6trelem, ahonnan \'e9szre sem veszik [az elj
\'f6vetel\'e9t]?
\par 46. Vagy megragadja \'f5ket, mik\'f6zben j\'e1rnak-kelnek [\'fcgyeiket int\'e9zve], \'e9s \'f5k nem fogj\'e1k [Allahot] megakad\'e1lyozni [semmiben]?
\par 47. Vagy megragadja \'f5ket, mik\'f6zben [a megragad\'e1sukt\'f3l] f\'e9lnek? \'c1m Uratok bizony Egy\'fctt\'e9rz\'f5, Irgalmas.
\par 48. H\'e1t vajon nem l\'e1tt\'e1k azt, hogy amit Allah teremtett, mindannak az \'e1rny\'e9ka [reggel \'e9s d\'e9lut\'e1n] jobbra \'e9s balra vet\'fcl, leborulva Allah el\'f5tt, mik\'f6zben megal\'e1zkodnak?
\par 49. \'c9s Allahnak borul le mindaz, ami az egekben \'e9s mindaz, ami a f\'f6ld\'f6n van a mozg\'f3 [\'e9l\'f5l\'e9nyek] k\'f6z\'fcl, \'e9s az angyalok, \'e9s \'f5k nem fennh\'e9j\'e1znak.
\par 50. F\'e9lik az Urukat felett\'fck \'e9s azt teszik, amire parancsot kapnak.
\par 
\par 51. Allah azt mondta: \'84Ne vegyetek magatoknak k\'e9t istent! Bizony \'d5 csup\'e1n Egy Isten! H\'e1t t\'f5lem rettegjetek!\'94
\par 52. \'c9s az \'d6v\'e9 mindaz, ami az egekben \'e9s [ami] a f\'f6ld\'f6n van, \'e9s \'d5t illeti meg a vall\'e1s (az engedelmess\'e9g) mind\'f6r\'f6kk\'e9. Vajon h\'e1t Allahon k\'edv\'fcl m\'e1st f\'e9ltek?}{\insrsid3161635 
\par 53. \'c9s b\'e1rmi j\'f3t\'e9tem\'e9nyben van r\'e9szetek, az Allaht\'f3l van! Majd ha \'e1rtalom \'e9r titeket, [egyed\'fcl] \'d5hozz\'e1 ki\'e1ltotok seg\'edts\'e9g\'e9rt.
\par 54. Azt\'e1n, amikor elh\'e1r\'edtotta r\'f3latok az \'e1rtalmat, \'edme [akkor] egy csoport k\'f6z\'fcletek t\'e1rsistent \'e1ll\'edt Ura mell\'e9.
\par 55. Az\'e9rt, hogy hitetlenn\'e9 (h\'e1l\'e1tlann\'e1) v\'e1ljanak azzal [a j\'f3t\'e9tem\'e9nnyel] szemben, amit adtunk nekik. \'c9lvezz\'e9tek h\'e1t [az evil\'e1gi \'e9letet], majd meg fogj\'e1tok tudni [hitetlens\'e9getek k\'f6vetkezm\'e9ny\'e9t]!

\par 
\par 56. \'c9s kijel\'f6lnek annak (a hamis isteneiknek), amir\'f5l nem tudnak semmit, egy r\'e9szt abb\'f3l amivel ell\'e1ttuk \'f5ket. Allahra! Bizony meg lesztek k\'e9rdezve arr\'f3l, amit kital\'e1ltatok.
\par 57. \'c9s Allahnak le\'e1nygyermekeket tulajdon\'edtanak - magasztaltass\'e9k! - \'e9s maguknak azt, amire v\'e1gynak (fi\'fagyermekeket).
\par 58. \'c9s amikor }{\insrsid3161635\charrsid7550020 valamelyik\'fcknek le\'e1nygyermek [sz\'fclet\'e9s\'e9r\'f5l] adnak \'f6r\'f6mh\'edrt, az arca els\'f6t\'e9t\'fcl, mik\'f6zben}{\insrsid3161635  leplezi [a b\'e1nat\'e1t].
\par 59. Elrejt\'f5zik a n\'e9pe el\'f5l azon rossz miatt, amir\'f5l \'f6r\'f6mh\'edrt kapott. Vajon megtartsa-e \'f5t [saj\'e1t maga] }{\insrsid3161635\charrsid395740 megal\'e1ztat\'e1s\'e1ra,}{\insrsid3161635  vagy temesse a porba? L\'e1
m, milyen rossz az, ahogyan \'edt\'e9lkeznek!
\par 60. Akik nem hisznek a T\'falvil\'e1gban, azok\'e9 a rossz p\'e9ld\'e1zat (tulajdons\'e1g), \'e9s Allah\'e9 a legmagasztosabb p\'e9ld\'e1zat (tulajdons\'e1g). \'c9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 61. \'c9s ha sz\'e1mon k\'e9rn\'e9 (megb\'fcntetn\'e9) Allah az embereket az igazs\'e1gtalans\'e1guk\'e9rt, akkor nem hagyna rajta (a f\'f6ld\'f6n) egyetlen mozg\'f3 [\'e9l\'f5l\'e9nyt] sem. De \'d5 halad\'e9kot ad nekik egy megszabott hat\'e1rid\'f5
ig. Amikor pedig elj\'f6n a hat\'e1ridej\'fck, nem k\'e9sleltethetik azt egy \'f3r\'e1val sem, se nem hozhatj\'e1k el\'f5re.
\par 62. \'c9s Allahnak olyat tulajdon\'edtanak, amit \'f5k maguk ut\'e1lnak. \'c9s a nyelv\'fck hazugs\'e1got \'edr le [mondv\'e1n], hogy nekik j\'e1r a legjobb (a Paradicsom). Nem k\'e9ts\'e9ges, hogy nekik a [Pokol-]t\'fbz j\'e1r, \'e9
s az, hogy [mindenkit] megel\'f5zve vitetnek oda.
\par 
\par 63. Allahra! Bizony, m\'e1r az el\'f5tted \'e9lt k\'f6z\'f6ss\'e9gekhez is k\'fcldt\'fcnk [k\'fcld\'f6tteket]. \'c1m a s\'e1t\'e1n d\'edszess\'e9 tette sz\'e1mukra a cselekedeteiket, \'edgy \'f5 a p\'e1rtfog\'f3juk ma, \'e9s f\'e1jdalmas gy\'f6trelem j
\'e1r nekik.
\par 64. \'c9s nem bocs\'e1tottuk le neked az \'cdr\'e1st (a Kor\'e1nt) m\'e1s\'e9rt, mint hogy nyilv\'e1nval\'f3v\'e1 tedd nekik azt, amiben \'f6sszek\'fcl\'f6nb\'f6ztek, \'e9s \'fatmutat\'e1sk\'e9nt \'e9s k\'f6ny\'f6r\'fcletk\'e9nt egy olyan n\'e9p sz\'e1m
\'e1ra, akik hisznek.
\par 
\par 65. \'c9s Allah vizet bocs\'e1tott le az \'e9gb\'f5l, majd \'e9letre keltette \'e1ltala a f\'f6ldet, annak hal\'e1la (kisz\'e1rad\'e1sa) ut\'e1n. Bizony, ebben jel van egy olyan n\'e9p sz\'e1m\'e1ra, akik hallanak.
\par 66. \'c9s bizony, tanuls\'e1g van nektek a j\'f3sz\'e1gokban [is]. Mi abb\'f3l itatunk titeket, ami a hasukban van - a b\'e9ltartalom \'e9s a v\'e9r k\'f6z\'f6tt -, tiszta tejjel, amely k\'f6nnyen ihat\'f3 az iv\'f3k sz\'e1m\'e1ra.
\par 67. \'c9s a datolyap\'e1lm\'e1k \'e9s a sz\'f5l\'f5k gy\'fcm\'f6lcseib\'f5l r\'e9szeg\'edt\'f5 [italt] \'e9s j\'f3 ell\'e1t\'e1st (t\'e1pl\'e1l\'e9kot) k\'e9sz\'edtetek magatoknak. Bizony, ebben jel van egy olyan n\'e9p sz\'e1m\'e1ra, akik \'e9lnek az esz
\'fckkel.
\par 68. \'c9s Urad azt sugallta a m\'e9hnek: \'84K\'e9sz\'edts magadnak h\'e1zakat a hegyeken, a f\'e1kon, \'e9s azokon [az \'e9p\'edtm\'e9nyeken], amelyeket [az emberek] emelnek!\'94
\par 69. Azt\'e1n egy\'e9l mindenf\'e9le gy\'fcm\'f6lcsb\'f5l \'e9s j\'e1rd az }{\insrsid3161635\charrsid16065244 Urad k\'f6nnyen j\'e1rhat\'f3 \'fatjait! A [m\'e9h] has\'e1b\'f3l k\'fcl\'f6nb\'f6z\'f5 sz\'edn\'fb ital ered, amelyben gy\'f3gyul\'e1
s van az emberek sz\'e1m\'e1ra. Bizony, ebben jel van egy olyan n\'e9p sz\'e1m\'e1ra, akik elgondolkodnak.
\par 
\par 70. \'c9s Allah teremtett titeket, azt\'e1n mag\'e1hoz sz\'f3l\'edt titeket. \'c1m van k\'f6z\'f6ttetek olyan, aki a legal\'e1val\'f3bb \'e9letkorba (v\'e9ns\'e9gbe) juttatik, hogy miut\'e1n tudott, ne tudjon semmit. Bizony, Allah Mindentud\'f3, Mindenhat
\'f3.
\par 71. \'c9s Allah el\'f5nyben r\'e9szes\'edtett egyeseket k\'f6z\'fcletek m\'e1sokkal szemben az ell\'e1t\'e1sban (a meg\'e9lhet\'e9sben). \'c9s akik el\'f5nyben r\'e9szes\'fcltek, azok nem adj\'e1k \'e1t ell\'e1t\'e1
sukat azoknak, akiket a jobbjuk birtokol (a rabszolg\'e1iknak), hogy egyenl\'f5ek legyenek vel\'fck abban. Vajon h\'e1t Allah j\'f3t\'e9tem\'e9ny\'e9t tagadj\'e1k?
\par 72. \'c9s Allah saj\'e1t magatok k\'f6z\'fcl h\'e1zast\'e1rsakat adott nektek, \'e9s a h\'e1zast\'e1rsaitokt\'f3l gyerekeket \'e9s unok\'e1kat adott nektek, \'e9s a j\'f3 dolgokb\'f3l l\'e1tott el titeket. Vajon h\'e1t a hamiss\'e1gban hisznek, \'e9
s Allah j\'f3t\'e9tem\'e9ny\'e9vel szemben hitetlenn\'e9 v\'e1lnak?}{\insrsid3161635 
\par 
\par 73. \'c9s Allah helyett olyat szolg\'e1lnak, amelynek nem \'e1ll m\'f3dj\'e1ban ell\'e1tni \'f5ket semmivel, sem az egekb\'f5l, sem a f\'f6ldr\'f5l, \'e9s nem is k\'e9pesek [erre].
\par 74. Ne adjatok h\'e1t Allahr\'f3l p\'e9ld\'e1zatokat! Bizony, Allah [mindent] tud, \'e1m ti nem tudtok.
\par 75. Allah p\'e9ld\'e1zatot adott egy birtokolt rabszolg\'e1r\'f3l, akinek nincs hatalma semmi felett, \'e9s [egy m\'e1sikr\'f3l], akit T\'f5l\'fcnk sz\'e1rmaz\'f3 sz\'e9p ell\'e1t\'e1ssal l\'e1ttunk el, \'e9s az titokban \'e9s ny\'edltan adakozik abb\'f3
l. Vajon egyenl\'f5k-e \'f5k? A h\'e1latelt dics\'e9ret Allahot illeti! De a legt\'f6bbj\'fck nem rendelkezik tud\'e1ssal.
\par 76. \'c9s Allah p\'e9ld\'e1zatot ad k\'e9t f\'e9rfir\'f3l. Az egyik\'fck n\'e9ma, nincs hatalma semmi felett, \'e9s \'f5 [csak] teher a gazd\'e1j\'e1nak, ak\'e1rhov\'e1 k\'fcldi is, semmi j\'f3t nem hoz. Vajon ez egyenl\'f5
-e azzal, aki megparancsolja az igazs\'e1goss\'e1got, mik\'f6zben az egyenes \'faton van?
\par 
\par 77. \'c9s Allahot illetik az egek \'e9s a f\'f6ld rejtett dolgai. \'c9s az \'d3ra parancsa csup\'e1n olyan, mint egy szempillant\'e1s, vagy m\'e9g gyorsabb. Bizony, Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 78. \'c9s Allah hozott ki titeket az \'e9desany\'e1itok has\'e1b\'f3l [\'fagy, hogy] nem tudtatok semmit. \'c9s [azt\'e1n] megadta nektek a hall\'e1st, a l\'e1t\'e1st \'e9s a sz\'edvet (\'e9rtelmet), h\'e1tha h\'e1l\'e1sak lesztek.
\par 79. Vajon nem gondolkodtak el a madarakon, amint [rep\'fcl\'e9sre] }{\insrsid3161635\charrsid14566264 rendeltetve [lebegnek] az \'e9g leveg\'f5j\'e9ben? Nem tartja meg \'f5ket m\'e1s, csak Allah. Bizony, ebben jelek vannak egy olyan n\'e9p sz\'e1m\'e1
ra, akik hisznek.
\par 
\par 80. \'c9s Allah a h\'e1zaitokat nyugalom hely\'e9v\'e9 tette sz\'e1motokra, \'e9s a j\'f3sz\'e1gok b\'f5r\'e9b\'f5l h\'e1zakat adott nektek, amelyeket k\'f6nny\'fbnek tal\'e1ltok azon a napon, amikor utaztok, \'e9s azon a napon, amikor meg\'e1llapodtok. 
\'c9s gyapj\'fajukb\'f3l, sz\'f5rm\'e9j\'fckb\'f5l \'e9s sz\'f5r\'fckb\'f5l egy id\'f5re berendez\'e9si t\'e1rgyakat \'e9s [a meg\'e9lhet\'e9shez sz\'fcks\'e9ges] holmikat [adott].
\par 81. \'c9s Allah \'e1rny\'e9kot adott nektek abb\'f3l, amit teremtett, \'e9s a hegyeken [mened\'e9k\'fcl szolg\'e1l\'f3] \'fcregeket adott nektek. \'c9s ruh\'e1kat adott nektek, amelyek meg\'f3vnak titeket a h\'f5s\'e9gt\'f5l, \'e9s [m\'e1s] ruh\'e1
kat, amelyek meg\'f3vnak titeket, amikor harcoltok. Ekk\'e9ppen teljes\'edti ki j\'f3t\'e9tem\'e9ny\'e9t ir\'e1ntatok, h\'e1tha al\'e1vetitek magatokat [Neki].
\par 82. Ha pedig h\'e1tat ford\'edtanak, \'fagy r\'e1d csup\'e1n a vil\'e1gos [\'fczenet-] \'e1tad\'e1s tartozik.
\par 83. Ismerik Allah j\'f3t\'e9tem\'e9ny\'e9t, azt\'e1n megtagadj\'e1k azt. \'c9s a legt\'f6bbj\'fck hitetlen.
\par 
\par 84. \'c9s [eml\'e9kezz] arra a napra, amikor minden k\'f6z\'f6ss\'e9gb\'f5l t\'e1masztunk egy tan\'fat, azt\'e1n nem adatik enged\'e9ly [a menteget\'f5z\'e9sre] azoknak, akik hitetlenn\'e9 v\'e1ltak, \'e9s nem k\'e9retik t\'f5l\'fck kiengesztel\'e9
s [Allah fel\'e9].
\par 85. \'c9s amikor megl\'e1tj\'e1k a gy\'f6trelmet azok, akik igazs\'e1gtalans\'e1got k\'f6vettek el, akkor nem enyh\'edttetik majd sz\'e1mukra, \'e9s halad\'e9kot sem fognak kapni.
\par 86. \'c9s amikor azok, akik t\'e1rsistent \'e1ll\'edtottak [Allah mell\'e9] megl\'e1tj\'e1k azokat, akiket t\'e1rsistenn\'e9 nyilv\'e1n\'edtottak, azt fogj\'e1k mondani: \'84Urunk! Ezek azok, akiket t\'e1rsistenn\'e9 nyilv\'e1n\'ed
tottunk, akikhez Helyetted foh\'e1szkodtunk.\'94 Azok pedig fel\'e9j\'fck vetik a sz\'f3t: \'84Bizony, hazugok vagytok!\'94
\par 87. \'c9s azon a napon teljes megad\'e1st mutatnak Allahnak, \'e9s elt\'fbnik mell\'f5l\'fck mindaz, amit kital\'e1ltak.
\par 88. Akik hitetlenn\'e9 v\'e1ltak \'e9s t\'e1vol tartottak [m\'e1sokat] Allah \'datj\'e1t\'f3l, azokat gy\'f6trelemmel halmozzuk el a gy\'f6trelem felett az\'e9rt, mert roml\'e1st okoztak.
\par 89. \'c9s [}{\insrsid3161635 e}{\insrsid3161635\charrsid11034251 ml\'edtsd meg}{\insrsid3161635  azt}{\insrsid3161635\charrsid14566264 ] a nap}{\insrsid3161635 ot}{\insrsid3161635\charrsid14566264 , amikor minden k\'f6z\'f6ss\'e9gb\'f5l saj\'e1t maguk k
\'f6z\'fcl egy tan\'fat t\'e1masztunk vel\'fck szemben, \'e9s t\'e9ged hozunk el\'f5 tan\'fak\'e9nt ezekkel szemben! \'c9s lebocs\'e1tottuk neked az \'cdr\'e1st minden dolog vil\'e1gos magyar\'e1zatak\'e9nt, \'e9s \'fatmutat\'e1sk\'e9nt, \'e9s k\'f6ny\'f6
r\'fcletk\'e9nt \'e9s \'f6r\'f6mh\'edrk\'e9nt azoknak, akik al\'e1vetik magukat [Allahnak].
\par 
\par 90. Bizony, Allah az igazs\'e1goss\'e1gra, \'e9s a j\'f3tev\'f5 cselekv\'e9sre \'e9s a rokonoknak val\'f3 adakoz\'e1sra sz\'f3l\'edt fel, \'e9s eltilt az f\'f6rtelmess\'e9gt\'f5l, \'e9s az elvetend\'f5t\'f5l \'e9s a zsarnoks\'e1gt\'f3l. Int titeket, h\'e1
tha okultok [az int\'e9sb\'f5l].
\par 91. \'c9s teljes\'edts\'e9tek az Allahhal [k\'f6t\'f6tt] egyezs\'e9get, ha egyezs\'e9get k\'f6t\'f6ttetek, \'e9s ne szegj\'e9tek meg az esk\'fcket, azok meger\'f5s\'edt\'e9se ut\'e1n, mik\'f6zben Allahot tett\'e9
tek meg kezesnek magatok ellen! Bizony, Allah tudja, hogy mit tesztek.}{\insrsid3161635 
\par 92. \'c9s ne legyetek olyanok, mint az [az asszony], aki sz\'e1lakra bontja fon\'e1s\'e1t, miut\'e1n er\'f5sen [megfonta], azzal, hogy esk\'fciteket csal\'e1rds\'e1g eszk\'f6z\'e9v\'e9 teszitek, [csup\'e1n az\'e9rt], mert az egyik k\'f6z\'f6ss\'e9
g nagyobb sz\'e1m\'fa, mint a [m\'e1sik] k\'f6z\'f6ss\'e9g! Allah ezzel csup\'e1n pr\'f3b\'e1nak vet al\'e1 titeket. Bizony vil\'e1gosan meg fogja magyar\'e1zni nektek a Felt\'e1mad\'e1s Napj\'e1n azt, amiben \'f6sszek\'fcl\'f6nb\'f6ztetek.
\par 93. \'c9s ha Allah \'fagy akarta volna, akkor egyetlen k\'f6z\'f6ss\'e9gg\'e9 tett volna titeket, \'e1m \'d5 t\'e9velyg\'e9sbe viszi azt, akit akar, \'e9s [igaz \'faton] vezeti azt, akit akar. \'c9s bizony meg lesztek k\'e9rdezve arr\'f3
l, amit cselekedtetek.
\par }{\insrsid16543947 
\par }{\insrsid3161635 94. \'c9s ne tegy\'e9tek esk\'fciteket egym\'e1s k\'f6z\'f6tti csal\'e1rds\'e1g eszk\'f6z\'e9v\'e9, nehogy megcs\'fasszon a l\'e1batok, miut\'e1n szil\'e1rdan \'e1lltatok [az igaz hiten], \'e9s [nehogy] a rosszat (az evil\'e1gi b\'fcntet
\'e9st) kelljen meg\'edzlelnetek az\'e9rt, mert t\'e1vol tartottatok [m\'e1sokat] Allah \'datj\'e1t\'f3l, \'e9s nehogy [emiatt] hatalmas gy\'f6trelem j\'e1rjon nektek!
\par 95. \'c9s ne k\'f3tyavety\'e9lj\'e9tek el az Allahhal [k\'f6t\'f6tt] egyezs\'e9get csek\'e9ly \'e1ron! Bizony az, ami Allahn\'e1l van, jobb nektek, }{\insrsid3161635\charrsid72611 ha val\'f3ban}{\insrsid3161635  rendelkeztek tud\'e1ssal!
\par 96. Ami n\'e1latok van, az elfogy, \'e1m }{\insrsid3161635\charrsid14566264 ami Allahn\'e1l van, az maradand\'f3. \'c9s azoknak a jutalm\'e1t akik t\'fcrelmesek voltak, a legjobb cselekedeteiknek megfelel\'f5en fogjuk megfizetni.
\par 97. Aki j\'f3tettet cselekszik, [legyen] ak\'e1r f\'e9rfi, ak\'e1r n\'f5, \'e9s h\'edv\'f5, j\'f3 \'e9letben fogjuk \'f5t r\'e9szes\'edteni, \'e9s jutalm\'e1t a legjobb cselekedeteinek megfelel\'f5en fogjuk megfizetni.
\par }{\insrsid8527935 
\par }{\insrsid3161635\charrsid14566264 98. \'c9s amikor a Kor\'e1nt [akarod] recit\'e1lni, akkor keress mened\'e9ket Allahn\'e1l a megk\'f6vezett s\'e1t\'e1n el\'f5l!
\par 99. Bizony, nincs neki (a s\'e1t\'e1nnak) hatalma azok felett, akik hisznek \'e9s Urukra hagyatkoznak.
\par 100. Csup\'e1n azok felett van hatalma, akik p\'e1rtfog\'f3jukk\'e1 teszik, \'e9s azok felett, akik [Allah] mell\'e9 t\'e1rsistent \'e1ll\'edtanak.
\par 101. \'c9s amikor kicser\'e9l\'fcnk egy jelet (Kor\'e1n-id\'e9zetet) egy m\'e1sik jellel - \'e9s Allah tudja a legjobban, mit bocs\'e1t le -, azt mondj\'e1k [a hitetlenek]: \'84Te csup\'e1n hazugs\'e1got tal\'e1lsz ki!\'94 De a legt\'f6bbj\'fc
k nem rendelkezik tud\'e1ssal.
\par 102. Mondd [\'f3 Mohamed]: \'84A Szent L\'e9lek (G\'e1briel) bocs\'e1totta le azt az Uradt\'f3l az igazs\'e1ggal, hogy megszil\'e1rd\'edtsa azokat, akik hisznek, \'e9s \'fatmutat\'e1sk\'e9nt \'e9s \'f6r\'f6mh\'edrk\'e9nt azok sz\'e1m\'e1ra, akik al\'e1
vetik magukat [Allahnak].\'94
\par }{\insrsid8527935 
\par }{\insrsid3161635\charrsid14566264 103. \'c9s bizony tudjuk, hogy \'f5k azt mondj\'e1k: \'84\'d5t csup\'e1n egy ember tan\'edtja!\'94 Azonban annak a nyelve, akire \'f5k utalnak, nem-arab, ez (a Kor\'e1n) azonban vil\'e1gos arab [nyelven van].
\par 104. Bizony, akik nem hisznek Allah jeleiben, [azokat] Allah nem vezeti [az Egyenes \'daton] \'e9s nekik f\'e1jdalmas gy\'f6trelem j\'e1r.
\par 105. Csup\'e1n azok tal\'e1lj\'e1k ki a hazugs\'e1got, akik nem hisznek Allah jeleiben, \'e9s \'f5k a hazugok!
\par 106. Aki hitetlenn\'e9 v\'e1lt Allahhal szemben, miut\'e1n h\'edv\'f5 volt, kiv\'e9ve azt, aki k\'e9nyszer\'edtve volt, mik\'f6zben sz\'edve nyugodt a hit fel\'f5l, hanem az, aki kit\'e1rta kebl\'e9t a hitetlens\'e9g el\'f5tt, nos azokat Allah haragv\'e1
sa s\'fajtja, \'e9s nekik hatalmas gy\'f6trelem j\'e1r.
\par 107. Ez az\'e9rt van, mert el\'f5nyben r\'e9szes\'edtett\'e9k az evil\'e1got, a t\'falvil\'e1ggal szemben, \'e9s [az\'e9rt] mert Allah nem vezeti [az igaz \'fatra] a hitetlen n\'e9pet.
\par 108. \'d5k azok, akiknek Allah lepecs\'e9telte a sz\'edv\'fcket, a hall\'e1sukat, \'e9s a l\'e1t\'e1sukat. \'c9s \'f5k azok, akik figyelmen k\'edv\'fcl hagyj\'e1k [a b\'fcntet\'e9st].
\par }\pard\plain \s92\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid3161635\charrsid14566264 109. Nem k\'e9ts\'e9ges, hogy a t
\'falvil\'e1gon \'f5k lesznek a vesztesek.
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid8527935 
\par }{\insrsid3161635\charrsid14566264 110. Majd, bizony az Urad azokkal szemben, akik kiv\'e1ndoroltak azt k\'f6vet\'f5en, hogy pr\'f3b\'e1ra lettek t\'e9ve, majd k\'fczd\'f6ttek \'e9s t\'fcrelmesek voltak \endash  bizony az Urad, azut\'e1n [a pr\'f3bat\'e9
telt k\'f6vet\'f5en] Megbocs\'e1t\'f3, Irgalmas!
\par 111. Azon a napon (a Felt\'e1mad\'e1s napj\'e1n) minden ember elj\'f6n, hogy saj\'e1t mag\'e1\'e9rt vit\'e1zzon, \'e9s minden ember [fizets\'e9ge] teljess\'e9 t\'e9tetik az\'e9rt, amit cselekedett, mik\'f6zben nem szenvednek el igazs\'e1gtalans\'e1got.}{
\insrsid3161635 
\par }{\insrsid8527935 
\par }{\insrsid3161635 112. \'c9s Allah p\'e9ld\'e1zatot adott egy v\'e1rosr\'f3l, amely }{\insrsid3161635\charrsid1847987 biztons\'e1gos \'e9s nyugodt volt, az ell\'e1t\'e1sa b\'f5s\'e9gesen j\'f6tt hozz\'e1 minden helyr\'f5l, \'e1m az megtagadta Allah j\'f3t
\'e9tem\'e9nyeit, Allah pedig meg\'edzleltette vele az \'e9hs\'e9g \'e9s a f\'e9lelem \'f6lt\'f6z\'e9k\'e9t az\'e9rt, amit [a lak\'f3i] m\'fbveltek.
\par 113. \'c9s bizony elj\'f6tt hozz\'e1juk egy k\'f6z\'fcl\'fck val\'f3 k\'fcld\'f6tt, \'e1m \'f5k meghazudtolt\'e1k. A gy\'f6trelem pedig elragadta \'f5ket, mik\'f6zben igazs\'e1gtalanok voltak.
\par }{\insrsid8527935 
\par }{\insrsid3161635\charrsid1847987 114. Egyetek h\'e1t abb\'f3l, amivel Allah ell\'e1tott titeket megengedett \'e9s j\'f3 [t\'e1pl\'e1l\'e9k] gyan\'e1nt! \'c9s legyetek h\'e1l\'e1sak Allah j\'f3t\'e9tem\'e9nye ir\'e1nt, ha val\'f3ban \'d5t szolg\'e1lj\'e1
tok!
\par 115. Bizony, csup\'e1n az elhullott \'e1llat [h\'fas\'e1t] tette tilalmass\'e1 sz\'e1motokra, \'e9s a v\'e9rt \'e9s a diszn\'f3h\'fast, \'e9s azt, amit [a lev\'e1g\'e1skor] Allah helyett [t\'e1rsistennek] aj\'e1nlanak fel. \'c1m, aki r\'e1k\'e9nyszer\'fc
l [ezek fogyaszt\'e1s\'e1ra] an\'e9lk\'fcl, hogy v\'e1gyakozna [az engedetlens\'e9gre], vagy t\'falkap\'e1sra vetemedne [ezek fogyaszt\'e1s\'e1ban, azt nem terheli b\'fbn].  Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 116. \'c9s ne mondj\'e1tok arr\'f3l, amir\'f5l a nyelvetek hazugs\'e1got \'e1ll\'edt, [hogy] \'84ez megengedett, ez pedig tiltott\'94, [az\'e9rt] hogy hazugs\'e1got tal\'e1ljatok ki Allahr\'f3l! Bizony, akik hazugs\'e1got tal\'e1lnak ki Allahr\'f3
l, azok nem fognak boldogulni.
\par 117. [Ez] csek\'e9ly [muland\'f3] \'e9lvezet, \'e9s nekik f\'e1jdalmas gy\'f6trelem j\'e1r.
\par 118. \'c9s azoknak, akik zsid\'f3k, tilalmass\'e1 tett\'fck amit kor\'e1bban elbesz\'e9lt\'fcnk neked. \'c9s nem k\'f6vett\'fcnk el igazs\'e1gtalans\'e1got ellen\'fck, hanem \'f5k voltak igazs\'e1gtalanok saj\'e1t magukkal szemben.
\par }\pard \s91\qj \li0\ri0\widctlpar\tx4379\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid1847987 119. Majd, bizony az Urad - azokkal szemben, akik tudatlans\'e1gb\'f3l cselekedtek rosszat, majd azut\'e1
n b\'fbnb\'e1natot tan\'fas\'edtottak \'e9s megjavultak - bizony a te Urad azut\'e1n Megbocs\'e1t\'f3, Irgalmas [ir\'e1ntuk].
\par }\pard \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid8527935 
\par }{\insrsid3161635\charrsid1847987 120. Bizony, \'c1brah\'e1m [egymag\'e1ban] egy k\'f6z\'f6ss\'e9g volt, aki al\'e1zatosan engedelmes volt Allah ir\'e1nt, han\'edf (egyistenh\'edv\'f5, a hamis vall\'e1sokt\'f3l elhajl\'f3) volt, \'e9
s nem tartozott az [Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3k k\'f6z\'e9.
\par 121. H\'e1l\'e1s volt az \'d5 j\'f3t\'e9tem\'e9nyei ir\'e1nt. [Allah] kiv\'e1lasztotta \'e9s az Egyenes \'datra vezette \'f5t.
\par 122. \'c9s az evil\'e1gon j\'f3t adtunk neki, a }{\insrsid3161635\charrsid7483848 t\'falvil\'e1gon pedig a j\'f3 emberek k\'f6z\'e9 fog tartozni.
\par 123. Majd [kinyilatkoztat\'e1sk\'e9nt] sugalltuk neked [\'f3 Mohamed], hogy k\'f6vesd \'c1brah\'e1m vall\'e1s\'e1t han\'edfk\'e9nt, \'e9s \'f5 nem tartozott az [Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3k k\'f6z\'e9.
\par 124. A szombat [t\'f6rv\'e9nye] csup\'e1n azoknak rendeltetett el, akik \'f6sszek\'fcl\'f6nb\'f6ztek miatta. \'c9s bizony az Urad \'edt\'e9lkezni fog k\'f6z\'f6tt\'fck [a Felt\'e1mad\'e1s napj\'e1n] abban, amiben \'f6sszek\'fcl\'f6nb\'f6ztek.
\par }{\insrsid8527935 
\par }{\insrsid3161635\charrsid7483848 125. H\'edvj az Urad \'datj\'e1ra b\'f6lcsess\'e9ggel \'e9s sz\'e9p int\'e9ssel, \'e9s sz\'e1llj vit\'e1ba \'fagy, ahogy a legjobb! Bizony, az Urad tudja a legjobban, hogy ki t\'e9velyedett el az \'d5 \'fatj\'e1r\'f3l, 
\'e9s \'d5 tudja a legjobban, hogy kik vannak az [igaz] \'faton vezetve.
\par 126. \'c9s ha b\'fcntettek (megtoroltok), akkor olyan m\'e9rt\'e9kben b\'fcntessetek (toroljatok meg), amilyen m\'e9rt\'e9kben titeket b\'fcntettek (\'e1rtottak nektek)! \'c1m ha t\'fcrelmet tan\'fas\'edtotok, az bizony jobb a t\'fcrelmeseknek.
\par 127. Legy\'e9l t\'fcrelmes, \'e1m nem lesz t\'fcrelmed, csak Allah \'e1ltal! \'c9s ne szomorkodj miattuk, \'e9s ne legy\'e9l gondterhelt az\'e9rt, ami [gonosz] tervet sz\'f5nek!
\par }\pard \s91\ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid3161635 {\insrsid3161635\charrsid7483848 128. Bizony Allah azokkal van, akik f\'e9lik [\'d5t] \'e9s azokkal, akik j\'f3tev\'f5k.}{\insrsid5968634 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid5968634 \page }{
\f0\fs24\insrsid5968634\charrsid5968634 17. sz\'fara \endash  Az \'e9jszakai Utaz\'e1s (al-Iszra) c. sz\'fara}{\fs24\insrsid5968634\charrsid8019449 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par A K\'f6ny\'f6r\'fcletes, az Irgalmas Allah nev\'e9ben.
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 1. Magasztaltass\'e9k az, aki \'e9jszaka utaz\'e1sra vitte a szolg\'e1j\'e1t a Tilalmas Mecsett\'f5l (Mekk\'e1ban) a Legt\'e1
volabbi Mecsetig (Jeruzs\'e1lemben), amelynek meg\'e1ldottuk a k\'f6rny\'e9k\'e9t, hogy mutassunk neki a jeleinkb\'f5l. Bizony, \'d5 a mindent Hall\'f3, a mindent L\'e1t\'f3.
\par 
\par 2. \'c9s odaadtuk M\'f3zesnek az \'cdr\'e1st, \'e9s azt \'fatmutat\'e1ss\'e1 tett\'fck Izrael gyermekeinek [mondv\'e1n:] \'84Ne tegyetek magatoknak Rajtam k\'edv\'fcl [m\'e1s] v\'e9delmez\'f5t!\'94
\par 3. [Ti, akik] a lesz\'e1rmazottai [vagytok] azoknak, akiket No\'e9val egy\'fctt vitt\'fcnk [a b\'e1rk\'e1n]! Bizony, \'f5 h\'e1l\'e1s szolga volt.\'94
\par 4. \'c9s elrendelt\'fck az \'cdr\'e1sban Izrael gyermekeivel kapcsolatban: \'84Bizony, k\'e9t alkalommal fogtok roml\'e1st okozni a f\'f6ld\'f6n, \'e9s fennh\'e9j\'e1zni fogtok nagy fennh\'e9j\'e1z\'e1ssal!\'94
\par 5. \'c9s amikor bek\'f6vetkezett az \'edg\'e9ret az els\'f5re a k\'e9t alkalom k\'f6z\'fcl, hatalmas hader\'f5vel b\'edr\'f3 szolg\'e1inkat t\'e1masztottuk ellenetek, akik t\'fczetesen \'e1tkutatt\'e1k a lakhelyeket. \'c9s az egy beteljesedett \'edg\'e9
ret volt.
\par 6. Majd vissza adtuk nektek a gy\'f5zelmet felett\'fck, \'e9s b\'f5s\'e9gesen gondoskodtunk r\'f3latok vagyonnal \'e9s gyermekekkel, \'e9s nagyobb sz\'e1m\'fa seregg\'e9 tett\'fcnk titeket.
\par 7. Ha j\'f3tev\'f5k vagytok, akkor magatoknak vagytok j\'f3tev\'f5k, ha pedig rosszat cselekszetek, azt [szint\'e9n] magatoknak teszitek. Amikor pedig bek\'f6vetkezik az \'edg\'e9ret az utols\'f3 alkalomra [akkor ism\'e9t elk\'fcldj\'fck szolg\'e1
inkat], hogy elkomor\'edts\'e1k az arcotokat, \'e9s hogy bel\'e9pjenek a mecsetbe (Jeruzs\'e1lemben), ahogyan az els\'f5 alkalommal l\'e9ptek be oda, \'e9s hogy nagy puszt\'edt\'e1ssal puszt\'edts\'e1k el azt, amit a hatalmukba ker\'edtettek.
\par 8. Az Uratok tal\'e1n megk\'f6ny\'f6r\'fcl rajtatok. \'c1m ha visszat\'e9rtek [a roml\'e1s okoz\'e1s\'e1hoz], akkor Mi is visszat\'e9r\'fcnk [a megb\'fcntet\'e9setekhez]. \'c9s a Gyehenn\'e1t a hitetlenek t\'f6ml\'f6c\'e9v\'e9 tett\'fck.
\par 
\par 9. Bizony, ez a Kor\'e1n arra vezet, ami egyenesebb (igazs\'e1gosabb \'e9s helyesebb), \'e9s \'f6r\'f6mh\'edrt ad a h\'edv\'f5knek, akik j\'f3tetteket cselekszenek [arr\'f3l], hogy nekik nagy jutalom j\'e1r.
\par 10. \'c9s [arr\'f3l] hogy akik nem hisznek a t\'falvil\'e1gban, azoknak f\'e1jdalmas gy\'f6trelmet k\'e9sz\'edtett\'fcnk el\'f5.
\par 11. \'c9s az ember \'fagy foh\'e1szkodik a rossz\'e9rt, ahogyan a j\'f3\'e9rt is foh\'e1szkodik, \'e9s }{\insrsid5968634\charrsid15092070 az ember az ember [mindig] elhamarkodott volt.}{\insrsid5968634 
\par 
\par 12. \'c9s az \'e9jszak\'e1t \'e9s a nappalt k\'e9t jell\'e9 tett\'fck. \'c9s elt\'f6r\'f6lt\'fck az \'e9jszaka jel\'e9t, \'e9s a nappal jel\'e9t olyann\'e1 tett\'fck, ami \'e1ltal l\'e1that\'f3v\'e1 v\'e1lnak [a dolgok], az\'e9rt, hogy az Uratokt\'f3l sz
\'e1rmaz\'f3 kegyeket keress\'e9tek, \'e9s hogy megtudhass\'e1tok az \'e9vek sz\'e1m\'e1t, s a[z id\'f5]-sz\'e1m\'edt\'e1st. \'c9s minden dolgot elmagyar\'e1zva, r\'e9szletesen fejtett\'fcnk ki.
\par 13. \'c9s minden embernek a nyak\'e1ra k\'f6t\'f6tt\'fck [saj\'e1t j\'f3 vagy rossz] tett\'e9t, \'e9s a Felt\'e1mad\'e1s napj\'e1n egy \'cdr\'e1st (tetteinek feljegyz\'e9s\'e9t) hozunk el\'f5 neki, amit kiter\'edtve tal\'e1l majd.
\par 14. [Az mondatik neki:] \'84Olvasd az \'edr\'e1sod (tetteidnek feljegyz\'e9s\'e9t)! A mai napon elegend\'f5 vagy \'f6nmagaddal szemben elsz\'e1moltat\'f3nak.\'94 
\par 15. Aki az igaz \'fatra lel, az csup\'e1n a maga haszn\'e1ra lel az igaz \'fatra. \'c9s aki t\'e9velyeg, az csup\'e1n a maga k\'e1r\'e1ra t\'e9velyeg. \'c9s egyetlen terhet cipel\'f5 sem cipeli egy m\'e1siknak a terh\'e9t. \'c9s Mi nem s\'fajtunk gy\'f6
trelemmel addig, am\'edg nem t\'e1masztunk k\'fcld\'f6ttet.
\par 16. \'c9s amikor el akarunk puszt\'edtani egy v\'e1rost, megparancsoljuk azoknak, akik j\'f3l\'e9tben d\'fask\'e1ltak [az engedelmess\'e9get], \'e1m azok engedetlens\'e9get k\'f6vettek el ott. \'cdgy v\'e1lt jogoss\'e1 vele (a v\'e1rossal) szemben a [b
\'fcntet\'e9sr\'f5l sz\'f3l\'f3] sz\'f3, \'e9s romba d\'f6nt\'f6tt\'fck azt teljes rombol\'e1ssal.
\par 17. \'c9s h\'e1ny nemzed\'e9ket puszt\'edtottunk el No\'e9 ut\'e1n! \'c9s elegend\'f5 a te Urad a szolg\'e1i v\'e9tkeinek j\'f3 ismer\'f5jek\'e9nt [\'e9s mindent] l\'e1t\'f3jak\'e9nt.
\par 
\par 18. Aki a tovasiet\'f5 [evil\'e1gi \'e9lvezetet] akarja, Mi abban (az evil\'e1gon) sietve megadjuk azt, amit akarunk, annak, akinek csak akarjuk. Majd a Gyehenn\'e1t tessz\'fck meg neki [b\'fcntet\'e9s\'e9nek hely\'e9\'fcl], amelyben \'e9gni fog, megal
\'e1zottan, kitasz\'edtva.
\par 19. \'c9s aki a t\'falvil\'e1got akarja \'e9s azt megillet\'f5 igyekezettel igyekszik \'e9rte, mik\'f6zben h\'edv\'f5, azoknak az igyekezete meg lesz h\'e1l\'e1lva.
\par 20. Mindannyiuknak \endash  ezeknek \'e9s azoknak is \endash  b\'f5s\'e9gesen adunk az Urad aj\'e1nd\'e9k\'e1b\'f3l, \'e9s az Urad aj\'e1nd\'e9ka [senkit\'f5l] sincs eltiltva.
\par 21. N\'e9zd meg, hogyan r\'e9szes\'edtett\'fcnk egyeseket k\'f6z\'fcl\'fck el\'f5nyben a t\'f6bbiekkel szemben, \'e1m a t\'falvil\'e1g bizony nagyobb fokozatokban \'e9s nagyobb kit\'fcntetetts\'e9gben.
\par 
\par 22. Ne helyezz Allah mell\'e9 m\'e1s istent, mert akkor ott maradsz megal\'e1zottan, elhagyatottan!
\par 23. \'c9s elrendelte az Urad, hogy ne szolg\'e1ljatok m\'e1st, csak \'d5t, \'e9s hogy b\'e1njatok j\'f3l a sz\'fcl\'f5kkel. \'c9s ha kettej\'fck k\'f6z\'fcl az egyik, vagy mindketten el\'e9rik melletted az id\'f5skort, akkor ne mondd nekik azt, hogy: \'84
Pf\'faj!\'94, \'e9s ne becsm\'e9reld \'f5ket, \'e9s tisztes szavakkal }{\insrsid5968634\charrsid15092070 sz\'f3lj hozz\'e1juk!
\par 24. \'c9s ereszd le nekik k\'f6ny\'f6r\'fcletb\'f5l az al\'e1zatoss\'e1g sz\'e1rny\'e1t, \'e9s mondd: \'84Uram! K\'f6ny\'f6r\'fclj meg rajtuk, ami\'e9rt \'f5k felneveltek engem kiskoromban.\'94}{\insrsid5968634 
\par 25. Az Uratok jobban tudja mi }{\insrsid5968634\charrsid15092070 van bennetek}{\insrsid5968634 . Ha j\'f3 emberek vagytok, h\'e1t bizony \'d5 megbocs\'e1t\'f3 azok ir\'e1nt, akik gyakran [b\'fbnb\'e1n\'f3an] visszat\'e9rnek [Hozz\'e1].
\par 26. \'c9s add meg a rokonnak a jogos r\'e9sz\'e9t, \'e9s a szeg\'e9nynek \'e9s az utaz\'f3nak [is], \'e1m ne pazarolj m\'e9rt\'e9ktelen\'fcl!
\par 27. Bizony a pazarl\'f3k a s\'e1t\'e1nok testv\'e9rei, \'e9s a s\'e1t\'e1n az \'f5 Ur\'e1val szemben mindig nagyon h\'e1l\'e1tlan.
\par 28. \'c9s ha elfordulsz t\'f5l\'fck [azokt\'f3l, akik jogosultak az adom\'e1nyra, mert nincs mit adnod], \'e1h\'edtozva Urad k\'f6ny\'f6r\'fclet\'e9t (b\'f5s\'e9ges ell\'e1t\'e1s\'e1t), amelyet rem\'e9lsz, akkor [legal\'e1bb] kedves szavakkal sz\'f3
lj hozz\'e1juk!
\par 29. \'c9s ne hagyd a kezed a nyakadhoz bilincselve (ne l\'e9gy fukar), }{\insrsid5968634\charrsid15092070 \'e9s ne terjeszd ki teljes}{\insrsid5968634  m\'e9rt\'e9kben (ne l\'e9gy pazarl\'f3), k\'fcl\'f6nben ott maradsz leszidva, nyomorogva!
\par 30. Bizony, Urad annak terjeszti ki az ell\'e1t\'e1st, akinek akarja, \'e9s sz\'fbk\'f6ss\'e9 teszi [azt m\'e1soknak]. Bizony \'d5 j\'f3l ismeri \'e9s \'e1tl\'e1tja szolg\'e1it.
\par 
\par 31. \'c9s ne \'f6lj\'e9tek meg gyermekeiteket szeg\'e9nys\'e9gt\'f5l tartva! Mi l\'e1tjuk el \'f5ket \'e9s titeket is. Bizony a meg\'f6l\'e9s\'fck nagy v\'e9tek!
\par 32. \'c9s ne k\'f6zel\'edtsetek a par\'e1znas\'e1ghoz! Bizony az f\'f6rtelmes tett \'e9s milyen rossz \'fat!
\par 33. \'c9s ne \'f6lj\'e9tek meg azt az embert, akinek [\'e9let\'e9t] Allah tilalmass\'e1 tette, csakis jogosan (ember\'f6l\'e9s vagy a f\'f6ld\'f6n val\'f3 puszt\'edt\'e1s b\'fcntet\'e9sek\'e9nt)! \'c9s aki igazs\'e1gtalanul \'f6letik meg, akkor az \'f5 p
\'e1rtfog\'f3j\'e1nak (legk\'f6zelebbi rokon\'e1nak) hatalmat adtunk [a kiegyenl\'edt\'e9sre, megkegyelmez\'e9sre vagy v\'e1lts\'e1gd\'edj elfogad\'e1s\'e1ra], \'e1m ne legyen m\'e9rt\'e9ktelen az \'f6l\'e9sben! Bizony, \'d5 meg lesz seg\'edtve.
\par 34. \'c9s ne k\'f6zel\'edtsetek az \'e1rva vagyon\'e1hoz, csak a legjobb m\'f3don [meg\'f5rizve \'e9s gyarap\'edtva azt], am\'edg el nem \'e9ri \'e9rett kor\'e1t! \'c9s teljes\'edts\'e9tek az egyezs\'e9get! Bizony az egyezs\'e9g sz\'e1mon lesz k\'e9
rve [rajtatok]!
\par 35. \'c9s tegy\'e9tek teljess\'e9 a kim\'e9r\'e9st (adjatok teljes m\'e9rt\'e9ket), amikor m\'e9rtek \'e9s m\'e9rjetek igazs\'e1gos (pontos) m\'e9rleggel! Ez jobb [nektek] \'e9s szebb kimenetel\'fb.
\par 
\par 36. \'c9s ne j\'e1rj annak nyomdok\'e1ban, amir\'f5l nem rendelkezel tud\'e1ssal! Bizony, a hall\'e1sr\'f3l, a l\'e1t\'e1sr\'f3l \'e9s a sz\'edvr\'f5l \endash  ezekr\'f5l mind sz\'e1mot kell majd adnia [az embernek]!
\par 37. \'c9s ne j\'e1rj kev\'e9lyen a f\'f6ld\'f6n! Bizony, te nem fogod \'e1tt\'f6rni a f\'f6ldet, \'e9s nem fogod el\'e9rni a hegyeket [sem] magass\'e1gban!
\par 38. Mindaz, ami ebb\'f5l rossz, ut\'e1latos a te Urad el\'f5tt.
\par 39. Ez annak a b\'f6lcsess\'e9gnek a r\'e9sze, amit az Urad sugallt [kinyilatkoztat\'e1sk\'e9nt] neked. \'c9s ne helyezz Allah mell\'e9 m\'e1st istent, mert akkor a Gyehenn\'e1ba vettetsz leszidva, kitasz\'edtva!
\par 
\par 40. Vajon a ti }{\insrsid5968634\charrsid15092070 Uratok fi\'fagyermekekkel t\'fcntetett}{\insrsid5968634  ki titeket, }{\insrsid5968634\charrsid8744260 \'e9s n\'f5}{\insrsid5968634 nem\'fbeke}{\insrsid5968634\charrsid8744260 t tett [gyermekeiv\'e9}{
\insrsid5968634 ] az angyalok k\'f6z\'fcl? Bizony, ti sz\'f6rny\'fb szavakat sz\'f3ltok!
\par 41. \'c9s bizony [sokf\'e9le tan\'edt\'e1st] sorakoztattunk fel ebben a Kor\'e1nban, hogy okuljanak [az int\'e9sb\'f5l], de [mindez] nem gyarap\'edtja \'f5ket m\'e1sban, csup\'e1n viszolyg\'e1sban [az igazs\'e1gt\'f3l].
\par 42. Mondd [\'f3 Mohamed]: \'84Ha lenn\'e9nek mellette istenek, ahogyan \'f5k mondj\'e1k, akkor azok bizony utat keresn\'e9nek a Tr\'f3nus Ur\'e1hoz.\'94
\par 43. Magasztaltass\'e9k \'d5! \'c9s [\'d5] afelett van, amit [R\'f3la] mondanak, nagy magasztoss\'e1ggal.
\par 44. \'d5t magasztalja a h\'e9t \'e9g \'e9s a f\'f6ld, \'e9s akik azokban vannak. \'c9s nincs olyan dolog, amely ne \'d5t magasztaln\'e1 az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, ti azonban nem \'e9rtitek az \'f5 magasztal\'e1sukat. \'d5 bizony B\'e9
ket\'fbr\'f5, Megbocs\'e1t\'f3.
\par 
\par 45. \'c9s amikor te [\'f3 Mohamed] a Kor\'e1nt recit\'e1lod, k\'f6z\'e9d \'e9s azok k\'f6z\'e9, akik nem hisznek a T\'falvil\'e1gban egy rejtett v\'e1laszfalat helyezt\'fcnk.
\par 46. \'c9s a sz\'edv\'fckre leplet tesz\'fcnk, hogy ne \'e9rthess\'e9k meg azt, \'e9s a f\'fcl\'fckbe pedig s\'fckets\'e9get. \'c9s amikor Uradat egyetlen [Istenk\'e9nt] eml\'edted meg a Kor\'e1nban, azok viszolyg\'e1sukban h\'e1tat ford\'edtanak.
\par 47. Mi jobban tudjuk azt, hogy mi\'e9rt hallgatnak t\'e9ged, amikor hallgatnak [amint recit\'e1lod a Kor\'e1nt], \'e9s [azt] amikor \'f5k bizalmasan besz\'e9lgetnek, amikor is az igazs\'e1gtalanok azt mondj\'e1k: \'84Ti nem k\'f6vettek m\'e1
st, mint egy var\'e1zslattal s\'fajtott f\'e9rfit.\'94
\par 48. N\'e9zd meg, hogyan adnak r\'f3lad p\'e9ld\'e1zatokat; \'edgy h\'e1t elt\'e9velyedtek \'f5k, \'e9s nem k\'e9pesek [igaz] \'fatra lelni.
\par 
\par 49. \'c9s azt mondt\'e1k: \'84Vajon amikor m\'e1r csontokk\'e1 \'e9s sz\'e9tm\'e1llott r\'e9szekk\'e9 lett\'fcnk, \'faj teremt\'e9sben lesz\'fcnk-e felt\'e1masztva?\'94
\par 50. Mondd [\'f3 Mohamed]: \'84Legyetek k\'f6vek vagy vas,
\par 51. Vagy ak\'e1rmilyen teremtett dolog, ami nagynak (felt\'e1maszthatatlannak) t\'fbnik kebletekben (elm\'e9tekben) [akkor is fel lesztek t\'e1masztva]!\'94 \'c9s azt mondj\'e1k majd: \'84Ki fog minket visszavinni (az \'e9letbe)?\'94 Mondd: \'84
Az, aki az els\'f5 alkalommal l\'e9trehozott titeket!\'94 A fej\'fcket cs\'f3v\'e1lj\'e1k majd fel\'e9d, \'e9s [g\'fanyol\'f3dva] azt mondj\'e1k: \'84Mikor lesz az?\'94 Mondd: \'84Tal\'e1n m\'e1r k\'f6zel van!\'94
\par 52. Azon a napon, amikor [Allah] h\'edv titeket [a felt\'e1mad\'e1sra], ti pedig az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel hallgatok r\'e1, mik\'f6zben azt gondolj\'e1tok, hogy nem id\'f5ztetek [a f\'f6ld\'f6n], csak egy keveset.
\par 
\par 53. \'c9s mondd [\'f3 Mohamed] a szolg\'e1imnak, hogy mondj\'e1k azt, ami a legjobb! }{\insrsid5968634\charrsid8744260 Bizony, a s\'e1t\'e1n visz\'e1lyt sz\'edt k\'f6zt\'fck. Bizony, a s\'e1t\'e1n az ember nyilv\'e1nval\'f3 ellens\'e9ge.}{\insrsid5968634 

\par 54. Uratok jobban ismer titeket! Ha \'fagy akarja megk\'f6ny\'f6r\'fcl rajtatok, \'e1m ha \'fagy akarja gy\'f6trelemmel s\'fajt titeket. Nem az\'e9rt k\'fcldt\'fcnk el t\'e9ged [\'f3 Mohamed], hogy v\'e9delmez\'f5j\'fck legy\'e9l.
\par 55. \'c9s az Urad jobban ismeri azokat, akik az egekben \'e9s a f\'f6ld\'f6n vannak. \'c9s bizony, egyes pr\'f3f\'e9t\'e1kat el\'f5nyben r\'e9szes\'edtett\'fcnk m\'e1sokkal szemben. \'c9s D\'e1vidnak Zsolt\'e1rokat (Zab\'far) adtunk.
\par 56. Mondd [\'f3 Mohamed]: \'84H\'edvj\'e1tok [seg\'edts\'e9g\'fcl] azokat, akikr\'f5l azt \'e1ll\'edtott\'e1tok, hogy [\'f5k istens\'e9gek] \'d5rajta k\'edv\'fcl! Nem \'e1ll m\'f3djukban elh\'e1r\'edtani az \'e1rtalmat (betegs\'e9get), sem pedig megm\'e1s
\'edtani (\'e1thelyezni m\'e1sra).\'94
\par 
\par 57. Akiket [seg\'edts\'e9g\'fcl] h\'edvnak, azok [j\'f3 cselekedet\'fckkel] az Urukhoz val\'f3 [k\'f6zeled\'e9s] eszk\'f6z\'e9t \'e1h\'edtozz\'e1k, [versenyezve] melyik\'fck lesz k\'f6zelebb [Allahhoz]. \'c9s rem\'e9lik az \'d5 k\'f6ny\'f6r\'fclet\'e9t, 
\'e9s f\'e9lik a }{\insrsid5968634\charrsid8744260 gy\'f6trelm\'e9t (b\'fcntet\'e9s\'e9t).}{\insrsid5968634  Bizony, az Urad gy\'f6trelm\'e9t\'f5l \'f3vakodni kell.
\par 58. \'c9s nincs egyetlen [hitetlen] telep\'fcl\'e9s sem, amelyet a Felt\'e1mad\'e1s Napja el\'f5tt el ne puszt\'edtan\'e1nk, vagy s\'falyos gy\'f6trelemmel meg ne b\'fcntetn\'e9nk. Ez egy \'cdr\'e1sban (az \'d5rz\'f6tt T\'e1bl\'e1n) van feljegyezve.

\par 
\par 59. \'c9s semmi nem tartott Minket vissza att\'f3l, hogy jeleket k\'fcldj\'fcnk [amikor a hitetlenek k\'f6vetelt\'e9k azokat], csak az, hogy a hajdanvoltak meghazudtolt\'e1k azokat. \'c9s [p\'e9ld\'e1ul] Tam\'fadnak egy n\'f5st\'e9ny tev\'e9t adtunk, l
\'e1that\'f3 jelk\'e9nt (egy\'e9rtelm\'fb csodak\'e9nt), \'e1m \'f5k igazs\'e1gtalans\'e1got k\'f6vettek el ellene. \'c9s nem k\'fcld\'fcnk el jeleket csak az\'e9rt}{\insrsid5968634\charrsid8744260 , hogy}{\insrsid5968634  f\'e9lelmet kelts\'fc
nk (elrettent\'e9sk\'e9nt).
\par 60. }{\insrsid5968634\charrsid8744260 \'c9s [eml\'e9kezz arra, \'f3 Mohamed] amikor azt mondtuk neked: \'84A te Urad [tud\'e1s\'e1val \'e9s hatalm\'e1val] k\'f6rbeveszi az embereket.\'94 \'c9s nem tett\'fck}{\insrsid5968634  meg a l\'e1tom\'e1
st, amelyet l\'e1ttattunk veled m\'e1s\'e9rt, csup\'e1n k\'eds\'e9rt\'e9snek az emberek sz\'e1m\'e1ra, \'e9s az \'e1tkozott f\'e1t [is] a Kor\'e1nban. A f\'e9lelmet akarjuk fel\'e9breszteni benn\'fck, \'e1m ez nem gyarap\'edtja \'f5ket m\'e1sban, }{
\insrsid5968634\charrsid14050257 csup\'e1n nagy t\'falkap\'e1sban.}{\insrsid5968634 
\par 
\par 61. \'c9s [eml\'edtsd meg,] amikor azt mondtuk az angyaloknak: \'84Boruljatok le \'c1d\'e1m el\'f5tt!\'94 Leborultak \'f5k, kiv\'e9ve Ibl\'edsz-t, [aki] azt mondta: \'84Vajon olyasvalaki el\'f5tt boruljak le, akit agyagb\'f3l teremtett\'e9l?\'94
\par 62. [Ibl\'edsz] azt mondta: \'84Vajon l\'e1ttad-e azt, akinek a rangj\'e1t f\'f6l\'e9m emelted? Ha halad\'e9kot adsz nekem a Felt\'e1mad\'e1s Napj\'e1ig, akkor bizony az ut\'f3daikat - kev\'e9s kiv\'e9tellel - k\'f6t\'f5f\'e9kkel fogom vezetni.\'94
\par 63. [Allah] azt mondta: \'84Menj, \'e9s akik k\'f6vetnek t\'e9ged k\'f6z\'fcl\'fck, bizony a Gyehenna lesz a fizets\'e9getek, b\'f5s\'e9ges fizets\'e9gk\'e9nt!
\par 64. \'c9s hergeld fel hangoddal (sugdos\'e1soddal), akit csak b\'edrsz k\'f6z\'fcl\'fck, \'e9s t\'e1madj r\'e1juk a lovass\'e1goddal \'e9s a gyalogs\'e1goddal \'e9s l\'e9gy a t\'e1rsuk a vagyonukban \'e9s a gyermekeikben! \'c9s \'edg\'e9rgess nekik!\'94 
\'c1m a s\'e1t\'e1n nem \'edg\'e9r nekik m\'e1st, csup\'e1n megt\'e9veszt\'e9st.
\par 65. \'84Bizony, a szolg\'e1im felett nem rendelkezel hatalommal.\'94 \'c9s a te Urad elegend\'f5 v\'e9delmez\'f5nek!
\par 
\par 66. Az Uratok az, aki hajtja nektek a haj\'f3kat a tengeren, hogy az \'d5 kegy\'e9t keress\'e9tek. Bizony, \'d5 Irgalmas ir\'e1ntatok.
\par }{\insrsid5968634\charrsid14050257 67. Ha \'e1rtalom \'e9r titeket a tengeren, elt\'fbnnek azok, akikhez foh\'e1szkodtok, kiv\'e9ve \'d5t! \'c9s amikor kiment titeket a sz\'e1razf\'f6ldre, elfordultok. \'c9s az ember [mindig] h\'e1l\'e1tlan volt.
\par }{\insrsid5968634 68. Vajon h\'e1t biztons\'e1gban \'e9rzitek magatok azzal szemben, hogy Allah egyszer csak els\'fcllyeszti alattatok a sz\'e1razf\'f6ld oldal\'e1t, vagy hogy kavicssz\'f3r\'f3 [sz\'e9lvihart] k\'fcld r\'e1tok, majd nem tal\'e1ln\'e1
tok sz\'e1motokra v\'e9delmez\'f5t?
\par 69. Avagy biztons\'e1gban \'e9rzitek magatok azzal szemben, hogy visszavisz titeket egy m\'e1sik alkalommal [a tengerbe], \'e9s puszt\'edt\'f3 sz\'e9lvihart k\'fcld r\'e1tok, \'e9s belefullaszt titeket [a tengerbe] az\'e9rt, mert hitetlenn\'e9 v\'e1
ltatok? Majd pedig nem tal\'e1ltok senkit, aki emiatt b\'e1rmit is k\'f6vetelhetne r\'e9szetekre Vel\'fcnk szemben.
\par 70. \'c9s bizony tiszteletre m\'e9lt\'f3 helyet adtunk \'c1d\'e1m gyermekeinek, \'e9s hordoztuk \'f5ket a sz\'e1razf\'f6ld\'f6n \'e9s a tengeren, \'e9s ell\'e1ttuk \'f5ket a j\'f3 dolgokb\'f3l, \'e9s f\'f6l\'e9nyes el\'f5nyben r\'e9szes\'edtett\'fck \'f5
ket sokakkal szemben azok k\'f6z\'fcl, akiket teremtett\'fcnk.
\par 
\par 71. [Eml\'edtsd meg, \'f3 Mohamed] azt a napot, amikor minden embert [a tetteit tartalmaz\'f3] \'edr\'e1s\'e1val h\'edvunk! \'c9s akinek az \'edr\'e1sa a jobbj\'e1ba adatik \endash  \'e9s azok olvass\'e1k az \'edr\'e1sukat, \'e9s annyi igazs\'e1gtalans
\'e1got sem fognak elszenvedni, mint a [datolyamagon l\'e9v\'f5] rost.
\par 72. \'c9s aki vak ebben (az evil\'e1gon), az a t\'falvil\'e1gon is vak lesz, \'e9s m\'e9g ink\'e1bb elt\'e9velyedik az [egyenes] \'fatt\'f3l.
\par 73. \'c9s \'f5k majdnem k\'eds\'e9rt\'e9sbe vittek t\'e9ged, [hogy elford\'edtsanak] att\'f3l, amit [kinyilatkoztat\'e1sk\'e9nt] sugalltunk neked, hogy kital\'e1lj R\'f3lunk valami m\'e1st, \'e9s akkor bizony bar\'e1tjukk\'e1 tettek volna t\'e9ged.
\par 74. \'c9s ha nem er\'f5s\'edtett\'fcnk volna meg t\'e9ged, akkor bizony egy kiss\'e9 m\'e1r hajlott\'e1l volna fel\'e9j\'fck.
\par 75. Akkor bizony az \'e9let k\'e9tszeres \'e9s a hal\'e1l k\'e9tszeres [gy\'f6trelm\'e9t] \'edzleltett\'fck volna meg veled. Azt\'e1n nem tal\'e1ln\'e1l sz\'e1modra seg\'edt\'f5t Vel\'fcnk szemben.
\par 76. \'c9s majdnem elriasztottak t\'e9ged a f\'f6ldr\'f5l (Mekk\'e1b\'f3l), hogy el\'fbzzenek onnan. \'c1m nem id\'f5ztek volna [ott] teut\'e1nad, csak egy keveset.
\par 77. [Ekk\'e9ppen rendelt\'fck el] t\'f6rv\'e9nyszer\'fbs\'e9gk\'e9nt [azt, amiben r\'e9szes\'edtett\'fck] azokat, akiket teel\'f5tted k\'fcldt\'fcnk el. \'c9s nem tal\'e1lsz [semmif\'e9le] megm\'e1s\'edt\'e1st a Mi [\'e1ltalunk elrendelt] t\'f6rv\'e9
nyszer\'fbs\'e9gben [ahogyan elj\'e1runk azokkal, akik el\'fbzik a pr\'f3f\'e9t\'e1jukat].
\par 
\par 78. Tartsd meg az im\'e1dkoz\'e1st a Nap [a zenitt\'f5l val\'f3] elmozdul\'e1s\'e1t\'f3l az \'e9jszaka s\'f6t\'e9ts\'e9g\'e9nek be\'e1llt\'e1ig! \'c9s [tartsd meg] a hajnali Kor\'e1n-recit\'e1l\'e1st [a hajnali im\'e1dkoz\'e1s sor\'e1
n]! Bizony, a hajnali Kor\'e1n-recit\'e1l\'e1sr\'f3l tan\'fas\'e1g t\'e9tetik.
\par 79. \'c9s az \'e9jszaka egy r\'e9sz\'e9ben [im\'e1dkozva] virrassz\'e1l vele (a Kor\'e1n recit\'e1l\'e1s\'e1val) k\'f6teless\'e9gen fel\'fcli cselekedetk\'e9nt r\'e9szedr\'f5l! Tal\'e1n az Urad dics\'e9retes rangra t\'e1maszt fel t\'e9ged!
\par 80. \'c9s mondd: \'84Uram, bocs\'e1ss be [abba, ami j\'f3 nekem] igaz bemenetellel \'e9s vigy\'e9l ki [abb\'f3l, ami rossz nekem] igaz kimenetellel, \'e9s adj nekem T\'f5led sz\'e1rmaz\'f3 seg\'edt\'f5 hatalmat!\'94
\par 81. \'c9s mondd: \'84Elj\'f6tt az igazs\'e1g, \'e9s elsz\'e1llt a hamiss\'e1g! Bizony a hamiss\'e1g mindig elsz\'e1ll.\'94
\par 82. \'c9s lebocs\'e1tunk a Kor\'e1nb\'f3l olyat, ami gy\'f3gyul\'e1s \'e9s k\'f6ny\'f6r\'fclet a h\'edv\'f5knek. \'c9s ez nem gyarap\'edtja az igazs\'e1gtalanokat, csup\'e1n vesztes\'e9gben.
\par 
\par 83. \'c9s amikor j\'f3t\'e9tem\'e9nyben r\'e9szes\'edtj\'fck az embert, az [h\'e1l\'e1tlanul] elfordul \'e9s [\'f6ntelten] oldalazva t\'e1vozik. \'c9s amikor rossz \'e9ri, akkor rem\'e9nyvesztett.
\par 84. Mondd [\'f3 Mohamed]: \'84Mindenki a maga m\'f3dj\'e1n cselekszik, \'e9s a ti Uratok tudja a legjobban, hogy ki van a legink\'e1bb az egyenes \'faton vezetve!\'94
\par 85. \'c9s k\'e9rdeznek t\'e9ged [\'f3 Mohamed] a l\'e9lekr\'f5l. Mondd: \'84A l\'e9lek az \'e9n Uram [azon] \'fcgyeihez tartozik [amelyet egyed\'fcl \'d5 ismer], \'e9s nem adatott nektek a tud\'e1sb\'f3l, csak kev\'e9snyi.\'94
\par 86. \'c9s bizony, ha akarn\'e1nk, akkor elt\'f6r\'f6ln\'e9nk azt, amit [kinyilatkoztat\'e1sk\'e9nt] sugalltunk neked, azt\'e1n nem tal\'e1ln\'e1l ezen \'fcgyben v\'e9delmez\'f5t sz\'e1modra Vel\'fcnk szemben.
\par 87. Csakis Uradt\'f3l sz\'e1rmaz\'f3 k\'f6ny\'f6r\'fcletb\'f5l [nem tesz\'fcnk \'edgy], bizony nagy az \'d5 kegye teir\'e1ntad!
\par 
\par 88. Mondd: \'84Bizony, ha \'f6sszegy\'fbln\'e9nek a dzsinnek \'e9s az emberek, hogy ehhez a Kor\'e1nhoz hasonl\'f3val \'e1lljanak el\'f5, nem lenn\'e9nek k\'e9pesek ehhez hasonl\'f3val el\'f5\'e1llni, m\'e9g ha egyik\'f5j\'fck a m\'e1siknak seg\'edt\'f5
je is lenne.\'94
\par 89. \'c9s bizony ebben a Kor\'e1nban mindenf\'e9le p\'e9ld\'e1zatot sorakoztattunk fel az embereknek. \'c1m a legt\'f6bb ember rend\'edthetetlen a hitetlens\'e9gben.
\par 
\par 90. \'c9s azt mondt\'e1k: \'84Nem hisz\'fcnk neked addig, am\'edg nem fakasztasz nek\'fcnk forr\'e1st a f\'f6ldb\'f5l. 
\par 91. Vagy [am\'edg] nem lesz egy kerted p\'e1lmaf\'e1kkal \'e9s sz\'f5l\'f5kkel, majd azok k\'f6z\'f6tt v\'edzben gazdag foly\'f3kat nem fakasztasz.
\par 92. Vagy [am\'edg] r\'e1nk [nem] hullajtod az eget darabokban, ahogyan azt \'e1ll\'edtottad, vagy elhozod el\'e9nk Allahot \'e9s az angyalokat.
\par 93. Vagy lesz egy [arannyal] \'e9kes\'edtett h\'e1zad, vagy [am\'edg nem] m\'e9sz fel az \'e9gbe, \'e1m nem fogunk hinni a felmeneteledben [addig], am\'edg \'edr\'e1st nem bocs\'e1tasz le nek\'fcnk, amit olvashatunk!\'94 }{\insrsid5968634\charrsid3369223 
Mondd [\'f3 Mohamed]:}{\insrsid5968634  \'84Magasztaltass\'e9k az \'e9n Uram! Vajon vagyok-e m\'e1s, mint ember [\'e9s] k\'fcld\'f6tt?\'94
\par 94. \'c9s nem akad\'e1lyozta meg [m\'e1s] az embereket abban, hogy higgyenek - amikor elj\'f6tt hozz\'e1juk az \'datmutat\'e1s - mint az, hogy [kifog\'e1sk\'e9nt] azt mondt\'e1k}{\insrsid5968634\charrsid3369223 : \'84Vajon Allah embert t\'e1masztott k\'fc
ld\'f6ttnek?\'94}{\insrsid5968634 
\par 95. Mondd: \'84Ha angyalok lenn\'e9nek a f\'f6ld\'f6n, akik nyugalomban j\'e1rn\'e1nak, akkor bizony angyalt bocs\'e1tottunk volna le hozz\'e1juk az \'e9gb\'f5l k\'fcld\'f6ttk\'e9nt.\'94
\par 96. Mondd: \'84Allah elegend\'f5 tan\'fa k\'f6ztem \'e9s k\'f6ztetek.\'94 Bizony, \'d5 j\'f3l ismeri \'e9s \'e1tl\'e1tja a szolg\'e1it.\'94
\par 
\par 97. Akit Allah [igaz] \'fatra vezet, az lel az [igaz] \'fatra, akit pedig a t\'e9velyg\'e9sbe visz, azok sz\'e1m\'e1ra nem tal\'e1lhatsz p\'e1rtfog\'f3kat rajta k\'edv\'fcl. \'c9s mi egybegy\'fbjtj\'fck \'f5ket a Felt\'e1mad\'e1s Napj\'e1n az arcukon [h
\'fazva] vakon, n\'e9m\'e1n \'e9s s\'fcketen. A hajl\'e9kuk a [Pokol-]t\'fbz lesz. Valah\'e1nyszor }{\insrsid5968634\charrsid14050257 lankad [a t\'fbz], gyarap\'edtjuk}{\insrsid5968634  \'f5ket L\'e1ngol\'f3 [Pokol-t\'fbzzel].
\par 98. Ez az \'f5 fizets\'e9g\'fck az\'e9rt, }{\insrsid5968634\charrsid14050257 mert hitetlenek voltak a jeleinkkel szemben, \'e9s}{\insrsid5968634  azt mondt\'e1k: \'84Vajon amikor m\'e1r csontokk\'e1 \'e9s sz\'e9tm\'e1llott r\'e9szekk\'e9 lett\'fcnk, \'fa
j teremt\'e9sben lesz\'fcnk-e felt\'e1masztva?\'94
\par 99. H\'e1t vajon nem l\'e1tt\'e1k, hogy Allah, aki megteremtette az egeket \'e9s a f\'f6ldet, k\'e9pes arra, hogy hozz\'e1juk hasonl\'f3kat teremtsen? Olyan hat\'e1rid\'f5t szabott meg nekik, amihez nem f\'e9r k\'e9ts\'e9g. \'c1m az igazs\'e1gtalanok rend
\'edthetetlenek a hitetlens\'e9gben.
\par 100. Mondd [\'f3 Mohamed]: \'84Ha birtokoln\'e1tok az \'e9n Uram k\'f6ny\'f6r\'fclet\'e9nek t\'e1rh\'e1zait, akkor megtartan\'e1tok [magatoknak] az elk\'f6lt\'e9s\'e9t\'f5l val\'f3 f\'e9lelemb\'f5l}{\insrsid5968634\charrsid14050257 . \'c9
s az ember [mindig] sz\'fbkmark\'fa volt!\'94}{\insrsid5968634 
\par 
\par 101. \'c9s bizony kilenc vil\'e1gos jelet adtunk M\'f3zesnek \endash  k\'e9rdezd h\'e1t meg Izrael gyermekeit [arr\'f3l, hogy] \endash  amikor elj\'f6tt hozz\'e1juk [M\'f3zes], \'e9s azt mondta neki a F\'e1ra\'f3: \'84\'c9n bizony t\'e9ged \endash  \'f3 M
\'f3zes \endash  var\'e1zslattal s\'fajtottnak v\'e9llek!\'94
\par 102. Azt mondta [M\'f3zes]: \'84Bizony, tudod m\'e1r, hogy ezeket nem bocs\'e1totta le m\'e1s, csak az egek \'e9s a f\'f6ld Ura, tiszt\'e1nl\'e1t\'e1st ad\'f3 bizony\'edt\'e9kokk\'e9nt. \'c9s \'e9n bizony t\'e9ged \endash  \'f3 F\'e1ra\'f3 \endash 
 pusztul\'e1sra \'edt\'e9ltnek v\'e9llek!\'94
\par 103. \'c9s \'f5 [a F\'e1ra\'f3] el akarta riasztani \'f5ket a f\'f6ldr\'f5l (Egyiptomb\'f3l), Mi azonban v\'edzbe fullasztottuk \'f5t \'e9s azokat, akik vele voltak, mindannyiukat.
\par 104. \'c9s \'f5ut\'e1na (a F\'e1ra\'f3 pusztul\'e1sa ut\'e1n) azt mondtuk Izrael gyermekeinek: \'84Lakjatok a [Szent] f\'f6ld\'f6n! S amikor elj\'f6n a T\'falvil\'e1g \'edg\'e9rete, [egyetlen] \'f6sszekeveredett t\'f6megk\'e9nt hoz majd el\'f5
 titeket [az \'edt\'e9letre].\'94
\par 
\par 105. \'c9s az Igazs\'e1ggal bocs\'e1tottuk le azt (a Kor\'e1nt), \'e9s az Igazs\'e1ggal \'e9rkezett le. \'c9s nem k\'fcldt\'fcnk el t\'e9ged, csup\'e1n \'f6r\'f6mh\'edrhoz\'f3k\'e9nt \'e9s figyelmeztet\'f5k\'e9nt.
\par 106. \'c9s Kor\'e1nt [bocs\'e1tottunk le, amelyet] vil\'e1gosan magyar\'e1ztunk, hogy siets\'e9g n\'e9lk\'fcl recit\'e1ld azt az embereknek, \'e9s r\'e9szletenk\'e9nt lebocs\'e1tott [kinyilatkoztat\'e1sul] bocs\'e1tottuk azt le.
\par 107. Mondd [\'f3 Mohamed]: \'84Higgyetek benne, vagy ne higgyetek!\'94 Bizony, azok, akiknek azel\'f5tt a tud\'e1s adatott, amikor recit\'e1ltatik nekik, arcukkal f\'f6ldre rogynak leborulva.
\par 108. \'c9s azt mondj\'e1k: \'84Magasztaltass\'e9k az Urunk! Bizony, a mi Urunk \'edg\'e9rete beteljesedik!\'94
\par 109. \'c9s arcukkal f\'f6ldre rogynak s\'edrva, \'e9s [a Kor\'e1n] gyarap\'edtja \'f5ket \'e1h\'edtatban.
\par 110. Mondd: \'84Foh\'e1szkodjatok Allahhoz, vagy foh\'e1szkodjatok a K\'f6ny\'f6r\'fcleteshez! B\'e1rmelyik [n\'e9ven] is h\'edvj\'e1tok, \'d5t illetik meg a Legszebb Nevek. Ne [recit\'e1ld a Kor\'e1nt] hangosan az im\'e1dkoz\'e1sodban, se ne [recit\'e1
ld] t\'fal halkan, hanem keress utat a kett\'f5 k\'f6z\'f6tt!\'94
\par 111. \'c9s mondd: \'84A h\'e1latelt dics\'e9ret Allahot illeti, aki nem tett meg [senkit] fi\'fagyermek\'e9v\'e9, \'e9s nem volt neki t\'e1rsa a kir\'e1lyi uralomban, \'e9s nem volt neki [sz\'fcks\'e9ge arra, hogy] p\'e1rtfog\'f3ja [legyen, aki megv\'e9
den\'e9] a megal\'e1zotts\'e1gt\'f3l!\'94 \'c9s magasztald az \'d5 nagys\'e1g\'e1t!
\par \page }{\insrsid5968634\charrsid5509263 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\f0\fs24\insrsid5968634\charrsid5968634 18. sz\'fara \endash  A Barlang (al-Kehf) c. sz\'fara}{\insrsid5968634\charrsid5968634 
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 A K\'f6ny\'f6r\'fcletes, az Irgalmas Allah nev\'e9ben.
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 1. A h\'e1latelt dics\'e9ret }{\insrsid5968634\charrsid14050257 Allahot illeti, aki lebocs\'e1totta}{\insrsid5968634  szolg\'e1j\'e1
nak az \'cdr\'e1st, \'e9s nem helyezett abba elhajl\'e1st.
\par 2. Egyenes [\'edr\'e1sk\'e9nt], hogy figyelmeztessen egy T\'f5le sz\'e1rmaz\'f3 s\'falyos csap\'e1sra, \'e9s hogy \'f6r\'f6mh\'edrt hozzon a h\'edv\'f5knek, akik j\'f3 cselekedeteket tesznek}{\insrsid5968634\charrsid14050257 , arr\'f3l, hogy}{
\insrsid5968634  nekik sz\'e9p jutalom j\'e1r,
\par 3. Amelyben \'f6r\'f6kre ott maradnak.
\par 4. \'c9s hogy figyelmeztesse azokat, akik azt mondj\'e1k: \'84Allah gyermek\'e9v\'e9 tett [valakit].\'94
\par 5. Nincs nekik err\'f5l tud\'e1suk, sem az \'f5saty\'e1iknak. Nagy (s\'falyos) sz\'f3 az, mely elhagyta a sz\'e1jukat. Nem mondanak \'f5k m\'e1st, mint hazugs\'e1got.
\par 6. [\'d3 Mohamed] h\'e1t ne puszt\'edtsd el magad a b\'e1natt\'f3l [az elfordul\'e1suk] nyom\'e1n, ha nem hisznek ebben a besz\'e9dben (a Kor\'e1nban)!
\par 
\par 7. Bizony, Mi mindazt, ami a f\'f6ld\'f6n van, annak \'e9kess\'e9g\'e9v\'e9 tett\'fck, az\'e9rt, hogy pr\'f3b\'e1nak vess\'fck \'f5ket al\'e1: }{\insrsid5968634\charrsid14050257 melyik\'fcknek jobb a cselekedete.}{\insrsid5968634 
\par 8. \'c9s bizony Mi, azt ami rajta van, kop\'e1r talajj\'e1 tessz\'fck.
\par 
\par 9. Vagy azt gondolod a barlang \'e9s a felirat embereir\'f5l, hogy a mi jeleink k\'f6z\'f6tt csodasz\'e1mba mentek?
\par 10. [Eml\'edtsd meg azt,] amikor az ifjak megh\'fazt\'e1k magukat a barlangban, \'e9s azt mondt\'e1k: \'84Urunk! Adj nek\'fcnk a T\'f5led sz\'e1rmaz\'f3 k\'f6ny\'f6r\'fcletb\'f5l \'e9s rendelj el sz\'e1munkra helyes [kiutat] az \'fcgy\'fcnkb\'f5l!\'94

\par 11. S f\'fcl\'fckre [leplet] vetett\'fcnk (m\'e9ly \'e1lmot bocs\'e1tottunk r\'e1juk) a barlangban sz\'e1mos \'e9vre.
\par 12. Majd felt\'e1masztottuk \'f5ket, hogy megtudjuk (felfedj\'fck) a k\'e9t csoport k\'f6z\'fcl melyik sz\'e1ml\'e1lta jobban azt az id\'f5t, amelyet elt\'f6lt\'f6ttek.
\par 13. Mi az Igazs\'e1gnak megfelel\'f5en besz\'e9lj\'fck el neked a h\'edr\'fcket (t\'f6rt\'e9net\'fcket). Bizony, \'f5k ifjak [voltak], akik hittek Urukban, s Mi gyarap\'edtottuk \'f5ket \'fatmutat\'e1sban.
\par 14. \'c9s meger\'f5s\'edtett\'fck a sz\'edv\'fcket, amikor fel\'e1lltak \'e9s azt mondt\'e1k: \'84A mi Urunk, az egek \'e9s a f\'f6ld Ura. Mi nem fogunk Rajta k\'edv\'fcl m\'e1s istenhez foh\'e1szkodni. Bizony, akkor [az igazs\'e1gt\'f3l] t\'e1vol \'e1ll
\'f3t mondan\'e1nk.
\par 15. Ezek [az emberek] a mi n\'e9p\'fcnk, \'d5helyette [m\'e1sokat] tettek istens\'e9geikk\'e9. H\'e1t mi\'e9rt nem hoznak nyilv\'e1nval\'f3 bizony\'edt\'e9kot azok [szolg\'e1lat\'e1ra]? \'c9s ki igazs\'e1gtalanabb ann\'e1l, mint aki hazugs\'e1got tal\'e1
l ki Allah ellen?
\par 16. \'c9s amikor [m\'e1r] t\'e1vol tartott\'e1tok magatokat t\'f5l\'fck \'e9s att\'f3l, amit Allah helyett szolg\'e1lnak, h\'fazz\'e1tok h\'e1t meg magatokat a barlangban! Kit\'e1r nektek Uratok a k\'f6ny\'f6r\'fclet\'e9b\'f5l, \'e9s elrendel sz\'e1
motokra hasznot az \'fcgyetekben.\'94
\par 
\par 17. \'c9s l\'e1thatn\'e1d a Napot, amikor f\'f6lkel, akkor barlangjukt\'f3l jobbra hajlik el, \'e9s amikor lenyugszik, akkor balra halad el mellett\'fck, mik\'f6zben annak t\'e1gas helys\'e9g\'e9ben vannak. Ez Allah jelei k\'f6z\'fcl val\'f3
. Akit Allah [igaz] \'fatra vezet, az lel az [igaz] \'fatra, akit pedig t\'e9velyg\'e9sbe visz, annak nem tal\'e1lsz helyes \'fatra vezet\'f5 p\'e1rtfog\'f3t.
\par 18. \'c9s azt gondoln\'e1d r\'f3luk, hogy \'e9bren vannak, holott \'f5k alszanak, \'e9s jobb \'e9s bal [oldalukra] ford\'edtjuk \'f5ket. A kuty\'e1juk pedig el\'f5reny\'fajtja mells\'f5 l\'e1bait a bej\'e1ratn\'e1l. Ha r\'e1juk tekinten\'e9
l, akkor bizony menek\'fclve ford\'edtan\'e1l h\'e1tat nekik, \'e9s f\'e9lelem t\'f6ltene el miattuk.
\par 19. \'c9s [ahogyan elaltattuk \'f5ket] akk\'e9ppen t\'e1masztottuk fel \'f5ket, hogy k\'e9rdez\'f5sk\'f6djenek egym\'e1s k\'f6z\'f6tt. Sz\'f3lott egy sz\'f3l\'f3 k\'f6z\'fcl\'fck: \'84Mennyit id\'f5ztetek?\'94 [N\'e9h\'e1nyan] azt mondt\'e1k: \'84
Egy napot id\'f5zt\'fcnk, vagy a napnak egy r\'e9sz\'e9t\'94. [M\'e1sok] azt mondt\'e1k: \'84Uratok tudja a legjobban, hogy mennyit id\'f5ztetek. K\'fcldj\'e9tek h\'e1t el egyik\'f5t\'f6ket ezen ez\'fcstp\'e9nzetekkel a v\'e1rosba, \'e9s n\'e9
zze meg, hogy melyik a legtiszt\'e1bb \'e9tel, \'e9s hozzon nektek ell\'e1t\'e1st abb\'f3l, \'e1m legyen kedves! \'c9s ne keltse fel egyik\'f5t\'f6kre se a figyelmet!
\par 20. Bizony, \'f5k ha tudom\'e1st szereznek r\'f3latok, megk\'f6veznek titeket vagy visszat\'e9r\'edtenek a vall\'e1sukra, \'e9s akkor sosem fogtok boldogulni!\'94
\par 
\par 21. \'c9s [ahogyan felt\'e1masztottuk \'f5ket] ekk\'e9ppen vezett\'fck [az embereket] a nyomukra, hogy megtudj\'e1k, hogy Allah \'edg\'e9rete igaz, \'e9s hogy az \'d3r\'e1hoz }{\insrsid5968634\charrsid14050257 nem f\'e9r k\'e9ts\'e9g. [Eml\'ed
tsd meg azt,] amikor \'f6sszek\'fcl\'f6nb\'f6ztek [az emberek] az \'fcgy\'fckkel kapcsolatban, azt mondt\'e1k: \'84\'c9p\'edtsetek f\'f6l\'e9j\'fck egy \'e9p\'edtm\'e9nyt! Az Uruk ismeri \'f5ket a legjobban.\'94 Azok,}{\insrsid5968634 
 akiknek teljhatalmuk volt az \'fcgy\'fckben, azt mondt\'e1k: \'84Bizony, imahelyet emel\'fcnk f\'f6l\'e9j\'fck!\'94
\par 22. Azt fogj\'e1k mondani: \'84H\'e1rman voltak, a negyedik\'fck a kuty\'e1juk volt.\'94 \'c9s azt mondj\'e1k: \'84\'d6ten voltak, a hatodikuk a kuty\'e1juk volt\'94 \endash  tal\'e1lgatva a rejtett dolgokat. \'c9s azt mondj\'e1k: \'84Heten voltak \'e9
s a kuty\'e1juk a nyolcadik volt.\'94 Mondd [\'f3 Mohamed]: \'84Az Uram tudja a legjobban, hogy h\'e1nyan voltak.\'94 Csup\'e1n kevesen tudj\'e1k azt. Ne vit\'e1zz h\'e1t vel\'fck kapcsolatban, csak arr\'f3l, ami nyilv\'e1nval\'f3 (amit elbesz\'e9lt\'fc
nk neked r\'f3luk), \'e9s ne is k\'e9rj felvil\'e1gos\'edt\'e1st r\'f3luk senkit\'f5l k\'f6z\'fcl\'fck!
\par 
\par 23. \'c9s ne mondd azt egy dologr\'f3l: \'84Bizony, \'e9n holnap megteszem azt\'94,
\par 24. Hacsak [hozz\'e1 nem teszed]: \'84Ha Allah \'fagy akarja!\'94 \'c9s eml\'e9kezz meg Uradr\'f3l, ha elfelejted, \'e9s mondd: \'84Tal\'e1n Uram arra vezet engem, ami enn\'e9l is k\'f6zelebb van a helyes [\'fathoz]!\'94
\par 
\par 25. \'c9s a barlangjukban h\'e1romsz\'e1z [nap]\'e9vig id\'f5ztek, \'e9s [hold\'e9vekben sz\'e1molva] m\'e9g kilenccel gyarapodtak [az \'e9vek].
\par 26. Mondd: \'84Allah tudja a legjobban, mennyit id\'f5ztek! \'d6v\'e9 az egek \'e9s a f\'f6ld rejtett dolgainak tud\'e1sa. Milyen t\'f6k\'e9letes \'d5 a l\'e1t\'e1st \'e9s a hall\'e1st illet\'f5en! Nincs nekik Rajta k\'edv\'fcl p\'e1rtfog\'f3juk, \'e9s 
\'d5 nem osztozik az \'edt\'e9lkez\'e9s\'e9ben senkivel.\'94
\par 
\par 27. \'c9s recit\'e1ld [\'f3 Mohamed] azt, ami [kinyilatkoztat\'e1sk\'e9nt] sugalltatott neked Urad \'cdr\'e1s\'e1b\'f3l! Nincs, aki megv\'e1ltoztathatn\'e1 az \'d5 szavait, \'e9s nem fogsz Rajta k\'edv\'fcl [m\'e1sn\'e1l] mened\'e9kre lelni.
\par 28. \'c9s tarts \'e1llhatatosan azokkal, akik Urukhoz foh\'e1szkodnak a napkelte el\'f5tt \'e9s naplemente el\'f5tt, az \'d5 arc\'e1t \'e1h\'edtozva! \'c9s ne ker\'fclje el a tekinteted \'f5ket az evil\'e1gi \'e9let \'e9kess\'e9geit \'e1h\'edtozv\'e1n, 
\'e9s ne engedelmeskedj annak, akinek figyelmetlenn\'e9 tett\'fck a sz\'edv\'e9t a R\'f3lunk val\'f3 megeml\'e9kez\'e9sr\'f5l, \'e9s [aki] a k\'e9ny\'e9t k\'f6veti \'e9s [akinek] minden \'fcgye szerte van sz\'f3r\'f3dva!
\par 
\par 29. \'c9s mondd: \'84Az Igazs\'e1g [amit elhoztam] az Uratokt\'f3l sz\'e1rmazik. Legyen h\'e1t h\'edv\'f5 az, aki akar, \'e9s legyen hitetlen az, aki akar!\'94 Bizony, mi el\'f5k\'e9sz\'edtett\'fcnk az igazs\'e1gtalanoknak olyan t\'fczet, amelynek falai k
\'f6r\'fclveszik \'f5ket, \'e9s ha seg\'edts\'e9get k\'e9rnek, akkor }{\insrsid5968634\charrsid16085752 vizet kapnak seg\'edts\'e9g\'fcl, amely olyan, mint az olvasztott \'e9rc}{\insrsid5968634 , amely megs\'fcti az arcokat. Milyen nyomor\'fas\'e1
gos ital ez, \'e9s milyen rossz pihen\'f5hely.
\par 30. Bizony azok, akik hisznek \'e9s j\'f3tetteket cselekszenek, [mert] bizony mi nem vessz\'fck el a jutalm\'e1t }{\insrsid5968634\charrsid8722313 azoknak, akik j\'f3tev\'f5en cselekszenek,
\par 31. Azoknak \'f6r\'f6kk\'e9 tart\'f3 kertek j\'e1rnak}{\insrsid5968634 , melyek al\'f3l foly\'f3k folynak. Aranyb\'f3l k\'e9sz\'fclt karperecekkel \'e9kes\'edttetnek azokban, z\'f6ld v\'e9kony selyemruh\'e1kat \'e9s vastag brok\'e1truh\'e1kat viselnek, 
\'e9s kerevetekre d\'f5lve fekszenek. Milyen nagyszer\'fb jutalom ez \'e9s milyen sz\'e9p pihen\'f5hely.
\par 
\par 32. \'c9s adj nekik [\'f3 Mohamed] p\'e9ld\'e1zatot k\'e9t f\'e9rfir\'f5l! Egyik\'f5j\'fcknek k\'e9t sz\'f5l\'f5skertet adtunk, amelyeket datolyap\'e1lm\'e1kkal vett\'fcnk k\'f6r\'fcl \'e9s gabon\'e1t tett\'fcnk k\'f6z\'e9j\'fck.
\par 33. Mindk\'e9t kert meghozta a gy\'fcm\'f6lcs\'e9t, \'e9s nem r\'f6vid\'edtette meg azt semmiben, \'e9s foly\'f3t fakasztottunk k\'f6z\'f6tt\'fck.
\par 34. \'c9s volt neki [egy\'e9b] term\'e9se (vagyona), \'edgy azt mondta a t\'e1rs\'e1nak, mik\'f6zben besz\'e9lgetett vele: \'84T\'f6bb az \'e9n vagyonom a ti\'e9dn\'e9l, \'e9s er\'f5sebb csapatom van.\'94
\par 35. \'c9s \'f6nmaga ellen igazs\'e1gtalans\'e1got elk\'f6vetve l\'e9pett be a kertj\'e9be. Azt mondta: \'84Nem v\'e9lem \'e9n azt, hogy ez valaha is el fog pusztulni.
\par 36. \'c9s nem v\'e9lem azt sem, hogy az \'d3ra (a Felt\'e1mad\'e1s) be fog k\'f6vetkezni. \'c9s bizony, ha Uramhoz vitetek vissza, akkor bizony\'e1ra jobb visszat\'e9r\'e9si helyet fogok tal\'e1lni enn\'e9l [a kertn\'e9l].\'94
\par 37. Azt mondta neki a t\'e1rsa, mik\'f6zben besz\'e9lgetett vele: \'84Vajon }{\insrsid5968634\charrsid3477372 hitetlenn\'e9 v\'e1lt\'e1l azzal szemben,}{\insrsid5968634  aki porb\'f3l, majd egy [megterm\'e9keny\'fclt] cseppb\'f5l teremtett t\'e9ged, azt
\'e1n pedig f\'e9rfiv\'e1 form\'e1lt?
\par 38. \'c9n azonban [hiszem, hogy] \'d5 Allah, az \'e9n Uram \'e9s nem \'e1ll\'edtok Uram mell\'e9 senkit se t\'e1rsistenk\'e9nt.
\par 39. \'c9s mi\'e9rt nem mondod, amikor bel\'e9psz a kertedbe: \rquote Ezt akarta Allah (nekem)! Nincs er\'f5 csakis Allah \'e1ltal!\rquote  Ha \'fagy v\'e9led, hogy kevesebb a vagyonom \'e9s a gyermekem, mint neked,
\par 40. \'dagy Uram tal\'e1n valami jobbat ad majd nekem, mint a kerted, \'e9s b\'fcntet\'e9st (puszt\'edt\'f3 z\'e1port) k\'fcld r\'e1 ez \'e9gb\'f5l, \'e9s csuszaml\'f3s talajj\'e1 lesz.
\par 41. Vagy [a f\'f6ld] m\'e9ly\'e9re s\'fcllyed\'f5 lesz a vize, \'e9s nem leszel k\'e9pes a megkeres\'e9s\'e9re.\'94
\par 42. \'c9s [a pusztul\'e1s \'e1ltal] k\'f6r\'fcl lettek v\'e9ve a gy\'fcm\'f6lcsei, \'e9s [b\'e1nat\'e1ban] \'f6sszecsapta tenyereit amiatt, amit r\'e1k\'f6lt\'f6tt, mik\'f6zben az (a kert) romokban hevert. \'c9s azt mondta: \'84B\'e1rcsak senkit se \'e1ll
\'edtottam volna t\'e1rsistenk\'e9nt az Uram mell\'e9!\'94
\par 43. \'c9s nem volt neki csapata, amely megseg\'edtette volna }{\insrsid5968634\charrsid8722313 \'f5t Allahhal szemben,}{\insrsid5968634  \'e9s nem is tudott volna saj\'e1t mag\'e1n seg\'edteni.
\par 44. A megseg\'edt\'e9s ott [egyed\'fcl] Allah\'e9, az Igazs\'e1g\'e9. \'d5 a legjobb jutalmaz\'e1sban, \'e9s \'d5 rendeli el [a h\'edv\'f5knek] a legjobb v\'e9get.
\par 
\par 45. \'c9s adj nekik [\'f3 Mohamed] p\'e9ld\'e1zatot az evil\'e1gi \'e9letr\'f5l, [amely] olyan mint a v\'edz, amelyet lebocs\'e1tottunk az \'e9gb\'f5l, azt\'e1n \'f6sszekeveredtek vele a f\'f6ld n\'f6v\'e9nyei, azt\'e1n elsz\'e1radt t\'f6rmel\'e9kk\'e9 v
\'e1ltak, amit a szelek sz\'e9tsz\'f3rtak! \'c9s Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 46. A vagyon \'e9s a gyermekek az evil\'e1gi \'e9let d\'edszei. \'c1m a maradand\'f3 j\'f3tetteknek jobb a jutalmaz\'e1sa Uradn\'e1l, \'e9s [azok] jobbak a rem\'e9ny tekintet\'e9ben.
\par 
\par 47. \'c9s [eml\'edtsd meg] a napot, amikor elmozd\'edtjuk a hegyeket [a hely\'fckr\'f5l], \'e9s l\'e1tod a f\'f6ldet, amint el\'f5t\'fbnik, \'e9s egybegy\'fbjtj\'fck \'f5ket, \'e9s nem hagyunk ki k\'f6z\'fcl\'fck egyet sem!
\par 48. \'c9s Urad el\'e9 vezettetnek sorban [\'e9s Allah azt mondja nekik]: \'84Bizony, elj\'f6ttetek el\'e9nk \'fagy, ahogyan megteremtett\'fcnk titeket az els\'f5 alkalommal, \'e1m ti azt \'e1ll\'edtott\'e1tok, hogy nem szabunk ki nektek meg\'edg\'e9rt id
\'f5t [a Vel\'fcnk val\'f3 tal\'e1lkoz\'e1sra].\'94
\par 49. \'c9s elhelyeztetik az \'cdr\'e1s (a tettek feljegyz\'e9se), azt\'e1n l\'e1tni fogod, hogy a gonosztev\'f5k megr\'e9m\'fclnek att\'f3l, ami abban van [feljegyezve], \'e9s azt mondj\'e1k: \'84\'d3, jaj nek\'fcnk! Mi lelte ezt az \'cdr\'e1
st? Nem hagy sem kis, sem nagy tettet an\'e9lk\'fcl, hogy sz\'e1mon ne tartan\'e1!\'94 \'c9s megtal\'e1lj\'e1k mindazt, amit tettek, el\'e9j\'fck t\'e1rva, \'e9s Urad nem k\'f6vet el igazs\'e1gtalans\'e1got senkivel szemben sem.
\par 
\par 50. \'c9s [eml\'edtsd meg azt,] amikor azt mondtuk az angyaloknak: \'84}{\insrsid5968634\charrsid8722313 Boruljatok le \'c1d\'e1m el\'f5tt!\'94 \'c9s \'f5k leborultak, kiv\'e9ve Ibl\'edszt, [aki] a dzsinnek k\'f6z\'fcl val\'f3 volt, \'e9
s engedetlen lett Ura parancs\'e1val szemben. Vajon \'f5t \'e9s a lesz\'e1rmazottait akarj\'e1tok}{\insrsid5968634  magatoknak megtenni p\'e1rtfog\'f3nak helyettem, holott \'f5k a ti ellens\'e9geitek? Milyen nyomor\'fas\'e1gos csere ez az igazs\'e1
gtalanoknak!
\par 51. Nem tettem \'f5ket (Ibl\'edszt \'e9s lesz\'e1rmazottait) az egek \'e9s a f\'f6ld teremt\'e9s\'e9nek tan\'faj\'e1v\'e1, \'e9s a saj\'e1t teremt\'e9s\'fck\'e9nek sem, \'e9s nem tettem meg magam [sz\'e1m\'e1ra] a t\'e9velyg\'e9sbe viv\'f5ket seg\'edt\'f5
nek.
\par 52. \'c9s [eml\'edtsd meg] a napot, amikor [Allah] azt mondja: \'84Sz\'f3l\'edts\'e1tok csak azokat, akikr\'f5l azt \'e1ll\'edtott\'e1tok, hogy \'f5k a t\'e1rsaim!\'94 \'c9s foh\'e1szkodni fognak hozz\'e1juk, \'e1m \'f5k nem adnak v\'e1laszt nekik. }{
\insrsid5968634\charrsid8722313 \'c9s pusztul\'e1s-helyet}{\insrsid5968634  tett\'fcnk k\'f6z\'e9j\'fck.
\par 53. \'c9s megl\'e1tj\'e1k a gonosztev\'f5k a [Pokol-]t\'fczet, \'e9s [biztosra] v\'e9lik, hogy bele fognak zuhanni, \'e9s nem tal\'e1lnak majd m\'f3dot arra, hogy kit\'e9rjenek el\'f5le.
\par 
\par }{\insrsid5968634\charrsid8722313 54. \'c9s ebben a Kor\'e1nban mindenf\'e9le p\'e9ld\'e1zatot sorakoztattunk fel az embereknek. \'c1m az ember vit\'e1zik}{\insrsid5968634  }{\insrsid5968634\charrsid8722313 [mindig] a legt\'f6bbet.
\par 55. \'c9s nem [m\'e1s] akad\'e1lyozta meg az embereket abban, hogy higgyenek \endash  amikor elj\'f6tt}{\insrsid5968634  hozz\'e1juk az \'datmutat\'e1s - \'e9s hogy megbocs\'e1t\'e1st k\'e9rjenek Urukt\'f3l, csup\'e1n az, hogy [k\'f6vetelt\'e9
k azt, hogy] el\'e9rje \'f5ket az a t\'f6rv\'e9nyszer\'fbs\'e9g [ahogyan Allah elj\'e1rt] a hajdanvoltakkal, vagy hogy el\'e9rje \'f5ket a k\'fcl\'f6nb\'f6z\'f5 fajt\'e1j\'fa b\'fcntet\'e9s.
\par 56. \'c9s nem k\'fcldj\'fck el a k\'fcld\'f6tteket, csak \'f6r\'f6mh\'edrhoz\'f3kk\'e9nt \'e9s figyelmeztet\'f5kk\'e9nt. \'c1m, akik hitetlenn\'e9 v\'e1ltak, vit\'e1ba sz\'e1llnak a hamiss\'e1ggal \'e9rvelve, hogy megc\'e1folj\'e1k vele az Igazs\'e1got. 
\'c9s g\'fany t\'e1rgy\'e1v\'e1 tett\'e9k a jeleimet \'e9s azt, amire figyelmeztetve lettek.
\par 
\par 57. \'c9s ki igazs\'e1gtalanabb ann\'e1l, mint aki eml\'e9keztetve lett az Ura jeleire, \'e1m \'f5 elfordult azokt\'f3l, \'e9s elfelejtette azt, amit a k\'e9t keze elk\'f6vetett? Bizony, Mi a sz\'edv\'fckre leplet tett\'fcnk, hogy ne \'e9rthess\'e9
k meg azt, a f\'fcl\'fckbe pedig s\'fckets\'e9get. \'c9s ha h\'edvod \'f5ket az Igaz \'datmutat\'e1sra, akkor sem fognak soha az Igaz \'datra lelni.
\par 58. \'c1m a te Urad a Megbocs\'e1t\'f3, a K\'f6ny\'f6r\'fclet Birtokosa. Ha sz\'e1mon k\'e9rn\'e9 \'f5ket az\'e9rt, amit maguknak szereztek, akkor bizony, siettetn\'e9 sz\'e1mukra a gy\'f6trelmet. \'c1m nekik meg\'edg\'e9rt idej\'fck van, \'e9
s nem fognak el\'f5le menek\'fcl\'f5helyre lelni.
\par 59. \'c9s ezek a telep\'fcl\'e9sek [amelyeknek] elpuszt\'edtottuk [a lak\'f3it], miut\'e1n igazs\'e1gtalans\'e1got k\'f6vettek el, \'e9s a pusztul\'e1suknak meg\'edg\'e9rt id\'f5t szabtunk ki.
\par 
\par 60. \'c9s [eml\'edtsd meg azt], amikor azt mondta M\'f3zes a leg\'e9ny\'e9nek: \'84Nem \'e1llok meg addig, am\'edg el nem \'e9rem a k\'e9t tenger tal\'e1lkoz\'e1s\'e1nak hely\'e9t, [m\'e9g ha] tov\'e1bb is haladok hossz\'fa ideig!\'94
\par 61. Amikor pedig el\'e9rt\'e9k a k\'e9t [tenger] tal\'e1lkoz\'e1s\'e1nak hely\'e9t, elfelejtett\'e9k a halukat, \'e9s [az \'e9letre kelve] a tenger fel\'e9 vette \'fatj\'e1t, szabad utat t\'f6rve mag\'e1nak.
\par 62. \'c9s amikor tov\'e1bbmentek, azt mondta a leg\'e9ny\'e9nek: \'84Hozd el nek\'fcnk az eb\'e9d\'fcnket, bizony f\'e1rads\'e1g lett \'farr\'e1 rajtunk eme utaz\'e1sunk miatt!\'94
\par 63. Azt mondta [a leg\'e9ny]: \'84Vajon l\'e1ttad-e, amikor a szikl\'e1n\'e1l h\'faztuk meg magunkat? Bizony, \'e9n elfeledkeztem a halr\'f3l, \'e1m semmi m\'e1s nem feledtette el velem azt, hogy eml\'e9kezzek r\'e1, mint a s\'e1t\'e1n. \'c9s [\'e9
letre kelve] a tenger fel\'e9 vette \'fatj\'e1t, csod\'e1s m\'f3don.\'94
\par 64. Azt mondta [M\'f3zes]: \'84Ez az [a jel], amit kerest\'fcnk!\'94 \'c9s visszat\'e9rtek a nyomaikat k\'f6vetve.
\par 65. \'c9s [ott] egy szolg\'e1t tal\'e1ltak a szolg\'e1ink k\'f6z\'fcl, akinek t\'f5l\'fcnk val\'f3 k\'f6ny\'f6r\'fcletet adtunk, \'e9s akinek T\'f5l\'fcnk sz\'e1rmaz\'f3 tud\'e1st tan\'edtottunk.
\par 66. Azt mondta neki M\'f3zes: \'84Vajon [megengeded], hogy k\'f6vesselek t\'e9ged az\'e9rt, hogy tan\'edts engem \endash  abb\'f3l, amire tan\'edtva lett\'e9l \endash  helyes \'fatra vezet\'e9s\'fcl?\'94
\par 67. Azt mondta [a szolg\'e1nk]: \'84Nem fogsz tudni t\'fcrelemmel velem [tartani]!
\par 68. Hogyan is lehetn\'e9l t\'fcrelmes azzal kapcsolatban, amir\'f5l nincs \'e1tfog\'f3 ismereted?\'94
\par 69. Azt mondta [M\'f3zes]: \'84Ha Allah \'fagy akarja, t\'fcrelmesnek fogsz tal\'e1lni engem, \'e9s nem fogok ellenszeg\'fclni egyetlen parancsodnak sem.\'94
\par 70. Azt mondta [a szolg\'e1nk]: \'84Nos, ha k\'f6vetsz engem, h\'e1t ne k\'e9rdezz semmir\'f5l, am\'edg \'e9n nem teszek eml\'edt\'e9st neked r\'f3la!\'94
\par 71. \'c9s elindultak, azt\'e1n, amikor felsz\'e1lltak a haj\'f3ra, [a szolg\'e1nk] megl\'e9kelte azt. Azt mondta [neki M\'f3zes]: \'84Vajon az\'e9rt l\'e9kelted meg, hogy v\'edzbe fullaszd a rajta l\'e9v\'f5ket? Bizony, borzaszt\'f3 dologra vetemedt\'e9l!
\'94
\par 72. Azt mondta [a szolg\'e1nk]: \'84Nem megmondtam, hogy nem fogsz tudni t\'fcrelemmel velem [tartani]?\'94
\par 73. [M\'f3zes] azt mondta: \'84Ne k\'e9rj sz\'e1mon amiatt, amit elfelejtettem, \'e9s ne terhelj engem neh\'e9zs\'e9ggel az \'fcgyemben (a t\'f5led val\'f3 tanul\'e1somban)!\'94
\par 74. Ezut\'e1n elindultak, azt\'e1n amikor tal\'e1lkoztak egy fi\'faval, [a szolg\'e1nk] meg\'f6lte \'f5t. [M\'f3zes] azt mondta: \'84Vajon meg\'f6lt\'e9l egy \'e1rtatlan embert, an\'e9lk\'fcl, hogy embert \'f6lt volna? Bizony rettenetes dologra vetemedt
\'e9l!\'94
\par 75. Azt mondta [a szolg\'e1nk]: \'84Nem megmondtam }{\insrsid5968634\charrsid8486143 neked}{\insrsid5968634 , hogy nem fogsz tudni t\'fcrelemmel velem [tartani]?\'94
\par 76. Azt mondta [M\'f3zes]: \'84Ha ezek ut\'e1n b\'e1rmir\'f5l megk\'e9rdezn\'e9lek, akkor ne fogadj t\'e1rsadul! Bizony, velem kapcsolatban minden okod meg van [a k\'fcl\'f6nv\'e1l\'e1sra].\'94
\par 77. Ezut\'e1n elindultak, azt\'e1n, amikor eljutottak }{\insrsid5968634\charrsid3938378 egy telep\'fcl\'e9shez, \'e9telt k\'e9rtek lak\'f3it\'f3l, de \'f5k megtagadt\'e1k azt, hogy vend\'e9g\'fcl l\'e1ss\'e1k \'f5ket. Majd egy falat tal\'e1ltak [a telep
\'fcl\'e9sen], amely led\'f5lni k\'e9sz\'fclt, [a szolg\'e1nk] pedig fel\'e1ll\'edtotta azt. Azt mondta [M\'f3zes}{\insrsid5968634 ]: \'84Ha akartad volna, fizets\'e9get szerezhett\'e9l volna ez\'e9rt.\'94
\par 
\par 78. [A szolg\'e1nk] azt mondta: \'84Ez a k\'fcl\'f6nv\'e1l\'e1s [ideje] k\'f6ztem \'e9s k\'f6zted. H\'edr\'fcl fogom adni neked annak magyar\'e1zat\'e1t, amiben nem tudt\'e1l t\'fcrelemmel velem [tartani].
\par 79. Ami a haj\'f3t illeti, nos az szeg\'e9nyek\'e9 volt, akik a tengeren dolgoztak. Azt akartam h\'e1t, hogy hib\'e1t ejtsek rajta, mert m\'f6g\'f6tt\'fck volt egy kir\'e1ly, aki er\'f5szakkal elvesz minden [\'e9p] haj\'f3t.
\par 80. \'c9s ami az ifj\'fat illeti, nos az \'f5 sz\'fclei h\'edv\'f5k voltak, \'e9s att\'f3l tartottunk, hogy t\'falkap\'e1sokkal \'e9s hitetlens\'e9ggel terheli majd \'f5ket.
\par 81. \'c9s azt akartuk, hogy az Uruk adjon nekik cser\'e9be olyat, aki jobb n\'e1la tisztas\'e1gban, \'e9s aki k\'f6zelebb \'e1ll [a sz\'fcleihez] k\'f6ny\'f6r\'fcletess\'e9gben.
\par 82. \'c9s ami pedig a falat illeti, h\'e1t az k\'e9t fiatal \'e1rv\'e1\'e9 volt a v\'e1rosb\'f3l, \'e9s az alatt kincs volt, amely \'f5ket illette meg, \'e9s az apjuk j\'f3 ember volt. Urad azt akarta, hogy el\'e9rj\'e9k \'e9rett korukat, \'e9s felhozhass
\'e1k a kincs\'fcket, Uradt\'f3l val\'f3 k\'f6ny\'f6r\'fcletk\'e9nt. \'c9s ezt nem a saj\'e1t }{\insrsid5968634\charrsid3938378 elhat\'e1roz\'e1somb\'f3l tettem! Ez a magyar\'e1zata annak, amivel kapcsolatban nem tudt\'e1l t\'fcrelmes lenni.\'94}{
\insrsid5968634 
\par 
\par 83. \'c9s k\'e9rdeznek t\'e9ged Dhul-Karnainr\'f3l. Mondd [\'f3 Mohamed]: \'84Recit\'e1lni fogok nektek a [t\'f6rt\'e9net\'e9b\'f5l] egy eml\'e9keztet\'f5t.\'94
\par 84. Bizony, mi hatalmat adtunk neki a f\'f6ld\'f6n \'e9s mindenf\'e9le dologb\'f3l utat (eszk\'f6zt) adtunk neki [ami elvezeti a c\'e9ljaihoz].
\par 85. \'d5 pedig k\'f6vetett egy utat.
\par 86. Azt\'e1n, amikor el\'e9rte azt a helyet, ahol a Nap lenyugszik, \'fagy tal\'e1lta, hogy az megfeketedett s\'e1rb\'f3l val\'f3 forr\'e1sban nyugodott le, \'e9s ott egy n\'e9pet tal\'e1lt. Azt mondtuk: \'84\'d3 Dhul-Karnain! Vagy b\'fcntesd meg \'f5
ket, vagy tegy\'e9l vel\'fck j\'f3t!\'94
\par 87. Azt mondta [Dhul-Karnain]: \'84Azt illet\'f5en, aki igazs\'e1gtalans\'e1got k\'f6vet el, }{\insrsid5968634\charrsid3938378 meg fogjuk b\'fcntetni \'f5t [az evil\'e1gon], majd Ur\'e1hoz vitetik vissza, aki rettenetes gy\'f6trelem}{\insrsid5968634 
mel fogja megb\'fcntetni [a t\'falvil\'e1gon].
\par 88. \'c9s azt illet\'f5en, aki hisz \'e9s j\'f3tettet cselekszik, annak a fizets\'e9ge a legjobb [jutalom] (a Paradicsom), \'e9s k\'f6nnyen [teljes\'edthet\'f5] parancsot fogunk neki mondani.\'94
\par 89. Azut\'e1n k\'f6vetett egy utat.
\par 
\par 90. Azt\'e1n, amikor el\'e9rte azt a helyet, ahol a Nap felkel, \'fagy tal\'e1lta, hogy az egy olyan n\'e9pre kel fel, akiknek nem adtunk olyat, ami eltakarta volna \'f5ket t\'f5le.
\par 91. [\'c9s] ekk\'e9ppen [t\'f6rt\'e9nt]. \'c9s bizony, \'e1tfog\'f3 ismeret\'fcnk van arr\'f3l, amivel \'f5 (Dhul-Qarnain) rendelkezett.
\par 92. Azut\'e1n k\'f6vetett egy [m\'e1sik] utat.
\par 93. Azt\'e1n, amikor el\'e9rt a k\'e9t g\'e1t (hegy) k\'f6z\'e9, a kett\'f5 m\'f6g\'f6tt egy olyan n\'e9pet tal\'e1lt, akik k\'f6zel\'e9be sem \'e1lltak annak, hogy meg\'e9rts\'e9k [m\'e1sok] besz\'e9d\'e9t.
\par 94. Azt mondt\'e1k: \'84\'d3 Dhul-Karnain! G\'f3g \'e9s Mag\'f3g roml\'e1st okoznak a f\'f6ld\'f6n. H\'e1t adhatunk-e neked fizets\'e9get az\'e9rt, hogy k\'f6z\'e9nk \'e9s k\'f6z\'e9j\'fck g\'e1tat emelj?\'94
\par 95. Azt mondta [Dhul-Karnain]: \'84Amiben hatalmat adott nekem Uram, az jobb! Seg\'edtsetek h\'e1t engem er\'f5vel, hogy k\'f6z\'e9tek \'e9s k\'f6z\'e9j\'fck v\'e9d\'f5falat \'e9p\'edthessek!
\par 96. Hozzatok nekem vasdarabokat!\'94 Azt\'e1n, amikor felt\'f6lt\'f6tte a k\'e9t hegyoldal k\'f6z\'f6tti r\'e9szt, azt mondta: \'84F\'fajj\'e1tok!\'94 Azt\'e1n, amikor felizz\'edtotta, azt mondta: \'84Hozzatok nekem megolvasztott rezet, hogy r\'e1\'f6
nthessem!\'94
\par 97. \'cdgy h\'e1t \'f5k (G\'f3g \'e9s Mag\'f3g) nem tudt\'e1k megm\'e1szni \'e9s nem tudtak rajta r\'e9st \'fctni.
\par 98. Azt mondta [Dhul-Karnain]: \'84Ez k\'f6ny\'f6r\'fclet az \'e9n Uramt\'f3l, \'e1m amikor elj\'f6n Uram \'edg\'e9rete, \'d5 porr\'e1 z\'fazza azt. \'c9s Uram \'edg\'e9rete igaz!\'94
\par 
\par 99. \'c9s azon a napon hagyjuk, hogy egym\'e1sba torl\'f3djanak, mint a hull\'e1mok. \'c9s megf\'favatik a k\'fcrt, majd \'f6sszegy\'fbjtj\'fck \'f5ket, mindannyiukat.
\par 100. \'c9s azon a napon a Gyehenna el\'e9 \'e1ll\'edtjuk a hitetleneket, megmutatva azt nekik.
\par 101. Azoknak, akiknek a szem\'e9t lepel fedte a R\'f3lam val\'f3 megeml\'e9kez\'e9ssel kapcsolatban, \'e9s nem voltak k\'e9pesek a hall\'e1sra.
\par 102. Vajon azt gondolt\'e1k azok, akik hitetlenn\'e9 v\'e1ltak, hogy a szolg\'e1imat p\'e1rtfog\'f3v\'e1 tehetik meg maguknak \'c9n helyettem? Bizony mi, a Gyehenn\'e1t sz\'e1ll\'e1shely\'fcl k\'e9sz\'edtett\'fck el\'f5 a hitetleneknek.
\par 103. Mondd [\'f3 Mohamed]: \'84Vajon adjunk-e h\'edrt nektek azokr\'f3l, akik a legink\'e1bb vesztesek a cselekedeteiket illet\'f5en?\'94
\par 104. Azok, akiknek igyekezete t\'e9v\'faton j\'e1r az evil\'e1gi \'e9letben, mik\'f6zben \'fagy gondolj\'e1k, hogy helyeset cselekszenek.
\par 105. \'d5k azok, akik hitetlenn\'e9 v\'e1ltak Uruk jeleivel \'e9s a Vele val\'f3 tal\'e1lkoz\'e1ssal szemben, ez\'e9rt semmiv\'e9 foszlottak a cselekedeteik, \'e9s nem tesz\'fcnk nekik s\'falyt a Felt\'e1mad\'e1s Napj\'e1n.
\par 106. Ez az \'f5 fizets\'e9g\'fck: a Gyehenna, ami\'e9rt hitetlenn\'e9 v\'e1ltak, \'e9s a jeleimet \'e9s a k\'fcld\'f6tteimet g\'fany t\'e1rgy\'e1v\'e1 tett\'e9k.
\par 
\par 107. Bizony, akik hisznek \'e9s j\'f3tetteket cselekszenek, azoknak a Firdausz kertjei j\'e1rnak [a Paradicsomban] sz\'e1ll\'e1shely\'fcl.
\par 108. \'d6r\'f6kre abban maradnak, nem k\'edv\'e1nnak onnan kiker\'fclni.
\par 
\par 109. Mondd [\'f3 Mohamed]: \'84Ha a tenger tinta lenne az \'e9n Uram szavai sz\'e1m\'e1ra, bizony kifogyna a tenger, miel\'f5tt elfogyn\'e1nak Uram szavai, m\'e9g akkor is, ha m\'e9g ugyanannyit tenn\'e9nk hozz\'e1 seg\'edts\'e9g\'fcl.\'94
\par 110. Mondd [\'f3 Mohamed]: \'84\'c9n csup\'e1n egy hozz\'e1tok hasonl\'f3 ember vagyok. Az sugalltatik nekem [kinyilatkoztat\'e1sk\'e9nt], hogy a ti istenetek egy Isten. Nos, aki rem\'e9li az Ur\'e1val val\'f3 tal\'e1lkoz\'e1st, }{
\insrsid5968634\charrsid7437142 az }{\insrsid5968634\charrsid3938378 tegyen j\'f3 cselekedetet, \'e9s}{\insrsid5968634  ne \'e1ll\'edtson semmit t\'e1rsistenk\'e9nt az Ura szolg\'e1lat\'e1ban!\'94}{\insrsid5968634\charrsid12735932 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\fs24\insrsid5968634\charrsid12735932 \page }{\f0\fs24\insrsid5968634\charrsid5968634 19. sz\'fara \endash  M\'e1ria (Mariam) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. K\'e1f-H\'e1-J\'e1-Ain-Szad.
\par 2. Eml\'edt\'e9s [ez] Urad k\'f6ny\'f6r\'fclet\'e9r\'f5l a szolg\'e1ja, Zakari\'e1s ir\'e1nt.
\par 3. Amikor titkos sz\'f3val sz\'f3l\'edtotta az \'f5 Ur\'e1t.
\par 4. Azt mondta: \'84Uram! Bizony, a csontjaim meggyeng\'fcltek, \'e9s \'f5sz haj fedte be a fejem, \'e9s \'f3 Uram, a Hozz\'e1d val\'f3 foh\'e1szkod\'e1s [meghallgat\'e1s\'e1ban] soha nem voltam boldogtalan.
\par 5. \'c9s bizony, \'e9n f\'e9lek, hogy mit tesznek a rokonok ut\'e1nam [a vall\'e1st illet\'f5en], a feles\'e9gem pedig medd\'f5. Aj\'e1nd\'e9kozz h\'e1t meg engem egy T\'f5led sz\'e1rmaz\'f3 p\'e1rtfog\'f3 [fi\'fagyermekkel]!
\par 6. Aki \'f6r\'f6k\'f6l t\'f5lem, \'e9s \'f6r\'f6k\'f6l J\'e1kob nemzets\'e9g\'e9t\'f5l. \'c9s tedd \'f5t olyann\'e1, Uram, akivel el\'e9gedett leszel!\'94
\par 7. [Allah \'edgy sz\'f3l\'edtotta az angyalokon kereszt\'fcl:] \'84\'d3 Zakari\'e1s! Bizony, Mi \'f6r\'f6mh\'edrt adunk neked egy ifj\'far\'f3l, [akinek] Jahj\'e1 (J\'e1nos) a neve. Kor\'e1bban nem adtunk senkinek az \'f5 nev\'e9hez hasonl\'f3t.\'94

\par 8. Azt mondta: \'84Uram! Hogyan lehetne nekem ifj\'fa gyermekem, holott a feles\'e9gem medd\'f5, \'e9n pedig m\'e1r el\'e9rtem a v\'e9gs\'f5 \'f6regkort?\'94
\par 9. Azt mondta [az angyal]: \'84}{\insrsid5968634 Ez \'fagy van, [de] az Urad }{\insrsid5968634 azt mondta: 'Ez k\'f6nny\'fb nekem, hiszen megteremtettelek t\'e9ged kor\'e1bban, amikor m\'e9g nem volt\'e1l semmi.'\'94
\par 10. Azt mondta [Zakari\'e1s]: \'84Uram! Adj nekem egy jelet!\'94 Azt mondta [Allah]: \'84A te jeled az, hogy h\'e1rom \'e9jjelen (napon) \'e1t nem fogsz [tudni] besz\'e9lni az emberekhez, eg\'e9szs\'e9ges l\'e9tedre.\'94 
\par 11. \'c9s kiment az imahely\'e9r\'f5l a n\'e9p\'e9hez, \'e9s [jelbesz\'e9ddel] sugallta nekik, hogy magasztalj\'e1k [az Urat] hajnalban \'e9s naplemente el\'f5tt.
\par 
\par 12. [\'c9s }{\insrsid5968634\charrsid7550020 kinyilatkoztatott a fi\'e1nak:] \'84\'d3 Jahj\'e1 (J\'e1nos)! Ragaszkodj er\'f5sen az \'cdr\'e1shoz (a T\'f3r\'e1hoz)!\'94 \'c9s kisgyermek l\'e9t\'e9re megadtuk neki a b\'f6lcsess\'e9get [a T\'f3ra meg\'e9rt
\'e9se \'e1ltal],
\par 13. \'c9s T\'f5l\'fcnk sz\'e1rmaz\'f3 gyeng\'e9ds\'e9get \'e9s tisztas\'e1got, \'e9s \'f5 istenf\'e9l\'f5 volt.
\par 14. \'c9s j\'f3s\'e1gos volt a sz\'fcleivel, \'e9s nem volt hatalmaskod\'f3, sem ellenszeg\'fcl\'f5.
\par 15. \'c9s b\'e9kess\'e9g}{\insrsid5968634  re\'e1 azon a napon, amikor megsz\'fcletett, \'e9s azon a napon, amikor meghal \'e9s azon a napon, amikor [\'faj] \'e9letre t\'e1masztatik fel.
\par }{\cs96\insrsid5968634 
\par 16. \'c9s eml\'edtsd meg [\'f3 Mohamed] az \'cdr\'e1sban M\'e1ri\'e1t, amikor elvonult a csal\'e1dj\'e1t\'f3l [a h\'e1z] egy keleti [r\'e9sz\'e9n l\'e9v\'f5] helyre! 
\par 17. \'c9s elf\'fcgg\'f6ny\'f6zte mag\'e1t el\'f5l\'fck, mi pedig elk\'fcldt\'fck hozz\'e1 a lelk\'fcnket (G\'e1briel angyalt), aki t\'f6k\'e9letes emberk\'e9nt jelent meg el\'f5tte.
\par 18. Azt mondta [M\'e1ria]: \'84Bizony, \'e9n a K\'f6ny\'f6r\'fcletesn\'e9l keresek mened\'e9ket el\'f5led! [Maradj h\'e1t t\'e1vol t\'f5lem,] ha istenf\'e9l\'f5 vagy!\'94
\par 19. Azt mondta [az angyal]: \'84\'c9n csup\'e1n a te Urad k\'fcld\'f6tte vagyok, [az\'e9rt], hogy tiszta ifj\'fa gyermeket aj\'e1nd\'e9kozzak neked.\'94
\par 20. Azt mondta [M\'e1ria]: \'84Hogyan is lehetne nekem ifj\'fa gyermekem, holott nem \'e9rintett engem ember, \'e9s nem voltam c\'e9da [sem]!\'94
\par 21. Azt mondta [az angyal]: \'84}{\cs96\insrsid5968634 Ez \'fagy van, [de] az Urad }{\cs96\insrsid5968634 azt mondta: 'Ez k\'f6nny\'fb nekem, \'e9s [az\'e9rt aj\'e1nd\'e9kozzuk \'f5t neked], hogy [csod\'e1s] jell\'e9 tegy\'fck az embereknek, \'e9s T\'f5l
\'fcnk sz\'e1rmaz\'f3 k\'f6ny\'f6r\'fclett\'e9. \'c9s ez egy eld\'f6nt\'f6tt \'fcgy!'\'94
\par 22. \'c9s [akkor] v\'e1rand\'f3s lett vele [J\'e9zussal], \'e9s elvonult vele egy t\'e1voli helyre.
\par 23. \'c9s eljuttatta a vaj\'fad\'e1s [f\'e1jdalma] egy p\'e1lmafa t\'f6rzs\'e9hez, \'e9s azt mondta: \'84\'d3, b\'e1rcsak meghaltam volna ez el\'f5tt, \'e9s lenn\'e9k elfelejtett, [aki] teljes feled\'e9sbe mer\'fclt!\'94
\par 24. Azut\'e1n [az \'fajsz\'fcl\'f6tt J\'e9zus] sz\'f3l\'edtotta \'f5t al\'f3la: \'84Ne szomorkodj! Az Urad m\'e1r elhelyezett alattad egy patakot,
\par 25. \'c9s r\'e1zd magadhoz a p\'e1lmafa t\'f6rzs\'e9t, friss datoly\'e1t fog hullatni r\'e1d!
\par 26. Egy\'e9l \'e9s igy\'e1l h\'e1t, \'e9s lelj \'f6r\'f6mre [\'fajsz\'fcl\'f6ttedben]! \'c9s ha megl\'e1tsz az }{\cs96\insrsid5968634\charrsid4546712 emberek k\'f6z\'fcl}{\cs96\insrsid5968634  valakit, mondd: 'Bizony, \'e9n b\'f6jt\'f6t (n\'e9mas\'e1
got) fogadtam a K\'f6ny\'f6r\'fcletesnek, ez\'e9rt nem fogok besz\'e9lni ma egyetlen emberhez sem.'\'94
\par 27. \'c9s elhozta \'f5t a n\'e9p\'e9hez, [karj\'e1n] hordv\'e1n \'f5t. Azt mondt\'e1k: \'84\'d3 M\'e1ria! Bizony, te egy hallatlan dolgot k\'f6vett\'e9l el!
\par 28. \'d3 le\'e1nytestv\'e9re \'c1ronnak! Ap\'e1d nem volt rossz ember, \'e9s any\'e1d sem volt c\'e9da!\'94
\par 29. \'d5 pedig r\'e1 (az \'fajsz\'fcl\'f6tt J\'e9zusra) mutatott. Azt mondt\'e1k: \'84Hogyan besz\'e9lhetn\'e9nk egy b\'f6lcs\'f5ben [fekv\'f5] kisgyermekkel?\'94
\par 30. Azt mondta [J\'e9zus]: \'84Bizony, \'e9n Allah szolg\'e1ja vagyok! Odaadta nekem az \'cdr\'e1st, \'e9s pr\'f3f\'e9t\'e1v\'e1 tett.
\par 31. \'c9s \'e1ldott\'e1 tett engem b\'e1rhol is legyek, \'e9s meghagyta nekem az im\'e1dkoz\'e1s [megtart\'e1s\'e1t] \'e9s a k\'f6telez\'f5 adom\'e1ny [megad\'e1s\'e1t], ameddig csak \'e9lek.
\par 32. \'c9s hogy \'e9desany\'e1m ir\'e1nt j\'f3s\'e1gos legyek, \'e9s nem tett engem hatalmaskod\'f3v\'e1 \'e9s boldogtalann\'e1.}{\insrsid5968634 
\par 33. \'c9s b\'e9kess\'e9g re\'e1m azon a napon, amikor megsz\'fclettem, \'e9s azon a napon, amikor meghalok \'e9s azon a napon, amikor [\'faj] \'e9letre leszek felt\'e1masztva.}{\cs96\insrsid5968634 \'94
\par 
\par 34. Ez J\'e9zus, M\'e1ria fia! [Ez] az igaz besz\'e9d [\'f5t illet\'f5en], amely fel\'f5l k\'e9telkednek.
\par 35. Allah sosem tesz [valakit] gyermek\'e9v\'e9. Magasztaltass\'e9k! Ha egy dolgot elrendel, akkor csup\'e1n annyit mond annak: \'84Legy\'e9l!\'94 \endash  \'e9s az van.
\par 36. [J\'e9zus azt mondta:] \'84\'c9s bizony Allah az \'e9n Uram \'e9s a ti Uratok! Szolg\'e1lj\'e1tok h\'e1t \'d5t! Ez egyenes \'fat.\'94}{\insrsid5968634 
\par 37. \'c1m a vall\'e1si csoportok \'f6sszek\'fcl\'f6nb\'f6ztek }{\insrsid5968634\charrsid1526157 egym\'e1s k\'f6z\'f6tt. Jaj h\'e1t azoknak, akik hitetlenn\'e9 v\'e1ltak, egy hatalmas napon val\'f3 jelenl\'e9t\'fck miatt!}{\insrsid5968634 
\par 38. Milyen tiszta lesz a hall\'e1suk \'e9s a l\'e1t\'e1suk azon a napon, amikor elj\'f6nnek Hozz\'e1nk! \'c1m az igazs\'e1gtalanok ma nyilv\'e1nval\'f3 t\'e9velyg\'e9sben vannak.
\par 39. Figyelmeztesd }{\insrsid5968634\charrsid1526157 h\'e1t \'f5ket [\'f3 Mohamed] a b\'e1nat}{\insrsid5968634  napj\'e1val kapcsolatban, amikor m\'e1r eld\'f6ntetett [lesz] az \'fcgy, noha \'f5k [most m\'e9g] figyelmetlens\'e9g [\'e1llapot\'e1
ban] vannak, \'e9s nem hisznek!
\par 40. Bizony, Mi fogjuk \'f6r\'f6k\'f6lni a f\'f6ldet \'e9s azokat, \'e9s akik rajta vannak, \'e9s Hozz\'e1nk lesznek visszavitetve.
\par 
\par 41. \'c9s eml\'edtsd meg [\'f3 Mohamed] az \'cdr\'e1sban (a Kor\'e1nban) \'c1brah\'e1mot! Bizony, \'f5 igaz ember \'e9s pr\'f3f\'e9ta volt.
\par 42. Amikor azt mondta az apj\'e1nak: \'84\'d3 ap\'e1m! Mi\'e9rt szolg\'e1lod azt, ami nem hall \'e9s nem l\'e1t, \'e9s ami semmiben sincs a hasznodra?
\par 43. \'d3 ap\'e1m! Nekem olyan tud\'e1s adatott, ami neked nem! K\'f6vess h\'e1t engem \'e9s \'e9n az egyenes \'fatra foglak vezetni!
\par 44. \'d3 ap\'e1m! Ne szolg\'e1ld a s\'e1t\'e1nt! Bizony, a s\'e1t\'e1n a K\'f6ny\'f6r\'fcletessel szemben ellenszeg\'fcl\'f5.
\par 45. \'d3 ap\'e1m! Bizony, \'e9n f\'e9lek, }{\insrsid5968634\charrsid1526157 hogy gy\'f6trelem fog s\'fajtani t\'e9ged a K\'f6ny\'f6r\'fcletest\'f5l,}{\insrsid5968634  \'e9s \'edgy a s\'e1t\'e1n p\'e1rtfog\'f3ja leszel [a Pokol-t\'fbzben].\'94
\par 46. Azt mondta [az apja]: \'84\'d3 \'c1brah\'e1m! Vajon elv\'e1gysz az \'e9n isteneimt\'f5l? Ha nem hagyod abba, bizony megk\'f6vezlek! \'c9s t\'e1vozz t\'f5lem egy hosszabb id\'f5re!\'94
\par 47. Azt mondta [\'c1brah\'e1m]: \'84B\'e9kess\'e9g re\'e1d! Megbocs\'e1t\'e1st fogok k\'e9rni sz\'e1modra Uramt\'f3l. Bizony, \'d5 mindig t\'f6r\'f5d\'f6tt velem.
\par 48. \'c9s t\'e1vol }{\insrsid5968634\charrsid11079081 tartom}{\insrsid5968634  magam t\'f5letek \'e9s att\'f3l, amihez Allah helyett foh\'e1szkodtok. \'c9s foh\'e1szkodom az Uramhoz, tal\'e1n az Uramhoz val\'f3 foh\'e1szkod\'e1som \'e1
ltal nem leszek boldogtalan.\'94
\par 49. \'c9s miut\'e1n t\'e1vol tartotta mag\'e1t t\'f5l\'fck, \'e9s att\'f3l, amit Allah helyett szolg\'e1ltak, neki aj\'e1nd\'e9koztuk Izs\'e1kot [fiak\'e9nt] \'e9s J\'e1kobot [unok\'e1jak\'e9nt]. Mindegyiket pr\'f3f\'e9t\'e1v\'e1 tett\'fck.
\par 50. \'c9s [kegyeket] aj\'e1nd\'e9koztunk nekik a k\'f6ny\'f6r\'fclet\'fcnkb\'f5l. \'c9s igaz \'e9s magasztos dics\'e9retet adtunk nekik.
\par 
\par 51. \'c9s eml\'edtsd meg [\'f3 Mohamed] az \'cdr\'e1sban (a Kor\'e1nban) M\'f3zest! Bizony, kiv\'e1lasztott volt, \'e9s k\'fcld\'f6tt volt [amellett, hogy] pr\'f3f\'e9ta!
\par 52. \'c9s megsz\'f3l\'edtottuk \'f5t a [S\'ednai] hegy jobb oldal\'e1r\'f3l \'e9s k\'f6zel hoztuk \'f5t bizalmas besz\'e9lget\'e9sre.
\par 53. \'c9s aj\'e1nd\'e9koztuk neki a k\'f6ny\'f6r\'fclet\'fcnkb\'f5l testv\'e9r\'e9t, \'c1ront, pr\'f3f\'e9tak\'e9nt.
\par 54. \'c9s eml\'edtsd meg az \'cdr\'e1sban Izmaelt! Bizony, \'f5 h\'fb volt \'edg\'e9ret\'e9hez, \'e9s k\'fcld\'f6tt volt [amellett, hogy] pr\'f3f\'e9ta!
\par 55. \'c9s [Izmael] mindig megparancsolta a csal\'e1dj\'e1nak az im\'e1dkoz\'e1s [megtart\'e1s\'e1t] \'e9s a k\'f6telez\'f5 adom\'e1ny [megad\'e1s\'e1t]. \'c9s Ura el\'e9gedett volt vele.
\par 56. \'c9s eml\'edtsd meg az \'cdr\'e1sban (a Kor\'e1nban) Idr\'edszt (\'c9nokhot)! Bizony, \'f5 igaz ember volt [\'e9s] pr\'f3f\'e9ta.
\par 57. \'c9s magasztos helyre emelt\'fck fel \'f5t.
\par 58. \'d5k azok, akiket Allah j\'f3t\'e9tem\'e9nyeiben r\'e9szes\'edtett a pr\'f3f\'e9t\'e1k k\'f6z\'fcl, \'c1d\'e1m lesz\'e1rmazottai k\'f6z\'fcl, \'e9s azok k\'f6z\'fcl, akiket No\'e9val egy\'fctt vitt\'fcnk [a b\'e1rk\'e1n], \'e9s \'c1brah\'e1m \'e9
s Izrael lesz\'e1rmazottai k\'f6z\'fcl, \'e9s azok k\'f6z\'fcl, akiket igaz \'faton vezett\'fcnk \'e9s kiv\'e1lasztottunk. Amikor a K\'f6ny\'f6r\'fcletes (Allah) jelei recit\'e1ltattak nekik, \'f5k f\'f6ldre rogytak leborulva \'e9s s\'edrva. 
\par 
\par 59. Azt\'e1n olyan ut\'f3dok k\'f6vetkeztek ut\'e1nuk, akik elhagyt\'e1k az im\'e1dkoz\'e1st, \'e9s a v\'e1gyakat k\'f6vett\'e9k. \'d5k t\'e9velyg\'e9s\'fck [fizets\'e9g\'e9vel] fognak szembetal\'e1lkozni.
\par 60. Kiv\'e9ve [azokat,] akik b\'fbnb\'e1natot tan\'fas\'edtottak, \'e9s hittek \'e9s j\'f3tetteket cselekedtek, nos, azok bel\'e9pnek a Paradicsomba, \'e9s semmiben sem fognak igazs\'e1gtalans\'e1got szenvedni.
\par 61. \'d6r\'f6kk\'e9 tart\'f3 kertekbe [l\'e9pnek be], amelyeket a K\'f6ny\'f6r\'fcletes \'edg\'e9rt a szolg\'e1inak [olyan jutalomk\'e9nt,] ami a rejtett dolgok k\'f6z\'fcl val\'f3. Bizony, az \'d5 \'edg\'e9rete beteljesedik!
\par 62. Nem hallanak ott felesleges besz\'e9det, csup\'e1n a b\'e9kess\'e9g [k\'f6sz\'f6nt\'e9s\'e9t], \'e9s megkapj\'e1k ell\'e1t\'e1sukat hajnalban \'e9s naplemente el\'f5tt.
\par 63. Ez a Paradicsom, amelyet \'f6r\'f6k\'fcl adunk azon szolg\'e1inknak, akik istenf\'e9l\'f5k voltak.
\par 64. [Az angyalok azt mondj\'e1k:] \'84\'c9s mi nem ereszked\'fcnk le, csup\'e1n Urad parancs\'e1ra. \'d6v\'e9 az, ami el\'f5tt\'fcnk \'e9s ami m\'f6g\'f6tt\'fcnk van, \'e9s az is, ami e kett\'f5 k\'f6z\'f6tt van. \'c9s Urad sosem feled\'e9keny.
\par 65. [Allah] az egek \'e9s a f\'f6ld Ura, \'e9s mindaz\'e9, ami k\'f6z\'f6tt\'fck van. Szolg\'e1ld h\'e1t \'d5t, \'e9s legy\'e9l t\'fcrelmesen kitart\'f3 az \'d5 szolg\'e1lat\'e1ban! Vajon h\'e1t tudsz-e olyanr\'f3l, akinek az \'d5 nev\'e9hez hasonl\'f3
 lenne a neve?\'94
\par 
\par 66. \'c9s azt mondja az ember: \'84Vajon, miut\'e1n meghalok, akkor bizony [\'faj] \'e9letre leszek kihozva [a s\'edrb\'f3l]?\'94
\par 67. Vajon nem eml\'e9kszik az ember arra, hogy megteremtett\'fck \'f5t kor\'e1bban, amikor \'f5 nem volt semmi?
\par 68. H\'e1t [esk\'fcsz\'f6m] az Uradra! Bizony, mi \'f6sszegy\'fbjtj\'fck \'f5ket a s\'e1t\'e1nokkal egy\'fctt, azut\'e1n t\'e9rd\'fck\'f6n fogjuk \'f5ket a Gyehenna k\'f6r\'e9 el\'f5hozni.
\par 69. Azut\'e1n minden csoportb\'f3l kiragadjuk azokat, akik a legelsz\'e1ntabbak voltak a K\'f6ny\'f6r\'fcletessel szembeni engedetlens\'e9gben.
\par 70. Azut\'e1n bizony, Mi jobban tudjuk, kik \'e9rdemlik meg legink\'e1bb azt, hogy abban (a Gyehenn\'e1ban) \'e9gjenek.
\par 71. \'c9s nincs k\'f6z\'fcletek olyan, aki ne jutna oda. Ez eld\'f6nt\'f6tt \'fcgy Urad r\'e9sz\'e9r\'f5l.
\par 72. Azut\'e1n megmentj\'fck azokat, akik istenf\'e9l\'f5k voltak, \'e9s ott hagyjuk az igazs\'e1gtalanokat benne, a t\'e9rd\'fck\'f6n [\'e1llva].
\par 
\par 73. \'c9s amikor a jeleink vil\'e1gos bizony\'edt\'e9kokk\'e9nt recit\'e1ltatnak nekik, [akkor] azok, akik hitetlenn\'e9 v\'e1ltak azt mondj\'e1k azoknak, akik hisznek: \'84A k\'e9t csoport k\'f6z\'fcl melyik van jobb helyzetben, \'e9
s melyiknek szebb a gy\'fclekez\'e9si helye?\'94
\par 74. \'c9s h\'e1ny el\'f5tt\'fck \'e9lt nemzed\'e9ket puszt\'edtottunk el, akiknek szebb berendez\'e9si t\'e1rgyaik \'e9s megjelen\'e9s\'fck volt!
\par 75. Mondd [\'f3 Mohamed]: \'84Aki t\'e9velyg\'e9sben van, adjon neki a K\'f6ny\'f6r\'fcletes gyarapod\'e1st [a t\'e9velyg\'e9sben], addig, am\'edg meg nem l\'e1tj\'e1k azt, amire \'edg\'e9retet kaptak: vagy a gy\'f6trelmet, vagy az \'d3r\'e1t (a Felt\'e1
mad\'e1st)! Akkor meg fogj\'e1k tudni, kinek rosszabb a helyzete \'e9s gyeng\'e9bb a serege!\'94
\par 76. \'c9s akik az igaz \'fatra lelnek, azokat Allah gyarap\'edtja \'fatmutat\'e1sban. \'c1m a maradand\'f3 j\'f3tetteknek jobb a jutalmaz\'e1sa Uradn\'e1l, \'e9s [azok] jobbak a viszonz\'e1s tekintet\'e9ben.
\par 
\par 77. }{\insrsid5968634 Vajon h\'e1t mit gondolsz arr\'f3l,}{\insrsid5968634  aki }{\insrsid5968634\charrsid14576812 hitetlen a jeleinkkel szemben}{\insrsid5968634 , \'e9s azt mondta: \'84Bizony vagyont \'e9s fi\'fagyermeket kapok majd [ha fel lenn\'e9k t
\'e1masztva].\'94
\par 78. Vajon betekint\'e9st nyert a rejtett [dolgokba], vagy egyezs\'e9get k\'f6t\'f6tt [erre n\'e9zve] }{\insrsid5968634\charrsid3176535 a}{\insrsid5968634  K\'f6ny\'f6r\'fcletessel?
\par 79. Nem! Fel fogjuk jegyezni azt, amit mond, \'e9s gyarapod\'e1st adunk neki [a b\'fcntet\'e9sb\'f5l].
\par 80. \'c9s \'f6r\'f6k\'f6lni fogjuk t\'f5le azt, amit mond (vagyont \'e9s fi\'fagyermeket) \'e9s egyed\'fcl fog Hozz\'e1nk j\'f6nni.
\par 81. \'c9s Allah helyett m\'e1sokat tettek istens\'e9geikk\'e9, hogy szerezzenek \'e1ltaluk m\'e9lt\'f3s\'e1got.
\par 82. Nem! [Azok, akiket isten\'edtettek,] meg fogj\'e1k tagadni a [hozz\'e1juk int\'e9zett] szolg\'e1latukat, \'e9s ellenfeleik lesznek.
\par 83. Vajon nem jutott tudom\'e1sodra az, hogy Mi bizony elk\'fcldt\'fck a s\'e1t\'e1nokat a hitetlenek ellen, hogy bujtogatva bujtogass\'e1k \'f5ket [a b\'fbnre]?
\par 84. Ne siettesd a r\'e1juk [v\'e1r\'f3 b\'fcntet\'e9st]! Mi bizony [pontos] sz\'e1mol\'e1ssal sz\'e1moljuk nekik [\'e9letidej\'fcket \'e9s tetteiket].
\par 85. Azon a napon egybegy\'fbjtj\'fck az istenf\'e9l\'f5ket a K\'f6ny\'f6r\'fcleteshez k\'fcld\'f6tts\'e9gk\'e9nt.
\par 86. \'c9s a gonosztev\'f5ket a Gyehenn\'e1hoz vezetj\'fck, mint szomjas ny\'e1jat az itat\'f3helyhez.
\par 87. Nem lesz m\'f3djuk a k\'f6zbenj\'e1r\'e1sra, csup\'e1n azoknak, akik enged\'e9lyt kaptak a K\'f6ny\'f6r\'fcletest\'f5l.
\par 
\par 88. \'c9s azt mondj\'e1k: \'84A K\'f6ny\'f6r\'fcletes gyermek\'e9v\'e9 tett [valakit].\'94
\par 89. Bizony, borzalmas dologgal j\'f6ttetek el\'f5.
\par 90. Csaknem sz\'e9trepednek az egek, \'e9s a f\'f6ld kett\'e9hasad, \'e9s a hegyek \'f6sszeroskadnak t\'f6rmel\'e9kk\'e9nt
\par 91. [Att\'f3l], hogy a K\'f6ny\'f6r\'fcletesnek gyermeket tulajdon\'edtanak.
\par 92. \'c9s nem val\'f3 a K\'f6ny\'f6r\'fcleteshez, hogy [valakit] gyermek\'e9v\'e9 tegyen.
\par 93. Nincs senki az egekben \'e9s a f\'f6ld\'f6n, aki ne szolgak\'e9nt j\'f6nne el a K\'f6ny\'f6r\'fcleteshez.
\par 94. Bizony, sz\'e1mba vette \'f5ket \'e9s sz\'e1m szerint tartja \'f5ket sz\'e1mon.
\par 95. \'c9s mindegyik\'fck egyed\'fcl j\'f6n el Hozz\'e1 a Felt\'e1mad\'e1s Napj\'e1n.
\par 
\par 96. Akik hisznek \'e9s j\'f3tetteket cselekszenek, azoknak a K\'f6ny\'f6r\'fcletes szeretetet fog adni.
\par 97. \'c9s bizony k\'f6nnyen \'e9rthet\'f5v\'e9 tett\'fck ezt [a Kor\'e1nt] a te [arab] nyelved \'e1ltal, hogy \'f6r\'f6mh\'edrt adj \'e1ltala az istenf\'e9l\'f5knek, \'e9s hogy figyelmeztesd vele a visz\'e1lykod\'f3 n\'e9pet.
\par 98. \'c9s h\'e1ny el\'f5tt\'fck \'e9lt nemzed\'e9ket puszt\'edtottunk el! Vajon \'e9rz\'e9kelsz-e k\'f6z\'fcl\'fck valakit, vagy hallasz t\'f5l\'fck ak\'e1r egy hangot [is]?
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid5968634 \page }{
\f0\fs24\insrsid5968634\charrsid5968634 20. sz\'fara \endash  Ta-ha (Ta-ha) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. Ta-ha.
\par 2. Nem az\'e9rt bocs\'e1tottuk le neked a Kor\'e1nt, hogy boldogtalan legy\'e9l,}{\chshdng0\chcfpat0\chcbpat8\insrsid5968634 
\par 3. Hanem em}{\insrsid5968634 l\'e9keztet\'f5\'fcl annak, aki f\'e9l [Allaht\'f3l].
\par 4. Lebocs\'e1tott [kinyilatkoztat\'e1sk\'e9nt] att\'f3l, Aki megteremtette a f\'f6ldet \'e9s a magass\'e1gos egeket.
\par 5. A K\'f6ny\'f6r\'fcletes elhelyezkedett [Hozz\'e1 m\'e9lt\'f3an] a Tr\'f3nuson.
\par 6. \'d6v\'e9 mindaz, ami az egekben, \'e9s ami a f\'f6ld\'f6n, \'e9s ami k\'f6z\'f6tt\'fck van, \'e9s az [is], }{\insrsid5968634\charrsid870336 ami a nedves talaj alatt van.}{\insrsid5968634 
\par 7. \'c9s ha hangosan mondod ki a sz\'f3t (a foh\'e1szt), h\'e1t bizony, \'d5 tudja a titkot \'e9s azt is, ami m\'e9g rejtettebb.
\par 8. Allah \endash  nincs m\'e1s isten csak \'d5! \'d5t illetik meg a Legszebb Nevek.
\par 
\par 9. \'c9s vajon eljutott-e hozz\'e1d a M\'f3zesr\'f5l sz\'f3l\'f3 elbesz\'e9l\'e9s?
\par 10. Amikor t\'fczet l\'e1tott, \'e9s azt mondta a csal\'e1dj\'e1nak: \'84Maradjatok [itt]! Bizony, \'e9n t\'fczet l\'e1ttam tiszt\'e1n, h\'e1tha hozhatok nektek onnan egy \'e9g\'f5 cs\'f3v\'e1t, vagy \'fatmutat\'e1st tal\'e1lok a t\'fbzn\'e9l.\'94
\par 11. \'c9s miut\'e1n odament hozz\'e1, megsz\'f3l\'edttatott: \'84\'d3 M\'f3zes!
\par 12. Bizony, \'e9n a te Urad vagyok! Vedd h\'e1t le saruidat! Bizony, te Tuva szent v\'f6lgy\'e9ben vagy!
\par 13. \'c9s \'e9n kiv\'e1lasztottalak t\'e9ged. Hallgasd h\'e1t azt, ami [kinyilatkoztat\'e1sk\'e9nt] sugaltatik!
\par 14. Bizony, \'c9n vagyok Allah, nincs m\'e1s isten csak \'c9n! Szolg\'e1lj h\'e1t engem, \'e9s tartsd meg az im\'e1dkoz\'e1st, hogy megeml\'e9kezz R\'f3lam!
\par 15. Bizony, az \'d3ra bek\'f6vetkezik, \'e1m csaknem elrejtem [a bek\'f6vetkez\'e9s\'e9ig], hogy minden ember megjutalmaztass\'e9k az\'e9rt, amiben igyekezett [munk\'e1lkodni].
\par 16. H\'e1t ne akad\'e1lyozzon meg abban az, aki nem hisz benne \'e9s a k\'e9ny\'e9t k\'f6veti, k\'fcl\'f6nben elpusztulsz!
\par 
\par 17. \'c9s mi az a jobb kezedben, \'f3 M\'f3zes?\'94
\par 18. Azt mondta [M\'f3zes]: \'84Ez a botom, t\'e1maszkodok r\'e1, \'e9s ler\'e1zom vele a juhaimnak [a leveleket], \'e9s m\'e1s haszon is van benne sz\'e1momra.\'94
\par 19. Azt mondta [Allah]: \'84Dobd el azt, \'f3 M\'f3zes!\'94
\par 20. Eldobta, \'e9s \'edme, az k\'edgy\'f3 [lett], amely sietve k\'faszott.
\par 21. Azt mondta [Allah]: \'84Vedd fel \'e9s ne f\'e9lj! Vissza fogjuk v\'e1ltoztatni el\'f5z\'f5 \'e1llapot\'e1ba.
\par 22. \'c9s szor\'edtsd a kezed az oldaladhoz, ragyog\'f3 feh\'e9ren j\'f6n el\'f5, rossz (betegs\'e9g) n\'e9lk\'fcl, egy m\'e1sik [csod\'e1s] jelk\'e9nt!
\par 23. [Az\'e9rt] hogy megmutassunk neked [n\'e9h\'e1nyat] a hatalmas Jeleinkb\'f5l.
\par 24. Menj el a F\'e1ra\'f3hoz, bizony \'f5 t\'falkap\'e1st k\'f6vetett el!\'94
\par 
\par 25. Azt mondta [M\'f3zes]: \'84Uram! T\'e1rd ki a keblemet!
\par 26. \'c9s k\'f6nny\'edtsd meg nekem a feladatomat!
\par 27. \'c9s oldd meg a csom\'f3t a nyelvemen!
\par 28. Hogy meg\'e9rthess\'e9k a szavamat.
\par 29. \'c9s adj sz\'e1momra seg\'edt\'f5t a csal\'e1domb\'f3l!
\par 30. \'c1ront, a testv\'e9remet!
\par 31. Er\'f5s\'edtsd meg \'e1ltala az er\'f5met!
\par 32. \'c9s tedd meg \'f5t t\'e1rsamnak a feladatomban! 
\par 33. Hogy magasztaljunk T\'e9ged sokszor.
\par 34. \'c9s megeml\'e9kezz\'fcnk R\'f3lad sokszor.
\par 35. Bizony, Te mindig bel\'e9nk l\'e1tsz.\'94
\par 36. Azt mondta [Allah]: \'84Bizony, megadatott neked, amit k\'e9rt\'e9l, \'f3 M\'f3zes!
\par 37. \'c9s m\'e1r egy m\'e1sik alkalommal is kegyesnek mutatkoztunk ir\'e1ntad.
\par 
\par 38. Amikor azt sugalltuk az \'e9desany\'e1dnak, ami sugalltatott.
\par 39. [Az lett sugallva neki, hogy:] 'Vesd \'f5t a l\'e1d\'e1ba, s vesd \'f5t a folyamba! A folyam pedig kidobja \'f5t a partra, \'e9s mag\'e1hoz veszi \'f5t egy ellens\'e9gem, [aki] az \'f5 ellens\'e9ge is.' \'c9s T\'f5lem val\'f3 szeretetet vetettem re
\'e1d, hogy a Szemem l\'e1tt\'e1ra neveljenek fel.
\par 40.}{\chshdng0\chcfpat0\chcbpat8\insrsid5968634  [\'c9s kegyesnek mutatkoztunk ir\'e1ntad] ami}{\insrsid5968634 kor odament a l\'e1nytestv\'e9red [a f\'e1ra\'f3 csal\'e1dj\'e1hoz] \'e9s azt mondta: 'Vajon elvezesselek titeket ahhoz, aki gondoz\'e1s\'e1
ba veszi?' \'cdgy juttattunk vissza t\'e9ged \'e9desany\'e1dhoz, hogy \'f6r\'f6mre leljen \'e9s ne szomorkodjon. \'c9s embert \'f6lt\'e9l, \'e1m Mi megmentett\'fcnk t\'e9ged a b\'e1natt\'f3l, \'e9s k\'eds\'e9rt\'e9seknek (megpr\'f3b\'e1ltat\'e1
soknak) tett\'fcnk ki t\'e9ged. \'c9s \'e9vekig id\'f5zt\'e9l Midi\'e1n n\'e9pe k\'f6z\'f6tt, majd elj\'f6tt\'e9l egy elrendelt [id\'f5pontban], \'f3 M\'f3zes.
\par 41. \'c9s t\'e9ged v\'e1lasztottalak Magamnak.
\par 42. Menj, te \'e9s a testv\'e9red, a jeleimmel, }{\insrsid5968634\charrsid870336 \'e9s ne lankadjatok a R\'f3lam val\'f3 megeml\'e9kez\'e9sben!
\par 43. Menjetek ti ketten a F\'e1ra\'f3hoz! Bizony, \'f5 t\'falkap\'e1sra vetemedett.}{\insrsid5968634 
\par 44. Mondjatok h\'e1t ti ketten szel\'edd szavakat neki, h\'e1tha okul [az int\'e9sb\'f5l] vagy f\'e9l [Allaht\'f3l]!\'94
\par 45. Azt mondt\'e1k: \'84\'d3 Urunk! Bizony, mi att\'f3l f\'e9l\'fcnk, hogy r\'e1nk ront, vagy hogy }{\insrsid5968634\charrsid870336 t\'falkap\'e1sra vetemedik [ellen\'fcnk].\'94}{\insrsid5968634 
\par 46. Azt mondta [Allah]: \'84Ne f\'e9ljetek! Bizony, \'c9n veletek vagyok; hallok \'e9s l\'e1tok!
\par 47. Menjetek h\'e1t el ketten hozz\'e1 \'e9s mondj\'e1tok: 'Bizony, mi a te Urad k\'fcld\'f6ttei vagyunk! K\'fcldd h\'e1t el vel\'fcnk Izrael gyermekeit, \'e9s ne gy\'f6t\'f6rd \'f5ket [tov\'e1bb]! Jelet hoztuk neked Uradt\'f3l, \'e9s b\'e9kess\'e9
g arra, aki k\'f6veti az \'fatmutat\'e1st.
\par 48. Bizony [kinyilatkoztat\'e1sk\'e9nt] sugalltatott nek\'fcnk az, hogy a gy\'f6trelem annak j\'e1r, aki meghazudtolja [a bizony\'edt\'e9kokat] \'e9s elfordul.'\'94
\par 
\par 49. Azt mondta [a F\'e1ra\'f3]: \'84Ki a ti uratok, \'f3 M\'f3zes?\'94
\par 50. Azt mondta [M\'f3zes]: \'84A mi Urunk az, aki megadta minden dolognak a teremtett [alkat\'e1t \'e9s form\'e1j\'e1t], majd utat mutatott.\'94
\par 51. Azt mondta [a F\'e1ra\'f3]: \'84Mi a helyzet az el\'f5z\'f5 nemzed\'e9kekkel?\'94
\par 52. Azt mondta [M\'f3zes]: \'84Az arr\'f3l sz\'f3l\'f3 tud\'e1s az Uramn\'e1l van egy \'cdr\'e1sban (az \'d5rz\'f6tt T\'e1bl\'e1n). Az \'e9n Uram nem t\'e9ved \'e9s nem felejt.\'94
\par 53. Aki a f\'f6ldet }{\insrsid5968634\charrsid6960962 egyengetett\'e9}{\insrsid5968634  tette a sz\'e1motokra \'e9s utakat helyezett r\'e1 nektek, az \'e9gb\'f5l pedig vizet bocs\'e1tott le, ami \'e1ltal k\'fcl\'f6nb\'f6z\'f5 fajta n\'f6v\'e9
nyeket hozunk el\'f5.
\par 54. Egyetek [a f\'f6ld term\'e9seib\'f5l] \'e9s legeltess\'e9tek j\'f3sz\'e1gaitokat! Bizony ebben jelek vannak azok sz\'e1m\'e1ra, akiknek van esz\'fck.
\par 
\par 55. Abb\'f3l teremtett\'fcnk meg titeket \'e9s oda fogunk visszat\'e9r\'edteni, \'e9s abb\'f3l fogunk el\'f5hozni titeket egy m\'e1sik alkalommal.
\par 
\par 56. \'c9s bizony, megmutattuk m\'e1r neki (a F\'e1ra\'f3nak) minden jel\'fcnket, \'e1m \'f5 meghazudtolta \'e9s visszautas\'edtotta [azokat].
\par 57. Azt mondta [a F\'e1ra\'f3]: \'84Vajon az\'e9rt j\'f6tt\'e9l el hozz\'e1nk \endash  \'f3 M\'f3zes \endash  hogy el\'fbzz minket a f\'f6ld\'fcnkr\'f5l a var\'e1zslatod \'e1ltal?
\par 58. Akkor bizony mi is hozunk neked ahhoz hasonl\'f3 var\'e1zslatot. Jel\'f6lj h\'e1t ki k\'f6zt\'fcnk \'e9s k\'f6zted egy id\'f5pontot a tal\'e1lkoz\'e1sra \endash  egy [mindkett\'f5nknek] egyenl\'f5 [es\'e9lyt ad\'f3] helyen \endash  amit nem szeg\'fc
nk meg, sem mi, sem te!\'94
\par 59. Azt mondta [M\'f3zes]: \'84A tal\'e1lkoz\'f3ra kijel\'f6lt id\'f5pontotok a D\'edsz (\'fcnnep) napja, \'e9s [\'fagy legyen,] hogy az emberek gy\'fbjtessenek egybe d\'e9lel\'f5tt.\'94
\par 60. \'c9s a F\'e1ra\'f3 elfordult \'e9s \'f6sszegy\'fbjt\'f6tte a fondorlat\'e1t, majd el\'f5j\'f6tt.
\par 61. Azt mondta M\'f3zes nekik (a F\'e1ra\'f3 \'f6sszegy\'fbjt\'f6tt var\'e1zsl\'f3inak): \'84Jaj nektek! Ne tal\'e1ljatok ki hazugs\'e1got Allahr\'f3l, mert akkor elt\'f6r\'f6l titeket egy gy\'f6trelemmel! \'c9s bizony kudarcot vall az, aki [hazugs\'e1
got] tal\'e1l ki.\'94
\par 62. \'c9s \'f6sszek\'fcl\'f6nb\'f6ztek az \'fcgy\'fck\'f6n egym\'e1s k\'f6z\'f6tt [hogy mit tegyenek] \'e9s titokban tartott\'e1k bizalmas besz\'e9lget\'e9s\'fcket.
\par 63. Azt mondt\'e1k: \'84Bizony, ezek ketten var\'e1zsl\'f3k, akik var\'e1zslatuk \'e1ltal akarnak titeket el\'fbzni a f\'f6ldetekr\'f5l, \'e9s elvenni p\'e9ld\'e1s utatokat (\'e9letm\'f3dotokat).
\par 64. Gy\'fbjts\'e9tek h\'e1t \'f6ssze a fondorlatotokat, majd gyertek sorakozva! \'c9s bizony az boldogul ma, aki fel\'fclkerekedik.\'94
\par 65. Azt mondt\'e1k: \'84\'d3 M\'f3zes! Vagy te dobsz, vagy mi lesz\'fcnk az els\'f5k, akik dobnak!\'94
\par 66. Azt mondta [M\'f3zes]: \'84Ink\'e1bb, dobjatok ti [el\'f5sz\'f6r]!\'94 S \'edme, a var\'e1zslatuk folyt\'e1n \'fagy t\'fbnt neki, mintha a k\'f6teleik \'e9s a botjaik sietve k\'faszn\'e1nak.
\par 67. \'c9s f\'e9lelmet \'e9rzett mag\'e1ban M\'f3zes.
\par 68. Azt mondtuk: \'84Ne f\'e9lj! Bizony, te vagy a fel\'fclkereked\'f5!
\par 69. \'c9s dobd el azt, ami a jobbodban van, el fogja nyelni azt, amit m\'fbveltek! Csup\'e1n egy var\'e1zsl\'f3 fondorlata az, amit m\'fbveltek. \'c9s a var\'e1zsl\'f3 nem boldogul, b\'e1rhova is megy.\'94
\par 
\par 70. A var\'e1zsl\'f3k }{\insrsid5968634\charrsid870336 pedig a f\'f6ldre vettettek leborulva}{\insrsid5968634  [\'e9s] azt mondt\'e1k: \'84Hisz\'fcnk \'c1ron \'e9s M\'f3zes Ur\'e1ban!\'94
\par 71. Azt mondta [a F\'e1ra\'f3]: \'84Hittetek neki, miel\'f5tt \'e9n enged\'e9lyt adtam volna r\'e1 nektek? Bizony, \'f5 a vezet\'f5t\'f6k, aki megtan\'edtotta nektek a var\'e1zsl\'e1st. Ez\'e9rt bizony lev\'e1gom a kezeteket \'e9s a l\'e1batokat [egym\'e1
ssal ellent\'e9tesen], \'e9s a p\'e1lmaf\'e1k t\'f6rzs\'e9re fesz\'edtelek fel titeket, \'e9s bizony megtudj\'e1tok, hogy melyik\'fcnk gy\'f6trelme s\'falyosabb \'e9s maradand\'f3bb!\'94
\par 72. Azt mondt\'e1k: \'84Nem fogunk t\'e9ged el\'f5nyben r\'e9szes\'edteni azzal szemben, ami elj\'f6tt hozz\'e1nk a nyilv\'e1nval\'f3 bizony\'edt\'e9kokb\'f3l, \'e9s [azzal szemben sem] aki l\'e9trehozott minket! Hajtsd h\'e1t v\'e9gre azt, amit v\'e9
gre akarsz hajtani! A v\'e9grehajt\'e1sod csup\'e1n az evil\'e1gi \'e9letre korl\'e1toz\'f3dik!
\par 73. Bizony, mi hisz\'fcnk Urunkban, [v\'e1gyakozva arra,] hogy megbocs\'e1ssa nek\'fcnk a v\'e9tkeinket, \'e9s a var\'e1zsl\'e1st, amire k\'e9nyszer\'edtett\'e9l minket. \'c9s Allah [jutalma] jobb \'e9s [fizets\'e9ge] maradand\'f3bb.\'94
\par 74. Bizony, aki Ur\'e1hoz gonosztev\'f5k\'e9nt (hitetlenk\'e9nt) j\'f6n el, annak bizony a [Pokol-]t\'fbz j\'e1r, ahol nem hal meg \'e9s nem is \'e9l.
\par 75. Aki pedig h\'edv\'f5k\'e9nt j\'f6n el Hozz\'e1, \'e9s j\'f3tetteket cselekedett, annak a magass\'e1gos fokozatok j\'e1rnak:
\par 76. \'d6r\'f6kk\'e9 tart\'f3 kertek, amelyek al\'f3l foly\'f3k folynak, \'f6r\'f6kk\'e9 abban maradnak, \'e9s ez a fizets\'e9ge annak, aki megtiszt\'edtja mag\'e1t [a v\'e9tkeit\'f5l].
\par 
\par 77. \'c9s bizony azt sugalltuk [kinyilatkoztat\'e1sk\'e9nt] M\'f3zesnek: \'84Indulj el \'e9jszaka a szolg\'e1immal, \'e9s v\'e1gj nekik [botoddal] sz\'e1raz utat a tengeren}{\insrsid5968634\charrsid870336 ! Nem kell f\'e9lned att\'f3l}{\insrsid5968634 
, hogy utol\'e9rnek, \'e9s nem kell agg\'f3dnod [a v\'edzbe fullad\'e1st\'f3l]!\'94
\par 78. A F\'e1ra\'f3 pedig k\'f6vette \'f5ket katon\'e1ival, \'e1m bebor\'edtotta \'f5ket a tengerb\'f5l az, ami bebor\'edtotta.
\par 79. \'c9s a F\'e1ra\'f3 t\'e9velyg\'e9sbe vitte a n\'e9p\'e9t \'e9s nem vezette [\'f5ket az igaz \'faton].
\par 
\par 80. \'d3 Izrael fiai! Bizony megmentett\'fcnk titeket az ellens\'e9getekt\'f5l, \'e9s id\'f5pontot jel\'f6lt\'fcnk ki nektek a hegy jobb oldal\'e1n [a T\'f3ra lebocs\'e1t\'e1s\'e1ra], \'e9s lebocs\'e1tottuk nektek a mann\'e1t \'e9s a f\'fcrjeket.
\par 81. Egyetek azokb\'f3l a j\'f3 dolgokb\'f3l, amelyekkel ell\'e1ttunk titeket, }{\insrsid5968634\charrsid3868422 \'e1m ne k\'f6vessetek el t\'falkap\'e1st abban, nehogy les\'fajtson r\'e1tok a haragv\'e1som! \'c9s akire les\'fajt}{\insrsid5968634  a haragv
\'e1som, az bizony lezuhan [a Pokol-t\'fbzbe].
\par 82. \'c9s bizony \'c9n Megbocs\'e1t\'f3 vagyok az ir\'e1nt, aki b\'fbnb\'e1natot tan\'fas\'edt, hisz \'e9s j\'f3tettet cselekszik, majd az igaz \'faton marad.
\par 
\par 83. [Allah azt mondta:] \'84\'c9s mi siettetett el t\'e9ged a n\'e9pedt\'f5l, \'f3 M\'f3zes?\'94
\par 84. Azt mondta [M\'f3zes:] \'84\'d5k ott vannak a nyomomban, \'e9s az\'e9rt siettem hozz\'e1d Uram, hogy el\'e9gedett legy\'e9l [velem].\'94
\par 85. Azt mondta [Allah:] \'84Bizony, Mi k\'eds\'e9rt\'e9seknek (megpr\'f3b\'e1ltat\'e1soknak) tett\'fck ki a n\'e9pedet t\'e1voll\'e9tedben, \'e9s t\'e9velyg\'e9sbe vitte \'f5ket Asz-Sz\'e1mir\'ed.\'94
\par 
\par 86. \'c9s miut\'e1n M\'f3zes haragosan \'e9s szomor\'faan ment vissza a n\'e9p\'e9hez, azt mondta: \'84\'d3 n\'e9pem! Nem \'edg\'e9rt-e nektek az Uratok sz\'e9p \'edg\'e9retet? Vajon hossz\'fanak bizonyult nektek az egyezm\'e9ny [beteljesed\'e9
se]? Vagy azt akart\'e1tok, hogy haragv\'e1s s\'fajtson le r\'e1tok az Uratokt\'f3l, ez\'e9rt szegt\'e9tek meg a nekem tett \'edg\'e9retet?\'94
\par 87. Azt mondt\'e1k: \'84Nem j\'f3sz\'e1ntunkb\'f3l szegt\'fck meg a neked tett \'edg\'e9retet, hanem meg lett\'fcnk terhelve [az egyiptomi] n\'e9p \'e9kszereinek [elvitel\'e9nek] terh\'e9vel (ellop\'e1suk b\'fbn\'e9vel), ez\'e9rt [a t\'fbzbe] vetett\'fc
k azokat, \'e9s ekk\'e9ppen dobta asz-Sz\'e1mir\'ed [az \'e9kszereket a t\'fbzbe].\'94
\par 88. \'c9s [\'f5 volt az, aki] el\'f5hozott [az \'e9kszereikb\'f5l] nekik egy testtel b\'edr\'f3 borj\'fat, aminek b\'f5g\'f5 [hangja] volt. \'c9s azt mondt\'e1k: \'84Ez a ti istenetek \'e9s M\'f3zes istene, \'f5 azonban elfelejtette [\'e9s a keres\'e9s
\'e9re indult].\'94
\par 89. Vajon h\'e1t nem l\'e1tj\'e1k, hogy az nem viszonozza nekik a besz\'e9det, \'e9s nem \'e1ll m\'f3dj\'e1ban sz\'e1mukra hasznot [hozni], sem \'e1rtalmat [elt\'e1vol\'edtani]?
\par 90. \'c9s bizony, azt mondta kor\'e1bban nekik \'c1ron: \'84\'d3 n\'e9pem! Csup\'e1n k\'eds\'e9rt\'e9snek lettetek kit\'e9ve az (a b\'e1lv\'e1ny) \'e1ltal, \'e9s bizony, a ti Uratok a K\'f6ny\'f6r\'fcletes. K\'f6vessetek h\'e1t engem, \'e9s
 engedelmeskedjetek a parancsomnak!\'94
\par 91. Azt mondt\'e1k: \'84Mi nem hagyunk fel azzal, hogy kitart\'f3an [im\'e1djuk] azt, am\'edg M\'f3zes vissza nem t\'e9r hozz\'e1nk!\'94
\par 92. Azt mondta [M\'f3zes]: \'84\'d3 \'c1ron! Amikor megl\'e1ttad \'f5ket elt\'e9velyedni, mi tartott vissza t\'e9ged att\'f3l, hogy
\par 93. K\'f6vess engem [\'e9s magukra hagyd \'f5ket]? H\'e1t vajon ellenszeg\'fclt\'e9l a parancsomnak?\'94
\par 94. Azt mondta [\'c1ron]: \'84\'d3 any\'e1m fia! Ne ragadj meg engem a szak\'e1llamn\'e1l \'e9s a fejemn\'e9l fogva! Bizony, \'e9n att\'f3l f\'e9ltem, hogy azt mondod: 'Megosztottad Izrael gyermekeit \'e9s nem k\'f6vetted a szavamat.'\'94
\par 
\par 95. Azt mondta [M\'f3zes]: \'84Milyen s\'falyos \'fcgy [vitt r\'e1 t\'e9ged arra], \'f3 Sz\'e1mir\'ed?\'94
\par 96. Azt mondta: \'84\'c9n megl\'e1ttam azt, amit \'f5k nem l\'e1ttak meg, \'e9s megmarkoltam egy mar\'e9knyi [port] a k\'fcld\'f6tt nyom\'e1b\'f3l, \'e9s r\'e1vetettem azt [az olvasztott \'e9kszerekre]. \'c9s ekk\'e9ppen csalt l\'e9pre engem saj\'e1
t magam.\'94
\par 97. Azt mondta [M\'f3zes]: \'84T\'e1vozz h\'e1t! Bizony, az [evil\'e1gi] \'e9letben az illet t\'e9ged [b\'fcntet\'e9s\'fcl], hogy azt mondd: 'Ne \'e9rintsetek [engem]!' \'c9s [a t\'falvil\'e1gon] meg\'edg\'e9rt id\'f5pontod lesz [az elsz\'e1mol\'e1
sra], amely nem lesz megszegve. \'c9s n\'e9zz csak az istenedre, amelyet kitart\'f3an [im\'e1dt\'e1l]! Bizony el fogjuk azt \'e9getni, majd porr\'e1 z\'fazva hintj\'fck sz\'e9t a folyamba.
\par 98. Bizony a ti Istenetek csakis Allah, akin k\'edv\'fcl nincs m\'e1s [jogosan im\'e1dhat\'f3] istens\'e9g! \'d5 mindent \'e1tfog tud\'e1ssal.\'94
\par 
\par 99. Ekk\'e9ppen besz\'e9l\'fcnk el neked azon h\'edrekb\'f5l, amelyek m\'e1r el\'f5z\'f5leg [megt\'f6rt\'e9ntek]. \'c9s bizony T\'f5l\'fcnk sz\'e1rmaz\'f3 eml\'e9keztet\'e9st (a Kor\'e1nt) adtunk neked.
\par 100. Aki elfordul att\'f3l, az bizony}{\chshdng0\chcfpat0\chcbpat8\insrsid5968634  [emiatt] a}{\insrsid5968634  Felt\'e1mad\'e1s Napj\'e1n terhet fog hordani.
\par 101. \'d6r\'f6kk\'e9 abban}{\chshdng0\chcfpat0\chcbpat8\insrsid5968634  [a b\'fcntet\'e9sben] }{\insrsid5968634 fognak maradni. \'c9s milyen rossz teher lesz az a Felt\'e1mad\'e1s Napj\'e1n!
\par 
\par 102. A napon, amikor megf\'favatik a K\'fcrt, \'e9s a gonosztev\'f5ket vil\'e1gtalanokk\'e9nt gy\'fbjtj\'fck majd \'f6ssze.
\par 103. \'d6sszes\'fagnak egym\'e1s k\'f6z\'f6tt: \'84Nem id\'f5ztetek [a Felt\'e1mad\'e1s el\'f5tt] t\'f6bbet, mint t\'edz napot.\'94 104. Mi tudunk a legjobban arr\'f3l, amit \'f5k mondanak, amikor is a legp\'e9ld\'e1sabb \'e9letvitel\'fb (felfog\'e1s\'fa
) k\'f6z\'fcl\'fck azt fogja mondani: \'84Nem id\'f5ztetek t\'f6bbet, mint egy napot.\'94
\par 105. \'c9s k\'e9rdeznek t\'e9ged a hegyekr\'f5l [hogy mi lesz vel\'fck az \'cdt\'e9let napj\'e1n]. Mondd [\'f3 Mohamed]: \'84Uram porr\'e1 z\'fazva fogja sz\'e9thinteni azokat,
\par 106. \'c9s [a hely\'fck\'f6n] kietlen lap\'e1lyt hagy.
\par 107. Nem l\'e1tsz azon ferdes\'e9get, sem egyenetlens\'e9get.\'94
\par 108. Azon a napon k\'f6vetni fogj\'e1k a h\'edv\'f3 [hangj\'e1t], aki el\'f5l nem lehet kit\'e9rni. Al\'e1zatosan elhalkulnak a hangok a K\'f6ny\'f6r\'fcletes el\'f5tt, nem hallasz h\'e1t m\'e1st, csup\'e1n suttog\'e1st.
\par 109. Azon a napon nem haszn\'e1l a k\'f6zbenj\'e1r\'e1s, kiv\'e9ve annak [a k\'f6zbenj\'e1r\'e1sa], akinek a K\'f6ny\'f6r\'fcletes enged\'e9lyt adott, \'e9s megel\'e9gedett annak az [iszl\'e1m tan\'fas\'e1gt\'e9tel\'e9r\'f5l sz\'f3l\'f3] mond\'e1s\'e1
val [aki\'e9rt k\'f6zbenj\'e1rnak].
\par 110. Tudja azt, ami el\'f5tt\'fck van [a j\'f6v\'f5t illet\'f5en], \'e9s azt, ami m\'f6g\'f6tt\'fck van [a m\'faltat illet\'f5en], \'e9s nem foghatnak fel semmit az \'d5 tud\'e1s\'e1b\'f3l.
\par 111. \'c9s lehorgadnak az arcok [az al\'e1zatt\'f3l] az \'c9l\'f5, a [saj\'e1t mag\'e1t \'e9s minden l\'e9tez\'f5t] Fenntart\'f3 el\'f5tt. \'c9s bizony kudarcot fog vallani az, aki igazs\'e1gtalans\'e1got hordoz.
\par 112. \'c9s aki j\'f3tetteket cselekszik, mik\'f6zben \'f5 h\'edv\'f5, annak nem kell f\'e9lnie igazs\'e1gtalans\'e1gt\'f3l, sem jutalm\'e1nak cs\'f6kken\'e9s\'e9t\'f5l.
\par 113. }{\insrsid5968634\charrsid3868422 \'c9s ekk\'e9ppen bocs\'e1tottuk le arab Kor\'e1nk\'e9nt, \'e9s sorakoztattunk fel benne [sokf\'e9le] fenyeget\'e9st, h\'e1tha istenf\'e9l\'f5k lesznek, vagy eml\'e9keztet\'e9st hoz el nekik.}{\insrsid5968634 
\par 
\par 114. \'c9s Allah afelett van [amit R\'f3la \'e1ll\'edtanak], [\'d5] az Igaz Kir\'e1ly. \'c9s ne siess [\'f3 Mohamed] a Kor\'e1n [recit\'e1l\'e1s\'e1val] miel\'f5tt befejez\'f5dne neked annak [kinyilatkoztatott] sugallata! \'c9s mondd: \'84Uram, gyarap\'ed
ts engem tud\'e1sban!\'94
\par 
\par 115. \'c9s bizony, meghagytuk \'c1d\'e1mnak kor\'e1bban [hogy ne egyen a tiltott f\'e1r\'f3l], \'e1m \'f5 elfeledkezett, \'e9s nem tal\'e1ltunk n\'e1la elsz\'e1nts\'e1got.
\par 116. \'c9s [eml\'edtsd meg,] amikor azt mondtuk az angyaloknak: \'84Boruljatok le \'c1d\'e1m el\'f5tt!\'94, s [azon nyomban] leborultak, kiv\'e9ve Ibl\'edszt, [\'f5] visszautas\'edtotta [azt, hogy leboruljon].
\par 117. Azt mondtuk: \'84\'d3 \'c1d\'e1m! Bizony ez az ellens\'e9ged neked \'e9s a feles\'e9gednek; h\'e1t nehogy ki\'fbzz\'f6n titeket a Paradicsomb\'f3l, mert akkor boldogtalan leszel!
\par 118. Bizony, abban te nem fogsz \'e9hezni, \'e9s nem leszel ruh\'e1tlan.
\par 119. \'c9s bizony, abban te nem fogsz szomjazni, se nem leszel kit\'e9ve a forr\'f3s\'e1gnak.\'94
\par 120. A s\'e1t\'e1n pedig sugdosott neki. Azt mondta: \'84\'d3 \'c1d\'e1m! Vajon megmutassam-e neked az \'f6r\'f6kl\'e9t f\'e1j\'e1t \'e9s olyan hatalmat, }{\insrsid5968634\charrsid6164517 ami [soha] nem m\'falik el?\'94}{\insrsid5968634 
\par 121. \'d5k ketten pedig ettek abb\'f3l, s l\'e1that\'f3v\'e1 v\'e1lt kettej\'fck sz\'e1m\'e1ra a szem\'e9rm\'fck, \'e9s elkezdt\'e9k elfedni magukat a Paradicsom [f\'e1inak] leveleivel. \'c9s \'c1d\'e1m ellenszeg\'fclt Ur\'e1nak \'e9s elt\'e9velyedett.

\par 122. Majd kiv\'e1lasztotta \'f5t az Ura, \'e9s kiengesztel\'f5d\'f6tt ir\'e1nta, \'e9s igaz \'fatra vezette.
\par 
\par 123. Azt mondta [Allah]: \'84Menjetek le mindannyian innen (a Paradicsomb\'f3l)! Egyik\'f5t\'f6k a m\'e1siknak ellens\'e9ge! \'c9s ha \'fatmutat\'e1s \'e9rkezik hozz\'e1tok majd T\'f5lem, az, aki k\'f6veti az \'fatmutat\'e1somat, az nem t\'e9velyedik el 
\'e9s nem lesz boldogtalan.
\par 124. \'c9s aki elfordul a R\'f3lam val\'f3 megeml\'e9kez\'e9st\'f5l, h\'e1t bizony annak sz\'fbk\'f6s lesz a meg\'e9lhet\'e9se, \'e9s vakon fogjuk a Felt\'e1mad\'e1s Napj\'e1n egybegy\'fbjteni.\'94
\par 125. Azt fogja mondani: \'84Uram! Mi\'e9rt gy\'fbjt\'f6tt\'e9l engem egybe vakon, holott [kor\'e1bban] l\'e1t\'f3 voltam?\'94
\par 126. Azt fogja [Allah] mondani: \'84Ekk\'e9ppen: elj\'f6ttek hozz\'e1d a jeleink, te pedig megfeledkezt\'e9l azokr\'f3l, \'e9s ekk\'e9ppen leszel ma te is elfelejtve.\'94
\par 127. \'c9s mi ekk\'e9ppen fizet\'fcnk meg annak, aki m\'e9rt\'e9ktelen \'e9s nem hisz Ura jeleiben. \'c9s bizony a T\'falvil\'e1g gy\'f6trelme }{\insrsid5968634\charrsid7755571 s\'falyosabb}{\insrsid5968634  \'e9s maradand\'f3bb!
\par 
\par 128. H\'e1t vajon nem \'fatmutat\'e1s-e nekik az, hogy h\'e1ny el\'f5tt\'fck \'e9lt nemzed\'e9ket puszt\'edtottunk el, akiknek a lak\'f3helyein j\'e1rnak? Bizony ebben jelek vannak azok sz\'e1m\'e1ra, akiknek van esz\'fck.
\par 129. \'c9s ha nem lett volna kor\'e1bban [a b\'fcntet\'e9s k\'e9sleltet\'e9s\'e9r\'f5l] egy sz\'f3 az Uradt\'f3l, akkor elker\'fclhetetlen lenne (azonnal bek\'f6vetkezne). De megszabott hat\'e1rid\'f5 van [minden dolog sz\'e1m\'e1ra]!
\par 130. Legy\'e9l h\'e1t t\'fcrelmes azzal szemben, amit mondanak! \'c9s magasztald Urad az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, napkelte \'e9s napnyugta el\'f5tt! \'c9s az \'e9jszaka \'f3r\'e1iban magasztald h\'e1t [\'d5t] \'e9s a nappal k\'e9t v\'e9
g\'e9n, h\'e1tha el\'e9gedetts\'e9gre lelsz!
\par 131. \'c9s ne mereszd a szemed arra, amit egyes csoportoknak k\'f6z\'fcl\'fck \'e9lvezet\'fcl adtunk az evil\'e1gi \'e9let csillog\'e1sak\'e9nt, hogy \'e1ltala k\'eds\'e9rt\'e9snek tegy\'fck ki \'f5ket! \'c1m az Urad ell\'e1t\'e1sa jobb \'e9s maradand\'f3
bb!
\par 132. \'c9s parancsold meg a csal\'e1dodnak az }{\insrsid5968634\charrsid3868422 im\'e1dkoz\'e1s [megtart\'e1s\'e1t],}{\insrsid5968634  \'e9s l\'e9gy te magad is kitart\'f3 abban! Nem k\'e9r\'fcnk t\'f5led ell\'e1t\'e1st, hanem Mi l\'e1tunk el t\'e9ged. 
\'c9s a [j\'f3] v\'e9g az istenf\'e9lelem\'e9rt [j\'e1r]!
\par 
\par 133. \'c9s azt mondt\'e1k: \'84Mi\'e9rt nem hozott el nek\'fcnk egy jelet az Ur\'e1t\'f3l?\'94 H\'e1t vajon nem j\'f6tt el hozz\'e1juk annak vil\'e1gos bizony\'edt\'e9ka, ami a kor\'e1bbi lapokon van?
\par 134. \'c9s ha m\'e9g azel\'f5tt (Mohamed Pr\'f3f\'e9ta elj\'f6vetele el\'f5tt) elpuszt\'edtottuk volna \'f5ket egy gy\'f6trelemmel, bizony azt mondt\'e1k volna: \'84Urunk! Mi\'e9rt nem k\'fcldt\'e9l el hozz\'e1nk egy k\'fcld\'f6ttet, hogy k\'f6vethett\'fc
k volna a Te jeleidet, azel\'f5tt, hogy megal\'e1ztat\'e1s \'e9s sz\'e9gyen \'e9rt volna minket?\'94
\par 135. Mondd: \'84Mindenki v\'e1r. Ti is v\'e1rjatok h\'e1t! Meg fogj\'e1tok tudni, hogy kik az Egyenes \'dat birtokosai \'e9s kik lettek igaz \'fatra vezetve.\'94
\par 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid5968634 \page }{
\f0\fs24\insrsid5968634\charrsid5968634 21. sz\'fara \endash  A pr\'f3f\'e9t\'e1k (al-Anbija) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\tx424\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4984954 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid4984954 \tab }{\insrsid5968634 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. K\'f6zeleg az emberekhez az elsz\'e1moltat\'e1suk, \'e9s \'f5k figyelmetlens\'e9g [\'e1llapot\'e1ban] vannak, \'fcgyet sem vetnek r\'e1.
\par 2. Nem j\'f6n el hozz\'e1juk Urukt\'f3l \'faj eml\'e9keztet\'e9s an\'e9lk\'fcl, hogy ne hallgatn\'e1k azt, mik\'f6zben j\'e1tszadoznak
\par 3. [\'dagy, hogy] sz\'f3rakozott a sz\'edv\'fck. \'c9s azok, akik igazs\'e1gtalans\'e1got k\'f6vettek el, titokban bizalmas besz\'e9dbe elegyedtek: \'84Vajon \'f5 nem m\'e1s-e, mint egy hozz\'e1tok hasonl\'f3 ember? A var\'e1zslatra akartok-e h\'e1
t vetemedni, holott l\'e1tj\'e1tok [var\'e1zslat\'e1t]?\'94
\par 4. Azt mondta [a Pr\'f3f\'e9ta]: \'84Az \'e9n Uram tud [minden kimondott] sz\'f3r\'f3l az \'e9gben \'e9s a f\'f6ld\'f6n, \'e9s \'d5 a mindent Hall\'f3, mindent Tud\'f3.\'94
\par 5. De nem! [A hitetlenek] azt mondt\'e1k [a Kor\'e1nr\'f3l:] \'84Zavaros \'e1lmok [ezek]! De nem! \'d5 tal\'e1lta ki azokat. De nem! \'d5 egy k\'f6lt\'f5! Hozzon h\'e1t el nek\'fcnk egy jelet, ahogyan a hajdanvoltak el lettek k\'fcldve!\'94
\par 6. Nem hitt el\'f5tt\'fck egyetlen telep\'fcl\'e9s [lakoss\'e1ga] sem, [amelyet] elpuszt\'edtottunk, h\'e1t \'f5k fognak-e hinni [a jelekben]?
\par 7. \'c9s nem k\'fcldt\'fcnk el el\'f5tted [\'f3 Mohamed], csak (kiz\'e1r\'f3lag) f\'e9rfiakat, akiknek [kinyilatkoztat\'e1st] sugalltunk. K\'e9rdezz\'e9tek h\'e1t meg az Eml\'e9keztet\'e9s (az \'cdr\'e1s) birtokosait, ha nem tudj\'e1tok [azt]!
\par 8. \'c9s nem tett\'fck \'f5ket [olyan] testekk\'e9, amelyek nem esznek \'e9lelmet}{\insrsid5968634\charrsid14893656 ,}{\insrsid5968634  \'e9s nem voltak \'f6r\'f6kl\'e9t\'fbek (halhatatlanok).
\par 9. Majd bev\'e1ltottuk a fel\'e9j\'fck tett \'edg\'e9retet: megmentett\'fck \'f5ket \'e9s azokat, akiket akarunk, \'e9s elpuszt\'edtottuk a m\'e9rt\'e9kteleneket.
\par 10. Bizony, lebocs\'e1tottunk nektek egy \'cdr\'e1st, amelyben eml\'e9keztet\'e9s (int\'e9s \'e9s tekint\'e9ly) van sz\'e1motokra. Vajon h\'e1t nem \'e9ltek az eszetekkel?
\par 
\par 11. \'c9s h\'e1ny [olyan] telep\'fcl\'e9st puszt\'edtottunk el, amely igazs\'e1gtalan volt, \'e9s m\'e1s n\'e9pet hoztunk l\'e9tre ut\'e1nuk!
\par 12. Majd amikor meg\'e9rezt\'e9k csap\'e1sunkat, \'edme, \'f5k az el\'f5l elszaladnak!
\par 13. Ne szaladjatok el, \'e9s t\'e9rjetek vissza a nektek juttatott t\'fal\'e1rad\'f3 j\'f3l\'e9thez \'e9s a lak\'f3helyeitekhez, h\'e1tha meg lesztek k\'e9rdezve!
\par 14. Azt mondt\'e1k: \'84Jaj nek\'fcnk! Mi bizony igazs\'e1gtalanok voltunk!\'94
\par 15. S nem sz\'fbnt meg [ezen] ki\'e1lt\'e1suk, am\'edg nem tett\'fck \'f5ket learatott\'e1, \'e9lettelenn\'e9 [mint a letarolt vet\'e9s, \'e9s a kialudt t\'fbz].
\par 
\par 16. \'c9s nem teremtett\'fck meg az egeket \'e9s a f\'f6ldet, \'e9s mindazt, ami k\'f6z\'f6tt\'fck van j\'e1tszadoz\'e1sb\'f3l.
\par 17. Ha sz\'f3rakoz\'e1sra (feles\'e9gre vagy gyermekre) akartunk volna szert tenni, akkor T\'f5l\'fcnk }{\insrsid5968634\charrsid12212905 sz\'e1rmaz\'f3t tett\'fcnk volna [feles\'e9gg\'e9 vagy gyermekk\'e9], ha [ezt] akartuk volna tenni.
\par 18. De nem! Mi az igazs\'e1got a hamiss\'e1gra haj\'edtjuk, [amely] sz\'e9tfoszlatja azt, \'e9s \'edme,}{\insrsid12212905\charrsid12212905  az elsz\'e1ll}{\insrsid5968634\charrsid12212905 . \'c9s jaj nektek amiatt, amit le\'edrtok!
\par 19. \'c9s \'d6v\'e9 mindenki}{\insrsid5968634 , aki az egekben \'e9s a f\'f6ld\'f6n van, \'e9s akik N\'e1la vannak (az angyalok), azok nem [fordulnak el] fennh\'e9j\'e1z\'f3an a Neki val\'f3 szolg\'e1latt\'f3l, \'e9s nem mer\'fclnek ki.
\par 20. Magasztal\'e1st v\'e9geznek \'e9jszaka \'e9s nappal, nem ernyednek el.
\par 
\par 21. Vagy olyanokat tettek isteneikk\'e9 a f\'f6ldr\'f5l, akik felt\'e1masztanak [holtakat]?
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid8065127 {\insrsid5968634 22. Ha e kett\'f5ben (az egekben \'e9s a f\'f6ld\'f6n) lenn\'e9nek istens\'e9gek Allahon k\'edv\'fcl, akkor mindkett\'f5
 elpusztulna. Magasztaltass\'e9k h\'e1t Allah! [\'d5] a Tr\'f3nus Ura, [}{\insrsid8065127\charrsid2638912 \'d5 felette van annak, mint}{\insrsid5968634 ], }{\insrsid8065127\charrsid2638912 ahogy le\'edrj\'e1k [\'d5t].}{\insrsid8065127 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 23. Nem vonj\'e1k \'d5t k\'e9rd\'f5re az\'e9rt, amit tesz, \'e1m \'f5k k\'e9rd\'f5re lesznek vonva.
\par 24. Vagy Helyette [m\'e1sokat] tettek istens\'e9gekk\'e9? Mondd [\'f3 Mohamed]: \'84Adj\'e1tok ide a bizony\'edt\'e9kotokat! Ez [itt] a velem l\'e9v\'f5k eml\'e9keztet\'f5je, \'e9s az el\'f5ttem \'e9ltek eml\'e9keztet\'f5je.\'94 De nem! A legt\'f6bbj\'fc
k nem ismeri az igazs\'e1got, \'edgy \'f5k h\'e1tat ford\'edtanak.
\par 
\par 25. \'c9s nem k\'fcldt\'fcnk el el\'f5tted egy k\'fcld\'f6ttet sem, csup\'e1n \'fagy, hogy azt sugalltuk neki [kinyilatkoztat\'e1sk\'e9nt]: \'84Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, csak \'c9n, h\'e1t Engem szolg\'e1ljatok!\'94
\par 26. \'c9s azt mondj\'e1k: \'84A K\'f6ny\'f6r\'fcletes gyermek\'e9v\'e9 tett [angyalokat].\'94 Magasztaltass\'e9k! Dehogy! [\'d5k csup\'e1n] megbecs\'fclt szolg\'e1k.
\par 27. Nem el\'f5zhetik meg \'d5t a besz\'e9dben, \'e9s a parancsa szerint cselekszenek.
\par 28. Tudja azt, ami el\'f5tt\'fck van [a j\'f6v\'f5t illet\'f5en], \'e9s azt, ami m\'f6g\'f6tt\'fck van [a m\'faltat illet\'f5en], \'e9s nem j\'e1rhatnak k\'f6zben csup\'e1n annak \'e9rdek\'e9ben, akivel \'d5 el\'e9gedett, \'e9s \'f5k a T\'f5le val\'f3 f
\'e9lelemben megr\'e9m\'fclnek.
\par 29. \'c9s aki azt mondja k\'f6z\'fcl\'fck: \'84Bizony, istens\'e9g vagyok Rajta k\'edv\'fcl!\'94, annak a Gyehenn\'e1val fizet\'fcnk meg! Ekk\'e9ppen fizet\'fcnk meg az igazs\'e1gtalanoknak.
\par 
\par 30. H\'e1t vajon nem l\'e1tt\'e1k azok, akik hitetlenn\'e9 v\'e1ltak, hogy az egek \'e9s a f\'f6ld egybef\'fcgg\'f5ek voltak, majd sz\'e9tv\'e1lasztottuk azokat, \'e9s a v\'edzb\'f5l hoztunk l\'e9tre minden \'e9l\'f5 dolgot? H\'e1t vajon nem hisznek?

\par 31. \'c9s a f\'f6ld\'f6n szil\'e1rdan r\'f6gz\'edtetteket (hegyeket) helyezt\'fcnk el, hogy [ne] r\'e1zk\'f3djon veletek, \'e9s azokra h\'e1g\'f3kat tett\'fcnk [sz\'e9les] utakk\'e9nt, h\'e1tha igaz \'fatra lelnek.
\par 32. \'c9s az eget \'f5rz\'f6tt mennyezett\'e9 tett\'fck, \'e1m \'f5k a mi jeleinkre \'fcgyet sem vetnek.
\par 33. \'c9s \'d5 az, aki megteremtette az \'e9jszak\'e1t \'e9s a nappalt, \'e9s a Napot \'e9s a Holdat, valamennyien [\'e9gi] p\'e1ly\'e1n \'fasznak (keringenek).
\par 34. \'c9s nem adtuk meg az \'f6r\'f6kl\'e9tet (halhatatlans\'e1got) egyetlen embernek sem el\'f5tted. [\'cdgy] h\'e1t, ha te [is] meghalsz, akkor \'f5k lenn\'e9nek az \'f6r\'f6kl\'e9t\'fbek?
\par 35. Minden ember meg\'edzleli a hal\'e1lt. \'c9s pr\'f3b\'e1ra tesz\'fcnk titeket a rosszal \'e9s a j\'f3val k\'eds\'e9rt\'e9sk\'e9nt. \'c9s Hozz\'e1nk lesztek visszavitetve.
\par 
\par 36. \'c9s amikor megl\'e1tnak azok, akik hitetlenn\'e9 v\'e1ltak, nem tesznek t\'e9ged m\'e1ss\'e1, mint g\'fany t\'e1rgy\'e1v\'e1 [azt mondv\'e1n]: \'84Ez az, aki [rosszat] eml\'edt isteneitekr\'f5l?\'94 \'c9s \'f5k a K\'f6ny\'f6r\'fcletes eml\'edt\'e9s
\'e9t megtagadj\'e1k.
\par 37. Az ember siet\'f5ss\'e9 teremtetett. Meg fogom nektek mutatni a [b\'fcntet\'e9sr\'f5l sz\'f3l\'f3] jeleimet, \'e1m ne siettess\'e9tek [azokat]!
\par 38. \'c9s azt mondj\'e1k: \'84Mikor [k\'f6vetkezik be] ez az \'edg\'e9ret, ha }{\insrsid5968634\charrsid9927185 val\'f3ban}{\insrsid5968634  igazmond\'f3k vagytok?\'94
\par 39. Ha tudn\'e1k azok, akik hitetlenn\'e9 v\'e1ltak, [hogy mi lesz akkor,] amikor majd nem tudj\'e1k t\'e1vol tartani a [Pokol-]t\'fczet az arcukt\'f3l, sem a h\'e1tukt\'f3l, \'e9s nem lesznek megseg\'edtve [akkor bizony hinn\'e9nek, \'e9s nem siettetn
\'e9k az \'edg\'e9ret bek\'f6vetkez\'e9s\'e9t].
\par 40. }{\insrsid5968634\charrsid21934 Mi t\'f6bb!}{\insrsid5968634  V\'e1ratlanul \'e9ri el \'f5ket [az \'cdt\'e9let napja], megh\'f6kkenti \'f5ket, majd nem tudj\'e1k kiv\'e9deni azt, \'e9s \'f5k nem kapnak halad\'e9kot [sem].
\par 41. \'c9s bizony }{\insrsid5968634\charrsid10422892 g\'fanyt}{\insrsid5968634  \'fbztek m\'e1r k\'fcld\'f6ttekb\'f5l teel\'f5tted is, \'e1m k\'f6rbeker\'edtette azokat, akik g\'fanyol\'f3dtak, az [a b\'fcntet\'e9s], amib\'f5l g\'fanyt \'fbztek.
\par 
\par 42. Mondd [\'f3 Mohamed]: \'84Ki oltalmaz meg titeket a K\'f6ny\'f6r\'fcletes [b\'fcntet\'e9s\'e9t\'f5l] \'e9jszaka \'e9s nappal?\'94 \'d5k azonban az Urukr\'f3l val\'f3 megeml\'e9kez\'e9sre \'fcgyet sem vetnek.
\par 43. Vagy tal\'e1n vannak isteneik, akik v\'e9delmezik \'f5ket, Helyett\'fcnk? Nem tudnak saj\'e1t magukon seg\'edteni, \'e9s Vel\'fcnk szemben sem tal\'e1lnak v\'e9delmez\'f5re!
\par }\pard \qj \li0\ri0\widctlpar\tx720\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 44. Ellenkez\'f5leg! \'c9lvezetekben r\'e9szes\'edtett\'fck \'f5ket \'e9s aty\'e1ikat, m\'edg hossz\'fara nem ny\'falt az \'e9
letkoruk. H\'e1t vajon nem l\'e1tt\'e1k, hogy k\'f6rbevessz\'fck a f\'f6ldet \'e9s sz\'fbk\'edtj\'fck azt a sz\'e9lei fel\'f5l? H\'e1t vajon \'f5k lesznek a gy\'f5zelmet arat\'f3k?
\par 
\par 45. Mondd [\'f3 Mohamed]: \'84\'c9n csup\'e1n a sugallat (a Kor\'e1n) \'e1ltal figyelmeztetlek titeket.\'94 \'c1m nem hallj\'e1k a s\'fcketek a h\'edv\'e1st, amikor figyelmeztet\'e9sben r\'e9szes\'fclnek.
\par 46. \'c9s ha meg\'e9rinten\'e9 \'f5ket egy leheletnyi Urad gy\'f6trelm\'e9b\'f5l, akkor bizony\'e1ra azt mondan\'e1k: \'84Jaj nek\'fcnk! Mi bizony igazs\'e1gtalanok voltunk!\'94
\par 47. \'c9s elhelyezz\'fck az igazs\'e1gos m\'e9rlegeket a Felt\'e1mad\'e1s napj\'e1n, \'e9s nem fog egyetlen ember sem igazs\'e1gtalans\'e1got elszenvedni semmiben. \'c9s ha annak (az emberi cselekedetnek) a s\'falya egy must\'e1
rmagnyi lenne [is], akkor is el\'f5hozzuk. \'c9s elegend\'f5ek vagyunk elsz\'e1moltat\'f3nak.
\par 
\par 48. \'c9s bizony odaadtuk M\'f3zesnek \'e9s \'c1ronnak az [igazs\'e1g \'e9s hamiss\'e1g k\'f6z\'f6tti] Sz\'e9tv\'e1laszt\'f3t (a T\'f3r\'e1t), \'e9s f\'e9nyess\'e9get, \'e9s eml\'e9keztet\'e9st az istenf\'e9l\'f5knek,
\par 49. Akik f\'e9lnek T\'f5le an\'e9lk\'fcl, hogy l\'e1tn\'e1k \'d5t, \'e9s \'f5k az \'d3r\'e1t\'f3l meg vannak r\'e9m\'fclve.
\par 50. \'c9s ez (a Kor\'e1n) egy \'e1ldott eml\'e9keztet\'e9s, amit lebocs\'e1tottunk. H\'e1t vajon ti elutas\'edtj\'e1tok ezt?
\par 
\par 51. \'c9s megadtuk \'c1brah\'e1mnak a helyes \'fatra vezet\'e9s\'e9t kor\'e1bban, \'e9s Mi j\'f3l tudtuk r\'f3la [hogy m\'e9lt\'f3 a pr\'f3f\'e9tas\'e1gra].
\par 52. Amikor azt mondta az apj\'e1nak \'e9s a n\'e9p\'e9nek: \'84Mik ezek a szobrok, amelyeket kitart\'f3an [im\'e1dtok]?\'94
\par 53. Azt mondt\'e1k: \'84Aty\'e1inkat \'fagy tal\'e1ltuk, hogy \'f5ket szolg\'e1lt\'e1k.\'94
\par 54. Azt mondta: \'84Bizony ti \'e9s aty\'e1itok nyilv\'e1nval\'f3 t\'e9velyg\'e9sben vagytok.\'94
\par 55. Azt mondt\'e1k: \'84Az igazs\'e1ggal j\'f6tt\'e9l-e hozz\'e1nk, vagy te csak a j\'e1tszadoz\'f3k k\'f6z\'e9 tartozol?\'94
\par 56. Azt mondta: \'84Dehogy! Uratok az }{\insrsid5968634\charrsid21934 egek \'e9s a}{\insrsid5968634  f\'f6ld Ura, aki l\'e9trehozta mindkett\'f5t, \'e9s \'e9n azok k\'f6z\'e9 tartozom, akik tan\'fak [ezekre].
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 57. \'c9s Allahra [esk\'fcsz\'f6m]! Bizony tervet fogok sz\'f5ni a b\'e1lv\'e1nyaitok ellen, miut\'e1n h\'e1tat ford\'edtottatok t
\'e1vozva.\'94
\par 58. \'c9s azokat apr\'f3 darabokra t\'f6rte, kiv\'e9ve azt, amely sz\'e1mukra nagy (f\'f5 b\'e1lv\'e1ny) volt, h\'e1tha visszat\'e9rnek [hozz\'e1].
\par 59. Azt mondt\'e1k: \'84Ki tette ezt isteneinkkel? Bizony, \'f5 az igazs\'e1gtalanok k\'f6z\'e9 tartozik.\'94
\par 60. Azt mondt\'e1k: \'84Hallottunk egy ifjat, [aki megvet\'f5en] emlegette azokat. \'dagy nevezik \'f5t: \'c1brah\'e1m.\'94
\par 61. Azt mondt\'e1k: \'84Hozz\'e1tok az emberek szeme el\'e9, h\'e1tha azok tan\'faskodni fognak [ellene]!\'94
\par 62. Azt mondt\'e1k: \'84Vajon te tetted ezt isteneinkkel, \'f3 \'c1brah\'e1m?\'94
\par 63. Azt mondta: \'84Dehogy! A nagy (a f\'f5 b\'e1lv\'e1ny) k\'f6z\'fcl\'fck tette ezt. K\'e9rdezz\'e9tek csak meg \'f5ket, ha meg tudnak sz\'f3lalni!\'94
\par 64. Majd visszat\'e9rtek magukhoz [elgondolkodv\'e1n], \'e9s azt mondt\'e1k [egym\'e1snak]: \'84Bizony, ti vagytok az igazs\'e1gtalanok!\'94
\par 65. Majd visszaestek [a hitetlens\'e9g\'fckbe, mondv\'e1n]: \'84Bizony\'e1ra tudtad, [hogy] azok nem tudnak megsz\'f3lalni!\'94
\par 66. Azt mondta [\'c1brah\'e1m]: \'84Vajon Allah helyett [olyasmit] szolg\'e1ltok, amely nem haszn\'e1l nektek semmiben, \'e9s nem [is] \'e1rt nektek?
\par 67. Pfuj r\'e1tok \'e9s azokra, amiket szolg\'e1ltok Allah helyett! Vajon h\'e1t nem \'e9ltek az eszetekkel?\'94
\par 68. Azt mondt\'e1k] \'84\'c9gess\'e9tek el, \'e9s seg\'edts\'e9tek az isteneiteket, ha }{\insrsid5968634\charrsid2501205 val\'f3ban}{\insrsid5968634  }{\insrsid5968634\charrsid21934 tenni akartok [valamit]!\'94}{\insrsid5968634 
\par 
\par 69. Azt mondtuk: \'84\'d3 t\'fbz! Legy\'e9l h\'fbv\'f6ss\'e9 \'e9s b\'e9kess\'e9gg\'e9 \'c1brah\'e1mnak!\'94
\par 70. \'c9s fondorlatot akartak sz\'f5ni [ellene], \'e1m Mi a legink\'e1bb vesztesekk\'e9 tett\'fck \'f5ket!
\par 71. \'c9s elmenek\'edtett\'fck \'f5t \'e9s L\'f3tot a f\'f6ldre, amelyet meg\'e1ldottunk a teremtm\'e9nyeknek.
\par 72. \'c9s megaj\'e1nd\'e9koztuk \'f5t Izs\'e1kkal \'e9s J\'e1kobbal r\'e1ad\'e1sk\'e9nt \'e9s mindkettej\'fcket j\'f3 emberr\'e9 tett\'fck.
\par 73. \'c9s vezet\'f5kk\'e9 tett\'fck \'f5ket, [akik] parancsunk szerint [igaz \'fatra] vezetnek, \'e9s sugalltuk nekik a j\'f3tettek megt\'e9tel\'e9t, \'e9s az im\'e1dkoz\'e1s megtart\'e1s\'e1t \'e9s a k\'f6telez\'f5 adom\'e1ny megad\'e1s\'e1t. \'c9s \'f5
k [val\'f3ban] Minket szolg\'e1ltak.
\par 
\par 74. \'c9s L\'f3tnak b\'f6lcsess\'e9get \'e9s tud\'e1st adtunk, \'e9s elmenek\'edtett\'fck \'f5t a telep\'fcl\'e9sb\'f5l, amely [lak\'f3i] rossz tetteket k\'f6vettek el. Bizony, \'f5k rossz n\'e9p voltak [\'e9s] engedetlenek.
\par 75. \'c9s bebocs\'e1tottuk \'f5t a k\'f6ny\'f6r\'fclet\'fcnkbe. Bizony, \'f5 a j\'f3 emberek k\'f6z\'fcl val\'f3.
\par 
\par 76. \'c9s [eml\'edtsd meg, \'f3 Mohamed] No\'e9t, amikor [Minket] sz\'f3l\'edtott kor\'e1bban, \'e9s Mi meghallgattuk \'f5t, \'e9s megmentett\'fck \'f5t \'e9s a csal\'e1dj\'e1t a hatalmas szorongattat\'e1st\'f3l!
\par 77. \'c9s megseg\'edtett\'fck \'f5t a n\'e9ppel szemben, akik meghazudtolt\'e1k a jeleinket. Bizony, \'f5k rossz n\'e9p voltak, \'e9s v\'edzbe fullasztottuk \'f5ket, mindny\'e1jukat.
\par 
\par 78. \'c9s [eml\'edtsd meg] D\'e1vidot \'e9s Salamont, amikor \'edt\'e9lkeztek a vet\'e9s [\'fcgy\'e9ben] akkor, amikor a n\'e9p juhai oda k\'f3boroltak legelni \'e9jszaka [t\'f6nkret\'e9ve azt]! \'c9s Mi tan\'fak voltunk az \'edt\'e9lkez\'e9s\'fckre.

\par 79. \'c9s megadtuk [azon eset] meg\'e9rt\'e9s\'e9t Salamonnak. \'c9s mindegyiknek b\'f6lcsess\'e9get \'e9s tud\'e1st adtunk. \'c9s szolg\'e1latra rendelt\'fck a hegyeket \'e9s a madarakat, hogy D\'e1viddal egy\'fctt magasztaljanak [Minket]. \'c9s Mi ekk
\'e9ppen cselekedt\'fcnk.
\par 80. \'c9s megtan\'edtottuk \'f5t [p\'e1nc\'e9l-]ruh\'e1zat k\'e9sz\'edt\'e9s\'e9re sz\'e1motokra, hogy megv\'e9djen titeket harci csap\'e1sotok idej\'e9n. Vajon h\'e1t h\'e1l\'e1sak vagytok?
\par 81. \'c9s Salamonnak [a szolg\'e1lat\'e1ra rendelt\'fck] a viharos szelet, [amely] az \'f5 parancsa szerint sz\'e1guld a f\'f6ldre, amelyet meg\'e1ldottunk. \'c9s Nek\'fcnk minden dologr\'f3l tudom\'e1sunk volt.
\par 82. \'c9s a s\'e1t\'e1nok k\'f6z\'fcl is [Salamon szolg\'e1lat\'e1ra rendelt\'fcnk] olyanokat, akik lemer\'fclnek neki [a tengerbe], \'e9s ezenk\'edv\'fcl m\'e1s cselekedetet is v\'e9geznek. \'c9s Mi voltunk az \'f5rz\'f5ik [att\'f3
l, hogy engedetlenek legyenek].
\par 
\par 83. \'c9s [eml\'edtsd meg] J\'f3bot, amikor az Ur\'e1t sz\'f3l\'edtotta: \'84Bizony \'e1rtalom (csap\'e1s) \'e9rt engem, \'e9s Te vagy a Legk\'f6ny\'f6r\'fcletesebb a k\'f6ny\'f6r\'fcletesek k\'f6z\'f6tt!\'94
\par 84. S meghallgattuk \'f5t, s elh\'e1r\'edtottuk r\'f3la az \'f5t \'e9rt \'e1rtalmat, \'e9s megadtuk neki a csal\'e1dj\'e1t, \'e9s vel\'fck egy\'fctt m\'e9g egyszer annyit, T\'f5l\'fcnk sz\'e1rmaz\'f3 k\'f6ny\'f6r\'fcletk\'e9nt, \'e9s eml\'e9keztet\'f5k
\'e9nt az istenszolg\'e1l\'f3knak.
\par 85. \'c9s [eml\'edtsd meg, \'f3 Mohamed] Izm\'e1elt, Idr\'edszt \'e9s Dhul-Kifl-t, mindegyik a t\'fcrelmesek k\'f6z\'fcl val\'f3!
\par 86. \'c9s bebocs\'e1tottuk \'f5ket a k\'f6ny\'f6r\'fclet\'fcnkbe. Bizony, \'f5k a j\'f3 emberek k\'f6z\'fcl val\'f3k.
\par 
\par 87. \'c9s [eml\'edtsd meg, \'f3 Mohamed] Dhun-N\'fan-t (J\'f3n\'e1st), amikor haragosan elment [a n\'e9p\'e9t\'f5l], \'e9s azt gondolta, hogy nem tessz\'fck sz\'fbk\'f6ss\'e9 a helyzet\'e9t, [\'e1m lenyelte \'f5t a hal] azt\'e1n a [k\'fcl\'f6nb\'f6z\'f5]
 s\'f6t\'e9ts\'e9gekben [Ur\'e1t] sz\'f3l\'edtotta: \'84Nincs m\'e1s isten Rajtad k\'edv\'fcl! Magasztaltass\'e1l! Bizony, az igazs\'e1gtalanok k\'f6z\'e9 tartoztam!\'94
\par 88. \'c9s meghallgattuk \'f5t, \'e9s megmentett\'fck \'f5t a b\'e1natt\'f3l, \'e9s ekk\'e9ppen mentj\'fck meg a h\'edv\'f5ket.
\par 
\par 89. \'c9s [}{\insrsid5968634\charrsid8734971 eml\'edtsd meg, \'f3 Mohamed] Zakari\'e1st, amikor Ur\'e1t sz\'f3l\'edtotta: \'84Uram! Ne hagyj engem egyed\'fcl, hiszen Te vagy a legjobb az \'f6r\'f6kl\'f5k k\'f6z\'f6tt!\'94}{\insrsid5968634 
\par 90. S meghallgattuk \'f5t, \'e9s megaj\'e1nd\'e9koztuk \'f5t J\'e1nossal, \'e9s meggy\'f3gy\'edtottuk (term\'e9kenny\'e9 tett\'fck) neki a feles\'e9g\'e9t. Bizony, \'f5k }{\insrsid5968634\charrsid2501205 sietve}{\f0\insrsid5968634\charrsid2501205  }{
\insrsid5968634\charrsid2501205 igyekeztek a j\'f3tettekben}{\insrsid5968634 , \'e9s Hozz\'e1nk foh\'e1szkodtak v\'e1gyakozva \'e9s f\'e9lve, \'e9s ir\'e1ntunk \'e1h\'edtatosak voltak.
\par 
\par 91. \'c9s [eml\'edtsd meg M\'e1ri\'e1t] aki meg\'f5rizte a szem\'e9rm\'e9t [a par\'e1znas\'e1gt\'f3l]! S Mi belef\'fajtunk a Mi [\'e1ltalunk teremtett] l\'e9lekb\'f5l. \'c9s \'f5t \'e9s a fi\'e1t jell\'e9 tett\'fck a teremtm\'e9nyek sz\'e1m\'e1ra.
\par 
\par 92. Bizony, ezen vall\'e1si k\'f6z\'f6ss\'e9getek egy k\'f6z\'f6ss\'e9g (a felsorolt pr\'f3f\'e9t\'e1k mind az egyistenhitet hirdett\'e9k), \'e9s \'c9n vagyok az Uratok, h\'e1t Engem szolg\'e1ljatok!
\par 93. \'c1m [csoportokra] szakadoztak [az emberek] egym\'e1s k\'f6z\'f6tt a [vall\'e1si] \'fcgy\'fcket illet\'f5en. Mindny\'e1jan Hozz\'e1nk t\'e9rnek vissza!
\par 94. S az, aki j\'f3tetteket cselekszik, mik\'f6zben h\'edv\'f5, annak igyekezete ir\'e1nt nincs megtagad\'e1s. \'c9s bizony Mi feljegyezz\'fck azt sz\'e1m\'e1ra!
\par 95. \'c9s tilalmas (kiz\'e1rt) egy telep\'fcl\'e9s sz\'e1m\'e1ra, melyet elpuszt\'edtottunk az, hogy ne t\'e9rjenek vissza [Hozz\'e1nk az \'cdt\'e9let napon elsz\'e1moltat\'e1sra].
\par 
\par 96. Azt\'e1n, amikor megnyittatik G\'f3g \'e9s Mag\'f3g [g\'e1tja], \'e9s \'f5k minden magaslatr\'f3l sietve j\'f6nnek le [hogy puszt\'edt\'e1st v\'e9gezzenek],
\par 97. \'c9s k\'f6zeleg az igaz \'edg\'e9ret (a Felt\'e1mad\'e1s Napja), \'e9s \'edme kimered azoknak a tekintete, akik hitetlenn\'e9 v\'e1ltak. [Azt mondj\'e1k] \'84\'d3, jaj nek\'fcnk! Bizony efel\'f5l figyelmetlens\'e9g [\'e1llapot\'e1
ban] voltunk! De, mi [val\'f3ban] igazs\'e1gtalanok voltunk!\'94
\par 98. Bizony, ti \'e9s mindaz, amit Allah helyett szolg\'e1ltok t\'fbzreval\'f3 a Gyehenn\'e1nak. Ti oda fogtok jutni.
\par 99. Ha ezek istenek voln\'e1nak, akkor nem jutn\'e1nak oda. \'c9s mindannyian \'f6r\'f6kk\'e9 abban [a Gyehenn\'e1ban] fognak maradni.
\par 100. [Sz\'f6rny\'fb hangon] fognak ott s\'f3hajtani, \'e9s nem fognak abban hallani!
\par 
\par 101. Bizony, akik sz\'e1m\'e1ra m\'e1r el\'f5z\'f5leg [elrendeltetett] T\'f5l\'fcnk a legjobb [jutalom], azok el lesznek t\'e1vol\'edtva onnan (a Gyehenn\'e1t\'f3l).
\par 102. Nem fogj\'e1k hallani [a Paradicsomban] a [Pokol-t\'fbz] sisterg\'e9s\'e9t, \'e9s \'f5k \'f6r\'f6kk\'e9 abban maradnak, amit \'f5k maguk k\'edv\'e1nnak.
\par 103. Nem szomor\'edtja el \'f5ket a legnagyobb ijedts\'e9g (a Felt\'e1mad\'e1s napja), \'e9s az angyalok [ekk\'e9ppen] fogadj\'e1k \'f5ket: \'84Ez a ti napotok, amelyre \'edg\'e9retet kaptatok!\'94
\par 
\par 104. Azon a napon \'fagy hajtjuk \'f6ssze az eget, ahogyan az \'edrott tekercsek lapjait hajtj\'e1k \'f6ssze. Ahogyan kezdetben v\'e9ghez vitt\'fck a teremt\'e9st, megism\'e9telj\'fck azt. \'cdg\'e9ret ez [amely] Minket k\'f6telez. Bizony, Mi megtessz\'fc
k [ezt].
\par 105. \'c9s bizony meg\'edrtuk a Zsolt\'e1rokban az eml\'e9keztet\'e9st k\'f6vet\'f5en, hogy a j\'f3 szolg\'e1im fogj\'e1k \'f6r\'f6k\'f6lni a f\'f6ldet.
\par 106. Bizony ebben [a Kor\'e1nban] \'fczenet van azon n\'e9p sz\'e1m\'e1ra, akik [Allahot] szolg\'e1lj\'e1k.
\par 
\par 107. \'c9s nem k\'fcldt\'fcnk el t\'e9ged [\'f3 Mohamed], csakis k\'f6ny\'f6r\'fcletk\'e9nt a teremtm\'e9nyek sz\'e1m\'e1ra.
\par 108. Mondd: \'84Csup\'e1n az sugalltatik nekem [kinyilatkoztat\'e1sk\'e9nt], hogy a ti istenetek csak egy Isten. Vajon h\'e1t al\'e1vetitek magatokat [Neki]?\'94
\par 109. S ha h\'e1tat ford\'edtanak, mondd: \'84\'c9n egyform\'e1n tudattam veletek [ami sugalltatott nekem]! \'c9s nem tudom, k\'f6zel, avagy t\'e1vol van-e az, amire \'edg\'e9retet kaptatok.
\par 110. Bizony, \'d5 tudja a nyilv\'e1nos besz\'e9det, \'e9s tudja azt, amit eltitkoltok.
\par 111. \'c9s nem tudom, tal\'e1n az egy k\'eds\'e9rt\'e9s sz\'e1motokra, \'e9s \'e9lvezet egy [meghat\'e1rozott] ideig.\'94
\par 112. Azt mondta [a K\'fcld\'f6tt]: \'84Uram! \'cdt\'e9lj igazs\'e1ggal! Urunk a K\'f6ny\'f6r\'fcletes, \'d5 a seg\'edts\'e9g\'fcl k\'e9rt [t\'e1maszom] az ellen, amit [hazugs\'e1gk\'e9nt] le\'edrtok.\'94
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid5968634 \page }{
\f0\fs24\insrsid5968634\charrsid5968634 22. sz\'fara - A zar\'e1ndoklat (al-Haddzs) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. \'d3 ti, emberek! F\'e9lj\'e9tek Uratokat! Bizony, a [V\'e9gs\'f5] \'d3ra idej\'e9n [bek\'f6vetkez\'f5] f\'f6ldreng\'e9s hatalmas dolog!
\par 2. Azon a napon l\'e1tni fogj\'e1tok, hogy minden szoptat\'f3 anya megfeledkezik arr\'f3l, akit [\'e9ppen] szoptatott, \'e9s a terhes n\'f5k elejtik terh\'fcket, \'e9s az embereket r\'e9szegeknek l\'e1tod majd, holott \'f5k nem is r\'e9szegek; de Allah gy
\'f6trelme s\'falyos.
\par 
\par 3. \'c9s van az emberek k\'f6z\'fcl olyan, aki vit\'e1ba sz\'e1ll Allahr\'f3l tud\'e1s n\'e9lk\'fcl, \'e9s k\'f6vet minden l\'e1zad\'f3 s\'e1t\'e1nt.
\par 4. El\'f5\'edratott neki, hogy aki p\'e1rtfog\'f3j\'e1nak teszi meg [a s\'e1t\'e1nt], h\'e1t azt \'f5 t\'e9velyg\'e9sbe viszi, \'e9s a L\'e1ngol\'f3 [Pokol-t\'fbz] gy\'f6trelm\'e9hez vezeti.
\par 
\par 5. \'d3 ti, emberek! Ha k\'e9ts\'e9gben vagytok a Felt\'e1mad\'e1s fel\'f5l, h\'e1t bizony Mi megteremtett\'fcnk titeket porb\'f3l, majd [megterm\'e9keny\'fclt] cseppb\'f5l, majd v\'e9rr\'f6gb\'f5l, majd egy megform\'e1lt vagy form\'e1tlan h\'fasdarabb
\'f3l, hogy vil\'e1goss\'e1 tegy\'fck el\'f5ttetek [a hatalmunkat]. \'c9s nyugv\'f3helyet adunk az anyam\'e9hben egy megszabott hat\'e1rid\'f5ig, annak, amit akarunk. Majd el\'f5hozunk titeket gyermekk\'e9nt, majd [gondoskodunk r\'f3latok,] hogy el\'e9
rhess\'e9tek az \'e9rett korotokat. \'c1m van k\'f6z\'f6ttetek olyan, aki [fiatalon] elsz\'f3l\'edttatik [Allahhoz] \'e9s van, aki a legal\'e1val\'f3bb \'e9letkorba juttatik, hogy miut\'e1n tudott, ne tudjon semmit. \'c9s l\'e1tod, hogy a f\'f6ld siv\'e1
r, \'e1m amikor lebocs\'e1tjuk r\'e1 a vizet, megrezzen \'e9s megduzzad \'e9s mindenfajta pomp\'e1s [n\'f6v\'e9nyt] sarjaszt.
\par 6. Ez az\'e9rt van, mert Allah az Igazs\'e1g, \'e9s \'d5 \'e9letre kelti a halottakat, \'e9s bizony, \'d5 minden dologra kiterjed\'f5 hatalm\'fa.
\par 7. \'c9s bizony, az \'d3ra el fog j\'f6nni, ehhez nem f\'e9r k\'e9ts\'e9g, \'e9s bizony Allah felt\'e1masztja azokat, akik a s\'edrokban vannak.
\par 
\par 8. \'c9s van az emberek k\'f6z\'f6tt olyan, aki vit\'e1ba sz\'e1ll Allahr\'f3l tud\'e1s, \'fatmutat\'e1s \'e9s vil\'e1goss\'e1got ad\'f3 \'cdr\'e1s n\'e9lk\'fcl.
\par 9. [Bek\'e9pzelten] elford\'edtja a nyak\'e1t, hogy t\'e9velyg\'e9sbe vigyen [m\'e1sokat] Allah \'datj\'e1r\'f3l. Neki az evil\'e1gon megsz\'e9gyen\'edt\'e9s j\'e1r, \'e9s a Felt\'e1mad\'e1s napj\'e1n meg\'edzleltetj\'fck vele az \'c9get\'f5 [Pokol-t\'fb
z] gy\'f6trelm\'e9t.
\par 10 Ez [a fizets\'e9ged] az\'e9rt, amit a kezed k\'f6vetett el, \'e9s Allah bizony nem igazs\'e1gtalan a szolg\'e1kkal (teremtm\'e9nyekkel).
\par 11. Van az emberek k\'f6z\'f6tt olyan, aki Allahot [a hit] sz\'e9l\'e9n \'e1llva szolg\'e1lja: ha valami j\'f3 \'e9ri, abban megnyugszik, ha azonban k\'eds\'e9rt\'e9s \'e9ri \'f5t, arc\'e1ra fordul (visszat\'e9r a hitetlens\'e9gbe). Elvesztette az evil
\'e1got \'e9s a T\'falvil\'e1got. Ez a nyilv\'e1nval\'f3 vesztes\'e9g.
\par 12. Allah helyett olyanhoz foh\'e1szkodik, ami nem \'e1rt neki \'e9s nem haszn\'e1l neki. Ez a messzemen\'f5 t\'e9velyg\'e9s.
\par 13. Olyanhoz foh\'e1szkodik, aminek az \'e1rtalma k\'f6zelebb van, mint a haszna. Milyen rossz p\'e1rtfog\'f3 \'e9s milyen rossz t\'e1rs!
\par 
\par 14. Bizony, akik hisznek \'e9s j\'f3tetteket cselekszenek, azokat Allah olyan kertekbe l\'e9pteti be [a Paradicsomban], amelyek al\'f3l foly\'f3k folynak. Bizony Allah azt tesz, amit akar.
\par 15. Aki azt gondolja, hogy Allah nem fogja megseg\'edteni \'f5t (Mohamedet) az evil\'e1gon \'e9s a t\'falvil\'e1gon, az f\'fcggesszen fel egy k\'f6telet az \'e9gig, [m\'e1sszon fel rajta], majd v\'e1gja el [a seg\'edts\'e9g \'fatj\'e1t], \'e9s n\'e9
zze meg, vajon a fondorlata elt\'e1vol\'edtja-e azt, ami feld\'fch\'edti!
\par 
\par 16. \'c9s ekk\'e9ppen bocs\'e1tottuk le [a Kor\'e1nt] vil\'e1gos jelekk\'e9nt, \'e9s bizony Allah azt vezet [az igaz \'fatra], akit akar.
\par 17. Bizony, akik hisznek [Allah egyedval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben], \'e9s akik zsid\'f3k, \'e9s a sz\'e1beit\'e1k, \'e9s a kereszt\'e9nyek, \'e9s a m\'e1gushit\'fbek, \'e9s akik t\'e1rsistent \'e1ll\'ed
tottak [Allah mell\'e9}{\insrsid5968634\charrsid8734971 ] \endash  azok k\'f6z\'f6tt bizony}{\insrsid5968634  Allah \'edt\'e9lkezni fog a Felt\'e1mad\'e1s Napj\'e1n. Bizony, Allah minden dolog felett tan\'fa.
\par 18. Vajon nem gondolkodt\'e1l el azon, hogy Allah el\'f5tt borul le mindenki, aki az egekben \'e9s aki a f\'f6ld\'f6n van, \'e9s a Nap, \'e9s a Hold, \'e9s a csillagok, \'e9s a hegyek, \'e9s a f\'e1k, \'e9s a mozg\'f3 [\'e9l\'f5l\'e9nyek], \'e9
s az emberek k\'f6z\'fcl sokan? \'c9s sokakkal szemben jogoss\'e1 v\'e1lt a gy\'f6trelem. \'c9s akit Allah megal\'e1z, annak nincs olyan, aki m\'e9lt\'f3s\'e1got ad. Bizony, Allah azt tesz, amit akar.
\par 
\par 19. Ezek [itt] ketten k\'e9t civakod\'f3, [akik] Urukkal kapcsolatban civakodtak. S akik hitetlenn\'e9 v\'e1ltak, azoknak a [Pokol-]t\'fbzb\'f5l lesz kiv\'e1gva a ruh\'e1ja, a fej\'fckre forr\'e1sban l\'e9v\'f5 vizet \'f6ntenek. 
\par 20. Megolvasztatik \'e1ltala az, ami a hasukban van, \'e9s a b\'f5r\'fck [is].
\par 21. \'c9s kamp\'f3s vasrudak lesznek sz\'e1mukra [b\'fcntet\'e9s\'fcl].
\par 22. Valah\'e1nyszor ki szeretn\'e9nek abb\'f3l j\'f6nni a b\'e1nat miatt, visszavitetnek oda. [Az lesz nekik mondva:] \'84\'cdzlelj\'e9tek meg az \'c9get\'f5 [Pokol-t\'fbz] gy\'f6trelm\'e9t!\'94 
\par 
\par 23. Bizony}{\insrsid5968634\charrsid8734971 , akik hisznek \'e9s j\'f3tetteket cselekszenek, azokat Allah olyan kertekbe l\'e9pteti be [a Paradicsomban], amelyek al\'f3l}{\insrsid5968634  foly\'f3k folynak; amelyekben aranyb\'f3l k\'e9sz\'fc
lt karperecekkel \'e9s gy\'f6ngy\'f6kkel \'e9kes\'edttetnek. \'c9s az \'f6lt\'f6z\'e9k\'fck ott selyem lesz.
\par 24. \'c9s a j\'f3 besz\'e9dhez lettek }{\insrsid5968634\charrsid8734971 vezetve; \'e9s a Dics\'e9retrem\'e9lt\'f3 [Allah] \'fatj\'e1ra}{\insrsid5968634  lettek vezetve.
\par 
\par 25. Bizony, akik hitetlenn\'e9 v\'e1ltak \'e9s t\'e1voltartanak [m\'e1sokat] Allah \'fatj\'e1t\'f3l \'e9s a Szent Mecsett\'f5l, amit kijel\'f6lt\'fcnk az embereknek, az ott [hosszasan] tart\'f3zkod\'f3knak \'e9s a beduinok egyar\'e1nt, \'e9s aki igazs\'e1
gtalan m\'f3don akar ott gyal\'e1zatos tettet elk\'f6vetni, azzal f\'e1jdalmas gy\'f6trelmet fogunk meg\'edzleltetni.
\par 26. \'c9s [eml\'edtsd meg] amikor kijel\'f6lt\'fck \'c1brah\'e1mnak a H\'e1z (a K\'e1ba) hely\'e9t, [azt mondv\'e1n:] \'84Ne \'e1ll\'edts semmit t\'e1rsistenk\'e9nt Mell\'e9m, \'e9s tiszt\'edtsd meg a H\'e1zamat a k\'f6rbej\'e1r\'e1st elv\'e9gz\'f5knek, 
\'e9s az [im\'e1dkozva] \'e1ll\'f3knak, \'e9s a meghajol\'f3knak \'e9s a leborul\'f3knak!
\par 27. \'c9s hirdesd ki az emberek k\'f6z\'f6tt a zar\'e1ndoklatot! Gyalogosan j\'f6nnek majd hozz\'e1d, \'e9s mindenf\'e9le zsugorodott [p\'fap\'fa tev\'e9n], amelyek minden m\'e9lyen fekv\'f5 h\'e1g\'f3k fel\'f5l j\'f6nnek,
\par 28. hogy tan\'fai legyenek sz\'e1mukra hasznos dolgoknak, \'e9s hogy megeml\'edts\'e9k Allah nev\'e9t meghat\'e1rozott [sz\'e1m\'fa] napokon azon n\'e9gyl\'e1b\'fa j\'f3sz\'e1gok [lev\'e1g\'e1sakor,] amelyekkel ell\'e1ttuk \'f5ket. Egyetek h\'e1
t ti is bel\'f5l\'fck, \'e9s \'e9lelmezz\'e9tek a nyomorg\'f3 nincstelent!
\par 29. Majd vessenek v\'e9get a [zar\'e1ndoklat alatti] elhanyagolts\'e1guknak, \'e9s teljes\'edts\'e9k fogadalmaikat, \'e9s v\'e9gezz\'e9k el a k\'f6rbej\'e1r\'e1st az \'d5si H\'e1z k\'f6r\'fcl!\'94
\par 
\par }{\insrsid5968634\charrsid3354093 30. Ez [Allah el\'f5\'edr\'e1sa], \'e9s aki nagy becsben tartja Allah tilalmait, annak az jobb az \'f5 Ura el\'f5tt [a jutalm\'e1t illet\'f5en]. \'c9s meg lettek engedve sz\'e1motokra a j\'f3sz\'e1gok, kiv\'e9ve azok}{
\insrsid5968634 , amelyek recit\'e1ltatnak nektek. Ker\'fclj\'e9tek h\'e1t el a b\'e1lv\'e1nyok f\'f6rtelmess\'e9g\'e9t, \'e9s ker\'fclj\'e9tek el a hamis besz\'e9det,
\par 31. Allah ir\'e1nt [odaad\'f3] han\'edfokk\'e9nt (egyistenh\'edv\'f5kk\'e9nt, a hamis vall\'e1sokt\'f3l elhajl\'f3kk\'e9nt), t\'e1rsistent \'d5mell\'e9 nem \'e1ll\'edt\'f3kk\'e9nt! \'c9s aki t\'e1rsistent \'e1ll\'edt Allah mell\'e9
, az olyan mintha lezuhant volna az \'e9gb\'f5l \'e9s elragadt\'e1k volna a madarak, vagy a sz\'e9l f\'fajta volna el egy megk\'f6zel\'edthetetlen helyre.
\par 32. Ez [Allah el\'f5\'edr\'e1sa]. \'c9s aki nagy becsben tartja az Allah \'e1ltal kijel\'f6lt szertart\'e1sokat, h\'e1t az [a cselekedet] bizony a sz\'edvek istenf\'e9lelm\'e9b\'f5l val\'f3.
\par 33. Nektek azokb\'f3l (az \'e1ldozatra kijel\'f6lt \'e1llatokb\'f3l) egy megszabott hat\'e1rid\'f5ig hasznotok sz\'e1rmazik, majd a fel\'e1ldoz\'e1si hely\'fck az \'d5si H\'e1zn\'e1l van.
\par 34. \'c9s minden egyes k\'f6z\'f6ss\'e9gnek kijel\'f6lt\'fck a maga \'e1ldoz\'e1si r\'edtus\'e1t, hogy megeml\'edts\'e9k Allah nev\'e9t azon n\'e9gyl\'e1b\'fa j\'f3sz\'e1gok [fel\'e1ldoz\'e1sakor], amivel ell\'e1ttuk \'f5ket. A ti Istenet
ek pedig egyetlen Isten, Neki vess\'e9tek h\'e1t al\'e1 magatokat! \'c9s adj [\'f3 Mohamed] \'f6r\'f6mh\'edrt azoknak, akik al\'e1zattal fordulnak [Allahhoz],
\par 35. Akik, ha eml\'edttetik Allah neve, akkor f\'e9lelemmel telik el a sz\'edv\'fck, \'e9s akik t\'fcrelmet tan\'fas\'edtanak az ir\'e1nt, ami \'e9ri \'f5ket, \'e9s akik }{\insrsid5968634\charrsid14698843 megtartj\'e1k az im\'e1dkoz\'e1st}{\insrsid5968634 
, \'e9s akik adakoznak abb\'f3l, amivel ell\'e1ttuk \'f5ket!
\par 36. \'c9s a testes [\'e1ldozati] tev\'e9ket az Allah \'e1ltal kijel\'f6lt szertart\'e1sok k\'f6z\'e9 tett\'fck nektek. J\'f3 sz\'e1rmazik bel\'f5l\'fck sz\'e1motokra. Eml\'edts\'e9tek h\'e1t meg Allah nev\'e9t felett\'fck, amikor felsorakoztatj\'e1k \'f5
ket [fel\'e1ldoz\'e1sukkor]! Mikor pedig [holtan] esnek le az oldalukra, egyetek bel\'f5l\'fck (a h\'fasukb\'f3l), \'e9s \'e9lelmezz\'e9tek azt [a szeg\'e9nyt], aki kez\'e9t k\'e9r\'e9sre emeli, \'e9s azt is, aki nem k\'e9reget! Ekk\'e9ppen rendelt\'fc
k azokat a szolg\'e1latotokra, h\'e1tha h\'e1l\'e1sak lesztek.
\par 37. Sem a h\'fasuk, sem a v\'e9r\'fck nem jut el Allahhoz, de a t\'f5letek sz\'e1rmaz\'f3 istenf\'e9lelem eljut \'d5hozz\'e1. Ekk\'e9ppen rendelt\'fck azokat a szolg\'e1latotokra, hogy Allahot magasztalj\'e1tok az\'e9rt, hogy az Igaz \'da
tra vezetett titeket. \'c9s adj \'f6r\'f6mh\'edrt a }{\insrsid5968634\charrsid6439036 j\'f3tev\'f5k}{\insrsid5968634 nek!
\par 
\par 38. Bizony, Allah megv\'e9delmezi azokat, akik hisznek. Bizony, Allah nem szeret egyetlen megr\'f6gz\'f6tt \'e1rul\'f3t, b\'fbn\'f6st [sem].
\par 39. Enged\'e9lyt kaptak [a harcra] azok, akik ellen harcolnak, mivel \'f5k igazs\'e1gtalans\'e1got szenvedtek el, \'e9s bizony, Allahnak hatalm\'e1ban \'e1ll az \'f5 megseg\'edt\'e9s\'fck.
\par 40. [\'d5k azok,] akiket jogtalanul \'fbztek el a lakhely\'fckr\'f5l, csup\'e1n az\'e9rt, mert azt mondj\'e1k: \'84A mi Urunk Allah!\'94 \'c9s ha Allah nem tartotta volna vissza az embereket \endash  egyeseket m\'e1sok \'e1ltal \endash 
 akkor bizony leromboltattak volna szerzetescell\'e1k, templomok, zsinag\'f3g\'e1k \'e9s mecsetek, ahol sokszor eml\'edttetik meg Allah neve. Bizony, Allah megseg\'edti azokat, akik seg\'edtik az \'d5 [\'fcgy\'e9t]. Bizony, Allah Er\'f5s, M\'e9lt\'f3s\'e1
gteljes.
\par 41. [Megseg\'edti azokat,] }{\insrsid5968634\charrsid6439036 akiknek ha hatalmat adunk a f\'f6ld\'f6n}{\insrsid5968634 , megtartj\'e1k az im\'e1dkoz\'e1st, megadj\'e1k }{\insrsid5968634\charrsid6439036 a k\'f6telez\'f5 adom\'e1nyt,}{\insrsid5968634  felsz
\'f3l\'edtanak a hely\'e9nval\'f3ra, \'e9s \'f3va intenek az elvetend\'f5t\'f5l. \'c9s Allahot illeti az \'fcgyek feletti v\'e9gs\'f5 [d\'f6nt\'e9s].
\par 
\par 42. \'c9s ha meghazudtolnak [t\'e9ged, \'f3 Mohamed], nos, meghazudtol\'e1st k\'f6vettek el el\'f5tt\'fck No\'e9 n\'e9pe, \'e9s \'c1d \'e9s Tham\'fad,
\par 43. \'c9s \'c1brah\'e1m n\'e9pe, \'e9s L\'f3t n\'e9pe,
\par 44. \'c9s Midi\'e1n lak\'f3i [is meghazudtol\'e1st k\'f6vettek el], \'e9s meg lett hazudtolva M\'f3zes, s halad\'e9kot adtam a hitetleneknek, majd elragadtam \'f5ket. Milyen volt h\'e1t az \'e9n rosszall\'e1som?
\par 45. H\'e1ny telep\'fcl\'e9st puszt\'edtottunk el, mik\'f6zben [a lak\'f3i] igazs\'e1gtalans\'e1got k\'f6vettek el, \'edgy az kihaltt\'e1 lett, romokban heverve! \'c9s [h\'e1ny] elhagyatott k\'fat [maradt ut\'e1nuk] \'e9s [h\'e1ny] f\'e9ny\'fbz\'f5
 palota [\'e1ll romokban]!
\par 46. Vajon h\'e1t nem j\'e1rt\'e1k be a f\'f6ldet, \'e9s lenne [ez\'e1ltal] sz\'edv\'fck, amivel \'e9rtenek, \'e9s f\'fcl\'fck, amivel hallhatnak? Mert bizony nem a szemek vakulnak meg, hanem a sz\'edvek, amelyek a keblekben vannak.
\par 
\par 47. \'c9s siettetnek t\'e9ged a gy\'f6trelemmel [hogy hozd el\'f5bbre azt], \'e1m Allah nem fogja megszegni az \'edg\'e9ret\'e9t. \'c9s bizony egyetlen nap az Uradn\'e1l annyi, mint ezer esztend\'f5 abb\'f3l, amit ti sz\'e1moltok.
\par 48. \'c9s h\'e1ny telep\'fcl\'e9snek adtam m\'e1r halad\'e9kot, mik\'f6zben azok [lak\'f3i] igazs\'e1gtalanok voltak, majd [b\'fcntet\'e9ssel] ragadtam meg \'f5ket \'e9s N\'e1lam lesz a v\'e9gc\'e9l!
\par 
\par 49. Mondd [\'f3 Mohamed]: \'84\'d3 emberek! \'c9n csup\'e1n nyilv\'e1nval\'f3 figyelmeztet\'f5 vagyok sz\'e1motokra.\'94
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 50. \'c9s akik hisznek \'e9s j\'f3
tetteket cselekszenek, azoknak megbocs\'e1t\'e1s \'e9s nemes ell\'e1t\'e1s j\'e1r.
\par 51. \'c1m akik azon igyekeznek, hogy meghi\'fas\'edts\'e1k a jeleinket, azok a Pokol lak\'f3i lesznek.
\par 
\par 52. \'c9s nem k\'fcldt\'fcnk egyetlen k\'fcld\'f6ttet vagy pr\'f3f\'e9t\'e1t sem an\'e9lk\'fcl, hogy ha recit\'e1lta [Allah kinyilatkoztat\'e1s\'e1t], akkor ne vetett volna a recit\'e1l\'e1s\'e1nak [jelent\'e9s\'e9be] a s\'e1t\'e1n [k\'e9telyeket \'e9
s hazugs\'e1gokat], \'e1m Allah elt\'f6rli azt, amit a s\'e1t\'e1n vet oda, majd Allah egy\'e9rtelm\'fben r\'f6gz\'edti a jeleit. Allah a Mindentud\'f3, a B\'f6lcs.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4984954 {\insrsid5968634 53. [Ez az\'e9rt t\'f6rt\'e9nhetett,] hogy azt, amit a s\'e1t\'e1n vet oda, [Allah] k\'eds\'e9rt\'e9ss\'e9
 tegye azoknak, akiknek a sz\'edv\'e9ben betegs\'e9g van \'e9s a kem\'e9nysz\'edv\'fbeknek. Bizony, az igazs\'e1gtalanok messzemen\'f5 ellent\'e9tben vannak.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 54. \'c9s, hogy megtudj\'e1k azok, akiknek a tud\'e1s adatott, hogy ez [a Kor\'e1n] az Igazs\'e1g a te Uradt\'f3l, \'e9
s higgyenek benne, \'e9s a sz\'edv\'fck al\'e1zattal forduljon Hozz\'e1 (Allahhoz). \'c9s bizony, Allah az Egyenes \'datra vezeti azokat, akik hisznek.
\par 55. \'c9s akik hitetlenn\'e9 v\'e1ltak, [azoknak] nem sz\'fbnik meg a k\'e9ts\'e9g fel\'f5le, am\'edg el nem j\'f6n hozz\'e1juk az \'d3ra v\'e1ratlanul, vagy el nem j\'f6n hozz\'e1juk egy medd\'f5 nap (az Utols\'f3 nap) gy\'f6trelme.
\par 56. A }{\insrsid5968634\charrsid3354093 kir\'e1lyi uralom [egyed\'fcl}{\insrsid5968634 ] Allah\'e9 azon a napon, \'edt\'e9lkezni fog k\'f6z\'f6tt\'fck. Akik hisznek \'e9s j\'f3tetteket cselekszenek, azok a gy\'f6ny\'f6r\'fbs\'e9
g kertjeiben lesznek [a Paradicsomban].
\par 57. \'c9s akik hitetlenn\'e9 v\'e1ltak \'e9s meghazudtolt\'e1k a jeleinket, azoknak megal\'e1z\'f3 gy\'f6trelem j\'e1r.
\par 
\par 58. \'c9s akik kiv\'e1ndoroltak Allah \'fatj\'e1n, majd meg\'f6lettek vagy meghaltak, azokat bizony Allah sz\'e9p ell\'e1t\'e1ssal l\'e1tja el. }{\insrsid5968634\charrsid12141346 \'c9s bizony Allah az, aki a legjobb [Ell\'e1t\'f3] az ell\'e1t\'f3k [k\'f6z
\'f6tt].}{\insrsid5968634 
\par 59. Bizony olyan bemenettel fogja bel\'e9ptetni \'f5ket [a Paradicsomba], amivel el\'e9gedettek lesznek. \'c9s bizony, Allah Mindentud\'f3, B\'e9ket\'fbr\'f5.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4984954 {\insrsid5968634 60. [\'cdgy van] ez! Ha valaki olyan m\'e9rt\'e9kben b\'fcntet (torol meg), amilyen m\'e9rt\'e9kben \'f5 szenvedett el b\'fcntet
\'e9st (igazs\'e1gtalans\'e1got), majd [ism\'e9t] zsarnoks\'e1got k\'f6vetnek el ellene, azt Allah bizonyosan megseg\'edti. Bizony, Allah Eln\'e9z\'f5, Megbocs\'e1t\'f3.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 61. Ez [az\'e9rt van \'edgy], mivel Allah beleviszi az \'e9jszak\'e1t a nappalba, \'e9s beleviszi a nappalt az \'e9jszak\'e1ba, 
\'e9s mivel Allah mindent Hall\'f3, mindent L\'e1t\'f3.
\par 62. Ez [az\'e9rt van \'edgy], mivel Allah az Igazs\'e1g, \'e9s amihez \'d5helyette foh\'e1szkodnak, az a hamiss\'e1g. \'c9s mivel Allah a Magass\'e1gos, a Nagy.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4984954 {\insrsid5968634 63. Vajon nem gondolkodt\'e1l el azon, hogy Allah vizet bocs\'e1tott le az \'e9gb\'f5l, \'e9s a f\'f6ld z\'f6ldell\'f5
 lesz? Bizony, Allah K\'edm\'e9letes, [mindent] j\'f3l Ismer\'f5.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 64. \'d6v\'e9 minden, ami az egekben \'e9s ami a f\'f6ld\'f6n van. \'c9s bizony, Allah a Gazdag, a Dics\'e9retrem\'e9lt\'f3.

\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4984954 {\insrsid5968634 65. Vajon nem gondolkodt\'e1l el azon, hogy Allah a szolg\'e1latotokra rendelte mindazt, ami a f\'f6ld\'f6n van, \'e9s a haj\'f3
kat [amelyek] haladnak a tengeren az \'d5 parancsa \'e1ltal? \'c9s megtartja az eget, nehogy a f\'f6ldre essen, kiv\'e9ve [ha] az \'d5 enged\'e9ly\'e9vel [ez megt\'f6rt\'e9nik]. Bizony, Allah az emberek ir\'e1nt Egy\'fctt\'e9rz\'f5, K\'f6ny\'f6r\'fcletes.

\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 66. \'c9s \'d5 az, aki \'e9letre keltett titeket, majd hal\'e1lba bocs\'e1t, majd \'fajra \'e9
letre kelt titeket. Bizony az ember h\'e1l\'e1tlan.
\par 
\par 67. Minden egyes k\'f6z\'f6ss\'e9gnek kijel\'f6lt\'fck a maga r\'edtus\'e1t (t\'f6rv\'e9nykez\'e9s\'e9t), amelyet betartanak. \'c9s ne vitatkozzanak h\'e1t veled az \'fcgyben. \'c9s h\'edvd [\'f5ket] az Uradhoz! Bizony te az Egyenes \'datmutat\'e1st k\'f6
veted.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4984954 {\insrsid5968634 68. \'c9s ha vit\'e1ba sz\'e1llnak veled, mondd: \'84Allah jobban tudja, hogy mit cselekszetek.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 69. Allah \'edt\'e9lkezni fog k\'f6ztetek a Felt\'e1mad\'e1s }{\insrsid5968634\charrsid3354093 Napj\'e1n abban, amiben \'f6sszek
\'fcl\'f6nb\'f6ztetek.\'94
\par 70. Vajon nem tudod, hogy Allah tudja mindazt, ami az \'e9gben}{\insrsid5968634  \'e9s a f\'f6ld\'f6n van? Bizony, \'cdr\'e1sban (feljegyz\'e9sben) van az! Bizony, k\'f6nny\'fb az Allahnak.
\par 71. \'c9s Allah helyett olyasmit szolg\'e1lnak, amellyel kapcsolatban [Allah] nem bocs\'e1tott le bizony\'edt\'f3 \'e9rvet, \'e9s amir\'f5l nem rendelkeznek tud\'e1ssal. \'c9s az igazs\'e1gtalanoknak nincs seg\'edt\'f5j\'fck.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4984954 {\insrsid5968634 72. \'c9s amikor a vil\'e1gos jeleink recit\'e1ltatnak nekik, akkor felismered a tagad\'e1st azoknak az arc\'e1n, akik hitetlenn
\'e9 v\'e1ltak. Majdnem r\'e1rontanak azokra, akik recit\'e1lj\'e1k nekik a jeleinket. Mondd: \'84Vajon h\'e1t h\'edr\'fcl adjam nektek azt, ami m\'e9g enn\'e9l is rosszabb? A [Pokol-]t\'fbz [az]. Allah azoknak \'edg\'e9rte meg, akik hitetlenn\'e9 v\'e1
ltak. Milyen nyomor\'fas\'e1gos v\'e9gc\'e9l!\'94
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4984954 {\insrsid5968634 73. \'d3 emberek! P\'e9ld\'e1zat hangzott el, hallgass\'e1tok h\'e1t meg! Bizony azok, akikhez Allah helyett foh\'e1szkodtok m
\'e9g egy legyet sem tudnak teremteni, akkor sem, ha \'f6sszefogn\'e1nak ez\'e9rt. Ha pedig a l\'e9gy elcsen t\'f5l\'fck valamit, nem tudj\'e1k azt visszaszerezni t\'f5le. [Egyform\'e1n] gyenge a k\'f6vetel\'f5 \'e9s akit\'f5l k\'f6vetelnek.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 74. Nem becs\'fclt\'e9k nagyra Allah [hatalm\'e1t], az \'d5t megillet\'f5 nagyrabecs\'fcl\'e9s szerint. Bizony, Allah Er\'f5s, M
\'e9lt\'f3s\'e1gteljes.
\par 75. Allah k\'fcld\'f6tteket v\'e1laszt az angyalok \'e9s az emberek k\'f6z\'fcl. Bizony, Allah mindent Hall\'f3, mindent L\'e1t\'f3.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4984954 {\insrsid5968634 76. Tudja azt, ami el\'f5tt\'fck van [a j\'f6v\'f5t illet\'f5en], \'e9s azt, ami m\'f6g\'f6tt\'fck van [a m\'faltat illet\'f5
en]. \'c9s Allahhoz vitetnek vissza az \'fcgyek [}{\insrsid5968634\charrsid12141346 d\'f6nt\'e9sre}{\insrsid5968634 ]}{\insrsid5968634\charrsid12141346 .}{\insrsid5968634 
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid4984954 {\insrsid5968634 77. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9
ben]! Hajoljatok meg, \'e9s boruljatok le \'e9s szolg\'e1lj\'e1tok Uratokat, \'e9s tegy\'e9tek a j\'f3t, h\'e1tha boldogultok!
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 78. \'c9s k\'fczdjetek Allah [\'fatj\'e1n] az \'d5t megillet\'f5 k\'fczdelemmel! \'d5 v\'e1lasztott ki titeket. \'c9
s nem okozott nektek fesz\'e9lyezetts\'e9get (neh\'e9zs\'e9get) a vall\'e1sban. [Ez] aty\'e1tok, \'c1brah\'e1m vall\'e1sa. \'d5 (Allah) nevezett el titeket muszlimoknak (Allahnak al\'e1vetetteknek) kor\'e1bban, \'e9s ebben [a Kor\'e1nban] is, hogy a k\'fc
ld\'f6tt tan\'fa lehessen veletek szemben, \'e9s ti is tan\'fak lehessetek az emberekkel szemben. Tarts\'e1tok h\'e1t meg az im\'e1dkoz\'e1st, adj\'e1tok meg a k\'f6telez\'f5 adom\'e1nyt, \'e9s ragaszkodjatok Allahhoz! \'d5 a p\'e1rtfog\'f3tok, s milyen j
\'f3 p\'e1rtfog\'f3, \'e9s milyen j\'f3 seg\'edt\'f5!
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid5968634 \page }{
\f0\fs24\insrsid5968634\charrsid5968634 23. sz\'fara \endash  A h\'edv\'f5k (al-Mu'min\'fan) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par }\pard \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 1. Bizony, boldogulnak a h\'edv\'f5k,
\par 2. Akik im\'e1dkoz\'e1sukban al\'e1zatosak.
\par 3. \'c9s akik a felesleges besz\'e9dt\'f5l elfordulnak.
\par 4. \'c9s akik a k\'f6telez\'f5 adom\'e1ny [megad\'e1s\'e1t] teljes\'edtik.
\par 5. \'c9s akik a szem\'e9rm\'fcket meg\'f5rzik [a nemi kapcsolatokt\'f3l],
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid12389669 {\insrsid5968634 6. Kiv\'e9ve a h\'e1zast\'e1rsaikkal [val\'f3 kapcsolatot], vagy azokkal, akiket a jobbjuk birtokol, mert akkor nem \'e9ri \'f5
ket szemreh\'e1ny\'e1s.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 7. Akik pedig ezen fel\'fcl keresnek [nemi kapcsolatot], azok a hat\'e1rokat \'e1th\'e1g\'f3k.
\par 8. \'c9s akik a r\'e1juk b\'edzott let\'e9teket \'e9s az egyezs\'e9g\'fcket meg\'f5rzik.
\par 9. \'c9s akik im\'e1dkoz\'e1saik [betart\'e1s\'e1ra] \'fcgyelnek.
\par 10. \'d5k lesznek az \'f6r\'f6kl\'f5k,
\par 11. Akik \'f6r\'f6klik a Firdauszt [a Paradicsomban]. \'d5k \'f6r\'f6kk\'e9 abban fognak maradni.
\par 
\par 12. \'c9s bizony megteremtett\'fck az embert agyag kivonat\'e1b\'f3l.
\par 13. Majd egy [megterm\'e9keny\'fclt] cseppk\'e9nt helyezt\'fck el egy biztos tart\'f3zkod\'e1si [helyen].
\par 14. Majd a cseppet v\'e9rr\'f6gg\'e9 teremtett\'fck, a v\'e9rr\'f6g\'f6t pedig h\'fasdarabb\'e1 teremtett\'fck, \'e9s a h\'fasdarabot csontokk\'e1 teremtett\'fck, \'e9s a csontokat h\'fassal ruh\'e1ztuk fel, majd egy m\'e1sik teremtm\'e9nyk\'e9nt hoztuk 
\'f5t l\'e9tre [a l\'e9lek belef\'faj\'e1s\'e1val]. \'c1ldass\'e9k h\'e1t Allah, a legjobb Teremt\'f5!
\par 15. Majd bizony ezek ut\'e1n meg fogtok halni.
\par 16. Majd bizony, a Felt\'e1mad\'e1s Napj\'e1n fel lesztek t\'e1masztva.
\par 
\par 17. \'c9s bizony, megteremtett\'fcnk felettetek h\'e9t utat (a h\'e9t eget) \'e9s nem hagyjuk figyelmen k\'edv\'fcl a teremtm\'e9nyeket.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid12389669 {\insrsid5968634 18. \'c9s vizet bocs\'e1tottunk le az \'e9gb\'f5l [megszabott] m\'e9rt\'e9kkel, majd helyet adtunk annak a f\'f6ld\'f6n (t\'e1
rol\'e1sra). \'c9s bizony Nek\'fcnk hatalmunk van arra, hogy elt\'fcntess\'fck azt.
\par }\pard \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 19. Azut\'e1n l\'e9trehoztunk nektek \'e1ltala datolyap\'e1lm\'e1kb\'f3l \'e9s sz\'f5l\'f5t\'f5k\'e9kb\'f5l \'e1ll\'f3
 kerteket, amelyekben sok gy\'fcm\'f6lcs van nektek, \'e9s ezekb\'f5l esztek.
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 20. \'c9s egy f\'e1t, amely a S\'ednai hegyr\'f5l n\'f5 ki, olajat ad 
\'e9s \'e9tel\'fcl szolg\'e1l az ev\'f5knek.
\par 21. \'c9s bizony, tanuls\'e1g van nektek a j\'f3sz\'e1gokban is. Mi abb\'f3l itatunk titeket, ami a hasukban van, sz\'e1motokra sok haszon van azokban \'e9s azokb\'f3l esztek.
\par 22. \'c9s rajtuk \'e9s a haj\'f3kon hordoztattok.
\par 
\par 23. \'c9s bizony elk\'fcldt\'fck No\'e9t az \'f5 n\'e9p\'e9hez, s azt mondta: \'84\'d3 n\'e9pem! Szolg\'e1lj\'e1tok Allahot! Nincs m\'e1s [jogosan }{\insrsid5968634\charrsid3354093 im\'e1dhat\'f3] isten}{\insrsid5968634  sz\'e1motokra Rajta k\'edv\'fc
l! Vajon h\'e1t nem akartok istenf\'e9l\'f5k lenni?\'94
\par 24. S azt mondt\'e1k az el\'f5kel\'f5k, akik hitetlenn\'e9 v\'e1ltak az \'f5 n\'e9p\'e9b\'f5l: \'84\'d5 nem m\'e1s, mint egy hozz\'e1tok hasonl\'f3 ember, [aki] f\'f6l\'e9tek akar emelkedni. \'c9s ha Allah akarta volna, bizony angyalokat k\'fcld\'f6
tt volna le. Nem hallottuk, hogy ilyesmi t\'f6rt\'e9nt volna a hajdanvolt aty\'e1inkkal.
\par 25. Bizony, nem m\'e1s \'f5, csup\'e1n egy f\'e9rfi, akiben \'f5r\'fclts\'e9g van. V\'e1rjatok h\'e1t vele egy ideig!\'94
\par 26. Azt mondta [No\'e9]: \'84Uram! Seg\'edts meg engem, ami\'e9rt meghazudtoltak!\'94
\par 27. \'c9s azt sugalltuk neki [kinyilatkoztat\'e1sk\'e9nt]: \'84K\'e9sz\'edts egy b\'e1rk\'e1t a szem\'fcnk el\'f5tt \'e9s a sugallatunk szerint, \'e9s amikor elj\'f6n a parancsunk \'e9s kifut a katlan (a v\'edz elbor\'edtja a f\'f6ldsz\'edn\'e9
t) akkor vigy\'e9l bele minden [fajt\'e1b\'f3l] egy p\'e1rt, kett\'f5t (h\'edmet \'e9s n\'f5st\'e9nyt) \'e9s a csal\'e1dodat - kiv\'e9ve azt, akivel szemben m\'e1r elhangzott a szavunk [a b\'fcntet\'e9sr\'f5l]! \'c9s ne sz\'f3l\'edts engem azok \'e9rdek
\'e9ben, akik igazs\'e1gtalans\'e1got k\'f6vettek el! Bizony, \'f5k v\'edzbe lesznek fullasztva.
\par 28. \'c9s amikor elhelyezkedt\'e9l a haj\'f3n, te \'e9s azok, akik veled vannak, mondd: 'A h\'e1latelt dics\'f5\'edt\'e9s Allahot illeti, aki megmentett minket az igazs\'e1gtalan n\'e9pt\'f5l!'\'94
\par }{\insrsid5968634\charrsid3354093 29. \'c9s mondd: \'84Uram! Tegy\'e9l le engem \'e1ldott lesz\'e1ll\'f3helyre, hiszen Te vagy a legjobb a sz\'e1ll\'e1sad\'f3k k\'f6z\'f6tt!\'94}{\insrsid5968634 
\par 30. Bizony, ebben jelek vannak! \'c9s mi bizony pr\'f3b\'e1ra tev\'f5k vagyunk.
\par 
\par 31. Majd m\'e1s nemzed\'e9keket hoztunk l\'e9tre \'f5ut\'e1nuk.
\par 32. \'c9s elk\'fcldt\'fcnk k\'f6z\'e9j\'fck egy k\'fcld\'f6ttet (H\'fad pr\'f3f\'e9t\'e1t}{\insrsid5968634\charrsid3354093 ) aki k\'f6z\'fcl\'fck val\'f3 volt, azzal, hogy: \'84Szolg\'e1lj\'e1tok Allahot! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten sz\'e1
motokra Rajta k\'edv\'fcl! Vajon h\'e1t nem akartok istenf\'e9l\'f5k lenni?\'94}{\insrsid5968634 
\par 33. \'c9s azt mondt\'e1k az el\'f5kel\'f5k, akik hitetlenn\'e9 v\'e1ltak az \'f5 n\'e9p\'e9b\'f5l, \'e9s meghazudtolt\'e1k a tal\'e1lkoz\'e1st a T\'falvil\'e1ggal, \'e9s akiknek az evil\'e1gon t\'fal\'e1rad\'f3 j\'f3l\'e9tet juttattunk: \'84\'d5 nem m\'e1
s, mint egy hozz\'e1tok hasonl\'f3 ember, [aki] abb\'f3l eszik, amit ti esztek, \'e9s abb\'f3l iszik, amit ti isztok.
\par 34. \'c9s ha engedelmeskedtek egy hozz\'e1tok hasonl\'f3 embernek, akkor bizony vesztesek vagytok.
\par 35. Vajon azt \'edg\'e9ri-e nektek, hogy ha meghaltok \'e9s porr\'e1, valamint csontokk\'e1 lesztek, akkor [\'e9l\'f5kk\'e9nt] lesztek kihozva [a s\'edrokb\'f3l]?
\par 36. T\'e1voli, nagyon t\'e1voli az, amire \'edg\'e9retet kaptok!
\par 37. Nincs m\'e1s [\'e9let], csup\'e1n az evil\'e1gi \'e9let\'fcnk, meghalunk \'e9s \'e9l\'fcnk, \'e9s nem lesz\'fcnk felt\'e1masztva.
\par 38. Bizony, nem m\'e1s \'f5, csup\'e1n egy olyan f\'e9rfi, aki hazugs\'e1got tal\'e1l ki Allah ellen, \'e9s mi nem hisz\'fcnk neki.\'94
\par 39. Azt mondta [H\'fad]: \'84Uram! Seg\'edts meg engem, ami\'e9rt meghazudtoltak!\'94
\par 40. Azt mondta [Allah]: \'84Egy kis id\'f5 m\'falva, bizony meg fogj\'e1k b\'e1nni!\'94
\par 41. \'c9s igazs\'e1gosan (meg\'e9rdemelten) ragadta el \'f5ket a ki\'e1lt\'e1s, \'e9s [v\'edzen \'fasz\'f3] tajt\'e9kk\'e1 tett\'fck \'f5ket. El h\'e1t az igazs\'e1gtalan n\'e9ppel!
\par 
\par 42. Majd m\'e1s nemzed\'e9keket hoztunk l\'e9tre \'f5ut\'e1nuk.
\par 43. Egyetlen k\'f6z\'f6ss\'e9g sem hozhatja el\'f5re [pusztul\'e1s\'e1nak] hat\'e1ridej\'e9t, \'e9s nem [is] k\'e9sleltetheti.
\par 44. Majd elk\'fcldt\'fck a k\'fcld\'f6tteinket egym\'e1st k\'f6vet\'f5en. Ak\'e1rh\'e1nyszor \'e9rkezett egy k\'fcld\'f6tt a n\'e9p\'e9hez, meghazudtolt\'e1k \'f5t, ez\'e9rt egyiket a m\'e1sik ut\'e1n k\'fcldt\'fck [a pusztul\'e1sba], \'e9s elbesz\'e9l
\'e9ss\'e9 tett\'fck \'f5ket. }{\insrsid5968634\charrsid15884326 Pusztuljon h\'e1t az a n\'e9p, mely nem hisz!}{\insrsid5968634 
\par 
\par 45. Majd elk\'fcldt\'fck M\'f3zest \'e9s testv\'e9r\'e9t, \'c1ront, a jeleinkkel \'e9s nyilv\'e1nval\'f3 bizony\'edt\'e9kot
\par 46. A F\'e1ra\'f3hoz \'e9s annak el\'f5kel\'f5ihez, \'e1m azok fennh\'e9j\'e1ztak, \'e9s g\'f5g\'f6s n\'e9p voltak.
\par 47. \'c9s azt mondt\'e1k: \'84Higgy\'fcnk-e k\'e9t hozz\'e1nk hasonl\'f3 embernek, holott kettej\'fck n\'e9pe a mi szolg\'e1ink?\'94
\par 48. S meghazudtolt\'e1k kettej\'fcket, \'edgy az elpuszt\'edtottak k\'f6z\'e9 ker\'fcltek.
\par 49. \'c9s bizony, M\'f3zesnek adtuk az \'cdr\'e1st (a T\'f3r\'e1t), h\'e1tha [igaz] \'fatra lelnek.
\par 50. \'c9s M\'e1ria fi\'e1t (J\'e9zust), \'e9s anyj\'e1t jell\'e9 tett\'fck, \'e9s kettej\'fcknek mened\'e9ket adtunk egy dombon, amely tart\'f3zkod\'e1si [helyet] \'e9s l\'e1that\'f3 forr\'e1svizet ad.
\par 
\par 51. \'d3 ti, K\'fcld\'f6ttek! Egyetek azokb\'f3l a j\'f3 [t\'e1pl\'e1l\'e9kokb\'f3l] \'e9s j\'f3t cselekedjetek! Bizony, nekem tudom\'e1som van arr\'f3l, amit cselekszetek.
\par 52. \'c9s bizony, ezen k\'f6z\'f6ss\'e9getek egy k\'f6z\'f6ss\'e9g (egy a vall\'e1sotok), \'e9s \'c9n vagyok az Uratok, h\'e1t Engem f\'e9ljetek!
\par 53. \'c1m \'f5k (a k\'fcld\'f6ttek n\'e9pei) darabokra szak\'edtott\'e1k sz\'e9t az \'fcgy\'fcket (vall\'e1sukat). Minden csoport annak \'f6rvendezik, ami n\'e1la van.
\par 54. Hagyd h\'e1t \'f5ket abban, amiben elmer\'fcltek (tudatlans\'e1gukban) egy ideig!
\par }{\insrsid5968634\charrsid3354093 55. }{\insrsid5968634 Vajon a}{\insrsid5968634\charrsid3354093 zt gondolj\'e1k, hogy az\'e9rt l\'e1ttuk el \'f5ket vagyonnal \'e9s fiakkal,
\par 56. Hogy sietve adjunk nekik a}{\insrsid5968634  j\'f3 dolgokb\'f3l? Nem! \'d5k nem veszik \'e9szre [a pr\'f3bat\'e9telt].
\par 57. Bizony azok, akik az Urukt\'f3l val\'f3 f\'e9lelm\'fckben megr\'e9m\'fclnek,
\par 58. \'c9s azok, akik Uruk jeleiben hisznek,
\par 59. \'c9s azok, akik Uruk mell\'e9 t\'e1rsistent nem \'e1ll\'edtanak,
\par 60. \'c9s akik adj\'e1k, amit adnak, mik\'f6zben f\'e9lelemmel telik el a sz\'edv\'fck, hogy Urukhoz t\'e9rnek vissza,
\par 61. \'d5k azok, akik sietve versengenek a j\'f3tettekben, \'e9s \'f5k megel\'f5znek ebben [m\'e1sokat].
\par 
\par 62. \'c9s nem k\'f6telez\'fcnk egyetlen embert sem t\'f6bbre, mint amire k\'e9pes. \'c9s van n\'e1lunk egy \'edr\'e1s, amely megmondja az igazs\'e1got, \'e9s \'f5k nem szenvednek igazs\'e1gtalans\'e1got.
\par 63. De nem! A sz\'edv\'fck elmer\'fclt [a tudatlans\'e1gban] efel\'f5l (a Kor\'e1n fel\'f5l), \'e9s ezen k\'edv\'fcl m\'e1s cselekedeteik is vannak, amelyeket cselekszenek.
\par 64. Amikor pedig gy\'f6trelemmel [s\'fajtva] ragadjuk meg azokat, akik j\'f3l\'e9tben d\'fask\'e1ltak, akkor seg\'edts\'e9g\'e9rt ki\'e1ltanak.
\par 65. [Az lesz mondva nekik]: \'84Ne ki\'e1ltsatok ma seg\'edts\'e9g\'e9rt! Bizony nem kaptok vel\'fcnk szemben seg\'edts\'e9get.
\par 66. Bizony, az \'e9n jeleim imm\'e1r recit\'e1lva lettek nektek, ti pedig sarkon fordultatok.
\par 67. Fennh\'e9j\'e1z\'f3k voltatok miatta (a K\'e1ba szent\'e9ly miatt), s\'e9rt\'f5 [m\'f3don] besz\'e9lgettetek \'e9jszak\'e1nk\'e9nt r\'f3la.\'94
\par 68. Vajon h\'e1t nem gondolkodnak el a besz\'e9den (a Kor\'e1non), vagy olyan j\'f6tt el hozz\'e1juk, ami a hajdanvolt aty\'e1iknak sem j\'f6tt el?
\par 69. Vagy nem ismert\'e9k fel a k\'fcld\'f6tt\'fcket, \'edgy \'f5k elutas\'edtj\'e1k \'f5t?
\par 70. Vagy azt mondj\'e1k: \'84\'d5r\'fclts\'e9g van benne\'94? De nem! Elj\'f6tt hozz\'e1juk az igazs\'e1ggal, \'e1m a legt\'f6bbj\'fck ut\'e1lja az igazs\'e1got.
\par 71. \'c9s ha az igazs\'e1g k\'f6vetn\'e9 a k\'e9nyeiket, akkor roml\'e1sba d\'f5ln\'e9nek az egek \'e9s a f\'f6ld, \'e9s mindaz, ami benn\'fck van. De nem! Az eml\'e9keztet\'e9s\'fcket (int\'e9st \'e9s tekint\'e9lyt) hoztuk el nekik, \'e1m \'f5k az eml
\'e9keztet\'e9s\'fckre \'fcgyet sem vetnek.
\par 72. Vagy fizets\'e9get k\'e9rsz t\'f5l\'fck? \'c1m Urad fizets\'e9ge jobb. \'c9s \'d5 a legjobb az ell\'e1t\'f3k k\'f6z\'f6tt!
\par 73. \'c9s Te bizony egyenes \'fatra h\'edvod \'f5ket.
\par 74. \'c1m akik nem hisznek a T\'falvil\'e1gban, azok bizony let\'e9rnek }{\insrsid5968634\charrsid341912 az}{\insrsid5968634  [Egyenes] \'fatr\'f3l.
\par 75. \'c9s ha megk\'f6ny\'f6r\'fcln\'e9nk rajtuk, \'e9s elh\'e1r\'edtan\'e1nk az \'f5ket \'e9rt \'e1rtalmat, akkor megmakacsoln\'e1k magukat a t\'falkap\'e1saikban, vakon bolyongva.
\par 76. \'c9s bizony megragadtuk \'f5ket a gy\'f6trelemmel, \'e1m nem al\'e1zkodtak meg Uruknak, \'e9s nem foh\'e1szkodtak al\'e1zatosan.
\par 77. Amikor azt\'e1n r\'e1juk nyitjuk a s\'falyos gy\'f6trelem kapuj\'e1t, l\'e1m [akkor] \'f5k k\'e9ts\'e9gbe esnek.
\par 
\par 78. \'c9s \'d5 az, aki l\'e9trehozta nektek a hall\'e1st, a l\'e1t\'e1st \'e9s a sz\'edvet (\'e9rtelmet). Mily kev\'e9ss\'e9 adtok h\'e1l\'e1t!
\par 79. \'c9s \'d5 az, aki megsokas\'edtott titeket a f\'f6ld\'f6n, \'e9s Hozz\'e1 lesztek \'f6sszegy\'fbjtve.
\par 80. \'c9s \'d5 az, aki \'e9letre kelt \'e9s hal\'e1lba k\'fcld, \'e9s \'d6v\'e9 (\'d5r\'e1 tartozik) a nappal \'e9s az \'e9jszaka v\'e1ltakoz\'e1sa. Vajon h\'e1t nem \'e9ltek az eszetekkel?
\par 81. De nem! Ahhoz hasonl\'f3t mondanak, amit a hajdan \'e9ltek mondtak.
\par 82. Azt mondt\'e1k: \'84Vajon ha meghalunk \'e9s porr\'e1, valamint csontokk\'e1 lesz\'fcnk, akkor [\'faj \'e9letre] lesz\'fcnk felt\'e1masztva?
\par 83. \'c9s bizony meg lett \'edg\'e9rve ez (a Felt\'e1mad\'e1s) nek\'fcnk \'e9s kor\'e1bban aty\'e1inknak is. Nem m\'e1s ez, mint a hajdan \'e9ltek legend\'e1i.\'94
\par 84. Mondd [\'f3 Mohamed]: \'84Ki\'e9 a f\'f6ld \'e9s azok, akik azon vannak, }{\insrsid5968634\charrsid6054263 ha val\'f3ban}{\insrsid5968634  rendelkeztek tud\'e1ssal?\'94
\par 85. Azt fogj\'e1k mondani: \'84Allah\'e9!\'94 Mondd: \'84Vajon h\'e1t nem okultok [az int\'e9sb\'f5l]?\'94
\par 86. Mondd: \'84Ki a h\'e9t \'e9g Ura, \'e9s [ki] a hatalmas Tr\'f3nus Ura?\'94
\par 87. Azt fogj\'e1k mondani: \'84Allah\'e9 [mindez]!\'94 Mondd: \'84Vajon h\'e1t nem akartok istenf\'e9l\'f5k lenni?\'94
\par 88. Mondd: \'84Kinek a kez\'e9ben van mindenek birodalma, \'e9s [ki az] aki v\'e9delmet ad, m\'edg Vele szemben nem lehet v\'e9delemre lelni, ha }{\insrsid5968634\charrsid6054263 val\'f3ban r}{\insrsid5968634 endelkeztek tud\'e1ssal?\'94
\par 89. Azt fogj\'e1k mondani: \'84Allah\'e9 [mindez]!\'94 Mondd: \'84Hogyan lehettek h\'e1t [ennyire] megb\'fbv\'f6lve (elt\'e1vol\'edtva az igazs\'e1gt\'f3l)?\'94
\par 90. De nem! Elhoztuk nekik az Igazs\'e1got, \'e9s bizony, \'f5k [}{\insrsid5968634\charrsid12083488 m\'e9gis] hazugok.
\par 91. Allah senkit sem tett gyermek\'e9v\'e9, \'e9s nem volt egyetlen isten sem \'d5mellette, hiszen akkor mindegyik isten mag\'e1val vinn\'e9 azt, amit teremtett, \'e9s egyesek}{\insrsid5968634  k\'f6z\'fcl\'fck a t\'f6bbiek f\'f6l\'e9 kerekedn\'e9
nek. Magasztaltass\'e9k Allah! [\'d5 felett}{\insrsid10321059 e}{\insrsid5968634  van}{\insrsid10321059  annak, mint}{\insrsid5968634 ]}{\insrsid10321059\charrsid2638912 , ahogy le\'edrj\'e1k [\'d5t].}{\insrsid5968634  
\par 92. A rejtett \'e9s a l\'e1that\'f3 [dolgok] Tud\'f3ja, \'e9s [\'d5] afelett van, amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [\'d5mell\'e9].
\par }{\insrsid10321059 
\par }{\insrsid5968634 93. Mondd [\'f3 Mohamed]: \'84Uram! Ha megmutatod nekem azt, amire \'edg\'e9retet kaptak,
\par 94. Uram, akkor ne helyezz engem az igazs\'e1gtalan n\'e9pe k\'f6z\'e9!\'94
\par 95. \'c9s bizony, nek\'fcnk hatalmunkban \'e1ll, hogy megmutassuk neked azt, amit meg\'edg\'e9rt\'fcnk nekik.
\par 96. H\'e1r\'edtsd el a rosszat azzal, ami jobb! }{\highlight4\insrsid5968634\charrsid983814 Mi tudjuk a legjobban, hogy \'f5k mit mondanak.}{\insrsid5968634 
\par 97. \'c9s mondd: \'84Uram! T\'f5led k\'e9rek mened\'e9ket a s\'e1t\'e1nok gonosz suttog\'e1sa el\'f5l!
\par 98. \'c9s T\'f5led k\'e9rek mened\'e9ket Uram, az el\'f5l, hogy megjelenjenek!\'94
\par 
\par 99. Azt\'e1n, amikor elj\'f6n a hal\'e1l valamelyik\'fckh\'f6z, azt mondja: \'84Uram! Hadd t\'e9rjek vissza [az evil\'e1gi \'e9letbe]!
\par 100. H\'e1tha j\'f3tettet fogok cselekedni abban, amit h\'e1tra hagytam!\'94 Nem! Bizony, ezek [csup\'e1n \'fcres] szavak, amelyeket \'f5 mond! \'c9s m\'f6g\'f6tt\'fck lesz egy [az evil\'e1g \'e9s a t\'falvil\'e1g] k\'f6zti akad\'e1ly, am\'edg fel nem t
\'e1masztatnak.
\par 101. \'c9s ha megf\'favatik a k\'fcrt, nem lesz k\'f6z\'f6tt\'fck rokons\'e1g azon a napon, \'e9s nem fogj\'e1k egym\'e1st k\'e9rdezgetni [sem].
\par 102. \'c9s akiknek s\'falyosak lesznek a m\'e9rend\'f5ik [a j\'f3tettekb\'f5l], nos \'f5k bizony azok, akik boldogulnak.
\par 103. \'c9s akiknek k\'f6nny\'fbnek lesznek a m\'e9rend\'f5ik [a j\'f3tettekb\'f5l], nos azok elvesztett\'e9k magukat, \'f6r\'f6kk\'e9 a Gyehenn\'e1ban fognak maradni.
\par 104. \'c9geti a [Pokol-]t\'fbz az arcukat, \'e9s \'f5k abban elkomorulnak [zsugorodott ajkakkal].
\par 105. [Azut\'e1n az lesz mondva nekik:] \'84Vajon nem lettek recit\'e1lva nektek a jeleim, ti pedig meghazudtolt\'e1tok azokat?\'94
\par 106. Azt mondj\'e1k: \'84Urunk! Gy\'f5zelmet aratott f\'f6l\'f6tt\'fcnk a nyomor\'fas\'e1gunk (v\'e1gyaink, b\'fbneink), \'e9s bizony t\'e9velyg\'f5 n\'e9p voltunk.
\par 107. Urunk! Vigy\'e9l ki minket bel\'f5le (a Pokolb\'f3l), \'e9s ha visszat\'e9r\'fcnk [a t\'e9velyg\'e9shez], akkor val\'f3ban igazs\'e1gtalanok vagyunk!\'94
\par 108. [Allah] azt mondja: \'84Maradjatok benne megvetetten, \'e9s ne besz\'e9ljetek Hozz\'e1m!
\par 109. Bizony, volt egy csoport a szolg\'e1im k\'f6z\'fcl, [akik] azt mondt\'e1k: 'Urunk hisz\'fcnk, bocs\'e1ss h\'e1t meg nek\'fcnk, \'e9s k\'f6ny\'f6r\'fclj rajtunk! \'c9s Te vagy a Legk\'f6ny\'f6r\'fcletesebb a k\'f6ny\'f6r\'fcletesek k\'f6z\'f6tt! '

\par 110. Ti pedig g\'fany t\'e1rgy\'e1v\'e1 tett\'e9tek \'f5ket, am\'edg [a g\'fanyol\'f3d\'e1saitok] el nem feledtett\'e9k veletek a R\'f3lam val\'f3 eml\'e9kez\'e9st, \'e9s ti k\'f6zben nevettetek rajtuk.
\par 111. Bizony, \'e9n a mai napon megadom a fizets\'e9g\'fcket, ami\'e9rt t\'fcrelmesek voltak. Bizony, \'f5k a diadalmasak!\'94
\par 112. [Allah] azt mondja: \'84Mennyit id\'f5ztetek a f\'f6ld\'f6n, [az] \'e9vek sz\'e1ma szerint?\'94
\par 113. Azt mondj\'e1k: \'84Egy napig id\'f5zt\'fcnk, vagy a nap egy r\'e9sz\'e9ig; k\'e9rdezd h\'e1t meg a sz\'e1mol\'f3kat!\'94
\par 114. Azt mondja: \'84Nem id\'f5ztetek, csak r\'f6vid ideig. Ha val\'f3ban rendelkeztetek volna tud\'e1ssal [akkor }{\insrsid5968634\charrsid12083488 tudhatt\'e1tok volna]!
\par 
\par 115. Vajon h\'e1t azt gondolt\'e1tok, hogy sz\'f3rakoz\'e1sb\'f3l teremtett\'fcnk titeket, \'e9s hogy ti nem lesztek Hozz\'e1nk}{\insrsid5968634  visszavitetve?\'94
\par 116. \'c9s }{\insrsid5968634\charrsid12083488 Allah afelett van, [amit R\'f3la \'e1ll\'edtanak], [\'d5] az Igaz Kir\'e1ly. Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, csak \'d5, a kegyes Tr\'f3nus Ura.
\par 117. \'c9s aki Allah mellett m\'e1s istenhez}{\insrsid5968634  foh\'e1szkodik, amire n\'e9zve nem [lehet] bizony\'edt\'e9ka, annak elsz\'e1mol\'e1sa az Ur\'e1n\'e1l lesz! Bizony a hitetlenek nem boldogulnak.
\par 118. \'c9s mondd [\'f3 Mohamed]: \'84Uram! Bocs\'e1ss meg \'e9s k\'f6ny\'f6r\'fclj! }{\insrsid5968634\charrsid12083488 \'c9s Te vagy a legjobb a k\'f6ny\'f6r\'fcletesek k\'f6z\'f6tt!\'94}{\insrsid5968634 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid5968634 \page }{
\f0\fs24\insrsid5968634\charrsid5968634 24. sz\'fara - A Vil\'e1goss\'e1g (an-N\'far) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par }\pard \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 1. [Ez egy] sz\'fara, amelyet lebocs\'e1tottunk, \'e9s el\'f5\'edrtuk [a benne foglalt t\'f6rv\'e9nyek betart\'e1s\'e1t], \'e9s vil
\'e1gos jeleket bocs\'e1tottunk le benne, h\'e1tha okultok [az int\'e9sb\'f5l].
\par 2. A par\'e1zn\'e1lkod\'f3 f\'e9rfit \'e9s a par\'e1zn\'e1lkod\'f3 n\'f5t \endash  mindegyik\'fcket - sz\'e1z korb\'e1cs\'fct\'e9ssel korb\'e1csolj\'e1tok meg! \'c9s Allah vall\'e1s\'e1nak k\'e9rd\'e9s\'e9ben ne vegyen r\'e1 titeket az ir\'e1ntuk [\'e9
rzett] egy\'fctt\'e9rz\'e9s [hogy elengedj\'e9tek b\'fcntet\'e9s\'fcket], ha val\'f3ban hisztek Allahban \'e9s az Utols\'f3 Napban! \'c9s legyen tan\'faja a gy\'f6trelm\'fcknek a h\'edv\'f5k egy csoportja!
\par 3. A par\'e1zn\'e1lkod\'f3 f\'e9rfi ne h\'e1zasodjon, csak par\'e1zn\'e1lkod\'f3 n\'f5vel vagy [Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3 n\'f5vel, \'e9s a par\'e1zn\'e1lkod\'f3 n\'f5vel ne h\'e1zasodjon, csak par\'e1zn\'e1lkod\'f3 f\'e9
rfi, vagy [Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3 f\'e9rfi. \'c9s ez (az ilyen h\'e1zast\'e1rs) tilalmass\'e1 t\'e9tetett a h\'edv\'f5knek.
\par 
\par 4. \'c9s akik tisztess\'e9ges asszonyokat [par\'e1znas\'e1ggal] r\'e1galmaznak meg, majd pedig nem \'e1llnak el\'f5 n\'e9gy tan\'faval, azokat korb\'e1csolj\'e1tok meg nyolcvan korb\'e1cs\'fct\'e9ssel, \'e9s ne fogadjatok el t\'f5l\'fck tan\'faskod\'e1
st soha t\'f6bb\'e9! }{\insrsid5968634\charrsid12914092 \'c9s \'f5k bizony az engedetlenek.}{\insrsid5968634 
\par 5. Kiv\'e9ve azokat, akik megb\'e1n\'e1st tan\'fas\'edtanak ezut\'e1n, \'e9s megjavulnak [azokt\'f3l elfogadtatik a tan\'faskod\'e1s]. Mert bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 
\par 6. \'c9s azok, akik a h\'e1zast\'e1rsukat r\'e1galmazz\'e1k meg [par\'e1znas\'e1ggal], \'e9s nincs m\'e1s tan\'fajuk, kiv\'e9ve saj\'e1t maguk, az ilyen f\'e9rfinek az legyen a tan\'faskod\'e1sa, hogy n\'e9gyszer tan\'faskodjon [esk\'fcdve] Allahra, hogy 
\'f5 az igazmond\'f3k k\'f6z\'fcl val\'f3.
\par 7. \'c9s \'f6t\'f6dsz\'f6rre [nyilv\'e1n\'edtsa ki], hogy Allah \'e1tka legyen rajta, ha [\'f5] a hazugok k\'f6z\'fcl val\'f3.
\par 8. \'c9s az h\'e1r\'edtja el r\'f3la (a megr\'e1galmazott feles\'e9gr\'f5l) a gy\'f6trelmet, hogy n\'e9gyszer tan\'faskodik [esk\'fcdve] Allahra, hogy \'f5 (a f\'e9rj) a hazugok k\'f6z\'fcl val\'f3.
\par 9. \'c9s \'f6t\'f6dsz\'f6rre [nyilv\'e1n\'edtsa ki], hogy Allah haragv\'e1sa s\'fajtson r\'e1, ha [\'f5] (a f\'e9rj) az igazmond\'f3k k\'f6z\'fcl val\'f3.
\par 10. \'c9s ha nem lett volna Allah kegye \'e9s k\'f6ny\'f6r\'fclete ir\'e1ntatok [akkor siettetn\'e9 sz\'e1mukra a b\'fcntet\'e9st]. Allah bizony Kiengesztel\'f5d\'f5, B\'f6lcs.
\par 
\par 11. Bizony, akik hazugs\'e1ggal \'e1lltak el\'f5, egy er\'f5s (sz\'f6vetkez\'f5) csoport k\'f6z\'fcletek. Ne gondolj\'e1tok, hogy az rossz }{\insrsid5968634\charrsid12914092 nektek, s\'f5t az}{\insrsid5968634  jobb nektek. }{
\insrsid5968634\charrsid10233576 K\'f6z\'fcl\'fck mindenkinek az j\'e1r, amire szert tett a b\'fbnb\'f5l [amit elk\'f6vetett], s}{\insrsid5968634  aki k\'f6z\'fcl\'fck a nagyj\'e1t (a h\'edresztel\'e9s\'e9t) k\'f6vette el, annak }{
\insrsid5968634\charrsid12914092 hatalmas gy\'f6trelem j\'e1r.
\par 12. Amikor meghallott\'e1tok ezt [a hazugs\'e1got], mi\'e9rt nem felt\'e9teleztek j\'f3t egym\'e1sr\'f3l a h\'edv\'f5 f\'e9rfiak \'e9s a h\'edv\'f5 n\'f5k, \'e9s mi\'e9rt nem mondt\'e1k: \'84Ez egy nyilv\'e1nval\'f3 hazugs\'e1g\'94?}{\insrsid5968634 

\par 13. Mi\'e9rt nem \'e1lltak el\'f5 [a r\'e1galmaz\'f3k] arra n\'e9zve n\'e9gy tan\'faval? \'c1m ha nem \'e1llnak el\'f5 tan\'fakkal, akkor Allah el\'f5tt \'f5k a hazugok.
\par 14. \'c9s ha nem lett volna Allah kegye \'e9s k\'f6ny\'f6r\'fclete ir\'e1ntatok az evil\'e1gon \'e9s a T\'falvil\'e1gon, akkor bizony, amiatt [a hazugs\'e1g miatt], amir\'f5l sz\'f3t szapor\'edtottatok, hatalmas gy\'f6trelem \'e9rt volna titeket.
\par 15. Amikor [sz\'e9tk\'fcrt\'f6lve] a nyelvetekre vett\'e9tek, \'e9s olyat mondtatok a }{\insrsid5968634\charrsid12914092 sz\'e1tokkal}{\insrsid5968634 , amir\'f5l nem rendelkeztetek tud\'e1ssal, \'e9s ezt jelent\'e9ktelennek gondolt\'e1tok, \'e1m Allah el
\'f5tt ez hatalmas dolog.
\par 16. \'c9s amikor meghallott\'e1tok ezt [a hazugs\'e1got], mi\'e9rt nem mondt\'e1tok: \'84Nem lenne szabad nek\'fcnk err\'f5l besz\'e9ln\'fcnk. Magasztaltass\'e1l [\'f3 Allah]! Ez egy hatalmas r\'e1galom!\'94
\par 17. Allah int titeket, nehogy valaha is ehhez hasonl\'f3 tetthez t\'e9rjetek vissza, ha val\'f3ban h\'edv\'f5k vagytok.
\par 18. \'c9s Allah vil\'e1goss\'e1 teszi nektek a jeleket, \'e9s Allah Mindentud\'f3, B\'f6lcs.
\par 
\par 19. Bizony, akik azt szeretn\'e9k, hogy elterjedjen a f\'f6rtelmes tett (a par\'e1znas\'e1g) a h\'edv\'f5k k\'f6r\'e9ben, azoknak f\'e1jdalmas gy\'f6trelem j\'e1r az evil\'e1gon \'e9s a T\'falvil\'e1gon. \'c9s Allah tud, \'e1m ti nem tudtok.
\par 20. \'c9s ha nem lett volna Allah kegye \'e9s k\'f6ny\'f6r\'fclete ir\'e1ntatok [akkor siettetn\'e9 sz\'e1mukra a b\'fcntet\'e9st]. \'c9s Allah bizony Egy\'fctt\'e9rz\'f5, Irgalmas.
\par 
\par 21. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne k\'f6vess\'e9tek a s\'e1t\'e1n l\'e9pteit! \'c9s aki k\'f6veti a s\'e1t\'e1n l\'e9pteit, h\'e1t \'f5 bizony a f\'f6rtelmess\'e9get \'e9
s az elvetend\'f5t parancsolja meg. \'c9s ha nem lett volna Allah kegye \'e9s k\'f6ny\'f6r\'fclete ir\'e1ntatok, akkor egyik\'f5t\'f6k sem tisztult volna meg soha, \'e1m Allah azt tiszt\'edt meg, akit akar. \'c9s Allah mindent Hall\'f3, Mindentud\'f3.

\par 22. \'c9s ne esk\'fcdjenek meg a kegyek \'e9s a b\'f5s\'e9g birtokosai arra, hogy nem adnak a k\'f6zeli rokonnak, \'e9s a szeg\'e9nyeknek, \'e9s azoknak, akik kiv\'e1ndoroltak Allah \'fatj\'e1n! \'c9s legyenek eln\'e9z\'f5ek \'e9s bocs\'e1
ssanak meg! Vajon nem szeretn\'e9tek, ha Allah megbocs\'e1tana nektek? \'c9s Allah Megbocs\'e1t\'f3 Irgalmas.
\par 
\par 23. Bizony, akik tisztess\'e9ges, [a b\'fbnre] nem is gondol\'f3 h\'edv\'f5 asszonyokat [par\'e1znas\'e1ggal] r\'e1galmaznak meg, azok \'e1tkozottak az evil\'e1gon \'e9s a t\'falvil\'e1gon, \'e9s hatalmas gy\'f6trelem j\'e1r nekik.
\par 24. Azon a napon, amikor tan\'faskodni fog ellen\'fck a nyelv\'fck, a kez\'fck \'e9s a l\'e1buk arr\'f3l, amit cselekedtek.
\par 25. Azon a napon Allah teljess\'e9 teszi nekik az \'f5ket megillet\'f5 \'edt\'e9let\'fcket, \'e9s megtudj\'e1k, hogy Allah a Nyilv\'e1nval\'f3 Igazs\'e1g.
\par 26. A hitv\'e1ny n\'f5k a hitv\'e1ny f\'e9rfiakhoz val\'f3k, a hitv\'e1ny f\'e9rfiak pedig a hitv\'e1ny n\'f5kh\'f6z val\'f3k. }{\insrsid5968634\charrsid9792051 \'c9s a j\'f3raval\'f3 n\'f5k}{\insrsid5968634  a j\'f3raval\'f3 f\'e9rfiakhoz val\'f3k, a j
\'f3raval\'f3 f\'e9rfiak pedig a j\'f3raval\'f3 n\'f5kh\'f6z val\'f3k. Azok (a j\'f3k) \'e1rtatlanok abban, amit [r\'f3luk] mondanak [a r\'e1galmaz\'f3k]. Megbocs\'e1t\'e1s \'e9s nemes ell\'e1t\'e1s j\'e1r nekik.
\par 
\par 27. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne l\'e9pjetek be a h\'e1zaitokon k\'edv\'fcl m\'e1s h\'e1zakba, am\'edg nem k\'e9rtek enged\'e9lyt, \'e9s nem k\'f6sz\'f6ntitek annak lak
\'f3it! Ez jobb nektek, h\'e1tha okultok [az int\'e9sb\'f5l].}{\cs100\insrsid5968634 
\par 28. \'c9s ha nem tal\'e1ltok benne senkit, akkor ne l\'e9pjetek be, am\'edg enged\'e9lyt nem kaptok! \'c9s ha azt mondj\'e1k nektek: \'84Forduljatok vissza!\'94, akkor forduljatok vissza! Ez tiszt\'e1bb nektek. \'c9s Allahnak tudom\'e1sa van arr\'f3
l, amit cselekszetek.}{\cs100\chshdng0\chcfpat0\chcbpat8\insrsid5968634 
\par 29. Nem terhel titeket v\'e9ts\'e9g, ha [enged\'e9ly n\'e9lk\'fcl] lakatlan h\'e1zba l\'e9ptek be, melyben [jogos] haszon van sz\'e1motokra. \'c9s Allah tudja azt, amit kinyilv\'e1n\'edtotok, \'e9s azt, amit eltitkoltok.
\par 
\par 30. Mondd [\'f3 Mohamed] a h\'edv\'f5 f\'e9rfiaknak, hogy s\'fcss\'e9k le a tekintet\'fcket, \'e9s \'f5rizz\'e9k meg a szem\'e9rm\'fcket [a par\'e1znas\'e1gt\'f3l]! Az tiszt\'e1bb nekik! \'c9s Allah j\'f3l ismeri azt, amit m\'fbvelnek [Allah t\'f6rv\'e9
nyeivel].
\par 31. \'c9s mondd [\'f3 Mohamed] a h\'edv\'f5 n\'f5knek, hogy s\'fcss\'e9k le a tekintet\'fcket, \'e9s \'f5rizz\'e9k meg a szem\'e9rm\'fcket [a par\'e1znas\'e1gt\'f3l], \'e9s ne fedj\'e9k fel d\'edszeiket, csup\'e1n azt, ami l\'e1that\'f3 bel\'f5le, \'e9
s vonj\'e1k fejkend\'f5iket ruhakiv\'e1g\'e1sukra (\'fagy hogy takarja a nyakukat \'e9s a kebl\'fcket is), \'e9s ne fedj\'e9k fel a d\'edszeiket, kiv\'e9ve f\'e9rj\'fcknek, atyjuknak, ap\'f3suknak, fiaiknak, f\'e9rj\'fck fiainak, fiv\'e9reiknek, fiv\'e9
reik fiainak \'e9s le\'e1nytestv\'e9reik fiainak, asszonyaiknak, [rabszolgan\'f5iknek] akiket jobbjuk birtokol, f\'e9rfi szolg\'e1iknak, akikben m\'e1r nincs nemi v\'e1gy, \'e9s a [kicsi] gyermekeknek, akik m\'e9g nem tudnak semmit a n\'f5k szem\'e9rm\'e9
r\'f5l! \'c9s ne dobogjanak a l\'e1bukkal az\'e9rt, hogy kitud\'f3djon az, amit elrejtenek a d\'edszeikb\'f5l! }{\cs100\chshdng0\chcfpat0\chcbpat8\insrsid5968634\charrsid5059092 \'c9s ti h\'edv\'f5k, mindannyian }{\insrsid5968634\charrsid5059092 
forduljatok Allahhoz b\'fbnb\'e1nattal}{\cs100\chshdng0\chcfpat0\chcbpat8\insrsid5968634\charrsid5059092 , h\'e1tha boldogultok!}{\cs100\chshdng0\chcfpat0\chcbpat8\insrsid5968634 
\par 
\par 32. \'c9s h\'e1zas\'edts\'e1tok meg a k\'f6z\'fcletek val\'f3 egyed\'fcl\'e1ll\'f3kat, \'e9s a j\'f3 embereket a rabszolg\'e1itok \'e9s a rabszolgan\'f5itek k\'f6z\'fcl! Ha szeg\'e9nyek, Allah gazdagg\'e1 teszi \'f5ket a kegy\'e9b\'f5l. \'c9
s Allah [mindent] \'c1tfog\'f3, Mindentud\'f3.
\par 33. \'c9s akiknek nincs m\'f3djuk megh\'e1zasodni, azok tan\'fas\'edtsanak \'f6nmegtart\'f3ztat\'e1st, am\'edg Allah gazdagg\'e1 nem teszi \'f5ket a kegy\'e9b\'f5l! \'c9s ha egyesek [a rabszolg\'e1itok k\'f6z\'fcl], akiket a jobbotok birtokol, a szabads
\'e1glevel\'fcket \'e1h\'edtozz\'e1k, akkor - ha valami j\'f3r\'f3l tudtok benn\'fck - \'edrj\'e1tok meg azt \'e9s adjatok nekik Allah vagyon\'e1b\'f3l, amit adott nektek! \'c9s ne k\'e9nyszer\'edts\'e9tek rabszolgal\'e1nyaitokat prostit\'faci\'f3
ra az evil\'e1gi \'e9let javai ut\'e1n \'e1h\'edtozva, ha meg akarj\'e1k \'f5rizni a tisztess\'e9g\'fcket (ellenkez\'f5 esetben \'f5ket is terheli a par\'e1znas\'e1g b\'fbne)! \'c9s aki k\'e9nyszer\'edti \'f5ket, akkor a k\'e9nyszer\'edt\'e9s\'fck ut\'e1n
}{\cs100\insrsid5968634  [ha b\'fbnb\'e1natot tan\'fas\'edtanak], Allah b}{\cs100\chshdng0\chcfpat0\chcbpat8\insrsid5968634 izony Megbocs\'e1t\'f3, K\'f6ny\'f6r\'fcletes.
\par }{\cs100\insrsid5968634 34. \'c9s bizony lebocs\'e1tottunk hozz\'e1tok vil\'e1goss\'e1 t\'e9v\'f5 jeleket, \'e9s azoknak p\'e9ld\'e1zatait, akik el\'f5ttetek t\'e1voztak el [az \'e9l\'f5k sor\'e1b\'f3l], \'e9s int\'e9st az istenf\'e9l\'f5knek.
\par 
\par 35. Allah az egek \'e9s a f\'f6ld vil\'e1goss\'e1ga. Vil\'e1goss\'e1ga hasonlatos egy falm\'e9lyed\'e9shez, amelyben l\'e1mp\'e1s van, a l\'e1mp\'e1s pedig \'fcvegben van, az \'fcveg mintha ragyog\'f3 \'e9gitest lenne. [A l\'e1mp\'e1s] egy \'e1ldott f\'e1
r\'f3l, ol\'edvaf\'e1r\'f3l gy\'fajt\'f3dik meg, mely nem keleti, se nem nyugati. Olaja majdnem izzik, m\'e9g ha nem is \'e9rintette t\'fbz. Vil\'e1goss\'e1g a vil\'e1goss\'e1gra. Allah azt vezeti az \'d5 vil\'e1goss\'e1g\'e1hoz, akit akar. \'c9s Allah p
\'e9ld\'e1zatokat ad az embereknek, \'e9s Allah minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 36. [Allah vil\'e1goss\'e1ga] olyan h\'e1zakban van, amelyek emel\'e9s\'e9t (\'e9p\'edt\'e9s\'e9t) Allah rendelte el, hogy megeml\'edttessen benn\'fck az \'d5 neve. \'d5t magasztalj\'e1k ott reggel \'e9s k\'e9s\'f5 d\'e9lut\'e1n
\par 37. [Olyan] f\'e9rfiak, akiknek sem a keresked\'e9s, sem az elad\'e1s nem vonja el a figyelm\'e9t az Allahr\'f3l val\'f3 megeml\'e9kez\'e9sr\'f5l, az im\'e1dkoz\'e1s megtart\'e1s\'e1r\'f3l \'e9s a k\'f6telez\'f5 adom\'e1ny kiad\'e1s\'e1r\'f3l. F\'e9
lnek egy olyan napt\'f3l, amelyen a sz\'edvek \'e9s a tekintetek \'f6ssze-vissza forgol\'f3dnak,
\par 38. Az\'e9rt, hogy Allah fizets\'e9get adjon nekik, a legjobb cselekedeteik szerint, \'e9s az \'d5 kegy\'e9b\'f5l gyarap\'edtsa \'f5ket [jutalomban]. \'c9s Allah annak ad ell\'e1t\'e1st, akinek akar, sz\'e1mad\'e1s n\'e9lk\'fcl.
\par 
\par 39. \'c9s akik hitetlenn\'e9 v\'e1ltak, azoknak a cselekedetei olyanok, mint a d\'e9lib\'e1b a s\'edks\'e1gon, amelyet a szomjaz\'f3 v\'edznek gondol, amikor pedig el\'e9rkezik ahhoz, nem tal\'e1l ott semmit, \'e1m Allahot ott tal\'e1lja mag\'e1n\'e1l, 
\'e9s \'d5 teljess\'e9ggel megadja az elsz\'e1mol\'e1s\'e1nak [megfelel\'f5 fizets\'e9get]; \'e9s Allah gyors az elsz\'e1mol\'e1sban.
\par 40. Vagy olyanok, mint [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gek egy m\'e9ly tengeren, amelyeket elbor\'edtanak a hull\'e1mok, amely felett hull\'e1mok vannak, amelyek felett felh\'f5k vannak. Amikor kiny\'fajtja a kez\'e9t, k\'f6zel\'e9
be sincs annak, hogy l\'e1ssa. \'c9s akinek Allah nem adott vil\'e1goss\'e1got, annak nincs semmi vil\'e1goss\'e1ga.}{\insrsid5968634 
\par 
\par 41. Vajon nem gondolkodt\'e1l el azon, hogy Allahot magasztalja mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van, \'e9s a madarak is [sz\'e1rnyaikat] kiterjesztve? Mindegyik tudja a maga im\'e1dkoz\'e1si \'e9s magasztal\'e1si [m\'f3dj\'e1t], \'e9s Alla
hnak tudom\'e1sa van arr\'f3l, amit tesznek.
\par 42. \'c9s Allah\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett. \'c9s Allahn\'e1l lesz a v\'e9gc\'e9l.
\par 43. Vajon nem gondolkodt\'e1l el azon, hogy Allah elhajtja a felh\'f5ket, majd egybevonja azokat, azt\'e1n halomm\'e1 teszi \'f5ket, \'e9s l\'e1tod az es\'f5t, amint el\'f5j\'f6n a hasad\'e9kaikb\'f3l, \'e9s lebocs\'e1t az \'e9gb\'f5l [felh\'f5-]hegyekb
\'f5l valamennyi j\'e9ges\'f5t, s azt s\'fajtja vele, akit akar, \'e9s att\'f3l ford\'edtja el, akit\'f5l akarja? A vill\'e1m\'e1nak ragyog\'e1sa majdnem elveszi a l\'e1t\'e1st.
\par 44. Allah v\'e1ltogatja az \'e9jszak\'e1t \'e9s a nappalt. Bizony ebben jelek vannak az \'e9les megl\'e1t\'e1ssal b\'edr\'f3knak.
\par 45. \'c9s Allah minden mozg\'f3 [\'e9l\'f5l\'e9nyt] v\'edzb\'f5l teremtett. \'c9s van k\'f6z\'f6tt\'fck olyan, amely a has\'e1n j\'e1r, \'e9s van k\'f6z\'f6tt\'fck olyan, amely k\'e9t l\'e1bon j\'e1r, \'e9s van k\'f6z\'f6tt\'fck olyan, amely n\'e9gy l\'e1
bon j\'e1r. Allah azt teremt, amit akar. Bizony, Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 
\par 46. Bizony, lebocs\'e1tottunk vil\'e1goss\'e1 t\'e9v\'f5 jeleket, \'e9s Allah azt vezet az Egyenes \'datra, akit akar.
\par 47. \'c9s azt mondj\'e1k [a k\'e9pmutat\'f3k]: \'84Hisz\'fcnk Allahban \'e9s a K\'fcld\'f6ttben, \'e9s engedelmesked\'fcnk\'94, majd azut\'e1n egy csoport k\'f6z\'fcl\'fck h\'e1tat ford\'edt, \'e9s nem h\'edv\'f5k azok.
\par 48. \'c9s amikor Allahhoz \'e9s a K\'fcld\'f6tt\'e9hez h\'edvatnak, hogy \'edt\'e9lkezzen k\'f6z\'f6tt\'fck, l\'e1m egy csoport }{\insrsid5968634\charrsid5059092 k\'f6z\'fcl\'fck elfordul.}{\insrsid5968634 
\par 49. De ha az \'f5 oldalukon van az igazs\'e1g, akkor j\'f6nnek hozz\'e1 (a Pr\'f3f\'e9t\'e1hoz) engedelmeskedve.
\par 50. Vajon betegs\'e9g van a sz\'edv\'fckben, vagy k\'e9ts\'e9gek gy\'f6trik \'f5ket, vagy att\'f3l f\'e9lnek, hogy igazs\'e1gtalans\'e1gul b\'e1nna vel\'fck Allah \'e9s a K\'fcld\'f6tte? De nem! \'d5k }{\insrsid5968634\charrsid2630221 bizony}{
\insrsid5968634  az igazs\'e1gtalanok.
\par 51. A h\'edv\'f5k szava, amikor Allahhoz \'e9s a K\'fcld\'f6tt\'e9hez h\'edvatnak, hogy \'edt\'e9lkezzen k\'f6z\'f6tt\'fck, csup\'e1n az, hogy azt mondj\'e1k: \'84Halljuk \'e9s engedelmesked\'fcnk.\'94 \'c9s \'f5k azok, akik boldogulnak.
\par 52. \'c9s akik engedelmeskednek Allahnak \'e9s a K\'fcld\'f6tt\'e9nek, \'e9s f\'e9lnek Allaht\'f3l, \'e9s istenf\'e9lelmet tan\'fas\'edtanak Ir\'e1nta, }{\insrsid5968634\charrsid2630221 nos \'f5k bizony}{\insrsid5968634  a diadalmasak.
\par 53. \'c9s Allahra esk\'fcdtek meg [a k\'e9pmutat\'f3k] a leger\'f5teljesebb esk\'fcikkel, hogy ha parancsot adsz nekik, akkor kivonulnak [veled a harchoz]. Mondd: \'84Ne esk\'fcdjetek [hamisan]!\'94 Az engedelmess\'e9g ismeretes [a r\'e9szetekr\'f5
l]. Bizony, Allah j\'f3l ismeri azt, amit cselekszetek.
\par 54. Mondd [\'f3 Mohamed]: \'84Engedelmeskedjetek Allahnak \'e9s engedelmeskedjetek a K\'fcld\'f6ttnek!\'94 \'c1m ha elfordulnak, csup\'e1n az tartozik r\'e1, }{\insrsid5968634\charrsid5059092 ami r\'e1 terheltetett, \'e9s r\'e1tok az, ami r\'e1
tok terheltetett. \'c9s ha engedelmeskedtek, [akkor] az igaz}{\insrsid5968634  \'faton j\'e1rtok. A K\'fcld\'f6ttre nem tartozik m\'e1s, csup\'e1n a vil\'e1gos [\'fczenet-]\'e1tad\'e1s.
\par 
\par 55. Meg\'edg\'e9rte Allah azoknak, akik hisznek k\'f6z\'fcletek \'e9s j\'f3tetteket cselekszenek, hogy bizony [el\'f5deik] hely\'e9be l\'e9pteti \'f5ket ut\'f3dk\'e9nt a f\'f6ld\'f6n, ahogyan [m\'e1sok] hely\'e9be l\'e9ptette ut\'f3dk\'e9
nt azokat is, akik el\'f5tt\'fck }{\insrsid5968634\charrsid5059092 \'e9ltek, \'e9s meg fogja er\'f5s\'edteni a vall\'e1sukat,}{\insrsid5968634  amelyet kiv\'e1lasztott a sz\'e1mukra. \'c9s miut\'e1n f\'e9lelemben \'e9ltek, cser\'e9be biztons\'e1
got ad nekik, [amennyiben] Engem szolg\'e1lnak \'e9s nem \'e1ll\'edtanak Mell\'e9m semmit t\'e1rsistenk\'e9nt. \'c1m akik ezut\'e1n hitetlenn\'e9 v\'e1lnak, azok }{\insrsid5968634\charrsid2630221 bizony}{\insrsid5968634  az engedetlenek.
\par 56. \'c9s tarts\'e1tok meg az im\'e1dkoz\'e1st, \'e9s adj\'e1tok meg a k\'f6telez\'f5 adom\'e1nyt, \'e9s engedelmeskedjetek a K\'fcld\'f6ttnek, }{\insrsid5968634\charrsid2630221 h\'e1tha k\'f6ny\'f6r\'fcletre leltek!}{\insrsid5968634 
\par 57. Ne gondold, hogy azok, akik hitetlenn\'e9 v\'e1ltak, meg fogj\'e1k akad\'e1lyozni [Allahot] a f\'f6ld\'f6n [b\'e1rmiben]. Az \'f5 hajl\'e9kuk a [}{\insrsid5968634\charrsid2630221 Pokol-]t\'fbz, \'e9s milyen}{\insrsid5968634  nyomor\'fas\'e1gos v\'e9gc
\'e9l [az]! 
\par 
\par 58. \'d3 ti, akik hisztek [Allah egyedval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! K\'e9rjenek t\'f5letek [a hozz\'e1tok val\'f3 bel\'e9p\'e9sre] enged\'e9lyt azok, akiket a jobbotok birtokol, \'e9s azok, akik nem \'e9rt\'e9
k el k\'f6z\'fcletek a serd\'fcl\'f5kort, h\'e1rom alkalommal: a hajnali im\'e1dkoz\'e1s el\'f5tt, \'e9s amikor leveszitek a ruh\'e1itok a d\'e9li id\'f5szakban, \'e9s az esti im\'e1dkoz\'e1s ut\'e1n! [Ez a] h\'e1rom [id\'f5szak, amelyben felfed\'f5
dhet] a szem\'e9rmetek. Ezeken t\'fal nem terhel v\'e9ts\'e9g sem titeket, sem \'f5ket [ha enged\'e9ly n\'e9lk\'fcl] egyik\'f5t\'f6k bej\'e1r a m\'e1sikhoz. Ekk\'e9ppen teszi Allah vil\'e1goss\'e1 nektek a jeleket, \'e9s Allah Mindentud\'f3, B\'f6lcs.

\par 59. \'c9s amikor a gyerekek el\'e9rik a serd\'fcl\'f5kort, akkor k\'e9rjenek enged\'e9lyt [minden id\'f5ben] \'fagy, ahogyan azok is enged\'e9lyt k\'e9rtek, akik el\'f5tt\'fck \'e9ltek (az id\'f5sebbek)! Ekk\'e9ppen teszi Allah vil\'e1goss\'e1
 nektek a jeleit. \'c9s Allah Mindentud\'f3, B\'f6lcs.
\par 60. \'c9s azon asszonyokat, akik t\'fal vannak a term\'e9kenys\'e9g kor\'e1n, \'e9s nem rem\'e9lhetnek h\'e1zass\'e1got, nem terheli v\'e9ts\'e9g}{\insrsid5968634\charrsid5059092 , ha leteszik [a k\'fcls\'f5] ruh\'e1jukat, d\'edszeik}{\insrsid5968634 
 mutogat\'e1sa n\'e9lk\'fcl, de ha \'f6nmegtart\'f3ztat\'e1st tan\'fas\'edtanak, az jobb nekik. \'c9s Allah mindent Hall\'f3, Mindentud\'f3.}{\chshdng0\chcfpat0\chcbpat8\insrsid5968634 
\par }{\chshdng0\chcfpat0\chcbpat8\insrsid5968634\charrsid10833629 61.}{\chshdng0\chcfpat0\chcbpat8\insrsid5968634  Ne \'e9rezzen fesz\'e9lyezetts\'e9get a vak, sem a s\'e1nta, sem a beteg [ami\'e9rt m\'e1sok h\'e1z\'e1ban eszik], \'e9s ti magatok se [\'e9
rezzetek fesz\'e9lyezetts\'e9get], ami\'e9rt [vel\'fck egy\'fctt vagy k\'fcl\'f6n] esztek a h\'e1zaitok}{\insrsid5968634 ban (az azokban tal\'e1lt \'e9telekb\'f5l), vagy aty\'e1itok h\'e1zaiban, vagy any\'e1itok h\'e1zaiban, vagy fiv\'e9reitek h\'e1
zaiban, vagy l\'e1nytestv\'e9reitek h\'e1zaiban, vagy apai nagyb\'e1ty\'e1itok h\'e1zaiban, vagy apai nagyn\'e9njeitek h\'e1zaiban, vagy anyai nagyb\'e1ty\'e1itok h\'e1zaiban, vagy anyai nagyn\'e9njeitek h\'e1zaiban, vagy [olyan h\'e1
zakban], amelyeknek a kulcsai a tulajdonotokban vannak, vagy a bar\'e1taitok\'e9ban. Nem }{\chshdng0\chcfpat0\chcbpat8\insrsid5968634 terhel titeket v\'e9ts\'e9g, ha egy\'fctt esztek, vagy k\'fcl\'f6n. \'c9s amikor h\'e1zakba l\'e9ptek be, akkor k\'f6sz
\'f6nts\'e9tek egym\'e1st Allaht\'f3l val\'f3 \'e1ldott \'e9s j\'f3 \'fcdv\'f6zl\'e9ssel! Ekk\'e9ppen teszi Allah vil\'e1goss\'e1 a jeleket, h\'e1tha \'e9ltek az eszetekkel.}{\insrsid5968634 
\par 
\par 62. A h\'edv\'f5k csup\'e1n azok, akik hisznek Allahban, \'e9s a K\'fcld\'f6tt\'e9ben, \'e9s amikor vele vannak egy k\'f6z\'f6s \'fcgyben, nem mennek el, am\'edg nem k\'e9rnek enged\'e9lyt t\'f5le. Bizony, akik enged\'e9lyt k\'e9rnek t\'f5led [\'f3
 Mohamed], \'f5k azok akik hisznek Allahban \'e9s a K\'fcld\'f6tt\'e9ben. \'c9s ha enged\'e9lyt k\'e9rnek t\'f5led valamilyen \'fcgy\'fckben, adj h\'e1t enged\'e9lyt annak, akinek akarsz k\'f6z\'fcl\'fck, \'e9s k\'e9rj megbocs\'e1t\'e1st a sz\'e1
mukra Allaht\'f3l! Bizony Allah Megbocs\'e1t\'f3, Irgalmas.
\par 63. Ne tegy\'e9tek a K\'fcld\'f6tt megsz\'f3l\'edt\'e1s\'e1t magatok k\'f6z\'f6tt olyann\'e1, mint amikor egym\'e1st sz\'f3l\'edtj\'e1tok meg! Bizony, Allah ismeri azokat, akik [enged\'e9ly n\'e9lk\'fcl] kilop\'f3znak k\'f6z\'fcletek, egym\'e1st fedezve. 
}{\insrsid5968634\charrsid10833629 Vigy\'e1zzanak h\'e1t azok,}{\insrsid5968634  akik szembesz\'e1llnak a [Pr\'f3f\'e9ta] parancs\'e1val, nehogy valami k\'eds\'e9rt\'e9s vagy f\'e1jdalmas gy\'f6trelem s\'fajtsa \'f5ket!
\par 64. L\'e1m, bizony Allah\'e9 mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van. \'d5 ismeri azt, amilyen [helyzetben] vagytok. \'c9s azon a Napon, amikor vissza lesznek vitetve Hozz\'e1, h\'edr\'fcl adja nekik azt, amit cselekedtek. \'c9
s Allah minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid5968634 \page }{
\f0\fs24\insrsid5968634\charrsid5968634 25. sz\'fara \endash  A Sz\'e9tv\'e1laszt\'f3 (al-Furq\'e1n) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. \'c1ldott az, aki lebocs\'e1totta az [igazs\'e1g \'e9s hamiss\'e1g k\'f6z\'f6tti] Sz\'e9tv\'e1laszt\'f3t a szolg\'e1j\'e1nak, hogy figyelmeztet\'f5 legyen a teremtm\'e9nyeknek.
\par 2. Az, aki\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett, \'e9s aki nem tett meg [senkit] fi\'fagyermek\'e9v\'e9, \'e9s nem volt neki t\'e1rsa a kir\'e1lyi uralomban, \'e9s megteremtett minden dolgot, majd [a teremtetts\'e9g\'e9nek megfelel\'f5
] m\'e9rt\'e9ket szabott neki.
\par 
\par 3. \'c9s [a hitetlenek] \'d5helyette olyanokat tettek }{\insrsid5968634\charrsid7628981 meg istenekk\'e9}{\insrsid5968634 , akik nem teremtenek semmit, \'e1m \'f5k maguk teremtve lettek. \'c9s nem \'e1ll m\'f3djukban a maguk sz\'e1m\'e1
ra hasznot [hozni], sem \'e1rtalmat [elt\'e1vol\'edtani], \'e9s nem \'e1ll m\'f3djukban hal\'e1lba bocs\'e1tani, sem \'e9letet adni, sem felt\'e1masztani.
\par 4. \'c9s azt mondt\'e1k azok, akik hitetlenn\'e9 v\'e1ltak: \'84Nem m\'e1s ez, mint hazugs\'e1g, amit \'f5 tal\'e1lt ki, \'e9s m\'e1s emberek seg\'edtettek neki ebben.\'94 Bizony, \'f5k igazs\'e1gtalans\'e1ggal \'e9s hamis [besz\'e9ddel] \'e1lltak el\'f5.

\par 5. \'c9s azt mondt\'e1k: \'84[Ezek] a hajdanvoltak legend\'e1i, amiket le\'edratott mag\'e1nak, \'e9s amiket tollba mondanak neki hajnalban \'e9s k\'e9s\'f5 d\'e9lut\'e1n.\'94
\par 6. Mondd [\'f3 Mohamed]: \'84Az bocs\'e1totta le ezt (a Kor\'e1nt), aki tudja a titkot az Egekben \'e9s a f\'f6ld\'f6n. Bizony, \'d5 (Allah) Megbocs\'e1t\'f3, Irgalmas.
\par 
\par 7. \'c9s azt mondt\'e1k: \'84Mi van ezzel a pr\'f3f\'e9t\'e1val, hogy \'e9telt eszik \'e9s j\'e1r a piacokon? Mi\'e9rt nem ker\'fcl lebocs\'e1t\'e1sra hozz\'e1 egy angyal, hogy figyelmeztet\'f5 legyen vele egy\'fctt?
\par 8. Vagy vettetne oda neki egy kincs, vagy lenne neki egy kertje, amelynek [term\'e9seib\'f5l] ehetne?\'94 \'c9s azt mondt\'e1k az igazs\'e1gtalanok: \'84}{\insrsid5968634\charrsid10833629 Nem k\'f6vettek ti m\'e1st, mint}{\insrsid5968634  egy var\'e1
zslattal s\'fajtott f\'e9rfit.\'94
\par 9. N\'e9zd meg, hogyan adnak r\'f3lad p\'e9ld\'e1zatokat, s elt\'e9velyedtek \'f5k, \'edgy nem k\'e9pesek [igaz] \'fatra lelni!
\par 10. \'c1ldass\'e9k az, Aki ha akarja, jobbat ad neked enn\'e9l: kerteket, melyek al\'f3l foly\'f3k folynak, \'e9s palot\'e1kat.
\par 
\par 11. De nem! \'d5k hazugs\'e1gnak tartj\'e1k az \'d3r\'e1t. \'c1m azoknak, akik hazugs\'e1gnak tartj\'e1k az \'d3r\'e1t, L\'e1ngol\'f3 [Pokol-t\'fczet] k\'e9sz\'edtett\'fcnk el\'f5.
\par 12. Amikor [a Pokol-t\'fbz] megl\'e1tja \'f5ket egy t\'e1voli helyr\'f5l, akkor d\'fch\'f6dt morg\'e1s\'e1t \'e9s \'fcv\'f6lt\'e9s\'e9t fogj\'e1k hallani.
\par 13. \'c9s amikor abban (a Pokolban) egy sz\'fbk helyre }{\insrsid5968634\charrsid10833629 vettetnek \'f5k}{\insrsid5968634  \'f6sszel\'e1ncolva, akkor a pusztul\'e1s\'e9rt fognak ott foh\'e1szkodni.
\par 14. [Az lesz nekik mondva:] \'84Ma ne egy pusztul\'e1s\'e9rt }{\insrsid5968634\charrsid7628981 foh\'e1szkodjatok,}{\insrsid5968634  hanem foh\'e1szkodjatok sok pusztul\'e1s\'e9rt!\'94
\par 15. Mondd [\'f3 Mohamed]: \'84Vajon ez a jobb, vagy az \'d6r\'f6kl\'e9t Kertje [a Paradicsomban], amire az istenf\'e9l\'f5k \'edg\'e9retet kaptak?\'94 Ez az \'f6v\'e9k lesz fizets\'e9gk\'e9nt \'e9s v\'e9gc\'e9lk\'e9nt.
\par 16. Nekik az j\'e1r ott, amit csak akarnak. \'d6r\'f6kk\'f6n [abban maradnak]. [Ez] Uradra tartozik felel\'f5ss\'e9gteljes \'edg\'e9retk\'e9nt.
\par 
\par 17. \'c9s azon a napon (a Felt\'e1mad\'e1s napj\'e1n), amikor \'f6sszegy\'fbjti \'f5ket, \'e9s azokat, akiket Allah helyett szolg\'e1lnak, \'e9s azt mondja: \'84Vajon ti vitt\'e9tek t\'e9velyg\'e9sbe ezen szolg\'e1imat, vagy \'f5k t\'e9velyedtek le az 
\'fatr\'f3l?\'94
\par 18. Azt mondj\'e1k: \'84Magasztaltass\'e1l [\'f3 Allah]! Nem lett volna helyes, ha Rajtad k\'edv\'fcl m\'e1st tett\'fcnk volna p\'e1rtfog\'f3v\'e1. \'c1m \'e9lvezetekben r\'e9szes\'edtetted \'f5ket \'e9s aty\'e1ikat, am\'edg elfelejtett\'e9k a [R\'f3
lad val\'f3] Eml\'e9keztet\'e9st, \'e9s elpusztult n\'e9p lettek.\'94
\par 19. Bizony meghazudtoltak titeket abban, amit ti mondtok, \'edgy nem tudj\'e1tok [a b\'fcntet\'e9st] elford\'edtani, \'e9s seg\'edts\'e9gre sem leltek. \'c9s aki igazs\'e1gtalans\'e1got k\'f6vet el k\'f6z\'fcletek, azzal nagy gy\'f6trelmet \'edzleltet\'fc
nk meg.
\par 20. \'c9s nem k\'fcldt\'fcnk el el\'f5tted egyetlen k\'fcld\'f6ttet sem, csak \'fagy, hogy \'f5k is \'e9telt ettek, \'e9s j\'e1rtak a piacokon. \'c9s egyeseket k\'f6z\'fcletek k\'eds\'e9rt\'e9ss\'e9 tett\'fcnk m\'e1sok sz\'e1m\'e1ra. Vajon t\'fc
relmesek lesztek-e? \'c9s Urad [mindenkibe] belel\'e1t.
\par 
\par 21. \'c9s azt mondj\'e1k azok, akik nem rem\'e9lik a Vel\'fcnk val\'f3 tal\'e1lkoz\'e1st: \'84Mi\'e9rt nem bocs\'e1ttattak le hozz\'e1nk az angyalok vagy [mi\'e9rt nem] l\'e1thatjuk Urunkat?\'94 Bizony fennh\'e9j\'e1ztak magukban \'e9s t\'falont\'fal g
\'f5g\'f6sek voltak.
\par 22. Azon a napon, amikor megl\'e1tj\'e1k az angyalokat, nem lesz aznap \'f6r\'f6mh\'edr a gonosztev\'f5knek, \'e9s azt mondj\'e1k [akkor nekik]: \'84Tiltottan tilalmas [sz\'e1motokra a bel\'e9p\'e9s a Paradicsomba]!
\par 23. \'c9s odafordulunk ahhoz, amit a [j\'f3]cselekedetekb\'f5l cselekedtek, \'e9s sz\'e9tsz\'f3rt porszemekk\'e9 tessz\'fck azokat.
\par 24. A Paradicsom lak\'f3inak aznap jobb lesz a nyugv\'f3helye, \'e9s szebb a pihen\'f5helye.
\par 25. \'c9s azon a napon, amikor az \'e9g sz\'e9thasad a felh\'f5k [el\'f5t\'f6r\'e9se] \'e1ltal, \'e9s lebocs\'e1ttatnak az angyalok [sorokban t\'f6rt\'e9n\'f5] lebocs\'e1t\'e1ssal,
\par 26. Aznap az igazi kir\'e1lyi uralom a K\'f6ny\'f6r\'fcletes\'e9, \'e9s neh\'e9z nap lesz az a hitetlenek sz\'e1m\'e1ra.
\par 27. \'c9s azon a napon az igazs\'e1gtalan r\'e1harap a kez\'e9re [b\'e1nat\'e1ban], \'e9s azt mondja: \'84\'d3, b\'e1rcsak a K\'fcld\'f6tt \'fatj\'e1t v\'e1lasztottam volna!\'94
\par 28. \'84\'d3, jaj nekem! B\'e1rcsak ne v\'e1lasztottam volna ezt [\'e9s ezt] bar\'e1tnak!
\par 29. Bizony, elt\'e9vely\'edtett engem az Eml\'e9keztet\'f5t\'f5l (a Kor\'e1nt\'f3l), azut\'e1n, hogy az elj\'f6tt hozz\'e1m! \'c9s a s\'e1t\'e1n mindig cserben hagyja az embert.\'94
\par 
\par 30. \'c9s a K\'fcld\'f6tt (Mohamed) azt mondta: \'84\'d3 Uram! Bizony, a n\'e9pem elhagyatott\'e1 tette ezt a Kor\'e1nt!\'94
\par 31. \'c9s ekk\'e9ppen tett\'fcnk minden k\'fcld\'f6tt sz\'e1m\'e1ra ellens\'e9get a gonosztev\'f5k k\'f6z\'fcl [legy\'e9l h\'e1t t\'fcrelemmel!]. A te Urad legyen sz\'e1modra el\'e9gs\'e9ges vezet\'f5nek \'e9s seg\'edt\'f5nek!
\par 32. \'c9s azt mondt\'e1k azok, akik hitetlenn\'e9 v\'e1ltak: \'84Mi\'e9rt nem bocs\'e1ttatott le neki a Kor\'e1n }{\insrsid5968634\charrsid7628981 egyszerre, teljes eg\'e9szben?}{\insrsid5968634  Ekk\'e9ppen [bocs\'e1tottuk le szakaszonk\'e9nt], h
ogy meger\'f5s\'edts\'fck \'e1ltala a sz\'edved, \'e9s lassan, r\'e9szenk\'e9nt recit\'e1ltuk azt.
\par 33. \'c9s nem \'e1llnak el\'f5 neked egyetlen p\'e9ld\'e1zattal (\'e9rvvel) sem an\'e9lk\'fcl, hogy ne hozn\'e1nk el neked [v\'e1laszk\'e9nt] az igazs\'e1got \'e9s [az \'f6v\'e9kn\'e9l] jobb magyar\'e1zatot.
\par 34. Akik az arcukon [h\'fazva] lesznek \'f6sszegy\'fbjtve a Gyehenn\'e1hoz, azok lesznek a legrosszabb helyzet\'fbek \'e9s [\'f5k] a legjobban elt\'e9velyedettek az [Egyenes] \'datt\'f3l.
\par 
\par 35. \'c9s bizony odaadtuk M\'f3zesnek az \'cdr\'e1st, \'e9s a testv\'e9r\'e9t, \'c1ront tett\'fck meg mell\'e9 seg\'edt\'f5\'fcl.
\par 36. \'c9s azt mondtuk: \'84Menjetek el, ti ketten ahhoz a n\'e9phez, akik meghazudtolt\'e1k a Mi jeleinket!\'94 \'c9s romba d\'f6nt\'f6tt\'fck azt teljes rombol\'e1ssal.
\par 37. \'c9s No\'e9 n\'e9p\'e9t [elpuszt\'edtottuk]! Miut\'e1n meghazudtolt\'e1k a k\'fcld\'f6tteket, v\'edzbe fullasztottuk \'f5ket. \'c9s [tanuls\'e1gos] jell\'e9 tett\'fck \'f5ket az embereknek, \'e9s az igazs\'e1gtalanoknak f\'e1jdalmas gy\'f6trelmet k
\'e9sz\'edtett\'fcnk el\'f5.
\par 38. \'c9s [ugyan\'edgy elpuszt\'edtottuk] \'c1dot, Tam\'fadot \'e9s al-Rassz lak\'f3it, \'e9s [m\'e1s] nemzed\'e9keket azok k\'f6z\'f6tt.
\par 39. \'c9s mindny\'e1juknak p\'e9ld\'e1zatokat adtunk [\'e9rvk\'e9nt], majd mindny\'e1jukat nagy puszt\'edt\'e1ssal puszt\'edtottuk el.
\par 40. \'c9s bizony [gyakran] elmentek a v\'e1ros (Szodoma) mellett, amelyre a sz\'f6rny\'fb es\'f5 hullott. H\'e1t vajon nem l\'e1tt\'e1k [mi t\'f6rt\'e9nt a v\'e1rossal]? De nem, }{\insrsid5968634\charrsid14107797 \'f5k nem rem\'e9lnek felt\'e1mad\'e1st}{
\insrsid5968634  [az \'cdt\'e9let napj\'e1n].
\par 
\par 41. \'c9s ha megl\'e1tnak t\'e9ged, nem tesznek meg m\'e1snak, mint g\'fany t\'e1rgy\'e1nak [azt mondv\'e1n]: \'84Vajon ezt k\'fcldte el Allah k\'fcld\'f6ttk\'e9nt?
\par 42. Majdnem elt\'e9r\'edtett minket az isteneinkt\'f5l, ha nem tartottunk volna ki mellett\'fck!\'94 \'c9s meg fogj\'e1k tudni, amikor megl\'e1tj\'e1k majd a gy\'f6trelmet, hogy ki a legjobban elt\'e9velyedett [az Egyenes \'datt\'f3l].
\par 43. Vajon mit gondolsz arr\'f3l, aki a k\'e9ny\'e9t teszi meg isten\'e9nek? H\'e1t vajon te leszel az \'f5 v\'e9delmez\'f5je?
\par 44. Vagy azt gondolod, hogy a legt\'f6bbj\'fck hall vagy \'e9l az esz\'e9vel? \'d5k nem m\'e1sok, mint j\'f3sz\'e1gok. De nem! \'d5k a legjobban elt\'e9velyedettek [az Egyenes \'datt\'f3l].
\par 
\par 45. Vajon nem gondolkodt\'e1l el azon, hogy Urad hogyan ny\'fajtotta meg az \'e1rny\'e9kot? \'c1m ha \'fagy akarta volna, akkor mozdulatlann\'e1 tette volna. Azut\'e1n a napot annak jelz\'f5j\'e9v\'e9 tett\'fck.
\par 46. Azut\'e1n visszah\'fazzuk [az \'e1rny\'e9kot] a magunk [akarat\'e1b\'f3l], k\'f6nny\'fb (fokozatos) visszah\'faz\'e1ssal.
\par 47. \'c9s \'d5 az, aki az \'e9jszak\'e1t \'f6lt\'f6z\'e9kk\'e9, az alv\'e1st pihen\'e9ss\'e9, a nappalt pedig sz\'e9tsz\'e9led\'e9ss\'e9 tette [a meg\'e9lhet\'e9s megszerz\'e9s\'e9\'e9rt].
\par 48. \'c9s \'d5 az, aki elk\'fcldi a szeleket \'f6r\'f6mh\'edr\'fcl a k\'f6ny\'f6r\'fclete (az es\'f5) el\'f5tt. \'c9s tiszta vizet }{\insrsid5968634\charrsid6890236 bocs\'e1tottunk}{\insrsid5968634  le az \'e9gb\'f5l.
\par 49. Hogy \'e9letre kelts\'fcnk \'e1ltala egy }{\insrsid5968634\charrsid7628981 halott helys\'e9get}{\insrsid5968634 , \'e9s hogy megitassunk vele sok j\'f3sz\'e1got \'e9s embert azok k\'f6z\'fcl, amiket teremtett\'fcnk.
\par 50. \'c9s bizony sz\'e9tosztottuk azt k\'f6z\'f6tt\'fck, hogy eml\'e9kezzenek [a Mi kegyeinkre]. \'c1m a legt\'f6bb ember rend\'edthetetlen a hitetlens\'e9gben.
\par 51. \'c9s ha akartuk volna, bizony }{\insrsid5968634\charrsid7628981 minden telep\'fcl\'e9sbe}{\insrsid5968634  k\'fcldt\'fcnk volna figyelmeztet\'f5t.
\par 52. Ne engedelmeskedj h\'e1t a hitetleneknek, \'e9s k\'fczdj ellen\'fck vele (a Kor\'e1nnal) nagy k\'fczdelemmel!
\par 53. \'c9s \'d5 az, aki engedte a k\'e9t tengert [egym\'e1s mellett] folyni \endash  ez \'e9des \'e9s \'edzletes, ez pedig er\'f5sen s\'f3s [\'e9s keser\'fb] \endash  \'e9s a kett\'f5 k\'f6z\'e9 akad\'e1lyt tett \'e9s tiltottan tilalmasat (\'e1th\'e1
ghatatlann\'e1 tette azt).
\par 54. \'c9s \'d5 az, aki a v\'edzb\'f5l embert teremtett, \'e9s [sz\'e1m\'e1ra] v\'e9rrokons\'e1got \'e9s s\'f3gors\'e1got (h\'e1zass\'e1gi rokons\'e1got) hozott l\'e9tre, \'e9s a Te Urad Mindenhat\'f3.
\par 55. \'c9s olyat szolg\'e1lnak Allah helyett, amely nem haszn\'e1l nekik, \'e9s }{\insrsid5968634\charrsid8739146 nem [is] \'e1rt}{\insrsid5968634  nekik, \'e9s a hitetlen mindig [a s\'e1t\'e1nnak] seg\'edt az Ura ellen.
\par 
\par 56. \'c9s nem k\'fcldt\'fcnk el t\'e9ged, csup\'e1n \'f6r\'f6mh\'edrhoz\'f3k\'e9nt \'e9s figyelmeztet\'f5k\'e9nt.
\par 57. Mondd: \'84Nem k\'e9rek \'e9rte semmilyen fizets\'e9get t\'f5letek, de aki akarja, az vegye Ura fel\'e9 \'fatj\'e1t!\'94
\par 58. \'c9s hagyatkozz az \'c9l\'f5re, aki nem hal meg, \'e9s \'d5t magasztald, az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel! \'c9s elegend\'f5 \'d5 a szolg\'e1i v\'e9tkeinek j\'f3 ismer\'f5jek\'e9nt.
\par 59. [\'d5 Allah,] aki megteremtette az egeket \'e9s a f\'f6ldet, \'e9s mindazt, ami k\'f6z\'f6tt\'fck van, hat nap alatt, azut\'e1n elhelyezkedett [Hozz\'e1 m\'e9lt\'f3an] a Tr\'f3nuson. A K\'f6ny\'f6r\'fcletes, k\'e9rdezd h\'e1t \'d5t, a mindent j\'f3
l Ismer\'f5t!}{\cs100\insrsid5968634 
\par 60. \'c9s amikor azt mondj\'e1k nekik: \'84Boruljatok le a K\'f6ny\'f6r\'fcletes el\'f5tt!\'94, azt mondj\'e1k: \'84\'c9s mi az, hogy a K\'f6ny\'f6r\'fcletes? Vajon boruljunk le az el\'f5tt, ami [el\'f5tt] Te parancsoltad meg nek\'fcnk [a leborul\'e1st]?
\'94 \'c9s gyarap\'edtotta \'f5ket viszolyg\'e1sban [az igazs\'e1gt\'f3l].
\par 61. \'c1ldott az, aki tornyokat (hatalmas csillagokat) helyezett az \'e9gre, \'e9s l\'e1mp\'e1st (a Napot), \'e9s vil\'e1goss\'e1got ad\'f3 Holdat tett oda.
\par 62. \'c9s \'d5 az, aki v\'e1ltakoz\'f3v\'e1 tette az \'e9jszak\'e1t \'e9s a nappalt annak, aki eml\'e9kezni akar, vagy h\'e1l\'e1s akar lenni.
\par 
\par 63. \'c9s a K\'f6ny\'f6r\'fcletes szolg\'e1i azok, akik al\'e1zattal j\'e1rnak a f\'f6ld\'f6n, \'e9s ha a tudatlanok [durv\'e1n] megsz\'f3l\'edtj\'e1k \'f5ket, azt mondj\'e1k: \'84B\'e9kess\'e9g!\'94
\par 64. \'c9s akik [im\'e1dkoz\'e1ssal] t\'f6ltik \'e9jjeleiket, Uruk el\'f5tt leborulva \'e9s fel\'e1llva,
\par 65. \'c9s akik azt mondj\'e1k: \'84Urunk ford\'edtsd el t\'f5l\'fcnk a Gyehenna gy\'f6trelm\'e9t, mert bizony annak a gy\'f6trelme elh\'e1r\'edthatatlan!\'94
\par 66. Bizony, rossz hely az a tart\'f3zkod\'e1shoz \'e9s az ottl\'e9thez.
\par 67. \'c9s akik, amikor k\'f6ltenek, nem pazarolnak \'e9s nem is sz\'fbkmark\'faak, \'e9s [a k\'f6lt\'e9s\'fck] azok k\'f6z\'f6tt van, a k\'f6z\'e9p\'faton.
\par 68. \'c9s akik nem foh\'e1szkodnak Allah mellett m\'e1s }{\cs100\insrsid5968634\charrsid9402237 isten}{\cs100\insrsid5968634 hez, \'e9s nem \'f6lnek meg egyetlen embert sem, akinek [\'e9let\'e9t] Allah tilalmass\'e1 tette, csakis jogosan (ember\'f6l\'e9
s vagy a f\'f6ld\'f6n val\'f3 puszt\'edt\'e1s b\'fcntet\'e9sek\'e9nt), \'e9s nem par\'e1zn\'e1lkodnak. Aki pedig ezt teszi, az b\'fbneinek [fizets\'e9g\'e9vel] fog tal\'e1lkozni.
\par 69. Megt\'f6bbsz\'f6r\'f6z\'f5dik neki a gy\'f6trelme a Felt\'e1mad\'e1s Napj\'e1n, \'e9s \'f6r\'f6kk\'e9 abban (a Gyehenn\'e1ban) fog maradni megal\'e1zottan.
\par 70. Kiv\'e9ve azokat, akik b\'fbnb\'e1natot tan\'fas\'edtanak, \'e9s hisznek \'e9s j\'f3tetteket cselekszenek, mert azoknak Allah a rossz tetteiket j\'f3kra cser\'e9li fel. \'c9s Allah Megbocs\'e1t\'f3, Irgalmas!
\par 71. \'c9s aki b\'fbnb\'e1natot tan\'fas\'edt \'e9s j\'f3tettet cselekszik, az bizony [val\'f3di] b\'fbnb\'e1natot tan\'fas\'edtva fordul Allahhoz.
\par 72. \'c9s akik nem k\'f6vetnek el hamis tan\'faz\'e1st, \'e9s ha felesleges besz\'e9d mellett haladnak el, m\'e9lt\'f3s\'e1ggal mennek tov\'e1bb.
\par 73. \'c9s azok, akik, ha eml\'e9keztetik \'f5ket Uruk jeleire, nem rogynak le [fej\'fcket lehajtva] ezek [hallat\'e1n] s\'fcketen \'e9s vakon [hanem elgondolkodnak].
\par 74. \'c9s akik azt mondj\'e1k [foh\'e1szkodva]: \'84Urunk, aj\'e1nd\'e9kozz nek\'fcnk olyan h\'e1zast\'e1rsakat \'e9s lesz\'e1rmazottakat, akikben szemgy\'f6ny\'f6rk\'f6dtet\'e9st (\'f6r\'f6m\'f6t) lel\'fcnk, \'e9s tegy\'e9l minket az istenf\'e9l\'f5k sz
\'e1m\'e1ra p\'e9ld\'e1v\'e1!\'94
\par 75. \'d5k a legfels\'f5 hellyel jutalmaztatnak meg [a Paradicsomban], ami\'e9rt t\'fcrelmesek voltak, \'e9s ott \'fcdv\'f6zl\'e9s \'e9s b\'e9kess\'e9g fogadja \'f5ket.
\par 76. \'d6r\'f6kk\'e9 abban fognak maradni; sz\'e9p hely az a tart\'f3zkod\'e1sra \'e9s az ottl\'e9tre.
\par 77. Mondd [\'f3 Mohamed]: \'84Uram nem t\'f6r\'f5dne veletek, ha nem foh\'e1szkodn\'e1tok [Hozz\'e1]. De [ti, hitetlenek] meghazudtol\'e1st k\'f6vettetek el, ez\'e9rt [a b\'fcntet\'e9s] elker\'fclhetetlen lesz.\'94}{\insrsid5968634 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid5968634 \page }{
\f0\fs24\insrsid5968634\charrsid5968634 26. sz\'fara \endash  A k\'f6lt\'f5k (as-Su'araa) c. sz\'fara}{\fs24\insrsid5968634\charrsid8019449 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par }\pard \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 1. Ta-sz\'edn-m\'edm.}{\cs100\insrsid5968634 
\par 2. Ezek a nyilv\'e1nval\'f3 \'cdr\'e1s jelei.
\par 3. [\'d3 Mohamed] }{\cs100\insrsid5968634\charrsid14368995 ne puszt\'edtsd el magad a b\'e1nattal amiatt, hogy nem h\'edv\'f5k!}{\cs100\insrsid5968634 
\par 4. Ha akarjuk, lebocs\'e1tunk hozz\'e1juk az \'e9gb\'f5l egy jelet, s akkor a nyakuk al\'e1zatosan meghajolva marad el\'f5tte (engedelmeskedve).
\par 5. \'c9s nem j\'f6n el hozz\'e1juk egyetlen \'faj eml\'e9keztet\'e9s a K\'f6ny\'f6r\'fcletest\'f5l an\'e9lk\'fcl, hogy ne forduln\'e1nak el \'f5k att\'f3l.
\par 6. Bizony, meghazudtolt\'e1k, ez\'e9rt el fog hozz\'e1juk j\'f6nni annak a h\'edre, amib\'f5l g\'fanyt \'fbztek.
\par 7. H\'e1t vajon nem l\'e1tt\'e1k a f\'f6ldet, h\'e1ny nemes fajt\'e1t sarjasztottunk rajta [a n\'f6v\'e9nyekb\'f5l]?
\par 8. Bizony, abban jel van, \'e1m a legt\'f6bben k\'f6z\'fcl\'fck nem h\'edv\'f5k.
\par 9. \'c9s bizony a te Urad az, aki a M\'e9lt\'f3s\'e1gteljes, az Irgalmas.
\par 
\par 10. \'c9s [eml\'edtsd meg azt, \'f3 Mohamed] amikor Urad sz\'f3l\'edtotta M\'f3zest: \'84Menj el az igazs\'e1gtalan n\'e9phez!
\par 11. A f\'e1ra\'f3 n\'e9p\'e9hez, vajon nem f\'e9lik [Allahot]?\'94
\par 12. Azt mondta [M\'f3zes]: \'84Bizony, f\'e9lek att\'f3l, hogy meghazudtolnak [engem],
\par 13. \'c9s \'f6sszesz\'fbk\'fcl a keblem \'e9s nem forog a nyelvem, k\'fcldj h\'e1t \'c1ron\'e9rt [hogy j\'f6jj\'f6n velem]!
\par 14. \'c9s b\'fbn terhel engem vel\'fck szemben, \'e9s f\'e9lek att\'f3l, hogy meg\'f6lnek!\'94
\par 15. Azt mondta [Allah]: \'84Nem [fognak titeket meg\'f6lni]! Menjetek h\'e1t a jeleinkkel! Bizony, mi veletek vagyunk, \'e9s [mindent] hallunk.
\par 16. Menjetek h\'e1t a F\'e1ra\'f3hoz, \'e9s mondj\'e1tok [azt neki]: \rquote Bizony, mi a teremtm\'e9nyek Ur\'e1nak a k\'fcld\'f6ttei vagyunk.\rquote 
\par 17. [Mondj\'e1tok azt,] hogy: \rquote K\'fcldd el vel\'fcnk Izrael gyermekeit!\rquote \'94
\par 18. Azt mondta [a F\'e1ra\'f3]: \'84Nem nevelt\'fcnk-e fel k\'f6z\'f6tt\'fcnk csecsem\'f5kort\'f3l [fogva], \'e9s id\'f5zt\'e9l k\'f6z\'f6tt\'fcnk \'e9letedb\'f5l \'e9veket?
\par 19. \'c9s elk\'f6vetted tettedet, amelyet tett\'e9l, \'e9s a h\'e1l\'e1tlanok k\'f6z\'e9 tartozol?\'94
\par 20. Azt mondta [M\'f3zes]: \'84Megtettem akkor, amikor m\'e9g a t\'e9velyg\'f5k k\'f6z\'e9 tartoztam,
\par 21. \'c9s elmenek\'fcltem h\'e1t el\'f5letek, amikor f\'e9ltem t\'f5letek, de Uram megaj\'e1nd\'e9kozott b\'f6lcsess\'e9ggel, \'e9s a k\'fcld\'f6ttek k\'f6z\'fcl val\'f3v\'e1 tett.
\par 22. \'c9s ez a j\'f3t\'e9tem\'e9ny, amit felh\'e1nytorgatsz nekem [az], hogy te rabszolg\'e1v\'e1 tetted Izrael gyermekeit!\'94
\par 
\par 23. Azt mondta [a F\'e1ra\'f3]: \'84\'c9s mi az, hogy a teremtm\'e9nyek Ura?\'94
\par 24. Azt mondta [M\'f3zes]: \'84Az egek \'e9s a f\'f6ld Ura, \'e9s mindaz\'e9, ami k\'f6z\'f6tt\'fck van, ha val\'f3ban szil\'e1rd bizonyoss\'e1gotok van.\'94
\par 25. Azt mondta [a F\'e1ra\'f3] azoknak, }{\cs100\insrsid5968634\charrsid13521619 akik}{\cs100\insrsid5968634  k\'f6r\'fclette [voltak]: \'84Vajon nem hallj\'e1tok [amit mond]?\'94}{\insrsid5968634 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 26. Azt mondta [M\'f3zes]: \'84A ti Uratok, \'e9s hajdanvolt aty\'e1
itok Ura.\'94
\par 27. Azt mondta }{\cs100\insrsid5968634 [a F\'e1ra\'f3]}{\insrsid5968634 : \'84Bizony, a k\'fcld\'f6ttetek, aki elk\'fcldetett hozz\'e1tok, egy \'f5r\'fclt!\'94}{\cs100\insrsid5968634 
\par 28. Azt mondta [M\'f3zes]: \'84A kelet \'e9s a nyugat Ura, \'e9s mindaz\'e9, ami k\'f6z\'f6tt\'fck van, ha val\'f3ban \'e9ltek az eszetekkel!\'94}{\insrsid5968634 
\par 29. Azt mondta }{\cs100\insrsid5968634 [a F\'e1ra\'f3]}{\insrsid5968634 : \'84Ha rajtam k\'edv\'fcl m\'e1s }{\insrsid5968634\charrsid9402237 istent}{\insrsid5968634  v\'e1lasztasz, akkor bizony a beb\'f6rt\'f6nz\'f6ttek k\'f6z\'e9 teszlek!\'94
\par 30. Azt mondta [M\'f3zes]: \'84Akkor is, ha nyilv\'e1nval\'f3 dolgot hozok neked [bizonys\'e1gul]?\'94
\par 31. Azt mondta }{\cs100\insrsid5968634 [a F\'e1ra\'f3]}{\insrsid5968634 : \'84Hozd h\'e1t el\'f5, ha val\'f3ban az igazmond\'f3k k\'f6z\'fcl val\'f3 vagy!\'94
\par 32. \'c9s [M\'f3zes] eldobta a botj\'e1t, \'e9s \'edme, az egy nyilv\'e1nval\'f3 (val\'f3s\'e1gos) k\'edgy\'f3 lett.
\par 33. \'c9s kih\'fazta a kez\'e9t, \'e9s \'edme, az feh\'e9r lett azok el\'f5tt, akik n\'e9zt\'e9k.
\par 34. Azt mondta }{\cs100\insrsid5968634 [a F\'e1ra\'f3] }{\insrsid5968634 az el\'f5kel\'f5knek k\'f6r\'fcl\'f6tte: \'84Bizony, ez egy nagy tud\'e1s\'fa var\'e1zsl\'f3!
\par 35. Ki akar \'fbzni titeket a f\'f6ldetekr\'f5l a var\'e1zslat\'e1val, mit tan\'e1csoltok h\'e1t?\'94
\par 36. Azt mondt\'e1k: \'84Halaszd el az \'f5 \'e9s a testv\'e9re \'fcgy\'e9t! \'c9s k\'fcldj a v\'e1rosokba \'f6sszegy\'fbjt\'f5ket,
\par 37. El\'e9d hozz\'e1k az \'f6sszes nagy tud\'e1s\'fa var\'e1zsl\'f3t!\'94
\par 38. \'c9s \'f6sszeh\'edvt\'e1k a var\'e1zsl\'f3kat egy meghat\'e1rozott napon, egy kijel\'f6lt id\'f5pontban.
\par 39. \'c9s az lett mondva }{\insrsid5968634\charrsid2775732 az embereknek: \'84Vajon \'f6sszegy\'fblt\'f6k,
\par 40. Hogy k\'f6vess\'fck a var\'e1zsl\'f3kat, ha \'f5k lesznek a gy\'f5zelmet arat\'f3k?!\'94}{\insrsid5968634 
\par 
\par 41. \'c9s amikor elj\'f6ttek a var\'e1zsl\'f3k, azt mondt\'e1k a F\'e1ra\'f3nak: \'84Lesz-e fizets\'e9g\'fcnk, ha mi lesz\'fcnk a gy\'f5zelmet arat\'f3k?\'94
\par 42. Azt mondta }{\cs100\insrsid5968634 [a F\'e1ra\'f3]}{\insrsid5968634 : \'84Igen! \'c9s ti bizony a [hozz\'e1nk] k\'f6zel\'e1ll\'f3k k\'f6z\'e9 fogtok tartozni.\'94
\par 43. Azt mondta nekik M\'f3zes: \'84Dobj\'e1tok azt, amit dobni akartok!\'94
\par 44. \'c9s eldobt\'e1k a k\'f6teleiket \'e9s a botjaikat, \'e9s azt mondt\'e1k: \'84A F\'e1ra\'f3 m\'e9lt\'f3s\'e1g\'e1ra [esk\'fcsz\'fcnk]! Bizony, mi vagyunk a gy\'f5zelmet arat\'f3k!\'94
\par 45. \'c9s M\'f3zes eldobta a botj\'e1t, s \'edme, az m\'e1r el is nyelte azt, ami hazugs\'e1got kital\'e1ltak.
\par 46. A var\'e1zsl\'f3k pedig leborulva vettettek [a f\'f6ldre],
\par 47. Azt mondv\'e1n: \'84Hisz\'fcnk a teremtm\'e9nyek Ur\'e1ban,
\par 48. M\'f3zes \'e9s \'c1ron Ur\'e1ban.\'94
\par 49. [A F\'e1ra\'f3] azt mondta: \'84Hittetek neki, miel\'f5tt enged\'e9lyt adtam volna r\'e1 nektek? Bizony, \'f5 a nagy (a f\'f5 var\'e1zsl\'f3) k\'f6z\'fcletek, aki megtan\'edtotta nektek a var\'e1zsl\'e1st. H\'e1t meg fogj\'e1tok tudni! Bizony lev\'e1
gom a kezeiteket \'e9s a l\'e1baitokat [egym\'e1ssal] ellent\'e9tesen, majd felfesz\'edtelek titeket, mindny\'e1jatokat!\'94
\par 50. Azt mondt\'e1k: \'84Nem \'e1rthatsz [nek\'fcnk]! Bizony, mi az Urunkhoz t\'e9r\'fcnk vissza!
\par 51. Bizony azt rem\'e9lj\'fck, hogy megbocs\'e1tja nek\'fcnk az Urunk a v\'e9tkeinket amiatt, hogy mi voltunk az els\'f5k, akik h\'edv\'f5k lettek [a F\'e1ra\'f3 n\'e9p\'e9b\'f5l]!\'94
\par 
\par 52. \'c9s azt sugalltuk M\'f3zesnek: \'84Indulj \'fatra \'e9jszaka a szolg\'e1immal; ti bizony k\'f6vetve (\'fcld\'f6zve) lesztek!\'94
\par 53. \'c9s a F\'e1ra\'f3 a }{\insrsid5968634\charrsid2775732 v\'e1rosokba \'f6sszegy\'fbjt\'f5ket k\'fcld\'f6tt,
\par 54. [akik kihirdetik:] \'84Bizony, ezek [csup\'e1n] egy kissz\'e1m\'fa csoport,
\par 55. \'c9s bizony \'f5k feld\'fch\'edtettek minket,
\par 56. \'c9s bizony, mi r\'e9sen \'e1llunk [cselvet\'e9s\'fck ellen].\'94
\par 57. Mi pedig ki\'fbzt\'fck \'f5ket (a F\'e1ra\'f3t \'e9s az embereit) kertekb\'f5l \'e9s forr\'e1sokb\'f3l,
\par 58. \'c9s kincsekb\'f5l, \'e9s nemes [lak]helyr\'f5l.}{\insrsid5968634 
\par 59. Ekk\'e9ppen [volt]. \'c9s \'f6r\'f6k\'fcl adtuk azt Izrael gyermekeinek.
\par 60. \'c9s k\'f6vett\'e9k \'f5ket napkeltekor.
\par 61. Majd amikor a k\'e9t sereg szembetal\'e1lkozott, azt mondt\'e1k M\'f3zes t\'e1rsai: \'84Bizony utol\'e9rtek minket!\'94
\par 62. Azt mondta [M\'f3zes]: \'84De nem! Bizony, Uram velem van, \'e9s vezetni fog engem!\'94
\par 63. Azt\'e1n azt sugalltuk M\'f3zesnek: \'84\'dcss a botoddal a tengerre!\'94 \'c9s az kett\'e9v\'e1lt, majd mindegyik oldala olyan lett, mint egy hatalmas hegy.
\par 64. \'c9s k\'f6zel hoztuk a t\'f6bbieket (a F\'e1ra\'f3t \'e9s a sereg\'e9t) ahhoz a helyhez.
\par 65. \'c9s megment}{\insrsid5968634\charrsid5441373 ett\'fck}{\insrsid5968634  M\'f3zest \'e9s [azokat,] akik vele voltak, mindny\'e1jukat}{\cs100\insrsid5968634 .
\par 66. Azut\'e1n v\'edzbe fullasztottuk a t\'f6bbieket.
\par 67. Bizony, abban jel van, \'e1m a legt\'f6bben k\'f6z\'fcl\'fck nem h\'edv\'f5k.
\par 68. \'c9s bizony a te Urad az, aki a M\'e9lt\'f3s\'e1gteljes, az Irgalmas.
\par 
\par 69. \'c9s recit\'e1ld nekik \'c1brah\'e1m h\'edr\'e9t (t\'f6rt\'e9net\'e9t)!
\par 70. Amikor azt mondta apj\'e1nak \'e9s a n\'e9p\'e9nek: \'84Mit szolg\'e1ltok?\'94
\par 71. Azt mondt\'e1k: \'84B\'e1lv\'e1nyokat szolg\'e1lunk, \'e9s kitart\'f3an [im\'e1djuk] \'f5ket!\'94
\par 72. Azt mondta: \'84Vajon hallanak titeket, amikor [hozz\'e1juk] foh\'e1szkodtok?
\par 73. Vagy hasznotokra vannak vagy \'e1rtani tudnak?\'94
\par 74. Azt mondt\'e1k: \'84Nem, de aty\'e1inkat \'fagy tal\'e1ltuk, hogy ekk\'e9ppen tesznek.\'94
\par 75. Azt mondta: \'84Vajon h\'e1t l\'e1tt\'e1tok, amit szolg\'e1ltatok,
\par 76. ti \'e9s a r\'e9gen \'e9lt aty\'e1itok?
\par 77. Bizony \'f5k az ellens\'e9geim, kiv\'e9ve a teremtm\'e9nyek Ur\'e1t,
\par 78. Aki megteremtett engem, s \'d5 [igaz \'fatra] vezet,
\par 79. \'c9s \'d5 az, aki t\'e1pl\'e1l engem \'e9s megitat,
\par 80. \'c9s ha megbetegszem, akkor \'d5 gy\'f3gy\'edt meg,
\par 81. \'c9s Aki hal\'e1lba k\'fcld engem, azut\'e1n \'e9letre kelt,
\par 82. \'c9s Akit\'f5l azt rem\'e9lem, hogy megbocs\'e1tja v\'e9tkemet az \'cdt\'e9let napj\'e1n.}{\insrsid5968634 
\par 83. Uram, aj\'e1nd\'e9kozz meg engem b\'f6lcsess\'e9ggel, \'e9s add, hogy csatlakozhassak a j\'f3 emberekhez!
\par 84. \'c9s adj nekem igaz dics\'e9retet a k\'e9s\'f5bbi [nemzed\'e9kek] k\'f6z\'f6tt!
\par 85. \'c9s helyezz engem a gy\'f6ny\'f6r\'fbs\'e9g kertj\'e9nek [a Paradicsomnak] \'f6r\'f6k\'f6sei k\'f6z\'e9!
\par 86. \'c9s bocs\'e1ss meg ap\'e1mnak, bizony, \'f5 az elt\'e9velyedettek k\'f6z\'e9 tartozott!
\par 87. \'c9s }{\insrsid5968634\charrsid5441373 ne sz\'e9gyen\'edts meg engem azon a}{\insrsid5968634  napon, amelyen [az emberek] fel lesznek t\'e1masztva!
\par 88. Azon a napon, amelyen nem haszn\'e1l sem a vagyon, sem a gyermekek.
\par 89. Csak az [boldogul], aki \'e9p (tiszta) sz\'edvvel j\'f6n Allahhoz.\'94
\par 
\par 90. \'c9s k\'f6zel hozatik a Paradicsom az istenf\'e9l\'f5kh\'f6z.
\par 91. \'c9s a Pokol el\'f5t\'fbnik azoknak, akik t\'e9v\'fatra ker\'fcltek.
\par 92. \'c9s az lesz mondva nekik: \'84Hol vannak, amiket szolg\'e1ltatok
\par 93. Allah helyett? Vajon seg\'edtenek rajtatok, vagy megseg\'edtik saj\'e1t magukat?\'94
\par 94}{\insrsid5968634\charrsid2775732 . \'c9s arcukra vettetnek abba (a Pokolba), \'f5k \'e9s azok, akik t\'e9v\'fatra ker\'fcltek.}{\insrsid5968634 
\par 95. \'c9s Ibl\'edsz katon\'e1i [is] mindannyian.
\par {\*\bkmkstart 96}{\*\bkmkend 96}96. Azt mondj\'e1k, mik\'f6zben civakodnak benne (a Pokolban):
\par 97. \'84Allahra, bizony nyilv\'e1nval\'f3 t\'e9velyg\'e9sben voltunk,
\par 98. Amikor egyenl\'f5nek tartottunk titeket a teremtm\'e9nyek Ur\'e1val.
\par {\*\bkmkstart 99}{\*\bkmkend 99}99. Nem t\'e9vely\'edtettek el minket m\'e1sok, mint a gonosztev\'f5k.
\par 100. \'c9s [most] nincs egy k\'f6zbenj\'e1r\'f3nk sem,
\par 101. Sem egy k\'f6zeli bar\'e1t.
\par 102. Ha lenne sz\'e1munkra visszat\'e9r\'e9s [az evil\'e1gi \'e9letbe], akkor a h\'edv\'f5k k\'f6z\'fcl val\'f3k lenn\'e9nk!\'94}{\cs100\insrsid5968634 
\par 103. Bizony, abban jel van, \'e1m a legt\'f6bben k\'f6z\'fcl\'fck nem h\'edv\'f5k.
\par 104. \'c9s bizony a te Urad az, aki a M\'e9lt\'f3s\'e1gteljes, az Irgalmas.}{\insrsid5968634 
\par 
\par 105. No\'e9 n\'e9pe meghazudtolta a k\'fcld\'f6tteket.
\par {\*\bkmkstart 106}{\*\bkmkend 106}106. [Eml\'edtsd meg,] amikor No\'e9, az \'f5 testv\'e9r\'fck azt mondta nekik: \'84Vajon nem f\'e9litek [Allahot]?
\par 107. Bizony, \'e9n megb\'edzhat\'f3 k\'fcld\'f6tt vagyok sz\'e1motokra.
\par 108. F\'e9lj\'e9tek h\'e1t Allahot \'e9s engedelmeskedjetek nekem!
\par 109. \'c9s nem k\'e9rek \'e9rte semmilyen fizets\'e9get t\'f5letek. Az \'e9n fizets\'e9gem csak a teremtm\'e9nyek Ur\'e1ra tartozik.
\par 110. F\'e9lj\'e9tek h\'e1t Allahot, \'e9s engedelmeskedjetek nekem!\'94
\par 111. [Azok] azt mondt\'e1k: \'84Higgy\'fcnk-e neked, holott a legal\'e1val\'f3bbak k\'f6vetnek t\'e9ged?\'94
\par 112. Azt mondta [No\'e9]: \'84\'c9s mi tud\'e1som van nekem arr\'f3l, amit kor\'e1bban cselekedtek?
\par 113. Bizony, az elsz\'e1mol\'e1suk csup\'e1n az Uramra tartozik. B\'e1rcsak \'e9szre venn\'e9tek [az igazs\'e1got]!
\par 114. \'c9s \'e9n nem tasz\'edtom ki a h\'edv\'f5ket.
\par 115. \'c9n nem vagyok m\'e1s, csak egy nyilv\'e1nval\'f3 figyelmeztet\'f5.\'94
\par 116. Azt mondt\'e1k: \'84\'d3 No\'e9! Ha nem hagyod abba, bizony a megk\'f6vezettek k\'f6z\'fcl val\'f3 leszel!\'94
\par 117. Azt mondta [No\'e9]: \'84Uram! Bizony a n\'e9pem meghazudtolt engem{\*\bkmkstart 118}{\*\bkmkend 118}!
\par 118. D\'f6nts h\'e1t k\'f6z\'f6tt\'fcnk igazs\'e1ggal, \'e9s ments meg engem, \'e9s azokat, akik velem vannak a h\'edv\'f5k k\'f6z\'fcl!\'94
\par 119. \'c9s megmentett\'fck \'f5t, \'e9s azokat, akik vele voltak a megrakott b\'e1rk\'e1n.
\par 120. Majd azut\'e1n v\'edzbe fullasztottuk azokat, akik megmaradtak [a hitetlens\'e9g\'fck\'f6n].
\par 121. Bizony, abban jel van, \'e1m a legt\'f6bben k\'f6z\'fcl\'fck nem h\'edv\'f5k.
\par 122. \'c9s bizony a te Urad }{\cs100\insrsid5968634 az, aki }{\insrsid5968634 a M\'e9lt\'f3s\'e1gteljes, az Irgalmas.
\par 
\par 123. \'c1d meghazudtolta a k\'fcld\'f6tteket.
\par 124. [Eml\'edtsd meg,] amikor H\'fad, az \'f5 testv\'e9r\'fck azt mondta nekik: \'84Vajon nem f\'e9litek [Allahot]?
\par 125. Bizony, \'e9n megb\'edzhat\'f3 k\'fcld\'f6tt vagyok sz\'e1motokra.
\par 126. F\'e9lj\'e9tek h\'e1t Allahot \'e9s engedelmeskedjetek nekem!
\par 127. \'c9s nem k\'e9rek \'e9rte semmilyen fizets\'e9get t\'f5letek. Az \'e9n fizets\'e9gem csak a teremtm\'e9nyek Ur\'e1ra tartozik.
\par {\*\bkmkstart 129}{\*\bkmkend 129}128. Vajon minden magaslatra jelet \'e9p\'edtetek, sz\'f3rakoz\'e1sb\'f3l?
\par 129. \'c9s er\'f5d\'edtm\'e9nyeket emeltek}{\insrsid5968634\charrsid9856864 , mintha \'f6r\'f6k}{\insrsid5968634  \'e9let\'fbek lenn\'e9nek?
\par 130. \'c9s amikor csap\'e1st m\'e9rtek, akkor hatalmaskod\'f3k\'e9nt teszitek?
\par 131. F\'e9lj\'e9tek h\'e1t Allahot \'e9s engedelmeskedjetek nekem!
\par 132. \'c9s f\'e9lj\'e9tek azt, aki b\'f5s\'e9gesen gondoskodott r\'f3latok azzal, amir\'f5l tudom\'e1sotok van!
\par 133. B\'f5s\'e9gesen gondoskodott r\'f3latok j\'f3sz\'e1gokkal \'e9s gyermekekkel,
\par 134. \'c9s kertekkel \'e9s forr\'e1sokkal.
\par 135. Bizony, \'e9n f\'e9ltelek titeket egy hatalmas nap gy\'f6trelm\'e9t\'f5l.\'94
\par 136. Azt mondt\'e1k: \'84Egyre megy nek\'fcnk, }{\insrsid5968634\charrsid9856864 hogy intesz-e}{\insrsid5968634  minket, vagy nem vagy az int\'f5k k\'f6z\'fcl val\'f3.
\par 137. Ez [amit megtiltott\'e1l nek\'fcnk] nem m\'e1s, mint a hajdanvoltak szok\'e1sa.
\par 138. \'c9s mi nem lesz\'fcnk gy\'f6trelemmel s\'fajtva.\'94
\par 139. Nos, meghazudtolt\'e1k \'f5t, Mi pedig elpuszt\'edtottuk \'f5ket. Bizony, abban jel van, \'e1m a legt\'f6bben k\'f6z\'fcl\'fck nem h\'edv\'f5k.
\par 140. \'c9s bizony a te Urad }{\cs100\insrsid5968634 az, aki }{\insrsid5968634 a M\'e9lt\'f3s\'e1gteljes, az Irgalmas.
\par 
\par 141. Tam\'fad meghazudtolta a k\'fcld\'f6tteket.
\par 142. [Eml\'edtsd meg,] amikor Sz\'e1leh, az \'f5 testv\'e9r\'fck azt mondta nekik: \'84Vajon nem f\'e9litek [Allahot]?
\par 143. Bizony, \'e9n megb\'edzhat\'f3 k\'fcld\'f6tt vagyok sz\'e1motokra.
\par 144. {\*\bkmkstart 145}{\*\bkmkend 145}F\'e9lj\'e9tek h\'e1t Allahot \'e9s engedelmeskedjetek nekem!
\par 145. \'c9s nem k\'e9rek \'e9rte semmilyen fizets\'e9get t\'f5letek. Az \'e9n fizets\'e9gem csak a teremtm\'e9nyek Ur\'e1ra tartozik.
\par 146. Vajon biztons\'e1gban hagynak titeket abban, ami itt van:{\*\bkmkstart 147}{\*\bkmkend 147}
\par 147. Kertek \'e9s forr\'e1sok{\*\bkmkstart 148}{\*\bkmkend 148} k\'f6zt,
\par 148. \'c9s gabonamez\'f5k\'f6n \'e9s datolyap\'e1lm\'e1k k\'f6zt, amelyeknek puha \'e9s \'e9rett a vir\'e1gzata (term\'e9se),
\par 149. \'c9s a hegyekb\'f5l h\'e1zakat faragtok ki, \'fcgyesen?
\par 150. F\'e9lj\'e9tek h\'e1t Allahot \'e9s engedelmeskedjetek nekem!
\par 151. \'c9s ne engedelmeskedjetek a m\'e9rt\'e9ktelenek parancs\'e1nak!
\par {\*\bkmkstart 152}{\*\bkmkend 152}152. Akik roml\'e1st okoznak a f\'f6ld\'f6n }{\insrsid5968634\charrsid6650394 \'e9s nem hoznak javul\'e1st!\'94}{\insrsid5968634 
\par 153. Azt mondt\'e1k: \'84Te csup\'e1n azok k\'f6z\'e9 tartozol, akiket var\'e1zslat s\'fajtott.
\par 154. Te nem vagy m\'e1s, mint hozz\'e1nk hasonl\'f3 ember. Hozz\'e1l h\'e1t egy jelet, }{\insrsid5968634\charrsid16470555 ha val\'f3ban}{\insrsid5968634  az igazmond\'f3k k\'f6z\'fcl val\'f3 vagy!\'94
\par {\*\bkmkstart 156}{\*\bkmkend 156}155. Azt mondta [Sz\'e1leh]: \'84Ez [itt] egy n\'f5st\'e9nyteve, amelynek joga van az iv\'e1sra, \'e9s nektek is jogotok van az iv\'e1sra egy [m\'e1sik] ismert napon!
\par 156. \'c9s ne illess\'e9tek rosszal, mert akkor egy hatalmas nap f\'e1jdalmas gy\'f6trelme ragad el titeket!\'94
\par 157. Azt\'e1n elv\'e1gt\'e1k a n\'f5st\'e9nyteve l\'e1bin\'e1t, \'e9s megb\'e1n\'f3kk\'e1 v\'e1ltak.
\par 158. \'c9s elragadta \'f5ket a gy\'f6trelem. Bizony, abban jel van, \'e1m a legt\'f6bben k\'f6z\'fcl\'fck nem h\'edv\'f5k.
\par 159. \'c9s bizony a te Urad }{\cs100\insrsid5968634 az, aki }{\insrsid5968634 a M\'e9lt\'f3s\'e1gteljes, az Irgalmas.
\par 
\par 160. L\'f3t n\'e9pe meghazudtolta a k\'fcld\'f6tteket.
\par 161. [Eml\'edtsd meg,] amikor L\'f3t, az \'f5 testv\'e9r\'fck azt mondta nekik: \'84Vajon nem f\'e9litek [Allahot]?
\par 162. Bizony, \'e9n megb\'edzhat\'f3 k\'fcld\'f6tt vagyok sz\'e1motokra.
\par 163. F\'e9lj\'e9tek h\'e1t Allahot \'e9s engedelmeskedjetek nekem!
\par 164. \'c9s nem k\'e9rek \'e9rte semmilyen fizets\'e9get t\'f5letek. Az \'e9n fizets\'e9gem csak a teremtm\'e9nyek Ur\'e1ra tartozik.
\par 165. Vajon [nemi v\'e1gyt\'f3l hajtva] k\'f6zeledtek a f\'e9rfiakhoz az [emberi] teremtm\'e9nyek k\'f6z\'fcl,
\par 166. \'c9s ott hagyj\'e1tok a feles\'e9geiteket, akiket a ti Uratok teremtett nektek? Nem! Olyan n\'e9p vagytok ti, akik \'e1th\'e1gj\'e1k a hat\'e1rokat.\'94
\par 167. Azt mondt\'e1k: \'84\'d3 L\'f3t! Ha nem hagyod abba, bizony, a ki\'fbz\'f6ttek k\'f6z\'fcl val\'f3 leszel.\'94
\par 168. Azt mondta [L\'f3t]: \'84Gy\'fbl\'f6l\'f6m azt, amit cselekszetek!
\par 169. Uram! Ments meg engem \'e9s a csal\'e1domat att\'f3l, amit cselekszenek!\'94
\par 170. Akkor megmentett\'fck \'f5t \'e9s a csal\'e1dj\'e1t, mindannyiukat,
\par 171. Kiv\'e9ve egy \'f6regasszonyt (a feles\'e9g\'e9t), aki azok k\'f6z\'fcl val\'f3 volt, akik h\'e1tramaradtak.
\par 172. Azut\'e1n elpuszt\'edtottuk a t\'f6bbieket.
\par 173. \'c9s [k\'f5-]es\'f5t z\'fad\'edtottunk r\'e1juk. Milyen rossz azok es\'f5je, akik figyelmeztetve lettek!
\par 174. Bizony, abban jel van, \'e1m a legt\'f6bben k\'f6z\'fcl\'fck nem h\'edv\'f5k.
\par 175. \'c9s bizony a te Urad }{\cs100\insrsid5968634 az, aki }{\insrsid5968634 a M\'e9lt\'f3s\'e1gteljes, az Irgalmas.
\par 
\par 176. A cserj\'e9s [erd\'f5] lak\'f3i meghazudtolt\'e1k a k\'fcld\'f6tteket.
\par 177. [Eml\'edtsd meg,] amikor Suajb azt mondta nekik: \'84Vajon nem f\'e9litek [Allahot]?
\par 178. Bizony, \'e9n megb\'edzhat\'f3 k\'fcld\'f6tt vagyok sz\'e1motokra.
\par 179. F\'e9lj\'e9tek h\'e1t Allahot \'e9s engedelmeskedjetek nekem!
\par 180. \'c9s nem k\'e9rek \'e9rte semmilyen fizets\'e9get t\'f5letek. Az \'e9n fizets\'e9gem csak a teremtm\'e9nyek Ur\'e1ra tartozik.
\par 181. Tegy\'e9tek teljess\'e9 a kim\'e9r\'e9st, \'e9s ne legyetek azok k\'f6z\'fcl val\'f3k, akik vesztes\'e9get okoznak!
\par 182. \'c9s m\'e9rjetek igazs\'e1gos (pontos) m\'e9rleggel!
\par 183. \'c9s ne r\'f6vid\'edts\'e9tek meg az embereket a dolgaikban \'e9s ne j\'e1rjatok [gonoszul] a f\'f6ld\'f6n roml\'e1st okozva!
\par 184. \'c9s f\'e9lj\'e9tek azt, aki titeket teremtett, \'e9s a hajdanvolt sokas\'e1got!\'94
\par 185. Azt mondt\'e1k: \'84Te csup\'e1n azok k\'f6z\'e9 tartozol, akiket var\'e1zslat s\'fajtott.
\par 186. Te nem vagy m\'e1s, mint egy hozz\'e1nk hasonl\'f3 ember, \'e9s \'fagy v\'e9lj\'fck, hogy te azok k\'f6z\'fcl val\'f3 vagy, akik hazudnak.
\par 187. Hullajts h\'e1t r\'e1nk darabokat [b\'fcntet\'e9sk\'e9nt] az \'e9gb\'f5l, }{\insrsid5968634\charrsid16470555 ha val\'f3ban az}{\insrsid5968634  igazmond\'f3k k\'f6z\'fcl val\'f3 vagy!\'94
\par 188. Azt mondta [Suajb]: {\*\bkmkstart 189}{\*\bkmkend 189}\'84Uram tudja a legjobban azt, amit cselekszetek.\'94
\par 189. \'c1m \'f5k meghazudtolt\'e1k \'f5t. \'c9s megragadta \'f5ket az \'e1rny\'e9kot ad\'f3 [felh\'f5] napj\'e1nak a gy\'f6trelme. Bizony, hatalmas nap gy\'f6trelme volt az.
\par {\*\bkmkstart 190}{\*\bkmkend 190}190. Bizony, abban jel van, \'e1m a legt\'f6bben k\'f6z\'fcl\'fck nem h\'edv\'f5k.
\par 191. \'c9s bizony a te Urad }{\cs100\insrsid5968634 az, aki }{\insrsid5968634 a M\'e9lt\'f3s\'e1gteljes, az Irgalmas.}{\cs100\insrsid5968634 
\par 
\par 192. \'c9s bizony, ez (a Kor\'e1n) a teremtm\'e9nyek Ur\'e1nak a lebocs\'e1tott [kinyilatkoztat\'e1sa].
\par 193. A Megb\'edzhat\'f3 L\'e9lek (G\'e1briel angyal) hozta le,
\par 194. A te sz\'edvedbe [\'f3 Mohamed], hogy a figyelmeztet\'f5k k\'f6z\'fcl val\'f3 legy\'e9l.
\par 195. Nyilv\'e1nval\'f3 (vil\'e1gos) arab nyelven.
\par 196. \'c9s bizony, az [eml\'edt\'e9se] benne van a hajdanvoltak k\'f6nyveiben.
\par 197. H\'e1t vajon nem volt-e nekik jel abban, hogy Izrael gyermekeinek a tud\'f3sai tudtak r\'f3la?
\par 198. \'c9s ha ezt lebocs\'e1tottuk volna valakinek a nem-arabok k\'f6z\'fcl,
\par 199. \'e9s felolvasta volna nekik, akkor sem hittek volna benne.
\par 200. Ekk\'e9ppen engedt\'fck bel\'e9pni [a hitetlens\'e9get] a gonosztev\'f5k sz\'edv\'e9be.}{\insrsid5968634 
\par 201. Nem hisznek benne, am\'edg a f\'e1jdalmas gy\'f6trelmet meg nem l\'e1tj\'e1k,
\par 202. Az pedig v\'e1ratlanul j\'f6n el hozz\'e1juk, mik\'f6zben \'e9szre sem veszik.
\par 203. Akkor majd azt mondj\'e1k: \'84Vajon kapunk-e halad\'e9kot?
\par 204. Vajon a Mi gy\'f6trelm\'fcnket siettetik?\'94
\par 205. }{\insrsid5968634 Vajon h\'e1t elgondolkodt\'e1l [azon], [hogy] }{\insrsid5968634 ha \'e9lvezetekben r\'e9szes\'edtj\'fck \'f5ket esztend\'f5kig,
\par 206. azt\'e1n elj\'f6n hozz\'e1juk az, amire \'edg\'e9retet kaptak,
\par 207. [Akkor] nem fog haszn\'e1lni nekik az, ami \'e9lvezetk\'e9nt adatott nekik?
\par 208. \'c9s nem puszt\'edtottunk el egyetlen v\'e1rost sem an\'e9lk\'fcl, hogy ne lettek volna figyelmeztet\'f5ik,
\par 209. Eml\'e9keztet\'e9s gyan\'e1nt. \'c9s nem voltunk sosem igazs\'e1gtalanok!
\par 210. \'c9s nem hozz\'e1k le [a Kor\'e1nt] a s\'e1t\'e1nok!
\par 211. Nem m\'e9lt\'f3k arra, \'e9s nem is k\'e9pesek r\'e1.
\par 212. Bizony, \'f5k t\'e1vol vannak tartva [annak] hall\'e1s\'e1t\'f3l [ami az \'e9gben elhangzik].
\par 
\par 213. Ne foh\'e1szkodj h\'e1t Allah }{\insrsid5968634\charrsid6650394 mellett m\'e1s istenhez}{\insrsid5968634 , mert akkor azok k\'f6z\'fcl val\'f3 leszel, akiket a gy\'f6trelem s\'fajt!
\par 214. \'c9s figyelmeztesd a legk\'f6zelebbi nemzets\'e9gedet!
\par 215. \'c9s ereszd le sz\'e1rnyaidat [al\'e1zatb\'f3l] azokra, akik h\'edv\'f5kk\'e9nt k\'f6vetnek t\'e9ged!
\par 216. \'c9s ha ellenszeg\'fclnek neked, akkor mondd: \'84Elhat\'e1rol\'f3dok att\'f3l, amit ti cselekszetek.\'94
\par 217. \'c9s hagyatkozz a M\'e9lt\'f3s\'e1gteljesre, az Irgalmasra,
\par 218. Aki l\'e1t t\'e9ged, amikor fel\'e1llsz [az im\'e1dkoz\'e1shoz],
\par 219. \'c9s [l\'e1tja] az imamozdulataidat a leborul\'f3kkal egy\'fctt (az im\'e1dkoz\'e1s k\'f6zben)!
\par 220. Bizony, \'d5 a Mindent Hall\'f3, a Mindentud\'f3.
\par 221. H\'edr\'fcl adjam-e nektek, hogy kihez j\'f6nnek le a s\'e1t\'e1nok?
\par 222. Minden hazudoz\'f3hoz, b\'fbn\'f6sh\'f6z j\'f6nnek le.
\par 223. Hallgat\'f3znak [az \'e9gben], \'e1m a legt\'f6bben k\'f6z\'fcl\'fck hazugok.
\par 224. \'c9s a k\'f6lt\'f5ket azok k\'f6vetik, akik t\'e9v\'fatra ker\'fcltek.
\par 225. Vajon nem gondolkodt\'e1l el azon, hogy minden v\'f6lgyben k\'f3sz\'e1lnak (mindenf\'e9le m\'fbfajban hazugs\'e1got k\'f6ltenek)?
\par 226. \'c9s bizony, \'f5k olyat mondanak, amit nem tesznek meg,
\par 227. kiv\'e9ve azokat, akik hisznek \'e9s j\'f3tetteket cselekszenek, \'e9s gyakran megeml\'e9keznek Allahr\'f3l, \'e9s akik seg\'edtenek magukon, miut\'e1n igazs\'e1gtalans\'e1got szenvedtek el. \'c9s meg fogj\'e1k tudni azok, akik igazs\'e1gtalans\'e1
got k\'f6vettek el, hogy milyen visszat\'e9r\'e9sre (b\'fcntet\'e9sre) fognak visszat\'e9rni!
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\fs24\insrsid5968634\charrsid6816005 
\page }{\f0\fs24\insrsid5968634\charrsid5968634 27. sz\'fara \endash  A hangy\'e1k (an-Naml) c. sz\'fara}{\fs24\insrsid5968634\charrsid6816005 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par }\pard \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 
\par 1. Ta-sz\'edn. Ezek a Kor\'e1n \'e9s egy nyilv\'e1nval\'f3 \'cdr\'e1s jelei,
\par 2. \'datmutat\'e1sk\'e9nt \'e9s \'f6r\'f6mh\'edrk\'e9nt a h\'edv\'f5knek,
\par 3. Akik megtartj\'e1k az im\'e1dkoz\'e1st, odaadj\'e1k a k\'f6telez\'f5 adom\'e1nyt, \'e9s szil\'e1rd bizonyoss\'e1guk van a t\'falvil\'e1gr\'f3l.
\par 4. Bizony, akik nem hisznek a t\'falvil\'e1gban, azoknak feld\'edsz\'edtett\'fck (j\'f3nak mutattuk) a cselekedeteiket, \'edgy \'f5k vakon bolyonganak.
\par 5. \'d5k azok, akiknek a sz\'f6rny\'fb gy\'f6trelem j\'e1r, a t\'falvil\'e1gon pedig \'f5k lesznek a legvesztesebbek.
\par 6. \'c9s bizony, te att\'f3l kapod a Kor\'e1nt, aki B\'f6lcs, Mindentud\'f3.
\par 
\par 7. [Eml\'edtsd meg,] amikor M\'f3zes azt mondta a csal\'e1dj\'e1nak: \'84Bizony, \'e9n t\'fczet l\'e1ttam. Hozni fogok onnan nektek valamilyen h\'edrt, vagy egy par\'e1zsl\'f3 fahas\'e1bot, \'e9g\'f5 cs\'f3v\'e1t, h\'e1tha f\'f6lmelegedtek [\'e1ltala].
\'94
\par 8. Amikor oda\'e9rkezett, megsz\'f3l\'edttatott: \'84\'c1ldott legyen az, aki a t\'fbzn\'e9l van \'e9s aki k\'f6r\'fcl\'f6tte van! \'c9s magasztaltass\'e9k Allah, a teremtm\'e9nyek Ura!
\par 9. \'d3 M\'f3zes! Bizony}{\insrsid5968634\charrsid2521044 , \'c9n}{\insrsid5968634  vagyok Allah, a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 10. \'c9s dobd el a botodat!\'94 Majd amikor l\'e1tta mozogni, mintha egy nagy k\'edgy\'f3 lenne, h\'e1tat ford\'edtott t\'e1vozva, \'e9s nem fordult vissza. [Allah azt mondta:] \'84\'d3 M\'f3zes! Ne f\'e9lj! N\'e1lam nem kell f\'e9lni\'fck a k\'fcld\'f6
tteknek.
\par 11. Kiv\'e9ve [azt], aki igazs\'e1gtalans\'e1got k\'f6vetett el, majd j\'f3 tettel (b\'fbnb\'e1nattal) v\'e1ltotta fel a rossz tettet, akkor bizony \'c9n Megbocs\'e1t\'f3, Irgalmas vagyok.
\par 12. \'c9s tedd be a kezed a ruhakiv\'e1g\'e1sodba, feh\'e9ren j\'f6n el\'f5, rossz (betegs\'e9g) n\'e9lk\'fcl, kilenc [csod\'e1s] jel egyikek\'e9nt, [amit] a F\'e1ra\'f3hoz \'e9s a n\'e9p\'e9hez [fogsz vinni]! Bizony, \'f5k engedetlen n\'e9p voltak!\'94

\par 13. \'c1m amikor elj\'f6ttek hozz\'e1juk a Mi jeleink l\'e1that\'f3an (egy\'e9rtelm\'fb csod\'e1kk\'e9nt), azt mondt\'e1k: \'84Ez egy nyilv\'e1nval\'f3 var\'e1zslat!\'94
\par 14. \'c9s igazs\'e1gtalanul \'e9s fennh\'e9j\'e1z\'f3an megtagadt\'e1k azt, noha megbizonyosodtak arr\'f3l magukban. N\'e9zd h\'e1t meg, milyen v\'e9gre jutottak azok, akik roml\'e1st okoznak!
\par 
\par 15. \'c9s bizony tud\'e1st adtunk D\'e1vidnak \'e9s Salamonnak. \'c9s azt mondt\'e1k: \'84A h\'e1latelt dics\'e9ret Allahot illeti, aki el\'f5nyben r\'e9szes\'edtett minket sokakkal szemben a h\'edv\'f5 szolg\'e1i k\'f6z\'fcl.\'94
\par 16. \'c9s Salamon D\'e1vid \'f6r\'f6k\'e9be l\'e9pett, \'e9s azt mondta: \'84\'d3 ti, emberek! }{\insrsid5968634\charrsid2521044 Meg lett\'fcnk tan\'edtva}{\insrsid5968634  a madarak nyelv\'e9re \'e9s mindenf\'e9le dologb\'f3l adatott nek\'fc
nk. Bizony, ez a nyilv\'e1nval\'f3 kegy.\'94
\par 17. \'c9s \'f6sszegy\'fbjtettek Salamonnak az \'f5 csapatai a dzsinnekb\'f5l, az emberekb\'f5l \'e9s a madarakb\'f3l, \'e9s sorba \'e1ll\'edttattak.
\par 18. Azt\'e1n, amikor el\'e9rkeztek a hangy\'e1k v\'f6lgy\'e9be, azt mondta egy hangya: \'84\'d3 ti, hangy\'e1k! Menjetek be a lakhelyeitekre, [hogy] ne tapossanak sz\'e9t titeket Salamon \'e9s a csapatai, mik\'f6zben \'e9szre se veszik [azt]!\'94
\par 19. \'d5 (Salamon) pedig nevetve elmosolyodott annak szavai [hallat\'e1n] \'e9s azt mondta: \'84Uram! Sarkallj arra engem, hogy megk\'f6sz\'f6njem a j\'f3t\'e9tem\'e9nyt, amelyet ir\'e1ntam \'e9s a sz\'fcleim ir\'e1nt tan\'fas\'edtott\'e1l \'e9
s hogy olyan j\'f3t cselekedjek, amellyel megel\'e9gedsz, \'e9s bocs\'e1ss be engem a Te k\'f6ny\'f6r\'fcleted r\'e9v\'e9n a j\'f3 szolg\'e1id k\'f6z\'e9!\'94
\par 
\par 20. \'c9s megszeml\'e9lte a madarakat \'e9s azt mondta: \'84Mi lelt engem, hogy nem l\'e1tom a b\'fabosbank\'e1t? Avagy a t\'e1voll\'e9v\'f5k k\'f6z\'f6tt van?
\par 21. Bizony, s\'falyos gy\'f6trelemmel s\'fajtom vagy lev\'e1gom \'f5t, hacsak nem hoz nekem nyilv\'e1nval\'f3 bizony\'edt\'e9kot [ments\'e9g\'fcl]!\'94
\par 22. \'c1m az nem maradt t\'e1vol sok\'e1ig \'e9s azt mondta: \'84Valami olyasmit tudtam meg, amit te nem tudt\'e1l, \'e9s S\'e1b\'e1b\'f3l bizonyoss\'e1got nyert h\'edrt hozok neked.
\par 23. Bizony, tal\'e1ltam egy n\'f5t, aki uralkodik f\'f6l\'f6tt\'fck, \'e9s mindenf\'e9le dolog adatott neki, \'e9s hatalmas tr\'f3nusa van.
\par 24. \'dagy tal\'e1ltam, hogy \'f5 \'e9s a n\'e9pe a Nap el\'f5tt borulnak le, Allah helyett. A s\'e1t\'e1n feld\'edsz\'edtette sz\'e1mukra a tetteiket \'e9s t\'e1vol tartotta \'f5ket az [Egyenes] \'datt\'f3l, \'fagy, hogy nem lelnek r\'e1 [az Igaz \'fa
tra].
\par 25. [A s\'e1t\'e1n r\'e1vette \'f5ket arra] hogy ne boruljanak le Allah el\'f5tt, aki el\'f5hozza azt, ami rejtve van az egekben \'e9s a f\'f6ld\'f6n, \'e9s tudja, amit elrejtetek \'e9s amit kinyilv\'e1n\'edtotok.
\par 26. Allah, rajta k\'edv\'fcl nincs m\'e1s isten, a fens\'e9ges Tr\'f3nus Ura!\'94
\par 27. Azt mondta [Salamon]: \'84Meg fogjuk n\'e9zni, vajon igazat mondt\'e1l-e, vagy a hazugok k\'f6z\'fcl val\'f3 vagy.
\par 28. Vidd el e levelemet \'e9s dobd le hozz\'e1juk! Azt\'e1n fordulj el t\'f5l\'fck \'e9s n\'e9zd meg, mit k\'fcldenek vissza v\'e1laszk\'e9nt!\'94
\par 
\par 29. Azt mondta [S\'e1ba kir\'e1lyn\'f5je]: \'84\'d3 ti, el\'f5kel\'f5k! Egy nemes lev\'e9l lett ledobva hozz\'e1m{\*\bkmkstart 30}{\*\bkmkend 30}.
\par 30. Bizony, Salamont\'f3l van \'e9s bizony \'edgy sz\'f3l: \'84Allah, a K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas nev\'e9ben.
\par 31. Ne fennh\'e9j\'e1zzatok velem! \'c9s \'fagy j\'f6jjetek hozz\'e1m, hogy al\'e1vetitek magatokat [Allahnak]!\'94
\par 32. Azt mondta [a kir\'e1lyn\'f5]: {\*\bkmkstart 33}{\*\bkmkend 33}\'84\'d3 ti, el\'f5kel\'f5k! Felvil\'e1gos\'edt\'e1st k\'e9rek t\'f5letek az \'e9n \'fcgyemben! Nem d\'f6nt\'f6k egy dologban sem, csak ha jelen vagytok.\'94
\par {\*\bkmkstart 34}{\*\bkmkend 34}33. Azt mondt\'e1k: \'84Mi er\'f5sek vagyunk \'e9s kem\'e9ny [a harci] er\'f5nk, \'e1m t\'e9ged illet a parancs. Fontold h\'e1t meg, mit parancsolsz!\'94
\par 34. Azt mondta [a kir\'e1lyn\'f5]: \'84Amikor a kir\'e1lyok bevonulnak egy v\'e1rosba, lerombolj\'e1k azt, \'e9s a tiszteletben \'e1ll\'f3 lak\'f3it megal\'e1zott\'e1 teszik. \'c9s ekk\'e9ppen cselekszenek.
\par 35. \'c9n bizony, egy aj\'e1nd\'e9kot k\'fcld\'f6k nekik \'e9s megn\'e9zem, milyen [v\'e1lasszal] t\'e9rnek vissza a k\'fcld\'f6ttek.\'94
\par 36. Majd amikor [a k\'fcld\'f6tt] Salamonhoz \'e9rkezett, azt mondta: \'84Vajon vagyonnal akartok b\'f5s\'e9gesen gondoskodni r\'f3lam? \'c1m, amit Allah adott nekem, az jobb ann\'e1l, mint amit nektek adott. De ti \'f6rvendeztek az aj\'e1nd\'e9kotoknak (
b\'fcszk\'e9lkedtek vele)!\'94
\par 37. [Azt mondta a k\'fcld\'f6ttnek:] \'84T\'e9rj vissza hozz\'e1juk! Mi bizony olyan katon\'e1kkal j\'f6v\'fcnk ellen\'fck, akikkel szemben nem k\'e9pesek ellen\'e1llni, \'e9s ki\'fbzz\'fck \'f5ket onnan megal\'e1zotts\'e1gukra, mik\'f6zben al\'e1
vetettek lesznek!\'94
\par 
\par 38. Azt mondta [Salamon]: \'84\'d3 ti, el\'f5kel\'f5k! Melyik\'f5t\'f6k hozza el nekem az \'f5 (a kir\'e1lyn\'f5) tr\'f3nus\'e1t, miel\'f5tt magukat al\'e1vetve j\'f6nn\'e9nek el hozz\'e1m?\'94
\par 39. Egy nagy erej\'fb dzsinn azt mondta: \'84\'c9n elhozom neked, miel\'f5tt m\'e9g fel\'e1lln\'e1l a helyedr\'f5l, \'e9s \'e9n bizony er\'f5s \'e9s megb\'edzhat\'f3 vagyok erre [a feladatra].\'94
\par 40. Azt mondta az, akinek tud\'e1sa volt az \'cdr\'e1sb\'f3l: \'84\'c9n elhozom neked azt egy szempillant\'e1sn\'e1l is kevesebb [id\'f5] alatt.\'94 Amikor [Salamon] maga el\'f5tt l\'e1tta let\'e9ve [a tr\'f3nt], azt mondta: \'84Ez Uram kegy\'e9b\'f5l val
\'f3, hogy pr\'f3b\'e1ra tegyen engem, vajon h\'e1l\'e1s vagyok-e, avagy h\'e1l\'e1tlan. \'c9s aki h\'e1l\'e1s, az \'f6nmaga haszn\'e1ra h\'e1l\'e1s. Aki pedig h\'e1l\'e1tlan, h\'e1t bizony az \'e9n Uram Gazdag, B\'f5kez\'fb.\'94
\par 41. Azt mondta [Salamon]: \'84Tegy\'e9tek felismerhetetlenn\'e9 sz\'e1m\'e1ra a tr\'f3nus\'e1t, hogy megn\'e9zz\'fck, vajon r\'e1lel-e (felismeri-e), avagy azok k\'f6z\'e9 tartozik, akik nem lelnek r\'e1!\'94
\par 42. Majd amikor [a kir\'e1lyn\'f5] elj\'f6tt, azt mondt\'e1k [neki]: \'84Ilyen-e a tr\'f3nusod?\'94 Azt mondta: \'84Mintha az lenne.\'94 [Azt mondta Salamon:] \'84\'c9s tud\'e1s adatott nek\'fcnk \'f5 el\'f5tte (kor\'e1bban, mint neki), \'e9
s mi [olyanok] voltunk, akik al\'e1vetik magukat [Allahnak].\'94
\par 43. \'c1m t\'e1vol tartotta \'f5t az, amit Allah helyett szolg\'e1lt. Bizony, egy hitetlen n\'e9pb\'f5l val\'f3 volt.
\par 44. Az mondatott neki: \'84L\'e9pj be a palot\'e1ba!\'94 Amikor megl\'e1tta azt, m\'e9ly v\'edznek gondolta \'e9s felfedte a l\'e1bsz\'e1r\'e1t. [Salamon] azt mondta: \'84Bizony, egy \'fcvegekkel kik\'f6vezett [padl\'f3j\'fa] palota.\'94 [A kir\'e1lyn\'f5
] azt mondta: \'84Uram! Igazs\'e1gtalans\'e1got k\'f6vettem el magam ellen, \'e9s al\'e1vetettem magamat Salamonnal egy\'fctt Allahnak, a teremtm\'e9nyek Ur\'e1nak!\'94
\par 
\par 45. \'c9s bizony elk\'fcldt\'fck Tam\'fadhoz testv\'e9r\'fcket, Sz\'e1lehot [azzal, hogy] \'84Szolg\'e1lj\'e1tok Allahot!\'94 \'c9s l\'e1m, \'f5k k\'e9t csoportra szakadva \'f6sszevitatkoztak.
\par 46. Azt mondta: \'84\'d3 n\'e9pem! Mi\'e9rt akarj\'e1tok siettetni a rosszat a j\'f3 el\'f5tt? Mi\'e9rt nem k\'e9rtek megbocs\'e1t\'e1st Allaht\'f3l}{\insrsid5968634\charrsid12015924 , h\'e1tha k\'f6ny\'f6r\'fcletre leltek?\'94}{\insrsid5968634 
\par {\*\bkmkstart 48}{\*\bkmkend 48}47. \'d5k azt mondt\'e1k: \'84Rossz el\'f5jelet l\'e1tunk benned, \'e9s azokban, akik veled vannak.\'94 Azt mondta: \'84A ti rossz el\'f5jeletek Allaht\'f3l van (az \'d5 elrendel\'e9s\'e9b\'f5l). De nem! Ti pr\'f3b\'e1
ra tett n\'e9p vagytok!\'94
\par 48. \'c9s volt a v\'e1rosban kilenc f\'e9rfib\'f5l \'e1ll\'f3 csoport, akik roml\'e1st okoztak a f\'f6ld\'f6n, \'e9s nem jav\'edtottak.
\par 49. Azt mondt\'e1k: \'84Esk\'fcdjetek meg egym\'e1s el\'f5tt Allahra, hogy }{\insrsid5968634\charrsid7434901 \'e9jszaka}{\insrsid5968634  megrohamozzuk \'f5t \'e9s a csal\'e1dj\'e1t! Azt\'e1n azt mondjuk a p\'e1rtfog\'f3j\'e1nak (legk\'f6zelebbi rokon\'e1
nak), hogy nem voltunk szemtan\'fai csal\'e1dja pusztul\'e1s\'e1nak, \'e9s mi bizony igazat mondunk.\'94
\par 50. \'c9s cselt sz\'f5ttek, \'e1m mi is cselt sz\'f5tt\'fcnk an\'e9lk\'fcl, hogy \'e9szrevett\'e9k volna.
\par 51. N\'e9zd h\'e1t meg, mi lett az \'f5 cselsz\'f6v\'e9s\'fck v\'e9ge! Bizony, elpuszt\'edtottuk \'f5ket \'e9s a n\'e9p\'fcket mindny\'e1jukat.
\par 52. \'c9s a h\'e1zaik, [amelyek] kihaltt\'e1 lettek, ami\'e9rt igazs\'e1gtalans\'e1got k\'f6vettek el. Bizony, ebben jel van egy olyan n\'e9pnek, akik rendelkeznek tud\'e1ssal.
\par 53. \'c9s megmentett\'fck azokat, akik hittek \'e9s istenf\'e9lelmet tan\'fas\'edtottak.
\par 
\par 54. \'c9s [eml\'edtsd meg] L\'f3tot, amikor azt mondta a n\'e9p\'e9nek: \'84Vajon a f\'f6rtelmes tettet k\'f6vetitek el, holott l\'e1ttok (tiszt\'e1ban vagytok gyal\'e1zatoss\'e1g\'e1val)?
\par 55. Vajon ti val\'f3ban a f\'e9rfiakhoz k\'f6zeledtek nemi v\'e1gyt\'f3l hajtva az asszonyok helyett?! De nem! Bizony, ti tudatlan n\'e9p vagytok!{\*\bkmkstart 56}{\*\bkmkend 56}\'94
\par 56. \'c9s nem volt a n\'e9p\'e9nek m\'e1s v\'e1lasza, csup\'e1n az, hogy \'edgy sz\'f3ltak: \'84\'dbzz\'e9tek ki L\'f3t csal\'e1dj\'e1t a telep\'fcl\'e9setekr\'f5l! \'d5k olyan emberek, akik \'fcgyelnek a tisztas\'e1gukra.\'94
\par 57. \'c9s megmentett\'fck \'f5t \'e9s a csal\'e1dj\'e1t, kiv\'e9ve a feles\'e9g\'e9t. [\'dagy] rendelt\'fck el, hogy azok k\'f6z\'fcl val\'f3 lesz, akik h\'e1tramaradnak.
\par 58. \'c9s [k\'f5-]es\'f5t z\'fad\'edtottunk r\'e1juk. \'c9s rossz azok es\'f5je, akik figyelmeztetve lettek!
\par 
\par 59. Mondd [\'f3 Mohamed]: \'84A h\'e1latelt dics\'e9ret Allahot illeti! \'c9s b\'e9kess\'e9g legyen az \'d5 szolg\'e1in, akiket kiv\'e1lasztott! Allah jobb-e, avagy az, amit \'f5k t\'e1rsistenk\'e9nt \'e1ll\'edtanak \'d5mell\'e9?\'94
\par 60. Avagy ki teremtette az egeket \'e9s a f\'f6ldet, \'e9s bocs\'e1tott le nektek vizet az \'e9gb\'f5l? Pomp\'e1s kerteket sarjasztottunk \'e1ltala, amelyeknek a f\'e1it ti magatok k\'e9ptelenek lettetek volna ki}{\insrsid5968634\charrsid7434901 
sarjasztani.}{\insrsid5968634  Vajon Allah mellett lenne egy m\'e1sik isten? Nem! \'d5k olyan emberek, akik elt\'e9rnek [az igaz \'fatt\'f3l].
\par 61. Avagy ki tette a f\'f6ldet tart\'f3zkod\'e1s [hely\'e9v\'e9], \'e9s tett foly\'f3kat a r\'e9szei k\'f6z\'e9, \'e9s helyezett r\'e1 szil\'e1rdan r\'f6gz\'edtett [hegyeket], \'e9s tett a k\'e9t tenger k\'f6z\'e9 g\'e1tat? Vajon Allah mellett lenne egy m
\'e1sik isten? De nem! A legt\'f6bben nem rendelkeznek tud\'e1ssal!
\par {\*\bkmkstart 63}{\*\bkmkend 63}62. Avagy ki v\'e1laszol a sz\'fcks\'e9gben l\'e9v\'f5nek, amikor foh\'e1szkodik Hozz\'e1, \'e9s ki h\'e1r\'edtja el a rosszat \'e9s tesz titeket ut\'f3dokk\'e1 a f\'f6ld\'f6n? Vajon Allah mellett lenne egy m\'e1
sik isten? Mily kev\'e9ss\'e9 okultok [az int\'e9sb\'f5l].
\par 63. Avagy ki vezet titeket igaz \'fatra a sz\'e1razf\'f6ld \'e9s a tenger s\'f6t\'e9ts\'e9g\'e9b\'f5l, \'e9s ki az, aki elk\'fcldi a szeleket \'f6r\'f6mh\'edr\'fcl a k\'f6ny\'f6r\'fclete (az es\'f5) el\'f5tt? Vajon Allah mellett lenne egy m\'e1
sik isten? Allah afelett van, amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [\'d5mell\'e9]!
\par 64. Avagy ki viszi v\'e9ghez a teremt\'e9st kezdetben, majd [a hal\'e1l ut\'e1n] megism\'e9teli azt, \'e9s ki l\'e1t el titeket az \'e9gb\'f5l \'e9s a f\'f6ldb\'f5l? Vajon Allah mellett lenne egy m\'e1sik isten? Mondd: \'84Adj\'e1tok ide a bizony\'edt\'e9
kotokat, }{\insrsid5968634\charrsid8207719 ha val\'f3ban}{\insrsid5968634  igazmond\'f3k vagytok!\'94
\par 65. Mondd: \'84Akik az egekben \'e9s a f\'f6ld\'f6n vannak, nem }{\insrsid5968634\charrsid7434901 tudj}{\insrsid5968634 \'e1k a rejtett dolgokat, Allah kiv\'e9tel\'e9vel.\'94 \'c9s \'e9szre sem veszik, hogy mikor t\'e1masztatnak fel.
\par 66. Nem! Teljess\'e9 fog v\'e1lni a tud\'e1suk a t\'falvil\'e1gr\'f3l [amikor l\'e1tj\'e1k azt]. Nem! \'d5k k\'e9ts\'e9gben vannak efel\'f5l. Nem! \'d5k vakok ezt illet\'f5en.
\par 
\par 67. \'c9s azt mondj\'e1k azok, akik hitetlenn\'e9 v\'e1ltak: \'84Amikor mi porr\'e1 lesz\'fcnk, \'e9s aty\'e1ink is, akkor vajon [\'e9l\'f5kk\'e9nt] lesz\'fcnk kihozva [a s\'edrokb\'f3l]?
\par 68. Bizony, ez m\'e1r kor\'e1bban meg lett \'edg\'e9rve nek\'fcnk \'e9s aty\'e1inknak. Nem m\'e1s ez, mint a hajdanvoltak legend\'e1i.\'94
\par 69. Mondd [\'f3 Mohamed]: \'84J\'e1rj\'e1tok be a f\'f6ldet, \'e9s n\'e9zz\'e9tek meg, milyen v\'e9gre jutottak a gonosztev\'f5k!\'94
\par 70. \'c9s ne l\'e9gy szomor\'fa miattuk, \'e9s ne szoruljon \'f6ssze [a sz\'edved] a cselsz\'f6v\'e9s\'fck miatt!
\par 71. \'c9s azt mondj\'e1k: \'84Mikor [k\'f6vetkezik be] ez az \'edg\'e9ret, }{\insrsid5968634\charrsid8207719 ha val\'f3ban}{\insrsid5968634  igazmond\'f3k vagytok?\'94
\par 72. Mondd: \'84Lehet, hogy m\'e1r szorosan a h\'e1tatok m\'f6g\'f6tt van egy r\'e9sze annak, amit siettetni akartok [a b\'fcntet\'e9sb\'f5l].\'94
\par 73. \'c9s bizony, az Urad kegyes az emberek ir\'e1nt, azonban a legt\'f6bbj\'fck nem h\'e1l\'e1s.
\par 74. \'c9s bizony, a te Urad tudja azt, hogy mit rejt a kebl\'fck \'e9s azt, hogy mit nyilv\'e1n\'edtanak ki.
\par {\*\bkmkstart 76}{\*\bkmkend 76}75. \'c9s nincs semmilyen rejt\'f5z\'f5 (ami rejtve van a teremtm\'e9nyek el\'f5tt) az \'e9gben \'e9s a f\'f6ld\'f6n, ami ne lenne [feljegyezve] egy nyilv\'e1nval\'f3 \'cdr\'e1sban.
\par 
\par 76. Bizony, ez a Kor\'e1n elbesz\'e9li Izrael gyermekeinek a legt\'f6bbj\'e9t annak, amiben \'f5k \'f6sszek\'fcl\'f6nb\'f6znek.
\par 77. \'c9s bizony, ez [a Kor\'e1n] \'fatmutat\'e1s \'e9s k\'f6ny\'f6r\'fclet a h\'edv\'f5knek!
\par 78. Bizony, a te Urad d\'f6nteni fog k\'f6z\'f6tt\'fck az \'d5 [igazs\'e1gos] \'edt\'e9let\'e9vel. \'c9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a Mindentud\'f3.
\par 79. Hagyatkozz h\'e1t Allahra! Bizony, te a nyilv\'e1nval\'f3 igazs\'e1gon vagy!
\par 80. Bizony, te nem teheted hallhat\'f3v\'e1 a halottaknak [az igazs\'e1got], \'e9s nem teheted hallhat\'f3v\'e1 a s\'fcketeknek se a h\'edv\'e1st, amikor \'f5k t\'e1vozva h\'e1tat ford\'edtanak.
\par 81. \'c9s te nem vezetheted ki a vakokat a t\'e9velyg\'e9sb\'f5l [az igaz \'fatra]. Nem teheted hallhat\'f3v\'e1 magadat, csak azoknak, akik hisznek a mi jeleinkben, \'e9s [\'edgy] \'f5k al\'e1vetik magukat [Allahnak].
\par 
\par 82. \'c9s amikor jogoss\'e1 v\'e1lik vel\'fck szemben [a b\'fcntet\'e9sr\'f5l sz\'f3l\'f3] sz\'f3, el\'f5hozunk nekik a f\'f6ldb\'f5l egy mozg\'f3 [\'e9l\'f5l\'e9nyt], amely besz\'e9lni fog hozz\'e1juk [azt mondv\'e1n], hogy az embereknek nem volt szil
\'e1rd bizonyoss\'e1guk a mi jeleinkr\'f5l.
\par 83. \'c9s azon a napon, amikor minden n\'e9pb\'f5l \'f6sszegy\'fbjt\'fcnk egy csoportot azokb\'f3l, akik meghazudtolt\'e1k a jeleinket, \'e9s sorba \'e1ll\'edttatnak [Allah el\'f5tt],
\par 84. Azt\'e1n, amikor el\'f5j\'f6nnek, Allah azt mondja: {\*\bkmkstart 85}{\*\bkmkend 85}\'84Vajon meghazudtolt\'e1tok a jeleimet, holott nem foghatt\'e1tok f\'f6l azt a tud\'e1sotokkal, vagy mi volt az, amit cselekedtetek?\'94
\par 85. \'c9s jogoss\'e1 v\'e1lik vel\'fck szemben [a b\'fcntet\'e9sr\'f5l sz\'f3l\'f3] sz\'f3 amiatt, hogy igazs\'e1gtalans\'e1got k\'f6vettek el, \'edgy \'f5k meg sem sz\'f3lalhatnak.
\par 86. Vajon nem gondolkodtak-e el azon, hogy mi arra rendelt\'fck az \'e9jszak\'e1t, hogy nyugalomra leljenek benne, \'e9s a nappalt arra, hogy l\'e1that\'f3v\'e1 tegye [a dolgokat]? Bizony, ebben jelek vannak egy olyan n\'e9p sz\'e1m\'e1ra, akik hisznek!

\par 87. \'c9s azon a napon, amikor megf\'favatik a k\'fcrt, akkor megijed mindenki, aki az egekben \'e9s aki a f\'f6ld\'f6n van, kiv\'e9ve azokat, akiket Allah akar [\'e9s mentes\'edt ett\'f5l]. \'c9s mindenki megal\'e1zkodva j\'f6n hozz\'e1.
\par 88. \'c9s l\'e1tni fogod a hegyeket, amelyeket mozdulatlannak gondolsz, amint elhaladnak a felh\'f5k halad\'e1s\'e1hoz hasonl\'f3an. Allah m\'fbve ez, aki minden dolgot t\'f6k\'e9letess\'e9 tett. Bizony, \'d5 j\'f3l ismeri azt, amit tesztek.
\par 
\par 89. Aki egy j\'f3 tettel j\'f6n majd el\'f5, annak m\'e9g jobb lesz a jutalma, \'e9s \'f5k azon a napon biztons\'e1gban lesznek az ijedts\'e9gt\'f5l.
\par 90. Akik pedig rossz tettel j\'f6nnek majd el\'f5, azok arcukkal vettetnek a [Pokol-]t\'fbzbe. Vajon [mi m\'e1s\'e9rt] kaptok fizets\'e9get, mint amit cselekedtetek?
\par 91. [Mondd, \'f3 Mohamed:] \'84Csup\'e1n azt a parancsot kaptam, hogy szolg\'e1ljam ennek a helys\'e9gnek (Mekk\'e1nak) az Ur\'e1t, aki tilalmasnak nyilv\'e1n\'edtotta. \'c9s minden dolog \'d5t illeti. \'c9s parancsot kaptam arra, hogy azok k\'f6z\'e9
 tartozzak, akik al\'e1vetik magukat [Allahnak],
\par 92. \'c9s hogy recit\'e1ljam a Kor\'e1nt!\'94 \'c9s aki az igaz \'fatra vezettetik, az a maga sz\'e1m\'e1ra vezettetik. Aki pedig t\'e9velyeg, annak mondd: \'84\'c9n csup\'e1n a figyelmeztet\'f5k k\'f6z\'fcl val\'f3 vagyok!\'94
\par 93. \'c9s mondd: \'84A h\'e1latelt dics\'e9ret Allahot illeti.\'94 \'d5 meg fogja mutatni nektek a jeleit \'e9s ti megismeritek azokat. \'c9s az Urad nem hagyja figyelmen k\'edv\'fcl azt, amit cselekszetek.\'94
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid5968634 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid5968634 \page }{
\f0\fs24\insrsid5968634\charrsid5968634 28. sz\'fara \endash  Az elbesz\'e9l\'e9sek}{\fs24\insrsid5968634\charrsid8019449 
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid5968634 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid5968634 {\insrsid5968634 1. Ta-sz\'edn-m\'edm. 
\par 2. Ezek a nyilv\'e1nval\'f3 \'cdr\'e1s (a Kor\'e1n) jelei.
\par 3. Elrecit\'e1lunk (elbesz\'e9l\'fcnk) neked M\'f3zes \'e9s a F\'e1ra\'f3 h\'edreib\'f5l az igazs\'e1gnak megfelel\'f5en, egy olyan n\'e9pnek, akik hisznek.
\par 4. Bizony, a F\'e1ra\'f3 fennh\'e9j\'e1zott a f\'f6ld\'f6n, \'e9s annak lak\'f3it [ellens\'e9ges] p\'e1rtokk\'e1 osztotta, elnyomott egy csoportot k\'f6z\'fcl\'fck, lem\'e9sz\'e1rolta a fiaikat \'e9s \'e9letben hagyta az asszonyaikat. Bizony, \'f5 a roml
\'e1st okoz\'f3k k\'f6z\'fcl val\'f3 volt.
\par 5. \'c9s kegyeinkb\'f5l r\'e9szes\'edteni akarjuk azokat, akik elnyom\'e1st szenvedtek a f\'f6ld\'f6n, \'e9s vezet\'f5kk\'e9 \'e9s \'f6r\'f6k\'f6s\'f6kk\'e9 [akarjuk] tenni \'f5ket.
\par 6. \'c9s hatalmat [akartunk] adni nekik a f\'f6ld\'f6n, \'e9s megmutatni a F\'e1ra\'f3nak \'e9s H\'e1m\'e1nnak \'e9s kettej\'fck katon\'e1inak azt, amit\'f5l \'f5k \'f3vakodtak.
\par 
\par 7. \'c9s azt sugalltuk M\'f3zes anyj\'e1nak: \'84Szoptasd \'f5t, ha pedig f\'e9lten\'e9d, akkor vesd \'f5t a folyamba, \'e9s ne f\'e9lj, \'e9s ne is szomorkodj! Bizony, mi vissza fogjuk adni \'f5t neked \'e9s a k\'fcld\'f6ttek k\'f6z\'fcl val\'f3v\'e1
 tessz\'fck.\'94
\par 8. \'c9s felvette \'f5t a F\'e1ra\'f3 h\'e1zn\'e9pe, hogy ellens\'e9g\'fckk\'e9 \'e9s szomor\'fas\'e1gukk\'e1 legyen. Bizony, a F\'e1ra\'f3 \'e9s H\'e1m\'e1n, \'e9s kettej\'fck katon\'e1i v\'e9tkesek voltak.
\par 9. \'c9s a F\'e1ra\'f3 feles\'e9ge azt mondta: \'84Szemgy\'f6ny\'f6rk\'f6dtet\'f5 (\'f6r\'f6m forr\'e1sa) lesz majd nekem \'e9s neked! Ne \'f6lj\'e9tek meg! H\'e1tha hasznunkra v\'e1lik, vagy gyermek\'fcnkk\'e9 fogadjuk \'f5t!\'94, \'e9s \'e9szre sem vett
\'e9k [a d\'f6nt\'e9s\'fck k\'f6vetkezm\'e9ny\'e9t]!
\par 10. \'c9s M\'f3zes anyj\'e1nak \'fcress\'e9 v\'e1lt a sz\'edve. Majdnem felfedte [M\'f3zes kil\'e9t\'e9t], ha Mi nem er\'f5s\'edtett\'fck volna meg a sz\'edv\'e9t, hogy a h\'edv\'f5k k\'f6z\'fcl val\'f3 legyen.
\par 11. \'c9s azt mondta [M\'f3zes] n\'f5v\'e9r\'e9nek: \'84Eredj a nyom\'e1ba!\'94 Az pedig t\'e1volr\'f3l n\'e9zte \'f5t an\'e9lk\'fcl, hogy \'e9szrevenn\'e9k.
\par 12. \'c9s megtiltottuk sz\'e1m\'e1ra kor\'e1bban a szoptat\'f3dajk\'e1kat. Azt\'e1n \'f5 (a n\'f5v\'e9re) azt mondta [a F\'e1ra\'f3nak]: \'84Vajon elvezesselek titeket egy csal\'e1dhoz, amely gondoz\'e1s\'e1ba venn\'e9 nektek, \'e9s }{
\insrsid5968634\charrsid5636168 amely \'f5szint\'e9n [k\'e9szs\'e9ggel]}{\insrsid5968634  b\'e1nna vele?\'94
\par {\*\bkmkstart 14}{\*\bkmkend 14}13. \'cdgy adtuk vissza \'f5t az anyj\'e1nak, hogy gy\'f6ny\'f6rk\'f6dj\'f6n a szeme (\'f6r\'f6m\'f6t leljen) \'e9s ne szomorkodjon, \'e9s hogy megtudja: Allah \'edg\'e9rete igaz. A legt\'f6bbj\'fc
k azonban nem rendelkezik tud\'e1ssal.
\par 
\par 14. \'c9s miut\'e1n el\'e9rte az \'e9rett kort \'e9s ereje telj\'e9t, b\'f6lcsess\'e9get \'e9s tud\'e1st adtunk neki. \'c9s Mi ekk\'e9ppen adjuk meg a fizets\'e9g\'e9t }{\insrsid5968634\charrsid5636168 a j\'f3tev\'f5knek.}{\insrsid5968634 
\par 15. \'c9s [M\'f3zes] bel\'e9pett a v\'e1rosba [akkor], amikor a lak\'f3i nem figyeltek, \'e9s k\'e9t f\'e9rfit tal\'e1lt ott, akik egym\'e1ssal tusakodtak. Az egyik az \'f5 p\'e1rtj\'e1hoz, a m\'e1sik az ellens\'e9g\'e9hez tartozott. Az, aki az \'f5 p\'e1
rtj\'e1hoz tartozott, seg\'edts\'e9g\'fcl h\'edvta \'f5t az ellen, aki az ellens\'e9g\'e9hez tartozott. M\'f3zes pedig meg\'fct\'f6tte az \'f6kl\'e9vel, s v\'e9gzett vele. Azt mondta: \'84Ez a s\'e1t\'e1n cselekedete! Bizony, \'f5 egy t\'e9velyg\'e9
sbe viv\'f5 nyilv\'e1nval\'f3 ellens\'e9g.\'94
\par 16. Azt mondta [M\'f3zes]: \'84Uram! Bizony, \'f6nmagam ellen k\'f6vettem el igazs\'e1gtalans\'e1got, bocs\'e1ss h\'e1t meg nekem!\'94 \'c9s \'d5 megbocs\'e1tott neki. Bizony, \'d5 a Megbocs\'e1t\'f3, az Irgalmas.{\*\bkmkstart 17}{\*\bkmkend 17}
\par 17. Azt mondta [M\'f3zes]: \'84Uram! Ami\'e9rt j\'f3t\'e9tem\'e9nyekben r\'e9szes\'edtett\'e9l, nem leszek soha seg\'edt\'f5je a gonosztev\'f5knek!\'94
\par 18. A v\'e1rosban pedig f\'e9lelem lett \'farr\'e1 rajta, \'e9s el\'f5vigy\'e1zatosan [tekingetett k\'f6r\'fcl]. \'c9s \'edme, az, aki tegnap seg\'edts\'e9get k\'e9rt t\'f5le, ki\'e1ltva k\'e9r t\'f5le [ism\'e9t] seg\'edts\'e9get. M\'f3
zes azt mondta neki: \'84Bizony, te nyilv\'e1nval\'f3 t\'e9v\'faton vagy!\'94
\par 19. Amikor azonban csap\'e1st akart m\'e9rni arra, aki mindkett\'f5j\'fck ellens\'e9ge volt, az azt mondta: \'84M\'f3zes! Vajon engem is meg akarsz \'f6lni, ahogy meg\'f6lt\'e9l valakit tegnap? Nem akarsz m\'e1st, mint hatalmaskod\'f3 lenni a }{
\insrsid5968634\charrsid9243560 f\'f6ld\'f6n \'e9s \'e9s nem akarsz a javul\'e1st hoz\'f3k k\'f6z\'e9 tartozni.\'94}{\insrsid5968634 
\par 
\par 20. \'c9s [ekkor] sietve j\'f6tt egy f\'e9rfi a v\'e1ros legt\'e1volabbi r\'e9sz\'e9b\'f5l, [\'e9s] azt mondta: \'84\'d3 M\'f3zes! Bizony, az el\'f5kel\'f5k arr\'f3l tan\'e1cskoznak veled kapcsolatban, hogy meg\'f6ljenek t\'e9ged. Menj h\'e1t el [a v\'e1
rosb\'f3l]! Bizony, \'e9n az \'f5szinte tan\'e1csad\'f3id }{\insrsid5968634\charrsid11013590 k\'f6z\'fcl val\'f3 vagyok}{\insrsid5968634 !\'94
\par 21. Kiment h\'e1t onnan, f\'e9lve, el\'f5vigy\'e1zatosan [k\'f6r\'fcltekingetve]. Azt mondta: \'84Uram! Ments meg engem az igazs\'e1gtalan n\'e9pt\'f5l!\'94
\par 
\par 22. \'c9s miut\'e1n Midi\'e1n fel\'e9 vette \'fatj\'e1t, azt mondta: \'84Tal\'e1n az Uram az Egyenes \'fatra vezet engem!\'94
\par 23. \'c9s miut\'e1n el\'e9rkezett Midi\'e1n [itat\'f3]viz\'e9hez, egy emberekb\'f5l \'e1ll\'f3 csoportot tal\'e1lt ott, akik [\'e1llataikat] itatt\'e1k. \'c9s nem messze t\'f5l\'fck k\'e9t n\'f5t tal\'e1lt, akik visszatartott\'e1k [\'e1llataikat az itat
\'f3helyt\'f5l]. Azt mondta: \'84Milyen s\'falyos \'fcgy [vitt r\'e1 arra titeket, hogy ne itass\'e1tok az \'e1llataitokat]?\'94 Azt mondt\'e1k: \'84Nem itatunk addig, am\'edg a p\'e1sztorok el nem mennek, ap\'e1nk pedig egy hajlott kor\'fa aggasty\'e1n.
\'94
\par 24. \'d5 [M\'f3zes] megitatta kettej\'fcknek [az \'e1llataikat]. Azt\'e1n f\'e9lrevonult az \'e1rny\'e9kba \'e9s azt mondta: \'84Uram! Bizony r\'e1 vagyok szorulva b\'e1rmi j\'f3ra, amit lebocs\'e1tasz nekem!\'94
\par 25. \'c9s }{\insrsid5968634\charrsid9243560 sz\'e9gyenl\'f5sen}{\insrsid5968634  j\'f6tt oda hozz\'e1 az egyik a k\'e9t n\'f5 k\'f6z\'fcl \'e9s azt mondta: \'84Bizony, az ap\'e1m h\'edv t\'e9ged, hogy megadja neked a fizets\'e9get az\'e9rt, mert itatt\'e1
l nek\'fcnk.\'94 Miut\'e1n [M\'f3zes] elj\'f6tt hozz\'e1 \'e9s elbesz\'e9lte neki a t\'f6rt\'e9netet, a [n\'f5k apja] azt mondta neki: \'84Ne f\'e9lj! Megmenek\'fclt\'e9l az igazs\'e1gtalan n\'e9pt\'f5l.\'94
\par 26. Azt mondta az egyik a k\'e9t n\'f5 k\'f6z\'fcl: \'84Ap\'e1csk\'e1m! B\'e9reld fel \'f5t! Bizony, a legjobb akit felb\'e9relhetsz az, aki er\'f5s \'e9s megb\'edzhat\'f3!\'94
\par 27. Azt mondta: \'84Hozz\'e1d akarom adni feles\'e9g\'fcl egyik le\'e1nyomat, azzal a felt\'e9tellel, hogy hozz\'e1m szeg\'f5dsz b\'e9resnek nyolc esztendeig, de ha kiteljes\'edted t\'edzre, az t\'f5led val\'f3 [j\'f3t\'e9konys\'e1
g] lesz, de nem akarom, hogy neh\'e9zs\'e9ggel terheljelek. Ha Allah \'fagy akarja, a j\'f3 emberek k\'f6z\'fcl val\'f3nak fogsz tal\'e1lni engem.\'94
\par 28. Azt mondta [M\'f3zes]: \'84Ez legyen [az egyezs\'e9g] k\'f6ztem \'e9s k\'f6z\'f6tted! B\'e1rmelyiket is t\'f6lt\'f6m ki a k\'e9t hat\'e1rid\'f5 k\'f6z\'fcl, nem \'e9rhet engem t\'falkap\'e1s (m\'e9lt\'e1nytalans\'e1g). \'c9s Allah a fel\'fcgyel\'f5
je annak, amit mondunk!\'94
\par 
\par 29. Miut\'e1n pedig M\'f3zes teljes\'edtette a hat\'e1rid\'f5t \'e9s a h\'e1za n\'e9p\'e9vel \'fatra kelt, t\'fczet l\'e1tott tiszt\'e1n a [S\'ednai] hegy fel\'f5l. Azt mondta a h\'e1za n\'e9p\'e9nek: \'84Maradjatok [itt]! \'c9n bizony t\'fczet l\'e1
ttam. H\'e1tha [tudok] hozni nektek onnan valamilyen h\'edrt, vagy l\'e1ngol\'f3 f\'e1kly\'e1t az\'e9rt, hogy felmelegedjetek.\'94
\par 30. Miut\'e1n pedig oda\'e9rt, megsz\'f3l\'edttatott a v\'f6lgy jobb oldala fel\'f5l, az \'e1ldott ter\'fcleten, a fa mell\'f5l: \'84\'d3 M\'f3zes! Bizony, \'e9n Allah vagyok, a teremtm\'e9nyek Ura!\'94
\par 31. \'c9s [Allah azt mondta neki]: \'84Dobd el a botodat!\'94 \'c9s miut\'e1n pedig l\'e1tta mozogni, mintha egy nagy k\'edgy\'f3 lenne, h\'e1tat ford\'edtott t\'e1vozva, \'e9s nem fordult vissza. [Allah azt mondta:] \'84\'d3 M\'f3zes! Gyere k\'f6zelebb 
\'e9s ne f\'e9lj! Bizony, te a biztons\'e1gban l\'e9v\'f5k k\'f6z\'fcl val\'f3 vagy!
\par 32. Tedd be a kezedet a ruhakiv\'e1g\'e1sodba, ragyog\'f3 feh\'e9ren j\'f6n el\'f5, rossz (betegs\'e9g) n\'e9lk\'fcl! \'c9s szor\'edtsd magadhoz a karodat, ha rettegn\'e9l! Ez k\'e9t bizony\'edt\'e9k Uradt\'f3l a F\'e1ra\'f3nak \'e9s az el\'f5kel\'f5
inek. Bizony, \'f5k egy engedetlen n\'e9p!\'94
\par 
\par 33. Azt mondta: \'84Uram! Meg\'f6ltem k\'f6z\'fcl\'fck egy embert, f\'e9lek h\'e1t, hogy meg\'f6lnek [emiatt].\'94
\par 34. \'c9s a fiv\'e9rem, \'c1ron, \'e9rthet\'f5bben besz\'e9l, mint \'e9n. K\'fcldd h\'e1t el velem, hogy meger\'f5s\'edtse az igazamat! Bizony, \'e9n f\'e9lek, hogy meghazudtolnak.\'94
\par 35. Azt mondta [Allah]: \'84Meger\'f5s\'edt\'fcnk t\'e9ged a testv\'e9red \'e1ltal, \'e9s hatalmat adunk nektek, \'e9s nem \'e9rhetnek el hozz\'e1tok (hogy legy\'f5zzenek titeket). [Menjetek h\'e1t] a jeleinkkel! Ti ketten \'e9s akik k\'f6vetn
ek titeket, [ti] vagytok a gy\'f5zelmet arat\'f3k.\'94
\par 
\par 36. Miut\'e1n pedig M\'f3zes elj\'f6tt hozz\'e1juk a jeleinkkel nyilv\'e1nval\'f3 bizony\'edt\'e9kk\'e9nt, azt mondt\'e1k: \'84Ez nem m\'e1s, mint kital\'e1lt var\'e1zslat. Nem hallottunk ilyesmir\'f5l a hajdanvolt aty\'e1inkn\'e1l.\'94
\par 37. \'c9s azt mondta M\'f3zes: \'84Az \'e9n Uram jobban tudja, hogy ki j\'f6n el az \'fatmutat\'e1ssal T\'f5le \'e9s ki\'e9 lesz a v\'e9gs\'f5 lakhely. Bizony, nem boldogulnak az igazs\'e1gtalanok!\'94
\par 38. \'c9s a F\'e1ra\'f3 azt mondta: \'84Ti el\'f5kel\'f5k! Nem ismerek nektek m\'e1s istent rajtam k\'edv\'fcl. \'c9gess h\'e1t nekem agyagot, \'f3 H\'e1m\'e1n, \'e9s emelj nekem tornyot, hogy r\'e1tekinthessek M\'f3zes isten\'e9re. \'c9s, bizony, \'fa
gy v\'e9lem, hogy \'f5 a hazugok k\'f6z\'fcl val\'f3!\'94
\par 39. \'c9s felfuvalkodtak, \'f5 \'e9s a katon\'e1i, jogtalanul a f\'f6ld\'f6n, \'e9s \'fagy v\'e9lt\'e9k, hogy \'f5k nem lesznek Hozz\'e1nk visszavitetve.
\par 40. \'c9s megragadtuk \'f5t \'e9s a katon\'e1it \'e9s a tengerbe vetett\'fck \'f5ket. N\'e9zd h\'e1t meg, milyen v\'e9gre jutottak az igazs\'e1gtalanok!
\par 41. \'c9s olyan vezet\'f5kk\'e9 tett\'fck \'f5ket, akik a [Pokol-]t\'fbzbe h\'edvnak. \'c9s a Felt\'e1mad\'e1s Napj\'e1n nem lesznek megseg\'edtve.
\par 42. \'c9s \'e1tkot k\'fcldt\'fcnk a nyomukba az evil\'e1gon, a Felt\'e1mad\'e1s Napj\'e1n pedig a megcs\'fafultak k\'f6z\'fcl val\'f3k lesznek.
\par 43. \'c9s bizony odaadtuk M\'f3zesnek az \'cdr\'e1st \endash  miut\'e1n elpuszt\'edtottuk az el\'f5z\'f5 nemzed\'e9keket \endash  tiszt\'e1nl\'e1t\'e1st ad\'f3 bizony\'edt\'e9kokk\'e9nt az embereknek, \'e9s \'fatmutat\'e1sk\'e9nt \'e9s k\'f6ny\'f6r\'fc
letk\'e9nt, h\'e1tha }{\insrsid5968634\charrsid9243560 okulnak [az int\'e9sb\'f5l].}{\insrsid5968634 
\par 
\par 44. \'c9s te [\'f3 Mohamed] nem volt\'e1l [a hegy] nyugati oldal\'e1n, amikor elrendelt\'fck M\'f3zesnek a parancsot [az \'fczenet \'e1tad\'e1s\'e1ra a F\'e1ra\'f3nak]. \'c9s nem volt\'e1l [szemtan\'fa] a szemtan\'fak k\'f6z\'f6tt.
\par 45. \'c9s Mi azonban nemzed\'e9keket hoztunk l\'e9tre [M\'f3zes ut\'e1n], \'e9s hossz\'fa id\'f5 telt el felett\'fck. \'c9s te nem lakozt\'e1l Midi\'e1n lak\'f3i k\'f6z\'f6tt, recit\'e1lva nekik a jeleinket. Azonban Mi voltunk a k\'fcld\'f5i [a k\'fcld
\'f6tteknek].
\par 46. \'c9s te nem volt\'e1l a [S\'ednai] hegy oldal\'e1n, amikor megsz\'f3l\'edtottuk [M\'f3zest]. \'c1m Uradt\'f3l val\'f3 k\'f6ny\'f6r\'fcletk\'e9nt [k\'fcldt\'fcnk el t\'e9ged], hogy egy olyan n\'e9pet figyelmeztess, amelyhez el\'f5tted m\'e9g nem j\'f6
tt k\'fcld\'f6tt}{\insrsid5968634\charrsid9243560 , h\'e1tha okulnak [az int\'e9sb\'f5l].}{\insrsid5968634 
\par 
\par 47. \'c9s ha nem [k\'fcldt\'fcnk volna el t\'e9ged, \'f3 Mohamed], \'e9s csap\'e1s s\'fajtan\'e1 \'f5ket az\'e9rt, amit a kez\'fck k\'f6vetett el, akkor azt mondhatn\'e1k: \'84Urunk! Mi\'e9rt nem k\'fcldt\'e9l hozz\'e1nk k\'fcld\'f6ttet, hogy k\'f6vethess
\'fck a jeleidet, \'e9s a h\'edv\'f5k k\'f6z\'fcl val\'f3k legy\'fcnk?\'94
\par 48. \'c9s miut\'e1n elj\'f6tt hozz\'e1juk az igazs\'e1g T\'f5l\'fcnk, azt mondt\'e1k: \'84Mi\'e9rt nem adatott neki olyan, mint ami M\'f3zesnek adatott?\'94 H\'e1t vajon nem v\'e1ltak hitetlenn\'e9 azzal szemben, ami M\'f3zesnek adatott kor\'e1
bban? Azt mondt\'e1k: \'84K\'e9t var\'e1zslat, amelyek egym\'e1st seg\'edtik [a b\'fbnben]!\'94 \'c9s azt mondt\'e1k: \'84Bizony, mi mindegyikkel szemben hitetlenek vagyunk.\'94
\par 49. Mondd [\'f3 Mohamed]: \'84Hozzatok h\'e1t egy \'cdr\'e1st Allaht\'f3l, amely e kett\'f5n\'e9l (a Kor\'e1nn\'e1l \'e9s a T\'f3r\'e1n\'e1l) jobb \'fatmutat\'e1st ad, hogy azt k\'f6vethessem, }{\insrsid5968634\charrsid16342199 ha val\'f3ban}{
\insrsid5968634  igazmond\'f3k vagytok!\'94
\par 50. \'c1m ha nem engedelmeskednek neked, akkor tudd meg, hogy csup\'e1n a k\'e9nyeiket k\'f6vetik. \'c9s ki t\'e9velyg\'f5bb ann\'e1l, mint az, aki Allaht\'f3l val\'f3 \'fatmutat\'e1s n\'e9lk\'fcl a saj\'e1t k\'e9ny\'e9t k\'f6
veti? Bizony, Allah nem vezeti [igaz \'fatra] az igazs\'e1gtalan n\'e9pet.
\par 
\par 51. \'c9s bizony [egym\'e1st k\'f6vet\'f5en, r\'e9szenk\'e9nt] juttattuk el hozz\'e1juk a Sz\'f3t (a Kor\'e1nt), h\'e1tha }{\insrsid5968634\charrsid9243560 okulnak [az int\'e9sb\'f5l].}{\insrsid5968634 
\par {\*\bkmkstart 53}{\*\bkmkend 53}52. Akiknek odaadtuk az \'cdr\'e1st ez (a Kor\'e1n) el\'f5tt, azok hisznek benne.
\par 53. \'c9s ha recit\'e1ltatik nekik, azt mondj\'e1k: \'84Hisz\'fcnk benne. Ez bizony az Igazs\'e1g a mi Urunkt\'f3l. Bizony, mi m\'e1r el\'f5tte [magunkat Allahnak] al\'e1vet\'f5k voltunk.\'94
\par {\*\bkmkstart 54}{\*\bkmkend 54}54. \'d5k k\'e9tszer kapj\'e1k meg a jutalmukat, ami\'e9rt t\'fcrelmesek voltak \'e9s [ami\'e9rt] a rosszat j\'f3val h\'e1r\'edtott\'e1k el, \'e9s adakoztak abb\'f3l, amivel ell\'e1ttuk \'f5ket.
\par 55. \'c9s ha felesleges besz\'e9det hallanak, elfordulnak att\'f3l \'e9s azt mondj\'e1k: \'84A mi cselekedeteink\'e9rt a mi\'e9nk [a felel\'f5ss\'e9g], \'e9s a ti cselekedeitek\'e9rt pedig ti\'e9tek [a felel\'f5ss\'e9g]. B\'e9kess\'e9g veletek! Nem v\'e1
gyakozunk a tudatlanok [t\'e1rsas\'e1g\'e1ra]!\'94
\par 56. Bizony, te (\'f3 Mohamed) nem vezeted az igaz \'fatra azt, akit szeretn\'e9l, hanem Allah az, aki az [igaz] \'fatra vezeti azt, akit akar, \'e9s \'d5 tudja a legjobban, hogy kik leltek az [igaz] \'fatra.
\par 
\par 57. \'c9s azt mondj\'e1k: \'84Ha veled egy\'fctt k\'f6vetn\'e9nk az \'fatmutat\'e1st, elragadtatn\'e1nk a f\'f6ld\'fcnkr\'f5l!\'94 H\'e1t vajon nem adtunk nekik hatalmat egy biztons\'e1gos, szent f\'f6ld felett, ahova mindenf\'e9le gy\'fcm\'f6
lcs hordatik T\'f5l\'fcnk sz\'e1rmaz\'f3 ell\'e1t\'e1sk\'e9nt? A legt\'f6bbj\'fck azonban nem rendelkezik tud\'e1ssal.
\par 58. \'c9s h\'e1ny olyan v\'e1rost puszt\'edtottunk el, amelynek lak\'f3i hivalkodtak a meg\'e9lhet\'e9s\'fck eszk\'f6zeivel. H\'e1t ezek az \'f5 lakhelyeik, amelyeket nem laktak be \'f5ut\'e1nuk, csup\'e1n kevesen. \'c9s bizony, mi vagyunk az \'f6r\'f6kl
\'f5k.
\par 59. \'c9s Urad soha nem puszt\'edtotta volna el a telep\'fcl\'e9seket an\'e9lk\'fcl, hogy ne k\'fcld\'f6tt volna az anyav\'e1rosukba k\'fcld\'f6ttet, aki recit\'e1lja nekik a jeleinket. \'c9s nem puszt\'edtjuk el a telep\'fcl\'e9
seket, csakis akkor, ha a lak\'f3ik igazs\'e1gtalanok.
\par 
\par 60. \'c9s b\'e1rmi adatott nektek, az csup\'e1n az evil\'e1gi \'e9let [muland\'f3] \'e9lvezete \'e9s d\'edszei. \'c1m, ami Allahn\'e1l van, az jobb \'e9s maradand\'f3bb! Vajon h\'e1t nem \'e9ltek az eszetekkel?
\par 61. Vajon az, akinek sz\'e9p \'edg\'e9retet tett\'fcnk - amelyet \'f5 [beteljes\'fcltnek] fog tal\'e1lni \endash  olyan, mint az, akinek az evil\'e1gi \'e9let [muland\'f3] \'e9lvezet\'e9t adtuk, azt\'e1n a Felt\'e1mad\'e1s napj\'e1n azok k\'f6z\'fcl val
\'f3 lesz, akit el\'f5vezetnek?
\par 62. \'c9s azon a napon, amikor [Allah] sz\'f3l\'edtani fogja \'f5ket \'e9s azt mondja: \'84Hol vannak azok, akikr\'f5l azt \'e1ll\'edtott\'e1tok, hogy \'f5k t\'e1rsistenek [Mellettem]?\'94
\par 63. [Akkor] azt fogj\'e1k mondani azok, akikkel szemben jogoss\'e1 v\'e1lt a [b\'fcntet\'e9sr\'f5l kimondott] sz\'f3: \'84Urunk! \'cdme, ezek azok, akiket t\'e9v\'fatra vitt\'fcnk. \'dagy vitt\'fck \'f5ket t\'e9v\'fatra, ahogy mi magunk is t\'e9v\'faton j
\'e1rtunk. Mi elhat\'e1rol\'f3dunk [att\'f3l, hogy p\'e1rtfogoljuk \'f5ket] El\'f5tted. \'d5k nem minket szolg\'e1ltak!\'94
\par 64. \'c9s az lesz mondva [a hitetleneknek]: \'84Foh\'e1szkodjatok [azokhoz, akiket Allah mell\'e9] t\'e1rsisteneknek \'e1ll\'edtottatok!\'94 \'c9s foh\'e1szkodni fognak hozz\'e1juk, \'e1m nem fognak [azok] v\'e1laszt adni nekik. \'c9s megl\'e1tj\'e1
k majd a gy\'f6trelmet, [\'e9s azt \'f3hajtj\'e1k:] \'84b\'e1rcsak az igaz }{\insrsid5968634\charrsid16342199 \'fatra lelt\'fcnk}{\insrsid5968634  volna!\'94
\par 65. \'c9s azon a napon, amikor [Allah] sz\'f3l\'edtja \'f5ket, \'e9s azt mondja: \'84Mit feleltetek a k\'fcld\'f6tteknek?\'94
\par 66. Elhom\'e1lyosulnak el\'f5tt\'fck a h\'edrek (az \'e9rvek) azon a napon, ez\'e9rt \'f5k nem k\'e9rdezgethetik egym\'e1st [a v\'e1laszr\'f3l].
\par 67. Ami pedig azt illeti, aki b\'fbnb\'e1natot tan\'fas\'edt, hisz \'e9s j\'f3t cselekszik, h\'e1t az tal\'e1n azok k\'f6z\'fcl val\'f3 lesz, akik boldogulnak.{\*\bkmkstart 68}{\*\bkmkend 68}
\par 
\par 68. \'c9s az Urad azt teremt, amit akar, \'e9s [azt] v\'e1laszt [k\'fcld\'f6tt\'e9v\'e9, akit akar]. Nem lehet nekik v\'e1laszt\'e1suk [abban, amiben Allah m\'e1r d\'f6nt\'f6tt]. Magasztaltass\'e9k Allah! \'c9s [\'d5] afelett van, ami t\'e1rsistent \'e1ll
\'edtanak [\'d5mell\'e9].
\par 69. \'c9s a te Urad tudja azt, hogy mit rejt a kebl\'fck (a sz\'edv\'fck) \'e9s azt, hogy mit nyilv\'e1n\'edtanak ki.
\par 70. \'c9s \'d5 Allah, nincs m\'e1s [jogosan im\'e1dhat\'f3] isten rajta k\'edv\'fcl. \'d5t illeti a h\'e1latelt dics\'e9ret az evil\'e1gon \'e9s a t\'falvil\'e1gon, \'e9s \'d5t illeti az \'edt\'e9lkez\'e9s, \'e9s Hozz\'e1 lesztek visszavitetve.
\par 71. Mondd [\'f3 Mohamed]: \'84Vajon mit gondoltok, ha Allah \'f6r\'f6kk\'e9val\'f3v\'e1 tenn\'e9 nektek az \'e9jszak\'e1t a Felt\'e1mad\'e1s Napj\'e1ig, vajon Allahon k\'edv\'fcl melyik }{\insrsid5968634\charrsid9243560 isten hozna nektek vil\'e1goss\'e1
got? H\'e1t vajon nem hallotok?
\par 72. Mondd [\'f3 Mohamed]: {\*\bkmkstart 73}{\*\bkmkend 73}\'84Vajon mit gondoltok, ha Allah \'f6r\'f6kk\'e9val\'f3v\'e1 tenn\'e9 nektek a nappalt a Felt\'e1mad\'e1s Napj\'e1ig, vajon Allahon k\'edv\'fcl melyik isten hozna nektek \'e9jszak\'e1
t, amelyben megpihenhettek? H\'e1t vajon nem l\'e1ttok?\'94
\par 73. \'c9s a k\'f6ny\'f6r\'fclet\'e9b\'f5l rendelte nektek az \'e9jszak\'e1t \'e9s a nappalt, hogy abban nyugalomra leljetek, \'e9s hogy a kegye ut\'e1n \'e1h\'edtozzatok, \'e9s h}{\insrsid5968634 \'e1tha }{\insrsid5968634\charrsid9243560 h\'e1l\'e1sak le}
{\insrsid5968634 sztek}{\insrsid5968634\charrsid9243560 .}{\insrsid5968634 
\par 74. \'c9s azon a napon, amikor [Allah] sz\'f3l\'edtani fogja \'f5ket \'e9s azt mondja: \'84Hol vannak azok, akikr\'f5l azt \'e1ll\'edtott\'e1tok, hogy \'f5k a t\'e1rsistenek [Mellettem]?\'94
\par 75. \'c9s minden k\'f6z\'f6ss\'e9gb\'f5l egy tan\'fat (k\'fcld\'f6ttet) vesz\'fcnk ki, \'e9s azt mondjuk: \'84Adj\'e1tok ide a bizony\'edt\'e9kotokat!\'94 Akkor meg fogj\'e1k tudni, hogy az igazs\'e1g Allahot illeti, \'e9s elt\'fbnik mell\'f5l\'fc
k mindaz, amit kital\'e1ltak.
\par 
\par 76. Bizony, K\'f3r\'e9 M\'f3zes n\'e9p\'e9b\'f5l val\'f3 volt, \'e9s zsarnokoskodott vel\'fck. \'c1m annyit adtunk neki a kincsekb\'f5l, hogy [azok] kulcsai t\'fal nagy teher volt egy csoport nagy erej\'fb f\'e9rfi sz\'e1m\'e1ra is. [Eml\'ed
tsd meg azt] amikor a n\'e9pe azt mondta neki: \'84Ne \'f6rvendezz! Bizony, Allah nem szereti a h\'e1l\'e1tlan \'f6rvendez\'f5ket.
\par 77. \'c9s keresd a t\'falvil\'e1gi lakhely [jutalm\'e1t] azzal [a vagyonnal,] amit Allah adott neked, \'e1m ne feledkezz meg a r\'e9szedr\'f5l az evil\'e1gb\'f3l! \'c9s tegy\'e9l j\'f3t [az emberekkel], mik\'e9ppen Allah is j\'f3t tett veled, \'e9
s ne okozz roml\'e1st a f\'f6ld\'f6n! Bizony, Allah nem szereti azokat, akik roml\'e1st okoznak.\'94
\par 78. Azt mondta [K\'f3r\'e9]: \'84Az csakis a n\'e1lam l\'e9v\'f5 tud\'e1s \'e1ltal adatott nekem!\'94 H\'e1t vajon nem tudta, hogy Allah nemzed\'e9keket puszt\'edtott el el\'f5tte, akik er\'f5sebbek voltak n\'e1la \'e9s t\'f6bb [vagyont] gy\'fbjt\'f6ttek 
\'f6ssze? \'c9s nem k\'e9rdeztetnek meg a gonosztev\'f5k a b\'fbneik fel\'f5l.
\par 79. S [K\'f3r\'e9] kiment a n\'e9pe el\'e9 [teljes] d\'edsz\'e9ben. Azt mondt\'e1k azok, akik az evil\'e1gi \'e9letet akarj\'e1k: \'84\'d3, b\'e1rcsak nek\'fcnk is lenne olyan, mint ami adatott K\'f3r\'e9nak! Bizony, \'f5 hatalmas r\'e9szesed\'e9
s birtokosa [az evil\'e1gi javakb\'f3l].\'94
\par 80. \'c9s azt mondt\'e1k azok, akiknek a tud\'e1s adatott: \'84Jaj nektek! Allah jutalma jobb azoknak, akik hisznek, \'e9s j\'f3t cselekszenek. \'c1m nem adatik meg m\'e1snak, csak a t\'fcrelmeseknek.\'94
\par 
\par 81. \'c9s els\'fcllyesztett\'fck a f\'f6ldet \'f5alatta }{\insrsid5968634\charrsid4151581 \'e9s a lakhelye alatt. \'c9s nem volt csapata, amely megseg\'edtette volna \'f5t Allah [b\'fcntet\'e9s\'e9vel] szemben,}{\insrsid5968634  \'e9s saj\'e1t mag\'e1
n sem tudott volna seg\'edteni.
\par 82. \'c9s azok, akik tegnap m\'e9g a hely\'e9t \'e1h\'edtozt\'e1k, a k\'f6vetkez\'f5 nap azt mondt\'e1k: \'84H\'e1t nem l\'e1tod, Allah kiterjeszti az ell\'e1t\'e1st annak, akinek akarja a szolg\'e1i k\'f6z\'fcl, \'e9s sz\'fbk\'f6ss\'e9 teszi [m\'e1
soknak]. Ha Allah nem tan\'fas\'edtott volna kegyet ir\'e1ntunk, akkor bizony alattunk is els\'fcllyesztette volna a f\'f6ldet. H\'e1t nem l\'e1tod [abb\'f3l, amit Allah tett, hogy], nem boldogulnak a hitetlenek?!\'94
\par 83. Azt a t\'falvil\'e1gi lakhelyet azoknak rendelj\'fck, akik nem v\'e1gyakoznak arra, hogy fennh\'e9j\'e1zzanak a f\'f6ld\'f6n, \'e9s hogy roml\'e1st okozzanak. \'c9s a [j\'f3] v\'e9g }{\insrsid5968634\charrsid3619736 az}{\insrsid5968634  istenf\'e9l
\'f5k\'e9.
\par 84. Aki egy j\'f3tettel j\'f6n majd el, annak m\'e9g jobb lesz a jutalma. Aki pedig egy rossz tettel j\'f6n majd el, nos akik rossz tetteket cselekedtek, azokat nem illeti meg m\'e1s fizets\'e9g, mint amit cselekedtek.
\par 
\par 85. Bizony, aki el\'f5\'edrta neked a Kor\'e1n [hirdet\'e9s\'e9t], az visszajuttat t\'e9ged egy visszat\'e9r\'e9si helyre (Mekk\'e1ba)! Mondd [\'f3 Mohamed]: \'84Az Uram jobban tudja, hogy ki hozza el az \'fatmutat\'e1st, \'e9s ki van nyilv\'e1nval\'f3 t
\'e9velyg\'e9sben!\'94
\par 86. \'c9s te [\'f3 Mohamed] nem rem\'e9lted, hogy le fog k\'fcldetni hozz\'e1d az \'cdr\'e1s (a Kor\'e1n), de ez Urad k\'f6ny\'f6r\'fclete. Ne l\'e9gy h\'e1t seg\'edt\'f5je a hitetleneknek!
\par 87. \'c9s ne hagyd, hogy t\'e1vol tartsanak t\'e9ged Allah jeleinek [\'e1tad\'e1s\'e1t\'f3l] azut\'e1n, hogy azok lebocs\'e1ttattak hozz\'e1d! \'c9s Uradhoz h\'edvd [az embereket]! \'c9s ne legy\'e9l azok k\'f6z\'fcl val\'f3, akik t\'e1rsistent \'e1ll\'ed
tanak [Allah mell\'e9]!
\par }{\insrsid5968634\charrsid4151581 88. \'c9s ne foh\'e1szkodj Allah mellett m\'e1s istenhez! Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten}{\insrsid5968634  Rajta k\'edv\'fcl! Minden dolog el fog pusztulni, kiv\'e9ve az \'d5 arcra. \'d5t illeti meg az \'edt
\'e9lkez\'e9s, \'e9s Hozz\'e1 lesztek visszavitetve.}{\insrsid13659446 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446 \page }{
\f0\fs24\insrsid13659446\charrsid7164156 29. A p\'f3k (al-Ankab\'fat) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid7164156 
\par }\pard \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 {\insrsid13659446\charrsid7164156 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 {\insrsid13659446\charrsid7164156 1. Alif-l\'e1m-m\'edm.
\par {\*\bkmkstart 2}{\*\bkmkend 2}2. Vajon azt gondolt\'e1k az emberek, hogy hagyni fogj\'e1k [\'f5ket], hogy azt mondj\'e1k: \'84Hisz\'fcnk!\'94, an\'e9lk\'fcl, hogy pr\'f3b\'e1ra lenn\'e9nek t\'e9ve?
\par 3. \'c9s bizony pr\'f3b\'e1ra tett\'fck m\'e1r azokat, akik el\'f5tt\'fck \'e9ltek. \'c9s bizony Allah nyilv\'e1nval\'f3v\'e1 fogja tenni [az embereknek] azt, amit m\'e1r tudott azokr\'f3l, akik igazat mondtak, \'e9s azokr\'f3l, akik hazugok.
\par 4. Vagy azt gondolj\'e1k azok, akik rossz tetteket cselekszenek, hogy elmenek\'fclhetnek [b\'fcntet\'e9s\'fcnk] el\'f5l? Milyen rossz az, ahogyan \'edt\'e9lkeznek!
\par 5. Aki rem\'e9li az Allahhal val\'f3 tal\'e1lkoz\'e1st, [az tudja meg, hogy] bizonyosan elj\'f6n Allah hat\'e1rideje. \'c9s \'d5 a Mindent Hall\'f3, a Mindentud\'f3.
\par 6. \'c9s aki er\'f5fesz\'edt\'e9st tesz, az csup\'e1n \'f6nmag\'e1\'e9rt tesz er\'f5fesz\'edt\'e9st. Bizony, Allahnak nincs sz\'fcks\'e9ge a teremtm\'e9nyekre.
\par 7. \'c9s akik hisznek, \'e9s j\'f3tetteket cselekszenek, azoknak bizony elengedj\'fck a rossz tetteiket \'e9s a legjobb cselekedeteik szerint adjuk meg nekik a fizets\'e9g\'fcket.
\par 
\par 8. \'c9s meghagytuk az embernek, hogy b\'e1njon j\'f3l a sz\'fcleivel. \'c1m ha \'f5k ketten er\'f5fesz\'edt\'e9seket tesznek ellened arra, hogy olyan t\'e1rsistent helyezz mell\'e9m, amir\'f5l nem rendelkezel tud\'e1ssal, akko
r ne engedelmeskedj nekik! Hozz\'e1m lesz a visszat\'e9r\'e9setek, \'e9s akkor h\'edr\'fcl adom nektek azt, amit cselekedtetek.
\par 9. \'c9s akik hisznek \'e9s j\'f3tetteket cselekszenek, azokat bizony bebocs\'e1tom a j\'f3k k\'f6z\'e9!
\par 
\par 10. \'c9s van az emberek k\'f6z\'f6tt olyan, aki azt mondja: \'84Hisz\'fcnk Allahban!\'94 \'c1m amikor [az emberek] b\'e1ntalmazz\'e1k \'f5t Allah [\'fcgye miatt], akkor [\'fagy] kezeli az emberekt\'f5l sz\'e1rmaz\'f3 k\'eds\'e9rt\'e9st, mint Allah gy\'f6
trelm\'e9t. Ha pedig seg\'edts\'e9g j\'f6n az Uradt\'f3l, akkor bizony azt mondj\'e1k: \'84Mi veletek voltunk!\'94 Vajon nem Allah az, aki jobban tudja, hogy mi van a teremtm\'e9nyek kebl\'e9ben?
\par 11. \'c9s Allah bizony nyilv\'e1nval\'f3v\'e1 fogja tenni [az embereknek] azt, amit m\'e1r tudott: hogy kik azok, akik hisznek, \'e9s kik a k\'e9pmutat\'f3k.
\par 12. \'c9s azok, akik hitetlenn\'e9 v\'e1ltak, azt mondj\'e1k azoknak, akik hisznek: \'84K\'f6vess\'e9tek a mi utunkat, mi pedig hordozni fogjuk a ti v\'e9tkeiteket!\'94 De \'f5k nem fognak hordozni semmit az \'f5 v\'e9tkeikb\'f5l! Bizony, \'f5k hazugok.

\par 13. \'c1m hordozni fogj\'e1k a saj\'e1t terheiket, \'e9s a maguk terhe mellett [m\'e1s] terheket! \'c9s a Felt\'e1mad\'e1s Napj\'e1n sz\'e1mon lesznek k\'e9rve arr\'f3l, amit kital\'e1ltak.
\par 
\par 14. \'c9s bizony elk\'fcldt\'fck No\'e9t az \'f5 n\'e9p\'e9hez, \'e9s \'f6tven \'e9v h\'edj\'e1n ezer esztend\'f5t id\'f5z\'f6tt k\'f6z\'f6tt\'fck, majd elragadta \'f5ket az \'f6z\'f6nv\'edz, mik\'f6zben igazs\'e1gtalanok voltak.
\par 15. \'c9s megmentett\'fck \'f5t \'e9s b\'e1rka lak\'f3it \'e9s jell\'e9 tett\'fck ezt a teremtm\'e9nyek sz\'e1m\'e1ra.
\par 
\par 16 \'c9s [eml\'edtsd meg] \'c1brah\'e1mot, amikor azt mondta a n\'e9p\'e9nek: \'84Szolg\'e1lj\'e1tok Allahot \'e9s f\'e9lj\'e9tek \'d5t! Ez jobb nektek, ha val\'f3ban rendelkeztek tud\'e1ssal!
\par 17. Ti csup\'e1n b\'e1lv\'e1nyokat szolg\'e1ltok Allah helyett \'e9s hazugs\'e1got hoztok l\'e9tre. Bizony, akiket Allah helyett szolg\'e1ltok, azoknak nem \'e1ll m\'f3djukban ell\'e1tni titeket. Keress\'e9tek h\'e1t Allahn\'e1l az ell\'e1t\'e1st, \'e9
s szolg\'e1lj\'e1tok \'d5t, \'e9s adjatok h\'e1l\'e1t Neki! Hozz\'e1 lesztek visszavitetve.\'94
\par 18. \'c9s ha meghazudtolj\'e1tok [a K\'fcld\'f6tt\'fcnket], h\'e1t m\'e1r el\'f5ttetek is voltak k\'f6z\'f6ss\'e9gek, amelyek meghazudtolt\'e1k [a K\'fcld\'f6ttj\'fcket]. \'c9s a K\'fcld\'f6ttre nem tartozik m\'e1s, csup\'e1n a vil\'e1gos [\'fczenet-]\'e1
tad\'e1s.
\par 
\par 19. H\'e1t vajon nem l\'e1tt\'e1k, hogyan viszi v\'e9ghez Allah a teremt\'e9st kezdetben, azt\'e1n [a hal\'e1l ut\'e1n] megism\'e9tli azt? Bizony, ez k\'f6nny\'fb Allahnak.
\par 20. Mondd [\'f3 Mohamed]: \'84J\'e1rj\'e1tok be a f\'f6ldet, \'e9s n\'e9zz\'e9tek meg, hogyan vitte v\'e9ghez [Allah] a teremt\'e9st kezdetben! Azut\'e1n Allah l\'e9trehozza a [v\'e9gs\'f5] teremt\'e9st [a t\'falvil\'e1
gon]. Bizony, Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 21. Azt s\'fajt gy\'f6trelemmel, akit akar, \'e9s azon k\'f6ny\'f6r\'fcl meg, akin akar. \'c9s Hozz\'e1 lesztek visszat\'e9r\'edtve.
\par 22. \'c9s nem fogj\'e1tok [Allahot] megakad\'e1lyozni [semmiben] sem a f\'f6ld\'f6n, sem az \'e9gben, \'e9s nincs nektek Allah helyett p\'e1rtfog\'f3tok, sem seg\'edt\'f5t\'f6k.
\par 23. Akik nem hisznek Allah jeleiben, \'e9s a Vele val\'f3 tal\'e1lkoz\'e1sban, azok elvesztett\'e9k a rem\'e9nyt az \'e9n k\'f6ny\'f6r\'fcletemben. \'c9s azoknak f\'e1jdalmas gy\'f6trelem j\'e1r.
\par 
\par 24. \'c9s nem volt m\'e1s v\'e1lasza [\'c1brah\'e1m] n\'e9p\'e9nek, csup\'e1n az, hogy azt mondt\'e1k: \'84\'d6lj\'e9tek meg vagy \'e9gess\'e9tek meg!\'94 Allah azonban megmentette \'f5t a t\'fbzt\'f5l. Bizony, ebben jelek vannak egy olyan n\'e9p sz\'e1m
\'e1ra, akik hisznek.
\par 25. \'c9s azt mondta [\'c1brah\'e1m]: \'84Csup\'e1n az\'e9rt tettetek meg magatoknak Allah helyett b\'e1lv\'e1nyokat, hogy szeretet legyen k\'f6z\'f6ttetek az evil\'e1gi \'e9letben. Majd a Felt\'e1mad\'e1s napj\'e1n meg fogj\'e1tok tagadni egym\'e1st, 
\'e9s meg fogj\'e1tok \'e1tkozni egym\'e1st. A [Pokol-]t\'fbz lesz a hajl\'e9kotok \'e9s nem lesznek seg\'edt\'f5itek!\'94
\par 26. L\'f3t pedig hitt neki. \'c9s azt mondta [\'c1brah\'e1m]: \'84Bizony, \'e9n Uramhoz fogok v\'e1ndorolni! Bizony, \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.{\*\bkmkstart 27}{\*\bkmkend 27}\'94
\par 27. \'c9s neki (\'c1brah\'e1mnak) aj\'e1nd\'e9koztuk Izs\'e1kot (fiak\'e9nt) \'e9s J\'e1kobot (unokak\'e9nt), \'e9s az \'f5 lesz\'e1rmazottainak adtuk a pr\'f3f\'e9tas\'e1got \'e9s az \'cdr\'e1st, \'e9s megadtuk neki a fizets\'e9g\'e9t az evil\'e1gon. 
\'c9s bizony, \'f5 a t\'falvil\'e1gon a j\'f3 emberek k\'f6z\'fcl val\'f3 lesz.
\par 
\par 28. \'c9s [eml\'e9kezz] L\'f3tra, amikor azt mondta: \'84\'d3 n\'e9pem! Bizony, ti [azt] a f\'f6rtelmes tettet k\'f6vetitek el, amelyet senki sem [k\'f6vetett el] el\'f5ttetek a teremtm\'e9nyek k\'f6z\'fcl.
\par 29. H\'e1t ti bizony [nemi] v\'e1gyt\'f3l hajtva k\'f6zeledtek a f\'e9rfiakhoz [az asszonyok helyett], \'faton\'e1ll\'f3k vagytok \'e9s a gy\'fbl\'e9setekben olyasmivel \'e1lltok el\'f5, ami elvetend\'f5?\'94 Az \'f5 n\'e9p\'e9nek csup\'e1n az volt a v
\'e1lasza, hogy azt mondt\'e1k: \'84Hozd h\'e1t ide nek\'fcnk Allah gy\'f6trelm\'e9t, ha val\'f3ban az igazmond\'f3k k\'f6z\'fcl val\'f3 vagy!\'94
\par 30. Azt mondta [L\'f3t]: \'84Uram! Seg\'edts meg a roml\'e1st okoz\'f3 n\'e9p ellen!\'94
\par 31. \'c9s amikor elj\'f6ttek a k\'fcld\'f6tteink \'c1brah\'e1mhoz az \'f6r\'f6mh\'edrrel, azt mondt\'e1k: \'84Bizony, mi elpuszt\'edtjuk ennek a telep\'fcl\'e9snek a lak\'f3it. Bizony, annak a lak\'f3i igazs\'e1gtalanok voltak.\'94
\par 32. Azt mondta: \'84Bizony, ott van L\'f3t is!\'94 Azt mondt\'e1k: \'84Mi jobban tudjuk, hogy ki van ott. Bizonyosan megmentj\'fck \'f5t \'e9s csal\'e1dj\'e1t, kiv\'e9ve a feles\'e9g\'e9t. \'d5 azok k\'f6z\'fcl val\'f3 volt, akik h\'e1tramaradtak.\'94

\par 33. \'c9s amikor elj\'f6ttek k\'fcld\'f6tteink L\'f3thoz, elszomorodott \'e9s gondterhelt lett miattuk. De [\'f5k] azt mondt\'e1k: \'84Ne f\'e9lj, \'e9s ne [is] szomorkodj! Bizony, mi megment\'fcnk t\'e9ged \'e9s a csal\'e1dodat, kiv\'e9ve a feles\'e9
gedet. \'d5 azok k\'f6z\'fcl val\'f3 volt, akik h\'e1tramaradtak.
\par 34. Bizony, mi ennek a telep\'fcl\'e9snek a lak\'f3ira b\'fcntet\'e9st fogunk lebocs\'e1tani az \'e9gb\'f5l, amiatt, hogy engedetlenek voltak.\'94
\par {\*\bkmkstart 36}{\*\bkmkend 36}35. \'c9s bizony, vil\'e1gos jelet hagytunk ebb\'f5l egy olyan n\'e9p sz\'e1m\'e1ra, akik \'e9lnek az esz\'fckkel.
\par 
\par 36. \'c9s Midi\'e1nhoz testv\'e9r\'fcket Suajbot [k\'fcldt\'fck el]. Azt mondta: \'84\'d3 n\'e9pem! Szolg\'e1lj\'e1tok Allahot \'e9s rem\'e9lj\'e9tek az Utols\'f3 nap [jutalm\'e1t], \'e9s ne j\'e1rjatok [gonoszul] a f\'f6ld\'f6n roml\'e1st okozva!\'94

\par 37. \'d5k azonban meghazudtolt\'e1k, ez\'e9rt elragadta \'f5ket a f\'f6ldreng\'e9s, \'e9s reggelre t\'e9rd\'fckre esve fek\'fcdtek (holtan) a lakhely\'fck\'f6n.
\par 
\par 38. \'c9s [elpuszt\'edtottuk] \'c1dot \'e9s Tham\'fadot, akiknek [pusztul\'e1sa] nyilv\'e1nval\'f3 lett sz\'e1motokra az \'f5 lakhelyeikb\'f5l. \'c9s a s\'e1t\'e1n feld\'edsz\'edtette nekik a cselekedeteiket \'e9s t\'e1vol tartotta \'f5ket az igaz \'fatt
\'f3l, noha tiszt\'e1nl\'e1t\'f3k (\'e9les elm\'e9j\'fbek) voltak.{\*\bkmkstart 39}{\*\bkmkend 39}
\par 39. \'c9s [elpuszt\'edtottuk] K\'f3r\'e9t \'e9s a F\'e1ra\'f3t \'e9s H\'e1m\'e1nt! \'c9s bizony elj\'f6tt hozz\'e1juk M\'f3zes a nyilv\'e1nval\'f3 bizony\'edt\'e9kokkal, \'f5k azonban felfuvalkodtak a f\'f6ld\'f6n. \'c1m nem tudtak elmenek\'fclni [b\'fc
ntet\'e9s\'fcnk] el\'f5l.
\par 40. \'c9s mindannyiukat megb\'fcntett\'fck a b\'fbneik miatt. \'cdgy volt, akire kavicssz\'f3r\'f3 [sz\'e9lvihart] k\'fcldt\'fcnk, \'e9s volt, akit a ki\'e1lt\'e1s ragadott el, \'e9s volt, aki alatt els\'fcllyesztett\'fck a f\'f6ldet, \'e9s volt, akit [v
\'edzbe] fullasztottunk. Allah sosem volt igazs\'e1gtalan vel\'fck, hanem saj\'e1t magukkal voltak igazs\'e1gtalanok.
\par 
\par 41. Azok, akik Allah helyett m\'e1s p\'e1rtfog\'f3kat tettek meg maguknak, hasonlatosak a p\'f3khoz, amely h\'e1zat k\'e9sz\'edtett mag\'e1nak, \'e1m a h\'e1zak k\'f6z\'fcl a p\'f3k h\'e1za a leggyeng\'e9bb. B\'e1rcsak rendelkezn\'e9nek tud\'e1ssal.

\par 42. Bizony, Allah tudja milyen dolgok azok, amelyekhez foh\'e1szkodnak \'d5helyette. \'c9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par {\*\bkmkstart 44}{\*\bkmkend 44}43. \'c9s ezek azok a p\'e9ld\'e1zatok, amelyeket adunk az embereknek. \'c1m csup\'e1n azok \'e9rtik meg ezeket, akik rendelkeznek tud\'e1ssal.
\par 
\par 44. Allah teremtette az egeket \'e9s a f\'f6ldet az igazs\'e1ggal (c\'e9llal). Bizony, ebben jel van a h\'edv\'f5knek.
\par 45. Recit\'e1ld [\'f3 Mohamed] azt, ami [kinyilatkoztat\'e1sk\'e9nt] sugalltatott neked az \'cdr\'e1sb\'f3l, \'e9s tartsd meg az im\'e1dkoz\'e1st! Bizony, az im\'e1dkoz\'e1s eltilt a f\'f6rtelmess\'e9gt\'f5l \'e9s az elvetend\'f5t\'f5l. \'c1m az Allahr
\'f3l val\'f3 megeml\'e9kez\'e9s [mindenn\'e9l] nagyobb. \'c9s Allah tudja, mit cselekszetek.
\par 
\par 46. \'c9s ne sz\'e1llj vit\'e1ba az \'cdr\'e1s n\'e9p\'e9vel, csak \'fagy, ahogy a legjobb \endash  kiv\'e9ve azokat, akik igazs\'e1gtalans\'e1got k\'f6vettek el! \'c9s mondj\'e1tok: \'84Hisz\'fcnk abban, ami lebocs\'e1ttatott hozz\'e1nk \'e9s ami lebocs
\'e1ttatott hozz\'e1tok! A mi Isten\'fcnk \'e9s a ti Istenetek egy. \'c9s mi Neki (Allahnak) vetj\'fck al\'e1 magunkat!\'94
\par 47. \'c9s ekk\'e9ppen bocs\'e1tottuk le hozz\'e1d az \'cdr\'e1st, \'e9s akiknek odaadtuk az \'cdr\'e1st, azok hisznek benne. \'c9s ezek k\'f6z\'f6tt is vannak olyanok, akik hisznek benne. \'c9s csup\'e1n a hitetlenek tagadj\'e1k a jeleinket.
\par 
\par 48. \'c9s nem recit\'e1lt\'e1l el\'f5tte (a Kor\'e1n el\'f5tt) egyetlen \'cdr\'e1st sem, \'e9s nem [is] \'edrtad azt a jobboddal, k\'fcl\'f6nben [ha \'edgy lett volna] k\'e9ts\'e9get \'e9breszten\'e9nek a hamiss\'e1got k\'f6vet\'f5k.
\par 49. De nem! Ez (a Kor\'e1n) vil\'e1gos jel azoknak a kebl\'e9ben, akiknek a tud\'e1s adatott. \'c9s csup\'e1n az igazs\'e1gtalanok tagadj\'e1k a jeleinket.
\par 50. \'c9s azt mondj\'e1k [a hitetlenek]: \'84H\'e1t mi\'e9rt nem bocs\'e1ttatott le hozz\'e1 egy jel az Ur\'e1t\'f3l?\'94 Mondd [\'f3 Mohamed]: \'84Bizony, a jelek csup\'e1n Allahra tartoznak, \'e9s \'e9n csup\'e1n egy nyilv\'e1nval\'f3 figyelmeztet\'f5
 vagyok.\'94
\par 51. H\'e1t vajon nem el\'e9g nekik az, hogy Mi lebocs\'e1tottuk hozz\'e1d az \'cdr\'e1st, amely recit\'e1ltatik nekik? Bizony, ebben k\'f6ny\'f6r\'fclet \'e9s eml\'e9keztet\'e9s van egy olyan n\'e9pnek, akik hisznek.
\par 52. Mondd [\'f3 Mohamed]: \'84Allah elegend\'f5 tan\'fanak k\'f6ztem \'e9s k\'f6ztetek! \'d5 tudja mindazt, ami az egekben \'e9s ami a f\'f6ld\'f6n van. \'c9s akik a hamiss\'e1gban hisznek \'e9s nem hisznek Allahban, azok bizony a vesztesek.\'94
\par 
\par 53. \'c9s siettetnek a gy\'f6trelemmel, \'e9s ha nem lenne egy megszabott hat\'e1rid\'f5, akkor bizony elj\'f6tt volna [m\'e1r] hozz\'e1juk a gy\'f6trelem. \'c9s bizony elj\'f6n az hozz\'e1juk v\'e1ratlanul, mik\'f6zben \'e9szre sem veszik [az elj\'f6
vetel\'e9t].
\par 54. Siettetnek t\'e9ged a gy\'f6trelemmel, \'e1m a Gyehenna bizonyosan k\'f6r\'fclveszi a hitetleneket.
\par 55. Azon a napon bebor\'edtja \'f5ket a gy\'f6trelem fel\'fclr\'f5l \'e9s a l\'e1buk al\'f3l, \'e9s [Allah] azt mondja: \'84\'cdzlelj\'e9tek meg [az eredm\'e9ny\'e9t] annak, amit cselekedtetek!\'94
\par 
\par 56. \'d3 szolg\'e1im, akik hisztek! Bizony, az \'e9n f\'f6ldem t\'e1gas, h\'e1t [egyed\'fcl] Engem szolg\'e1ljatok!
\par 57. Minden ember meg\'edzleli a hal\'e1lt. Azt\'e1n Hozz\'e1nk lesztek visszavitetve.
\par 58. \'c9s akik hisznek \'e9s j\'f3tetteket cselekszenek, azoknak bizony a Paradicsomban a legfels\'f5 helyeket jel\'f6lj\'fck ki [lakhely\'fcl], amelyek al\'f3l foly\'f3k folynak, \'f6r\'f6kk\'e9 abban fognak maradni. Milyen kit\'fbn\'f5 jutalom j\'e1
r azoknak, akik [j\'f3t] cselekszenek!
\par 59. Akik t\'fcrelmet tan\'fas\'edtanak \'e9s Urukra hagyatkoznak!
\par 60. \'c9s h\'e1ny mozg\'f3 [\'e9l\'f5l\'e9ny] van, amely nem k\'e9pes biztos\'edtani a saj\'e1t ell\'e1t\'e1s\'e1t. Allah l\'e1tja el \'f5ket \'e9s titeket. \'c9s \'d5 a mindent Hall\'f3, a mindent Tud\'f3.
\par 
\par 61. \'c9s bizony, ha megk\'e9rdezed \'f5ket, hogy ki teremtette az egeket \'e9s a f\'f6ldet, \'e9s ki rendelte szolg\'e1latra a Napot \'e9s a Holdat, bizonyosan azt mondj\'e1k: \'84Allah!\'94 Hogyan lehettek h\'e1t elt\'e9r\'edtve [az igazs\'e1gt\'f3l]?

\par 62. Allah kiterjeszti az ell\'e1t\'e1st annak, akinek akarja a szolg\'e1i k\'f6z\'fcl, \'e9s [m\'e1skor] sz\'fbk\'f6ss\'e9 teszi [azt] sz\'e1m\'e1ra (az \'f5 \'e9rdek\'e9ben). Bizony, Allah minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 63. \'c9s bizony, ha megk\'e9rdezed \'f5ket, hogy ki bocs\'e1tott le vizet az \'e9gb\'f5l, \'e9s keltette \'e9letre \'e1ltala a f\'f6ldet, miut\'e1n az meghalt, bizonyosan azt mondj\'e1k: \'84Allah!\'94 Mondd: \'84A h\'e1latelt dics\'e9ret Allahot illeti!
\'94 De a legt\'f6bben nem \'e9lnek az esz\'fckkel.
\par 64. \'c9s az evil\'e1gi \'e9let nem m\'e1s, mint sz\'f3rakoz\'e1s \'e9s j\'e1t\'e9k, \'e9s bizony a t\'falvil\'e1gi lakhely az igazi \'e9let! B\'e1rcsak tudn\'e1k!
\par 65. Ha pedig haj\'f3ra sz\'e1llnak, akkor Allahhoz foh\'e1szkodnak, \'f5szinte odaad\'e1ssal szentelve Neki a vall\'e1s [gyakorl\'e1s\'e1t]. \'c1m miut\'e1n kimentette \'f5ket a sz\'e1razf\'f6ldre - \'edme, \'f5k t\'e1rsat \'e1ll\'edtanak [Allah mell\'e9
],
\par {\*\bkmkstart 67}{\*\bkmkend 67}66. Hogy h\'e1l\'e1tlanok legyenek az ir\'e1nt, amit adtunk nekik, \'e9s hogy \'e9lvezz\'e9k [az evil\'e1gi \'e9let muland\'f3 \'f6r\'f6meit]. \'c1m majd meg fogj\'e1k tudni!
\par 67. H\'e1t vajon nem l\'e1tt\'e1k, hogy egy biztons\'e1gos, szent f\'f6ldet hoztunk l\'e9tre [Mekk\'e1ban], mik\'f6zben az emberek elragadtatnak (nincsenek biztons\'e1gban) k\'f6r\'fcl\'f6tt\'fck? Vajon a hamiss\'e1gban hisznek, \'e9s h\'e1l\'e1
tlanok Allah j\'f3t\'e9tem\'e9ny\'e9vel szemben?
\par {\*\bkmkstart 69}{\*\bkmkend 69}68. Ki lehet igazs\'e1gtalanabb ann\'e1l, mint aki hazugs\'e1got tal\'e1l ki Allahr\'f3l, vagy meghazudtolja az Igazs\'e1got, miut\'e1n az elj\'f6tt hozz\'e1? Vajon nincs-e a Gyehenn\'e1ban [jogos] otthona a hitetleneknek?

\par 69. \'c9s akik er\'f5fesz\'edt\'e9st tesznek Mi\'e9rt\'fcnk, bizony azokat a Mi [istenszolg\'e1lati] \'fatjainkon vezetj\'fck. \'c9s bizony, Allah a j\'f3tev\'f5kkel van.
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid7164156 
\page }{\f0\fs24\insrsid13659446\charrsid7164156 30. A Biz\'e1nciak (ar-R\'fam) c. sz\'fara
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid7164156 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 {\insrsid13659446\charrsid7164156 
\par 1. Alif-l\'e1m-m\'edm.
\par 2. Legy\'f5zettek a biz\'e1nciak
\par 3. A [Perzsi\'e1hoz] legk\'f6zelebb es\'f5 [biz\'e1nci] f\'f6ld\'f6n, \'e1m legy\'f5zet\'e9s\'fck ut\'e1n \'f5k fognak gy\'f5zelmet aratni,
\par 4. N\'e9h\'e1ny}{\insrsid13659446  \'e9ven bel\'fcl - Allahra tartozik az \'fcgyek [eld\'f6nt\'e9se] ezel\'f5tt \'e9s ezut\'e1n is. \'c9s azon a napon \'f6rvendeznek majd a h\'edv\'f5k
\par }{\insrsid13659446\charrsid15750829 5. Allah seg\'edts\'e9g\'e9nek. \'d5 megseg\'edti azt, akit akar \'e9s \'d5 a M\'e9lt\'f3s\'e1gteljes, az Irgalmas.
\par 6. [Ez] Allah \'edg\'e9rete. Allah nem szegi meg az \'edg\'e9ret\'e9t, \'e1m a legt\'f6bb ember nem rendelkezik tud\'e1ssal.}{\insrsid13659446 
\par 7. \'d5k az evil\'e1gi \'e9let k\'fcls\'f5s\'e9geir\'f5l rendelkeznek tud\'e1ssal, \'e1m \'f5k figyelmen k\'edv\'fcl hagyj\'e1k a t\'falvil\'e1got.
\par 
\par 8. H\'e1t vajon nem gondolkodtak-e el \'f6nmagukon? Allah nem teremtette az egeket \'e9s a f\'f6ldet \'e9s mindazt, ami k\'f6z\'f6tt\'fck van, csakis az igazs\'e1ggal (c\'e9llal) \'e9s megszabott hat\'e1rid\'f5vel. \'c1m bizony az emberek k\'f6z\'fc
l sokan nem hisznek az Urukkal val\'f3 tal\'e1lkoz\'e1sban.
\par 9. H\'e1t nem j\'e1rt\'e1k-e be a f\'f6ldet, \'e9s n\'e9zt\'e9k meg, milyen v\'e9gre jutottak azok, akik el\'f5tt\'fck \'e9ltek? Azok er\'f5sebbek voltak n\'e1luk, megm\'fbvelt\'e9k a f\'f6ldet \'e9s felvir\'e1goztatt\'e1k, jobban mint ahogyan \'f5k vir
\'e1goztatt\'e1k fel. \'c9s elj\'f6ttek hozz\'e1juk a k\'fcld\'f6tteik a nyilv\'e1nval\'f3 bizony\'edt\'e9kokkal. \'c9s Allah nem volt vel\'fck igazs\'e1gtalan, hanem \'f5k voltak igazs\'e1gtalanok magukkal szemben.
\par 10. [\'cdgy] majd akik rosszat cselekedtek, azoknak a v\'e9ge a legrosszabb lesz, mivel meghazudtolt\'e1k Allah jeleit, \'e9s g\'fanyol\'f3dtak azokon.
\par 11. Allah viszi v\'e9ghez a teremt\'e9st kezdetben, majd [a hal\'e1l ut\'e1n] }{\insrsid13659446\charrsid5272243 megism\'e9tli azt, majd Hozz\'e1 lesztek visszavitetve.
\par 12. \'c9s azon a napon, amikor val\'f3ra v\'e1lik az \'d3ra (a Felt\'e1mad\'e1s), a gonosztev\'f5k k\'e9ts\'e9gbe esnek.
\par 13 \'c9s nem lesznek nekik k\'f6zbenj\'e1r\'f3ik azok k\'f6z\'fcl, akiket [Allah mell\'e9] t\'e1rsistenk\'e9nt \'e1ll\'edtottak \'e9s nem fognak hinni azokban, akiket [Allah mell\'e9] t\'e1rsistenk\'e9nt \'e1ll\'edtottak.
\par 14. \'c9s azon a napon, amikor val\'f3ra v\'e1lik az \'d3ra (a Felt\'e1mad\'e1s), azon a napon elk\'fcl\'f6n\'fclnek [egym\'e1st\'f3l].
\par 15. Akkor akik hittek \'e9s j\'f3tetteket cselekedtek, azok egy d\'fas n\'f6v\'e9nyzet\'fb, kimagasl\'f3 kertben \'f6rvendeztetnek.
\par 16. Akik azonban hitetlenn\'e9 v\'e1ltak \'e9s meghazudtolt\'e1k jeleinket \'e9s a t\'falvil\'e1gi tal\'e1lkoz\'e1st, h\'e1t azok el\'f5hozatnak a gy\'f6trelemre.
\par 
\par 17. Magasztaltass\'e9k h\'e1t Allah, amikor el\'e9ritek az est\'e9t, \'e9s amikor reggelre keltek!
\par 18. \'c9s \'d5t illeti a h\'e1latelt dics\'e9ret az egekben \'e9s a f\'f6ld\'f6n, naplemente el\'f5tt, \'e9s amikor deleltek.
\par 19. \'d5 hozza el\'f5 az \'e9l\'f5t a halottb\'f3l, \'e9s a halottat az \'e9l\'f5b\'f5l, \'e9s \'e9letre kelti a f\'f6ldet, miut\'e1n az meghalt (kisz\'e1radt). \'c9s ekk\'e9ppen lesztek [a s\'edrotokb\'f3l] el\'f5hozatva.
\par 20. \'c9s az \'d5 jelei k\'f6z\'e9 tartozik, hogy porb\'f3l teremtett titeket, majd \'edme, ti emberek vagytok, akik sz\'e9tsz\'f3r\'f3dtok [a f\'f6ld\'f6n].
\par 21 \'c9s az \'d5 jelei k\'f6z\'e9 tartozik, hogy saj\'e1t magatok k\'f6z\'fcl h\'e1zast\'e1rsakat teremtett nektek, hogy nyugalomra leljetek n\'e1luk, \'e9s szeretetet \'e9s irgalmat helyezett k\'f6z\'e9tek. Bizony, jelek vannak ebben egy olyan n\'e9p sz
\'e1m\'e1ra, akik elgondolkodnak.
\par 22. \'c9s az \'d5 jelei k\'f6z\'e9 tartozik az egek \'e9s a f\'f6ld megteremt\'e9se, \'e9s a nyelveitek \'e9s a [b\'f5r-]sz\'edneitek k\'fcl\'f6nb\'f6z\'f5s\'e9ge. Bizony, jelek vannak ebben azoknak, akik tud\'e1ssal rendelkeznek.
\par 23 \'c9s az \'d5 jelei k\'f6z\'e9 tartozik az alv\'e1sotok \'e9jjel \'e9s nappal, \'e9s az \'e1h\'edtoz\'e1sotok az \'d5 kegye (ell\'e1t\'e1sa) ut\'e1n. Bizony, ebben jelek vannak egy olyan n\'e9p sz\'e1m\'e1ra, akik hallanak.
\par 24. \'c9s az \'d5 jelei k\'f6z\'e9 tartozik, hogy megmutatja nektek a vill\'e1mot \endash  f\'e9lelmet \'e9s v\'e1gyakoz\'e1st keltve bennetek \endash  \'e9s vizet bocs\'e1t le az \'e9gb\'f5l \'e9s fel\'e9leszti \'e1ltala a f\'f6ldet, miut\'e1
n az meghalt (kisz\'e1radt). Bizony, jelek vannak ebben egy olyan n\'e9p sz\'e1m\'e1ra, akik \'e9lnek az esz\'fckkel.
\par 25. \'c9s az \'d5 jelei k\'f6z\'e9 tartozik, hogy az \'e9g \'e9s a f\'f6ld az \'d5 parancsa \'e1ltal \'e1llnak [minden t\'e1masz n\'e9lk\'fcl], majd amikor h\'edv\'e1ssal sz\'f3l\'edt [a felt\'e1mad\'e1sra] titeket a f\'f6ldb\'f5l, \'edme, el\'f5j\'f6tt
\'f6k [a s\'edrotokb\'f3l].
\par 26. \'c9s az \'d6v\'e9 mindaz, aki az egekben \'e9s a f\'f6ld\'f6n van. Minden al\'e1zatosan engedelmeskedik Neki.
\par 27. \'c9s \'d5 az, aki v\'e9ghez viszi a teremt\'e9st kezdetben, majd [a hal\'e1l ut\'e1n] megism\'e9tli azt, \'e9s ez k\'f6nnyebb neki. \'d6v\'e9 a legmagasztosabb p\'e9ld\'e1zat az egekben \'e9s a f\'f6ld\'f6n. \'c9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B
\'f6lcs.
\par 
\par 28. \'d5 p\'e9ld\'e1zatot adott nektek saj\'e1t magatokb\'f3l. Vajon azok k\'f6z\'f6tt, akiket a jobbotok birtokol, vannak-e olyanok, akik t\'e1rsaitok lenn\'e9nek abban, amivel titeket ell\'e1ttunk \'fagy, hogy egyenl\'f5k lenn\'e9tek annak birtokl\'e1s
\'e1ban? \'c9s f\'e9ltek-e t\'f5l\'fck \'fagy, ahogyan egym\'e1st\'f3l f\'e9ltek? Ekk\'e9ppen fejtj\'fck ki r\'e9szletesen a jeleket egy olyan n\'e9pnek, akik \'e9lnek az esz\'fckkel.{\*\bkmkstart 291}{\*\bkmkend 291}
\par 29. De nem! Akik igazs\'e1gtalans\'e1got k\'f6vettek el, azok tudatlans\'e1gukban a k\'e9ny\'fcket k\'f6vetik. [Vajon] h\'e1t ki vezeti az igaz \'fatra azt, akit Allah t\'e9velyg\'e9sbe vitt? \'c9s nem lesznek nekik seg\'edt\'f5ik!
\par 30. Tartsd magad h\'e1t a vall\'e1shoz han\'edfk\'e9nt (egyistenh\'edv\'f5k\'e9nt, a hamis vall\'e1sokt\'f3l elhajl\'f3k\'e9nt), [\'e9s ragaszkodj] az Allah \'e1ltal teremtett term\'e9szethez, amellyel l\'e9trehozta az embereket! Allah teremt\'e9s\'e9
t nem lehet megv\'e1ltoztatni! Ez az egyenesen (szil\'e1rd alapokon) \'e1ll\'f3 vall\'e1s, \'e1m a legt\'f6bb ember nem rendelkezik tud\'e1ssal.
\par 31. [Legyetek b\'fbnb\'e1n\'f3an] visszat\'e9r\'f5k [Allahhoz], \'e9s f\'e9lj\'e9tek \'d5t, \'e9s tarts\'e1tok meg az im\'e1dkoz\'e1st, \'e9s ne tartozzatok azokhoz, akik [Allah mell\'e9] t\'e1rsistent helyeznek,
\par 32. [Vagyis] azokhoz, akik megosztj\'e1k vall\'e1sukat \'e9s [vall\'e1si] p\'e1rtokra szakadnak, \'e9s mindegyik csoport annak \'f6rvendezik, ami n\'e1la van!
\par 
\par 33. \'c9s ha valami \'e1rtalom \'e9ri az embereket, Urukhoz foh\'e1szkodnak, [b\'fbnb\'e1n\'f3an] visszat\'e9r\'f5kk\'e9nt \'d5hozz\'e1, majd amikor meg\'edzlelteti vel\'fck a T\'f5le val\'f3 k\'f6ny\'f6r\'fcletet, akkor \'edme, egy csoport k\'f6z\'fcl
\'fck azonnal t\'e1rsistent \'e1ll\'edt az Ura mell\'e9
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\tx1134\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid5272243 34. Az\'e9rt, hogy hitetlenn\'e9
 (h\'e1l\'e1tlann\'e1) v\'e1ljanak azzal [a j\'f3t\'e9tem\'e9nnyel] szemben, amit adtunk nekik! \'c9lvezz\'e9tek h\'e1t [az evil\'e1gi \'e9letet], majd meg fogj\'e1tok tudni [hitetlens\'e9getek k\'f6vetkezm\'e9ny\'e9t]!
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid5272243 35. Vagy tal\'e1n bizony\'edt\'e9kot bocs\'e1
tottunk le nekik, ami besz\'e9l arr\'f3l, amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak \'d5mell\'e9?
\par 36. \'c9s amikor Mi k\'f6ny\'f6r\'fcletet \'edzleltet\'fcnk meg az emberekkel, akkor \'f6rvendeznek annak. Ha azonban valami rossz \'e9ri \'f5ket az\'e9rt, amit a kez\'fck elk\'f6vetett, akkor elvesz\'edtik a rem\'e9nyt.
\par 37. H\'e1t vajon nem l\'e1tt\'e1k, hogy Allah kiterjeszti az ell\'e1t\'e1st annak, akinek akarja, \'e9s sz\'fbk\'f6ss\'e9 teszi [azt m\'e1soknak]? Bizony, jelek vannak ebben egy olyan n\'e9p sz\'e1m\'e1ra, akik hisznek.
\par 
\par 38. \'c9s add meg a rokonnak a jogos r\'e9sz\'e9t, \'e9s a szeg\'e9nynek \'e9s az utaz\'f3nak [is]! Ez jobb azoknak, akik Allah arc\'e1t (megel\'e9ged\'e9s\'e9t) \'e1h\'edtozz\'e1k. \'c9s \'f5k bizony azok, akik boldogulnak.}{
\cf1\insrsid13659446\charrsid5272243 
\par 39. Amit kamatra adtok [k\'f6lcs\'f6n], hogy kamatozzon az emberek javaib\'f3l, az nem kamatozik Allahn\'e1l. \'c1m ami k\'f6telez\'f5 adom\'e1nyt adtok, Allah arc\'e1t (megel\'e9ged\'e9s\'e9t) \'e1h\'edtozva [az elfogadtatik Allahn\'e1l], nos \'f5
k bizony azok, akiknek megt\'f6bbsz\'f6r\'f6zik [jutalmukat].
\par }{\insrsid13659446\charrsid5272243 40. Allah az, aki megteremtett titeket, majd ell\'e1tott benneteket, azt\'e1n hal\'e1lba bocs\'e1t titeket, majd \'fajra \'e9letre kelt benneteket. Vajon, van-e azok k\'f6z\'fcl, akiket [Allah mell\'e9] t\'e1rsistenk\'e9
nt \'e1ll\'edtotok, b\'e1rki, aki megtesz ebb\'f5l valamit? Magasztaltass\'e9k \'d5! \'c9s [\'d5] afelett van, amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [\'d5mell\'e9].
\par 41. Megjelent a roml\'e1s a sz\'e1razf\'f6ld\'f6n \'e9s a tengeren amiatt, amit az emberek keze szerzett, hogy Allah meg\'edzleltessen valamennyit vel\'fck abb\'f3l, amit cselekedtek, [az\'e9rt, hogy] h\'e1tha visszat\'e9rnek.
\par 
\par 42. Mondd [\'f3 Mohamed]: \'84J\'e1rj\'e1tok be a f\'f6ldet, \'e9s figyelj\'e9tek meg, hogy milyen v\'e9gre jutottak azok, akik kor\'e1bban \'e9ltek! A legt\'f6bbj\'fck [Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3k [k\'f6z\'fcl val\'f3] volt.\'94
\par 43. Ford\'edtsd h\'e1t orc\'e1dat az egyenesen (szil\'e1rd alapokon) \'e1ll\'f3 vall\'e1s fel\'e9, miel\'f5tt m\'e9g elj\'f6nne Allaht\'f3l az a nap, amely nem h\'e1r\'edthat\'f3 el! Azon a napon csoportokra szakadnak.
\par 44. Akik hitetlenn\'e9 v\'e1ltak, azoknak a hitetlens\'e9ge \'f5ket terheli. \'c9s akik pedig j\'f3tettet cselekszenek, h\'e1t azok a maguk sz\'e1m\'e1ra k\'e9sz\'edtik el\'f5 [hely\'fcket a Paradicsomban],
\par 45. Hogy Allah fizets\'e9get adjon az \'d5 kegy\'e9b\'f5l azoknak, akik hisznek \'e9s j\'f3tetteket cselekszenek. Bizony, \'d5 nem szereti a hitetleneket.
\par 
\par 46. \'c9s a jelei k\'f6z\'e9 tartozik az, hogy elk\'fcldi a szeleket \'f6r\'f6mh\'edrhoz\'f3kk\'e9nt, \'e9s az\'e9rt, hogy meg\'edzleltesse veletek a k\'f6ny\'f6r\'fclet\'e9t, \'e9s hogy a haj\'f3k haladhassanak a tengeren az \'d5 parancsa \'e1ltal, \'e9
s hogy az \'d5 kegy\'e9t keress\'e9tek, h\'e1tha h\'e1l\'e1sak lesztek.
\par 47. \'c9s bizony, m\'e1r el\'f5tted is [\'f3 Mohamed] k\'fcldt\'fcnk k\'fcld\'f6tteket az \'f5 n\'e9p\'fckh\'f6z, \'e9s nyilv\'e1nval\'f3 bizony\'edt\'e9kokkal j\'f6ttek el hozz\'e1juk. Mi pedig el\'e9gt\'e9telt vett\'fcnk azokon, akik gonosztev\'f5
k voltak. \'c9s k\'f6teless\'e9g\'fcnk volt a h\'edv\'f5k megseg\'edt\'e9se.
\par {\*\bkmkstart 481}{\*\bkmkend 481}48. Allah az, aki szeleket k\'fcld, amelyek mozgatj\'e1k a felh\'f5ket, \'e9s \'d5 kiter\'edti azokat az \'e9gen, \'fagy ahogyan akarja, \'e9s darabokra oszlatja sz\'e9t azokat, \'e9s l\'e1tod az es\'f5t, amint el\'f5j
\'f6n a hasad\'e9kaikb\'f3l. \'c9s amikor el\'e9ri azokat az \'d5 szolg\'e1i k\'f6z\'fcl, akiket akar, akkor \'f5k [azonnal] \'f6r\'f6mmel tekintenek [az es\'f5 \'e9rkez\'e9s\'e9re].
\par 49. Noha azel\'f5tt, miel\'f5tt lebocs\'e1ttatott re\'e1juk, k\'e9ts\'e9gbe voltak esve.
\par 50. N\'e9zz h\'e1t Allah k\'f6ny\'f6r\'fclet\'e9nek a nyomaira: hogyan kelti \'e9letre a f\'f6ldet, miut\'e1n az meghalt. Bizony, \'d5 az, aki \'e9letre kelti a halottakat. \'c9s \'d5 minden dologra kiterjed\'f5 hatalm\'fa.
\par 51. \'c9s ha [forr\'f3] szelet k\'fclden\'e9nk el, \'e9s l\'e1tn\'e1k, amint els\'e1rgul [a n\'f6v\'e9nyzet], bizony, azut\'e1n is hitetlenek maradn\'e1nak.
\par {\*\bkmkstart 541}{\*\bkmkend 541}52. \'c9s bizony, te [\'f3 Mohamed] nem teheted hallhat\'f3v\'e1 a halottaknak [az igazs\'e1got], \'e9s nem teheted hallhat\'f3v\'e1 a s\'fcketeknek sem a h\'edv\'e1st, amikor \'f5k t\'e1vozva h\'e1tat ford\'edtanak.

\par 53. \'c9s te nem vezetheted ki a vakokat a t\'e9velyg\'e9sb\'f5l [az igaz \'fatra]. Nem teheted hallhat\'f3v\'e1 magadat, csak azoknak, akik hisznek a mi jeleinkben, \'e9s [\'edgy] \'f5k al\'e1vetik magukat [Allahnak].
\par 
\par 54. Allah az, aki gyenge [ivarsejtb\'f5l] teremtett titeket, majd a gyenges\'e9g ut\'e1n er\'f5t adott, azt\'e1n az er\'f5 ut\'e1n gyenges\'e9get \'e9s \'f5sz hajat adott. Azt teremt, amit akar. \'c9s \'d5 a Mindent Tud\'f3, a Mindenhat\'f3.
\par 
\par 55. \'c9s azon a napon, amikor val\'f3ra v\'e1lik az \'d3ra (a Felt\'e1mad\'e1s), megesk\'fcsznek a gonosztev\'f5k, hogy csup\'e1n egy \'f3r\'e1t id\'f5ztek [az evil\'e1gon]. Ekk\'e9ppen lettek elt\'e9r\'edtve [az igazs\'e1gt\'f3l].
\par 56. \'c9s akiknek a tud\'e1s \'e9s a hit adatott, azok azt mondj\'e1k: \'84Bizony, Allah \'cdr\'e1s\'e1ban az \'e1ll, hogy a Felt\'e1mad\'e1s Napj\'e1ig id\'f5ztetek, \'e9s ez a Felt\'e1mad\'e1s Napja. \'c1m ti nem rendelkeztetek tud\'e1ssal.\'94
\par {\*\bkmkstart 581}{\*\bkmkend 581}57. \'c9s azon a napon nem haszn\'e1l a menteget\'f5z\'e9s\'fck azoknak, akik igazs\'e1gtalans\'e1got k\'f6vettek el, \'e9s nem k\'e9retik t\'f5l\'fck kiengesztel\'e9s [Allah fel\'e9].
\par 58. \'c9s bizony, ebben a Kor\'e1nban mindenf\'e9le p\'e9ld\'e1zatot adtunk az embereknek; \'e9s bizony, ha b\'e1rmilyen Jellel is j\'f6ssz el hozz\'e1juk, [azok, akik] hitetlenn\'e9 v\'e1ltak, bizony azt fogj\'e1k mondani; \'84Ti nem vagytok m\'e1
sok, mint hamiss\'e1got k\'f6vet\'f5k!\'94
\par 59. Ekk\'e9ppen pecs\'e9teli le Allah azoknak a sz\'edv\'e9t, akik nem rendelkeznek tud\'e1ssal.
\par 60. L\'e9gy h\'e1t t\'fcrelmes! Bizony, Allah \'edg\'e9rete igaz. \'c9s ne hagyd, hogy elb\'e1tortalan\'edtsanak azok, akiknek nincs szil\'e1rd bizonyoss\'e1guk!
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid5272243 
\page }{\f0\fs24\insrsid13659446\charrsid14371386 31. Lukm\'e1n (Luqm\'e1n) c. sz\'fara}{\insrsid13659446\charrsid14371386 
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid14371386 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 {\insrsid13659446\charrsid14371386 1. Alif-l\'e1m-m\'edm.
\par 2. Ezek a B\'f6lcs \'cdr\'e1s jelei,
\par 3. \'datmutat\'e1sk\'e9nt \'e9s k\'f6ny\'f6r\'fcletk\'e9nt a j\'f3tev\'f5knek,
\par 4. Akik megtartj\'e1k az im\'e1dkoz\'e1st, \'e9s megadj\'e1k a k\'f6telez\'f5 adom\'e1nyt \'e9s szil\'e1rd bizonyoss\'e1guk van a t\'falvil\'e1gr\'f3l.
\par 5. \'d5k Urukt\'f3l val\'f3 \'fatmutat\'e1st k\'f6vetnek, \'e9s \'f5k bizony azok, akik boldogulnak. 
\par 
\par 6. \'c9s van az emberek k\'f6z\'f6tt olyan, aki sz\'f3rakoztat\'f3 t\'f6rt\'e9neteket v\'e1s\'e1rol tudatlans\'e1gb\'f3l, hogy t\'e9velyg\'e9sbe vigyen [m\'e1sokat] Allah \'fatj\'e1r\'f3l, \'e9s hogy g\'fany t\'e1rgy\'e1v\'e1
 tegye azokat (Allah jeleit). Azoknak [akik ilyenek] megal\'e1z\'f3 gy\'f6trelem j\'e1r.
\par 7. \'c9s amikor a Mi jeleink recit\'e1ltatnak neki, fennh\'e9j\'e1zva h\'e1tat ford\'edt, mintha nem hallan\'e1, mintha s\'fckets\'e9g lenne a f\'fcleiben. Adj h\'e1t neki \'f6r\'f6mh\'edrt f\'e1jdalmas gy\'f6trelemr\'f5l!
\par 8. Akik hisznek \'e9s j\'f3tetteket cselekszenek, bizony azoknak a gy\'f6ny\'f6r\'fbs\'e9g kertjei j\'e1rnak [a Paradicsomban],
\par 9. Abban maradnak \'f6r\'f6kk\'e9. Ez Allah \'edg\'e9rete, igazs\'e1gk\'e9nt. \'c9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par {\*\bkmkstart 101}{\*\bkmkend 101}
\par 10. [\'d5 az, aki] megteremtette az egeket oszlopok n\'e9lk\'fcl, ahogy l\'e1tj\'e1tok, \'e9s szil\'e1rdan r\'f6gz\'edtetteket (hegyeket) vetett a f\'f6ldbe \endash  nehogy r\'e1zk\'f3djon veletek \endash  \'e9s azon mindenf\'e9le mozg\'f3 [\'e9l\'f5l\'e9
nyt] sz\'f3rt sz\'e9t. \'c9s az \'e9gb\'f5l vizet bocs\'e1tottunk le, \'e9s mindenf\'e9le nemes fajt\'e1t sarjasztottunk rajta [a n\'f6v\'e9nyekb\'f5l].
\par 11. Ez Allah teremt\'e9se. Mutass\'e1tok h\'e1t meg nekem, mit teremtettek azok, akik Rajta k\'edv\'fcl vannak! \'c1m az igazs\'e1gtalanok nyilv\'e1nval\'f3 t\'e9velyg\'e9sben vannak!
\par 
\par 12. \'c9s bizony, Lukm\'e1nnak megadtuk a b\'f6lcsess\'e9get: \'84L\'e9gy h\'e1l\'e1s Allahnak!\'94 Aki h\'e1l\'e1s, az saj\'e1t maga haszn\'e1ra h\'e1l\'e1s. \'c9s aki h\'e1l\'e1tlan, h\'e1t Allah bizony Gazdag, Dics\'e9retrem\'e9lt\'f3.
\par 13. \'c9s [eml\'e9kezz arra] amikor Lukm\'e1n azt mondta a fi\'e1nak, mik\'f6zben intette: \'84\'d3 fiacsk\'e1m! Ne \'e1ll\'edts t\'e1rsistent Allah mell\'e9! Bizony, [Allah mell\'e9] t\'e1rsistent \'e1ll\'edtani hatalmas igazs\'e1gtalans\'e1g.\'94
\par 
\par 14. \'c9s meghagytuk az embernek a sz\'fcleire n\'e9zve \endash  [hiszen] az anyja hordta ki \'f5t gyenges\'e9get gyenges\'e9gre [halmozva], \'e9s az elv\'e1laszt\'e1sa k\'e9t \'e9v alatt [t\'f6rt\'e9nt] \endash  hogy: \'84Legy\'e9l h\'e1l\'e1s Nekem \'e9
s a sz\'fcleidnek! N\'e1lam lesz a v\'e9gc\'e9l.\'94
\par 15. \'c9s ha \'f5k ketten er\'f5fesz\'edt\'e9seket tesznek ellened arra, hogy olyan t\'e1rsistent helyezz  mell\'e9m, amir\'f5l nem rendelkezel tud\'e1ssal, akkor ne engedelmeskedj nekik! \'c9s hely\'e9nval\'f3 m\'f3don legy\'e9l a t\'e1rsuk az evil\'e1
gon, \'e9s k\'f6vesd annak az \'fatj\'e1t, aki b\'fbnb\'e1nattal t\'e9r vissza Hozz\'e1m! Majd [v\'e9g\'fcl] Hozz\'e1m lesz a visszat\'e9r\'e9setek, \'e9s akkor h\'edr\'fcl adom nektek azt, amit cselekedtetek.
\par 
\par 16. [Azt mondta Lukm\'e1n:] \'84\'d3 Fiacsk\'e1m! Ha annak [amit cselekszel] ak\'e1r egy must\'e1rmagnyi s\'falya is lenne, \'e9s az legyen ak\'e1r egy szikl\'e1ban, vagy az egekben, vagy a f\'f6ld\'f6n, Allah el\'f5hozza azt. Bizony, Allah K\'edm\'e9
letes, [mindent] j\'f3l Ismer\'f5.
\par 17. \'84\'d3 Fiacsk\'e1m! Tartsd meg az im\'e1dkoz\'e1st, sz\'f3l\'edts fel a hely\'e9nval\'f3ra, \'e9s tiltsd meg az elvetend\'f5t, \'e9s legy\'e9l t\'fcrelmes az ir\'e1nt, ami [b\'e1ntalom] \'e9r t\'e9ged! Bizony ezek az elsz\'e1nts\'e1got [k\'f6vetel
\'f5] dolgok k\'f6z\'e9 tartoznak.
\par 18. \'c9s ne ford\'edtsd el az arcodat az emberekt\'f5l megvet\'f5en! \'c9s ne j\'e1rj kev\'e9lyen a f\'f6ld\'f6n! Bizony, Allah nem szeret egyetlen p\'f6ffeszked\'f5t, dicsekv\'f5t sem.
\par 19. \'c9s legy\'e9l m\'e9rt\'e9kletes a j\'e1r\'e1sodban, \'e9s halk\'edtsd le a hangodat! Bizony, a hangok [k\'f6z\'fcl] a legvisszatasz\'edt\'f3bb a szamarak hangja.\'94
\par 
\par 20. Vajon nem gondolkodtatok el azon, hogy Allah a szolg\'e1latotokra rendelte mindazt, ami az egekben \'e9s a f\'f6ld\'f6n van, \'e9s ki\'e1rasztotta r\'e1tok l\'e1that\'f3 \'e9s rejtett kegyeit? \'c9s [m\'e9gis] van az emberek k\'f6z\'f6
tt olyan, aki vit\'e1ba sz\'e1ll Allahr\'f3l tud\'e1s, \'fatmutat\'e1s \'e9s vil\'e1goss\'e1got ad\'f3 \'cdr\'e1s n\'e9lk\'fcl.
\par 21. \'c9s ha azt mondj\'e1k nekik: \'84K\'f6vess\'e9tek azt, amit Allah lebocs\'e1tott!\'94 Azt mondj\'e1k: \'84Dehogy! Azt k\'f6vetj\'fck, amin aty\'e1inkat tal\'e1ltuk.\'94 Vajon akkor is, ha [azzal] a s\'e1t\'e1n a L\'e1ngol\'f3 [Pokol-t\'fbz] gy\'f6
trelm\'e9hez sz\'f3l\'edtan\'e1 \'f5ket?
\par 22. \'c1m, aki al\'e1veti arc\'e1t (\'f6nmag\'e1t) Allahnak \'e9s j\'f3tev\'f5, az bizony megragadta a szil\'e1rd kapaszkod\'f3t. \'c9s Allahra tartozik az \'fcgyek v\'e9gkimenetele.
\par {\*\bkmkstart 242}{\*\bkmkend 242}23. \'c9s aki hitetlenn\'e9 v\'e1lt [Allahhal szemben], annak a hitetlens\'e9ge ne szomor\'edtson el t\'e9ged! Hozz\'e1nk lesz majd a visszat\'e9r\'e9s\'fck, \'e9s akkor h\'edr\'fcl adjuk nekik, hogy mit cselekedtek. B
izony, Allahnak tudom\'e1sa van arr\'f3l, amit a keblek rejtenek.
\par 24. R\'f6vid ideig \'e9lvezetekben r\'e9szes\'edtj\'fck, azut\'e1n s\'falyos gy\'f6trelembe k\'e9nyszer\'edtj\'fck \'f5ket.
\par 25. \'c9s bizony, ha megk\'e9rdezed \'f5ket, hogy ki teremtette az egeket \'e9s a f\'f6ldet, bizonyosan azt mondj\'e1k: \'84Allah.\'94 Mondd: \'84A h\'e1latelt dics\'e9ret Allahot illeti!\'94 De a legt\'f6bben nem rendelkeznek tud\'e1ssal.
\par 26. Allahot illeti meg mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van. Bizony, Allah az, aki a Gazdag, a Dics\'e9retrem\'e9lt\'f3.
\par 
\par 27. \'c9s ha minden fa, ami csak van a f\'f6ld\'f6n, \'edr\'f3toll lenne, \'e9s a tenger, \'e9s tov\'e1bbi h\'e9t tenger hozz\'e1t\'e9ve [tinta lenne], Allah szavai akkor sem fogyn\'e1nak el. Bizony, Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.
\par 28. A ti megteremt\'e9setek \'e9s felt\'e1maszt\'e1sotok csup\'e1n olyan, mintha egyetlen ember [megteremt\'e9se \'e9s felt\'e1maszt\'e1sa] lenne. Bizony, Allah Mindent Hall\'f3, Mindent L\'e1t\'f3.
\par 
\par 29. Vajon nem gondolkodt\'e1l el azon, hogy Allah beleviszi az \'e9jszak\'e1t a nappalba, \'e9s beleviszi a nappalt az \'e9jszak\'e1ba, \'e9s \'d5 rendelte szolg\'e1latra a Napot \'e9s a Holdat, mindegyik megszabott ideig fut (kering a p\'e1ly\'e1j\'e1
n), \'e9s hogy Allah j\'f3l ismeri mindazt, amit cselekszetek?
\par }\pard\plain \s103\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid14371386 30. Ez [az\'e9rt van \'ed
gy], mivel Allah az Igazs\'e1g, \'e1m amihez \'d5helyette foh\'e1szkodnak, az a hamiss\'e1g. \'c9s [az\'e9rt,] mivel Allah az, aki a Magass\'e1gos, a Nagy.
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid14371386 31. Vajon nem gondolkodt\'e1l el azon, hogy a haj
\'f3k Allah kegy\'e9b\'f5l haladnak a tengeren, hogy mutathasson nektek az \'d5 jeleib\'f5l? Bizony, ebben jelek vannak minden t\'fcrelmesnek, h\'e1l\'e1snak.
\par 32. \'c9s amikor akkora hull\'e1m bor\'edtja el \'f5ket, mint a [hatalmas felh\'f5k] \'e1rny\'e9kai, akkor Allahhoz foh\'e1szkodnak, \'f5szinte odaad\'e1ssal szentelve Neki a vall\'e1s [gyakorl\'e1s\'e1t]. \'c1m miut\'e1n kimenti \'f5ket a sz\'e1razf\'f6
ldre, \'edme van k\'f6z\'f6tt\'fck aki [csak] m\'e9rs\'e9kelt [a h\'e1laad\'e1sban \'e9s van k\'f6z\'f6tt\'fck, aki tagadja Allah kegy\'e9t], \'e1m [senki m\'e1s] nem tagadja a Mi jeleinket, csak minden \'e1rul\'f3, h\'e1l\'e1tlan.
\par 
\par }{\insrsid13659446\charrsid4358122 33. \'d3 ti, emberek! F\'e9lj\'e9tek Uratokat \'e9s f\'e9ljetek att\'f3l a napt\'f3l, amikor egy sz\'fcl\'f5 sem lehet gyermek\'e9nek haszn\'e1ra, \'e9s egy gyermek sem lehet sz\'fcl\'f5j\'e9nek haszn\'e1
ra semmivel! Bizony, Allah \'edg\'e9rete igaz. Ne t\'e9vesszen h\'e1t meg titeket az evil\'e1gi \'e9let, \'e9s ne t\'e9vesszen meg titeket Allahot illet\'f5en a megt\'e9veszt\'f5 (a s\'e1t\'e1n)!
\par 34. Bizony, Allah tudja [egyed\'fcl, hogy mikor j\'f6n el] az \'d3ra, \'e9s \'d5 bocs\'e1tja le a z\'e1pores\'f5t, \'e9s \'d5 tudja, mi van az anyam\'e9hekben. \'c9s senki sem tudja, hogy mire tesz szert holnap \'e9s senki sem tudja, hogy mely f\'f6ld\'f6
n fog meghalni. Bizony, Allah Mindentud\'f3, [mindent] j\'f3l Ismer\'f5.
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid4358122 
\page }{\f0\fs24\insrsid13659446\charrsid4358122 32. A leborul\'e1s (asz-Szedzsda) c. sz\'fara}{\insrsid13659446\charrsid4358122 
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid4358122 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. Alif-l\'e1m-m\'edm.
\par 2. Az \'cdr\'e1s (a Kor\'e1n) a teremtm\'e9nyek Ur\'e1nak lebocs\'e1tott [kinyilatkoztat\'e1sa], melyhez nem f\'e9r k\'e9ts\'e9g.
\par 3. Vagy azt mondj\'e1k: \'84\'d5 maga tal\'e1lta ki!\'94 De nem! Ez az Igazs\'e1g, ami az Uradt\'f3l val\'f3 [\'f3 Mohamed], hogy egy olyan n\'e9pet figyelmeztess, amelyhez el\'f5tted m\'e9g nem j\'f6tt figyelmeztet\'f5, h\'e1tha az igaz \'fatra lelnek.

\par 
\par 4. Allah az, aki megteremtette az egeket \'e9s a f\'f6ldet \'e9s ami k\'f6z\'f6tt\'fck van, hat nap alatt, azut\'e1n elhelyezkedett [Hozz\'e1 m\'e9lt\'f3an] a Tr\'f3nuson. Nincs nektek Helyette m\'e1s p\'e1rtfog\'f3tok, sem k\'f6zbenj\'e1r\'f3tok. Vajon h
\'e1t nem okultok [az int\'e9sb\'f5l]?
\par 5. [Egyed\'fcl \'d5] rendezi a [teremtm\'e9nyeinek] \'fcgyeit az \'e9gb\'f5l a f\'f6ldig. Azt\'e1n [minden \'fcgy] ism\'e9t felemelkedik hozz\'e1 egy nap alatt, amelynek a m\'e9rt\'e9ke ezer esztend\'f5 abb\'f3l, amit ti sz\'e1moltok.
\par {\*\bkmkstart 610}{\*\bkmkend 610}6. Ez [Allah,] a rejtett \'e9s a l\'e1that\'f3 dolgok Tud\'f3ja, a M\'e9lt\'f3s\'e1gteljes, a K\'f6ny\'f6r\'fcletes.
\par {\*\bkmkstart 82}{\*\bkmkend 82}7 Aki t\'f6k\'e9letess\'e9 tett mindent, amit megteremtett. \'c9s aki agyagb\'f3l kezdte az ember teremt\'e9s\'e9t,
\par 8. Azt\'e1n ut\'f3dait megvetett v\'edz kivonat\'e1b\'f3l,
\par 9. Azt\'e1n megform\'e1lta \'f5t, \'e9s bel\'e9 lehelt [az \'e1ltala teremtett] l\'e9lekb\'f5l. \'c9s megadta nektek a hall\'e1st, a l\'e1t\'e1st \'e9s a sz\'edvet (az \'e9rtelmet). Mily kev\'e9ss\'e9 adtok h\'e1l\'e1t!
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 {\insrsid13659446\charrsid4358122 
\par 10. \'c9s azt mondj\'e1k: \'84Vajon, ha elt\'fbn\'fcnk a f\'f6ldben, akkor val\'f3ban \'faj teremt\'e9sben lesz\'fcnk [felt\'e1masztva]?\'94 De nem! \'d5k nem hisznek az Urukkal val\'f3 tal\'e1lkoz\'e1sban.
\par 11. Mondd: {\*\bkmkstart 123}{\*\bkmkend 123}\'84Mag\'e1hoz sz\'f3l\'edt titeket a hal\'e1l angyala, akire r\'e1 lettetek b\'edzva, azt\'e1n Uratokhoz lesztek visszavitetve.\'94
\par 12. \'c9s ha l\'e1tn\'e1d azt, amikor a b\'fbn\'f6s\'f6k lehorgasztj\'e1k fej\'fcket Uruk el\'f5tt: \'84Urunk! L\'e1ttunk \'e9s hallottunk! Vitess vissza minket [az evil\'e1gba], hogy j\'f3t cselekedj\'fcnk! Bizony, nek\'fcnk [most m\'e1r] szil\'e1
rd bizonyoss\'e1gunk van!\'94
\par 13. \'c9s ha akartuk volna, minden embernek megadtuk volna az \'fatmutat\'e1s\'e1t, \'e1m jogoss\'e1 v\'e1lik majd a T\'f5lem val\'f3 sz\'f3 [a hitetlenek b\'fcntet\'e9s\'e9vel kapcsolatban]: \'84Bizony, a Gyehenn\'e1t megt\'f6lt\'f6m dzsinnekkel \'e9
s emberekkel, mindannyiukkal.
\par 14. \'cdzlelj\'e9tek h\'e1t meg [a Pokol-t\'fbz gy\'f6trelm\'e9t], ami\'e9rt elfelejtett\'e9tek az ezzel a nappal val\'f3 tal\'e1lkoz\'e1sotokat! Bizony Mi is elfelejt\'fcnk titeket. \'c9s \'edzlelj\'e9tek meg az \'f6r\'f6k gy\'f6trelmet az\'e9
rt, amit cselekedtetek!\'94
\par {\*\bkmkstart 163}{\*\bkmkend 163}
\par 15. Csup\'e1n azok hisznek a mi Jeleinkben, akik, ha eml\'e9keztetve lesznek azokra, f\'f6ldre rogynak leborulva, \'e9s magasztalj\'e1k Urukat, az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, \'e9s \'f5k nem fennh\'e9j\'e1znak.
\par 16. Az oldaluk elhagyja a fekhely\'fcket, [mik\'f6zben] Urukhoz foh\'e1szkodnak f\'e9lve \'e9s rem\'e9lve, \'e9s adakoznak abb\'f3l, amivel ell\'e1ttuk \'f5ket.
\par 17. \'c9s egy ember sem tudja, hogy milyen szemet }{\cs100\insrsid13659446\charrsid4358122 gy\'f6ny\'f6rk\'f6dtet\'f5 [jutalom] van elrejtve}{\insrsid13659446\charrsid4358122  fizets\'e9gk\'e9ppen az\'e9rt, amit cselekedtek.
\par 
\par 18. Vajon az, aki h\'edv\'f5, olyan, mint az, aki engedetlen? [Nem!] \'d5k nem egyenl\'f5ek!
\par 19. Ami azokat illeti, akik hisznek \'e9s j\'f3tetteket cselekszenek, h\'e1t nekik hajl\'e9kot ad\'f3 kertek j\'e1rnak [a Paradicsomban] sz\'e1ll\'e1shely\'fcl az\'e9rt, amit cselekedtek.
\par 20. \'c9s ami azokat illeti, akik engedetlens\'e9get k\'f6vettek el, h\'e1t [azoknak] a hajl\'e9kuk a [Pokol-]t\'fbz lesz. Valah\'e1nyszor ki akarnak onnan jutni, visszavitetnek oda, \'e9s az lesz nekik mondva: \'84\'cdzlelj\'e9tek meg a [Pokol-]t\'fbz gy
\'f6trelm\'e9t, amit [kor\'e1bban] meghazudtoltatok!\'94
\par {\*\bkmkstart 223}{\*\bkmkend 223}21. \'c9s bizony meg\'edzleltetj\'fck vel\'fck a k\'f6zelebbi (az evil\'e1gi) gy\'f6trelmet, a nagyobb gy\'f6trelem el\'f5tt, h\'e1tha visszat\'e9rnek.
\par 22. \'c9s ki igazs\'e1gtalanabb ann\'e1l, mint aki eml\'e9keztetve lett Ura jeleire, \'e1m \'f5 elfordult azokt\'f3l? Bizony, Mi el\'e9gt\'e9telt vesz\'fcnk a {\*\bkmkstart 232}{\*\bkmkend 232}gonosztev\'f5k\'f6n.
\par 
\par 23 \'c9s bizony odaadtuk M\'f3zesnek az \'cdr\'e1st (a T\'f3r\'e1t), ne legyen h\'e1t k\'e9ts\'e9ged afel\'f5l, hogy tal\'e1lkoz\'e1sod lesz vele, \'e9s \'fatmutat\'e1ss\'e1 tett\'fck azt Izrael fiainak{\*\bkmkstart 243}{\*\bkmkend 243}.
\par 24. \'c9s [olyanokat] tett\'fcnk meg vezet\'f5knek k\'f6z\'fcl\'fck, [akik] parancsunk szerint [igaz \'fatra] vezetnek, miut\'e1n t\'fcrelmesek voltak \'e9s szil\'e1rd bizonyoss\'e1guk volt a jeleinkben.
\par {\*\bkmkstart 263}{\*\bkmkend 263}25. Bizony, Urad az, aki d\'f6nteni fog k\'f6z\'f6tt\'fck a Felt\'e1mad\'e1s Napj\'e1n abban, amiben \'f6sszek\'fcl\'f6nb\'f6ztek.
\par 26. H\'e1t vajon nem szolg\'e1lt nekik \'fatmutat\'e1sk\'e9nt az, hogy h\'e1ny el\'f5tt\'fck \'e9lt nemzed\'e9ket puszt\'edtottunk el, akiknek lakhelyein j\'e1rnak-kelnek? Bizony, jelek vannak ebben. H\'e1t nem hallanak?
\par 27. H\'e1t vajon nem l\'e1tt\'e1k, hogy Mi a vizet a kop\'e1r f\'f6ldre vezetj\'fck \'e9s gabon\'e1t sarjasztunk \'e1ltala, amelyb\'f5l j\'f3sz\'e1gaik \'e9s saj\'e1t maguk [is] t\'e1pl\'e1lkoznak? H\'e1t nem l\'e1tnak?
\par 
\par 28. \'c9s azt mondj\'e1k: {\*\bkmkstart 293}{\*\bkmkend 293}\'84Mikor lesz ez a d\'f6nt\'e9s, ha val\'f3ban igazmond\'f3k vagytok?\'94
\par 29. Mondd [\'f3 Mohamed]: \'84A d\'f6nt\'e9s napj\'e1n nem haszn\'e1l azoknak a hite, akik hitetlenn\'e9 v\'e1ltak, \'e9s nem kapnak halad\'e9kot.\'94
\par 30. Fordulj h\'e1t el t\'f5l\'fck \'e9s v\'e1rakozz! Bizony, \'f5k [is] v\'e1rakoznak.
\par 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid4358122 
\page }{\f0\fs24\insrsid13659446\charrsid4358122 33. A Sz\'f6vets\'e9gesek (al-Ahz\'e1b) c. sz\'fara}{\insrsid13659446\charrsid4358122 
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid4358122 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 {\insrsid13659446\charrsid4358122 1. \'d3 Pr\'f3f\'e9ta! F\'e9ld Allahot \'e9s ne engedelmeskedj a hitetleneknek \'e9s a k\'e9pmutat\'f3
knak! Bizony, Allah Mindentud\'f3, B\'f6lcs.{\*\bkmkstart 21}{\*\bkmkend 21}
\par 2. \'c9s k\'f6vesd azt, ami sugaltatik neked [kinyilatkoztat\'e1sk\'e9nt] az Uradt\'f3l! Bizony Allah j\'f3l ismeri mindazt, amit cselekszetek.
\par 3. \'c9s hagyatkozz Allahra! \'c9s Allah elegend\'f5 v\'e9delmez\'f5nek.
\par 
\par 4. Allah nem helyezett egyetlen f\'e9rfi belsej\'e9be se k\'e9t sz\'edvet, \'e9s nem tette any\'e1itokk\'e1 azokat a feles\'e9geiteket, akikt\'f5l elv\'e1ltok [azt mondv\'e1n: olyan tilalmas vagy nekem, mint az any\'e1m h\'e1ta!], \'e9
s fogadott fiaitokat sem tette [val\'f3di] fiaitokk\'e1. Ezek a ti szavaitok, amelyek elhagyt\'e1k a sz\'e1tokat. \'c1m Allah kimondja az igazs\'e1got \'e9s az igaz \'fatra vezet.
\par 5. [A fogadott gyermekeiteket] sz\'f3l\'edts\'e1tok [v\'e9r szerinti] apjuk ut\'e1n! Ez m\'e9lt\'e1nyosabb Allah el\'f5tt, ha azonban nem tudj\'e1tok, ki az apjuk, akkor \'f5k testv\'e9reitek a vall\'e1sban, \'e9s v\'e9denceitek. \'c9
s nem terhel titeket v\'e9ts\'e9g az\'e1ltal, ha hib\'e1ztok [e tekintetben], hanem [csak] azt [illet\'f5en], amit a sz\'edvetek sz\'e1nd\'e9kosan [akar]. \'c9s Allah Megbocs\'e1t\'f3, K\'f6ny\'f6r\'fcletes.
\par 6. A pr\'f3f\'e9ta el\'f5bbre val\'f3 a h\'edv\'f5kn\'e9l, [m\'e9g] saj\'e1t magukn\'e1l [is]. \'c9s [a pr\'f3f\'e9ta] feles\'e9gei [a h\'edv\'f5k] any\'e1i. \'c1m Allah \'cdr\'e1s\'e1ban a v\'e9rrokonok el\'f5bbre val\'f3k egym\'e1s sz\'e1m\'e1ra [az 
\'f6r\'f6k\'f6s\'f6d\'e9st illet\'f5en], mint a h\'edv\'f5k \'e9s a kiv\'e1ndorl\'f3k, kiv\'e9ve, ha sz\'edvess\'e9get tesztek v\'e9denceiteknek [v\'e9grendelettel]. Ez egy \'cdr\'e1sban (az \'d5rz\'f6tt T\'e1bl\'e1n) van feljegyezve.
\par 
\par 7. \'c9s [eml\'e9kezz arra,] amikor sz\'f6vets\'e9get k\'f6t\'f6tt\'fcnk a pr\'f3f\'e9t\'e1kkal, \'e9s veled, \'e9s No\'e9val, \'c1brah\'e1mmal, M\'f3zessel \'e9s J\'e9zussal, M\'e1ria fi\'e1val, \'e9s szil\'e1rd sz\'f6vets\'e9get k\'f6t\'f6tt\'fcnk vel
\'fck,
\par 8. Hogy [Allah] megk\'e9rdezze az igazakat igazmond\'e1sukr\'f3l. \'c9s a hitetleneknek f\'e1jdalmas gy\'f6trelmet k\'e9sz\'edtett el\'f5.
\par 
\par 9. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Eml\'e9kezzetek Allah j\'f3t\'e9tem\'e9ny\'e9re ir\'e1ntatok, amikor csapatok j\'f6ttek hozz\'e1tok, mi pedig [puszt\'edt\'f3] szelet \'e9
s olyan katon\'e1kat k\'fcldt\'fcnk r\'e1juk, amelyeket nem l\'e1ttatok. \'c9s Allah l\'e1tja mindazt, amit cselekszetek.
\par 10. [Eml\'e9kezzetek arra], amikor elj\'f6ttek hozz\'e1tok fel\'fclr\'f5l \'e9s alulr\'f3l \'e9s amikor kimeredtek a szemek, a sz\'edvek el\'e9rt\'e9k a torkokat, \'e9s [mindenf\'e9le] v\'e9leked\'e9st v\'e9lekedtetek Allahr\'f3l!
\par 11. Pr\'f3b\'e1ra lettek t\'e9ve ott a h\'edv\'f5k, \'e9s s\'falyos megr\'e1zk\'f3dtat\'e1ssal rend\'fcltek meg.
\par 12. \'c9s [eml\'e9kezzetek arra], amikor a k\'e9pmutat\'f3k \'e9s azok, akiknek a sz\'edv\'e9ben betegs\'e9g van, azt mondt\'e1k: \'84Allah \'e9s a k\'fcld\'f6tte nem \'edg\'e9rt nek\'fcnk m\'e1st, csup\'e1n megt\'e9veszt\'e9st!\'94
\par 13. \'c9s [eml\'e9kezzetek arra], amikor az egyik csoportjuk azt mondta: \'84\'d3 Jeszrib (Medina) lak\'f3i! Nem fogj\'e1tok tudni tartani [hadi] \'e1ll\'e1saitokat, t\'e9rjetek h\'e1t vissza!\'94 Egy [m\'e1sik] csoport k\'f6z\'fcl\'fck pedig enged\'e9
lyt k\'e9rt a pr\'f3f\'e9t\'e1t\'f3l [a hazat\'e9r\'e9sre], azt mondv\'e1n: \'84A h\'e1zaink v\'e9dtelenek\'94, pedig azok nem voltak v\'e9dtelenek! Nem akarnak m\'e1st, mint menek\'fcl\'e9st.
\par 14. \'c9s ha [az ellens\'e9g] bevonult volna ellen\'fck [a v\'e1ros k\'fcl\'f6nb\'f6z\'f5] sz\'e9lein \'e1t, \'e9s arra lettek volna k\'e9rve, hogy essenek k\'eds\'e9rt\'e9sbe (hagyjanak fel a hit\'fckkel), akkor megtett\'e9k volna \'e9s nem k\'e9
slekedtek volna abban, csup\'e1n egy keveset.
\par 15. \'c9s bizony, azel\'f5tt egyezs\'e9get k\'f6t\'f6ttek Allahhal arra, hogy nem ford\'edtanak h\'e1tat. \'c9s az Allahhal [k\'f6t\'f6tt] egyezs\'e9g sz\'e1mon lesz k\'e9rve!
\par 16. Mondd [\'f3 Mohamed]: \'84Nem fog haszn\'e1lni nektek a menekv\'e9s, ha a hal\'e1l vagy a meg\'f6let\'e9s el\'f5l menek\'fclt\'f6k, \'e9s [ha meg is menek\'fclt\'f6k] akkor sem fogj\'e1tok \'e9lvezni [az \'e9letet], csup\'e1n egy keveset.\'94
\par 17. Mondd [\'f3 Mohamed]: \'84Ki az, aki v\'e9delmezhet titeket Allaht\'f3l, ha valami rosszat akar nektek [b\'fcntet\'e9s\'fcl], vagy k\'f6ny\'f6r\'fcletet akar [tan\'fas\'edtani] ir\'e1ntatok?\'94 Allahon k\'edv\'fcl nem tal\'e1lnak maguknak sem p\'e1
rtfog\'f3t, sem seg\'edt\'f5t.
\par 
\par 18. Bizony Allah ismeri a g\'e1ncsvet\'f5ket k\'f6z\'fcletek, \'e9s azokat akik azt mondj\'e1k a testv\'e9reiknek: \'84Gyertek [csatlakozzatok] hozz\'e1nk!\'94 \'c9s nem vesznek r\'e9szt a harcban, csup\'e1n kevesen,
\par 19. Kapzsi irigys\'e9get [\'e9rezve] ir\'e1ntatok [a zs\'e1km\'e1ny miatt]. \'c9s amikor elj\'f6n a f\'e9lelem (a harc), akkor l\'e1tni fogod, hogy forg\'f3 szemekkel n\'e9znek r\'e1d, mint az, aki el\'e1jul a hal\'e1lt\'f3l [val\'f3 f\'e9lelm\'e9
ben]. De amikor elm\'falik a f\'e9lelem, \'e9les nyelvvel szurk\'e1lnak titeket, kapzsi irigys\'e9ggel [v\'e1gyakozva] a javakra [a zs\'e1km\'e1nyb\'f3l]. Azok nem hisznek, Allah pedig hi\'e1baval\'f3v\'e1 teszi a tetteiket. \'c9s ez k\'f6nny\'fb
 Allahnak!
\par 20. Azt gondolj\'e1k, hogy a sz\'f6vets\'e9gesek nem vonultak el. \'c9s ha [ism\'e9t] elj\'f6nn\'e9nek a sz\'f6vets\'e9gesek, azt szeretn\'e9k, ha nom\'e1dok lenn\'e9nek a beduinok k\'f6z\'f6tt [a sivatagban], a h\'edreitek fel\'f5l k\'e9rdez\'f5sk\'f6dv
\'e9n. \'c9s ha k\'f6z\'f6ttetek lenn\'e9nek, nem harcoln\'e1nak, csak egy keveset.
\par {\*\bkmkstart 224}{\*\bkmkend 224}
\par 21. Bizony, Allah K\'fcld\'f6tt\'e9ben sz\'e9p p\'e9ldak\'e9p van sz\'e1motokra \endash  annak, aki rem\'e9nykedik Allahban \'e9s a V\'e9gs\'f5 Napban, \'e9s sokszor megeml\'e9kezik Allahr\'f3l.
\par 22. \'c9s miut\'e1n a h\'edv\'f5k megl\'e1tt\'e1k a sz\'f6vets\'e9geseket, azt mondt\'e1k: \'84Ez az, amit Allah \'e9s a K\'fcld\'f6tte \'edg\'e9rt nek\'fcnk. Allah \'e9s a K\'fcld\'f6tte igazat mondott!\'94 \'c9s [ez] nem gyarap\'edtotta \'f5ket m\'e1
sban, mint hitben \'e9s al\'e1vet\'e9sben (engedelmess\'e9gben).
\par 23. Vannak a h\'edv\'f5k k\'f6z\'f6tt olyan f\'e9rfiak, akik h\'fbek ahhoz az egyezs\'e9ghez, amit Allahhal k\'f6t\'f6ttek. Vannak k\'f6z\'f6tt\'fck olyanok, akik hal\'e1lukat lelt\'e9k, \'e9s vannak k\'f6z\'f6tt\'fck olyanok, akik v\'e1rakoznak, \'e9
s nem v\'e1ltoztatt\'e1k meg [az elk\'f6telezetts\'e9g\'fcket semmif\'e9le] megv\'e1ltoztat\'e1ssal.
\par 24. Az\'e9rt, hogy Allah fizets\'e9get adjon az igazmond\'f3knak igazmond\'e1suk\'e9rt, \'e9s hogy megb\'fcntesse a k\'e9pmutat\'f3kat, ha \'fagy akarja, vagy kiengesztel\'f5dj\'f6n ir\'e1ntuk. Bizony, Allah Megbocs\'e1t\'f3, K\'f6ny\'f6r\'fcletes.
\par 
\par 25. \'c9s Allah visszaford\'edtotta azokat, akik hitetlenn\'e9 v\'e1ltak, a d\'fch\'fckkel egy\'fctt, an\'e9lk\'fcl, hogy b\'e1rmi j\'f3ra szert tettek volna. \'c9s Allah megk\'edm\'e9lte a h\'edv\'f5ket a harct\'f3l. \'c9s Allah Er\'f5s, M\'e9lt\'f3s\'e1
gteljes.
\par 26. \'c9s arra k\'e9nyszer\'edtette azokat, akik az \'edr\'e1s n\'e9p\'e9b\'f5l seg\'edtett\'e9k \'f5ket, hogy lej\'f6jjenek az er\'f5d\'edtm\'e9nyeikb\'f5l, \'e9s \'d5 r\'e9m\'fcletet vetett a sz\'edv\'fckbe; egy csoportot [k\'f6z\'fcl\'fck] meg\'f6
ltetek, egy [m\'e1sik] csoportot pedig foglyul ejtettetek.
\par 27. \'c9s \'f6r\'f6k\'fcl adtuk nektek a f\'f6ldj\'fcket, a lakhelyeiket, a vagyonukat \'e9s egy olyan f\'f6ldet, amelyre m\'e9g nem l\'e9ptetek. \'c9s Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 
\par 28. \'d3 Pr\'f3f\'e9ta! Mondd a feles\'e9geidnek: \'84Ha az evil\'e1gi \'e9letet \'e9s annak d\'edsz\'e9t akarj\'e1tok, akkor gyertek, ell\'e1tlak titeket [aj\'e1nd\'e9kkal k\'e1rp\'f3tl\'e1sk\'e9nt] \'e9s sz\'e9p elbocs\'e1t\'e1ssal bocs\'e1
talak el titeket.
\par 29. Ha azonban Allahnak \'e9s az \'d5 K\'fcld\'f6tt\'e9nek [el\'e9gedetts\'e9g\'e9t] akarj\'e1tok, \'e9s a t\'falvil\'e1gi lakhelyet, bizony Allah hatalmas fizets\'e9get k\'e9sz\'edtett el\'f5 a j\'f3tev\'f5 n\'f5knek k\'f6z\'fcletek.\'94
\par 30. \'d3 pr\'f3f\'e9ta asszonyai! Aki k\'f6z\'fcletek nyilv\'e1nval\'f3 f\'f6rtelmes tettet k\'f6vet el, annak meg lesz sokszorozva a gy\'f6trelme, k\'e9tszeresen. \'c9s ez k\'f6nny\'fb Allahnak!
\par 31. Aki azonban k\'f6z\'fcletek al\'e1zatosan engedelmeskedik Allahnak \'e9s a K\'fcld\'f6tt\'e9nek \'e9s j\'f3t cselekszik, annak k\'e9tszer adjuk meg a jutalm\'e1t \'e9s nemes ell\'e1t\'e1st k\'e9sz\'edtett\'fcnk el\'f5 neki.
\par 
\par 32. \'d3 pr\'f3f\'e9ta asszonyai! Ti nem vagytok olyanok, mint b\'e1rki m\'e1s az asszonyok k\'f6z\'fcl. Ha f\'e9litek [Allahot], akkor ne besz\'e9ljetek gyeng\'e9den [az idegenekkel], nehogy az, akinek a sz\'edv\'e9ben betegs\'e9g van, v\'e1gyat \'e9
rezzen [ir\'e1ntatok], \'e9s mondjatok hely\'e9nval\'f3 szavakat!
\par 33. \'c9s maradjatok a h\'e1zaitokban, \'e9s ne mutass\'e1tok meg [d\'edszeiteket] \'fagy, ahogyan a kor\'e1bbi tudatlans\'e1g kor\'e1ban (az iszl\'e1m el\'f5tti korszakban) volt szok\'e1s megmutatni! \'c9s v\'e9gezz\'e9tek el az im\'e1dkoz\'e1st, \'e9
s adj\'e1tok meg a k\'f6telez\'f5 adom\'e1nyt, \'e9s engedelmeskedjetek Allahnak \'e9s a K\'fcld\'f6tt\'e9nek! Allah csup\'e1n azt akarja, hogy elt\'e1vol\'edtsa r\'f3latok \endash  \'f3 [Pr\'f3f\'e9ta] H\'e1za n\'e9pe! - a tiszt\'e1talans\'e1got, \'e9
s hogy megtiszt\'edtson titeket [teljesen] tiszt\'e1v\'e1 t\'e9ve.
\par 34. \'c9s eml\'edts\'e9tek meg azt, ami recit\'e1ltatik a h\'e1zaitokban Allah jeleib\'f5l (szavaib\'f3l) \'e9s a b\'f6lcsess\'e9gb\'f5l! Bizony, Allah K\'edm\'e9letes, [mindent] j\'f3l Ismer\'f5.
\par 
\par 35. Bizony, a muszlim f\'e9rfiak \'e9s a muszlim n\'f5k, a h\'edv\'f5 f\'e9rfiak \'e9s a h\'edv\'f5 n\'f5k, az al\'e1zatosan engedelmes f\'e9rfiak \'e9s az al\'e1zatosan engedelmes n\'f5k, az igazmond\'f3 f\'e9rfiak \'e9s az igazmond\'f3 n\'f5k, a t\'fc
relmes f\'e9rfiak \'e9s a t\'fcrelmes n\'f5k, az \'e1h\'edtatos f\'e9rfiak \'e9s az \'e1h\'edtatos n\'f5k, az adakoz\'f3 f\'e9rfiak \'e9s az adakoz\'f3 n\'f5k, a b\'f6jt\'f6l\'f5 f\'e9rfiak \'e9s a b\'f6jt\'f6l\'f5 n\'f5k, a szem\'e9rm\'fc
ket [tiltott nemi kapcsolatt\'f3l] meg\'f5rz\'f5 f\'e9rfiak \'e9s a [szem\'e9rm\'fcket] meg\'f5rz\'f5 n\'f5k, \'e9s az Allahr\'f3l sokszor megeml\'e9kez\'f5 f\'e9rfiak \'e9s a sokszor megeml\'e9kez\'f5 n\'f5k sz\'e1m\'e1ra Allah megbocs\'e1t\'e1st \'e9
s hatalmas jutalmat k\'e9sz\'edtett el\'f5.
\par 
\par 36. \'c9s nem lehet egy h\'edv\'f5 f\'e9rfinak, sem egy h\'edv\'f5 n\'f5nek v\'e1laszt\'e1sa valamely dolgukban, ha Allah \'e9s a K\'fcld\'f6tte [m\'e1r] d\'f6nt\'f6tt abban. Aki ellenszeg\'fcl Allahnak \'e9s a K\'fcld\'f6tt\'e9nek, az bizony nyilv\'e1
nval\'f3 t\'e9velyg\'e9ssel t\'e9velyeg.
\par 37. \'c9s [eml\'e9kezz arra, \'f3 Mohamed], amikor azt mondtad annak, akit Allah j\'f3t\'e9tem\'e9nyekben r\'e9szes\'edtett, \'e9s akit te is j\'f3t\'e9tem\'e9nyekben r\'e9szes\'edtett\'e9l: \'84Tartsd meg magadnak a feles\'e9gedet, \'e9s f\'e9ld Allahot!
\'94 \'c1m elrejted magadban azt, amit Allah nyilv\'e1noss\'e1gra fog hozni, \'e9s f\'e9lsz az emberekt\'f5l, pedig Allaht\'f3l kellene f\'e9lned. \'c9s miut\'e1n Zejd befejezte a h\'e1zass\'e1gi kapcsolat\'e1t vele, [a v\'e1l\'e1st k\'f6vet\'f5 v\'e1
rakoz\'e1si id\'f5 letelte ut\'e1n] hozz\'e1d adtuk \'f5t feles\'e9g\'fcl, hogy ne \'e9rezzenek a h\'edv\'f5 f\'e9rfiak fesz\'e9lyezetts\'e9get [amiatt, hogy feles\'e9g\'fcl veszik] fogadott fiaik feles\'e9geit, ha azok befejezt\'e9k vel\'fck a h\'e1zass
\'e1gi kapcsolatot. \'c9s Allah elrendel\'e9se mindig beteljesedik!
\par {\*\bkmkstart 392}{\*\bkmkend 392}38. Ne \'e9rezzen a Pr\'f3f\'e9ta fesz\'e9lyezetts\'e9get amiatt, amit Allah el\'f5\'edrt neki! Ez Allah [\'e1ltal elrendelt] t\'f6rv\'e9nyszer\'fbs\'e9g [amelyben r\'e9szes\'edtette] azokat [a pr\'f3f\'e9t\'e1
kat,] akik kor\'e1bban t\'e1voztak el [az \'e9l\'f5k sor\'e1b\'f3l]. \'c9s Allah parancsa elrendelt elrendel\'e9s!
\par 39. [Ezek a pr\'f3f\'e9t\'e1k azok,] akik \'e1tadj\'e1k Allah \'fczeneteit, \'e9s f\'e9lnek T\'f5le, \'e9s Allahon k\'edv\'fcl nem f\'e9lnek senkit\'f5l. \'c9s elegend\'f5 Allah elsz\'e1moltat\'f3nak!
\par 40. Mohamed nem apja egyetlen f\'e9rfinak sem k\'f6z\'fcletek, hanem Allah K\'fcld\'f6tte \'e9s a pr\'f3f\'e9t\'e1k pecs\'e9tje! Bizony, Allahnak minden dologr\'f3l tudom\'e1sa van.
\par 
\par 41. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Eml\'e9kezzetek meg Allahr\'f3l,}{\insrsid13659446 {\*\bkmkstart 422}{\*\bkmkend 422} sokszori}{\insrsid13659446\charrsid4358122  megeml
\'e9kez\'e9ssel!}{\insrsid13659446 
\par 42. \'c9s magasztalj\'e1tok \'f5t hajnalban \'e9s k\'e9s\'f5 d\'e9lut\'e1n!{\*\bkmkstart 432}{\*\bkmkend 432}
\par 43. \'d5 az, aki \'e1ld\'e1sait (dics\'e9ret\'e9t \'e9s k\'f6ny\'f6r\'fclet\'e9t) k\'fcldi re\'e1tok, \'e9s angyalai [im\'e1dkoznak \'e9rtetek], hogy kihozzon titeket a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gekb\'f5l a f\'e9nyre. \'c9
s Allah irgalmas a h\'edv\'f5k ir\'e1nt.
\par {\*\bkmkstart 442}{\*\bkmkend 442}44. A k\'f6sz\'f6nt\'e9s\'fck azon a napon, amikor tal\'e1lkoznak \'d5vele [az lesz]: \'84B\'e9kess\'e9g\'94, \'e9s [Allah] nemes jutalmat k\'e9sz\'edtett el\'f5 nekik.
\par 
\par 45. \'d3 te, Pr\'f3f\'e9ta! Bizony, Mi elk\'fcldt\'fcnk t\'e9ged tan\'fak\'e9nt, \'e9s \'f6r\'f6mh\'edrhoz\'f3k\'e9nt \'e9s figyelmeztet\'f5k\'e9nt,
\par 46. \'c9s Allahhoz h\'edv\'f3k\'e9nt az \'d5 engedelm\'e9vel, \'e9s vil\'e1goss\'e1got ad\'f3 l\'e1mp\'e1sk\'e9nt.
\par 47. \'c9s adj \'f6r\'f6mh\'edrt a h\'edv\'f5knek arr\'f3l, hogy nagy kegy j\'e1r nekik Allaht\'f3l!
\par 48. \'c9s ne engedelmeskedj a hitetleneknek \'e9s a k\'e9pmutat\'f3knak, \'e9s ne t\'f6r\'f5dj a b\'e1ntalmaz\'e1sukkal, \'e9s hagyatkozz Allahra!{\*\bkmkstart 492}{\*\bkmkend 492} \'c9s Allah elegend\'f5 v\'e9delmez\'f5nek.
\par 
\par 49. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha h\'edv\'f5 n\'f5ket vesztek feles\'e9g\'fcl, majd elv\'e1ltok t\'f5l\'fck m\'e9g azel\'f5tt, hogy \'e9rintett\'e9tek volna \'f5
ket, akkor [az \'fajra h\'e1zasod\'e1sukhoz] nem kell kiv\'e1rniuk a v\'e1rakoz\'e1si id\'f5t, ami titeket illetne. L\'e1ss\'e1tok h\'e1t el \'f5ket [aj\'e1nd\'e9kkal k\'e1rp\'f3tl\'e1sul], \'e9s sz\'e9p elbocs\'e1t\'e1ssal bocs\'e1ss\'e1tok el \'f5ket!

\par 50. \'d3 te, Pr\'f3f\'e9ta! Bizony, Mi megengedett\'e9 tett\'fck sz\'e1modra a feles\'e9geidet, akiknek odaadtad a fizets\'e9g\'fcket (jegyaj\'e1nd\'e9kukat), \'e9s akiket a jobbod birtokol azok k\'f6z\'fcl, akiket Allah juttatott neked, \'e9
s az apai nagyb\'e1ty\'e1id le\'e1nyait \'e9s apai nagyn\'e9n\'e9id le\'e1nyait, \'e9s az anyai nagyb\'e1ty\'e1id le\'e1nyait \'e9s az anyai nagyn\'e9n\'e9id le\'e1nyait, akik veled egy\'fctt v\'e1ndoroltak ki [Medin\'e1ba], \'e9s olyan h\'edv\'f5
 asszonyt, aki odaaj\'e1nd\'e9kozza mag\'e1t [feles\'e9gk\'e9nt] a pr\'f3f\'e9t\'e1nak [lemondva a jegyaj\'e1nd\'e9k\'e1r\'f3l], \'e9s a pr\'f3f\'e9ta is feles\'e9g\'fcl akarja \'f5t venni, [ez ut\'f3bbi] a h\'edv\'f5k k\'f6z\'fcl kiz\'e1r\'f3lag t\'e9
ged illet meg. Bizony, tudjuk, hogy mit \'edrtunk el\'f5 sz\'e1mukra feles\'e9geiket \'e9s azokat illet\'f5en, akiket jobbjuk birtokol, hogy ne \'e9rezz fesz\'e9lyezetts\'e9get [a h\'e1zass\'e1goddal kapcsolatban]. \'c9s Allah Megbocs\'e1t\'f3, Irgalmas.

\par 51. Elhalaszthatod [a h\'e1zass\'e1gk\'f6t\'e9st] azzal k\'f6z\'fcl\'fck (a feles\'e9gnek aj\'e1nlkoz\'f3k k\'f6z\'fcl), akivel akarod \'e9s magadhoz veheted azt, akit akarsz, \'e9s ha olyasvalakit k\'edv\'e1nsz feles\'e9g\'fcl, akit kor\'e1bban elk\'fc
ldt\'e9l, nem r\'f3hat\'f3 f\'f6l v\'e9tked\'fcl. \'cdgy }{\insrsid13659446\charrsid7552877 \'e9rhet\'f5 el legink\'e1bb, hogy }{\cs100\insrsid13659446\charrsid7552877 \'f6r\'f6m\'f6t leljenek (}{\insrsid13659446\charrsid7552877 megnyugodjanak), \'e9
s ne szomorkodjanak, \'e9s megel\'e9gedjenek mindazzal}{\insrsid13659446 , amit adt\'e1l nekik. Allah tudja, hogy mi van a sz\'edvetekben. Allah Mindentud\'f3, B\'e9ket\'fbr\'f5.
\par 52. Nem megengedettek az asszonyok sz\'e1modra ezen k\'edv\'fcl, \'e9s nem cser\'e9lheted fel \'f5ket feles\'e9gekkel, m\'e9g akkor sem, ha tetszene neked a sz\'e9ps\'e9g\'fck, kiv\'e9ve azokat akiket a jobbod birtokol! Allah minden dolog felett tan\'fa.

\par 
\par 53. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne l\'e9pjetek be a Pr\'f3f\'e9ta h\'e1zaiba, kiv\'e9ve ha enged\'e9lyt kaptok \'e9tel [elfogyaszt\'e1s\'e1ra], nem v\'e1rva annak elk\'e9
sz\'edt\'e9s\'e9t! Azonban, ha megh\'edv\'e1st kaptok, akkor l\'e9pjetek be, amikor pedig m\'e1r ettetek, akkor sz\'e9ledjetek sz\'e9t (t\'e1vozzatok) \'e9s ne elegyedjetek tapintatlanul besz\'e9lget\'e9sbe! Bizony, ez a dolog b\'e1ntja a Pr\'f3f\'e9t\'e1
t, \'e1m \'f5 sz\'e9gyell\'f5s el\'f5ttetek [ez\'e9rt nem k\'fcld el titeket]. Allah azonban nem sz\'e9gyelli az igazs\'e1got. \'c9s ha k\'e9rtek valami eszk\'f6zt a feles\'e9geit\'f5l, akkor f\'fcgg\'f6ny m\'f6g\'fcl k\'e9rj\'e9tek! Ez tiszt\'e1
bb a ti sz\'edvetek \'e9s az \'f5 sz\'edv\'fck sz\'e1m\'e1ra is. \'c9s nem szabad b\'e1ntanotok Allah K\'fcld\'f6tt\'e9t, \'e9s nem szabad }{\insrsid13659446\charrsid7552877 sohasem megh\'e1zasodnotok az \'f5 feles\'e9geivel, \'f5ut\'e1na (a hal\'e1l\'e1
t k\'f6vet\'f5en)! Ez s\'falyos [v\'e9tek] lenne a r\'e9szetekr\'f5l Allah el\'f5tt.
\par 54. Ak\'e1r kinyilv\'e1n\'edtotok egy dolgot, ak\'e1r elrejtitek azt, h\'e1t bizony, Allah minden dologr\'f3l tudom\'e1ssal b\'edr.
\par {\*\bkmkstart 562}{\*\bkmkend 562}55. Nem r\'f3hat\'f3 fel v\'e9tek\'fcl nekik (a n\'f5knek), [hogy nem f\'fcgg\'f6ny\'f6zik el magukat] aty\'e1ik el\'f5tt, vagy a fiaik el\'f5tt, vagy a fiv\'e9reik el\'f5tt, vagy a fiv\'e9reik fiai el\'f5tt, vagy a n\'f5
v\'e9reik fiai el\'f5tt, vagy az asszonyaik (a h\'edv\'f5 n\'f5k) el\'f5tt, vagy azok el\'f5tt [a szolg\'e1l\'f3n\'f5k el\'f5tt], akiket jobbjuk birtokol. [\'d3 ti, n\'f5k!] F\'e9lj\'e9tek Allahot! Bizony, Allah minden dolog felett tan\'fa.
\par 
\par 56. Bizony, Allah \'e1ld\'e1s\'e1t (dics\'e9ret\'e9t \'e9s k\'f6ny\'f6r\'fclet\'e9t) k\'fcldi a Pr\'f3f\'e9t\'e1ra, \'e9s az \'d5 angyalai [im\'e1dkoznak \'e9rte]. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k
\'fcldet\'e9s\'e9ben]! Im\'e1dkozzatok \'e9rte \'e9s [az iszl\'e1m szerinti] k\'f6sz\'f6nt\'e9ssel k\'f6sz\'f6nts\'e9tek \'f5t!
\par 57. Bizony, akik b\'e1ntj\'e1k Allahot \'e9s a K\'fcld\'f6tt\'e9t, azokat el\'e1tkozta Allah az evil\'e1gon \'e9s a t\'falvil\'e1gon, \'e9s megal\'e1z\'f3 gy\'f6trelmet k\'e9sz\'edtett el\'f5 nekik.
\par 58. \'c9s azok, akik b\'e1ntj\'e1k a h\'edv\'f5 f\'e9rfiakat \'e9s a h\'edv\'f5 n\'f5ket, olyan\'e9rt, amit meg sem tettek, bizony a rettenetes r\'e1galmaz\'e1s \'e9s nyilv\'e1nval\'f3 b\'fbn terh\'e9t veszik magukra.
\par 
\par 59. \'d3 te, Pr\'f3f\'e9ta! Mondd a feles\'e9geidnek, \'e9s a le\'e1nyaidnak \'e9s a h\'edv\'f5k asszonyainak,}{\insrsid13659446  hogy takarj\'e1k el magukat k\'fcls\'f5 ruh\'e1juk egy r\'e9sz\'e9vel! \'cdgy \'e9rhet\'f5 el legink\'e1bb, hogy felismerhet
\'f5k legyenek \'e9s ne \'e9rje \'f5ket b\'e1ntalom. \'c9s Allah Megbocs\'e1t\'f3, K\'f6ny\'f6r\'fcletes.
\par 
\par 60. Ha nem hagyj\'e1k abba a k\'e9pmutat\'f3k, \'e9s azok, akiknek a sz\'edv\'fckben betegs\'e9g van, \'e9s azok, akik r\'e9mh\'edrt terjesztenek (az ellens\'e9gek t\'e1mad\'e1s\'e1r\'f3l) Medin\'e1ban, akkor bizony felb\'f5sz\'edtelek t\'e9ged ellen\'fc
k, \'e9s ut\'e1na [m\'e1r] csak egy kis ideig lesznek ott a szomsz\'e9daid,
\par 61. \'c1tkozottak [\'f5k]. B\'e1rhol is tal\'e1ltatnak, ragadtassanak meg, \'e9s egyt\'f5l-egyik \'f6lessenek meg.
\par 62. Ez Allah [\'e1ltal elrendelt] t\'f6rv\'e9nyszer\'fbs\'e9g [ahogyan elj\'e1rt] azokkal, akik kor\'e1bban t\'e1voztak el [az \'e9l\'f5k sor\'e1b\'f3l]. \'c9s nem tal\'e1lsz [semmif\'e9le] v\'e1ltoz\'e1st az Allah [\'e1ltal elrendelt] t\'f6rv\'e9nyszer
\'fbs\'e9gben.
\par 
\par 63. K\'e9rdeznek t\'e9ged [\'f3 Mohamed] az emberek az \'d3r\'e1r\'f3l (a Felt\'e1mad\'e1s idej\'e9r\'f5l). Mondd: \'84Annak tud\'e1sa csup\'e1n Allahn\'e1l van. \'c9s mi tudathatn\'e1 azt veled? Tal\'e1n az \'f3ra m\'e1r k\'f6zel van.\'94 
\par 64. Bizony Allah meg\'e1tkozta a hitetleneket \'e9s a L\'e1ngol\'f3 [Pokol-t\'fczet] k\'e9sz\'edtette el\'f5 nekik.
\par 65. \'d6r\'f6kk\'f6n \'f6r\'f6kk\'e9 abban fognak maradni, nem tal\'e1lnak sem p\'e1rtfog\'f3t, sem seg\'edt\'f5t.
\par 66. Azon a napon, amikor majd az arcuk a t\'fbzben forgattatik, azt mondj\'e1k: \'84B\'e1rcsak engedelmeskedt\'fcnk volna Allahnak \'e9s engedelmeskedt\'fcnk volna a K\'fcld\'f6ttnek!\'94
\par 67. \'c9s azt mondj\'e1k: \'84Urunk! Mi a vezet\'f5inknek \'e9s a hatalmasainknak engedelmeskedt\'fcnk \'e9s \'f5k elt\'e9vely\'edtettek minket az [egyenes] \'fatr\'f3l.
\par 68. Urunk! Adj nekik k\'e9tszeres gy\'f6trelmet \'e9s \'e1tkozd meg \'f5ket s\'falyos \'e1tokkal!\'94
\par 
\par 69. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne legyetek olyanok, mint azok}{\insrsid13659446\charrsid7552877 , akik megb\'e1ntott\'e1k M\'f3zest, majd Allah mentette fel \'f5t az al
\'f3l, amit mondtak! \'c9s Allah el\'f5tt \'f5 nagy becsben \'e1llt.
\par 70. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! F\'e9lj\'e9tek Allahot \'e9s mondjatok [mindig] egyenes besz\'e9det!}{\insrsid13659446 
\par 71. Sikerre viszi a cselekedeteiteket \'e9s megbocs\'e1tja a b\'fbneiteket. \'c9s aki engedelmeskedik Allahnak \'e9s a K\'fcld\'f6tt\'e9nek, az hatalmas diadalt arat.
\par 
\par 72. Bizony, Mi felaj\'e1nlottuk a megb\'edzat\'e1st az egeknek, a f\'f6ldnek \'e9s a hegyeknek. \'d5k azonban nem v\'e1llalt\'e1k fel \'e9s \'f5rizkedtek t\'f5le, \'e1m felv\'e1llalta az ember. Bizony, \'f5 [mindig is] igazs\'e1gtalan \'e9s tudatlan volt.

\par 73. Hogy Allah megb\'fcntesse a k\'e9pmutat\'f3 f\'e9rfiakat, \'e9s a k\'e9pmutat\'f3 n\'f5ket \'e9s az [Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3 f\'e9rfiakat \'e9s az [Allah mell\'e9] t\'e1rsistent \'e1ll\'edt\'f3 n\'f5
ket [amiatt, hogy nem tettek eleget a megb\'edzat\'e1snak], \'e9s hogy kiengesztel\'f5dj\'f6n a h\'edv\'f5 f\'e9rfiak \'e9s a h\'edv\'f5 n\'f5k ir\'e1nt. \'c9s Allah Megbocs\'e1t\'f3, K\'f6ny\'f6r\'fcletes.
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446 \page }{
\f0\fs24\insrsid13659446\charrsid3423863 34. S\'e1ba (Szaba) c. sz\'fara}{\insrsid13659446 
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 {\insrsid13659446 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. A h\'e1latelt dics\'e9ret Allahot illeti, aki\'e9 mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van, \'e9s \'d5t illeti a h\'e1latelt dics\'e9ret a t\'falvil\'e1gon, \'e9s \'d5 a B\'f6lcs{\*\bkmkstart 210}{\*\bkmkend 210}, a }{
\insrsid13659446\charrsid1118354 mindent j}{\insrsid13659446 \'f3l Ismer\'f5.
\par 2. \'d5 tudja, hogy mi megy be a f\'f6ldbe, \'e9s mi j\'f6n ki abb\'f3l, \'e9s mi j\'f6n le az \'e9gb\'f5l \'e9s mi emelkedik fel oda. \'c9s \'d5 az Irgalmas, a Megbocs\'e1t\'f3.
\par 
\par 3. \'c9s azt mondt\'e1k azok, akik a hitetlenn\'e9 v\'e1ltak: \'84Nem fog elj\'f6nni hozz\'e1nk az \'d3ra (a Felt\'e1mad\'e1s).\'94 Mondd: \'84Dehogynem! Az Uramra \endash  a rejtett dolgok Tud\'f3j\'e1ra \endash  esk\'fcsz\'f6m, bizony, el fog j\'f6
nni hozz\'e1tok. \'c9s \'d5el\'f5tte egy porszemnyi s\'faly\'fa [dolog] sem marad rejtve a f\'f6ld\'f6n, sem az \'e9gben, sem enn\'e9l kisebb, sem nagyobb an\'e9lk\'fcl, hogy ne lenne benne egy nyilv\'e1nval\'f3 \'edr\'e1sban (az \'d5rz\'f6tt T\'e1bl\'e1
n),
\par 4. Hogy megadja azok fizets\'e9g\'e9t, akik hisznek \'e9s j\'f3tetteket cselekszenek. Azoknak megbocs\'e1t\'e1s \'e9s nemes ell\'e1t\'e1s j\'e1r.
\par 5. \'c1m akik azon igyekeznek, hogy megakad\'e1lyozz\'e1k a Mi jeleinket, azoknak f\'e1jdalmas b\'fcntet\'e9sb\'f5l \'e1ll\'f3 gy\'f6trelemben lesz r\'e9sz\'fck.
\par 
\par 6. \'c9s azok, akiknek a tud\'e1s adatott, l\'e1tj\'e1k, hogy ami lebocs\'e1ttatott hozz\'e1d az Uradt\'f3l, az az igazs\'e1ga}{\insrsid13659446\charrsid7552877 , \'e9s a M\'e9lt\'f3s\'e1gteljes, a Dics\'e9retrem\'e9lt\'f3 [Allah] \'fatj\'e1hoz}{
\insrsid13659446  vezet.
\par 7. \'c9s azok, akik hitetlenn\'e9 v\'e1ltak, azt mondj\'e1k: \'84Vajon elvezess\'fcnk titeket egy emberhez, aki arr\'f3l besz\'e9l nektek, hogy amikor [meghaltok \'e9s] mindenfel\'e9 szerte fogtok foszlani, akkor \'faj teremt\'e9sben fogtok \'e9
letre kelni?
\par 8. Hazugs\'e1got tal\'e1lt-e ki Allah ellen, vagy \'f5r\'fclts\'e9g van benne?\'94 De nem! Akik nem hisznek a t\'falvil\'e1gban, azok [lesznek] a gy\'f6trelemben \'e9s a messzeviv\'f5 t\'e9velyg\'e9sben.
\par 9. Vajon nem l\'e1tt\'e1k-e azt, ami el\'f5tt\'fck van \'e9s ami m\'f6g\'f6tt\'fck van az egekb\'f5l \'e9s a f\'f6ldb\'f5l? Ha akarjuk, els\'fcllyesztj\'fck alattuk a f\'f6ldet, vagy r\'e1juk hullajtjuk az eget darabokban. Bizony, jel van ebben minden [b
\'fbnb\'e1n\'f3an] visszat\'e9r\'f5 szolg\'e1nak (teremtm\'e9nynek).}{\insrsid13659446\charrsid15875231 
\par 
\par 10. \'c9s bizony adtunk D\'e1vidnak a Mi kegy\'fcnkb\'f5l, [\'e9s azt mondtuk]: \'84Ti hegyek! Zengj\'e9tek vele a dics\'f5\'edt\'e9st, \'e9s ti is, madarak!\'94 \'c9s megl\'e1gy\'edtottuk neki a vasat.}{\insrsid13659446 
\par 11. [Megparancsolva neki,] hogy: \'84Teljesen takar\'f3 p\'e1nc\'e9lzatot k\'e9sz\'edts \'e9s pontosan m\'e9rd ki a szemeket! \'c9s cselekedjetek j\'f3t! Bizony, \'e9n l\'e1tom azt, amit cselekszetek!\'94
\par 12. \'c9s Salamon [szolg\'e1lat\'e1ra rendelt\'fck] a szeleket, amelynek reggeli \'fatja egy h\'f3napnyi [utat tesz ki], \'e9s esti \'fatja is egy h\'f3napnyi [utat tesz ki], \'e9s foly\'e9konny\'e1 tett\'fck neki az olvadt rezet. \'c9
s dzsinneket [rendelt\'fcnk mell\'e9], akik Ura engedelm\'e9vel munk\'e1lkodnak keze (hatalma) alatt. \'c9s aki elt\'e9r k\'f6z\'fcl\'fck a Mi parancsunkt\'f3l, azzal a L\'e1ngol\'f3 [Pokol-t\'fbz] gy\'f6trelm\'e9t \'edzleltetj\'fck meg.
\par 13. Elk\'e9sz\'edtett\'e9k neki, amit csak akart: magas \'e9p\'edtm\'e9nyeket, szobrokat, medenc\'e9khez hasonl\'f3 t\'e1lakat, \'e9s szi}{\insrsid13659446\charrsid2499145 l\'e1rdan \'e1ll\'f3 \'fcst\'f6ket. \'d3 D\'e1vid nemzets\'e9ge! Cselekedjetek h
\'e1laad\'e1ssal! \'c9s kev\'e9s az \'e9n szolg\'e1im k\'f6z\'f6tt az, aki h\'e1l\'e1s.
\par 
\par 14. \'c9s amikor d\'f6nt\'f6tt\'fcnk [Salamon] hal\'e1la fel\'f5l, semmi m\'e1s nem mutatta meg a hal\'e1l\'e1t nekik (a dzsinneknek), csak a f\'f6ld apr\'f3 \'e1llata (a termesz), amelyik sz\'e9tr\'e1gta a botj\'e1t. Amikor a f\'f6ldre rogyott, vil\'e1
goss\'e1 v\'e1lt a dzsinneknek, hogy ha tudt\'e1k volna a rejtett dolgokat, nem id\'f5ztek volna a megal\'e1z\'f3 b\'fcntet\'e9sben.}{\insrsid13659446 
\par 
\par 15. Bizony, jel volt S\'e1ba [t\'f6rzs\'e9nek] a lakhely\'e9ben: k\'e9t kert, [az egyik] jobbr\'f3l, [a m\'e1sik] balr\'f3l. [Az mondatott nekik]: \'84Egyetek Uratok ell\'e1t\'e1s\'e1b\'f3l \'e9s legyetek h\'e1l\'e1sak neki! J\'f3 f\'f6ld[etek] \'e9
s megbocs\'e1t\'f3 Ur[atok] van!\'94
\par {\*\bkmkstart 185}{\*\bkmkend 185}16. \'d5k azonban h\'e1tat ford\'edtottak, mi pedig r\'e1juk k\'fcldt\'fck az [\'e1tszakadt] g\'e1t ki\'e1rad\'f3 viz\'e9t, \'e9s a k\'e9t kertj\'fcket k\'e9t olyan kertre cser\'e9lt\'fck fel, amelyeknek keser\'fb term
\'e9seik voltak: tamariszkusz, \'e9s egy kev\'e9s a t\'f6visf\'e1kb\'f3l.
\par 17. Ekk\'e9ppen fizett\'fcnk meg nekik, ami\'e9rt hitetlenn\'e9 v\'e1ltak. \'c9s vajon megfizet\'fcnk-e [ilyen m\'f3don] m\'e1snak, mint a hitetlennek?
\par 18. \'c9s k\'f6z\'e9j\'fck \'e9s azon v\'e1rosok k\'f6z\'e9, amelyeket meg\'e1ldottunk, l\'e1that\'f3 (egym\'e1shoz k\'f6zeli) v\'e1rosokat helyezt\'fcnk el, \'e9s elrendelt\'fck azok k\'f6z\'f6tt az [utak] j\'e1rhat\'f3s\'e1g\'e1t, [mondv\'e1n]: \'84J
\'e1rj\'e1tok azokat \'e9jszak\'e1kon \'e9s napokon \'e1t biztons\'e1gban!\'94
\par {\*\bkmkstart 205}{\*\bkmkend 205}19. \'d5k azonban azt mondt\'e1k: \'84Urunk! Tedd hosszabb\'e1 [a t\'e1vols\'e1got] az utaz\'e1saink [c\'e9lpontjai] k\'f6z\'f6tt!\'94 \'c9s igazs\'e1gtalans\'e1got k\'f6vettek el \'f6nmagukkal szemben, Mi pedig [sz\'e1jr
\'f3l-sz\'e1jra j\'e1r\'f3] elbesz\'e9l\'e9sekk\'e9 tett\'fck \'f5ket, \'e9s [csoportokra] szaggatva sz\'f3rtuk sz\'e9t mindenfel\'e9 \'f5ket. Bizony, jelek vannak ebben minden t\'fcrelmesnek, h\'e1l\'e1snak.
\par 
\par 20. \'c9s bizony beigazol\'f3dott Ibl\'edsz (a s\'e1t\'e1n) v\'e9leked\'e9se r\'f3luk, \'e9s k\'f6vett\'e9k \'f5t, kiv\'e9ve egy csoportot a h\'edv\'f5k k\'f6z\'fcl.
\par 21. \'c1m nem volt neki hatalma f\'f6l\'f6tt\'fck. Csup\'e1n az\'e9rt [t\'f6rt\'e9nt], hogy nyilv\'e1nval\'f3v\'e1 tegy\'fck [az embereknek] azt, amit m\'e1r tudtunk: ki az, aki hisz a t\'falvil\'e1gban, \'e9s ki az, aki k\'e9ts\'e9gben van fel\'f5le. 
\'c9s a te Urad mindenek felett \'d5rz\'f5.
\par 22. Mondd [\'f3 Mohamed]: \'84Foh\'e1szkodjatok csak azokhoz, akiket Allahon k\'edv\'fcl [isteneknek] \'e1ll\'edtottatok! Nem \'e1ll m\'f3djukban rendelkezni egyetlen porszemnyi s\'faly\'fa [dolog felett] az egekben, sem a f\'f6ld\'f6n, \'e9
s egyikben sincs nekik semmilyen r\'e9szesed\'e9s\'fck. \'c9s nincs senki k\'f6z\'fcl\'fck, aki az \'d5 (Allah) seg\'edt\'f5je lenne.
\par 23. \'c9s nem haszn\'e1l \'d5n\'e1la a k\'f6zbenj\'e1r\'e1s, csak annak [a k\'f6zbenj\'e1r\'e1sa], akinek enged\'e9lyt adott. \'c9s amikor v\'e9g\'fcl [enged\'e9lyt kapnak a k\'f6zbenj\'e1r\'e1sra], elm\'falik [a k\'f6zbenj\'e1r\'e1st k\'e9r\'f5k] sz\'edv
\'e9ben az ijedts\'e9g, azt mondj\'e1k: \'84Mit mondott az Uratok?\'94 Azt mondj\'e1k [a k\'f6zbenj\'e1r\'f3k]: \'84Az Igazs\'e1got.\'94 \'c9s \'d5 a Magass\'e1gos, a Nagy!
\par {\*\bkmkstart 255}{\*\bkmkend 255}
\par 24. Mondd: \'84Ki l\'e1t el titeket az egekb\'f5l \'e9s a f\'f6ldb\'f5l?\'94 Mondd: \'84Allah.\'94 \'c9s bizony, vagy mi vagyunk, vagy ti vagytok az igaz \'faton vezetettek, vagy a nyilv\'e1nval\'f3 t\'e9velyg\'e9sben j\'e1r\'f3k.\'94
\par 25. Mondd: \'84Ti nem lesztek megk\'e9rdezve arr\'f3l, ami gonosztettet elk\'f6vett\'fcnk, \'e9s mi sem lesz\'fcnk megk\'e9rdezve arr\'f3l, amit ti {\*\bkmkstart 265}{\*\bkmkend 265}cselekszetek.\'94
\par 26. Mondd: \'84\'d6sszegy\'fbjt majd minket az Urunk, azt\'e1n d\'f6nteni fog k\'f6z\'f6tt\'fcnk az igazs\'e1g szerint. \'d5 az [igazs\'e1gosan] \'cdt\'e9lkez\'f5, a Mindentud\'f3{\*\bkmkstart 275}{\*\bkmkend 275}.\'94
\par 27. Mondd: \'84Mutass\'e1tok meg nekem azokat, akiket t\'e1rsistenekk\'e9nt helyeztetek [Allah] mell\'e9!\'94 De nem! \'d5 Allah, a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.\'94
\par 
\par 28. \'c9s nem k\'fcldt\'fcnk el t\'e9ged [\'f3 Mohamed], csup\'e1n \'f6r\'f6mh\'edrhoz\'f3k\'e9nt \'e9s figyelmeztet\'f5k\'e9nt, minden emberhez. Azonban a legt\'f6bb ember nem tudja [ezt].
\par 29. \'c9s azt mondj\'e1k: \'84Mikor [k\'f6vetkezik be] ez az \'edg\'e9ret, }{\insrsid13659446\charrsid1844626 ha val\'f3ban}{\insrsid13659446  igazmond\'f3k vagytok?\'94
\par 30. Mondd: \'84Egy olyan napra kaptok \'edg\'e9retet [az \'edt\'e9letre], amelyet nem k\'e9sleltethettek egy \'f3r\'e1val sem, \'e9s nem is siettethettek.\'94
\par 
\par 31. \'c9s azok, akik hitetlenn\'e9 v\'e1ltak, azt mondj\'e1k: \'84Nem hisz\'fcnk ebben a Kor\'e1nban, \'e9s abban sem, ami el\'f5tte volt\'94. \'c9s b\'e1rcsak l\'e1tn\'e1d [milyen sz\'f6rny\'fb lesz], amikor az igazs\'e1gtalanok majd Uruk el\'e9 \'e1ll
\'edttatnak, egym\'e1st v\'e1dolva! Azok, akik elnyomottak voltak azt mondj\'e1k majd azoknak, akik fennh\'e9j\'e1ztak: \'84Ha ti nem lettetek volna, bizony h\'edv\'f5k lett\'fcnk volna!\'94
\par 32. Akik fennh\'e9j\'e1ztak, azt mondj\'e1k majd azoknak, akik elnyomottak voltak: \'84Vajon mi tartottunk-e t\'e1vol titeket az \'fatmutat\'e1st\'f3l, miut\'e1n az elj\'f6tt hozz\'e1tok? Nem! {\*\bkmkstart 334}{\*\bkmkend 334}Ti gonosztev\'f5k voltatok!
\'94
\par 33. \'c9s azok, akik elnyomottak voltak, azt mondj\'e1k majd azoknak, akik fennh\'e9j\'e1ztak: \'84Nem! Cselsz\'f6v\'e9s [folyt a r\'e9szetekr\'f5l] \'e9jjel-nappal. [Eml\'e9kezzetek arra], amikor arra utas\'edtottatok minket, v\'e1ljunk hitetlenn\'e9
 Allahhal szemben, \'e9s hogy vet\'e9lyt\'e1rsakat helyezz\'fcnk \'d5mell\'e9!\'94 \'c9s el fogj\'e1k titkolni a megb\'e1n\'e1sukat, miut\'e1n megl\'e1tj\'e1k a gy\'f6trelmet. \'c9s bilincset tesz\'fcnk azoknak a nyak\'e1ba, akik hitetlenn\'e9 v\'e1
ltak. Vajon [mi m\'e1s\'e9rt] kapnak fizets\'e9get, mint amit cselekedtek?
\par 
\par 34. \'c9s nem k\'fcldt\'fcnk egy v\'e1rosba sem figyelmeztet\'f5t an\'e9lk\'fcl, hogy annak j\'f3l\'e9tben d\'fask\'e1l\'f3i ne mondt\'e1k volna azt: \'84Bizony, mi nem hisz\'fcnk abban, amivel el lettetek k\'fcldve{\*\bkmkstart 352}{\*\bkmkend 352}.\'94

\par 35. \'c9s azt mondt\'e1k: \'84Bizony, nek\'fcnk t\'f6bb vagyonunk \'e9s gyermek\'fcnk van, \'e9s mi nem lesz\'fcnk gy\'f6trelemmel s\'fajtva.\'94
\par }{\insrsid13659446\charrsid2499145 36. Mondd: \'84Bizony, az \'e9n Uram kiterjeszti az ell\'e1t\'e1st annak, akinek akarja, \'e9s sz\'fbk\'f6ss\'e9 teszi [m\'e1soknak], \'e1m a legt\'f6bb ember nem rendelkezik tud\'e1ssal.\'94}{\insrsid13659446 
\par 37. \'c9s nem a vagyonotok, \'e9s nem [is] a gyermekeitek fognak titeket k\'f6zelebb hozni Hozz\'e1nk, [hanem] csak [az, ha] valaki hisz \'e9s j\'f3t cselekszik, mert azoknak k\'e9tszeres fizets\'e9g j\'e1r az\'e9rt, amit cselekedtek, \'e9s \'f5
k a legfels\'f5 helyeken lesznek [a Paradicsomban], biztons\'e1gban.
\par 38. \'c1m akik azon igyekeznek, hogy meghi\'fas\'edts\'e1k a jeleinket, azok a gy\'f6trelemre lesznek elhozatva.
\par 39. Mondd: \'84Bizony, }{\insrsid13659446\charrsid2499145 az \'e9n Uram kiterjeszti az ell\'e1t\'e1st annak, akinek akarja a szolg\'e1i k\'f6z\'fcl, \'e9s sz\'fbk\'f6ss\'e9 teszi sz\'e1m\'e1ra (azt az \'f5 \'e9rdek\'e9ben). \'c1m b\'e1rmit is k\'f6lt\'f6t
\'f6k, azt \'d5 visszafizeti nektek. \'c9s \'d5 a legjobb [Ell\'e1t\'f3] az ell\'e1t\'f3k k\'f6z\'f6tt}{\insrsid13659446 .\'94
\par 
\par 40. \'c9s azon a napon [Allah] \'f6sszegy\'fbjti mindannyiukat, azut\'e1n azt mondja az angyaloknak: \'84Vajon ezek titeket szolg\'e1ltak?\'94
\par 41. Azt }{\insrsid13659446\charrsid9515304 mondj\'e1k: \'84Magasztaltass\'e1l! Te vagy a mi p\'e1rtfog\'f3nk, nem \'f5k! Ellenkez\'f5leg, \'f5k a dzsinneket szolg\'e1lt\'e1k. A legt\'f6bbj\'fck [\'f5ket szolg\'e1lva] hisz benn\'fck.\'94
\par 42. Ma pedig egyik\'f5t\'f6knek sem \'e1ll m\'f3dj\'e1ban m\'e1soknak hasznot [hozni], sem \'e1rtalmat [elt\'e1vol\'edtani]. \'c9s azt mondjuk azoknak, akik igazs\'e1gtalans\'e1got k\'f6vettek el: \'84\'cdzlelj\'e9tek meg a [Pokol-]t\'fbz gy\'f6trelm\'e9
t, amit [kor\'e1bban] meghazudtoltatok!\'94
\par 43. \'c9s amikor a mi jeleink }{\insrsid13659446\charrsid5336861 nyilv\'e1nval\'f3 bizony\'edt\'e9kokk\'e9nt recit\'e1ltatnak nekik (a mekkai hitetleneknek), azt mondj\'e1k: \'84Nem m\'e1s ez, mint egy ember, aki t\'e1vol akar tartani titeket att\'f3
l, amit aty\'e1itok szolg\'e1ltak.\'94 \'c9s azt mondj\'e1k: \'84Nem m\'e1s ez [a Kor\'e1n], mint egy kital\'e1lt hazugs\'e1g.\'94 \'c9s azok, akik hitetlenn\'e9 v\'e1ltak, azt mondj\'e1k az Igazs\'e1gr\'f3l, miut\'e1n az elj\'f6tt hozz\'e1juk: \'84Nem m
\'e1s ez, mint nyilv\'e1nval\'f3 var\'e1zslat.\'94
\par 44. \'c9s nem adtunk nekik \'cdr\'e1sokat, amelyeket tanulm\'e1nyozhattak volna, \'e9s nem k\'fcldt\'fcnk el hozz\'e1juk teel\'f5tted egy figyelmeztet\'f5t sem.
\par 45. \'c9s meghazudtol\'e1st k\'f6vettek el azok is, akik \'f5el\'f5tt\'fck \'e9ltek, \'e9s \'f5k [a mekkai hitetlenek] a tized\'e9t sem szerezt\'e9k meg annak, amit azoknak adtunk, \'e1m meghazudtolt\'e1k a k\'fcld\'f6tteimet [Mi pedig elpuszt\'edtottuk 
\'f5ket]. Milyen volt h\'e1t az \'e9n rosszall\'e1som?
\par 
\par 46. Mondd: \'84\'c9n csak egyvalamire intelek titeket: \'c1lljatok Allah el\'e9 kettes\'e9vel, vagy egyes\'e9vel, azut\'e1n gondolkodjatok el! Nincs a ti t\'e1rsatokban (Mohamed pr\'f3f\'e9t\'e1ban) \'f5r\'fclts\'e9g. Nem m\'e1s \'f5, mint az, aki egy s
\'falyos gy\'f6trelem [bek\'f6vetkez\'e9se] el\'f5tt figyelmeztet titeket.\'94
\par 47. Mondd: \'84amilyen fizets\'e9get k\'e9rn\'e9k t\'f5letek, azt megtarthatn\'e1tok (az a ti javatokra van). Az \'e9n fizets\'e9gem egyed\'fcl Allahra tartozik. \'c9s \'d5 minden dolog tan\'faja.\'94
\par 
\par 48. Mondd: \'84Bizony, az \'e9n Uram az igazs\'e1got [a hamiss\'e1gra] haj\'edtja, [amely sz\'e9tfoszlatja azt, \'e9s \'edme, az elt\'fbnik]. \'d5 a rejtett dolgok Tud\'f3ja.\'94
\par 49. Mondd: \'84Elj\'f6tt az igazs\'e1g, a hamiss\'e1g pedig nem k\'e9pes elkezdeni semmit}{\insrsid13659446 ,}{\insrsid13659446\charrsid5336861  sem megism\'e9telni.
\par 50. Mondd: \'84Ha t\'e9velygek, a magam k\'e1r\'e1ra t\'e9velygek, \'e9s ha az igaz \'fatra tal\'e1lok, az az\'e1ltal van, amit az Uram sugall nekem [kinyilatkoztat\'e1sk\'e9nt]. Bizony, \'d5 mindent Hall\'f3, K\'f6zell\'e9v\'f5.
\par 51. \'c9s b\'e1rcsak l\'e1tn\'e1d, amikor [a Felt\'e1mad\'e1s napj\'e1n] megijednek, \'e1m nem lesz menekv\'e9s [sz\'e1mukra] \'e9s k\'f6zeli helyr\'f5l ragadtatnak meg!
\par 52. \'c9s [akkor] azt mondj\'e1k: \'84Most m\'e1r hisz\'fcnk abban (Allah egyed\'fclval\'f3s\'e1g\'e1ban).\'94 \'c1m hogyan juthatn\'e1nak [a hit birtok\'e1ba] e t\'e1voli helyr\'f5l (a t\'falvil\'e1gr\'f3l, ahonnan nem t\'e9rhetnek vissza az evil\'e1
gba, hogy higgyenek)?
\par 53. \'c9s bizony nem hittek benne kor\'e1bban, \'e9s t\'e1voli helyr\'f5l bocs\'e1tkoztak tal\'e1lgat\'e1sokba a rejtett dolgokkal kapcsolatban.
\par 54. \'c9s akad\'e1ly \'e1llt k\'f6z\'e9j\'fck \'e9s ak\'f6z\'e9, amire v\'e1gyakoztak, ahogyan az a hozz\'e1juk hasonl\'f3kkal is megt\'f6rt\'e9nt kor\'e1bban. Bizony, \'f5k zavarba ejt\'f5 k\'e9ts\'e9gben voltak.}{\insrsid13659446 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446 \page }{
\f0\fs24\insrsid13659446\charrsid3423863 35. A L\'e9trehoz\'f3 (F\'e1tir) c. sz\'fara}{\insrsid13659446 
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 {\insrsid13659446 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. A h\'e1latelt dics\'e9ret Allahot illeti, az egek \'e9s a f\'f6ld L\'e9trehoz\'f3j\'e1t, aki az angyalokat k\'fcld\'f6ttekk\'e9 tette, sz\'e1rnyakkal [}{\insrsid13659446\charrsid14308542 ell\'e1tva \'f5ket]:}{\insrsid13659446  kett\'f5vel, h\'e1rommal 
\'e9s n\'e9ggyel. Azt n\'f6veli meg a teremt\'e9sben, amit akar. Bizony, Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 2. }{\insrsid13659446\charrsid14308542 Ami }{\insrsid13659446 [}{\insrsid13659446\charrsid14308542 kegyet}{\insrsid13659446 ] ad Allah az embereknek, azt nem tarthatja vissza senki, \'e9s amit visszatart, azt nem \'e1raszthatja ki senki \'d5ut\'e1na. \'c9
s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 3. \'d3 ti, emberek! Eml\'e9kezzetek Allah j\'f3t\'e9tem\'e9ny\'e9re, amelyben r\'e9szes\'edtett titeket! Vajon van-e Allahon k\'edv\'fcl m\'e1s teremt\'f5, aki ell\'e1t titeket az \'e9gb\'f5l \'e9s a f\'f6ldb\'f5l? Nincs m\'e1s [jogosan im\'e1dhat\'f3]
 isten rajta k\'edv\'fcl. Hogyan lehettek h\'e1t elt\'e9r\'edtve [az igazs\'e1gt\'f3l]?
\par 4. \'c9s ha meghazudtolnak, [\'f3 Mohamed,] bizony meg lettek hazudtolva k\'fcld\'f6ttek m\'e1r el\'f5tted is. \'c9s Allahhoz vitetnek vissza az \'fcgyek [d\'f6nt\'e9sre].
\par 
\par 5. \'d3 ti, emberek! Bizony, Allah \'edg\'e9rete igaz. Ne t\'e9vesszen h\'e1t meg titeket az evil\'e1gi \'e9let, \'e9s ne t\'e9vesszen meg titeket Allahot illet\'f5en a megt\'e9veszt\'f5 (a s\'e1t\'e1n)!
\par 6. Bizony, a s\'e1t\'e1n a ti ellens\'e9getek, tegy\'e9tek h\'e1t \'f5t ellens\'e9getekk\'e9! Csup\'e1n arra h\'edvja a sz\'f6vets\'e9geseit, hogy a L\'e1ngol\'f3 [Pokol-t\'fbz] lak\'f3i k\'f6z\'e9 tartozzanak.
\par 7. Akik }{\insrsid13659446\charrsid7879571 hitetlenn\'e9 v\'e1ltak}{\insrsid13659446 , azoknak sz\'f6rny\'fb gy\'f6trelem j\'e1r, \'e1m akik hisznek \'e9s j\'f3tetteket cselekszenek, azoknak megbocs\'e1t\'e1s \'e9s nagy jutalom j\'e1r.
\par 8. Vajon az, akinek d\'edszess\'e9 lett t\'e9ve a rossz cselekedete, \'e9s \'edgy j\'f3nak l\'e1tja azt [egyenl\'f5-e azzal, aki r\'e1tal\'e1lt az igaz \'fatra]? Bizony, Allah t\'e9velyg\'e9sbe engedi azt, akit akar, \'e9s igaz \'fa
tra vezeti azt, akit akar. Ne puszt\'edtsd h\'e1t el magadat [\'f3 Mohamed] miattuk a b\'e1natt\'f3l! Bizony, Allah tudja, hogy mit m\'fbvelnek.
\par {\*\bkmkstart 105}{\*\bkmkend 105}
\par 9. \'c9s Allah az, aki elk\'fcldi a szeleket, amelyek mozgatj\'e1k a felh\'f5ket, majd Mi azokat a [sz\'e1razs\'e1gt\'f3l] halott helys\'e9gre hajtjuk \'e9s \'fajj\'e1\'e9lesztj\'fck \'e1ltala a f\'f6ldet, miut\'e1n az m\'e1r meghalt. Ilyen lesz a kij\'f6
vetel [a s\'edrokb\'f3l].
\par 10. Aki m\'e9lt\'f3s\'e1got akar [szerezni], nos minden m\'e9lt\'f3s\'e1g Allah\'e9. \'c9s \'d5hozz\'e1 emelkedik fel a j\'f3 sz\'f3, \'e9s a j\'f3 cselekedetet felemeli. Akik azonban rossz cseleket sz\'f5nek, azoknak sz\'f6rny\'fb b\'fcntet\'e9s j\'e1r, 
\'e9s semmiv\'e9 lesz azok cselsz\'f6v\'e9se.
\par 11. \'c9s Allah megteremtett titeket porb\'f3l, majd [megterm\'e9keny\'fclt] cseppb\'f5l, azt\'e1n p\'e1rokk\'e1 tett titeket. \'c9s egyetlen n\'f5st\'e9ny sem visel\'f5s, \'e9s nem hozza terh\'e9t vil\'e1gra an\'e9lk\'fcl, hogy \'d5 (Allah) ne tudn\'e1. 
\'c9s nem lesz hossz\'fa \'e9let\'fb senki sem, \'e9s nem [is] r\'f6vid\'fcl meg \'e9letkorban an\'e9lk\'fcl, hogy az ne lenne egy \'edr\'e1sban [az \'d5rz\'f6tt T\'e1bl\'e1n]. Bizony, ez k\'f6nny\'fb Allahnak.
\par 
\par 12. \'c9s nem egyenl\'f5 a k\'e9t tenger: ez itt \'e9des, szomjolt\'f3, \'e9s k\'f6nnyen ihat\'f3, az pedig er\'f5sen s\'f3s [\'e9s keser\'fb]. \'c9s mindegyikb\'f5l friss h\'fast esztek \'e9s \'e9kszereket hoztok fel bel\'f5le, amelyeket magatokra \'f6lt
\'f6t\'f6k. \'c9s l\'e1thatod a haj\'f3kat, amint \'e1tszelik azt az\'e9rt, hogy az \'d5 kegy\'e9t kereshess\'e9tek, \'e9s h\'e1tha h\'e1l\'e1sak lesztek.
\par 13. [Allah] beleviszi az \'e9jszak\'e1t a nappalba, \'e9s beleviszi a nappalt az \'e9jszak\'e1ba, \'e9s szolg\'e1latra rendelte a Napot \'e9s a Holdat, mindegyik megszabott ideig fut (kering a p\'e1ly\'e1j\'e1n). \'cdme, \'d5 Allah, a ti Uratok! \'d6v\'e9
 a kir\'e1lyi uralom, \'e1m akikhez Rajta k\'edv\'fcl foh\'e1szkodtok, azok nem rendelkeznek annyi hatalommal sem, mint amekkora a datolyamagon a h\'e1rtya.
\par 14. Ha hozz\'e1juk foh\'e1szkodtok, nem hallj\'e1k a foh\'e1szotokat, \'e9s ha hallan\'e1k, akkor sem v\'e1laszoln\'e1nak nektek, \'e9s a Felt\'e1mad\'e1s napj\'e1n elutas\'edtj\'e1k (elhat\'e1rol\'f3dnak att\'f3l), hogy Ti [Allah mell\'e9] t\'e1rsistenn
\'e9 \'e1ll\'edtott\'e1tok [\'f5ket]. \'c9s senki nem ad neked h\'edrad\'e1st \'fagy, mint a [mindent] j\'f3l Ismer\'f5.
\par 
\par 15. \'d3 ti, emberek! Ti Allahra szorultok r\'e1, \'e9s Allah a Gazdag, a Dics\'e9retre M\'e9lt\'f3.
\par {\*\bkmkstart 186}{\*\bkmkend 186}16. Ha \'fagy akarja, elt\'e1vol\'edt (elpuszt\'edt) titeket \'e9s \'faj teremt\'e9st hoz.
\par 17. \'c9s ez Allahnak nem lehetetlen.
\par 18. \'c9s egy terhet cipel\'f5 sem cipeli egy m\'e1siknak a terh\'e9t. \'c9s ha egy nehez\'e9ket cipel\'f5 [seg\'edts\'e9get] h\'edv terhe [hordoz\'e1s\'e1hoz], akkor semmi sem lesz \'e1tv\'e9ve t\'f5le, m\'e9g akkor sem, ha k\'f6zeli rokon. Te csup\'e1
n azokat figyelmezteted, akik f\'e9lnek Urukt\'f3l an\'e9lk\'fcl, hogy l\'e1tn\'e1k \'d5t, }{\insrsid13659446\charrsid15619907 \'e9s megtartj\'e1k}{\insrsid13659446  az im\'e1dkoz\'e1st. \'c9s aki megtisztul, az a maga haszn\'e1ra tisztul meg. \'c9
s Allahn\'e1l lesz a v\'e9gc\'e9l.
\par 
\par 19. \'c9s nem egyenl\'f5 a vak \'e9s a l\'e1t\'f3,{\*\bkmkstart 206}{\*\bkmkend 206}
\par 20. Sem a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gek \'e9s a vil\'e1goss\'e1g,
\par 21.Sem az \'e1rny\'e9k \'e9s a forr\'f3 sz\'e9l.{\*\bkmkstart 226}{\*\bkmkend 226}
\par {\*\bkmkstart 235}{\*\bkmkend 235}22. \'c9s nem egyenl\'f5k az \'e9l\'f5k \'e9s a holtak. Bizony, Allah annak ad hall\'e1st, akinek akar. Te azonban nem teheted meg, hogy hall\'f3v\'e1 tegyed azokat, akik a s\'edrokban vannak.
\par 23. Te [\'f3 Mohamed] nem vagy m\'e1s, mint figyelmeztet\'f5.
\par 24. Bizony, mi elk\'fcldt\'fcnk t\'e9ged az igazs\'e1ggal, \'f6r\'f6mh\'edr-hoz\'f3k\'e9nt \'e9s figyelmeztet\'f5k\'e9nt. \'c9s nem volt olyan k\'f6z\'f6ss\'e9g, amelyben ne lett volna kor\'e1bban figyelmeztet\'f5.{\*\bkmkstart 256}{\*\bkmkend 256}
\par 25. \'c9s ha meghazudtolnak t\'e9ged, bizony meghazudtolt\'e1k [a k\'fcld\'f6tteiket] m\'e1r azok is, akik el\'f5tt\'fck voltak. Az \'d5 k\'fcld\'f6tteik nyilv\'e1nval\'f3 bizony\'edt\'e9kokkal, k\'f6nyvekkel \'e9s vil\'e1goss\'e1got ad\'f3 \'cdr\'e1
ssal j\'f6ttek el hozz\'e1juk.
\par 26. Azt\'e1n [b\'fcntet\'e9ssel] ragadtam meg azokat, akik hitetlenn\'e9 v\'e1ltak. \'c9s milyen [sz\'f6rny\'fb] volt az \'e9n rosszall\'e1som!{\*\bkmkstart 276}{\*\bkmkend 276}
\par 
\par 27. Vajon nem gondolkodt\'e1l el azon, hogy Allah vizet bocs\'e1tott le az \'e9gb\'f5l, azt\'e1n k\'fcl\'f6nb\'f6z\'f5 sz\'edn\'fb term\'e9seket hoztunk el\'f5 vele? \'c9s a hegyek k\'f6z\'f6tt vannak vonulatok, [amelyeknek] k\'fcl\'f6nb\'f6z\'f5 a sz\'ed
n\'fbk: }{\insrsid13659446\charrsid13459231 feh\'e9rek, v\'f6r\'f6sek \'e9s koromfeket\'e9k}{\insrsid13659446 .
\par 28. \'c9s az emberek, a mozg\'f3 [\'e9l\'f5l\'e9nyek], \'e9s a j\'f3sz\'e1gok k\'f6z\'f6tt ugyan\'edgy vannak k\'fcl\'f6nb\'f6z\'f5 sz\'edn\'fbek. Bizony, Allahot a szolg\'e1i k\'f6z\'fcl csup\'e1n a tud\'f3sok f\'e9lik. Bizony, Allah M\'e9lt\'f3s\'e1
gteljes, Megbocs\'e1t\'f3.
\par 
\par 29. Bizony, akik recit\'e1lj\'e1k Allah \'edr\'e1s\'e1t (a Kor\'e1nt) }{\insrsid13659446\charrsid11674769 \'e9s megtartj\'e1k}{\insrsid13659446  az im\'e1dkoz\'e1st, \'e9s ny\'edltan \'e9s titokban adakoznak abb\'f3l, amivel ell\'e1ttuk \'f5
ket, azok olyan keresked\'e9sben rem\'e9nykednek, amely soha nem megy veszend\'f5be.
\par 30. Az\'e9rt, mert [Allah] teljess\'e9gben megadja a fizets\'e9g\'fcket, \'e9s az \'d5 kegy\'e9b\'f5l gyarap\'edtja \'f5ket [jutalomban]. Bizony, \'d5 Megbocs\'e1t\'f3, H\'e1l\'e1s.
\par {\*\bkmkstart 325}{\*\bkmkend 325}31. \'c9s amit sugalltunk neked [kinyilatkoztat\'e1s gyan\'e1nt] az \'cdr\'e1sb\'f3l, az az Igazs\'e1g, meger\'f5s\'edtve [annak igazs\'e1g\'e1t] ami el\'f5tte volt. Bizony, Allah j\'f3l ismeri a szolg\'e1it \'e9s \'e1tl
\'e1tja \'f5ket.
\par 32. Azt\'e1n \'f6r\'f6k\'fcl adtuk az \'cdr\'e1st azoknak a szolg\'e1inknak, akiket kiv\'e1lasztottunk. \'c9s van k\'f6zt\'fck igazs\'e1gtalan \'f6nmag\'e1val szemben, \'e9s van k\'f6z\'f6tt\'fck, aki m\'e9rt\'e9ktart\'f3, \'e9s van k\'f6z\'f6tt\'fc
k, aki Allah engedelm\'e9vel }{\insrsid13659446\charrsid13459231 \'e9len j\'e1r a j\'f3}{\insrsid13659446  a j\'f3 cselekedetekkel. Ez a nagy kegy!
\par 33. [A Paradicsom] \'f6r\'f6kk\'e9 tart\'f3 kertjeibe}{\f0\insrsid13659446  }{\insrsid13659446 mennek be, arany karperecek \'e9s gy\'f6ngy\'f6k lesznek az \'e9kszereik, \'e9s selyem lesz az \'f6lt\'f6z\'e9k\'fck.
\par 34. \'c9s azt mondj\'e1k: \'84A h\'e1latelt dics\'e9ret Allahot illeti, aki elt\'e1vol\'edtotta r\'f3lunk a szomor\'fas\'e1got. Bizony, a mi Urunk Megbocs\'e1t\'f3, H\'e1l\'e1s.{\*\bkmkstart 353}{\*\bkmkend 353}
\par 35. Aki az \'d5 kegye \'e1ltal az \'f6r\'f6k lakhelyre telep\'edtett minket, ahol nem }{\insrsid13659446\charrsid7934346 \'e9r}{\insrsid13659446  minket sem f\'e1radts\'e1g, sem kimer\'fclts\'e9g.\'94
\par 
\par 36. \'c9s akik hitetlenek, azoknak a Gyehenna T\'fcze j\'e1r. Nem \'edt\'e9ltetnek arra, hogy meghaljanak \'e9s nem lesz sz\'e1mukra enyh\'edtve ott a b\'fcntet\'e9s. Ekk\'e9ppen fizet\'fcnk meg minden hitetlennek.
\par 37. \'c9s \'f5k seg\'edts\'e9g\'e9rt fognak ki\'e1ltani ott: \'84Urunk! Vigy\'e9l ki minket, hogy j\'f3t cselekedj\'fcnk, nem olyat, amit [kor\'e1bban] cselekedt\'fcnk!\'94 Vajon nem hagytuk-e, hogy olyan kort \'e9rjetek el, ami alatt az, aki akart eml
\'e9kezni, eml\'e9kezett volna? \'c9s elj\'f6tt hozz\'e1tok a figyelmeztet\'f5. \'cdzlelj\'e9tek h\'e1t meg [a gy\'f6trelmet]! Az igazs\'e1gtalanoknak nem lesz seg\'edt\'f5j\'fck.
\par 38. Bizony, Allah tudja az egek \'e9s a f\'f6ld rejtett dolgait. Bizony, Neki tudom\'e1sa van arr\'f3l, amit a keblek rejtenek.
\par 
\par 39. \'d5 az, aki [a kor\'e1bbi nemzed\'e9kek] ut\'f3daik\'e9nt helyezett titeket a f\'f6ldre. Aki pedig hitetlen, annak a hitetlens\'e9ge saj\'e1t mag\'e1t terheli, \'e9s a hitetleneket az \'f5 hitetlens\'e9g\'fck nem gyarap\'edtja m\'e1sban Uruk el\'f5
tt, }{\insrsid13659446\charrsid2376327 mint gy\'fbl\'f6let}{\insrsid13659446 ess\'e9g}{\insrsid13659446\charrsid2376327 ben.}{\insrsid13659446  \'c9s nem gyarap\'edtja a hitetleneket a hitetlens\'e9g m\'e1sban, mint vesztes\'e9gben.
\par 40. Mondd [\'f3 Mohamed]: \'84Vajon mit gondoltok azokr\'f3l, akiket [Allah mell\'e9] t\'e1rsistenk\'e9nt \'e1ll\'edtottatok, akikhez Allah helyett foh\'e1szkodtatok? Mutass\'e1tok meg nekem, mit teremtettek \'f5k a f\'f6ldb\'f5l, vagy tal\'e1n r\'e9
szesed\'e9s\'fck van az egekb\'f5l? Avagy \'cdr\'e1st adtunk-e nekik, mi\'e1ltal \'f5k nyilv\'e1nval\'f3 bizony\'edt\'e9kokkal rendelkeznek [az \'e1ll\'edt\'e1sukr\'f3l]?\'94 Ellenkez\'f5leg! Az igazs\'e1gtalanok nem \'edg\'e9rnek m\'e1st egym\'e1
snak, csup\'e1n megt\'e9veszt\'e9st.
\par 41. Bizony, Allah tartja (\'f5rzi) meg az egeket \'e9s a f\'f6ldet att\'f3l, hogy elm\'faljanak, \'e9s ha elm\'faln\'e1nak, akkor nem lenne senki, aki azut\'e1n megtartan\'e1 azt (megakad\'e1lyozn\'e1 elm\'fal\'e1sukat). Bizony, \'d5 B\'e9ket\'fbr\'f5
, Megbocs\'e1t\'f3.
\par 
\par 42. \'c9s Allahra esk\'fcdtek meg a leger\'f5teljesebb esk\'fcikkel, hogy ha figyelmeztet\'f5 j\'f6nne el hozz\'e1juk, akkor \'f5k igazabb \'faton j\'e1rn\'e1nak b\'e1rmely k\'f6z\'f6ss\'e9gn\'e9l. \'c1m miut\'e1n figyelmeztet\'f5 j\'f6tt el hozz\'e1
juk, az nem gyarap\'edtotta \'f5ket m\'e1sban, csup\'e1n }{\cs100\insrsid13659446 viszolyg\'e1sban [az igazs\'e1gt\'f3l].}{\insrsid13659446 
\par 43. Fennh\'e9j\'e1zva [j\'e1rva] a f\'f6ld\'f6n \'e9s gonosz cseleket sz\'f5ve. \'c1m a gonosz cselsz\'f6v\'e9s nem ker\'edt be m\'e1st, csup\'e1n a kieszel\'f5it. Vajon mi m\'e1st v\'e1rhatnak \'f5k, mint a hajdanvoltakkal [szembeni] t\'f6rv\'e9nyszer
\'fb elj\'e1r\'e1st, \'e1m nem tal\'e1lsz az Allah [\'e1ltal elrendelt] t\'f6rv\'e9nyszer\'fbs\'e9gben [semmif\'e9le] v\'e1ltoz\'e1st, \'e9s nem tal\'e1lsz az Allah [\'e1ltal elrendelt] t\'f6rv\'e9nyszer\'fbs\'e9gben [semmif\'e9le] megm\'e1s\'edt\'e1st.

\par 44. H\'e1t nem j\'e1rt\'e1k-e be a f\'f6ldet, \'e9s n\'e9zt\'e9k meg, milyen v\'e9gre jutottak azok, akik el\'f5tt\'fck \'e9ltek? \'c9s azok er\'f5sebbek voltak n\'e1luk! Lehetetlen az, hogy Allahot b\'e1rmi is megakad\'e1lyozza az egekben \'e9s a f\'f6ld
\'f6n. Bizony, \'d5 Mindentud\'f3, }{\insrsid13659446\charrsid15340295 \'e9s Mindenhat\'f3.}{\insrsid13659446 
\par 45. \'c9s ha Allah megb\'fcntetn\'e9 az embereket az\'e9rt, amit elk\'f6vettek, akkor nem hagyna a [f\'f6ld] sz\'edn\'e9n egyetlen mozg\'f3 \'e9l\'f5l\'e9nyt sem. \'d5 azonban halad\'e9kot ad nekik egy megszabott hat\'e1rid\'f5ig (a Felt\'e1mad\'e1s napj
\'e1ig), \'e9s ha elj\'f6n a hat\'e1ridej\'fck [akkor mindenki megkapja a meg\'e9rdemelt fizets\'e9g\'e9t]. \'c9s bizony, Allah belel\'e1t a szolg\'e1iba.
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446 \page }{
\f0\fs24\insrsid13659446\charrsid3423863 36. J\'e1sz\'edn (J\'e1sz\'edn) c. sz\'fara}{\insrsid13659446 
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 {\insrsid13659446 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. J\'e1-sz\'edn.
\par 2. [Esk\'fcsz\'f6m] a b\'f6lcs Kor\'e1nra!{\*\bkmkstart 315}{\*\bkmkend 315}
\par 3. Bizony, te val\'f3ban a k\'fcld\'f6ttek k\'f6z\'fcl val\'f3 vagy{\*\bkmkstart 414}{\*\bkmkend 414},
\par 4. Az Egyenes \'faton.{\*\bkmkstart 514}{\*\bkmkend 514}
\par 5. [Ez] a M\'e9lt\'f3s\'e1gteljes, az Irgalmas lebocs\'e1tott [kinyilatkoztat\'e1sa],
\par {\*\bkmkstart 761}{\*\bkmkend 761}6. Hogy figyelmeztess vele egy olyan n\'e9pet, amelynek aty\'e1i nem lettek figyelmeztetve, ez\'e9rt \'f5k figyelmen k\'edv\'fcl hagyj\'e1k [az egyistenhitet].
\par 7. Bizony, beigazol\'f3dott m\'e1r a sz\'f3 [a b\'fcntet\'e9sr\'f5l] a legt\'f6bbj\'fckkel szemben, hiszen \'f5k nem hisznek.
\par 8. Bizony, Mi bilincseket tett\'fcnk a nyakukba, melyek az \'e1llukig \'e9rnek, \'edgy a fej\'fck felfel\'e9 van szegezve.
\par 9. \'c9s g\'e1tat tett\'fcnk el\'e9j\'fck \'e9s g\'e1tat tett\'fcnk m\'f6g\'e9j\'fck is, \'e9s bebor\'edtottuk \'f5ket, \'edgy \'f5k nem l\'e1tnak.
\par 10. }{\insrsid13659446\charrsid15151310 \'c9s egyre}{\insrsid13659446  megy nekik, hogy figyelmeztetted-e \'f5ket [\'f3 Mohamed] vagy nem figyelmeztetted, nem hisznek.
\par 11. Te csak azt figyelmezteted, aki k\'f6veti az Eml\'e9keztet\'f5t (a Kor\'e1nt), \'e9s f\'e9l a K\'f6ny\'f6r\'fcletest\'f5l, an\'e9lk\'fcl, hogy l\'e1tn\'e1. Adj h\'e1t neki \'f6r\'f6mh\'edrt megbocs\'e1t\'e1sr\'f3l \'e9s nemes jutalomr\'f3l!
\par 12. Bizony, Mi keltj\'fck \'e9letre a halottakat, \'e9s feljegyezz\'fck azt, amit [a tetteikb\'f5l] el\'f5re k\'fcldtek \'e9s [a h\'e1trahagyott] nyomaikat. \'c9s mindent sz\'e1mba vett\'fcnk egy Nyilv\'e1nval\'f3 \'cdr\'e1sban (az \'d5rz\'f6tt T\'e1bl
\'e1n).
\par 
\par 13. \'c9s adj nekik p\'e9ld\'e1zatot a v\'e1ros lak\'f3ir\'f3l, amikor elj\'f6ttek oda a k\'fcld\'f6ttek!
\par 14. Amikor elk\'fcldt\'fcnk hozz\'e1juk k\'e9t [k\'fcld\'f6ttet], \'e1m meghazudtolt\'e1k \'f5ket, ez\'e9rt meger\'f5s\'edtett\'fck [kettej\'fcket] egy harmadikkal, \'e9s azt mondt\'e1k [a k\'fcld\'f6ttek]: \'84Bizony, mi hozz\'e1tok k\'fcldett\'fcnk.\'94

\par 15. Azt mondt\'e1k [a v\'e1ros lak\'f3i]: \'84Nem vagytok m\'e1sok, mint hozz\'e1nk hasonl\'f3 emberek, \'e9s a K\'f6ny\'f6r\'fcletes semmit sem bocs\'e1tott le. Ti csak hazudtok.\'94
\par 16. Azt mondt\'e1k [a k\'fcld\'f6ttek]: \'84A mi Urunk tudja, hogy bizony, mi val\'f3ban hozz\'e1tok k\'fcldett\'fcnk.
\par 17. \'c9s r\'e1nk nem tartozik m\'e1s, csup\'e1n a vil\'e1gos [\'fczenet-]\'e1tad\'e1s.\'94
\par 18. Azt mondt\'e1k [a v\'e1ros lak\'f3i]: \'84Bizony rossz el\'f5jelet l\'e1tunk bennetek! Bizony, ha nem hagyj\'e1tok abba, akkor megk\'f6vez\'fcnk titeket, \'e9s f\'e1jdalmas b\'fcntet\'e9s fog r\'e9sz\'fcnkr\'f5l \'e9rni titeket.\'94}{
\cs100\cf1\insrsid13659446 
\par 19. Azt mondt\'e1k [a k\'fcld\'f6ttek]: \'84A rossz el\'f5jeleitek saj\'e1t magatokn\'e1l vannak. Vajon [megk\'f6veztek,] ha eml\'e9keztetve lettetek? Ti ink\'e1bb egy m\'e9rt\'e9ktelen n\'e9p vagytok!\'94
\par 
\par 20. \'c9s igyekezve j\'f6tt egy ember a v\'e1ros legt\'e1volabbi r\'e9sz\'e9r\'f5l, \'e9s azt mondta: \'84\'d3 n\'e9pem! K\'f6vess\'e9tek a k\'fcld\'f6tteket!
\par 21. K\'f6vess\'e9tek azokat, akik nem k\'e9rnek t\'f5letek jutalmat, \'e9s akik az [igaz] \'fatra leltek!
\par 22. \'c9s mi\'e9rt ne szolg\'e1ln\'e1m azt, aki l\'e9trehozott engem, \'e9s akihez vissza lesztek vitetve?
\par 23. Vajon Helyette [m\'e1sokat] tegyek }{\cs100\cf1\insrsid13659446\charrsid2376327 meg istenekk\'e9}{\cs100\cf1\insrsid13659446 ? Ha a K\'f6ny\'f6r\'fcletes \'e1rtani akarna nekem, akkor semmiben sem v\'e1lna hasznomra a k\'f6zbenj\'e1r\'e1suk, \'e9
s nem menten\'e9nek meg.
\par 24. Akkor bizony nyilv\'e1nval\'f3 t\'e9velyg\'e9sben lenn\'e9k.
\par 25. Bizony \'e9n hiszek az Uratokban, hallgassatok h\'e1t r\'e1m!\'94
\par 26. [Miut\'e1n meg\'f6lt\'e9k, az lett neki mondva]: \'84L\'e9pj be a Paradicsomba!\'94 [\'d5] azt mondta: \'84\'d3, b\'e1rcsak a n\'e9pem megtudn\'e1,
\par 27. Hogy megbocs\'e1tott nekem az Uram \'e9s azok k\'f6z\'e9 helyezett engem, akik megtiszteltet\'e9sben r\'e9szes\'fcltek!\'94
\par 
\par }{\insrsid13659446 28. \'c9s \'f5ut\'e1na nem bocs\'e1tottunk le n\'e9pe ellen sereget az \'e9gb\'f5l, \'e9s [az ilyenek ellen] nem is bocs\'e1tunk le.
\par 29. Csup\'e1n egyetlen ki\'e1lt\'e1s volt, \'e9s \'edme kialudt t\'fbzk\'e9nt [pusztultak el mindannyian].
\par 30. Mily nagy b\'e1natban lesz r\'e9sze [az elpusztult] szolg\'e1knak! Nem j\'f6tt el hozz\'e1juk egyetlen k\'fcld\'f6tt sem an\'e9lk\'fcl, hogy ne \'fbztek volna g\'fanyt bel\'f5le.
\par 31. Vajon nem gondolkodtak el azon, h\'e1ny el\'f5tt\'fck \'e9lt nemzed\'e9ket puszt\'edtottunk el, [akik t\'f6bb\'e9] nem t\'e9rnek vissza hozz\'e1juk?
\par 32. \'c9s bizony, mindannyian, egyt\'f5l-egyig Miel\'e9nk lesznek el\'f5hozatva.
\par 
\par 33. \'c9s jel sz\'e1mukra a halott f\'f6ld, amit \'e9letre keltett\'fcnk, \'e9s [gabona]szemeket sarjasztottunk bel\'f5le, \'e9s \'f5k abb\'f3l esznek.
\par 34. \'c9s datolyap\'e1lm\'e1kb\'f3l \'e9s sz\'f5l\'f5t\'f5k\'e9kb\'f5l \'e1ll\'f3 kerteket helyezt\'fcnk r\'e1, \'e9s forr\'e1sokat fakasztottunk bel\'f5le,{\*\bkmkstart 354}{\*\bkmkend 354}
\par 35. Hogy egyenek a term\'e9seib\'f5l, \'e9s abb\'f3l, amit az \'f5 kez\'fck k\'e9sz\'edtett. Vajon h\'e1t nem adnak h\'e1l\'e1t?
\par 36. Magasztaltass\'e9k az, aki megteremtette a p\'e1rokat, az \'f6sszeset: a f\'f6ld sarjasztotta [n\'f6v\'e9nyfajt\'e1kat], \'e9s a [saj\'e1t] magukb\'f3l [nemzetteket, f\'e9rfiakat \'e9s n\'f5ket], \'e9s azokb\'f3l, amelyekr\'f5l nincsen tud\'e1suk!

\par }{\insrsid13659446\charrsid2376327 37. \'c9s jel sz\'e1mukra az \'e9j: kih\'fazzuk bel\'f5le a nappalt (a f\'e9nyt), \'e9s \'edme s\'f6t\'e9ts\'e9g borul r\'e1juk.}{\insrsid13659446 
\par {\*\bkmkstart 395}{\*\bkmkend 395}38. \'c9s a Nap nyugv\'e1s\'e1nak idej\'e9ig fut. Ez a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs elrendel\'e9se.
\par 39. \'c9s a Holdnak \'e1llom\'e1sokat rendelt el, m\'edg \'fagy nem t\'e9r vissza, mint egy \'f6reg, kisz\'e1radt p\'e1lma\'e1g.
\par 40. Sem a Napnak nem szabad utol\'e9rnie a Holdat, sem az \'e9jjel nem el\'f5zheti meg a nappalt, \'e9s mindegyik a kering\'f5 \'fatj\'e1n \'faszik.
\par 41. \'c9s jel sz\'e1mukra az, hogy Mi bizony a megrakott b\'e1rk\'e1n vitt\'fck a lesz\'e1rmazottaikat.
\par 42. \'c9s teremtett\'fcnk nekik ahhoz hasonl\'f3t, amelyen utaznak.
\par 43. \'c9s ha \'fagy akarjuk, akkor v\'edzbe fullasztjuk \'f5ket, \'e9s nem lenne senki, aki v\'e1laszolna a ki\'e1lt\'e1sukra, \'e9s nem lenn\'e9nek megmentve,
\par 44. Csup\'e1n a mi k\'f6ny\'f6r\'fclet\'fcnkb\'f5l, \'e9s [hogy] egy ideig tart\'f3 \'e9lvezetben [legyen r\'e9sz\'fck].{\*\bkmkstart 455}{\*\bkmkend 455}
\par 45. \'c9s ha azt mondj\'e1k nekik: \'84\'d3vakodjatok [a b\'fbn\'f6kt\'f5l], amit elk\'f6vettetek \'e9s amit el fogtok k\'f6vetni, }{\insrsid13659446\charrsid2376327 h\'e1tha k\'f6ny\'f6r\'fcletre leltek!{\*\bkmkstart 464}{\*\bkmkend 464}\'94}{
\insrsid13659446  [akkor elfordulnak].
\par 46. \'c9s nem j\'f6tt el hozz\'e1juk egyetlen jel sem Allah jelei k\'f6z\'fcl an\'e9lk\'fcl, hogy ne fordultak volna el att\'f3l.
\par 47. \'c9s ha azt mondj\'e1k nekik: \'84Adakozzatok abb\'f3l, amivel Allah ell\'e1tott titeket!\'94, akkor azok, akik hitetlenek, azt mondj\'e1k azoknak, akik hisznek: \'84Vajon azt t\'e1pl\'e1ljuk, akit t\'e1pl\'e1lna Allah, ha [\'fagy] akarn\'e1
? Bizony, hogy ti nyilv\'e1nval\'f3 t\'e9velyg\'e9sben vagytok!\'94
\par 
\par 48. \'c9s azt mondj\'e1k: \'84Mikor [k\'f6vetkezik be] ez az \'edg\'e9ret [a b\'fcntet\'e9sr\'f5l], }{\insrsid13659446\charrsid5333168 ha val\'f3ban}{\insrsid13659446  igazmond\'f3k vagytok?\'94
\par 49. Nem v\'e1rnak m\'e1sra, csup\'e1n egyetlen ki\'e1lt\'e1sra, amely megragadja \'f5ket, mik\'f6zben vit\'e1znak.{\*\bkmkstart 504}{\*\bkmkend 504}
\par 50. Akkor nem fognak v\'e9grendelkezni, sem visszat\'e9rni a h\'e1zuk n\'e9p\'e9hez.
\par 51. \'c9s megf\'favatik a k\'fcrt, \'e9s \'edme \'f5k a s\'edrokb\'f3l az Uruk el\'e9 sietnek.
\par 52. Azt mondj\'e1k: \'84Jaj nek\'fcnk! Ki keltett fel minket a fekhely\'fcnkr\'f5l?\'94 [Az mondatik nekik:] \'84Ez az, amit a K\'f6ny\'f6r\'fcletes meg\'edg\'e9rt, \'e9s igazat mondtak a k\'fcld\'f6ttek.{\*\bkmkstart 534}{\*\bkmkend 534}\'94
\par 53. Csup\'e1n egyetlen ki\'e1lt\'e1s lesz \'e9s \'edme, {\*\bkmkstart 544}{\*\bkmkend 544}mindannyian, egyt\'f5l-egyig, Miel\'e9nk lesznek el\'f5hozatva.
\par 54. \'c9s ma nem fog egyetlen ember sem igazs\'e1gtalans\'e1got elszenvedni semmiben, \'e9s nem kaptok [m\'e1s\'e9rt] fizets\'e9get, csak az\'e9rt, amit cselekedtetek.
\par 
\par 55. Bizony, a Paradicsom lak\'f3i ma el vannak foglalva \'f6r\'f6meikkel.
\par {\*\bkmkstart 573}{\*\bkmkend 573}56. \'d5k \'e9s a feles\'e9geik \'e1rny\'e9kban lesznek, \'e9s kerevetekre d\'f5lve fekszenek.
\par 57. Gy\'fcm\'f6lcs\'f6k lesznek ott nekik, \'e9s mindaz, amit csak k\'edv\'e1nnak.
\par 58. \'84B\'e9kess\'e9g\'94 - ez lesz az [\'fcdv\'f6zl\'e9s] szava az irgalmas \'dart\'f3l.
\par 
\par 59. K\'fcl\'f6n\'fcljetek h\'e1t el ma, ti igazs\'e1gtalanok!
\par 60. \'d3 \'c1d\'e1m fiai! Vajon nem hagytam-e meg nektek azt, hogy ne szolg\'e1lj\'e1tok a s\'e1t\'e1nt? Bizony, \'f5 nyilv\'e1nval\'f3 ellens\'e9getek.
\par 61. \'c9s hogy engem szolg\'e1ljatok?! Ez az egyenes \'fat!{\*\bkmkstart 6221}{\*\bkmkend 6221} 
\par 62. \'c9s bizony [a s\'e1t\'e1n] sz\'e1mos embert\'f6meget vitt t\'e9velyg\'e9sbe k\'f6z\'fcletek. Vajon h\'e1t nem \'e9ltek az eszetekkel?
\par 63. Ez [itt most] a Gyehenna, amelyre \'edg\'e9retet kaptatok.
\par 64. \'c9gjetek h\'e1t benne a mai napon, ami\'e9rt hitetlenek voltatok!
\par 65. A mai napon lepecs\'e9telj\'fck a sz\'e1jukat, \'e9s a kez\'fck fog besz\'e9lni nek\'fcnk \'e9s a l\'e1buk fog tan\'faskodni arr\'f3l, amire kor\'e1bban szert tettek.
\par 66. \'c9s ha [\'fagy] akartuk volna, akkor kioltottuk volna a szem\'fck vil\'e1g\'e1t, azt\'e1n versengve igyekezhetn\'e9nek az egyenes \'fatra, \'e1m hogyan l\'e1thatn\'e1nak?
\par 67. \'c9s ha [\'fagy] akartuk volna, akkor eltorz\'edthattuk (megb\'e9n\'edthattuk) volna \'f5ket ott, ahol vannak, azt\'e1n nem tudtak volna sem elmenni, sem visszat\'e9rni.
\par 68. \'c9s akinek hossz\'fa \'e9letet adunk, azt hanyatl\'e1sba juttatjuk a teremtetts\'e9g\'e9ben. Vajon h\'e1t nem \'e9ltek az eszetekkel?{\*\bkmkstart 6921}{\*\bkmkend 6921} 
\par 
\par 69. \'c9s nem tan\'edtottuk meg neki (Mohamednek) a k\'f6lt\'e9szetet, \'e9s nem is illik hozz\'e1! Nem m\'e1s ez, mint eml\'e9keztet\'e9s \'e9s egy nyilv\'e1nval\'f3 Kor\'e1n,
\par 70. Hogy figyelmeztesse azt, aki \'e9l, \'e9s beigazol\'f3djon a sz\'f3 [a b\'fcntet\'e9sr\'f5l] a hitetleneken!
\par 
\par 71. Vajon nem l\'e1tt\'e1k-e, hogy Mi teremtett\'fcnk nekik j\'f3sz\'e1gokat abb\'f3l, amit a kez\'fcnk hozott l\'e9tre, \'e9s \'edme \'f5k birtokolj\'e1k azokat?
\par 72. \'c9s megszel\'edd\'edtett\'fck azokat nekik, \'e9s azok k\'f6z\'fcl vannak olyanok, amelyeket utaz\'e1sra haszn\'e1lnak, \'e9s vannak olyanok, amelyeket megesznek.
\par 73. \'c9s [m\'e1s] hasznuk \'e9s italuk van bel\'f5l\'fck. Vajon h\'e1t nem adnak h\'e1l\'e1t?
\par 74. \'c9s Allah helyett }{\cs100\cf1\insrsid13659446 [m\'e1sokat] tettek }{\cs100\cf1\insrsid13659446\charrsid2376327 meg istenekk\'e9}{\insrsid13659446\charrsid2376327 , h\'e1tha}{\insrsid13659446  meg lesznek seg\'edtve.
\par 75. [A hamis istenek] nem tudnak seg\'edteni rajtuk, \'e9s \'f5k [maguknak] is olyan seregeik lesznek, amelyek [vel\'fck egy\'fctt lesznek] el\'f5hozatva [a Pokol-t\'fbzbe].
\par 76. H\'e1t ne szomor\'edtson el t\'e9ged a besz\'e9d\'fck! Bizony, Mi tudjuk azt, amit elrejtenek \'e9s azt, amit kinyilv\'e1n\'edtanak.
\par 
\par 77. Vajon nem gondolkodott el az ember [azon], hogy megteremtett\'fck egy [megterm\'e9keny\'fclt] cseppb\'f5l, \'e9s \'edme, \'f5 [m\'e9gis] nyilv\'e1nval\'f3 vit\'e1z\'f3?
\par 78. \'c9s p\'e9ld\'e1zatot adott Nek\'fcnk, \'e9s elfelejtette a saj\'e1t teremt\'e9s\'e9t. }{\insrsid13659446\charrsid9387881 Azt mondta:}{\insrsid13659446  \'84Ki kelti \'e9letre a csontokat, miut\'e1n elporladtak?\'94
\par 79. Mondd: \'84Az kelti \'e9letre, aki l\'e9trehozta els\'f5 alkalommal, \'e9s akinek minden teremt\'e9sr\'f5l tudom\'e1sa van,
\par 80. Aki a z\'f6ld f\'e1b\'f3l k\'e9sz\'edtett nektek t\'fczet, \'e9s \'edme, ti abb\'f3l gy\'fajtotok [t\'fczet].
\par 81. Vajon az, aki megteremtette az egeket \'e9s a f\'f6ldet, ne lenne k\'e9pes arra, hogy azokhoz hasonl\'f3kat teremtsen? Dehogynem! \'c9s \'d5 a Teremt\'f5, a Mindentud\'f3.
\par 82. Az \'d5 parancsa, ha akar egy dolgot [hogy legyen], csup\'e1n az, hogy azt mondja annak: \'84Legy\'e9l!\'94, \'e9s az van.
\par 83. Magasztaltass\'e9k az, akinek a kez\'e9ben van mindenek birodalma, \'e9s Hozz\'e1 lesztek visszat\'e9r\'edtve.
\par 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446 \page }{
\f0\fs24\insrsid13659446\charrsid3423863 37. A felsorakoz\'f3 angyalok (asz-Szaff\'e1t) c. sz\'fara}{\insrsid13659446 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446  
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1 A sorokban felsorakoz\'f3kra,}{\f0\insrsid13659446 
\par }{\insrsid13659446 2. \'c9s [a felh\'f5ket] er\'f5s hajt\'e1ssal hajt\'f3kra,
\par 3. \'c9s az Eml\'e9keztet\'f5t{\*\bkmkstart 4}{\*\bkmkend 4} recit\'e1l\'f3kra! 
\par 4. Bizony, a ti Istenetek Egy.
\par {\*\bkmkstart 5}{\*\bkmkend 5}5. Ura az egeknek \'e9s a f\'f6ldnek, \'e9s annak, ami a kett\'f5 k\'f6z\'f6tt van, \'e9s Ura a napkelt\'e9knek.
\par 6. Bizony, Mi feld\'edsz\'edtett\'fck a legals\'f3 \'e9gboltot a csillagok d\'edsz\'e9vel.
\par {\*\bkmkstart 7}{\*\bkmkend 7}7. \'c9s \'f5rz\'e9sk\'e9ppen minden l\'e1zad\'f3 s\'e1t\'e1n ellen.
\par 8. Nem hallhatj\'e1k meg a legfels\'f5bb el\'f5kel\'f5 [angyalok gy\'fbl\'e9s\'e9t], \'e9s megdob\'e1ltatnak minden oldalr\'f3l,
\par 9. El\'fbz\'e9s\'fcl. \'c9s \'f6r\'f6kk\'e9 tart\'f3 gy\'f6trelemben lesz r\'e9sz\'fck,
\par 10. Kiv\'e9ve azt, aki elkap [az angyalok besz\'e9d\'e9b\'f5l] valamit, azt viszont egy f\'e9nyes \'fcst\'f6k\'f6s k\'f6veti.
\par 
\par 11. K\'e9rj h\'e1t felvil\'e1gos\'edt\'e1st t\'f5l\'fck arr\'f3l, hogy vajon \'f5k vannak-e er\'f5sebbre teremtve, vagy azok [a m\'e1s l\'e9tez\'f5k], amiket teremtett\'fcnk? Bizony, Mi ragad\'f3s agyagb\'f3l teremtett\'fck \'f5ket.
\par 12. De nem! Te csod\'e1lkozol [a hitetlens\'e9g\'fck\'f6n], m\'edg \'f5k g\'fanyol\'f3dnak [a k\'fcldet\'e9seden],
\par 13. \'c9s ha eml\'e9keztet\'e9st kapnak, nem hallgatnak az eml\'e9keztet\'e9sre,
\par 14. \'c9s ha valamilyen jelet l\'e1tnak, g\'fanyt \'fbznek bel\'f5le.
\par 15. \'c9s azt mondj\'e1k: \'84Ez bizony nyilv\'e1nval\'f3 var\'e1zslat!{\*\bkmkstart 16}{\*\bkmkend 16}
\par 16. Vajon ha m\'e1r meghaltunk, \'e9s porr\'e1 \'e9s csontt\'e1 lett\'fcnk, akkor \'faj \'e9letre lesz\'fcnk felt\'e1masztva?
\par 17. \'c9s vajon a hajdanvolt aty\'e1ink is?\'94
\par {\*\bkmkstart 18}{\*\bkmkend 18}18. Mondd: \'84Igen! \'c9s ti megal\'e1zottan [fogtok felt\'e1madni]{\*\bkmkstart 19}{\*\bkmkend 19}.\'94
\par {\*\bkmkstart 20}{\*\bkmkend 20}19. \'c9s csak egyetlen ki\'e1lt\'e1s lesz akkor, \'e9s \'edme, \'f5k k\'f6r\'fcln\'e9znek [elsz\'f6rnyedve],
\par 20. \'c9s azt mondj\'e1k: \'84Jaj nek\'fcnk! Ez az \'cdt\'e9let napja!\'94
\par 21. [Az lesz nekik mondva:] \'84Ez a D\'f6nt\'e9s napja, amelyet kor\'e1bban meghazudtoltatok!\'94
\par 
\par 22. [Az lesz mondva az angyaloknak:] \'84Gy\'fbjts\'e9tek \'f6ssze azokat, akik igazs\'e1gtalans\'e1got k\'f6vettek el, \'e9s [vel\'fck egy\'fctt] a hozz\'e1juk hasonl\'f3kat, \'e9s azokat, amiket szolg\'e1ltak
\par 23. Allah helyett, \'e9s vezess\'e9tek \'f5ket a Pokol \'fatj\'e1ra!{\*\bkmkstart 24}{\*\bkmkend 24}
\par 24. \'c9s \'e1ll\'edts\'e1tok meg \'f5ket! Bizony, \'f5k k\'e9rd\'f5re lesznek vonva!{\*\bkmkstart 25}{\*\bkmkend 25}\'94
\par 25. \'84Mi lelt titeket, hogy nem seg\'edtitek egym\'e1st?{\*\bkmkstart 26}{\*\bkmkend 26}\'94
\par 26. De nem! \'d5k ma al\'e1vetik magukat [Allah parancs\'e1nak].
\par 27. \'c9s egyesek k\'f6z\'fcl\'fck a t\'f6bbiekhez fordulnak, k\'e9rdezgetv\'e9n egym\'e1st [vitatkozva].
\par 28. Azt mondj\'e1k: \'84Bizony, ti jobb fel\'f5l (hatalmatokat kihaszn\'e1lva) j\'f6ttetek hozz\'e1nk.\'94
\par 29. [Azok] azt mondj\'e1k: \'84De Nem! Ti nem voltatok h\'edv\'f5k.
\par 30. \'c9s nek\'fcnk nem volt hatalmunk }{\insrsid13659446\charrsid10503002 f\'f6l\'f6ttetek. Nem! Ti t\'falkap\'e1sra vetemed\'f5 n\'e9p voltatok.}{\insrsid13659446 
\par 31. Jogoss\'e1 v\'e1lt vel\'fcnk szemben az Urunk [b\'fcntet\'e9sr\'f5l kimondott] szava, hogy bizony, meg fogjuk \'edzlelni [a b\'fcntet\'e9st].
\par 32. T\'e9v\'fatra vitt\'fcnk h\'e1t titeket, bizony [mi] is t\'e9v\'faton voltunk.\'94
\par 33. \'c9s bizony, \'f5k azon a napon k\'f6z\'f6sen fognak r\'e9szes\'fclni a gy\'f6trelemben.
\par 34. Bizony, Mi \'edgy tesz\'fcnk a gonosztev\'f5kkel.
\par 35. Amikor azt mondt\'e1k nekik: \'84Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, csak Allah\'94, bizony \'f5k fennh\'e9j\'e1ztak.
\par 36. \'c9s azt mondt\'e1k: \'84Vajon hagyjuk el isteneinket egy \'f5r\'fclt k\'f6lt\'f5 kedv\'e9\'e9rt?{\*\bkmkstart 37}{\*\bkmkend 37}\'94
\par 37. De nem}{\insrsid13659446\charrsid7361197 ! \'d5 az Igazs\'e1got hozta el \'e9s meger\'f5s\'edtette a [kor\'e1bbi] k\'fcld\'f6ttek igazs\'e1g\'e1t!
\par 38. Bizony, meg fogj\'e1tok \'edzlelni a f\'e1jdalmas gy\'f6trelmet!
\par 39. \'c9s nem kaptok [m\'e1s\'e9rt] fizets\'e9get, mint amit cselekedtetek.
\par 
\par 40. Kiv\'e9ve Allah kiv\'e1lasztott (\'f5szinte hit\'fb) szolg\'e1it.
\par 41. Nekik meghat\'e1rozott ell\'e1t\'e1sban lesz r\'e9sz\'fck:
\par 42. Gy\'fcm\'f6lcs\'f6k [j\'e1rnak nekik], \'e9s \'f5k megbecs\'fcltek lesznek
\par 43. A gy\'f6ny\'f6r\'fbs\'e9g kertjeiben}{\insrsid13659446  [a Paradicsomban].
\par 44. Kereveteken [\'fclnek] egym\'e1ssal szemben.
\par 45. K\'f6rbe fognak j\'e1rni k\'f6z\'f6tt\'fck poh\'e1rral, amelyben olyan kifogyhatatlan forr\'e1sb\'f3l sz\'e1rmaz\'f3 ital van,
\par 46. Amely [ragyog\'f3] feh\'e9r \'e9s \'edzletes az iv\'f3knak.
\par 47. Nincs }{\insrsid13659446\charrsid7361197 benne \'e1rtalom,}{\insrsid13659446  \'e9s nem fognak megr\'e9szeg\'fclni t\'f5le.
\par 48. \'c9s les\'fct\'f6tt tekintet\'fb, nagyszem\'fb feles\'e9geik lesznek mellett\'fck.
\par 49. Mintha elrejtett gy\'f6ngy\'f6k lenn\'e9nek.
\par 
\par 50. \'c9s egyesek k\'f6z\'fcl\'fck a t\'f6bbiekhez fordulnak, k\'e9rdezgetv\'e9n egym\'e1st.
\par 51. Egyik\'fck k\'f6z\'fcl\'fck az mondta: \'84Bizony, volt nekem egy [\'e1lland\'f3] k\'eds\'e9r\'f5m [az evil\'e1gban],{\*\bkmkstart 52}{\*\bkmkend 52}
\par 52. Aki azt mondta: \'84Vajon te azok k\'f6z\'e9 tartozol, akik igaznak tartj\'e1k [a felt\'e1mad\'e1st]?
\par 53. Vajon ha m\'e1r meghaltunk, \'e9s porr\'e1 \'e9s csontt\'e1 lett\'fcnk, akkor meg lesz\'fcnk \'edt\'e9ltetve?\'94
\par 54. Azt mondta [ez a h\'edv\'f5 ember a t\'e1rsainak]: \'84R\'e1tekinten\'e9tek [velem]?\'94
\par 55. \'c9s r\'e1tekintett, \'e9s megl\'e1tta \'f5t a Pokol k\'f6zep\'e9n.
\par 56. Azt mondta: \'84Allahra [esk\'fcsz\'f6m]! Majdnem pusztul\'e1sba vitt\'e9l engem!
\par 57. \'c9s ha nem lett volna Uram j\'f3t\'e9tem\'e9nye, most azok k\'f6z\'e9 tartozn\'e9k, akiket el\'f5hozatnak [a b\'fcntet\'e9sre].
\par 58. Vajon mi nem fogunk meghalni,
\par 59. csup\'e1n az els\'f5 hal\'e1lunk alkalm\'e1val \'e9s mi nem fogunk b\'fcntet\'e9sben r\'e9szes\'fclni?{\*\bkmkstart 60}{\*\bkmkend 60}\'94
\par 60. Bizony, ez a hatalmas diadal!
\par 61. Ehhez hasonl\'f3\'e9rt cselekedjenek h\'e1t a cselekv\'f5k!
\par 
\par 62. Vajon ez a jobb sz\'e1ll\'e1shely, vagy a [Pokolban l\'e9v\'f5] Zakk\'fam-fa?
\par 63. Bizony, Mi k\'eds\'e9rt\'e9ss\'e9 tett\'fck azt az igazs\'e1gtalanoknak.
\par 64. Bizony, olyan fa ez, amely a Pokol alj\'e1b\'f3l n\'f5 ki,
\par 65. A term\'e9sei olyanok, mint a s\'e1t\'e1nok fejei.
\par 66. \'c9s \'f5k bizony enni fognak abb\'f3l \'e9s meg fogj\'e1k t\'f6lteni vele a hasukat.
\par 67. Azut\'e1n \'f5k bizony ehhez [az \'e9tel\'fckh\'f6z] kever\'e9kk\'e9nt, forr\'e1sban l\'e9v\'f5 vizet kapnak.
\par 68. Azut\'e1n bizony a Pokolhoz lesz a visszat\'e9r\'e9s\'fck.
\par 69. Bizony, \'f5k aty\'e1ikat t\'e9velyg\'e9sben tal\'e1lt\'e1k,
\par 70. \'c9s \'f5k [azoknak] a nyomdokaiban rohannak.
\par }\pard\plain \s103\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 71. \'c9s bizony, elt\'e9velyedett m\'e1r el\'f5tt\'fc
k a hajdanvoltak legt\'f6bbje.
\par 72. \'c9s bizony, elk\'fcldt\'fcnk m\'e1r k\'f6z\'e9j\'fck figyelmeztet\'f5ket.
\par 73. N\'e9zd h\'e1t meg milyen v\'e9gre jutottak azok, akik figyelmeztetve lettek!
\par 74. Kiv\'e9ve Allah kiv\'e1lasztott szolg\'e1i.
\par {\*\bkmkstart 75}{\*\bkmkend 75}
\par 75. \'c9s bizony sz\'f3l\'edtott minket No\'e9 \'e9s Mi vagyunk a legjobb v\'e1laszol\'f3k.
\par 76. \'c9s megmentett\'fck \'f5t \'e9s a csal\'e1dj\'e1t a hatalmas szorongattat\'e1sb\'f3l.
\par 77. \'c9s az \'f5 lesz\'e1rmazottait tett\'fck azokk\'e1, akik megmaradtak (t\'fal\'e9l\'f5kk\'e9).
\par 78. \'c9s [dics\'e9retet] hagytunk r\'f3la a k\'e9s\'f5bbi [nemzed\'e9kek] k\'f6z\'f6tt [\'edgy]:
\par 79. \'84B\'e9kess\'e9g No\'e9ra a teremtm\'e9nyek k\'f6z\'f6tt!\'94
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid13659446 80. Bizony Mi ekk\'e9ppen adjuk meg a fizets\'e9g\'e9t 
}{\insrsid13659446\charrsid3757099 a j\'f3tev\'f5knek.}{\insrsid13659446 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 81. Bizony, \'f5 (No\'e9) a Mi h\'edv\'f5 szolg\'e1ink k\'f6z\'fc
l val\'f3 [volt].
\par 82. Azut\'e1n v\'edzbe fullasztottuk a t\'f6bbieket.
\par 
\par 83. \'c9s bizony az \'f5 [\'fatj\'e1nak] k\'f6vet\'f5i k\'f6z\'e9 tartozott \'c1brah\'e1m.
\par {\*\bkmkstart 88}{\*\bkmkend 88}84. [Eml\'edtsd meg,] amikor elj\'f6tt az Ur\'e1hoz \'e9p sz\'edvvel!
\par 85. [Eml\'edtsd meg,] amikor az atyj\'e1nak \'e9s a n\'e9p\'e9nek azt mondta: \'84Mit szolg\'e1ltok?
\par 86. Vajon hazugs\'e1got, [hamis] isteneket akartok Allah helyett?
\par 87. Hogyan v\'e9lekedtek h\'e1t a teremtm\'e9nyek Ur\'e1r\'f3l?\'94
\par 88. \'c9s egy pillant\'e1st vetett a csillagokra,
\par 89. \'c9s azt mondta: \'84Bizony, beteg vagyok!\'94
\par 90. Azok pedig h\'e1tat ford\'edtottak neki, t\'e1vozva.
\par 91. \'d5 pedig [az isteneikhez ment \'e9s] azt mondta: \'84Vajon nem esztek?
\par 92. Mi lelt titeket, hogy nem sz\'f3laltok meg?\'94
\par 93. Azt\'e1n sietve fel\'e9j\'fck fordult, r\'e1juk s\'fajtva a jobb kez\'e9vel [apr\'f3 darabokra t\'f6rv\'e9n azokat].
\par 94. \'d5k (az emberek) pedig sietve mentek hozz\'e1.
\par 95. Azt mondta [\'c1brah\'e1m]: \'84Vajon azt szolg\'e1lj\'e1tok, amit ti faragtok ki,
\par 96. Mik\'f6zben Allah teremtett titeket \'e9s azt, amit k\'e9sz\'edtetek?\'94 
\par 97. Azt mondt\'e1k: \'84Emeljetek neki egy \'e9p\'edtm\'e9nyt \'e9s vess\'e9tek bele a [l\'e1ngol\'f3 t\'fbz] pokl\'e1ba!\'94
\par 98. Fondorlatot akartak sz\'f5ni ellene, de Mi lealacsony\'edtott\'e1 (megal\'e1zott\'e1) tett\'fck \'f5ket.
\par 
\par 99. \'c9s [\'c1brah\'e1m] azt mondta: \'84Bizony, \'e9n elmegyek az Uramhoz, \'d5 fog vezetni engem [az igaz \'faton].
\par 100. Uram! Aj\'e1nd\'e9kozz nekem [egy fi\'fagyermeket, aki] a j\'f3 emberek k\'f6z\'fcl val\'f3.\'94
\par 101. Ekkor \'f6r\'f6mh\'edrt adtunk neki egy b\'e9ket\'fbr\'f5 ifj\'far\'f3l.
\par 102. \'c9s azt\'e1n, amikor [Izmael] el\'e9rte [azt a kort], hogy m\'e1r vele tarthatott, [\'c1brah\'e1m] azt mondta neki: \'84\'d3 fiacsk\'e1m! Azt l\'e1ttam \'e1lmomban, hogy fel\'e1ldozlak. Fontold h\'e1t meg, mi a v\'e9lem\'e9nyed!\'94
 [Izmael] azt mondta: \'84\'d3 ap\'e1m! Tedd azt, amire parancsot kapt\'e1l! Ha Allah \'fagy akarja, akkor a t\'fcrelmesek k\'f6z\'fcl val\'f3 leszek.\'94
\par 103. \'c9s miut\'e1n al\'e1vetett\'e9k magukat [Allah akarat\'e1nak] \'e9s homlok\'e1ra fektette [hogy fel\'e1ldozza],
\par 104. Mi megsz\'f3l\'edtottuk \'f5t: \'84\'d3 \'c1brah\'e1m!
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid13659446 105. Bizony, beteljes\'edtetted [amit l\'e1tt\'e1l] 
\'e1lmodban!\'94 Bizony Mi ekk\'e9ppen adjuk meg a fizets\'e9g\'e9t }{\insrsid13659446\charrsid8273728 a j\'f3tev\'f5knek.}{\insrsid13659446 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 106. Bizony, ez [volt] a nyilv\'e1nval\'f3 pr\'f3bat\'e9tel.
\par 107. \'c9s egy hatalmas \'e1ldozattal (egy kossal) v\'e1ltottuk meg \'f5t.
\par 108. \'c9s [dics\'e9retet] hagytunk r\'f3la a k\'e9s\'f5bbi [nemzed\'e9kek] k\'f6z\'f6tt [\'edgy]:
\par 109. \'84B\'e9kess\'e9g \'c1brah\'e1mra!\'94
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid13659446 110. Ekk\'e9ppen adjuk meg a }{
\insrsid13659446\charrsid8273728 fizets\'e9g\'e9t a j\'f3tev\'f5knek.}{\insrsid13659446 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 111. Bizony, \'f5 a Mi h\'edv\'f5 szolg\'e1ink k\'f6z\'fcl val\'f3.

\par 112. \'c9s \'f6r\'f6mh\'edrt adtunk neki Izs\'e1kr\'f3l, aki a j\'f3 emberek k\'f6z\'fcl val\'f3 pr\'f3f\'e9ta [lesz].
\par 113. \'c9s meg\'e1ldottuk \'f5t \'e9s Izs\'e1kot. De kettej\'fck lesz\'e1rmazottjai k\'f6z\'f6tt [van}{\insrsid13659446\charrsid8273728 ] j\'f3tev\'f5}{\insrsid13659446  \'e9s [van] \'f6nmaga ellen nyilv\'e1nval\'f3 igazs\'e1gtalans\'e1got elk\'f6vet\'f5.

\par }\pard\plain \s103\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 
\par 114. \'c9s bizony, kegyesnek mutatkoztunk M\'f3zes \'e9s \'c1ron ir\'e1nt,
\par 115. \'c9s megmentett\'fck \'f5ket \'e9s a n\'e9p\'fcket a hatalmas szorongattat\'e1sb\'f3l.
\par 116. \'c9s megseg\'edtett\'fck \'f5ket, \'edgy \'f5k lettek a gy\'f5zelmet arat\'f3k.
\par 117. \'c9s odaadtuk nekik a nyilv\'e1nval\'f3v\'e1 tev\'f5 \'cdr\'e1st.
\par 118. \'c9s kettej\'fcket az egyenes \'fatra vezett\'fck.
\par 119. \'c9s [dics\'e9retet] hagytunk r\'f3luk a k\'e9s\'f5bbi [nemzed\'e9kek] k\'f6z\'f6tt [\'edgy]:
\par 120. \'84B\'e9kess\'e9g M\'f3zesre \'e9s \'c1ronra!\'94
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid13659446 121. Bizony, Mi ekk\'e9ppen adjuk meg a }{
\insrsid13659446\charrsid8273728 fizets\'e9g\'e9t a j\'f3tev\'f5knek.}{\insrsid13659446 
\par }\pard\plain \s103\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 122. Bizony, \'f5k ketten a Mi h\'edv\'f5 szolg\'e1ink k\'f6z
\'fcl val\'f3k [voltak].
\par 
\par 123. \'c9s bizony, Ill\'e9s is a k\'fcld\'f6ttek k\'f6z\'fcl val\'f3 [volt].
\par 124. [Eml\'edtsd meg,] amikor azt mondta a n\'e9p\'e9nek: \'84Vajon nem f\'e9litek [Allahot]?
\par 125. Vajon Ba\'e1lhoz foh\'e1szkodtok, \'e9s ott hagyj\'e1tok a Legjobb Teremt\'f5t,
\par 126. Allahot, a ti Uratokat \'e9s hajdanvolt aty\'e1itok Ur\'e1t?\'94
\par 127. \'c1m \'f5k meghazudtolt\'e1k \'f5t, ez\'e9rt bizony el\'f5 lesznek hozatva [a b\'fcntet\'e9sre],
\par 128. Kiv\'e9ve Allah kiv\'e1lasztott szolg\'e1it.
\par 129. \'c9s [dics\'e9retet] hagytunk r\'f3la a k\'e9s\'f5bbi [nemzed\'e9kek] k\'f6z\'f6tt [\'edgy]:
\par 130. \'84B\'e9kess\'e9g Ill\'e9sre!\'94
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {\insrsid13659446 131. Bizony, Mi ekk\'e9ppen adjuk meg a }{
\insrsid13659446\charrsid2044833 fizets\'e9g\'e9t a j\'f3tev\'f5knek.}{\insrsid13659446 
\par }\pard\plain \s103\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 132. Bizony, \'f5 a Mi h\'edv\'f5 szolg\'e1ink k\'f6z\'fcl val
\'f3 [volt].
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 {\*\bkmkstart 133}{\*\bkmkend 133}
\par 133. \'c9s bizony, L\'f3t [is] a k\'fcld\'f6ttek k\'f6z\'fcl val\'f3 [volt].
\par 134. [Eml\'edtsd meg,] amikor megmentett\'fck \'f5t \'e9s a csal\'e1dj\'e1t, mindannyiukat,
\par 135. Kiv\'e9ve egy \'f6regasszonyt (a feles\'e9g\'e9t), \'f5 azok k\'f6z\'e9 tartozott, akik h\'e1tramaradtak.
\par 136. Azt\'e1n elpuszt\'edtottuk a t\'f6bbieket (Szodom\'e1t \'e9s Gomor\'e1t).
\par 137. \'c9s ti bizony elhaladtok mellett\'fck reggel,
\par 138. \'c9s \'e9jjel. Vajon h\'e1t nem \'e9ltek az eszetekkel?
\par }\pard\plain \s103\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 
\par 139. \'c9s bizony, J\'f3n\'e1s [is] a k\'fcld\'f6ttek k\'f6z\'fcl val\'f3 }{\insrsid13659446\charrsid2044833 [volt].}{\insrsid13659446 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 140. [Eml\'edtsd meg,] amikor a megrakott haj\'f3ra sz\'f6k\'f6tt!

\par 141. \'c9s sorsot h\'fazott \'e9s a vesztesek k\'f6z\'fcl val\'f3 volt.
\par 142. \'c9s a hal lenyelte \'f5t, mert \'f5 r\'e1szolg\'e1lt a szemreh\'e1ny\'e1sra.
\par 143. \'c9s ha nem lett volna az [Allahot] magasztal\'f3k k\'f6z\'fcl val\'f3,
\par 144. Akkor bizony a [hal] gyomr\'e1ban id\'f5z\'f6tt volna addig a napig, amikor felt\'e1masztatnak [az emberek]!
\par 145. \'c9s kivetett\'fck \'f5t egy kop\'e1r helyre, betegen,
\par 146. \'c9s egy t\'f6k-ind\'e1t n\'f6vesztett\'fcnk f\'f6l\'e9je.
\par 147. \'c9s elk\'fcldt\'fck \'f5t sz\'e1zezerhez [az emberek k\'f6z\'fcl], vagy m\'e9g t\'f6bbh\'f6z [pr\'f3f\'e9tak\'e9nt].
\par 148. [Azok] h\'edv\'f5k lettek, \'e9s \'e9lvezetekben r\'e9szes\'edtett\'fck \'f5ket egy ideig.
\par }\pard\plain \s103\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 
\par 149. K\'e9rj h\'e1t felvil\'e1gos\'edt\'e1st t\'f5l\'fck [\'f3 Mohamed]: \'84Vajon az Uradnak a le\'e1nyok j\'e1rnak, nekik pedig a fiak?\'94
\par 150. Vagy tal\'e1n az angyalokat n\'f5nem\'fbeknek teremtett\'fck, mik\'f6zben \'f5k tan\'fak voltak r\'e1?
\par 151. L\'e1m, bizony, \'f5k hazugs\'e1gukb\'f3l fakad\'f3an azt mondj\'e1k:
\par 152. \'84Allah [gyermeket] nemzett\'94, \'e9s bizony, \'f5k val\'f3ban hazugok!
\par 153. Vajon fi\'fak helyett le\'e1nyokat v\'e1lasztott volna [mag\'e1nak, ahogy \'e1ll\'edtj\'e1k]?
\par 154. Mi lelt titeket? Hogyan \'edt\'e9lkeztek?
\par 155. H\'e1t nem hallgattok az eml\'e9keztet\'e9sre?
\par 156. Vagy nyilv\'e1nval\'f3 bizony\'edt\'e9kotok van?
\par 157. Hozz\'e1tok h\'e1t el\'f5 az \'edr\'e1sotokat, }{\insrsid13659446\charrsid2044833 ha val\'f3ban}{\insrsid13659446  igazmond\'f3k vagytok!
\par 
\par 158. \'c9s \'d5k\'f6z\'f6tte \'e9s a dzsinnek k\'f6z\'f6tt rokons\'e1got tal\'e1ltak ki. A dzsinnek azonban tudj\'e1k, hogy el\'f5 lesznek hozatva [az \'cdt\'e9letre].
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 159. Magasztaltass\'e9k }{\insrsid13659446\charrsid1258422 Allah! [
\'d5 felette van annak, mint] ahogy le\'edrj\'e1k [\'d5t].}{\insrsid13659446 
\par }\pard\plain \s103\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 160. Kiv\'e9ve Allah kiv\'e1lasztott szolg\'e1it (mert \'f5
k nem tesznek ilyet).
\par 161. Ez\'e9rt, bizony ti, \'e9s amit szolg\'e1ltok,
\par 162. \'d5t (Allahot) illet\'f5en, ti nem vihettek senkit k\'eds\'e9rt\'e9sbe (t\'e9velyg\'e9sbe),
\par 163. Kiv\'e9ve azt, aki a Pokolban fog \'e9gni.
\par 164. [Az angyalok azt mondj\'e1k] \'84Nincs k\'f6z\'f6tt\'fcnk senki, akinek ne lenne ismert helye,
\par 165. \'c9s bizony mi vagyunk a felsorakoz\'f3k,
\par 166. \'c9s mi vagyunk az [Allahot] magasztal\'f3k.\'94
\par 
\par 167. \'c9s \'f5k (a hitetlenek) [kor\'e1bban mindig] azt mondt\'e1k:
\par 168. \'84Ha lenne eml\'e9keztet\'f5nk a hajdanvoltakt\'f3l,
\par 169. Bizony, Allah kiv\'e1lasztott szolg\'e1i lenn\'e9nk.\'94
\par 170. \'c1m \'f5k nem hittek benne (az Eml\'e9keztet\'e9sben, amikor elj\'f6tt hozz\'e1juk). De meg fogj\'e1k tudni!
\par 
\par 171. \'c9s bizony, m\'e1r elhangzott kor\'e1bban a Mi szavunk a k\'fcld\'f6tt szolg\'e1inknak,
\par 172. [Arr\'f3l, hogy] bizony \'f5k azok, akik megseg\'edttetnek,
\par 173. \'c9s [hogy] bizony, a Mi sereg\'fcnk lesz a gy\'f5zelmet arat\'f3.
\par 174. Fordulj h\'e1t el t\'f5l\'fck [\'f3 Mohamed] egy ideig,
\par 175. \'c9s figyeld \'f5ket! Hamarosan meg fogj\'e1k l\'e1tni (a b\'fcntet\'e9st).
\par 176. Vajon siettetik a Mi b\'fcntet\'e9s\'fcnket?
\par 177. \'c9s amikor ott terem majd n\'e1luk, akkor sz\'f6rny\'fb reggel virrad azokra, akik figyelmeztetve lettek.
\par 178. \'c9s fordulj el t\'f5l\'fck [\'f3 Mohamed] egy ideig,
\par 179. \'c9s figyelj! Hamarosan meg fogj\'e1k l\'e1tni (a b\'fcntet\'e9st).
\par }{\insrsid13659446\charrsid1258422 180. Magasztaltass\'e9k a te Urad, a M\'e9lt\'f3s\'e1g Ura! [\'d5 felette van annak, mint] ahogy le\'edrj\'e1k [\'d5t].}{\insrsid13659446 
\par 181. \'c9s b\'e9kess\'e9g a K\'fcld\'f6ttekre.
\par 182. \'c9s a h\'e1latelt dics\'e9ret Allahot illeti, a teremtm\'e9nyek Ur\'e1t!
\par 
\par 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446 \page }{
\f0\fs24\insrsid13659446\charrsid3423863 38. Szad (Szad) c. sz\'fara}{\insrsid13659446 
\par }\pard\plain \s103\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev
\'e9ben.
\par 
\par 1. Szad. A Kor\'e1nra, az eml\'e9keztet\'e9st tartalmaz\'f3ra!
\par 2. Nem! Akik hitetlenek, azok b\'fcszk\'e9lked\'f5k (fennh\'e9j\'e1z\'f3k) \'e9s ellenszeg\'fcl\'e9sben vannak [veled szemben].
\par 3. H\'e1ny nemzed\'e9ket puszt\'edtottunk el el\'f5tt\'fck! \'c9s [akkor] \'f5k felki\'e1ltottak, de nem volt id\'f5 a menek\'fcl\'e9sre.
\par 4. \'c9s csod\'e1lkoztak [a t\'f6bbistenhit\'fb arabok] azon, hogy egy k\'f6z\'fcl\'fck val\'f3 figyelmeztet\'f5 j\'f6tt el hozz\'e1juk. \'c9s a hitetlenek azt }{\insrsid13659446\charrsid1258422 mondt\'e1k: \'84Ez egy }{\insrsid13659446\charrsid1258422 
hazudoz\'f3}{\insrsid13659446\charrsid1258422  var\'e1zsl\'f3}{\insrsid13659446 .
\par 5. Vajon az isteneket egy istenn\'e9 tette? Bizony, ez csod\'e1lkoz\'e1sra okot ad\'f3 dolog!\'94
\par 6. \'c9s elindultak az el\'f5kel\'f5k k\'f6z\'fcl\'fck [azt mondv\'e1n,] hogy: \'84Menjetek [tov\'e1bb] \'e9s tartsatok ki az isteneitek mellett! Bizony, ez egy olyan dolog, amellyel [f\'f6l\'e9tek] akar [ker\'fclni]!
\par 7. Nem hallottunk err\'f5l az utols\'f3 vall\'e1sban sem. Nem m\'e1s ez, mint kital\'e1ci\'f3.
\par 8. Vajon az Eml\'e9keztet\'e9s (a Kor\'e1n) [csak egyed\'fcl] hozz\'e1 bocs\'e1ttatott volna le k\'f6z\'fcl\'fcnk?\'94 Nem! \'d5k k\'e9ts\'e9gben vannak az Eml\'e9keztet\'e9sem fel\'f5l. Nem! \'d5k m\'e9g nem \'edzlelt\'e9k meg a b\'fcntet\'e9semet!

\par 9. Vagy tal\'e1n n\'e1luk vannak a M\'e9lt\'f3s\'e1gteljes \'e9s Adom\'e1nyoz\'f3 Urad k\'f6ny\'f6r\'fclet\'e9nek a t\'e1rh\'e1zai?
\par 10. Vagy \'f6v\'e9k a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett, \'e9s [afelett,] ami a kett\'f5 k\'f6z\'f6tt van? [Ha \'edgy gondolj\'e1k] akkor emelkedjenek fel az [\'e9gi] utakon!
\par 11. \'d5k olyan sereg, amely le lesz gy\'f5zve, ahogyan a [k\'fcld\'f6tteik ellen] \'f6sszesz\'f6vetkez\'f5kkel [t\'f6rt\'e9nt kor\'e1bban].
\par 
\par 12. \'c9s m\'e1r meghazudtol\'e1st k\'f6vetett el el\'f5tt\'fck No\'e9 n\'e9pe, \'e9s \'c1d [t\'f6rzse] \'e9s a F\'e1ra\'f3, a szil\'e1rd kar\'f3k (seregek) birtokosa,
\par 13. \'c9s Tam\'fad \'e9s L\'f3t n\'e9pei \'e9s a cserj\'e9s [erd\'f5] lak\'f3i. \'d5k a [k\'fcld\'f6tteik ellen] \'f6sszesz\'f6vetkez\'f5k.
\par 14. Mindannyian meghazudtolt\'e1k a k\'fcld\'f6tteket, az\'e9rt jogoss\'e1 v\'e1lt a [r\'e1juk kiszabott] b\'fcntet\'e9sem.
\par 15. \'c9s ezek [a mekkai b\'e1lv\'e1nyim\'e1d\'f3k] nem v\'e1rnak m\'e1sra, mint egy ki\'e1lt\'e1sra, amely nem fog k\'e9slekedni.
\par 16 \'c9s azt mondt\'e1k: \'84Urunk! Siettesd a r\'e9sz\'fcnket [a b\'fcntet\'e9sb\'f5l] az Elsz\'e1mol\'e1s napja el\'f5tt!\'94
\par 
\par 17. Viseld t\'fcrelemmel [\'f3 Mohamed], amit mondanak, \'e9s eml\'edtsd meg a mi szolg\'e1nkat, D\'e1vidot, az er\'f5set! Bizony, \'f5 gyakran [b\'fbnb\'e1n\'f3an] visszat\'e9r\'f5 [volt]!
\par 18. Bizony, Mi az \'f5 szolg\'e1lat\'e1ra rendelt\'fck a hegyeket, [hogy vele egy\'fctt] magasztaljanak [Minket] este \'e9s napkelte ut\'e1n,
\par 19. \'c9s  a madarakat seregest\'f5l. Mindannyian gyakran visszat\'e9r\'f5k voltak Hozz\'e1 (Allahhoz).
\par 20. \'c9s meger\'f5s\'edtett\'fck az uralm\'e1t, \'e9s b\'f6lcsess\'e9get }{\insrsid13659446\charrsid13575996 \'e9s d\'f6nt\'f5 (l\'e9nyegre t\'f6r\'f5) besz\'e9det [\'e9s hat\'e1rozott, igazs\'e1gos \'edt\'e9lkez\'e9st] adtunk neki.}{\insrsid13659446 

\par 
\par 21. \'c9s vajon eljutott-e hozz\'e1d a civakod\'f3 [peresked\'f5k] h\'edre (t\'f6rt\'e9nete), amikor \'e1tm\'e1sztak az imahely fal\'e1n?
\par 22. Amikor bel\'e9ptek D\'e1vidhoz, }{\insrsid13659446\charrsid6228714 \'f5}{\insrsid13659446  megijedt t\'f5l\'fck. Azt mondt\'e1k: \'84Ne f\'e9lj! Mi k\'e9t civakod\'f3 [peresked\'f5] vagyunk, egyik\'fcnk igazs\'e1gtalans\'e1got k\'f6vetett el a m\'e1
sikkal szemben. \'cdt\'e9lj h\'e1t k\'f6z\'f6tt\'fcnk igazs\'e1ggal, \'e9s ne l\'e9gy r\'e9szrehajl\'f3! \'c9s vezess minket az igazs\'e1g \'fatj\'e1ra!
\par 23. Bizony, ez az \'e9n testv\'e9rem. Neki kilencvenkilenc anyajuha van, nekem pedig csak egy }{\insrsid13659446\charrsid7540560 anyajuhom}{\insrsid13659446  van. \'c9s azt mondta: 'B\'edzd r\'e1m azt!', \'e9s f\'f6l\'e9m kerekedett besz\'e9dben
{\*\bkmkstart 241}{\*\bkmkend 241}.\'94
\par {\*\bkmkstart 251}{\*\bkmkend 251}24. [D\'e1vid] azt mondta: \'84Bizony igazs\'e1gtalan volt veled, amikor elk\'e9rte az anyajuhodat }{\insrsid13659446\charrsid7540560 az \'f5 anyajuhai mell\'e9! \'c9s bizony, azok k\'f6z\'fcl, akik javaikban t\'e1
rsulnak egym\'e1ssal, sokan vannak, akik igazs\'e1gtalans\'e1got k\'f6vetnek el egym\'e1ssal szemben, kiv\'e9ve azokat, akik}{\insrsid13659446  hisznek \'e9s j\'f3tetteket cselekszenek, \'e9s mily kevesen vannak \'f5k!\'94 \'c9s D\'e1vid \'fagy v\'e9
lte, hogy Mi pr\'f3b\'e1ra tett\'fck \'f5t, ez\'e9rt megbocs\'e1t\'e1st k\'e9rt Ur\'e1t\'f3l, \'e9s meghajolva rogyott f\'f6ldre, \'e9s b\'fbnb\'e1nattal t\'e9rt vissza [Allahhoz].
\par {\*\bkmkstart 261}{\*\bkmkend 261}25. \'c9s mi megbocs\'e1tottuk neki ezt. \'c9s bizony, \'f5 k\'f6zel lesz [Hozz\'e1nk], \'e9s sz\'e9p [t\'falvil\'e1gi] helye lesz, ahova visszat\'e9r.
\par 26. \'d3 D\'e1vid! Mi bizony helytart\'f3v\'e1 tett\'fcnk t\'e9ged a f\'f6ld\'f6n. \'cdt\'e9lj h\'e1t igazs\'e1ggal az emberek k\'f6z\'f6tt! \'c9s ne k\'f6vesd a k\'e9nyt, nehogy t\'e9velyg\'e9sbe vigyen t\'e9ged Allah \'fatj\'e1t\'f3l! Bizony, akik elt
\'e9velyednek Allah \'fatj\'e1t\'f3l, azoknak s\'falyos b\'fcntet\'e9sben lesz r\'e9sz\'fck az\'e9rt, mert elfeledkeztek a Elsz\'e1mol\'e1s napj\'e1r\'f3l.
\par 
\par 27. \'c9s nem teremtett\'fck az eget \'e9s a f\'f6ldet \'e9s mindazt, ami k\'f6z\'f6tt\'fck van c\'e9ltalanul. Ezt [csup\'e1n] azok v\'e9lik \'edgy, akik hitetlenn\'e9 v\'e1ltak. \'c9s jaj lesz a hitetleneknek a [Pokol-]t\'fbzt\'f5l!
\par 28. Vajon \'fagy b\'e1njunk azokkal, akik hisznek \'e9s j\'f3tetteket cselekszenek, mint azokkal, akik roml\'e1st okoznak a f\'f6ld\'f6n? Vagy \'fagy b\'e1njunk-e az istenf\'e9l\'f5kkel, mint }{\insrsid13659446\charrsid7540560 a [f\'e9ktelen] gonoszokkal?
}{\insrsid13659446 
\par 29. \'c1ldott \'cdr\'e1s ez, amelyet lebocs\'e1tottunk hozz\'e1d [\'f3 Mohamed], hogy elgondolkodjanak a jelein (id\'e9zetein), \'e9s hogy az \'e9rtelemmel b\'edr\'f3k okuljanak [az int\'e9sb\'f5l].
\par 
\par 30. \'c9s D\'e1vidnak Salamont aj\'e1nd\'e9koztuk. Milyen kiv\'e1l\'f3 szolga [volt] \'f5! Bizony, \'f5 gyakran [b\'fbnb\'e1n\'f3an] visszat\'e9r\'f5 [volt].
\par 31. [}{\insrsid13659446\charrsid7540560 \'c9s eml\'edtsd meg,] amikor k\'e9s\'f5}{\insrsid13659446  d\'e9lut\'e1n felvonultatt\'e1k el\'f5tte a gyorsan v\'e1gt\'e1z\'f3 \'e9s kecsesen \'e1ll\'f3 lovakat!
\par 32. \'c9s azt mondta: \'84Bizony, el\'f5bbre helyeztem a }{\insrsid13659446\charrsid7540560 szeretetet a javak ir\'e1nt, az}{\insrsid13659446  Uramr\'f3l val\'f3 megeml\'e9kez\'e9sn\'e9l, [addig], am\'edg el nem t\'fbntek az [\'e9jszaka] f\'fcgg\'f6nye m
\'f6g\'f6tt.
\par 33. [Azt mondta Salamon:] \'84Hozz\'e1tok \'f5ket vissza hozz\'e1m! Majd simogatni kezdte a l\'e1bukat \'e9s a nyakukat.
\par 34. \'c9s bizony, pr\'f3b\'e1ra tett\'fck Salamont \'e9s egy testet (dzsinnt) vetett\'fcnk a tr\'f3nj\'e1ra, azt\'e1n b\'fbnb\'e1nattal t\'e9rt vissza [Hozz\'e1nk].
\par 35. Azt mondta: \'84Uram, bocs\'e1ss meg nekem \'e9s aj\'e1nd\'e9kozz meg engem }{\insrsid13659446\charrsid6228714 olyan kir\'e1lyi}{\insrsid13659446  uralommal, amely \'e9nut\'e1nam senkit meg nem illethet! Bizony, Te vagy a Megaj\'e1nd\'e9koz\'f3.

\par 36. \'c9s szolg\'e1lat\'e1ra rendelt\'fck a szelet, [amely] l\'e1gyan lengedezik az \'f5 parancsa szerint, ott ahol csak akarja,
\par 37. \'c9s a s\'e1t\'e1nokat [a dzsinnek k\'f6z\'fcl]: minden \'e9p\'edt\'f5t \'e9s lemer\'fcl\'f5t,
\par 38. \'c9s m\'e1sokat, bilincsekben [egym\'e1shoz] k\'f6t\'f6zve.
\par 39. [Allah \'edgy sz\'f3lt:] \'84Ez a mi adom\'e1nyunk. Adj h\'e1t bel\'f5le vagy tartsd vissza sz\'e1mad\'e1s n\'e9lk\'fcl!{\*\bkmkstart 401}{\*\bkmkend 401}\'94
\par 40. \'c9s bizony, \'f5 k\'f6zel lesz [Hozz\'e1nk], \'e9s sz\'e9p [t\'falvil\'e1gi] helye lesz, ahova visszat\'e9r.
\par 
\par 41. \'c9s eml\'e9kezz szolg\'e1nkra, J\'f3bra, amikor Ur\'e1hoz ki\'e1ltott: \'84A s\'e1t\'e1n bizony kimer\'fclts\'e9ggel \'e9s gy\'f6trelemmel s\'fajtott engem{\*\bkmkstart 421}{\*\bkmkend 421}!\'94
\par 42. \'84Dobbants a l\'e1baddal! [\'cdme,] ez hideg [gy\'f3gyv\'edz], f\'fcrd\'e9sre \'e9s iv\'e1sra val\'f3.\'94
\par 43. \'c9s megaj\'e1nd\'e9koztuk \'f5t a csal\'e1dj\'e1val \'e9s ugyanannyival vel\'fck egy\'fctt T\'f5l\'fcnk val\'f3 k\'f6ny\'f6r\'fcletk\'e9nt \'e9s eml\'e9keztet\'e9sk\'e9nt azoknak, akik \'e9rtelemmel b\'edrnak.
\par 44. [Az mondatott neki:] \'84Vegy\'e9l a kezedbe egy k\'f6teg vessz\'f5t, \'e9s \'fcss vele, \'e9s ne l\'e9gy esk\'fcszeg\'f5!\'94 Bizony, Mi t\'fcrelmesnek tal\'e1ltuk \'f5t. Milyen kiv\'e1l\'f3 szolga [volt] \'f5! Bizony, \'f5 gyakran [b\'fbnb\'e1n\'f3
an] visszat\'e9r\'f5 [volt].
\par 
\par 45. \'c9s eml\'edtsd meg szolg\'e1inkat, \'c1brah\'e1mot, Izs\'e1kot \'e9s J\'e1kobot, az er\'f5vel \'e9s \'e9lesl\'e1t\'e1ssal b\'edr\'f3kat!
\par 46. Bizony, Mi kiv\'e1lasztottuk \'f5ket [a szolg\'e1latunkra], k\'fcl\'f6nleges tulajdons\'e1got adv\'e1n nekik: a [t\'falvil\'e1gi] hajl\'e9kra val\'f3 eml\'e9keztet\'e9st.
\par 47. \'c9s Miel\'f5tt\'fcnk bizony \'f5k a kiv\'e1lasztottak \'e9s a legjobbak k\'f6z\'fcl val\'f3k.
\par 48. \'c9s eml\'edtsd meg Izm\'e1elt, Elizeust \'e9s \'c9zsai\'e1st! Mindannyian a legjobbak k\'f6z\'fcl val\'f3k.
\par 
\par 49. Ez eml\'e9keztet\'e9s. \'c9s bizony, az istenf\'e9l\'f5knek sz\'e9p [t\'falvil\'e1gi] helye lesz, oda t\'e9rnek vissza.
\par 50. \'c9den kertjei, amelyek kapui megny\'edlnak el\'f5tt\'fck,
\par 51. [Kerevetekre] d\'f5lve fekszenek ott \'e9s sok gy\'fcm\'f6lcs\'f6t \'e9s italt k\'e9rnek,
\par 52. \'c9s les\'fct\'f6tt szem\'fb, azonos kor\'fa [paradicsomi] n\'f5k lesznek vel\'fck.
\par 53. Ez az, amire \'edg\'e9retet kaptak a Sz\'e1mad\'e1s Napj\'e1ra.
\par 54. Bizony, ez a T\'f5l\'fcnk val\'f3 ell\'e1t\'e1s, amely soha el nem fogy.
\par 
\par 55. Ekk\'e9ppen van ez! Ellenben, akik t\'falkap\'e1sokra vetemednek, azok bizony rossz helyre fognak visszat\'e9rni:
\par 56. A Gyehenn\'e1ba; benne fognak \'e9gni. Milyen nyomorult fekhely!
\par 57. Ekk\'e9ppen van ez! \'cdzlelj\'e9k csak meg! Forr\'e1sban l\'e9v\'f5 v\'edz \'e9s genny,
\par 58. \'c9s m\'e1s, ehhez hasonl\'f3 t\'f6bbf\'e9le [b\'fcntet\'e9s]!
\par 59. \'cdme ez egy veletek egy\'fctt bez\'fadul\'f3 csoport. [Azt mondj\'e1k:] \'84Nincs sz\'edves fogadtat\'e1s r\'e9sz\'fckre. Bizony, \'f5k is a [Pokol-]t\'fbzben fognak \'e9gni.
\par 60. [Azok] azt mondj\'e1k: \'84Nem! Ti vagytok azok, akik r\'e9sz\'e9re nincs sz\'edves fogadtat\'e1s! Ti hozt\'e1tok ezt r\'e1nk! \'c9s milyen nyomor\'fas\'e1gos tart\'f3zkod\'e1si hely.\'94
\par 61. Azt mondt\'e1k: \'84Urunk! Aki r\'e1nk hozta ezt annak n\'f6veld k\'e9tszeresre a gy\'f6trelm\'e9t a [Pokol-]t\'fbzben!\'94
\par 62. \'c9s azt mondt\'e1k: \'84Mi\'e9rt nem l\'e1tunk [itt] olyan f\'e9rfiakat, akiket a rosszak k\'f6z\'f6tt tartottunk sz\'e1mon?
\par 63. Vajon [hib\'e1ztunk amikor] g\'fany t\'e1rgy\'e1v\'e1 tett\'fck \'f5ket? Vagy tal\'e1n elker\'fclte \'f5ket a tekintet\'fcnk?\'94
\par 64. Ez bizony az igazs\'e1g: a [Pokol-]t\'fbz lak\'f3inak civakod\'e1sa!
\par 
\par 65. Mondd [\'f3 Mohamed]: \'84\'c9n csak figyelmeztet\'f5 vagyok, \'e9s nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, csak Allah, az Egy, a Legy\'f5zhetetlen,
\par 66. Az egek \'e9s a f\'f6ld Ura, \'e9s mindaz\'e9, ami e kett\'f5 k\'f6z\'f6tt van, a M\'e9lt\'f3s\'e1gteljes, a Megbocs\'e1t\'f3!\'94
\par 67. Mondd: \'84Ez egy hatalmas h\'edr!
\par 68. Amit\'f5l ti elfordultok.
\par 69. Nem volt nekem tud\'e1som a legfels\'f5bb el\'f5kel\'f5 [angyalok gy\'fbl\'e9se] fel\'f5l, amikor civakodtak [\'c1d\'e1m teremt\'e9s\'e9r\'f5l].
\par 70. Nem m\'e1s\'e9rt kaptam sugallatot [kinyilatkoztat\'e1sk\'e9nt], csup\'e1n az\'e9rt, mert nyilv\'e1nval\'f3 figyelmeztet\'f5 vagyok.\'94
\par {\*\bkmkstart 721}{\*\bkmkend 721}71. [Eml\'edtsd meg,] amikor a te Urad azt mondta az angyaloknak: \'84Bizony, embert teremtek agyagb\'f3l.
\par 72. \'c9s ha megform\'e1ltam, \'e9s belef\'fajtam [az \'e1ltalam teremtett] l\'e9lekb\'f5l, akkor vess\'e9tek le magatokat el\'f5tte leborulva!\'94
\par 73. \'c9s az angyalok f\'f6ldre borultak,{\*\bkmkstart 741}{\*\bkmkend 741} mindannyian,
\par 74. Ibl\'edsz kiv\'e9tel\'e9vel, [\'f5] fennh\'e9j\'e1zott, \'e9s a hitetlenek k\'f6z\'fcl val\'f3 volt.
\par 75. [Allah] azt mondta \'84\'d3 Ibl\'edsz! Mi tartott vissza att\'f3l, hogy leborulj az el\'f5tt, amit \'c9n a k\'e9t kezemmel teremtettem? Vajon fennh\'e9j\'e1zt\'e1l [most], vagy [mindig is] a g\'f5g\'f6sek k\'f6z\'fcl val\'f3 volt\'e1l?\'94
\par 76. Azt mondta [Ibl\'edsz]: \'84\'c9n jobb vagyok n\'e1la (\'c1d\'e1mn\'e1l)! Engem t\'fbzb\'f5l teremtett\'e9l, \'f5t pedig agyagb\'f3l teremtetted.\'94
\par 77. [Allah] azt mondta: \'84Menj h\'e1t ki innen (a Paradicsomb\'f3l)! \'c9s bizony, kitasz\'edtott vagy!
\par 78. \'c9s bizony, rajtad lesz az \'e1tkom, eg\'e9szen az \'cdt\'e9let napj\'e1ig!\'94
\par 79. Azt mondta [Ibl\'edsz]: \'84Uram! Adj nekem halad\'e9kot, addig a napig, amikor felt\'e1masztatnak [a halottak]!\'94
\par 80. Azt mondta [Allah]: \'84Bizony, azok k\'f6z\'e9 tartozol, akik halad\'e9kot kapnak,
\par 81. A megszabott id\'f5 napj\'e1ig.\'94
\par 82. Azt mondta [Ibl\'edsz]: \'84\'c9s a m\'e9lt\'f3s\'e1godra [esk\'fcsz\'f6m], hogy bizony, t\'e9v\'fatra vezetem \'f5ket,{\*\bkmkstart 831}{\*\bkmkend 831} mindannyiukat,
\par 83. Kiv\'e9ve a kiv\'e1lasztott szolg\'e1idat k\'f6z\'fcl\'fck!{\*\bkmkstart 841}{\*\bkmkend 841}\'94
\par 84. [Allah] azt mondta: \'84Ez h\'e1t az Igazs\'e1g, \'e9s [\'c9n] az Igazs\'e1got mondom:
\par 85. Bizony meg fogom t\'f6lteni a Gyehenn\'e1t veled \'e9s azokkal, akik k\'f6vetnek t\'e9ged, mindny\'e1jotokkal.\'94
\par 86. Mondd [\'f3 Mohamed]: \'84Nem k\'e9rek t\'f5letek jutalmat, \'e9s \'e9n nem tartozom azok k\'f6z\'e9, akik sz\'ednlelnek (val\'f3tlant \'e1ll\'edtanak).
\par 87. Ez nem m\'e1s, mint eml\'e9keztet\'e9s a teremtm\'e9nyeknek.
\par 88. \'c9s bizony meg fogj\'e1tok tudni annak h\'edr\'e9t (igazs\'e1g\'e1t) egy id\'f5 ut\'e1n!\'94
\par 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446 \page }{
\f0\fs24\insrsid13659446\charrsid3423863 39. A csoportok (az-Zumar) c. sz\'fara}{\insrsid13659446 
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. Az \'cdr\'e1s (a Kor\'e1n) lebocs\'e1t\'e1sa a M\'e9lt\'f3s\'e1gteljes \'e9s a B\'f6lcs Allaht\'f3l [van].
\par 2. Bizony, Mi }{\insrsid13659446\charrsid9509240 az igazs\'e1ggal bocs\'e1tottuk le neked [\'f3 Mohamed] az \'cdr\'e1st, szolg\'e1ld h\'e1t Allahot, \'f5szint\'e9n Neki szentelve a vall\'e1s{\*\bkmkstart 310}{\*\bkmkend 310} [gyakorl\'e1s\'e1t]!
\par 3. L\'e1m, bizony a tiszta vall\'e1s[-gyakorl\'e1s] Allahot illeti! \'c9s akik \'d5helyette m\'e1s p\'e1rtfog\'f3kat tesznek meg maguknak [azt mondv\'e1n]: \'84Csup\'e1n az\'e9rt szolg\'e1ljuk \'f5ket, hogy k\'f6zeli kapcsolatba hozzanak minket Allahhal
\'94, azok k\'f6z\'f6tt bizony Allah \'edt\'e9lkezni fog abban, amiben \'f6sszek\'fcl\'f6nb\'f6ztek. Bizony, Allah nem vezeti az igaz \'fatra azt, aki hazug, megr\'f6gz\'f6tt hitetlen.
\par 4. Ha Allah azt akarta volna, hogy [valakit] gyermek\'e9v\'e9 tegyen, akkor kiv\'e1lasztotta volna azt, amit \'d5 akar, abb\'f3l, amit teremtett. Magasztaltass\'e9k}{\insrsid13659446 ! \'d5 Allah, az Egy, a Legy\'f5zhetetlen.
\par 5. Megteremtette az egeket \'e9s a f\'f6ldet az igazs\'e1ggal (c\'e9llal). R\'e1g\'f6ngy\'f6l\'edti az \'e9jszak\'e1t a nappalra \'e9s a nappalt az \'e9jszak\'e1ra, \'e9s szolg\'e1latra rendelte a Napot \'e9s a Holdat, mindegyik\'fck megszabott id\'f5re 
futja be a p\'e1ly\'e1j\'e1t. Bizony, \'d5 a M\'e9lt\'f3s\'e1gteljes, a Megbocs\'e1t\'f3.
\par 
\par 6. Egyetlen emberb\'f5l teremtett titeket, majd megalkotta bel\'f5le a p\'e1rj\'e1t. \'c9s lebocs\'e1tott nektek a j\'f3sz\'e1gokb\'f3l nyolcat p\'e1ros\'e1val. Egym\'e1s ut\'e1ni teremt\'e9sben teremt meg titeket }{\insrsid13659446\charrsid10886056 any
\'e1tok m\'e9h\'e9ben, h\'e1romszoros s\'f6t\'e9ts\'e9gben. \'cdme, \'d5 Allah, a ti Uratok, \'d6v\'e9 a kir\'e1lyi uralom, nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, csak \'d5. Hogyan ford\'edthatnak h\'e1t el titeket [Allah szolg\'e1lat\'e1t\'f3l]?

\par 7. Ha hitetlenek vagytok, nos Allah Gazdag \'e9s nem szorul r\'e1tok, \'e9s \'d5 nem}{\insrsid13659446  fogadja megel\'e9ged\'e9ssel szolg\'e1inak hitetlens\'e9g\'e9t. \'c1m ha h\'e1l\'e1sak vagytok, azt megel\'e9ged\'e9ssel fogadja t\'f5letek. \'c9
s egyetlen terhet cipel\'f5 sem cipeli egy m\'e1siknak a terh\'e9t. Majd Uratokhoz lesz a visszat\'e9r\'e9setek, \'e9s \'d5 h\'edr\'fcl adja nektek azt, amit cselekedtetek. Bizony, Neki tudom\'e1sa van arr\'f3l, amit a keblek rejtenek.
\par 8. \'c9s ha valami baj \'e9ri az embert, akkor Ur\'e1hoz foh\'e1szkodik, [b\'fbnb\'e1nattal] visszat\'e9rve \'d5hozz\'e1; azt\'e1n amikor ism\'e9telten j\'f3t\'e9tem\'e9nyben r\'e9szes\'edti \'f5t, elfelejti azt, ami miatt kor\'e1bban foh\'e1szkodott Hozz
\'e1, \'e9s Allahnak vet\'e9lyt\'e1rsakat \'e1ll\'edt, hogy t\'e9velyg\'e9sbe vigyen [m\'e1sokat] Allah \'fatj\'e1r\'f3l. Mondd: \'84\'c9lvezd csak egy kev\'e9ss\'e9 a hitetlens\'e9gedet! Bizony, te a [Pokol-]t\'fbz lak\'f3i k\'f6z\'fcl val\'f3 vagy.\'94

\par 
\par 9. Vajon az, aki al\'e1zatosan engedelmeskedik Allahnak, \'fagy hogy leborulva \'e9s fel\'e1llva [t\'f6lti] az \'e9jszaka \'f3r\'e1it, \'f3vakodik a t\'falvil\'e1gt\'f3l, \'e9s Ura k\'f6ny\'f6r\'fclet\'e9ben rem\'e9
nykedik [olyan lenne, mint az, aki hitetlen]? Mondd: \'84Vajon egyenl\'f5k-e azok, akik tudnak, azokkal, akik nem tudnak?\'94 Csup\'e1n az \'e9rtelemmel b\'edr\'f3k okulnak [az int\'e9sb\'f5l].
\par 10. Mondd [\'f3 Mohamed a szolg\'e1imnak:] \'84\'d3 szolg\'e1im, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! F\'e9lj\'e9tek Allahot! Akik az evil\'e1gi \'e9letben }{
\insrsid13659446\charrsid10886056 j\'f3tev\'f5en cselekszenek}{\insrsid13659446 , azoknak j\'f3 j\'e1r. \'c9s Allah f\'f6ldje t\'e1gas [v\'e1ndoroljatok h\'e1t oda, }{\insrsid13659446\charrsid10886056 ahol szabadon szolg\'e1lhatj\'e1tok \'d5t]! A t\'fc
relmesek a fizets\'e9g\'fcket teljes eg\'e9sz\'e9ben meg fogj\'e1k kapni, sz\'e1mad\'e1s n\'e9lk\'fcl.\'94}{\insrsid13659446 
\par 11. Mondd [\'f3 Mohamed]: \'84Bizony, \'e9n arra kaptam parancsot, hogy szolg\'e1ljam Allahot \'f5szint\'e9n Neki szentelve a vall\'e1s{\*\bkmkstart 3101}{\*\bkmkend 3101} [gyakorl\'e1s\'e1t],
\par {\*\bkmkstart 1210}{\*\bkmkend 1210}12. \'c9s parancsot kaptam arra, hogy \'e9n legyek az els\'f5, aki al\'e1veti mag\'e1t [Allahnak]{\*\bkmkstart 1310}{\*\bkmkend 1310}.\'94
\par 13. Mondd [\'f3 Mohamed]: \'84Bizony, \'e9n f\'e9lek \endash  ha ellenszeg\'fcln\'e9k Uramnak \endash  egy hatalmas Nap gy\'f6trelm\'e9t\'f5l.\'94
\par 14. Mondd: \'84Allahot szolg\'e1lom, \'f5szint\'e9n Neki szentelve a vall\'e1som [gyakorl\'e1s\'e1t].
\par 15. Szolg\'e1ljatok h\'e1t Rajta k\'edv\'fcl azt, amit akartok!\'94 Mondd: }{\insrsid13659446\charrsid12720631 \'84Azok a vesztesek, akik elvesz\'edtik (k\'e1rhozatba tasz\'edtj\'e1k) magukat \'e9s a csal\'e1djukat a Felt\'e1mad\'e1s Napj\'e1n.}{
\insrsid13659446  L\'e1m, ez a nyilv\'e1nval\'f3 vesztes\'e9g!\'94
\par 16. T\'fbzb\'f5l val\'f3 r\'e9tegek }{\insrsid13659446\charrsid10182251 lesznek felett\'fck, \'e9s alattuk is. Ezzel kelt f\'e9lelmet Allah az \'d5 szolg\'e1iban. \'d3 szolg\'e1im! F\'e9ljetek h\'e1t Engem!
\par 17. Akik azonban elker\'fclik a hamisan isten\'edtettek szolg\'e1lat\'e1t, \'e9s b\'fbnb\'e1nattal}{\insrsid13659446  t\'e9rnek vissza Allahhoz, azokat illeti az \'f6r\'f6mh\'edr. Adj h\'e1t \'f6r\'f6mh\'edrt a szolg\'e1imnak,
\par 18. Akik hallgatnak a sz\'f3ra \'e9s azt k\'f6vetik abb\'f3l, ami a legjobb [Allah szava]! \'d5k azok, akiket Allah az igaz \'fatra vezetett, \'e9s }{\insrsid13659446\charrsid12720631 \'f5k bizony az}{\insrsid13659446  \'e9rtelemmel b\'edr\'f3k.
\par 19. Vajon [az igaz \'fatra tudod vezetni] azt, akivel szemben jogoss\'e1 v\'e1lt a gy\'f6trelemr\'f5l [sz\'f3l\'f3] sz\'f3 [amiatt, hogy makacsul kitartott a hitetlens\'e9ge mellett]? Te tal\'e1n meg tudod menteni azt, aki a [Pokol-]t\'fbzben van?
\par 20. Akik azonban f\'e9lt\'e9k Urukat, azoknak egym\'e1s f\'f6l\'e9 \'e9p\'fclt szob\'e1ik lesznek [a Paradicsomban], amelyek al\'f3l foly\'f3k folynak. [Ez] Allah \'edg\'e9rete. Nem szegi meg Allah az \'edg\'e9ret\'e9t.
\par 
\par 21. Vajon nem gondolkodt\'e1l el azon, hogy Allah vizet bocs\'e1tott le az \'e9gb\'f5l, \'e9s v\'edzerekk\'e9nt vezette bele a f\'f6ldbe, azt\'e1n k\'fcl\'f6nb\'f6z\'f5 fajt\'e1j\'fa gabon\'e1t sarjaszt \'e1ltala, majd elsz\'e1rad \'e9s l\'e1
tod, amint els\'e1rgul, azt\'e1n sz\'e1raz k\'f3r\'f3v\'e1 teszi? Bizony ebben eml\'e9keztet\'e9s van az \'e9rtelemmel b\'edr\'f3knak.
\par 22. Vajon az, akinek Allah kit\'e1rta a kebl\'e9t az iszl\'e1mra, \'e9s \'edgy Ur\'e1t\'f3l val\'f3 vil\'e1goss\'e1gban van [olyan, mint aki kem\'e9nysz\'edv\'fb]? Jaj h\'e1t azoknak, akiknek }{\insrsid13659446\charrsid983814 a sz\'edve megkem\'e9
nyedett az Allahr\'f3l val\'f3 megeml\'e9kez\'e9ssel szemben! \'d5k nyilv\'e1nval\'f3 t\'e9velyg\'e9sben vannak.
\par 23. Allah bocs\'e1totta le a legszebb elbesz\'e9l\'e9st (a Kor\'e1nt), olyan \'cdr\'e1sk\'e9nt [amelynek r\'e9szei egym\'e1shoz] hasonl\'f3ak, ism\'e9tl\'f5d\'f5k, amelyt\'f5l borzong azoknak a b\'f5re, akik f\'e9lnek Urukt\'f3l, majd a b\'f5r\'fck \'e9
s a sz\'edv\'fck megl\'e1gyul az Allahr\'f3l val\'f3 megeml\'e9kez\'e9st\'f5l. Ez Allah \'fatmutat\'e1sa, azt vezeti \'e1ltala, akit akar. \'c9s akit Allah t\'e9velyg\'e9sbe visz, annak nincs vezet\'f5je}{\insrsid13659446  [az igaz \'fatra].
\par 24. }{\insrsid13659446\charrsid5786819 Vajon az, aki a Felt\'e1mad\'e1s napj\'e1n arc\'e1val [k\'e9nyszer\'fcl] \'f3vni mag\'e1t a sz\'f6rny\'fb gy\'f6trelemt\'f5l [olyan, mint aki b\'e9k\'e9ben l\'e9p be a Paradicsomba]? \'c9s az igazs\'e1
gtalanoknak az lesz mondva: \'84\'cdzlelj\'e9tek meg azt, amire szert tettetek!\'94
\par 25. Meghazudtol\'e1st k\'f6vettek el [m\'e1r] azok [is], akik el\'f5tt\'fck \'e9ltek, \'e9s onnan j\'f6tt el a gy\'f6trelem hozz\'e1juk, ahonnan \'e9szre sem vett\'e9k [az elj\'f6vetel\'e9t].
\par 26. Azut\'e1n Allah meg\'edzleltette vel\'fck a sz\'e9gyent az evil\'e1gi \'e9letben, de bizony a t\'falvil\'e1g gy\'f6trelme [m\'e9g] nagyobb. B\'e1rcsak tudt\'e1k volna!
\par 
\par 27. \'c9s ebben a Kor\'e1nban mindenf\'e9le p\'e9ld\'e1zatot adtunk az embereknek, h\'e1tha okulnak [az int\'e9sb\'f5l].
\par 28. Arab Kor\'e1nk\'e9nt [bocs\'e1tottuk le], amiben nincsen ferdes\'e9g, h\'e1tha istenf\'e9l\'f5k lesznek.
\par 29. Allah p\'e9ld\'e1zatot ad: \'84Egy [rabszolga] f\'e9rfit vit\'e1ban \'e1ll\'f3 r\'e9szest\'e1rsak birtokolnak, egy m\'e1sik [rabszolga f\'e9rfi] pedig egyetlen ember\'e9. Vajon egyenl\'f5k-e a p\'e9ld\'e1zat tekintet\'e9ben? A h\'e1latelt dics\'e9
ret Allahot illeti! De nem! A legt\'f6bben k\'f6z\'fcl\'fck nem rendelkeznek tud\'e1ssal.
\par 30. Bizony, te [\'f3 Mohamed] meg fogsz halni, \'e9s bizony \'f5k is meg fognak halni.
\par 31. Azut\'e1n ti bizony a Felt\'e1mad\'e1s napj\'e1n az Uratok el\'f5tt fogtok civakodni [egym\'e1ssal{\*\bkmkstart 322}{\*\bkmkend 322}].
\par 
\par 32. \'c9s ki igazs\'e1gtalanabb ann\'e1l, [mint] aki hazugs\'e1got eszel ki Allahr\'f3l \'e9s meghazudtolja az igazs\'e1got (a Kor\'e1nt), amikor az elj\'f6tt hozz\'e1? Vajon nem a Gyehenn\'e1ban van-e otthona a hitetleneknek?
\par {\*\bkmkstart 342}{\*\bkmkend 342}33. \'c9s az, aki elj\'f6tt az igazs\'e1ggal (Mohamed Pr\'f3f\'e9ta) \'e9s azok, akik igaznak tartott\'e1k, \'f5k bizony az istenf\'e9l\'f5k.
\par 34. Az j\'e1r nekik Urukn\'e1l, amit csak akarnak. Ez a j\'f3tev\'f5k fizets\'e9ge.
\par 35. Az\'e9rt, hogy Allah elengedje nekik a legrosszabb cselekedeteiket, \'e9s megadja nekik fizets\'e9g\'fcket a legjobb cselekedeteik\'e9rt.
\par 36. Vajon nem el\'e9gs\'e9ges-e Allah az \'d5 szolg\'e1j\'e1nak? \'c9s \'f5k f\'e9lelmet [akarnak] kelteni benned azokkal, akiket Rajta k\'edv\'fcl [im\'e1dnak]. \'c1m akit Allah t\'e9velyg\'e9sbe visz, annak nincs vezet\'f5je [az igaz \'fatra].
\par 37. \'c9s akit Allah az igaz \'fatra vezet, azt nem viheti senki sem t\'e9velyg\'e9sbe. Vajon nem Allah-e [az, aki] M\'e9lt\'f3s\'e1gteljes, az el\'e9gt\'e9tel Birtokosa?
\par 
\par 38. \'c9s ha megk\'e9rdezed \'f5ket, hogy ki teremtette az egeket \'e9s a f\'f6ldet, bizonyosan azt fogj\'e1k mondani: \'84Allah\'94. Mondd: \'84Vajon mit gondoltok azokr\'f3l, akikhez Allah helyett foh\'e1szkodtok? Ha Allah csap\'e1ssal akarna engem s
\'fajtani, vajon elh\'e1r\'edthatj\'e1k-e \'f5k a csap\'e1s\'e1t? Vagy ha k\'f6ny\'f6r\'fcletet akarna ir\'e1ntam tan\'fas\'edtani, vajon visszatarthatj\'e1k-e \'f5k a k\'f6ny\'f6r\'fclet\'e9t?\'94 Mondd: \'84Elegend\'f5 nekem Allah. \'d5r\'e1
 hagyatkoznak a hagyatkoz\'f3k.\'94
\par 39. Mondd [\'f3 Mohamed]: \'84\'d3 n\'e9pem! Cselekedjetek helyzetetek (m\'f3dszeretek) szerint. Bizony, \'e9n is cselekedni fogok [a m\'f3dszerem szerint]. Meg fogj\'e1tok h\'e1t tudni,
\par 40. [Hogy] kit s\'fajt egy [olyan] gy\'f6trelem, amely megsz\'e9gyen\'edti, \'e9s kire telepszik \'f6r\'f6kk\'e9 tart\'f3 gy\'f6trelem!\'94
\par 
\par 41. Bizony, Mi lebocs\'e1tottuk hozz\'e1d az \'cdr\'e1st (a Kor\'e1nt) az emberek sz\'e1m\'e1ra az igazs\'e1ggal. \'c9s aki r\'e1lel az igaz \'fatra, \'f6nmaga haszn\'e1ra teszi, aki pedig t\'e9velyeg, \'f6nmaga k\'e1r\'e1ra t\'e9velyeg. \'c9
s te nem vagy a v\'e9delmez\'f5j\'fck}{\insrsid13659446 .}{\cf1\insrsid13659446 
\par 
\par 42. Allah sz\'f3l\'edtja mag\'e1hoz a lelkeket, amikor meghalnak, \'e9s azokat is, akik nem halnak meg az \'e1lmukban, majd visszatartja azt, akinek elrendelte a hal\'e1l\'e1t \'e9s visszabocs\'e1tja a t\'f6bbit egy meghat\'e1
rozott ideig. Bizony, ebben jelek vannak egy [olyan] n\'e9p sz\'e1m\'e1ra, akik elgondolkodnak.}{\insrsid13659446 
\par 43. Vagy tal\'e1n k\'f6zbenj\'e1r\'f3kat tettek meg maguknak [azok k\'f6z\'fcl, akiket szolg\'e1lnak] Allah helyett? Mondd: \'84Vajon m\'e9g [akkor is \'edgy tenn\'e9tek], ha [a v\'e9lt k\'f6zbenj\'e1r\'f3knak] nem \'e1ll m\'f3
djukban rendelkezni semmi felett \'e9s nem fognak fel \'e9sszel [semmit abb\'f3l, amivel fordultok hozz\'e1juk]?\'94
\par 44. Mondd: \'84Allahot illeti meg minden k\'f6zbenj\'e1r\'e1s [enged\'e9lyez\'e9se]. \'d6v\'e9 az egek \'e9s a f\'f6ld kir\'e1lyi uralma; azut\'e1n hozz\'e1 lesztek visszavitetve.\'94
\par 
\par 45. \'c9s ha Allah egyed\'fcl eml\'edttetik, undorral telik el azoknak a sz\'edve, akik nem hisznek a t\'falvil\'e1gban. \'c1m amikor azok eml\'edttetnek, akiket Rajta k\'edv\'fcl [im\'e1dnak], akkor \'edme, \'f5k \'f6rvendeznek.
\par 46. Mondd [\'f3 Mohamed]: \'84\'d3 Allah, az egek \'e9s a f\'f6ld L\'e9trehoz\'f3ja, a rejtett \'e9s a nyilv\'e1nval\'f3 dolgok Tud\'f3ja! Te fogsz \'edt\'e9lkezni a szolg\'e1id k\'f6z\'f6tt }{\insrsid13659446\charrsid5787874 abban, amiben \'f6sszek\'fcl
\'f6nb\'f6ztek.\'94
\par 47. \'c9s ha azoknak, akik igazs\'e1gtalans\'e1got k\'f6vettek el, minden a birtokukban lenne, ami a f\'f6ld\'f6n van \'e9s azzal egy\'fctt m\'e9g egyszer annyi, akkor bizony meg szeretn\'e9k v\'e1ltani magukat azzal a sz\'f6rny\'fb gy\'f6trelemt\'f5
l a Felt\'e1mad\'e1s Napj\'e1n; \'e1m meg fog mutatkozni nekik Allaht\'f3l az, amivel nem is sz\'e1moltak.
\par 48. \'c9s meg fog mutatkozni nekik a rossz tetteik [k\'f6vetkezm\'e9nye], amit szereztek, \'e9s k\'f6rbeker\'edti \'f5ket az [a b\'fcntet\'e9s], amib\'f5l g\'fanyt \'fbztek.}{\insrsid13659446 
\par 
\par 49. \'c1m ha valami baj \'e9ri az embert, akkor Mihozz\'e1nk foh\'e1szkodik, azt\'e1n amikor [ism\'e9telten] j\'f3t\'e9tem\'e9nyben r\'e9szes\'edtj\'fck \'f5t, azt mondja: \'84Ez csup\'e1n a [birtokomban l\'e9v\'f5] tud\'e1s r\'e9v\'e9n adatott nekem.\'94
 De nem! Ez egy k\'eds\'e9rt\'e9s (pr\'f3bat\'e9tel), \'e1m a legt\'f6bbj\'fck nem rendelkezik tud\'e1ssal.
\par 50. Ezt }{\insrsid13659446\charrsid1120705 mondt\'e1k m\'e1r azok [is], akik el\'f5tt\'fck \'e9ltek, \'e9s nem haszn\'e1lt nekik a [b\'fcntet\'e9s\'fck bek\'f6vetkeztekor] az, amit szereztek [az evil\'e1gi javakb\'f3l].
\par 51. \'cdgy les\'fajtott r\'e1juk [a s\'falyos k\'f6vetkezm\'e9nye] azoknak a rossz tetteknek, amiket szereztek  \'c9s akik ezek (a mekkaiak) k\'f6z\'fcl igazs\'e1gtalans\'e1got k\'f6vettek el, azokra is le fog s\'fajtani [a s\'falyos k\'f6vetkezm\'e9
nye] azoknak a rossz tetteknek, amelyekre szert tettek. \'c9s \'f5k nem fogj\'e1k [Allahot] megakad\'e1lyozni [semmiben].
\par 52. Vajon nem tudj\'e1k, hogy Allah annak terjeszti ki az ell\'e1t\'e1st, akinek akarja, \'e9s sz\'fbk\'f6ss\'e9 teszi [m\'e1soknak]? Bizony, jelek vannak ebben egy olyan n\'e9p sz\'e1m\'e1ra, akik hisznek.
\par 
\par 53. Mondd [\'f3 Mohamed, hogy Allah \'edgy sz\'f3lt]: \'84\'d3 szolg\'e1im, akik m\'e9rt\'e9ktelenek voltatok magatokkal szemben [a b\'fbn\'f6k elk\'f6vet\'e9s\'e9t illet\'f5en], ne vesz\'edts\'e9tek el a rem\'e9nyt Allah k\'f6ny\'f6r\'fclet\'e9
ben! Bizony, Allah minden b\'fbnt megbocs\'e1t. Bizony, \'d5 a Megbocs\'e1t\'f3, a K\'f6ny\'f6r\'fcletes.
\par 54. \'c9s t\'e9rjetek vissza b\'fbnb\'e1n\'f3an Uratokhoz \'e9s vess\'e9tek al\'e1 magatokat neki, miel\'f5tt elj\'f6n hozz\'e1tok a b\'fcntet\'e9s, mert akkor nem lesztek megseg\'edtve!
\par 55. \'c9s k\'f6vess\'e9tek a legjobbat abb\'f3l, ami lebocs\'e1ttatott nektek az Uratokt\'f3l, miel\'f5tt elj\'f6n hozz\'e1tok a b\'fcntet\'e9s v\'e1ratlanul \'fagy, hogy \'e9szre sem veszitek [annak elj\'f6vetel\'e9t],
\par 56. Nehogy [akkor] azt mondja egy ember [is]: \'84Jaj, mily nagy a b\'e1natom az\'e9rt, amit elmulasztottam Allahhal szemben, \'e9s bizony a g\'fanyol\'f3d\'f3k k\'f6z\'e9 tartoztam!\'94
\par 57. Vagy nehogy azt mondja: \'84Ha Allah igaz \'faton vezetett volna, akkor az istenf\'e9l\'f5k k\'f6z\'e9 tartoztam volna.\'94
\par 58. Vagy nehogy azt mondja, amikor megl\'e1tja a b\'fcntet\'e9st: \'84Ha lehetne visszat\'e9r\'e9s sz\'e1momra, akkor a j\'f3tev\'f5k k\'f6z\'e9 tartozn\'e9k!\'94
\par 59. De igenis elj\'f6ttek hozz\'e1d a jeleim, \'e1m meghazudtoltad azokat \'e9s fennh\'e9j\'e1zt\'e1l \'e9s a hitetlenek k\'f6z\'e9 tartozt\'e1l!
\par 
\par 60. \'c9s a Felt\'e1mad\'e1s Napj\'e1n l\'e1tni fogod, hogy akik hazugs\'e1got eszeltek ki Allahr\'f3l, azok arca els\'f6t\'e9t\'fcl. Vajon nem a Gyehenn\'e1ban van a fennh\'e9j\'e1z\'f3knak otthona?
\par 61. \'c9s Allah megmenti [a Pokol-t\'fbzt\'f5l] azokat, akik istenf\'e9l\'f5k voltak, ami\'e9rt elnyert\'e9k [Allah el\'e9gedetts\'e9g\'e9t]. Nem fogja \'f5ket rossz \'e9rni, \'e9s nem fognak szomorkodni [sem].
\par 62. Allah minden dolog teremt\'f5je, \'e9s \'d5 minden dolog v\'e9delmez\'f5je.
\par 63. \'d6v\'e9 az egek \'e9s a f\'f6ld kulcsai \'e9s akik nem hisznek az \'d5 jeleiben, azok bizony a vesztesek.
\par 64. Mondd [\'f3 Mohamed]: {\*\bkmkstart 652}{\*\bkmkend 652}\'84Vajon azt parancsolj\'e1tok nekem, hogy Allahon k\'edv\'fcl valaki m\'e1st szolg\'e1ljak, ti tudatlanok?\'94
\par 65. \'c9s bizony m\'e1r kinyilatkoztatott neked \'e9s azoknak, akik el\'f5tted \'e9ltek, hogy ha [Allah mell\'e9] t\'e1rsistent \'e1ll\'edtan\'e1l, akkor bizony szertefoszlan\'e1nak a cselekedeteid, \'e9s a vesztesek k\'f6z\'fcl val\'f3 lenn\'e9l.
\par 66. De ink\'e1bb Allahot szolg\'e1ld, \'e9s legy\'e9l a h\'e1l\'e1sak k\'f6z\'fcl val\'f3!
\par 67. \'c9s nem becs\'fclt\'e9k nagyra Allah [hatalm\'e1t], az \'d5t megillet\'f5 nagyrabecs\'fcl\'e9s szerint. \'c9s az eg\'e9sz F\'f6ld az \'d5 mark\'e1ban lesz a Felt\'e1mad\'e1s napj\'e1n, \'e9s az egek \'f6ssze lesznek hajtva az \'d5 jobbj\'e1
ban. Magasztaltass\'e9k \'d5! \'c9s [\'d5] afelett van, amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [\'d5mell\'e9].
\par 
\par 68. \'c9s megf\'favatik a k\'fcrt, \'e9s holtan esik \'f6ssze mindenki, aki az egekben van \'e9s mindenki, aki a F\'f6ld\'f6n van, kiv\'e9ve az, akit Allah [meg] akar [menteni]. Azut\'e1n \'fajra megf\'favatik, \'e9s \'edme! \'d5k \'e1llnak \'e9s n\'e9
znek.\'94
\par 69. \'c9s a F\'f6ld ragyogni fog Ura f\'e9nye \'e1ltal, \'e9s elhelyeztetik az \'cdr\'e1s (a tettek feljegyz\'e9se), \'e9s el\'f5hozz\'e1k a pr\'f3f\'e9t\'e1kat \'e9s a v\'e9rtan\'fakat, \'e9s az igazs\'e1ggal lesz d\'f6ntve k\'f6z\'f6tt\'fck, \'e9
s nem fognak igazs\'e1gtalans\'e1got szenvedni.
\par 70. \'c9s minden embernek teljess\'e9 t\'e9tetik [a fizets\'e9ge] az\'e9rt, amit cselekedett, \'e9s \'d5 tudja legjobban azt, amit tesznek.
\par 
\par 71. \'c9s csoportokban vezettettnek majd a Gyehenn\'e1ba azok, akik hitetlenek voltak. Amikor azt\'e1n oda\'e9rnek, ki fognak ny\'edlni annak kapui, \'e9s az \'f5rz\'f5i azt mondj\'e1k nekik: \'84Vajon nem j\'f6ttek-e hozz\'e1tok k\'f6z\'fcletek val\'f3 k
\'fcld\'f6ttek, akik recit\'e1lt\'e1k nektek az Uratok jeleit, \'e9s figyelmeztettek titeket ezzel a nappal val\'f3 tal\'e1lkoz\'e1sotokra?\'94 Azt mondj\'e1k. \'84Dehogynem!\'94 Azonban beigazol\'f3dott [Allah] b\'fcntet\'e9sr\'f5l [sz\'f3l\'f3
] szava a hitetleneken.
\par 72. Az lesz mondva [nekik]: \'84L\'e9pjetek h\'e1t be a Gyehenna kapuin, hogy \'f6r\'f6kk\'e9 ott maradjatok!\'94 \'c9s milyen nyomor\'fas\'e1gos [is] a fennh\'e9j\'e1z\'f3k otthona!
\par 73. \'c9s csoportokban vezettettnek majd a Paradicsomba azok, akik f\'e9lt\'e9k Urukat. Amikor azt\'e1n oda\'e9rnek, \'e9s nyitva \'e1llnak m\'e1r annak kapui, \'e9s az \'f5rz\'f5i azt mondj\'e1k nekik: \'84B\'e9kess\'e9g re\'e1tok! J\'f3l cselekedtetek,
 l\'e9pjetek h\'e1t be, hogy \'f6r\'f6kk\'e9 ott maradjatok!\'94
\par 74. \'c9s azt mondj\'e1k: \'84A h\'e1latelt dics\'e9ret Allahot illeti, aki teljes\'edtette nek\'fcnk \'edg\'e9ret\'e9t \'e9s \'f6r\'f6k\'fcl adta nek\'fcnk a [Paradicsom] f\'f6ldj\'e9t. Ott jel\'f6lhet\'fcnk ki lak\'f3
helyet magunknak a Paradicsomban, ahol csak akarunk.\'94 Milyen kit\'fbn\'f5 a [j\'f3t] cselekv\'f5k jutalma!
\par 75. \'c9s l\'e1tni fogod, amint az angyalok k\'f6r\'fclveszik a Tr\'f3nust \'e9s magasztalj\'e1k Urukat az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, \'e9s az igazs\'e1ggal lesz d\'f6ntve k\'f6z\'f6tt\'fck, \'e9s az mondatik: \'84A h\'e1latelt dics\'e9
ret Allahot illeti, a teremtm\'e9nyek Ur\'e1t!\'94}{\insrsid13659446 
\par 
\par 
\par 
\par }\pard\plain \s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid13659446 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {\insrsid13659446 \page }{
\f0\fs24\insrsid13659446\charrsid3423863 40. }{\f0\fs24\insrsid13659446\charrsid5589655 Megbocs\'e1t\'f3 (Gh\'e1fir) c. sz\'fara}{\insrsid13659446\charrsid5589655 
\par }\pard\plain \qj \li0\ri0\sl100\slmult0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid13659446 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid13659446\charrsid5589655 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. H\'e1-M\'edm.
\par 2. Az \'cdr\'e1s (a Kor\'e1n) lebocs\'e1t\'e1sa a M\'e9lt\'f3s\'e1gteljes \'e9s a Mindentud\'f3 Allaht\'f3l [van].
\par 3. [Att\'f3l, aki] megbocs\'e1tja a b\'fbn\'f6ket \'e9s elfogadja a megb\'e1n\'e1st, [aki] szigor\'fa a b\'fcntet\'e9sben \'e9s b\'f5s\'e9ges kegyeket juttat. Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten Rajta k\'edv\'fcl. Hozz\'e1 lesz a v\'e9gc\'e9l.

\par {\*\bkmkstart 5111}{\*\bkmkend 5111}4. Nem sz\'e1llnak vit\'e1ba Allah jeleir\'f5l, kiv\'e9ve azokat, akik hitetlenek. Ne t\'e9vesszen meg t\'e9ged, ahogy [j\'f3l\'e9t\'fckben] j\'e1rnak-kelnek az orsz\'e1gban!
\par 
\par 5. M\'e1r \'f5el\'f5tt\'fck meghazudtol\'e1st k\'f6vetett el No\'e9 n\'e9pe \'e9s \'f5ut\'e1nuk a [k\'fcld\'f6tteik ellen] \'f6sszesz\'f6vetkez\'f5k. Minden k\'f6z\'f6ss\'e9g azon munk\'e1lkodott, hogy megragadja a k\'fcld\'f6tt\'e9t. \'c9s vit\'e1ba sz
\'e1lltak a hamiss\'e1ggal \'e9rvelve, hogy megc\'e1folj\'e1k azzal az Igazs\'e1got. Azt\'e1n megragadtam \'f5ket, \'e9s milyen volt a b\'fcntet\'e9sem!
\par 6. \'c9s ekk\'e9ppen igazol\'f3dott be Urad szava (\'edt\'e9lete) azokkal szemben, akik hitetlenek voltak, hogy \'f5k a [Pokol-]t\'fbz lak\'f3i lesznek.
\par 
\par 7. Azok [az angyalok], }{\insrsid13659446\charrsid4023759 akik a tr\'f3nust hordozz\'e1k, \'e9s akik k\'f6r\'fcl\'f6tte vannak, az Urukat magasztalj\'e1k, az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, \'e9s hisznek benne. \'c9s megbocs\'e1t\'e1st k\'e9
rnek a h\'edv\'f5k sz\'e1m\'e1ra [mondv\'e1n]: \'84Urunk! Te minden dolgot \'e1tfogsz a k\'f6ny\'f6r\'fcleteddel \'e9s a tud\'e1soddal. Bocs\'e1ss h\'e1t meg azoknak, akik megb\'e1n\'e1st tan\'fas\'edtottak \'e9s k\'f6vett\'e9k az Utad, \'e9s \'f3vd meg 
\'f5ket a Pokol gy\'f6trelm\'e9t\'f5l!
\par 8. Urunk! \'c9s bocs\'e1sd be \'f5ket \'f6r\'f6kk\'e9 tart\'f3 kertekbe [a Paradicsomban], amelyekre \'edg\'e9retet tett\'e9l nekik, \'e9s azokat is, akik j\'f3raval\'f3k voltak az aty\'e1ik, a h\'e1zast\'e1rsaik \'e9s a lesz\'e1rmazottaik k\'f6z\'fc
l! Bizony Te vagy a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 9. \'c9s \'f3vd meg \'f5ket a rossz tetteik [k\'f6vetkezm\'e9nyeit\'f5l]! Akit azon a napon meg\'f3vsz a rossz tettek [k\'f6vetkezm\'e9nyeit\'f5l], azon Te megk\'f6ny\'f6r\'fclsz. \'c9s ez a nagy diadal!\'94
\par 
\par 10. Bizony, akik hitetlenn\'e9 v\'e1ltak, \'edgy sz\'f3l\'edttatnak [majd meg]: \'84Allah gy\'fbl\'f6lete [fel\'e9tek] bizony nagyobb ann\'e1l, ahogyan ti [most] gy\'fbl\'f6litek saj\'e1t magatokat, [mert] amikor h\'ed
vattatok a hitre, akkor ti nem hittetek.\'94
\par 11. Azt mondj\'e1k [akkor]: \'84Urunk! K\'e9tszer k\'fcldt\'e9l minket a hal\'e1lba \'e9s k\'e9tszer keltett\'e9l minket \'e9letre. Elismerj\'fck a b\'fbneinket. Vajon van-e [sz\'e1munkra] m\'f3d a kijut\'e1sra [a Pokol-t\'fbzb\'f3l]?\'94
\par 12. Ez [az\'e9rt van \'edgy sz\'e1motokra], mert amikor egyed\'fcl Allahhoz foh\'e1szkodtak [mint az egyetlen Istenhez], akkor ti hitetlenn\'e9 v\'e1ltatok, \'e1m ha t\'e1rsisteneket \'e1ll\'edtottak [\'d5mell\'e9], akkor hittetek. A d\'f6nt\'e9s a Magass
\'e1gos \'e9s Nagy Allah\'e9.
\par 
\par 13. \'d5 az, aki megmutatja nektek a jeleit \'e9s ell\'e1t\'e1st bocs\'e1t le nektek az \'e9gb\'f5l. Csup\'e1n az okul [az int\'e9sb\'f5l], aki b\'fbnb\'e1nattal t\'e9r vissza [Allahhoz].
\par 14. Foh\'e1szkodjatok h\'e1t Allahhoz \'f5szinte odaad\'e1ssal szentelve Neki a vall\'e1s [gyakorl\'e1s\'e1t], m\'e9g ha ez ut\'e1latos is a hitetleneknek!
\par 15. [\'d5 Allah,] a legmagasabb fokozatok Birtokosa \'e9s a Tr\'f3nus Ura. A szolg\'e1i k\'f6z\'fcl arra bocs\'e1tja le a lelket (a kinyilatkozat\'e1st) a Parancs\'e1ra, akire akarja, hogy figyelmeztessen a Tal\'e1lkoz\'e1s napj\'e1ra.
\par 16. Azon a napon, amikor \'f5k el\'f5t\'fbnnek, nem marad semmi sem rejtve r\'f3luk Allah el\'f5tt. Ki\'e9 ma a kir\'e1lyi uralom? Allah\'e9, az Eggy\'e9, a Legy\'f5zhetetlen\'e9.
\par 17. A mai napon minden ember megkapja a fizets\'e9g\'e9t az\'e9rt, amire szert tett. A mai napon nincs igazs\'e1gtalans\'e1g. Bizony, Allah gyors az elsz\'e1mol\'e1sban.
\par 18. \'c9s figyelmeztesd \'f5ket [\'f3 Mohamed] a k\'f6zeled\'f5 nappal kapcsolatban, amikor a sz\'edv\'fck [szinte] a torkukban [dobog], \'e9s [l\'e9legzet\'fcket] visszatartj\'e1k [ijedts\'e9g\'fckben]. Az igazs\'e1gtalanoknak nem lesz k\'f6zeli }{
\insrsid13659446\charrsid6370639 bar\'e1tjuk, sem k\'f6zbenj\'e1r\'f3juk, aki meghallgat\'e1st nyerne.
\par 19. [Allah] ismeri a szemek csal\'e1rds\'e1g\'e1t \'e9s azt, amit a keblek elrejtenek.
\par 20. \'c9s Allah igazs\'e1gosan \'edt\'e9l, \'e1m akikhez Rajta k\'edv\'fcl foh\'e1szkodnak, azok semmilyen \'fcgyben nem \'edt\'e9lnek. Bizony, Allah az, aki a mindent Hall\'f3, a mindent L\'e1t\'f3.
\par 
\par 21. H\'e1t nem j\'e1rt\'e1k-e be a f\'f6ldet, \'e9s n\'e9zt\'e9k meg, milyen v\'e9gre jutottak azok, akik el\'f5tt\'fck \'e9ltek? Azok er\'f5sebbek voltak n\'e1luk, \'e9s t\'f6bb [maradand\'f3] nyomot [hagytak h\'e1tra] a f\'f6ld\'f6n, [mint \'f5
k]. Allah m\'e9gis elragadta \'f5ket a b\'fbneik miatt. \'c9s nem volt nekik senkij\'fck, aki meg\'f3vta \'f5ket Allaht\'f3l.
\par {\*\bkmkstart 2631}{\*\bkmkend 2631}22. Ez az\'e9rt [t\'f6rt\'e9nt \'edgy], mert elj\'f6ttek hozz\'e1juk a k\'fcld\'f6tteik a vil\'e1gos bizony\'edt\'e9kokkal, \'f5k azonban hitetlenekk\'e9 v\'e1ltak. Allah pedig elragadta \'f5ket. Bizony, \'d5 Er\'f5s 
\'e9s szigor\'fa a b\'fcntet\'e9sben.
\par 
\par 23. \'c9s m\'e1r [elk\'fcldt\'fck] kor\'e1bban M\'f3zest a jeleinkkel \'e9s nyilv\'e1nval\'f3 bizony\'edt\'e9kkal,
\par 24. F\'e1ra\'f3hoz, H\'e1m\'e1nhoz \'e9s K\'f3r\'e9hoz. De [\'f5k] azt mondt\'e1k: \'84[Ez egy]}{\insrsid13659446\charrsid6370639  hazudoz\'f3}{\insrsid13659446\charrsid6370639  var\'e1zsl\'f3!\'94
\par 25. \'c9s amikor elhozta nekik az Igazs\'e1got Mit\'f5l\'fcnk, azt mondt\'e1k: \'84\'d6lj\'e9tek meg azoknak a fiait, akik vele egy\'fctt hisznek, \'e9s hagyj\'e1tok \'e9letben asszonyaikat!\'94 \'c1m a hitetlenek fondorlata nincs m\'e1shol, mint t\'e9v
\'faton.
\par 26. \'c9s azt mondta a F\'e1ra\'f3: \'84Hagyj\'e1tok, hadd \'f6ljem meg M\'f3zest, \'f5 pedig foh\'e1szkodjon csak az Ur\'e1hoz! Bizony, f\'e9lek, hogy megv\'e1ltoztatja a vall\'e1sotokat, vagy hogy roml\'e1st id\'e9z el\'f5 a f\'f6ld\'f6n.\'94
\par 27. \'c9s azt mondta M\'f3zes: \'84Bizony, \'e9n mened\'e9ket keresek [Allahn\'e1l], az \'e9n Uramn\'e1l \'e9s a ti Uratokn\'e1l, minden fennh\'e9j\'e1z\'f3 el\'f5l, aki nem hisz az Elsz\'e1mol\'e1s napj\'e1ban{\*\bkmkstart 2831}{\*\bkmkend 2831}.\'94

\par 
\par 28. \'c9s a F\'e1ra\'f3 csal\'e1dj\'e1b\'f3l egy h\'edv\'f5 f\'e9rfi, aki elrejtette a hit\'e9t, azt mondta: \'84Meg akartok \'f6lni egy embert, mert azt mondja: 'Allah az \'e9n Uram' - holott Uratokt\'f3l val\'f3 vil\'e1gos bizony\'edt\'e9kokkal j\'f6
tt el hozz\'e1tok? Ha hazudik, akkor a hazugs\'e1ga \'f5ellene fordul. Ha azonban igazat mond, akkor titeket fog s\'fajtani annak egy r\'e9sze, amire \'edg\'e9retet tesz nektek. Bizony, Allah nem vezeti az igaz \'fatra azt, aki m\'e9rt\'e9ktelen}{
\f0\insrsid13659446\charrsid6370639  }{\insrsid13659446\charrsid6370639 hazudoz\'f3.
\par 29. \'d3 n\'e9pem! Ti\'e9tek ma a kir\'e1lyi uralom, ti vagytok a fel\'fclkered\'f5k a f\'f6ld\'f6n. \'c1m ki fog seg\'edteni rajtunk Allah csap\'e1sa ellen, ha el\'e9rkezne hozz\'e1nk?\'94 A F\'e1ra\'f3 azt mondta: \'84\'c9n csak azt l\'e1
ttatom veletek, amit \'e9n [helyesnek] l\'e1tok, \'e9s csup\'e1n a helyes \'fatra vezetlek titeket.\'94
\par 30. \'c9s az, aki h\'edv\'f5 lett, azt mondta: \'84\'d3 n\'e9pem! \'c9n bizony, f\'e9ltelek titeket [egy olyan napt\'f3l], ami hasonl\'f3 a [k\'fcld\'f6tteik ellen] \'f6sszesz\'f6vetkez\'f5k napj\'e1hoz!
\par 31. [A hozz\'e1\'e1ll\'e1sotok] olyan, mint amilyen No\'e9, \'c1d \'e9s Tam\'fad n\'e9peinek a hozz\'e1\'e1ll\'e1sa [volt], \'e9s azoknak, akik ut\'e1nuk [\'e9ltek]. \'c9s Allah nem akar igazs\'e1gtalans\'e1got a szolg\'e1knak.
\par 32. \'c9s \'f3 n\'e9pem! Bizony f\'e9ltelek titeket att\'f3l a napt\'f3l, amikor [az emberek] egym\'e1st sz\'f3longatj\'e1k,
\par 33. egy olyan napt\'f3l, amikor h\'e1tat ford\'edtotok menek\'fclve, [\'e1m] nem lesz nektek v\'e9delmez\'f5t\'f6k [aki megv\'e9dene] Allaht\'f3l, \'e9s akit Allah t\'e9velyg\'e9sbe visz, annak nincs vezet\'f5je [az igaz \'fatra].
\par 
\par 34. \'c9s kor\'e1bban elj\'f6tt m\'e1r hozz\'e1tok J\'f3zsef a vil\'e1gos bizony\'edt\'e9kokkal, \'e1m ti k\'e9ts\'e9gben maradtatok afel\'f5l, amit elhozott nektek, \'e9s amikor [ut\'f3d n\'e9lk\'fcl] meghalt, azt mondt\'e1tok: 'Allah nem fog k\'fcld\'f6
ttet k\'fcldeni \'f5ut\'e1na.' Ekk\'e9ppen vezeti t\'e9velyg\'e9sbe Allah azt, aki m\'e9rt\'e9ktelen k\'e9telked\'f5.\'94
\par {\*\bkmkstart 3631}{\*\bkmkend 3631}35. Akik vit\'e1ba sz\'e1llnak Allah jeleir\'f5l an\'e9lk\'fcl, hogy bizony\'edt\'e9k j\'f6tt volna el hozz\'e1juk. Nagyon gy\'fbl\'f6letes ez Allah el\'f5tt \'e9s azok el\'f5tt, akik h\'edv\'f5k lettek. Ekk\'e9
ppen pecs\'e9teli le Allah minden fennh\'e9j\'e1z\'f3, hatalmaskod\'f3 sz\'edv\'e9t.
\par 
\par 36. \'c9s azt mondta a F\'e1ra\'f3: \'84\'d3 H\'e1m\'e1n! \'c9p\'edts nekem egy magas tornyot! Tal\'e1n el\'e9rem az utakat,
\par 37. Az \'e9g \'fatjait, hogy r\'e1tekinthessek M\'f3zes isten\'e9re. \'c9s bizony, \'e9n \'fagy v\'e9lem, hogy \'f5 hazug!\'94 \'c9s ekk\'e9ppen d\'edsz\'edttettek fel a F\'e1ra\'f3nak a rossz tettei, \'e9s t\'e1vol lett tartva az [Egyenes] \'datt\'f3l. 
\'c1m a F\'e1ra\'f3 fondorlata nem ment m\'e1sba, mint veszend\'f5be.
\par 
\par 38. \'c9s az, aki h\'edv\'f5 lett, azt mondta: \'84\'d3 n\'e9pem! K\'f6vessetek engem, elvezetlek titeket a helyes \'fatra{\*\bkmkstart 3931}{\*\bkmkend 3931}!
\par 39. \'d3 n\'e9pem! Ez az evil\'e1gi \'e9let csup\'e1n [muland\'f3] \'e9lvezet. \'c9s bizony a t\'falvil\'e1g az \'f6r\'f6k tart\'f3zkod\'e1s helye.
\par 40. Aki rosszat cselekszik, azt nem illeti m\'e1s fizets\'e9g, csup\'e1n ugyanannyi. Aki j\'f3tettet cselekszik, [legyen] ak\'e1r f\'e9rfi, ak\'e1r n\'f5, \'e9s h\'edv\'f5, az bel\'e9p a Paradicsomba, ahol ell\'e1t\'e1sban r\'e9szes\'fcl sz\'e1mad\'e1s n
\'e9lk\'fcl.
\par {\*\bkmkstart 4231}{\*\bkmkend 4231}41. \'c9s \'f3 n\'e9pem! Mi\'e9rt van az, hogy a megmenek\'fcl\'e9sre h\'edvlak titeket, ti pedig a [Pokol-]t\'fbzbe h\'edvtok engem?
\par 42. Arra h\'edvtok engem, hogy hitetlenn\'e9 v\'e1ljak Allahhal szemben \'e9s olyan t\'e1rsisteneket \'e1ll\'edtsak [Allah] mell\'e9, amelyekr\'f5l nem rendelkezem tud\'e1ssal, \'e9n pedig a M\'e9lt\'f3s\'e9gteljeshez, a Megbocs\'e1t\'f3hoz h\'ed
vlak titeket.\'94
\par 43. Nem k\'e9ts\'e9ges, hogy akihez ti h\'edvtok engem, az nem \'e9rdemli meg a foh\'e1szt, sem az evil\'e1gon, sem a t\'falvil\'e1gon, \'e9s [nem k\'e9ts\'e9ges,] hogy Allahhoz lesz a visszat\'e9r\'e9s\'fcnk \'e9s hogy a m\'e9rt\'e9ktelenek lesznek a [P
okol-]t\'fbz lak\'f3i.
\par 44. \'c9s eml\'e9kezni fogtok arra, amit mondok nektek, \'e9s Allahra }{\insrsid13659446\charrsid11561001 b\'edzom az \'fcgyemet. Bizony, Allah belel\'e1t a szolg\'e1iba.\'94
\par 45. \'c9s Allah meg\'f3vta \'f5t annak a rossz\'e1t\'f3l, ami fondorlatot sz\'f5ttek [ellene]. \'c9s sz\'f6rny\'fb gy\'f6trelem ker\'edtette k\'f6rbe a F\'e1ra\'f3 }{\insrsid13659446\charrsid4270468 n\'e9p\'e9t.
\par 46. A [Pokol-]t\'fbz el\'e9 lesznek \'e1ll\'edtva kora reggel \'e9s naplemente el\'f5tt [a s\'edrjukban az \'cdt\'e9let napj\'e1ig]. \'c9s azon a napon, amikor bek\'f6vetkezik az \'d3ra, [az mondatik]: \'84Bocs\'e1ss\'e1tok be a F\'e1ra\'f3 n\'e9p\'e9
t a legs\'falyosabb gy\'f6trelembe!\'94
\par 
\par 47. \'c9s [eml\'edtsd meg azt], amikor \'e9rvelve sz\'e1llnak majd vit\'e1ba egym\'e1ssal a [Pokol-]t\'fbzben! \'c9s az elnyomottak azt mondj\'e1k azoknak, akik fennh\'e9j\'e1ztak: \'84Bizony, mi a ti k\'f6vet\'f5itek voltunk, h\'e1t tudtok-e sz\'e1
munkra egy r\'e9szt is elh\'e1r\'edtani a [Pokol-]t\'fbzb\'f5l?\'94
\par 48. Akik fennh\'e9j\'e1ztak, azt mondj\'e1k: \'84Bizony, mi mindannyian benne vagyunk. Bizony, Allah m\'e1r \'edt\'e9lkezett a szolg\'e1i k\'f6z\'f6tt.{\*\bkmkstart 4931}{\*\bkmkend 4931}\'94
\par {\*\bkmkstart 5031}{\*\bkmkend 5031}49. \'c9s akik a [Pokol-]t\'fbzben vannak, azt mondj\'e1k a Gyehenna \'f5rz\'f5inek: \'84Foh\'e1szkodjatok az Uratokhoz, hogy enyh\'edtsen sz\'e1munkra [ak\'e1rcsak] egyetlen napot a gy\'f6trelemb\'f5l!\'94
\par 50. [A Gyehenna \'f5rz\'f5i] azt mondj\'e1k: \'84H\'e1t nem j\'f6ttek el hozz\'e1tok a k\'fcld\'f6tteitek a vil\'e1gos bizony\'edt\'e9kokkal?\'94 Azt mondj\'e1k: \'84Dehogynem!\'94 Azt mondj\'e1k [az \'f5rz\'f5k]: \'84Foh\'e1szkodjatok h\'e1t [magatok\'e9
rt]!\'94 \'c9s a hitetlenek foh\'e1sza nincs m\'e1shol, mint t\'e9v\'faton.
\par 51. Bizony, Mi megseg\'edtj\'fck a k\'fcld\'f6tteket \'e9s azokat, akik h\'edv\'f5k lettek, az evil\'e1gi \'e9letben \'e9s [a Felt\'e1mad\'e1s] napj\'e1n, amikor el\'f5\'e1llnak a tan\'fak.
\par 52. Azon a napon, amikor nem haszn\'e1l az igazs\'e1gtalanoknak a menteget\'f5z\'e9s\'fck. \'c9s nekik \'e1tok j\'e1r \'e9s a legrosszabb lakhely illeti \'f5ket.
\par 
\par 53. \'c9s bizony, \'fatmutat\'e1st adtunk kor\'e1bban M\'f3zesnek, \'e9s Izrael fiainak adtuk \'f6r\'f6k\'fcl az \'cdr\'e1st (a T\'f3r\'e1t).
\par 54. \'datmutat\'e1sk\'e9nt \'e9s eml\'e9keztet\'e9sk\'e9nt az \'e9rtelemmel b\'edr\'f3knak.
\par 55. Legy\'e9l h\'e1t t\'fcrelmes! Bizony, Allah \'edg\'e9rete igaz. \'c9s k\'e9rj megbocs\'e1t\'e1st a b\'fbn\'f6d\'e9rt! \'c9s magasztalt az Urad az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, naplemente el\'f5tt \'e9s hajnalban!
\par 56. Bizony, akik vit\'e1ba sz\'e1llnak Allah jeleir\'f5l an\'e9lk\'fcl, hogy bizony\'edt\'e9k j\'f6tt volna el hozz\'e1juk, azoknak a kebl\'e9ben csak fennh\'e9j\'e1z\'e1s van, de nem fogj\'e1k el\'e9rni azt (Allah jeleinek megc\'e1fol\'e1s\'e1
t). Keress h\'e1t Allahn\'e1l mened\'e9ket! Bizony, \'d5 a mindent Hall\'f3, a mindent L\'e1t\'f3.
\par 57. Az egek \'e9s a f\'f6ld megteremt\'e9se bizony nagyobb, mint az emberek teremt\'e9se, \'e1m a legt\'f6bb ember nem rendelkezik tud\'e1ssal.
\par 58. \'c9s nem egyenl\'f5 egym\'e1ssal a vak \'e9s a l\'e1t\'f3, \'e9s azok, akik hisznek \'e9s j\'f3tetteket cselekszenek, [\'f5k] sem egyenl\'f5ek a rosszat tev\'f5vel. Mily kev\'e9ss\'e9 okultok [az int\'e9sb\'f5l].
\par 
\par 59. Bizony, az \'d3ra biztosan el fog j\'f6nni, nem f\'e9rhet hozz\'e1 k\'e9ts\'e9g! \'c1m a legt\'f6bb ember nem hisz.
\par 60. \'c9s azt mondta az Uratok: \'84Foh\'e1szkodjatok hozz\'e1m \'e9s \'e9n meghallgatlak titeket! Akik fennh\'e9j\'e1z\'f3an [elfordulnak] a Nekem val\'f3 szolg\'e1latt\'f3l, azok al\'e1zatosan fognak a Gyehenn\'e1ba menni.\'94
\par 
\par 61. Allah az, aki az \'e9jszak\'e1t arra rendelte nektek, hogy abban nyugalomra leljetek, \'e9s a nappalt arra, hogy l\'e1that\'f3v\'e1 tegye [a dolgokat]. Bizony Allah kegyes az emberek ir\'e1nt, azonban a legt\'f6bb ember nem h\'e1l\'e1s.
\par 62. \'cdme, \'d5 Allah, a ti Uratok. [\'d5] minden dolog Teremt\'f5je. Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten Rajta k\'edv\'fcl. Hogyan lehettek h\'e1t elt\'e9r\'edtve [az igazs\'e1gt\'f3l]?
\par {\*\bkmkstart 643}{\*\bkmkend 643}63. Ekk\'e9ppen lettek elt\'e9r\'edtve [az igazs\'e1gt\'f3l] azok, akik tagadt\'e1k Allah jeleit.
\par 64. Allah az, aki a f\'f6ldet tart\'f3zkod\'e1s [hely\'e9v\'e9] tette nektek \'e9s az eget \'e9p\'edtm\'e9nny\'e9, \'e9s megform\'e1zott titeket, \'e9s a legjobb form\'e1t adta nektek, \'e9s mindenf\'e9le j\'f3 dologgal l\'e1tott el titeket. \'cdme, \'d5
 Allah, a ti Uratok. \'c1ldass\'e9k h\'e1t Allah, a teremtm\'e9nyek Ura!
\par 65. \'d5 az \'e9l\'f5. Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten Rajta k\'edv\'fcl. Foh\'e1szkodjatok h\'e1t Hozz\'e1 \'f5szinte odaad\'e1ssal szentelve Neki a vall\'e1s [gyakorl\'e1s\'e1t]! A h\'e1latelt dics\'e9ret Allahot illeti, a teremtm\'e9nyek Ur
\'e1t!
\par {\*\bkmkstart 673}{\*\bkmkend 673}66. Mondd [\'f3 Mohamed]: \'84Megtilttatott nekem az, hogy azokat szolg\'e1ljam, akikhez ti Allah helyett foh\'e1szkodtok, miut\'e1n vil\'e1gos bizony\'edt\'e9kok \'e9rkeztek hozz\'e1m az Uramt\'f3l. \'c9
s parancsot kaptam, hogy vessem al\'e1 magam a teremtm\'e9nyek Ur\'e1nak!\'94
\par 
\par 67. \'d5 az, aki megteremtett titeket porb\'f3l, azt\'e1n [megterm\'e9keny\'fclt] cseppb\'f5l, azt\'e1n v\'e9rr\'f6gb\'f5l, azt\'e1n gyermekk\'e9nt hoz el\'f5 titeket, hogy azt\'e1n \'e9rett korba l\'e9pjetek, \'e9s hogy ut\'e1na \'f6regekk\'e9 v\'e1
ljatok - \'e1mb\'e1r van k\'f6z\'f6ttetek olyan, aki m\'e1r kor\'e1bban elsz\'f3l\'edttatik [Allahoz] - \'e9s hogy el\'e9rjetek egy megszabott hat\'e1rid\'f5t; \'e9s h\'e1tha \'e9ltek az eszetekkel.}{\cs96\insrsid13659446\charrsid4270468 
\par 68. \'d5 az, aki \'e9letre kelt \'e9s hal\'e1lba k\'fcld. \'c9s ha egy dolgot elrendel, akkor csup\'e1n annyit mond annak: \'84Legy\'e9l!\'94 \endash  \'e9s az van.}{\insrsid13659446\charrsid4270468 
\par 
\par 69. Vajon nem jutott tudom\'e1sodra azoknak [a h\'edre], akik vit\'e1ba sz\'e1llnak Allah jeleir\'f5l? Hogyan ford\'edthatj\'e1k el \'f5ket [a hitt\'f5l]?
\par 70. Akik meghazudtolj\'e1k az \'cdr\'e1st (a Kor\'e1nt) \'e9s azt, amivel elk\'fcldt\'fck a k\'fcld\'f6tteinket, azok meg fogj\'e1k majd tudni [annak a k\'f6vetkezm\'e9ny\'e9t],
\par {\*\bkmkstart 733}{\*\bkmkend 733}71. Amikor bilincsek lesznek a nyakukon \'e9s l\'e1ncok, belehurcoltatnak
\par 72. [A Pokol-t\'fbz] forr\'e1sban l\'e9v\'f5 v\'edz\'e9be, majd a t\'fbzben lesznek \'e9getve.
\par 73. Azt\'e1n az lesz mondva nekik: \'84Hol vannak azok, akiket t\'e1rsistenk\'e9nt \'e1ll\'edtottatok
\par 74. Allah mell\'e9?\'94 Azt fogj\'e1k mondani: \'84Elt\'fbntek t\'f5l\'fcnk. S\'f5t! Nem foh\'e1szkodtunk kor\'e1bban semmihez!\'94 \'cdgy viszi t\'e9velyg\'e9sbe Allah a hitetleneket.
\par 75. Ez [az\'e9rt t\'f6rt\'e9nt] veletek, mert jogtalanul \'f6rvendeztetek a f\'f6ld\'f6n, \'e9s mert kev\'e9lyek voltatok.
\par 76. L\'e9pjetek h\'e1t be a Gyehenna kapuin, [hogy] \'f6r\'f6kk\'e9 ott maradjatok! Milyen nyomor\'fas\'e1gos is a fennh\'e9j\'e1z\'f3k otthona!
\par 77. Legy\'e9l h\'e1t t\'fcrelmes [\'f3 Mohamed]! Bizony, Allah \'edg\'e9rete igaz. Ak\'e1r megmutatjuk neked annak egy r\'e9sz\'e9t, amit meg\'edg\'e9rt\'fcnk nekik, ak\'e1r [m\'e9g el\'f5tte] magunkhoz sz\'f3l\'edtunk t\'e9ged \endash  Hozz\'e1
nk lesz a visszat\'e9r\'e9s\'fck.
\par 
\par 78. \'c9s m\'e1r teel\'f5tted is k\'fcldt\'fcnk k\'fcld\'f6tteket. Vannak k\'f6z\'f6tt\'fck, akiknek a t\'f6rt\'e9net\'e9t m\'e1r elbesz\'e9lt\'fck neked, \'e1m vannak k\'f6z\'f6tt\'fck [olyanok is,] akiknek a t\'f6rt\'e9net\'e9t nem besz\'e9lt\'fc
k el neked. \'c9s egy k\'fcld\'f6tt sem hozhatott jelet, csak Allah engedelm\'e9vel. \'c9s ha elj\'f6n Allah parancsa, akkor a d\'f6nt\'e9s az igazs\'e1g szerint t\'f6rt\'e9nik, \'e9s akkor vesztesek lesznek a hamiss\'e1got k\'f6vet\'f5k.
\par 
\par 79. Allah az, aki megalkotta sz\'e1motokra a j\'f3sz\'e1gokat, hogy azok k\'f6z\'fcl legyenek olyanok, amelyeken utazhattok, \'e9s olyanok, amelyeket megehettek.
\par 80. \'c9s sok haszon van abban sz\'e1motokra, \'e9s hogy el\'e9rj\'e9tek azt a sz\'fcks\'e9get (a nehezen el\'e9rhet\'f5 \'fati c\'e9lt), amely a kebletekben van (amire v\'e1gytok), \'e9s azokon \'e9s a haj\'f3kon hordoztattok.
\par {\*\bkmkstart 822}{\*\bkmkend 822}81. \'c9s [Allah] megmutatja nektek a jeleit. Allah melyik jel\'e9t akarj\'e1tok h\'e1t tagadni?
\par 82. H\'e1t nem j\'e1rt\'e1k-e be a f\'f6ldet, \'e9s n\'e9zt\'e9k meg, milyen v\'e9gre jutottak azok, akik el\'f5tt\'fck \'e9ltek? [Azok] t\'f6bben voltak n\'e1luk \'e9s er\'f5sebbek [voltak] \'e9s t\'f6bb [maradand\'f3] nyomot hagytak h\'e1tra a f\'f6ld
\'f6n. De nem haszn\'e1lt nekik az, amit szereztek [amikor el\'e9rte \'f5ket Allah b\'fcntet\'e9se].
\par 83. \'cdgy miut\'e1n elj\'f6ttek hozz\'e1juk a k\'fcld\'f6ttek a vil\'e1gos bizony\'edt\'e9kokkal, [elutas\'edtott\'e1k azokat, \'e9s] \'f6rvendeztek annak a tud\'e1snak, ami a birtokukban volt. \'c9s k\'f6rbeker\'edtette \'f5ket az [a b\'fcntet\'e9
s], amib\'f5l g\'fanyt \'fbztek.
\par {\*\bkmkstart 852}{\*\bkmkend 852}84. \'c9s miut\'e1n megl\'e1tt\'e1k a csap\'e1sunkat, azt mondt\'e1k: \'84Egyed\'fcl Allahban hisz\'fcnk \'e9s hitetlenek lett\'fcnk azzal szemben, amit t\'e1rsistenk\'e9nt \'e1ll\'edtottunk [Allah mell\'e9].\'94}{
\insrsid13659446 
\par 85. \'c1m nem haszn\'e1lt m\'e1r nekik az \'f5 hit\'fck, miut\'e1n megl\'e1tt\'e1k a mi csap\'e1sunkat. Ez Allah [\'e1ltal elrendelt] t\'f6rv\'e9nyszer\'fbs\'e9g, [amely] m\'e1r v\'e9gbement a szolg\'e1it illet\'f5en. \'c9
s akkor vesztesek lesznek a hitetlenek.}{\insrsid10757626 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\insrsid10757626 \page }{\b0\fs24\insrsid10757626\charrsid3236878 41. }{\b0\fs24\lang1038\langfe1081\kerning1\dbch\af13\langfenp1081\insrsid10757626\charrsid8812106 \hich\af1\dbch\af13\loch\f1 \hich\f1 R\'e9\loch\f1 \hich\f1 
szletesen kifejtettek (Fusszilat) c. sz\'fa\loch\f1 ra}{\b0\fs24\insrsid10757626\charrsid8812106 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid8812106 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid8812106 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev
\'e9ben{\*\bkmkstart 3141}{\*\bkmkend 3141}.
\par 
\par 1. H\'e1-M\'edm.
\par 2. [A Kor\'e1n] lebocs\'e1t\'e1sa a K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas [Allaht\'f3l] van.
\par 3. Olyan \'cdr\'e1s ez, amelynek a jelei (id\'e9zetei) r\'e9szletesen kifejtettek, arab nyelv\'fb Kor\'e1nk\'e9nt egy olyan n\'e9pnek, akik rendelkeznek tud\'e1ssal.
\par 4. \'d6r\'f6mh\'edr-hoz\'f3k\'e9nt \'e9s figyelmeztet\'f5kk\'e9nt. A legt\'f6bbj\'fck azonban elfordul, \'e9s \'edgy \'f5k nem hallj\'e1k meg [az int\'f5 sz\'f3t].
\par 5. \'c9s azt mondt\'e1k: \'84A sz\'edv\'fcnk lepelben van, azzal szemben, amire h\'edvsz minket [ez\'e9rt nem fogadja be], \'e9s a f\'fcl\'fcnkben pedig s\'fckets\'e9g van, \'e9s k\'f6zt\'fcnk \'e9s k\'f6zted f\'fcgg\'f6ny van. Cselekedj h\'e1
t [a hited szerint], mi is \'fagy cseleksz\'fcnk.\'94
\par 6. Mondd [\'f3 Mohamed]: \'84\'c9n csup\'e1n egy hozz\'e1tok hasonl\'f3 ember vagyok. Az sugalltatik nekem [kinyilatkoztat\'e1sk\'e9nt], hogy a ti istenetek egy Isten. J\'e1rjatok h\'e1t az Egyenes \'faton, ami \'d5hozz\'e1 vezet, \'e9s k\'e9
rjetek megbocs\'e1t\'e1st [T\'f5le]!\'94 \'c9s jaj azoknak, akik t\'e1rsisteneket \'e1ll\'edtanak [Allah mell\'e9],
\par 7. Akik nem adj\'e1k meg a k\'f6telez\'f5 adom\'e1nyt, \'e9s \'f5k [azok, akik] nem hisznek a t\'falvil\'e1gban.
\par 8. Bizony, akik hisznek, \'e9s j\'f3tetteket cselekszenek, azoknak meg nem sz\'fbn\'f5 fizets\'e9g lesz a r\'e9sz\'fck.
\par 
\par 9. Mondd: \'84Vajon ti val\'f3ban nem hisztek abban, aki k\'e9t nap alatt teremtette a f\'f6ldet, \'e9s vet\'e9lyt\'e1rsakat helyeztek mell\'e9 [az im\'e1datban]? \'d5 a teremtm\'e9nyek Ura!\'94
\par 10. \'c9s szil\'e1rdan r\'f6gz\'edtetteket (hegyeket) helyezett r\'e1 (a f\'f6ldre), amelyek f\'f6l\'e9je [magasodnak], \'e9s meg\'e1ldotta azt \'e9s megszabta azon az \'e9lelm\'fcket [az el\'f5z\'f5 k\'e9t nappal egy\'fctt] n\'e9gy egyenl\'f5
 nap alatt - [ez a v\'e1lasz] azoknak, akik k\'e9rdeznek [a f\'f6ld teremt\'e9s\'e9r\'f5l].
\par 11. Azt\'e1n az \'e9g fel\'e9 fordult, amikor az m\'e9g f\'fcst volt, \'e9s azt mondta annak \'e9s a f\'f6ldnek: \'84J\'f6jjetek \'f6nsz\'e1ntatokb\'f3l, vagy akaratotok ellen\'e9re!\'94 Azok ketten azt mondt\'e1k: \'84Elj\'f6tt\'fcnk \'f6nsz\'e1ntunkb
\'f3l [hogy az ember rendelkezhessen vel\'fcnk].\'94
\par 12. \'c9s \'fagy rendelkezett [az egek fel\'f5l] hogy h\'e9t \'e9gbolt legyen k\'e9t nap alatt, \'e9s elrendelte mindegyik \'e9gnek a dolg\'e1t. \'c9s l\'e1mp\'e1sokkal d\'edsz\'edtett\'fck a legals\'f3 \'e9gboltot \endash  \'e9s \'f5rz\'e9sk\'e9ppen [a s
\'e1t\'e1nok ellen]. Mindez a M\'e9lt\'f3s\'e1gteljes, a Mindentud\'f3 elrendel\'e9se.
\par 
\par 13. \'c9s ha elfordulnak, akkor mondd: \'84Figyelmeztetlek titeket egy olyan vill\'e1mcsap\'e1sra, mint amilyen vill\'e1mcsap\'e1s [s\'fajtotta] \'c1dot \'e9s Tam\'fadot!\'94
\par 14. [Eml\'edtsd meg] amikor [egym\'e1s ut\'e1n] elj\'f6ttek hozz\'e1juk a k\'fcld\'f6tteik, el\'f5tt\'fck \'e9s m\'f6g\'f6tt\'fck [azt mondv\'e1n, hogy:] \'84Ne szolg\'e1ljatok m\'e1st, csak Allahot!\'94 Azt mondt\'e1k: \'84Ha Urunk [\'fa
gy] akarta volna, akkor bizony angyalokat bocs\'e1tott volna le. Bizony, mi nem hisz\'fcnk abban, amivel el lettetek k\'fcldve.\'94
\par 15. Ami \'c1dot illeti, \'f5k jogtalanul fennh\'e9j\'e1ztak a f\'f6ld\'f6n, \'e9s azt mondt\'e1k: \'84Ki er\'f5sebb n\'e1lunk?\'94 Nem l\'e1tt\'e1k-e, hogy Allah, aki teremtette \'f5ket, er\'f5sebb n\'e1luk? \'c9s tagadt\'e1k a mi jeleinket.
\par 16. \'c9s s\'fcv\'edt\'f5, tombol\'f3 szelet k\'fcldt\'fcnk r\'e1juk v\'e9szterhes napokon, hogy m\'e1r az evil\'e1gi \'e9letben meg\'edzleltess\'fck vel\'fck a megsz\'e9gyen\'edt\'e9s gy\'f6trelm\'e9t. \'c9s bizony a t\'falvil\'e1g gy\'f6trelme m\'e9
g megsz\'e9gyen\'edt\'f5bb, \'e9s \'f5k nem lesznek megseg\'edtve.
\par {\*\bkmkstart 188}{\*\bkmkend 188}17. Ami pedig Tam\'fadot illeti, h\'e1t megmutattuk nekik az igaz utat, \'e1m \'f5k el\'f5nyben r\'e9szes\'edtett\'e9k a vaks\'e1got az \'fatmutat\'e1ssal szemben. \'c9s [akkor] megal\'e1z\'f3 gy\'f6trelem vill\'e1mcsap
\'e1sa ragadta meg \'f5ket az\'e9rt, amit szereztek.
\par 18. \'c9s mi megmentett\'fck azokat, akik hittek \'e9s istenf\'e9lelmet tan\'fas\'edtottak.
\par 
\par 19. \'c9s [eml\'edtsd meg] azt a napot, amikor Allah ellens\'e9gei \'f6sszegy\'fbjtetnek majd a [Pokol-]t\'fbzh\'f6z, \'e9s \'f5k [ott] sorba \'e1ll\'edttatnak!
\par 20. Amikor v\'e9g\'fcl oda\'e9rkeznek, a hall\'e1suk, a l\'e1t\'e1suk \'e9s a b\'f5r\'fck tesz tan\'fabizonys\'e1got ellen\'fck arr\'f3l, ami [rosszat] cselekedtek [az evil\'e1gon].
\par 21. \'c9s azt mondj\'e1k a b\'f5r\'fcknek: \'84Mi\'e9rt tan\'faskodtatok ellen\'fcnk?\'94 Azok azt mondj\'e1k: \'84Allah b\'edrt sz\'f3ra minket, aki mindent sz\'f3ra b\'edrt.\'94 \'c9s \'d5 teremtett meg titeket els\'f5 alkalommal \'e9s Hozz\'e1
 lesztek visszavitetve.
\par 22. \'c9s nem [att\'f3l tartva] k\'f6vett\'e9tek el leplezve [a b\'fbn\'f6ket], hogy tan\'fabizonys\'e1got fog tenni ellenetek a hall\'e1sotok, a l\'e1t\'e1sotok \'e9s a b\'f5r\'f6t\'f6k, hanem azt v\'e9lt\'e9tek, hogy Allahnak nincsen tudom\'e1
sa sok olyanr\'f3l, amiket cselekszetek.
\par {\*\bkmkstart 247}{\*\bkmkend 247}23. \'c9s eme v\'e9leked\'e9setek, amelyet Uratokr\'f3l v\'e9ltetek, vitt titeket pusztul\'e1sba \'e9s a vesztesek k\'f6z\'fcl val\'f3v\'e1 v\'e1ltatok.
\par 24. \'c9s ha t\'fcrelmet tan\'fas\'edtanak, akkor is a [Pokol-]t\'fbz az \'f5 lakhely\'fck! \'c9s ha lehet\'f5s\'e9get k\'e9rnek a menteget\'f5z\'e9sre, akkor \'f5k nem fognak azok k\'f6z\'e9 tartozni, akiknek elfogadtatnak a ments\'e9gei.
\par 
\par 25. \'c9s olyan t\'e1rsakat adtunk mell\'e9j\'fck, akik feld\'edsz\'edtett\'e9k sz\'e1mukra azt, ami el\'f5tt\'fck van [az evil\'e1gi \'e9letb\'f5l], \'e9s ami m\'f6g\'f6tt\'fck van [a t\'falvil\'e1gb\'f3l]. \'c9s jogoss\'e1 v\'e1lt vel\'fck szemben a [b
\'fcntet\'e9sr\'f5l sz\'f3l\'f3] sz\'f3, ak\'e1rcsak [azokkal] a dzsinnek \'e9s az emberek k\'f6z\'fcl val\'f3 k\'f6z\'f6ss\'e9gekkel szemben, akik elt\'e1voztak [m\'e1r az \'e9l\'f5k sor\'e1b\'f3l]. Bizony, \'f5k vesztesek voltak [mindannyian].
\par 26. \'c9s azt mondt\'e1k [egym\'e1snak] azok, akik hitetlenn\'e9 v\'e1ltak: \'84Ne hallgassatok erre a Kor\'e1nra, \'e9s zajongjatok [a recit\'e1l\'e1sa] k\'f6zben, h\'e1tha ti lesztek a fel\'fclkereked\'f5k!\'94
\par 27. \'c9s bizony, sz\'f6rny\'fb gy\'f6trelmet fogunk meg\'edzleltetni azokkal, akik hitetlenn\'e9 v\'e1ltak, \'e9s bizony a legrosszabb cselekedeteik szerint adjuk meg nekik a fizets\'e9g\'fcket.
\par 28. Ez Allah ellens\'e9geinek a fizets\'e9ge [ami] a [Pokol]-t\'fcze. \'d6r\'f6k lakhely\'fck lesz abban fizets\'e9g\'fcl az\'e9rt, ami\'e9rt tagadt\'e1k a jeleinket.
\par 29. \'c9s azt mondj\'e1k azok, akik hitetlenn\'e9 v\'e1ltak: \'84Urunk! Mutasd meg nek\'fcnk azokat, akik t\'e9velyg\'e9sbe vittek minket a dzsinnek \'e9s emberek k\'f6z\'fcl, hogy a l\'e1bunk al\'e1 tegy\'fck \'f5ket, hogy \'f5
k legyenek a legalantasabbak!\'94}{\cs100\cf1\insrsid10757626\charrsid8812106 
\par 
\par 30. Bizony, akik azt mondj\'e1k: \'84Allah az Urunk!\'94, majd az egyenes \'faton j\'e1rnak, azokhoz leereszkednek az angyalok [a hal\'e1lukkor, azt mondv\'e1n]: \'84Ne f\'e9ljetek, \'e9s ne [is] szomorkodjatok, \'e9s fogadjatok \'f6r\'f6mh\'ed
rt a Paradicsomr\'f3l, amelyre \'edg\'e9retet kaptatok!
\par 31. Mi vagyunk a p\'e1rtfog\'f3itok az evil\'e1gi \'e9letben \'e9s a t\'falvil\'e1gon. \'c9s azt fogtok ott kapni, amit ti magatok megk\'edv\'e1ntok, \'e9s azt fogtok ott kapni, amit csak k\'e9rtek.}{\insrsid10757626\charrsid8812106 
\par {\*\bkmkstart 336}{\*\bkmkend 336}32. [A] Megbocs\'e1t\'f3t\'f3l \'e9s Megk\'f6ny\'f6r\'fcl\'f5t\'f5l sz\'e1rmaz\'f3 sz\'e1ll\'e1shely\'fcl.\'94}{\cs100\cf1\insrsid10757626\charrsid8812106 
\par 
\par 33. \'c9s ki az, aki szebb besz\'e9d\'fb ann\'e1l, [mint] aki Allahhoz h\'edv \'e9s j\'f3tetteket cselekszik \'e9s azt mondja: \'84Bizony, \'e9n azok k\'f6z\'e9 tartozom, akik al\'e1vetik magukat [Allahnak]!\'94
\par 34. \'c9s nem egyenl\'f5 a j\'f3tett a rossz tettel. H\'e1r\'edtsd el [a rosszat] azzal, ami jobb, \'e9s \'edme, az, aki k\'f6z\'f6tt \'e9s k\'f6zted ellens\'e9gess\'e9g volt, olyan [lesz] mintha egy k\'f6zeli bar\'e1t lenne!}{
\insrsid10757626\charrsid8812106 
\par 35. \'c9s ez nem adatik meg [m\'e1snak], csak azoknak, akik t\'fcrelmesek, \'e9s nem adatik meg [m\'e1snak], csak a hatalmas r\'e9szesed\'e9s birtokos\'e1nak [az evil\'e1gi \'e9s t\'falvil\'e1gi boldogs\'e1gb\'f3l].
\par 36. \'c9s ha gonosz sugallat sugalltatik neked a s\'e1t\'e1n r\'e9sz\'e9r\'f5l, akkor k\'e9rj mened\'e9ket Allaht\'f3l! Bizony, \'d5 Mindent Hall\'f3, Mindentud\'f3.
\par 
\par 37. Az \'d5 jelei k\'f6z\'e9 tartozik az \'e9jszaka \'e9s a nappal \'e9s a Nap \'e9s a Hold. Ne boruljatok le se a Nap el\'f5tt, se a Hold el\'f5tt! Boruljatok le Allah el\'f5tt, aki megteremtette ezeket, ha val\'f3ban \'d5t szolg\'e1lj\'e1tok!
\par {\*\bkmkstart 394}{\*\bkmkend 394}38. \'c9s ha fennh\'e9j\'e1znak, h\'e1t azok, akik a te Uradn\'e1l vannak (az angyalok) [f\'e1radhatatlanul] magasztalj\'e1k \'d5t \'e9jszaka \'e9s nappal, \'e9s \'f5k nem unnak bele.
\par 39. \'c9s az \'d5 jelei k\'f6z\'e9 tartozik az, hogy kisz\'e1radtnak l\'e1tod a f\'f6ldet. Amikor azonban vizet bocs\'e1tunk le r\'e1, megrezd\'fcl \'e9s n\'f6vekedik. Bizony, aki \'e9letre kelti azt, az \'e9letre kelti a halottakat [is]. Bizony, \'d5
 minden dologra kiterjed\'f5 hatalm\'fa.
\par 
\par 40. Bizony, akik gyal\'e1zattal illetik a jeleinket (a Kor\'e1nt), azok nincsenek rejtve el\'f5l\'fcnk. Vajon annak jobb-e, aki a Pokol t\'fcz\'e9be vettetik, vagy annak, aki a Felt\'e1mad\'e1s napj\'e1n biztons\'e1gban j\'f6n el\'f5? Cselekedj\'e9
tek azt, amit akartok! Bizony, \'d5 l\'e1tja [mindazt], amit cselekszetek.
\par 41. Bizony, akik nem hisznek az Eml\'e9keztet\'f5ben (a Kor\'e1nban), miut\'e1n az elj\'f6tt hozz\'e1juk [azok meg lesznek b\'fcntetve]. \'c9s bizony, ez egy M\'e9lt\'f3s\'e1gteljes \'cdr\'e1s!
\par 42. Nem f\'e9rhet hozz\'e1 hamiss\'e1g sem el\'f6lr\'f5l, sem h\'e1tulr\'f3l; [annak] lebocs\'e1t\'e1sa a B\'f6lcs \'e9s Dics\'e9retrem\'e9lt\'f3 [Allaht\'f3l van].
\par 43. [\'d3 Mohamed] nem mondanak neked [a hitetlenek] m\'e1st, mint amit m\'e1r teel\'f5tted mondtak a k\'fcld\'f6tteknek. Bizony, a te Urad a megbocs\'e1t\'e1s Birtokosa, \'e9s a f\'e1jdalmas b\'fcntet\'e9s Birtokosa.
\par 44. \'c9s ha nem-arab Kor\'e1nn\'e1 tett\'fck volna azt, akkor bizony azt mondan\'e1k: \'84Mi\'e9rt nem lettek a jelei r\'e9szletesen kifejtve?\'94 Hogyan lehetne [a Kor\'e1n nyelve] nem-arab, holott [a pr\'f3f\'e9ta nyelve] arab?\'94 Mondd: \'84
Ez azok sz\'e1m\'e1ra, akik hisznek, \'fatmutat\'e1s \'e9s gy\'f3gyul\'e1s. Akik azonban nem hisznek, azoknak s\'fckets\'e9g van a f\'fcl\'fckben, \'e9s az vaks\'e1g sz\'e1mukra. \'d5k [olyanok, mint] akiket t\'e1volr\'f3l sz\'f3l\'edtanak (de nem hallj
\'e1k azt, \'e9s nem is l\'e1tj\'e1k azt).
\par 
\par 45. \'c9s bizony odaadtuk M\'f3zesnek az \'cdr\'e1st (a T\'f3r\'e1t), majd [r\'f6gt\'f6n] \'f6sszek\'fcl\'f6nb\'f6ztek abban. \'c9s ha nem lett volna kor\'e1bban [a b\'fcntet\'e9s k\'e9sleltet\'e9s\'e9r\'f5l] egy sz\'f3 Uradt\'f3l, akkor bizony d\'f6nt
\'e9s hozatott volna k\'f6z\'f6tt\'fck. De bizony, \'f5k elbizonytalan\'edt\'f3 k\'e9ts\'e9gben vannak azzal kapcsolatban.
\par 46. Aki j\'f3tettet cselekszik, a maga haszn\'e1ra [teszi azt], aki pedig rosszat tesz, a maga k\'e1r\'e1ra [teszi azt]. \'c9s az Urad nem igazs\'e1gtalan a szolg\'e1kkal (a teremtm\'e9nyekkel).
\par 
\par 47. [\'d5 az,] akire tartozik az \'d3ra tud\'e1sa. \'c9s nem j\'f6n ki egyetlen term\'e9s sem a burk\'e1b\'f3l \'e9s egyetlen n\'f5st\'e9ny sem esik teherbe, vagy sz\'fcl an\'e9lk\'fcl, hogy \'d5 ne tudn\'e1. \'c9s azon a napon, amikor [\'edgy] sz\'f3l
\'edtja \'f5ket: \'84Hol vannak [azok, akikr\'f5l azt \'e1ll\'edtott\'e1tok, hogy] t\'e1rsistenek Mellettem?\'94, akkor azt mondj\'e1k: \'84Kijelentj\'fck neked, hogy nincs k\'f6z\'f6tt\'fcnk egyetlen tan\'fa sem [a t\'e1rsistens\'e9g\'fckre].\'94
\par 48. \'c9s elt\'fbntek t\'f5l\'fck azok, akikhez kor\'e1bban foh\'e1szkodtak. \'c9s [megbizonyosodva] v\'e9lt\'e9k, hogy nincs sz\'e1mukra menek\'fcl\'e9si hely.
\par 
\par 49. Az ember nem un bele abba, hogy [az evil\'e1gi] j\'f3\'e9rt foh\'e1szkodjon, \'e1m ha rossz \'e9ri, akkor k\'e9ts\'e9gbees\'f5 \'e9s rem\'e9nyvesztett.
\par 50. \'c9s ha meg\'edzleltetj\'fck vele a k\'f6ny\'f6r\'fclet\'fcnket az ut\'e1n, hogy baj \'e9rte \'f5t, bizonyosan azt mondja: \'84Ez megillet engem, \'e9s \'e9n nem v\'e9lem, hogy az \'d3ra (a Felt\'e1mad\'e1s) [be fog k\'f6vetkezni]. \'c9
s bizony, ha Uramhoz vitetek vissza, akkor bizony\'e1ra a legjobb [jutalomban] lesz r\'e9szem N\'e1la.\'94 Bizony, Mi h\'edr\'fcl adjuk azoknak, akik hitetlenn\'e9 v\'e1ltak, hogy mit cselekedtek \'e9s bizony s\'falyos gy\'f6trelmet \'edzleltet\'fc
nk meg vel\'fck.
\par 51. \'c9s amikor j\'f3t\'e9tem\'e9nyben r\'e9szes\'edtj\'fck az embert, az [h\'e1l\'e1tlanul] elfordul \'e9s [\'f6ntelten] oldalazva t\'e1vozik. \'c9s amikor rossz \'e9ri, akkor hosszasan foh\'e1szkodik.
\par 52. Mondd: \'84Vajon mit gondoltok? Ha ez [Kor\'e1n] val\'f3ban Allaht\'f3l van, \'e9s ti nem hisztek benne, [akkor k\'f6z\'f6lj\'e9tek velem,] ki t\'e9velyg\'f5bb ann\'e1l, mint aki messzemen\'f5 ellent\'e9tben van!\'94
\par }\pard\plain \s106\qj \li0\ri0\nowidctlpar\hyphpar0\aspalpha\aspnum\faroman\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1081\kerning1\loch\af172\hich\af172\dbch\af173\cgrid\langnp1038\langfenp1081 {
\f0\insrsid10757626\charrsid8812106 
\par \hich\af0\dbch\af173\loch\f0 \hich\f0 53. Meg fogjuk mutatni nekik a Jeleinket a horizontokon, \'e9\loch\f0 \hich\f0 s saj\'e1\loch\f0 \hich\f0 t magukban, am\'ed\loch\f0 \hich\f0 g nyilv\'e1\loch\f0 \hich\f0 nval\'f3\loch\f0 \hich\f0 v\'e1\loch\f0 
\hich\f0  nem v\'e1\loch\f0 \hich\f0 lik sz\'e1\loch\f0 \hich\f0 mukra, hogy az (a Kor\'e1\loch\f0 \hich\f0 n) az igazs\'e1\loch\f0 \hich\f0 g. H\'e1\loch\f0 \hich\f0 t nem elegend\'f5\loch\f0  Uraddal kap\hich\af0\dbch\af173\loch\f0 \hich\f0 
csolatban, hogy \'d5\loch\f0 \hich\f0  minden dolog felett tan\'fa\loch\f0 ?}{\lang1038\langfe1025\langfenp1025\insrsid10757626\charrsid8812106 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid8812106 54. L\'e1m, \'f5k bizony k\'e9ts\'e9
gben vannak az Urukkal val\'f3 tal\'e1lkoz\'e1suk fel\'f5l. L\'e1m, \'d5 bizony minden dolgot k\'f6r\'fclvesz [a tud\'e1s\'e1val].}{\insrsid10757626 
\par 
\par }\pard \qj \li0\ri0\nowidctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626 \page }{\b\lang1038\langfe1081\kerning1\dbch\af13\langfenp1081\insrsid10757626\charrsid13065856 
\hich\af0\dbch\af13\loch\f0 \hich\f0 42. A Tan\'e1\loch\f0 \hich\f0 cskoz\'e1\loch\f0 \hich\f0 s (as-S\'fa\loch\f0 \hich\f0 ra) c. sz\'fa\loch\f0 ra}{\b\insrsid10757626\charrsid3236878 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben
{\*\bkmkstart 31411}{\*\bkmkend 31411}.
\par 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626 1. H\'e1-M\'edm.
\par }{\insrsid10757626\charrsid1144975 2. Ain-Sz\'edn-K\'e1f.
\par 3. Ekk\'e9ppen sugallja a M\'e9lt\'f3s\'e1gteljes \'e9s a B\'f6lcs Allah [a kinyilatkoztat\'e1st] neked [\'f3 Mohamed], \'e9s azoknak [is \'edgy sugallta], akik el\'f5tted [\'e9ltek].
\par 4. \'d6v\'e9 mindaz, ami az egekben \'e9s ami a f\'f6ld\'f6n van, \'e9s \'d5 a Magass\'e1gos, a Hatalmas.
\par 5. Csaknem sz\'e9trepednek az egek egym\'e1s felett, \'e9s az angyalok magasztalj\'e1k Urukat az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, \'e9s megbocs\'e1t\'e1st k\'e9rnek azok sz\'e1m\'e1ra, akik a F\'f6ld\'f6n vannak. L\'e1
m, bizony Allah az, aki a Megbocs\'e1t\'f3, a K\'f6ny\'f6r\'fcletes.
\par 6. \'c9s akik \'d5helyette m\'e1s p\'e1rtfog\'f3t tesznek meg maguknak, azok felett Allah [az] \'f5rz\'f5, \'e9s te nem vagy a v\'e9delmez\'f5j\'fck.
\par 
\par 7. \'c9s ekk\'e9ppen sugalltunk neked egy arab nyelv\'fb Kor\'e1nt, hogy figyelmeztesd vele a telep\'fcl\'e9sek anyav\'e1ros\'e1t (Mekk\'e1t), \'e9s azokat, akik k\'f6r\'fcl\'f6tte \'e9lnek, \'e9s hogy figyelmeztess a Gy\'fclekez\'e9s napj\'e1
ra, amelyhez k\'e9ts\'e9g nem f\'e9rhet. Egy r\'e9sz\'fck a Paradicsomban lesz, egy m\'e1sik r\'e9sz\'fck}{\insrsid10757626  pedig a L\'e1ngol\'f3 [Pokol-t\'fbzben].}{\insrsid10757626\charrsid1144975 
\par 8. \'c9s ha Allah \'fagy akarta volna, akkor egyetlen k\'f6z\'f6ss\'e9gg\'e9 tette volna \'f5ket, \'e1m \'d5 azt bocs\'e1t be a k\'f6ny\'f6r\'fclet\'e9be, akit akar. Az igazs\'e1gtalanoknak pedig nem lesz sem p\'e1rtfog\'f3juk, sem seg\'edt\'f5j\'fck.

\par 9. Vagy tal\'e1n Rajta k\'edv\'fcl m\'e1s p\'e1rtfog\'f3kat tettek meg maguknak? \'c1m Allah az, aki [egyed\'fcli] P\'e1rtfog\'f3, \'e9s \'d5 kelti \'e9letre a halottakat, \'e9s \'d5 mindenre kiterjed\'f5 hatalm\'fa.
\par 10. \'c9s ha valamivel kapcsolatban n\'e9zetelt\'e9r\'e9s van k\'f6z\'f6ttetek, annak eld\'f6nt\'e9se Allahra tartozik. \'cdme, \'d5 Allah, az \'e9n Uram! \'d5r\'e1 hagyatkozom \'e9s Hozz\'e1 t\'e9rek vissza megb\'e1n\'e1ssal.
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid1144975 11. [Allah] az egek \'e9s a f\'f6ld L\'e9trehoz\'f3
ja. Saj\'e1t magatokb\'f3l teremtett nektek h\'e1zast\'e1rsakat, \'e9s a j\'f3sz\'e1gokb\'f3l is [l\'e9trehozott] p\'e1rokat. Megsokas\'edt titeket ez\'e1ltal. Nincs semmi, ami Hozz\'e1 hasonl\'f3 lenne, \'e9s \'d5 a mindent Hall\'f3, a mindent L\'e1t\'f3
.
\par 12. \'d6v\'e9 az egek \'e9s a f\'f6ld kulcsai. Kiterjeszti az ell\'e1t\'e1s\'e1t annak, akinek akarja, \'e9s sz\'fbk\'f6ss\'e9 teszi [m\'e1soknak]. Bizony, \'d5 minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 
\par 13. [Allah] azt rendelte el nektek a vall\'e1s ter\'e9n, amit meghagyott No\'e9nak, \'e9s amit [kinyilatkoztat\'e1sk\'e9nt] sugalltunk neked [\'f3 Mohamed], \'e9s amit meghagytunk \'c1brah\'e1mnak, M\'f3zesnek \'e9s J\'e9zusnak: \'84Tarts\'e1tok be a vall
\'e1s [el\'f5\'edr\'e1sait] \'e9s ne szakadjatok sz\'e9t [csoportokra] azt illet\'f5en!\'94 Neh\'e9z az [Allah mell\'e9] t\'e1rsisteneket \'e1ll\'edt\'f3k sz\'e1m\'e1ra az, amire h\'edvod \'f5ket. Allah azt v\'e1lasztja ki Mag\'e1nak [k\'fcld\'f6ttek\'e9
nt], akit akar, \'e9s azt vezeti Mag\'e1hoz, aki b\'fbnb\'e1nattal t\'e9r vissza [Hozz\'e1].
\par 14. \'c9s nem szakadtak sz\'e9t [k\'fcl\'f6nb\'f6z\'f5 csoportokra az Allah mell\'e9 t\'e1rsistent \'e1ll\'edt\'f3k] csak azut\'e1n, hogy elj\'f6tt hozz\'e1juk a tud\'e1s, az egym\'e1s ir\'e1nti irigys\'e9g miatt. \'c9s ha nem lett volna kor\'e1bban [a b
\'fcntet\'e9s k\'e9sleltet\'e9s\'e9r\'f5l] egy sz\'f3 Uradt\'f3l, akkor bizony d\'f6nt\'e9s hozatott volna k\'f6z\'f6tt\'fck. \'c9s bizony azok, akik ut\'e1nuk \'f6r\'f6k\'fcl kapt\'e1k az \'cdr\'e1st (a T\'f3r\'e1t \'e9s az Evang\'e9
liumot), elbizonytalan\'edt\'f3 k\'e9ts\'e9gben vannak azzal kapcsolatban.
\par 15. Ehhez [a vall\'e1shoz] h\'edvj h\'e1t [\'f3 Mohamed], \'e9s j\'e1rj az Egyenes \'faton, mik\'e9nt arra parancsot kapt\'e1l, \'e9s ne k\'f6vesd az \'f5 k\'e9ny\'fcket! \'c9s mondd: \'84Hiszek [mind]abban, amit Allah lebocs\'e1tott az \'cdr\'e1sok k\'f6
z\'fcl. \'c9s parancsot kaptam arra, hogy igazs\'e1got tegyek k\'f6ztetek. Allah a mi Urunk \'e9s a ti Uratok. A mi cselekedeteink [felel\'f5ss\'e9ge] a mi\'e9nk, \'e9s a ti cselekedeteitek [felel\'f5ss\'e9ge] pedig a ti\'e9tek. Nincs helye vit\'e1nak k
\'f6zt\'fcnk \'e9s k\'f6ztetek! Allah \'f6sszegy\'fbjt majd minket. \'c9s Hozz\'e1 lesz a v\'e9gc\'e9l.\'94
\par 
\par 16. De akik \'e9rvelve sz\'e1llnak vit\'e1ba Allahr\'f3l, miut\'e1n m\'e1r hallgattak R\'e1 [\'e9s aszerint cselekedtek], azoknak megc\'e1foltatott (\'e9rv\'e9nytelen) az \'e9rvel\'e9se Uruk el\'f5tt, \'e9s [Allah] haragv\'e1sa s\'fajtja \'f5ket, \'e9
s nekik szigor\'fa gy\'f6trelem j\'e1r.
\par {\*\bkmkstart 187}{\*\bkmkend 187}17. Allah az, aki lebocs\'e1totta az \'cdr\'e1st az Igazs\'e1ggal \'e9s az [igazs\'e1gos] M\'e9rleggel. \'c9s mi tudathatn\'e1 veled, lehet, hogy az \'d3ra m\'e1r k\'f6zel van?!
\par 18. Siettetn\'e9k [a bek\'f6vetkez\'e9s\'e9t] azok, akik nem hisznek benne, \'e1m akik hisznek, azok meg vannak r\'e9m\'fclve t\'f5le \'e9s tudj\'e1k, hogy az az igazs\'e1g. L\'e1m, bizony, akik k\'e9telkednek az \'d3r\'e1ban, azok az igaz \'fatt\'f3
l messze j\'e1r\'f3 t\'e9velyg\'e9sben vannak.
\par 19. Allah K\'edm\'e9letes a szolg\'e1ihoz. Annak ad ell\'e1t\'e1st, akinek akar, \'e9s \'d5 az Er\'f5s, a M\'e9lt\'f3s\'e1gteljes.
\par 
\par 20. Aki a t\'falvil\'e1g term\'e9s\'e9t (jutalm\'e1t) akarja [tetteivel el\'e9rni], annak gyarap\'edtjuk a term\'e9s\'e9t (tettei jutalm\'e1t). Aki azonban az evil\'e1g term\'e9s\'e9t akarja [el\'e9rni tetteivel], annak adunk abb\'f3l, de a t\'falvil\'e1
gon nem lesz r\'e9szesed\'e9se [a jutalomb\'f3l].
\par 21. Vagy vannak nekik t\'e1rsisteneik [Allah mellett], akik olyat rendeltek el nekik a vall\'e1s ter\'e9n, amire Allah nem adott enged\'e9lyt? \'c9s ha nem hangzott volna el [Allaht\'f3l] a d\'f6nt\'e9s szava [a b\'fcntet\'e9s idej\'e9r\'f5l], akkor m\'e1
r \'edt\'e9let hozatott volna k\'f6z\'f6tt\'fck. \'c9s bizony az igazs\'e1gtalanoknak f\'e1jdalmas gy\'f6trelem j\'e1r.
\par 22. L\'e1thatod majd, amint az igazs\'e1gtalanok megr\'e9m\'fclnek att\'f3l [a b\'fcntet\'e9st\'f5l], amit szereztek [tetteik \'e1ltal], amikor az les\'fajt r\'e1juk. Akik azonban hisznek \'e9s j\'f3
tetteket cselekszenek, azok a [Paradicsom] Kertjeiben [vir\'e1gz\'f3] r\'e9teken lesznek, \'e9s az j\'e1r nekik Urukn\'e1l, amit csak akarnak. Ez a nagy kegy.
\par 
\par 23. Ez az, amit \'f6r\'f6mh\'edr\'fcl ad Allah [azoknak] a szolg\'e1inak, akik hisznek \'e9s j\'f3tetteket cselekszenek. Mondd [\'f3 Mohamed]: \'84Nem k\'e9rek ez\'e9rt fizets\'e9get t\'f5letek, csup\'e1n azt a szeretetet, ami [szok\'e1sos] a rokonok k
\'f6z\'f6tt.\'94 \'c9s aki j\'f3t cselekszik, azt m\'e9g t\'f6bb j\'f3s\'e1ggal gyarap\'edtjuk. Bizony, Allah Megbocs\'e1t\'f3, H\'e1l\'e1s.
\par 24. Vagy pedig azt mondj\'e1k: \'84Hazugs\'e1got tal\'e1lt ki Allah ellen.\'94 Ha Allah \'fagy akarja, lepecs\'e9teli a sz\'edvedet. Allah azonban elt\'f6rli a hamiss\'e1got \'e9s val\'f3ra v\'e1ltja az Igazs\'e1got a szavai \'e1ltal. Bizony, Neki tudom
\'e1sa van arr\'f3l, amit a keblek rejtenek.
\par 25. \'c9s \'d5 az, aki elfogadja szolg\'e1it\'f3l a b\'fbnb\'e1natot \'e9s eln\'e9zi a rossz tetteket, \'e9s tudom\'e1sa van arr\'f3l, mit tesztek.
\par 26. \'c9s hallgatnak Re\'e1 azok, akik hisznek \'e9s j\'f3tetteket cselekszenek, \'d5 pedig gyarap\'edtja \'f5ket [jutalomban] az \'d5 kegy\'e9b\'f5l. \'c9s a hitetleneknek szigor\'fa gy\'f6trelem j\'e1r.
\par 
\par 27. \'c9s ha Allah kiterjeszten\'e9 az ell\'e1t\'e1st a szolg\'e1inak, akkor zsarnoks\'e1got k\'f6vetn\'e9nek el a f\'f6ld\'f6n. \'c1m \'d5 m\'e9rt\'e9kkel bocs\'e1tja le [az ell\'e1t\'e1sb\'f3l], amit csak akar. Bizony, \'d5 j\'f3l ismeri \'e9s \'e1tl
\'e1tja a szolg\'e1it.
\par 28. \'c9s \'d5 az, aki lebocs\'e1tja a z\'e1pores\'f5t, miut\'e1n [az emberek] m\'e1r elvesztett\'e9k a rem\'e9nyt, \'e9s kiterjeszti az \'d5 k\'f6ny\'f6r\'fclet\'e9t. \'d5 a P\'e1rtfog\'f3, a Dics\'e9retrem\'e9lt\'f3.
\par 29. \'c9s az \'d5 jelei k\'f6z\'e9 tartozik az egek \'e9s a f\'f6ld teremt\'e9se, \'e9s mindazon mozg\'f3 [\'e9l\'f5l\'e9ny teremt\'e9se], amelyet sz\'e9tsz\'f3rt mindkett\'f5ben. \'c9s hatalm\'e1ban \'e1ll \'f6sszegy\'fbjteni \'f5ket, amikor csak akarja.

\par 30. \'c9s b\'e1rmi csap\'e1s \'e9r titeket, h\'e1t [az] amiatt [t\'f6rt\'e9nik], amit a kezetek elk\'f6vetett, de [Allah] sok mindent eln\'e9z.
\par 31. \'c9s ti nem fogj\'e1tok [semmiben] megakad\'e1lyozni [Allahot] a f\'f6ld\'f6n, \'e9s nincs nektek Allah helyett p\'e1rtfog\'f3tok, sem seg\'edt\'f5t\'f6k.
\par 
\par 32. \'c9s az \'d5 jelei k\'f6z\'e9 tartoznak a tengeren sietve halad\'f3 haj\'f3k, amelyek hegyekhez hasonl\'f3ak.
\par 33. Ha akarja, lecsendes\'edti a szeleket \'e9s akkor mozdulatlanok maradnak a [tenger] sz\'edn\'e9n. Bizony, jelek vannak ebben mindenki sz\'e1m\'e1ra, aki [mindig] t\'fcrelmes \'e9s h\'e1l\'e1s.
\par 34. Vagy els\'fcllyeszti azokat az\'e9rt, amit \'f5k elk\'f6vettek, de [Allah] sok mindent eln\'e9z.
\par 35. \'c9s tudni fogj\'e1k azok, akik vit\'e1ba sz\'e1llnak a Mi jeleinkr\'f5l, hogy nincs sz\'e1mukra menek\'fcl\'e9si hely.
\par 36. \'c9s b\'e1rmi adatott nektek, az csup\'e1n az evil\'e1gi \'e9let [muland\'f3] \'e9lvezete. \'c1m ami Allahn\'e1l van, az jobb \'e9s maradand\'f3bb azoknak, akik hisznek \'e9s Urukra hagyatkoznak,
\par 
\par 37. \'c9s akik elker\'fclik a legnagyobb b\'fbn\'f6ket \'e9s a f\'f6rtelmess\'e9geket, \'e9s amikor megharagszanak, akkor \'f5k megbocs\'e1tanak,
\par 38. \'c9s akik hallgatnak Urukra, \'e9s megtartj\'e1k az im\'e1dkoz\'e1st, \'e9s \'fcgyeik egym\'e1s k\'f6z\'f6tti tan\'e1cskoz\'e1s [\'e1ltal ker\'fclnek eld\'f6nt\'e9sre], \'e9s adakoznak abb\'f3l, amivel ell\'e1ttuk \'f5ket,
\par 39. \'c9s akik seg\'edtenek magukon (megv\'e9dik magukat), ha zsarnoks\'e1g s\'fajtja \'f5ket.
\par 40. Egy rossz tett fizets\'e9ge egy hozz\'e1 hasonl\'f3 rossz tett. Aki azonban eln\'e9z (megbocs\'e1t), \'e9s kib\'e9k\'edt, annak a jutalma Allahn\'e1l van. Bizony, \'d5 nem szereti az igazs\'e1gtalanokat.
\par 41. \'c9s akik saj\'e1t maguk v\'e9delm\'e9re kelnek, miut\'e1n igazs\'e1gtalans\'e1g [\'e9rte \'f5ket], azokkal szemben nincs m\'f3d [a sz\'e1monk\'e9r\'e9sre].
\par 42. Csak azokkal szemben van m\'f3d [a sz\'e1monk\'e9r\'e9sre] akik igazs\'e1gtalans\'e1got k\'f6vetnek el az emberek ellen \'e9s jogtalanul zsarnokoskodnak a f\'f6ld\'f6n. Azoknak f\'e1jdalmas b\'fcntet\'e9s j\'e1r.
\par 43. Ha valaki t\'fcrelmet tan\'fas\'edt \'e9s megbocs\'e1t, nos bizony, ezek az elsz\'e1nts\'e1got [k\'f6vetel\'f5] dolgok k\'f6z\'e9 tartoznak.
\par 
\par 44. \'c9s akit Allah t\'e9velyg\'e9sbe visz, annak nem lesz p\'e1rtfog\'f3ja, azut\'e1n [hogy Allah mag\'e1ra hagyta]. \'c9s l\'e1thatod majd, amint az igazs\'e1gtalanok azt mondj\'e1k, amikor a b\'fcntet\'e9st megl\'e1tj\'e1k: \'84Vajon van-e [sz\'e1
munkra] m\'f3d a visszat\'e9r\'e9sre [az evil\'e1gba]?\'94
\par 45. \'c9s l\'e1thatod \'f5ket, amint a [Pokol-t\'fbz] el\'e9 \'e1ll\'edttatnak, les\'fajtva a megal\'e1zotts\'e1gt\'f3l, mik\'f6zben a szem\'fck sark\'e1b\'f3l n\'e9zik [azt]. \'c9s azok, akik hisznek, azt mondj\'e1k: \'84
Bizony, azok a vesztesek, akik elvesz\'edtik (k\'e1rhozatba tasz\'edtj\'e1k) magukat \'e9s a csal\'e1djukat a Felt\'e1mad\'e1s Napj\'e1n.\'94 L\'e1m bizony, az igazs\'e1gtalanok \'e1lland\'f3 gy\'f6trelemben lesznek.
\par 46. \'c9s nem lesznek p\'e1rtfog\'f3ik, akik Allahon k\'edv\'fcl seg\'edten\'e9k \'f5ket. \'c9s akit Allah t\'e9velyg\'e9sbe visz, annak a sz\'e1m\'e1ra nincs m\'f3d [eljutni az igazs\'e1gra, \'e9s bejutni a Paradicsomba].
\par 
\par 47. Hallgassatok az Uratokra, miel\'f5tt elj\'f6n egy olyan nap, amelyet Allah nem fog elh\'e1r\'edtani! Azon a napon nem lesz sz\'e1motokra mened\'e9khely, \'e9s nem lesz sz\'e1motokra [m\'f3d] a tagad\'e1sra.
\par 48. \'c9s [ne legy\'e9l szomor\'fa amiatt,] ha elfordulnak, [mert] nem az\'e9rt k\'fcldt\'fcnk el t\'e9ged [\'f3 Mohamed], hogy \'f5rz\'f5j\'fck legy\'e9l! A te feladatod csup\'e1n az [\'fczenet-]\'e1tad\'e1s. \'c9s bizony, amikor T\'f5l\'fcnk sz\'e1rmaz
\'f3 k\'f6ny\'f6r\'fcletet \'edzleltet\'fcnk meg az emberrel, akkor \'f6rvendezik annak. Ha azonban valami rossz s\'fajtja \'f5ket az\'e9rt, amit a kez\'fck elk\'f6vetett, akkor bizony az ember h\'e1l\'e1tlan.
\par 49. Allah\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett. Azt teremt, amit akar. L\'e1nygyermeket aj\'e1nd\'e9koz annak, akinek akar, \'e9s fi\'fagyermeket aj\'e1nd\'e9koz annak, akinek akar,
\par 50. Vagy k\'fcl\'f6nb\'f6z\'f5 nem\'fb, gyermekeket, fi\'fakat \'e9s l\'e1nyokat aj\'e1nd\'e9koz, \'e9s medd\'f5v\'e9 teszi azt, akit akar. Bizony, \'d5 Mindentud\'f3, Mindenhat\'f3.
\par 
\par 51. \'c9s lehetetlen egy embernek, hogy Allah besz\'e9ljen vele, csakis sugallat \'e1ltal, vagy f\'fcgg\'f6ny m\'f6g\'fcl, vagy \'fagy, hogy k\'fcld\'f6ttet (angyalt) k\'fcld, aki [a kinyilatkoztat\'e1st \'e1tadva] sugallja neki, az \'d5 engedelm\'e9
vel azt, amit \'d5 akar. Bizony, \'d5 Magass\'e1gos, B\'f6lcs.
\par 52. \'c9s ekk\'e9ppen sugalltunk neked egy lelket (a Kor\'e1nt) a mi parancsunkb\'f3l. [Ezel\'f5tt] nem volt ismereted arr\'f3l, hogy mi az \'cdr\'e1s, sem arr\'f3l, hogy mi a hit. De f\'e9nny\'e9 tett\'fck azt (a Kor\'e1nt), amivel szolg\'e1ink k\'f6z
\'fcl azt vezetj\'fck az igaz \'fatra, akit akarunk. \'c9s bizony, te [\'f3 Mohamed] az Egyenes \'datra vezetsz!
\par 53. Allah \'fatj\'e1ra, aki\'e9 mindaz, ami az egekben \'e9s ami a f\'f6ld\'f6n van. L\'e1m, Allahhoz t\'e9rnek vissza az \'fcgyek [elsz\'e1moltat\'e1sra].}{\insrsid10757626 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626 
\par \line 
\par }\pard\plain \qj \li0\ri0\nowidctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626 \page }{
\b\lang1038\langfe1081\kerning1\dbch\af13\langfenp1081\insrsid10757626\charrsid13065856 \hich\af0\dbch\af13\loch\f0 43. Az \loch\af0\dbch\af13\hich\f0 \'e9\loch\f0 \hich\f0 kess\'e9\loch\f0 gek (az-}{
\b\lang1038\langfe1081\kerning1\dbch\af13\langfenp1081\insrsid10757626\charrsid5130710 \hich\af0\dbch\af13\loch\f0 \hich\f0 Zukhruf) c. sz\'fa\loch\f0 ra}{\b\insrsid10757626\charrsid5130710  
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid5130710 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid5130710 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev
\'e9ben.
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid5130710 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid5130710 1. H\'e1-M\'edm.{\*\bkmkstart 214}{\*\bkmkend 214}

\par 2. A nyilv\'e1nval\'f3 \'cdr\'e1sra!{\*\bkmkstart 312}{\*\bkmkend 312} 
\par 3. Bizony, Mi arab [nyelv\'fb] Kor\'e1nn\'e1 tett\'fck azt, h\'e1tha \'e9ltek az eszetekkel.
\par 4. \'c9s bizony, ez (a Kor\'e1n) az \'d5s\'edr\'e1sban van N\'e1lunk, [\'e9s] bizony [az] magasztos, [\'e9s] b\'f6lcs.
\par 5. Vajon forduljunk el t\'f5letek, felhagyv\'e1n az Eml\'e9keztet\'f5 (a Kor\'e1n) [lebocs\'e1t\'e1s\'e1val amiatt], hogy ti egy m\'e9rt\'e9ktelen n\'e9p vagytok?
\par 6. \'c9s h\'e1ny pr\'f3f\'e9t\'e1t k\'fcldt\'fcnk [m\'e1r] a hajdanvoltakhoz!
\par 7. \'c9s egyetlen pr\'f3f\'e9ta sem j\'f6tt el hozz\'e1juk an\'e9lk\'fcl, hogy ne \'fbztek volna g\'fanyt bel\'f5le.
\par 8. Mi pedig olyan [n\'e9peket] puszt\'edtottunk el, amelyek er\'f5sebbek voltak \'f5n\'e1luk [az ellens\'e9g] megragad\'e1s\'e1t illet\'f5en. \'c9s elm\'falt m\'e1r a hajdanvoltak p\'e9ld\'e1ja.
\par 
\par 9. \'c9s ha megk\'e9rdezn\'e9d \'f5ket, hogy ki teremtette az egeket \'e9s a f\'f6ldet, bizonyosan azt mondj\'e1k: \'84A M\'e9lt\'f3s\'e1gteljes \'e9s Mindentud\'f3 teremtette azokat.\'94
\par 10. [\'d5 az,] aki a f\'f6ldet egyengetett\'e9 tette sz\'e1motokra, \'e9s utakat helyezett el nektek rajta, h\'e1tha  \'fatra leltek [az utaz\'e1sotok sor\'e1n].
\par 11. \'c9s [\'d5 az,] aki az \'e9gb\'f5l vizet bocs\'e1tott le [megszabott] m\'e9rt\'e9kkel, \'e9s felt\'e1masztottuk \'e1ltala a halott helys\'e9get. Ekk\'e9ppen lesztek [majd] el\'f5hozatva [a s\'edrotokb\'f3l].
\par 12. \'c9s [\'d5 az,] aki megteremtette az \'f6sszes p\'e1rt, \'e9s haj\'f3kat \'e9s j\'f3sz\'e1gokat adott nektek, amelyeken utazhattok,
\par 13. Hogy elhelyezkedhessetek a h\'e1tukon, azt\'e1n megeml\'e9kezhessetek Uratok kegy\'e9r\'f5l, amikor elhelyezkedtek rajtuk, \'e9s mondj\'e1tok [azt, hogy]: \'84Magasztaltass\'e9k az, aki szolg\'e1latunkra rendelte ezt. \'c9s mi k\'e9ptelenek lett\'fc
nk volna erre.
\par 14. \'c9s bizony, mi az Urunkhoz t\'e9r\'fcnk vissza.\'94
\par 
\par 15. \'c9s [a hitetlenek] Neki tulajdon\'edtott\'e1k [lesz\'e1rmazottaik\'e9nt] a szolg\'e1inak egy r\'e9sz\'e9t. Bizony, az ember nyilv\'e1nval\'f3an h\'e1l\'e1tlan.
\par 16. Vajon [Allah] le\'e1nygyermekeket tett meg mag\'e1nak abb\'f3l, amit teremt, titeket pedig fi\'fagyermekekkel t\'fcntetett ki?
\par 17. \'c9s amikor valamelyik\'fcknek [le\'e1nygyermek sz\'fclet\'e9s\'e9r\'f5l] adnak \'f6r\'f6mh\'edrt - olyasvalakir\'f5l, akit a K\'f6ny\'f6r\'fcletesnek tulajdon\'edtott - az arca els\'f6t\'e9t\'fclve marad, mik\'f6zben leplezi [a b\'e1nat\'e1t].

\par 18. Vajon h\'e1t olyasvalakit [tulajdon\'edtanak Neki] aki \'e9kszerek k\'f6z\'f6tt neveltetik \'e9s aki a vita [hev\'e9ben] nem tudja mag\'e1t vil\'e1gosan kifejezni?
\par 19. \'c9s az angyalokat, akik a K\'f6ny\'f6r\'fcletes szolg\'e1i, n\'f5nem\'fbekk\'e9 tett\'e9k meg. Vajon tan\'fai voltak a teremt\'e9s\'fcknek? A tan\'favallom\'e1suk fel lesz jegyezve \'e9s k\'e9rd\'f5re lesznek vonva [a Felt\'e1mad\'e1s napj\'e1n].

\par 20. \'c9s azt mondj\'e1k: \'84Ha a K\'f6ny\'f6r\'fcletes \'fagy akarta volna, nem szolg\'e1ltuk volna \'f5ket.\'94 Nincs nekik arr\'f3l tud\'e1suk. \'d5k csup\'e1n tal\'e1lgatnak.
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid5130710 21. Vagy \'cdr\'e1st adtunk nekik azel\'f5
tt [a Kor\'e1n el\'f5tt], \'e9s amihez \'f5k ragaszkodnak?
\par 22. De nem! Azt mondj\'e1k: \'84Bizony, Mi aty\'e1inkat egy k\'f6z\'f6ss\'e9g [szab\'e1lyait k\'f6vetve] tal\'e1ltuk, \'e9s bizony mi az \'f5 nyomdokaikban j\'e1rva lel\'fcnk az [igaz] \'fatra.\'94
\par 23. \'c9s ekk\'e9ppen [volt]. Nem k\'fcldt\'fcnk teel\'f5tted egy v\'e1rosba sem figyelmeztet\'f5t an\'e9lk\'fcl, hogy annak j\'f3l\'e9tben d\'fask\'e1l\'f3i ne mondt\'e1k volna azt: \'84Bizony, mi aty\'e1inkat egy k\'f6z\'f6ss\'e9g [szab\'e1lyait k\'f6
vetve] tal\'e1ltuk, \'e9s bizony mi az \'f5 nyomdokaikban j\'e1runk.\'94
\par 24. Azt mondta [az egyik figyelmeztet\'f5]: \'84M\'e9g akkor is, ha jobb \'fatmutat\'e1ssal j\'f6ttem hozz\'e1tok, mint amiben aty\'e1itokat tal\'e1lt\'e1tok?\'94 Azt mondt\'e1k: \'84Bizony, mi nem hisz\'fcnk abban, amivel el lettetek k\'fcldve.\'94

\par 25. Mi pedig el\'e9gt\'e9telt vett\'fcnk rajtuk. \'c9s n\'e9zd meg, milyen v\'e9gre jutottak azok, akik meghazudtolt\'e1k [a k\'fcld\'f6tteket]!
\par 
\par 26. \'c9s [eml\'edtsd meg azt], amikor \'c1brah\'e1m azt mondta az apj\'e1nak \'e9s a n\'e9p\'e9nek: \'84Bizony, \'e9n elhat\'e1rolom magamat att\'f3l, amit im\'e1dtok,
\par 27. Kiv\'e9ve azt, aki l\'e9trehozott engem, \'e9s bizony \'d5 fogja nekem megmutatni [az igaz] utat.\'94
\par 28. \'c9s maradand\'f3 sz\'f3v\'e1 tette ezt (az egyistenhit megvall\'e1s\'e1t) az ut\'f3dai k\'f6zt, h\'e1tha visszat\'e9rnek [ehhez].
\par 
\par 29. De nem! [Annak ellen\'e9re, hogy nem t\'e9rtek vissza,] \'e9lvezetekben r\'e9szes\'edtettem \'f5ket \'e9s aty\'e1ikat, m\'edg el nem j\'f6tt hozz\'e1juk az igazs\'e1g (a Kor\'e1n) \'e9s egy nyilv\'e1nval\'f3 k\'fcld\'f6tt.
\par 30. \'c9s amikor elj\'f6tt hozz\'e1juk az igazs\'e1g (a Kor\'e1n), azt mondt\'e1k: \'84Ez var\'e1zslat, \'e9s mi bizony nem hisz\'fcnk benne.\'94
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid5130710 31. \'c9s azt mondt\'e1k: \'84Mi\'e9rt nem bocs\'e1
ttatott le a Kor\'e1n egy hatalmas [rang\'fa] emberre a k\'e9t v\'e1ros [egyik\'e9b\'f5l]?\'94
\par 32. Vajon \'f5k osztj\'e1k el Urad k\'f6ny\'f6r\'fclet\'e9t? Mi osztottuk el k\'f6z\'f6tt\'fck a meg\'e9lhet\'e9s\'fcket az evil\'e1gi \'e9letben, \'e9s emelt\'fcnk egyeseket k\'f6z\'fcl\'fck a t\'f6bbiek f\'f6l\'e9 fokozatokkal, hogy n\'e9h\'e1nyan k\'f6
z\'fcl\'fck szolg\'e1latukba fogadjanak m\'e1sokat. \'c1m Urad k\'f6ny\'f6r\'fclete jobb, mint amit \'f6sszegy\'fbjtenek.
\par 33. \'c9s ha nem lenne az, hogy az emberek [a cs\'e1b\'edt\'f3 f\'f6ldi javak miatt] egyetlen k\'f6z\'f6ss\'e9gg\'e9 v\'e1ln\'e1nak [a hitetlens\'e9g k\'f6r\'e9 gy\'fblve], akkor azoknak, akik nem hisznek a K\'f6ny\'f6r\'fcletesben, ez\'fcst tet\'f5
ket adtunk volna a h\'e1zaikhoz \'e9s l\'e9pcs\'f5ket, amelyeken felmennek,
\par 34. \'c9s h\'e1zaikhoz [ez\'fcst] kapukat, \'e9s \'e1gyakat, amelyekre d\'f5lve fekszenek,
\par 35. \'c9s [tov\'e1bbi] \'e9kess\'e9geket. \'c1m mindez csup\'e1n az evil\'e1gi \'e9let [muland\'f3] \'e9lvezete, \'e9s a t\'falvil\'e1g [\'f6r\'f6mei] az Uradn\'e1l az istenf\'e9l\'f5knek [vannak fenntartva].
\par 
\par 36. \'c9s aki elfordul a K\'f6ny\'f6r\'fcletesr\'f5l val\'f3 megeml\'e9kez\'e9st\'f5l, amell\'e9 egy s\'e1t\'e1nt rendel\'fcnk, aki az \'f5 k\'eds\'e9r\'f5je lesz.
\par 37. \'c9s bizony, \'f5k (a s\'e1t\'e1nok) t\'e1vol tartj\'e1k \'f5ket az [igaz] \'fatt\'f3l, \'e9s [k\'f6zben] azt gondolj\'e1k, hogy az [igaz] \'fatra leltek.
\par 38. Amikor azt\'e1n elj\'f6n Hozz\'e1nk, azt mondja [a s\'e1t\'e1nnak]: \'84B\'e1rcsak akkora [t\'e1vols\'e1g] lenne k\'f6z\'f6ttem \'e9s k\'f6z\'f6tted}{\insrsid10757626 ,}{\insrsid10757626\charrsid5130710  mint a Napkelet \'e9s a Napnyugat k\'f6z\'f6
tti t\'e1vols\'e1g! Milyen nyomor\'fas\'e1gos k\'eds\'e9r\'f5!\'94
\par 39. \'c9s nem fog haszn\'e1lni nektek azon a napon \endash  miut\'e1n igazs\'e1gtalans\'e1got k\'f6vettetek el \endash  az, hogy k\'f6z\'f6sen fogtok r\'e9szes\'fclni a gy\'f6trelemben.
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid5130710 
\par 40. Vajon te [\'f3 Mohamed] hall\'f3v\'e1 tudod-e tenni a s\'fcketeket, vagy [igaz] \'fatra [tudod-e] vezetni a vakokat, \'e9s azokat, akik nyilv\'e1nval\'f3 t\'e9velyg\'e9sben vannak?
\par 41. \'c9s m\'e9g ha el is visz\'fcnk t\'e9ged (a hal\'e1lba bocs\'e1tunk), bizony, mi akkor is el\'e9gt\'e9telt vesz\'fcnk rajtuk,
\par 42. Vagy ha megmutatjuk neked azt, amire [fenyeget\'e9sk\'e9ppen] \'edg\'e9retet tett\'fcnk nekik, mert bizony, Nek\'fcnk hatalmunk van felett\'fck.
\par 43. Ragaszkodj h\'e1t er\'f5sen ahhoz, ami sugalltatik neked [kinyilatkozt\'e1sk\'e9nt]! Bizony, te az egyenes \'faton j\'e1rsz!
\par 44. \'c9s bizony ez [a Kor\'e1n] eml\'e9keztet\'e9s (int\'e9s \'e9s tekint\'e9ly) sz\'e1modra \'e9s a n\'e9ped sz\'e1m\'e1ra, \'e9s meg lesztek k\'e9rdezve.
\par 45. \'c9s k\'e9rdezd meg azokat, akiket teel\'f5tted k\'fcldt\'fcnk el a k\'fcld\'f6tteink k\'f6z\'fcl! Vajon a K\'f6ny\'f6r\'fcletes helyett m\'e1s isteneket tett\'fcnk meg, [hogy azokat] szolg\'e1lj\'e1k?
\par 
\par 46. \'c9s bizony [}{\insrsid10757626\charrsid2439359 kor\'e1bban] elk\'fcldt\'fck M\'f3zest a jeleinkkel a F\'e1ra\'f3hoz \'e9s az el\'f5kel\'f5ihez, s azt mondta: \'84Bizony \'e9n a teremtm\'e9nyek Ur\'e1nak a k\'fcld\'f6tte vagyok.\'94
\par 47. \'c1m amikor elj\'f6tt hozz\'e1juk a jeleinkkel, \'edme, \'f5k kinevett\'e9k azokat.
\par 48. \'c9s egyetlen jelet sem mutattunk nekik an\'e9lk\'fcl, hogy az ne lett volna nagyobb a p\'e1rj\'e1n\'e1l (az el\'f5z\'f5n\'e9l). \'c9s elragadtuk \'f5ket a b\'fcntet\'e9ssel, h\'e1tha visszat\'e9rnek.
\par 49. \'c9s azt mondt\'e1k [M\'f3zesnek]: \'84\'d3 te var\'e1zsl\'f3! Foh\'e1szkodj \'e9rt\'fcnk az Uradhoz [hogy mentsen meg minket a b\'fcntet\'e9st\'f5l], mivel egyezs\'e9get k\'f6t\'f6tt veled! Bizony, mi r\'e1 fogunk lelni az [igaz] \'fatra.\'94
\par 50. \'c1m amikor elh\'e1r\'edtottuk r\'f3luk a b\'fcntet\'e9st, \'edme, [r\'f6gt\'f6n] megszegt\'e9k [az \'edg\'e9retet].
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid2439359 51. \'c9s a F\'e1ra\'f3 \'edgy sz\'f3l\'edtotta a n
\'e9p\'e9t azt mondva: \'84\'d3 n\'e9pem! Nem az eny\'e9m-e a kir\'e1lyi uralom Egyiptom f\'f6l\'f6tt, [\'e9s nem az eny\'e9mek-e] ezek a foly\'f3k, amelyek alattam folynak? H\'e1t vajon nem l\'e1ttok?
\par 52. Nem vagyok-e jobb ann\'e1l, aki megvetett \'e9s alig tudja mag\'e1t vil\'e1gosan kifejezni?
\par 53. H\'e1t mi\'e9rt nem adtak r\'e1 arany karpereceket, vagy j\'f6ttek el vele az angyalok k\'eds\'e9rv\'e9n [\'f5t]{\*\bkmkstart 542}{\*\bkmkend 542}?\'94 54. \'c9s k\'f6nnyelm\'fbs\'e9gre vette r\'e1 n\'e9p\'e9t, \'f5k pedig engedelmeskedtek neki. Bizo
ny \'f5k egy engedetlen n\'e9p voltak.
\par 55. Miut\'e1n haragv\'e1sunkat vont\'e1k magukra, el\'e9gt\'e9telt vett\'fcnk rajtuk \'e9s v\'edzbe fullasztottuk \'f5ket, mindannyiukat.
\par 56. \'c9s [tanuls\'e1gul szolg\'e1l\'f3] el\'f5dd\'e9 \'e9s p\'e9ld\'e1v\'e1 tett\'fck \'f5ket (az \'f5 eset\'fcket) az ut\'e1nuk k\'f6vetkez\'f5knek.
\par 
\par 57. \'c9s amikor [J\'e9zus,] M\'e1ria fia p\'e9ld\'e1nak lett felhozva, akkor \'edme, a te n\'e9ped hangos \'f6rvendez\'e9sbe fogott miatta,
\par 58. \'c9s azt mondt\'e1k: \'84A mi isteneink jobbak-e, vagy pedig \'f5?\'94 \'c1m csup\'e1n vitatkoz\'e1sb\'f3l hozt\'e1k fel p\'e9ld\'e1nak. Mert \'f5k egy civakod\'f3 n\'e9p.
\par 59. Nem m\'e1s \'f5 (J\'e9zus), mint egy szolga, akit j\'f3t\'e9tem\'e9nyekben r\'e9szes\'edtett\'fcnk \'e9s akit p\'e9ld\'e1v\'e1 tett\'fcnk Izrael fiainak.
\par 60. \'c9s ha \'fagy akartuk volna, bizony angyalokat tett\'fcnk volna ti helyettetek a f\'f6ldre, akik egym\'e1s hely\'e9be l\'e9p\'f5 nemzed\'e9kek lesznek.
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid2439359 61. \'c9s bizony, \'f5 (J\'e9zus) az \'d3r
a ismert [jele]. Ne k\'e9telkedjetek h\'e1t abban \'e9s k\'f6vessetek Engem! Ez az egyenes \'fat! 
\par 62. \'c9s ne tartson t\'e1vol titeket a s\'e1t\'e1n [az istenszolg\'e1latt\'f3l]! Bizony, \'f5 nyilv\'e1nval\'f3 ellens\'e9getek.
\par 63. \'c9s amikor J\'e9zus elj\'f6tt a nyilv\'e1nval\'f3 bizony\'edt\'e9kokkal, azt mondta: \'84Elj\'f6ttem m\'e1r hozz\'e1tok a b\'f6lcsess\'e9ggel, \'e9s hogy nyilv\'e1nval\'f3v\'e1 tegyek nektek valamennyit abb\'f3l, amiben \'f6sszek\'fcl\'f6nb\'f6
ztetek. F\'e9lj\'e9tek h\'e1t Allahot \'e9s engedelmeskedjetek nekem!
\par 64. Bizony, Allah az, aki az \'e9n Uram \'e9s a ti Uratok. Szolg\'e1lj\'e1tok h\'e1t \'f5t! Ez az egyenes \'fat.{\*\bkmkstart 651}{\*\bkmkend 651}\'94
\par 65. \'c1m a sz\'f6vets\'e9gesek \'f6sszek\'fcl\'f6nb\'f6ztek egym\'e1ssal. \'c9s jaj az igazs\'e1gtalanoknak egy f\'e1jdalmas nap gy\'f6trelm\'e9t\'f5l!
\par 66. Vajon mi m\'e1sra v\'e1rnak, mint hogy elj\'f6jj\'f6n hozz\'e1juk az \'d3ra (a Felt\'e1mad\'e1s) v\'e1ratlanul, mik\'f6zben \'f5k \'e9szre sem veszik?
\par 
\par 67. A bar\'e1tok azon a napon egym\'e1s ellens\'e9gei lesznek, kiv\'e9ve az istenf\'e9l\'f5ket.
\par 68. \'d3 szolg\'e1im! Ma nem lesz \'farr\'e1 rajtatok a f\'e9lelem \'e9s ti nem fogtok szomorkodni!
\par 69. Azok, akik hisznek a jeleinkben \'e9s akik al\'e1vetett\'e9k magukat [Allahnak]{\*\bkmkstart 70}{\*\bkmkend 70}.
\par 70. L\'e9pjetek be a Paradicsomba, ti \'e9s a feles\'e9geitek, boldogs\'e1gban [lesz ott r\'e9szetek]!
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid2439359 71. Arany ed\'e9nyeket \'e9s kup\'e1kat hordanak k
\'f6rbe k\'f6z\'f6tt\'fck, \'e9s ott az lesz, amit \'f5k maguk megk\'edv\'e1nnak, \'e9s ami a szemet gy\'f6ny\'f6rk\'f6dteti. \'c9s ti \'f6r\'f6kk\'e9 abban fogtok maradni.
\par 72. \'c9s ez a Paradicsom, amit \'f6r\'f6k\'fcl kaptatok az\'e9rt, amit cselekedtetek.
\par 73. Sokf\'e9le gy\'fcm\'f6lcs van ott sz\'e1motokra, amib\'f5l ehettek.
\par 
\par 74. Bizony, a gonosztev\'f5k a Gyehenna gy\'f6trelm\'e9ben fognak maradni [\'f6r\'f6kk\'e9].
\par 75. Nem k\'f6nny\'edttetik meg sz\'e1mukra, \'e9s abban k\'e9ts\'e9gbe lesznek esve.
\par {\*\bkmkstart 77}{\*\bkmkend 77}76. \'c9s nem k\'f6vett\'fcnk el igazs\'e1gtalans\'e1got ellen\'fck, hanem \'f5k voltak az igazs\'e1gtalanok.
\par {\*\bkmkstart 78}{\*\bkmkend 78}77. \'c9s sz\'f3l\'edtj\'e1k [a Pokol \'f5r\'e9t]: \'84\'d3 M\'e1lik! V\'e9gezzen vel\'fcnk az Urad!\'94 [Erre] \'f5 azt mondja: \'84Bizony, ti maradni fogtok!\'94
\par {\*\bkmkstart 79}{\*\bkmkend 79}78. Bizony elj\'f6tt\'fcnk imm\'e1r hozz\'e1tok az igazs\'e1ggal, azonban a legt\'f6bben k\'f6z\'fcletek ut\'e1lj\'e1k az igazs\'e1got.
\par 79. Vagy tal\'e1n valamif\'e9le tervet sz\'f5ttek [az igazs\'e1g ellen]? \'c9s bizony, Mi [is] tervet sz\'f6v\'fcnk [ellen\'fck].
\par 80. Vagy \'fagy gondolj\'e1k, hogy nem halljuk meg azt, amit eltitkolnak \'e9s amir\'f5l bizalmasan besz\'e9lgetnek? Dehogynem! \'c9s a Mi k\'fcld\'f6tteink vel\'fck vannak, \'e9s feljegyzik [a tetteiket].
\par 
\par 81. Mondd [\'f3 Mohamed]: \'84Ha a K\'f6ny\'f6r\'fcletesnek lenne fi\'fagyermeke, akkor \'e9n lenn\'e9k az els\'f5, aki szolg\'e1ln\'e1 [\'f5t].\'94
\par 82. Magasztaltass\'e9k az egek \'e9s a f\'f6ld Ura, a Tr\'f3nus Ura! [\'d5 felette van annak, mint], ahogy le\'edrj\'e1k [\'d5t].
\par 83. Hagyd h\'e1t \'f5ket, hadd elegyedjenek [\'fcres fecseg\'e9sbe] \'e9s hadd sz\'f3rakozzanak, am\'edg nem tal\'e1lkoznak azzal a nappal, amelyre \'edg\'e9retet kaptak!
\par 84. \'c9s \'d5 az, Aki az \'e9gben Isten \'e9s a f\'f6ld\'f6n [is] Isten. \'d5 a B\'f6lcs, a mindent Tud\'f3.
\par 85. \'c9s \'e1}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid2439359 ldass\'e9k az, aki\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett, \'e9s afelett, ami a kett\'f5 k}{\insrsid10757626\charrsid2439359 \'f6z\'f6tt van. \'c9
s N\'e1la van az \'d3ra tud\'e1sa, \'e9s \'d5hozz\'e1 lesz a visszat\'e9r\'e9setek.
\par 86. \'c9s azoknak, akikhez Rajta k\'edv\'fcl foh\'e1szkodnak, nem \'e1ll m\'f3djukban a k\'f6zbenj\'e1r\'e1s. Csak azok, akik az igazs\'e1got (az egyistenhitet) tan\'fas\'edtj\'e1k \'e9s rendelkeznek tud\'e1ssal [tehetik meg a k\'f6zbenj\'e1r\'e1
st Allah engedelm\'e9vel].
\par 87. \'c9s bizony, ha megk\'e9rdezed \'f5ket, hogy ki teremtette \'f5ket, bizonyosan azt mondj\'e1k: \'84Allah!\'94 Hogyan lehetnek h\'e1t elt\'e9r\'edtve [az igazs\'e1gt\'f3l]?
\par 88. \'c9s az [volt az] \'f5 (Mohamed) mond\'e1sa [panaszk\'e9ppen Allahnak]: \'84\'d3 Uram! Bizony \'f5k egy olyan n\'e9p, amely nem hisz.\'94
\par 89. Fordulj h\'e1t el t\'f5l\'fck \'e9s mondd: \'84B\'e9kess\'e9g!\'94 De meg fogj\'e1k tudni!}{\insrsid10757626 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626 
\par }\pard\plain \qj \li0\ri0\nowidctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626 \page }{
\b\lang1038\langfe1081\kerning1\dbch\af13\langfenp1081\insrsid10757626\charrsid13065856 \hich\af0\dbch\af13\loch\f0 44. A }{\b\lang1038\langfe1081\kerning1\dbch\af13\langfenp1081\insrsid10757626\charrsid2439359 \hich\af0\dbch\af13\loch\f0 \hich\f0 F\'fc
\loch\f0 \hich\f0 st (ad-Dukh\'e1\loch\f0 \hich\f0 n) c. sz\'fa\loch\f0 ra}{\b\insrsid10757626\charrsid2439359 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid2439359 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. H\'e1-M\'edm.{\*\bkmkstart 2141}{\*\bkmkend 2141} 
\par 2. A nyilv\'e1nval\'f3 \'cdr\'e1sra!
\par 3. Bizony, Mi bocs\'e1tottuk le ezt [a Kor\'e1nt] egy \'e1ldott \'e9jszak\'e1n. Bizony, Mi figyelmeztet\'f5i vagyunk [az embereknek].
\par 4. Akkor d\'f6ntetik el minden [Allah] b\'f6lcsess\'e9ge [szerint elrendelt] \'fcgy.
\par 5. T\'f5l\'fcnk val\'f3 [elrendelt] \'fcgyk\'e9nt. Bizony, mi elk\'fcld\'f5i vagyunk [a k\'fcld\'f6tteknek].
\par 6. Uradt\'f3l val\'f3 k\'f6ny\'f6r\'fcletk\'e9nt. \'d5 a mindent Hall\'f3, a Mindentud\'f3.
\par 7. [Att\'f3l, aki] az Ura az egeknek, a f\'f6ldnek \'e9s mindannak ami kettej\'fck k\'f6z\'f6tt van. Ha val\'f3ban szil\'e1rd bizonyoss\'e1gotok van [akkor tudnotok kell, hogy Allah k\'fcldi el a pr\'f3f\'e9t\'e1kat, \'e9s bocs\'e1tja le a K\'f6nyveket].

\par 8. Nincs m\'e1s [jogosan im\'e1dhat\'f3] isten Rajta k\'edv\'fcl. \'d5 kelt \'e9letre \'e9s bocs\'e1t hal\'e1lba. A ti Uratok, \'e9s hajdanvolt aty\'e1itok Ura.
\par 
\par 9. De nem! \'d5k k\'e9telyek k\'f6z\'f6tt j\'e1tszadoznak.
\par 10. Figyeld h\'e1t meg azt a napot, amelyen az \'e9g nyilv\'e1nval\'f3 (tiszt\'e1n l\'e1that\'f3) f\'fcsttel j\'f6n el,
\par 11. Amely elbor\'edtja az embereket! [Azt mondatik majd:] \'84F\'e1jdalmas gy\'f6trelem ez.\'94
\par 12. [Azt ki\'e1ltj\'e1k majd:] \'84Urunk! H\'e1r\'edtsd el r\'f3lunk a gy\'f6trelmet! Bizony, mi hisz\'fcnk!\'94
\par 13. \'c1m [akkor] hogyan is lehetne [hasznukra] az eml\'e9kez\'e9s, holott [kor\'e1bban] m\'e1r elj\'f6tt hozz\'e1juk egy nyilv\'e1nval\'f3 k\'fcld\'f6tt,
\par 14. Ezut\'e1n h\'e1tat ford\'edtottak neki \'e9s azt mondt\'e1k [r\'f3la]: \'84[M\'e1sok \'e1ltal] tan\'edtott [\'e9s] \'f5r\'fclt.\'94
\par {\*\bkmkstart 165}{\*\bkmkend 165}15. Bizony, Mi elh\'e1r\'edtjuk egy kis id\'f5re a gy\'f6trelmet, ti pedig bizonyosan visszat\'e9rtek [a hitetlens\'e9ghez].
\par 16. Azon a napon, amikor a legnagyobb (er\'f5vel) ragadjuk meg \'f5ket, Mi bizony el\'e9gt\'e9telt vesz\'fcnk rajtuk.
\par 
\par 17. \'c9s bizony, m\'e1r \'f5el\'f5tt\'fck pr\'f3b\'e1ra tett\'fck a F\'e1ra\'f3 n\'e9p\'e9t, \'e9s egy nemes k\'fcld\'f6tt j\'f6tt el hozz\'e1juk,
\par 18. [Aki azt mondta,] hogy: \'84Adj\'e1tok ki nekem Allah szolg\'e1it [Izrael gyermekeit]! Bizony, \'e9n megb\'edzhat\'f3 k\'fcld\'f6tt vagyok sz\'e1motokra.\'94
\par 19. \'c9s [azt mondta,] hogy \'84Ne fennh\'e9j\'e1zzatok Allahhal szemben! Bizony \'e9n nyilv\'e1nval\'f3 hatalommal j\'f6v\'f6k hozz\'e1tok.
\par 20. \'c9s \'e9n bizony mened\'e9ket keresek [Allahn\'e1l,] az \'e9n Uramn\'e1l \'e9s a ti Uratokn\'e1l, [az el\'f5l,] hogy megk\'f6vezzetek.
\par 21. \'c9s ha nem hisztek nekem, akkor tarts\'e1tok t\'e1vol magatokat t\'f5lem!\'94
\par 22. \'c9s Ur\'e1hoz foh\'e1szkodott [azt mondv\'e1n], hogy: \'84Ezek bizony egy gonosztev\'f5 n\'e9p!\'94
\par 23. [Allah azt mondta:] \'84Indulj h\'e1t \'fatnak \'e9jszaka a szolg\'e1immal! Ti bizony k\'f6vetve (\'fcld\'f6zve) lesztek.
\par 24. \'c9s hagyd [m\'f6g\'f6tted] a tengert, \'fagy ahogy van (sz\'e9tv\'e1lasztva)! Bizony, \'f5k egy olyan sereg, amely v\'edzbe lesz fullasztva.\'94
\par 25. Mennyi kertet \'e9s forr\'e1st hagytak h\'e1tra,
\par 26. \'c9s gabonaf\'f6ldeket \'e9s nemes helyet{\*\bkmkstart 274}{\*\bkmkend 274},
\par 27. \'c9s [Allaht\'f3l kapott] j\'f3t\'e9tem\'e9nyeket, amelyek k\'f6z\'f6tt \'f6rvendeztek.
\par 28. Ekk\'e9ppen [volt ez]. \'c9s egy m\'e1sik n\'e9pnek adtuk azt \'f6r\'f6k\'fcl.
\par 29. \'c9s nem siratta meg \'f5ket az \'e9g, sem a f\'f6ld, \'e9s halad\'e9kot sem kaptak.
\par 30. \'c9s Mi pedig megmentett\'fck Izrael fiait a megal\'e1z\'f3 gy\'f6trelemt\'f5l,
\par 31. A F\'e1ra\'f3 [gonosztetteit\'f5l]. Bizony, \'f5 g\'f5g\'f6s volt \'e9s a m\'e9rt\'e9ktelenek k\'f6z\'fcl val\'f3.
\par 32. \'c9s bizony, tud\'e1s alapj\'e1n v\'e1lasztottuk ki \'f5ket kor\'e1bban a teremtm\'e9nyek f\'f6l\'e9.
\par 33. \'c9s jeleket adtunk nekik, amelyekben nyilv\'e1nval\'f3 pr\'f3bat\'e9tel volt.
\par 
\par 34. Bizony, ezek [az emberek] azt mondj\'e1k:
\par 35. \'84Nincs m\'e1s [v\'e9ge az evil\'e1gi l\'e9t\'fcnknek], csup\'e1n az egyetlen hal\'e1lunk, \'e9s mi nem lesz\'fcnk felt\'e1masztva [\'faj \'e9letre].
\par 36. Hozz\'e1tok h\'e1t vissza aty\'e1inkat [a hal\'e1lukb\'f3l], ha val\'f3ban igazmond\'f3k vagytok!\'94
\par 37. Vajon \'f5k-e a jobbak, avagy Tubba n\'e9pe \'e9s azok, akik \'f5el\'f5tt\'fck \'e9ltek? Elpuszt\'edtottuk \'f5ket. Bizony, \'f5k gonosztev\'f5k voltak.
\par 38. \'c9s nem teremtett\'fck meg az egeket \'e9s a f\'f6ldet \'e9s mindazt, ami k\'f6z\'f6tt\'fck van j\'e1tszadoz\'e1sb\'f3l.
\par {\*\bkmkstart 40}{\*\bkmkend 40}39. Nem teremtett\'fck meg mindkettej\'fcket, csakis az igazs\'e1ggal (c\'e9llal), \'e1m a legt\'f6bbj\'fck nem tudja [ezt].
\par 
\par 40. Bizony, a D\'f6nt\'e9s napj\'e1nak id\'f5pontja ki van jel\'f6lve sz\'e1mukra, mindannyiuknak.
\par 41. [Az] a nap, amikor egy rokon sem fog haszn\'e1ra v\'e1lni egy rokon\'e1nak, \'e9s nem lesznek megseg\'edtve,
\par 42. Kiv\'e9ve azt, akin Allah megk\'f6ny\'f6r\'fcl. Bizony, \'d5 a M\'e9lt\'f3s\'e1gteljes, az Irgalmas.{\*\bkmkstart 431}{\*\bkmkend 431}
\par 43. Bizony, a [Pokolban l\'e9v\'f5] Zakk\'fam fa
\par 44. A b\'fbn\'f6s \'e9tele,
\par 45. Olyan, mint az olvasztott \'e9rc, [amely] forrni fog a hasakban,
\par 46. \'dagy, mint [ahogy] a forr\'e1sban l\'e9v\'f5 v\'edz fortyog.
\par 47. [Az lesz mondva:] \'84Fogj\'e1tok meg \'f5t \'e9s vonszolj\'e1tok be a Pokol k\'f6zep\'e9be!
\par 48. Azt\'e1n \'f6ntsetek a fej\'e9re forr\'e1sban l\'e9v\'f5 vizet, gy\'f6trelm\'fcl!\'94
\par 49. [Az mondatik neki:] \'84\'cdzleld meg! Bizony, te m\'e9lt\'f3s\'e1gos \'e9s nemes vagy!
\par 50. Bizony, ez az, amiben mindig k\'e9telkedtetek!\'94
\par 
\par 51. Bizony, az istenf\'e9l\'f5k biztons\'e1gos helyen lesznek [a t\'falvil\'e1gi Paradicsomban],
\par 52. Kertekben \'e9s forr\'e1sok k\'f6z\'f6tt,
\par 53. V\'e9kony selymet \'e9s vastag brok\'e1tot viselnek, egym\'e1ssal szemben [elhelyezkedve].
\par 54. Ekk\'e9ppen lesz. \'c9s nagy szem\'fb, sz\'e9p n\'f5ket adunk nekik feles\'e9g\'fcl,
\par 55. \'c9s mindenf\'e9le gy\'fcm\'f6lcs\'f6t k\'e9rhetnek ott, biztons\'e1gban.
\par 56. \'c9s nem \'edzlelik meg ott a hal\'e1lt, kiv\'e9ve az [evil\'e1gi] egyetlen hal\'e1lt. \'c9s Allah meg\'f3vja \'f5ket a Pokol gy\'f6trelm\'e9t\'f5l,
\par 57. Kegyk\'e9nt a te Uradt\'f3l. Ez a hatalmas diadal.
\par 58. \'c9s bizony, k\'f6nny\'fbv\'e9 tett\'fck a nyelveden ezt [a Kor\'e1nt], hogy okulhassanak [az int\'e9sb\'f5l].
\par 59. V\'e1rj h\'e1t [\'f3 Mohamed]! Bizony, \'f5k [is] v\'e1rakoznak.}{\insrsid10757626 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626 
\par }\pard\plain \qj \li0\ri0\nowidctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid983814 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626 \page }{
\b\lang1038\langfe1081\kerning1\dbch\af13\langfenp1081\insrsid10757626\charrsid983814 \hich\af0\dbch\af13\loch\f0 45. A \hich\af0\dbch\af13\loch\f0 \hich\f0 let\'e9\loch\f0 \hich\f0 rdepl\'f5\hich\af0\dbch\af13\loch\f0  (adzs-\hich\af0\dbch\af13\loch\f0 
\hich\f0 Dzs\'e1\loch\f0 \hich\f0 szija) c. sz\'fa\loch\f0 ra}{\b\insrsid10757626\charrsid10037048 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid10037048 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid10037048 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev
\'e9ben.
\par 
\par 1. H\'e1-M\'edm.{\*\bkmkstart 21411}{\*\bkmkend 21411}
\par 2. Az \'cdr\'e1s (a Kor\'e1n) lebocs\'e1t\'e1sa a M\'e9lt\'f3s\'e1gteljes \'e9s a B\'f6lcs Allaht\'f3l [van].
\par 3. Bizony, az egekben \'e9s a f\'f6ld\'f6n jelek vannak a h\'edv\'f5knek.
\par 4. \'c9s a ti teremt\'e9setekben \'e9s minden mozg\'f3 [\'e9l\'f5l\'e9ny teremt\'e9s\'e9ben], amit [Allah] sz\'f3rt sz\'e9t [a f\'f6ld\'f6n], jelek vannak egy olyan n\'e9p sz\'e1m\'e1ra, akik szil\'e1rd bizonyoss\'e1ggal hisznek.
\par 5. \'c9s az \'e9jszaka \'e9s a nappal v\'e1ltakoz\'e1s\'e1ban, \'e9s az ell\'e1t\'e1sban, amit Allah bocs\'e1t le az \'e9gb\'f5l - \'e9s \'e9letre kelti \'e1ltala a f\'f6ldet annak hal\'e1la (kisz\'e1rad\'e1sa) ut\'e1n - \'e9s a szelek ir\'e1ny\'edt\'e1s
\'e1ban, jelek vannak egy olyan n\'e9p sz\'e1m\'e1ra, akik \'e9lnek az esz\'fckkel.
\par 6. Ezek Allah jelei (szavai), melyeket az igazs\'e1gnak megfelel\'f5en recit\'e1lunk el neked. H\'e1t vajon mif\'e9le besz\'e9dben fognak Allah [besz\'e9de] \'e9s jelei ut\'e1n hinni?
\par 
\par 7. Jaj minden hazudoz\'f3nak, b\'fbn\'f6snek,
\par 8. [Aki] hallja Allah jeleit, amint recit\'e1ltatnak neki, azt\'e1n fennh\'e9j\'e1zva meg\'e1talkodik [a hitetlens\'e9gben], mintha nem hallan\'e1 azt. Adj h\'e1t \'f6r\'f6mh\'edrt neki egy f\'e1jdalmas gy\'f6trelemr\'f5l!
\par 9. \'c9s amikor megtud valamit a jeleinkb\'f5l, akkor g\'fanyt \'fbz azokb\'f3l. Azoknak megal\'e1z\'f3 b\'fcntet\'e9s j\'e1r.
\par 10. El\'f5tt\'fck van a Gyehenna. \'c9s nem haszn\'e1l nekik semmit az, amit megszereztek, sem azok, akiket p\'e1rtfog\'f3ikk\'e1 tettek Allahon k\'edv\'fcl. \'c9s nekik hatalmas gy\'f6trelem j\'e1r.
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid10037048 11. Ez [a Kor\'e1n] \'fatmutat\'e1s. \'c1
m azoknak, akik nem hisznek Uruk jeleiben, f\'e1jdalmas gy\'f6trelemb\'f5l \'e1ll\'f3 b\'fcntet\'e9sben lesz r\'e9sz\'fck.
\par 
\par 12. Allah az, aki a szolg\'e1latotokra rendelte a tengert, hogy a haj\'f3k azon haladjanak az \'d5 parancsa \'e1ltal, \'e9s hogy keress\'e9tek az \'d5 kegy\'e9t, \'e9s h\'e1tha h\'e1l\'e1sak lesztek.
\par 13. \'c9s szolg\'e1latotokra rendelte mindazt, ami az egekben \'e9s a f\'f6ld\'f6n van, mindezt T\'f5le [egyed\'fcl]. Bizony, jelek vannak ebben egy olyan n\'e9p sz\'e1m\'e1ra, akik elgondolkodnak.
\par 
\par 14. Mondd [\'f3 Mohamed] a h\'edv\'f5knek, hogy bocs\'e1ssanak meg azoknak, akik nem tartanak Allah [b\'fcntet\'e9s\'e9nek] napjait\'f3l, hogy [Allah egyed\'fcl] fizessen meg [a h\'edv\'f5knek \'e1rt\'f3] n\'e9pnek az\'e9rt, amit [kor\'e1
bban] megszereztek.
\par 15. Aki j\'f3tettet cselekszik, a maga haszn\'e1ra [teszi azt], aki pedig rosszat tesz, a maga k\'e1r\'e1ra [teszi azt]. Azt\'e1n Uratokhoz lesztek visszavitetve.
\par 
\par 16. \'c9s bizony, odaadtuk kor\'e1bban Izrael fiainak az \'cdr\'e1st, a b\'f6lcsess\'e9get \'e9s a pr\'f3f\'e9tas\'e1got. \'c9s mindenf\'e9le j\'f3 dologgal l\'e1ttuk el \'f5ket. \'c9s el\'f5nyben r\'e9szes\'edtett\'fck \'f5ket [az akkori] teremtm\'e9
nyekkel szemben.
\par 17. \'c9s nyilv\'e1nval\'f3 bizony\'edt\'e9kokat adtunk nekik [a vall\'e1s] \'fcgy\'e9ben. \'c1m nem k\'fcl\'f6nb\'f6ztek \'f6ssze, csak miut\'e1n elj\'f6tt hozz\'e1juk a tud\'e1s, az egym\'e1s ir\'e1nti irigys\'e9g miatt. Bizony, a te Urad fog \'edt\'e9
lkezni k\'f6z\'f6tt\'fck a Felt\'e1mad\'e1s Napj\'e1n arr\'f3l, amiben \'f6sszek\'fcl\'f6nb\'f6ztek.
\par 18. Azut\'e1n [vil\'e1gos] \'f6sv\'e9nyre helyezt\'fcnk t\'e9ged (\'f3 Mohamed) [a vall\'e1s] \'fcgy\'e9ben. K\'f6vesd h\'e1t azt \'e9s ne k\'f6vesd azoknak a k\'e9ny\'e9t, akik nem rendelkeznek tud\'e1ssal!
\par {\*\bkmkstart 203}{\*\bkmkend 203}19. Bizony, \'f5k nem lesznek hasznodra semmiben Allah el\'f5tt. \'c9s bizony az igazs\'e1gtalanok egym\'e1s p\'e1rtfog\'f3i, \'e1m Allah az istenf\'e9l\'f5k p\'e1rtfog\'f3ja.
\par 20. Ez [a Kor\'e1n] tiszt\'e1nl\'e1t\'e1st ad\'f3 bizony\'edt\'e9k az embereknek, \'e9s \'fatmutat\'e1s \'e9s k\'f6ny\'f6r\'fclet egy olyan n\'e9p sz\'e1m\'e1ra, akik szil\'e1rd bizonyoss\'e1ggal hisznek.
\par 
\par 21. Vajon azt gondolj\'e1k azok, akik rossz tetteket k\'f6vettek el, hogy \'fagy b\'e1nunk majd vel\'fck, mint azokkal, akik hisznek \'e9s j\'f3tetteket cselekszenek - egyenl\'f5v\'e9 t\'e9ve \'f5ket \'e9let\'fckben \'e9s hal\'e1
lukban? Milyen rossz az, ahogyan \'edt\'e9lkeznek!
\par 22. \'c9s Allah teremtette az egeket \'e9s a f\'f6ldet az igazs\'e1ggal (c\'e9llal), \'e9s hogy minden ember megkapja a fizets\'e9get az\'e9rt, amit megszerzett, \'e9s nem szenvednek el igazs\'e1gtalans\'e1got.
\par 
\par 23. Vajon h\'e1t mit gondolsz arr\'f3l, aki a k\'e9ny\'e9t teszi meg az isten\'e9nek, \'e9s akit Allah t\'e9v\'fatra visz, tud\'e1sa ellen\'e9re, \'e9s akinek lepecs\'e9teli a hall\'e1s\'e1t \'e9s a sz\'edv\'e9t, \'e9s leplet helyez a l\'e1t\'e1s\'e1
ra? Vajon ki vezeti \'f5t [az igaz \'fatra], miut\'e1n Allah [t\'e9v\'fatra vitte]? H\'e1t vajon nem okulnak [az int\'e9sb\'f5l]?
\par 24. \'c9s azt mondj\'e1k: \'84Nincs m\'e1s [\'e9let], csup\'e1n az evil\'e1gi \'e9let\'fcnk, meghalunk \'e9s \'e9l\'fcnk, \'e9s csup\'e1n az id\'f5 puszt\'edt el minket.\'94 \'c9s nincs nekik tudom\'e1suk arr\'f3l. \'d5k csup\'e1n v\'e9lekednek.
\par 25. \'c9s amikor a jeleink vil\'e1gos bizony\'edt\'e9kokk\'e9nt recit\'e1ltatnak nekik, [soha] nem volt m\'e1s \'e9rv\'fck, csak az, hogy azt mondj\'e1k: \'84Hozz\'e1tok vissza aty\'e1inkat, ha val\'f3ban igazmond\'f3k vagytok!\'94
\par {\*\bkmkstart 273}{\*\bkmkend 273}26. Mondd [\'f3 Mohamed]: \'84Allah kelt \'e9letre titeket, azut\'e1n hal\'e1lba bocs\'e1t titeket, azut\'e1n \'f6sszegy\'fbjt titeket a Felt\'e1mad\'e1s napj\'e1ra, amelyhez nem f\'e9rhet k\'e9ts\'e9g, de a legt\'f6
bb ember nem rendelkezik tud\'e1ssal.\'94
\par 
\par 27. \'c9s Allah\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett. \'c9s azon a napon, amikor val\'f3ra v\'e1lik az \'d3ra (a Felt\'e1mad\'e1s), azon a napon vesztesek lesznek a hamiss\'e1got k\'f6vet\'f5k.
\par 28. \'c9s l\'e1tni fogod, amint minden n\'e9p let\'e9rdepel. Minden n\'e9p a tetteinek a feljegyz\'e9s\'e9hez sz\'f3l\'edttatik: \'84Ma [az\'e9rt] kaptok fizets\'e9get, amit cselekedtetek.
\par 29. \'cdme, ez a Mi \'edr\'e1sunk (feljegyz\'e9s\'fcnk), ami az igazs\'e1gnak megfelel\'f5en sz\'f3l ellenetek. Bizony, Mi feljegyezt\'fck [az angyalok \'e1ltal] mindazt, amit cselekedtetek.\'94
\par 30. \'c9s ami azokat illeti, akik hittek, \'e9s j\'f3tetteket cselekedtek, azokat az Uruk bebocs\'e1tja az \'d5 k\'f6ny\'f6r\'fclet\'e9be. Ez a nyilv\'e1nval\'f3 diadal!
\par 31. Ami pedig azokat illeti, akik hitetlenn\'e9 v\'e1ltak, [azokhoz Allah \'edgy sz\'f3l:] \'84Vajon nem recit\'e1lt\'e1k-e nektek az \'e9n jeleimet (szavaimat)? Ti azonban fennh\'e9j\'e1ztatok \'e9s gonosztev\'f5 n\'e9p voltatok!
\par 32. \'c9s amikor az mondatik [nektek, hogy] Allah \'edg\'e9rete igaz, \'e9s a \'d3r\'e1hoz nem f\'e9rhet k\'e9ts\'e9g, [akkor azt felelitek, hogy] mi nem tudjuk, mit jelent az \'d3ra, nek\'fcnk csak v\'e9leked\'e9s\'fcnk van r\'f3la, \'e9s nincs szil\'e1
rd bizonyoss\'e1gunk [benne].{\*\bkmkstart 332}{\*\bkmkend 332}\'94
\par 33. \'c9s meg fognak mutatkozni nekik a rossz [k\'f6vetkezm\'e9nyei] annak, amit cselekedtek, \'e9s k\'f6rbeker\'edti \'f5ket [az a b\'fcntet\'e9s], amib\'f5l g\'fanyt \'fbztek.
\par 34. \'c9s azt mondatik [nekik:] \'84Ma elfelejt\'fcnk titeket, ahogyan ti is elfelejtett\'e9tek az ezzel a nappal val\'f3 tal\'e1lkoz\'e1sotokat, \'e9s a [Pokol-]t\'fbz lesz a hajl\'e9kotok \'e9s nem lesznek seg\'edt\'f5itek.\'94
\par 35. Ez [az\'e9rt t\'f6rt\'e9nik veletek], mivel g\'fany t\'e1rgy\'e1v\'e1 tett\'e9tek Allah jeleit \'e9s megt\'e9vesztett titeket az evil\'e1gi \'e9let. \'cdgy ma nem vitetnek ki bel\'f5le (a Pokol-t\'fbzb\'f5l), \'e9s nem k\'e9retik t\'f5l\'fc
k kiengesztel\'e9s [Allah fel\'e9].
\par 
\par 36. \'c9s Allahot illeti a h\'e1latelt dics\'e9ret, az egek Ur\'e1t \'e9s a f\'f6ld Ur\'e1t, a teremtm\'e9nyek Ur\'e1t!
\par 37. \'c9s \'d5t illeti minden nagys\'e1g az egekben \'e9s a f\'f6ld\'f6n, \'e9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 
\par 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\insrsid10757626\charrsid10037048 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid983814 \hich\af0\dbch\af13\loch\f0 \hich\f0 46. A homokd\'fb\loch\f0 \hich\f0 n\'e9\loch\f0 \hich\f0 k (al-Ahk
\'e1\loch\f0 \hich\f0 f) c. sz\'fa\loch\f0 ra}{\b0\insrsid10757626\charrsid10037048 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid10037048 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid10037048 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev
\'e9ben.
\par 
\par 1. H\'e1-M\'edm.{\*\bkmkstart 214111}{\*\bkmkend 214111}
\par 2. A [Kor\'e1n] lebocs\'e1t\'e1sa a M\'e9lt\'f3s\'e1gteljes \'e9s a B\'f6lcs Allaht\'f3l [van].
\par 3. Nem teremtett\'fck meg az egeket \'e9s a f\'f6ldet, \'e9s mindazt, ami k\'f6z\'f6tt\'fck van, csakis az igazs\'e1ggal (c\'e9llal) \'e9s megszabott hat\'e1rid\'f5vel. \'c9s akik hitetlenn\'e9 v\'e1ltak, elfordulnak att\'f3l, amire figyelmeztet\'e9
st kaptak.
\par 4. Mondd [\'f3 Mohamed:] \'84Vajon mit gondoltok azokr\'f3l, akikhez Allah helyett foh\'e1szkodtok? Mutass\'e1tok meg nekem, hogy mit teremtettek \'f5k a f\'f6ldb\'f5l? Vagy r\'e9szesed\'e9s\'fck lenne az egek [teremt\'e9s\'e9b\'f5
l]? Hozzatok nekem ide egy \endash  ezt (a Kor\'e1nt) megel\'f5z\'f5 \endash  \'cdr\'e1st, vagy a [kinyilatkoztatott] tud\'e1sb\'f3l b\'e1rmilyen r\'e9szt, ha val\'f3ban igazmond\'f3k vagytok!\'94
\par 5. \'c9s ki t\'e9velyg\'f5bb ann\'e1l, mint aki Allah helyett olyasvalakikhez foh\'e1szkodik, akik nem adnak v\'e1laszt neki a Felt\'e1mad\'e1s napj\'e1ig, \'e9s \'f5k \'e9szre sem veszik a hozz\'e1juk int\'e9zett foh\'e1szokat?
\par 
\par 6. \'c9s amikor \'f6sszegy\'fbjtetnek majd az emberek, [azok, akiket isten\'edtettek] az \'f5 ellens\'e9geik lesznek \'e9s meg fogj\'e1k tagadni a fel\'e9j\'fck int\'e9zett szolg\'e1latot.
\par 7. \'c9s amikor a mi jeleink nyilv\'e1nval\'f3 bizony\'edt\'e9kokk\'e9nt recit\'e1ltatnak nekik, azok, akik hitetlenn\'e9 v\'e1ltak, azt mondj\'e1k az Igazs\'e1gr\'f3l, miut\'e1n az elj\'f6tt hozz\'e1juk: \'84Nyilv\'e1nval\'f3 var\'e1zslat ez.\'94
\par 8. Vagy azt mondj\'e1k: \'84\'d5 tal\'e1lta ki azt!\'94 Mondd [\'f3 Mohamed]: \'84Ha \'e9n tal\'e1ltam volna ki azt, h\'e1t nem \'e1ll m\'f3dotokban semmit se tenni \'e9rtem Allahhal szemben. \'d5 tudja a legjobban azt, hogy mi rosszat mondtok r\'f3
la (a Kor\'e1nr\'f3l). \'d5 el\'e9gs\'e9ges tan\'fa k\'f6ztem \'e9s k\'f6ztetek. \'c9s \'d5 a Megbocs\'e1t\'f3, a K\'f6ny\'f6r\'fcletes.\'94
\par 
\par 9. Mondd [\'f3 Mohamed]: \'84Nem vagyok \'fajdons\'e1g [az \'e1ltalam hozott \'fczenetet illet\'f5en] a k\'fcld\'f6ttek k\'f6z\'f6tt, \'e9s nem tudom, hogy mi fog t\'f6rt\'e9nni velem, vagy veletek. \'c9n csup\'e1n azt k\'f6vetem, ami [kinyilatkoztat\'e1
sk\'e9nt}{\insrsid10757626\charrsid8595362 ] sugalltatik nekem. \'c9s \'e9n nem vagyok m\'e1s, mint nyilv\'e1nval\'f3 figyelmeztet\'f5.{\*\bkmkstart 103}{\*\bkmkend 103}\'94
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid8595362 10. Mondd: \'84
Vajon mit gondoltok? Ha ez [a Kor\'e1n] val\'f3ban Allaht\'f3l van, \'e9s ti tagadj\'e1tok, holott egy tan\'fa Izrael fiai k\'f6z\'fcl tan\'faskodott valami ahhoz hasonl\'f3r\'f3l (a Kor\'e1n \'fczenet\'e9t igazol\'f3r\'f3l), azut\'e1
n hitt benne, ti pedig fennh\'e9j\'e1ztatok [akkor ez nem hatalmas b\'fbn]?\'94 Bizony, Allah nem vezeti az igaz \'fatra az igazs\'e1gtalan n\'e9pet.
\par 11. \'c9s azok, akik hitetlenn\'e9 v\'e1ltak, azt mondt\'e1k azoknak, akik hittek: \'84Ha ez [a Kor\'e1n] j\'f3 volna, akkor [a szeg\'e9nyek \'e9s az elnyomottak] nem el\'f5ztek volna meg minket abban (a hitben).\'94 \'c9s ha nem lelnek igaz \'fatra \'e1
ltala, h\'e1t azt mondj\'e1k r\'f3la: \'84Ez egy r\'e9gi hazugs\'e1g.\'94
\par 12. \'c9s ezel\'f5tt ott volt M\'f3zes \'cdr\'e1sa ir\'e1nyad\'f3k\'e9nt \'e9s k\'f6ny\'f6r\'fcletk\'e9nt. \'c9s olyan \'edr\'e1s ez, amely igazolja [annak az igazs\'e1g\'e1t, ami el\'f5tte volt], arab nyelv\'fbk\'e9nt az\'e9
rt, hogy figyelmeztesse azokat, akik igazs\'e1gtalans\'e1got k\'f6vettek el, \'e9s hogy \'f6r\'f6mh\'edr legyen a j\'f3tev\'f5knek.
\par 13. }{\cs100\insrsid10757626\charrsid8595362 Bizony, akik azt mondj\'e1k, [hogy] \'84Allah az Urunk!\'94, majd az egyenes \'faton j\'e1rnak,}{\insrsid10757626\charrsid8595362  h\'e1t azokon nem lesz \'farr\'e1 a f\'e9lelem \'e9s nem fognak szomorkodni.

\par 14. \'d5k azok, akik a Paradicsom lak\'f3i lesznek, \'f6r\'f6kk\'e9 ott fognak maradni, fizets\'e9gk\'e9ppen az\'e9rt, amit cselekedtek.{\*\bkmkstart 153}{\*\bkmkend 153}
\par 
\par 15. \'c9s meghagytuk az embernek a sz\'fcleivel val\'f3 j\'f3 b\'e1n\'e1sm\'f3dot. Az anyja neh\'e9zs\'e9ggel hordozta \'f5t, \'e9s neh\'e9zs\'e9ggel sz\'fclte meg \endash  \'e9s a terhess\'e9g [elej\'e9t\'f5l] az elv\'e1laszt\'e1sig harminc h\'f3nap van 
\endash , amikor pedig el\'e9ri ereje telj\'e9t, \'e9s el\'e9ri a negyvenedik \'e9v\'e9t, azt mondja: \'84Uram! Sarkallj arra engem, hogy megk\'f6sz\'f6njem a j\'f3t\'e9tem\'e9nyt, amelyet ir\'e1ntam \'e9s a sz\'fcleim ir\'e1nt tan\'fas\'edtott\'e1l, \'e9
s arra, hogy olyan j\'f3t cselekedjek, amellyel megel\'e9gedsz! \'c9s tedd j\'f3raval\'f3v\'e1 nekem a lesz\'e1rmazottaimat! Bizony, \'e9n b\'fbnb\'e1nattal fordulok Hozz\'e1d, \'e9s bizony, }{\cs100\insrsid10757626\charrsid8595362 \'e9n azok k\'f6z\'e9
 tartozom, akik al\'e1vetik magukat [Neked]!\'94}{\insrsid10757626\charrsid8595362 
\par 16. \'d5k azok, akikt\'f5l a legjobbakat fogadjuk el azok k\'f6z\'fcl, amiket cselekedtek, \'e9s eltekint\'fcnk a rossz tetteikt\'f5l, a Paradicsom lak\'f3i k\'f6z\'f6tt [lesznek \'f5k]. Igaz \'edg\'e9ret ez, amelyre \'edg\'e9retet kaptak.
\par 17. \'c1m [van olyan ember], aki azt mondja a sz\'fcleinek: \'84Pf\'faj r\'e1tok, vajon azt \'edg\'e9ritek nekem, hogy el\'f5 leszek hozatva a s\'edrb\'f3l, holott nemzed\'e9kek t\'e1voztak el [az \'e9l\'f5k sor\'e1b\'f3l] \'e9n el\'f5ttem?\'94 \'c9
s mindk\'e9t [sz\'fcl\'f5] seg\'edts\'e9g\'e9rt ki\'e1lt Allahhoz [\'e9s azt mondj\'e1k a gyermeknek:] \'84Jaj neked! Higgy\'e9l! Bizony, Allah \'edg\'e9rete igaz!\'94, de \'f5 azt mondja: \'84Nem m\'e1sok ezek, mint a hajdanvoltak legend\'e1i.\'94
\par 18. \'d5k azok, akikkel szemben jogoss\'e1 v\'e1lt [a b\'fcntet\'e9sr\'f5l sz\'f3l\'f3] sz\'f3, ak\'e1rcsak azon k\'f6z\'f6ss\'e9gekkel szemben, akik m\'e1r elt\'e1voztak [az \'e9l\'f5k sor\'e1b\'f3l] a dzsinnek \'e9s az emberek k\'f6z\'fcl. Bizony, \'f5
k vesztesek voltak [mindannyian].
\par 
\par 19. \'c9s mindegyik\'fcknek meglesznek a fokozataik a cselekedeteiknek megfelel\'f5en, \'e9s az\'e9rt hogy [Allah] teljess\'e9 tegye [a fizets\'e9get] a cselekedeteik\'e9rt, \'e9s \'f5k nem szenvednek el igazs\'e1gtalans\'e1got.
\par 20. \'c9s azon a napon, amikor azok, akik hitetlenn\'e9 v\'e1ltak, a Pokol-t\'fbz el\'e9 \'e1ll\'edttatnak [\'e9s az mondatik nekik:] \'84Elpocs\'e9kolt\'e1tok a j\'f3 dolgaitokat az evil\'e1gi \'e9letetekben \'e9s \'e9lvezt\'e9tek azokat. Ma a megal\'e1z
\'e1s gy\'f6trelm\'e9t kapj\'e1tok fizets\'e9g\'fcl, ami\'e9rt jogtalanul fennh\'e9j\'e1ztatok a f\'f6ld\'f6n, \'e9s mert engedetlenek voltatok.\'94
\par 
\par 21. \'c9s eml\'edtsd meg \'c1d testv\'e9r\'e9t (H\'fad pr\'f3f\'e9t\'e1t), amikor figyelmeztette n\'e9p\'e9t a homokd\'fbn\'e9kn\'e9l [D\'e9l-Ar\'e1bi\'e1ban]! \'c1m m\'e1r elt\'e1voztak a figyelmeztet\'f5k \'f5el\'f5tte \'e9s ut\'e1na is, [akik azt mondt
\'e1k:] \'84Ne szolg\'e1ljatok m\'e1st, csak Allahot! Bizony, \'e9n f\'e9ltelek titeket egy hatalmas nap gy\'f6trelm\'e9t\'f5l.\'94
\par 22. Azt mondt\'e1k: \'84Vajon az\'e9rt j\'f6tt\'e9l el hozz\'e1nk, hogy elford\'edts minket az isteneinkt\'f5l? Hozd h\'e1t ide nek\'fcnk [azt a b\'fcntet\'e9st], amit meg\'edg\'e9rt\'e9l nek\'fcnk, ha val\'f3ban az igazmond\'f3k k\'f6z\'fcl val\'f3 vagy!
\'94
\par 23. Azt mondta [H\'fad pr\'f3f\'e9ta:] \'84A [b\'fcntet\'e9s idej\'e9r\'f5l sz\'f3l\'f3] tud\'e1s csup\'e1n Allahn\'e1l van, \'e9n pedig \'e1tadom nektek azt, amivel el lettem k\'fcldve. De \'e9n azt l\'e1tom, hogy ti tudatlan n\'e9p vagytok!\'94
\par 24. \'c9s amikor azt l\'e1tt\'e1k, hogy a l\'e1t\'f3hat\'e1ron egy felh\'f5 k\'f6zeledik a v\'f6lgyeik fel\'e9, azt mondt\'e1k: \'84Ez egy felh\'f5, amely es\'f5t hoz nek\'fcnk.\'94 De nem! Ez az, amit siettettetek: sz\'e9l, amelyben f\'e1jdalmas gy\'f6
trelem van.
\par 25. Elpuszt\'edt mindent az Ura parancs\'e1ra. \'c9s reggelre m\'e1r csak a lakhelyeik [romjai] l\'e1tsz\'f3dtak. \'c9s ekk\'e9ppen fizet\'fcnk meg a gonosztev\'f5 n\'e9pnek.
\par 
\par 26. Pedig olyan hatalmat adtunk nekik, amit nektek sem adtunk. \'c9s adtunk nekik hall\'e1st, \'e9s l\'e1t\'e1st \'e9s sz\'edvet. \'c1m nem haszn\'e1lt nekik semmit sem a hall\'e1suk, sem a l\'e1t\'e1suk, sem a sz\'edv\'fck, mivel [folyamatosan] tagadt
\'e1k Allah jeleit. \'c9s k\'f6rbeker\'edtette \'f5ket az [a b\'fcntet\'e9s], amib\'f5l g\'fanyt \'fbztek.
\par 27. \'c9s m\'e1r [kor\'e1bban] elpuszt\'edtottuk a telep\'fcl\'e9seket k\'f6r\'fcl\'f6ttetek, \'e9s felsorakoztattuk a jeleket, az\'e9rt hogy visszat\'e9rjenek.
\par 28. H\'e1t mi\'e9rt nem seg\'edtett\'e9k meg \'f5ket azok, amelyeket istenekk\'e9 tettek meg maguknak Allah helyett, hogy k\'f6zelebb ker\'fclhessenek [\'d5hozz\'e1]? De nem! Elt\'fbntek mell\'f5l\'fck. \'c9s ez az \'f5 hazugs\'e1guk \'e9s az, amit kital
\'e1ltak.
\par 
\par 29. \'c9s [eml\'e9kezz arra,] amikor egy csapat dzsinnt ir\'e1ny\'edtottunk hozz\'e1d, [hogy] hallgass\'e1k a Kor\'e1nt! \'c9s amikor jelen voltak [a recit\'e1l\'e1s\'e1n], azt mondt\'e1k: \'84Figyeljetek csendben!\'94 \'c9s amikor befejez\'f5d\'f6
tt, visszamentek a n\'e9p\'fckh\'f6z, hogy figyelmeztess\'e9k [\'f5ket].
\par 30. Azt mondt\'e1k: \'84\'d3 n\'e9p\'fcnk! Bizony, mi hallottunk egy \'cdr\'e1st, amely M\'f3zes ut\'e1n bocs\'e1ttatott le igazolv\'e1n annak igazs\'e1g\'e1t, ami el\'f5tte volt, [\'e9s amely] az igazs\'e1gra \'e9s egyenes \'fatra vezet.
\par 31. \'d3 n\'e9p\'fcnk! Hallgassatok az Allahhoz h\'edv\'f3ra (Mohamed pr\'f3f\'e9t\'e1ra) \'e9s higgyetek benne, hogy [Allah] megbocs\'e1ssa a b\'fbneiteket \'e9s megv\'e9delmezzen egy f\'e1jdalmas gy\'f6trelemt\'f5l!
\par 32. \'c9s aki nem hallgat az Allahhoz h\'edv\'f3ra, az nem fogja [semmiben] megakad\'e1lyozni [Allahot] a f\'f6ld\'f6n, \'e9s nincsenek neki \'d5helyette p\'e1rtfog\'f3i. Az ilyenek nyilv\'e1nval\'f3 t\'e9velyg\'e9sben vannak.\'94
\par 
\par 33. Vajon nem gondolkodnak el azon, hogy Allah - aki megteremtette az egeket \'e9s a f\'f6ldet, \'e9s nem f\'e1radt bele a teremt\'e9s\'fckbe - k\'e9pes arra, hogy \'e9letre keltse a holtakat? De igen! Bizony, \'d5 mindenre kiterjed\'f5 hatalm\'fa.
\par 34. \'c9s azon a napon, amikor a hitetlenek a [Pokol-]t\'fbz el\'e9 \'e1ll\'edttatnak [\'e9s az mondatik nekik:] \'84Vajon ez nem igaz?\'94 Azt mondj\'e1k: \'84De igen! Urunkra!\'94 [Allah] azt mondja: \'84\'cdzlelj\'e9tek h\'e1t meg a gy\'f6trelmet, ami
\'e9rt hitetlenek voltatok!\'94
\par 35. Legy\'e9l h\'e1t t\'fcrelmes [\'f3 Mohamed], ahogy t\'fcrelmet tan\'fas\'edtottak az elsz\'e1nts\'e1ggal b\'edr\'f3 k\'fcld\'f6ttek! \'c9s ne siettesd nekik [a b\'fcntet\'e9st]! Azon a napon, amikor megl\'e1tj\'e1k azt, amire \'edg\'e9
retet kaptak, olyan lesz nekik (\'fagy fog t\'fbnni), mintha [az evil\'e1gon] a napb\'f3l csak egyetlen \'f3r\'e1t id\'f5ztek volna. [Ez a Kor\'e1n] \'fczenet [mindenki sz\'e1m\'e1ra]. De vajon [ki m\'e1s] lesz elpuszt\'edtva, mint az engedetlen n\'e9p?}{
\insrsid10757626 
\par 
\par 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid983814 \hich\af0\dbch\af13\loch\f0 47. \hich\af0\dbch\af13\loch\f0 \hich\f0 Mohamed (Mohamed) c. sz\'fa\loch\f0 ra}{
\b0\insrsid10757626\charrsid9516260 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9516260 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9516260 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev
\'e9ben.
\par 
\par 1. Akik hitetlenn\'e9 v\'e1ltak \'e9s t\'e1vol tartottak [m\'e1sokat] Allah \'datj\'e1t\'f3l, azoknak Allah hagyja veszend\'f5be menni a cselekedeteik [jutalm\'e1t].
\par 2. Akik azonban hisznek, j\'f3tetteket cselekszenek \'e9s hisznek abban, ami lebocs\'e1ttatott Mohamednek - az pedig az Igazs\'e1g az \'f5 Urukt\'f3l -, azoknak elt\'f6rli a rossz tetteiket \'e9s jobb\'e1 teszi az \'e1llapotukat.
\par 3. Ez az\'e9rt van, mert akik hitetlenekk\'e9 v\'e1ltak, azok a hamiss\'e1got k\'f6vetik, \'e9s mert akik hisznek, azok az Urukt\'f3l val\'f3 Igazs\'e1got k\'f6vetik. Ekk\'e9ppen ad Allah p\'e9ld\'e1zatokat az emberek sz\'e1m\'e1ra.
\par 4. \'c9s amikor \'f6sszetal\'e1lkoztok [a h\'e1bor\'faban] azokkal, akik hitetlenn\'e9 v\'e1ltak, \'fcssetek r\'e1 a nyakukra [a kardotokkal]! Amikor azt\'e1n v\'e9gleges csap\'e1st m\'e9rtek r\'e1juk, akkor k\'f6t\'f6zz\'e9
tek meg szorosan [a foglyokat], \'e9s ut\'e1na vagy nagylelk\'fbs\'e9gb\'f5l, vagy v\'e1lts\'e1gd\'edj fej\'e9ben [engedj\'e9tek el \'f5ket] - am\'edg a h\'e1bor\'fa v\'e9get nem \'e9r. \'cdgy van ez. Ha Allah \'fagy akarta volna, bizony [harc n\'e9lk\'fc
l] b\'fcntette volna meg \'f5ket, \'e1m az\'e9rt tesz \'edgy, hogy pr\'f3b\'e1ra tegyen egyeseket k\'f6z\'fcletek m\'e1sokkal. \'c9s akik Allah \'fatj\'e1n \'f6letnek meg, azoknak [Allah] nem hagyja veszend\'f5be menni a cselekedeteik [jutalm\'e1t].

\par 5. [Az igaz \'fatra] fogja \'f5ket vezetni \'e9s{\*\bkmkstart 62}{\*\bkmkend 62} jobb\'e1 teszi az \'e1llapotukat.
\par {\*\bkmkstart 72}{\*\bkmkend 72}6. \'c9s bebocs\'e1tja \'f5ket a Paradicsomba, amelyet [m\'e1r] megismertetett vel\'fck.
\par 
\par 7. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha seg\'edts\'e9g\'e9re vagytok Allah [vall\'e1sa \'fcgy\'e9nek], \'d5 is megseg\'edt titeket \'e9s megszil\'e1rd\'edtja l\'e1batokat.

\par 8. \'c9s akik hitetlenn\'e9 v\'e1ltak, azokra pusztul\'e1s [v\'e1r] \'e9s [Allah] hagyja veszend\'f5be menni a cselekedeteik [jutalm\'e1t].}{\insrsid10757626 
\par 9. Ez az\'e9rt [t\'f6rt\'e9nik], mert ut\'e1lt\'e1k azt, amit Allah lebocs\'e1tott (a Kor\'e1nt), \'e9s ez\'e9rt Allah semmiv\'e9 tette a cselekedeteiket.
\par 10. Vajon h\'e1}{\insrsid10757626\charrsid9516260 t nem j\'e1rt\'e1k be a f\'f6ldet, \'e9s nem n\'e9zt\'e9k meg, milyen v\'e9gre jutottak azok, akik el\'f5tt\'fck \'e9ltek? Allah pusztul\'e1st k\'fcld\'f6tt r\'e1juk. \'c9s a hitetleneknek hasonl\'f3 [v
\'e9g\'fck] lesz.
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9516260 {\*\bkmkstart 122}{\*\bkmkend 122}11. Ez az
\'e9rt [van \'edgy], mert Allah azok p\'e1rtfog\'f3ja, akik hisznek, \'e9s mert a hitetleneknek nincs p\'e1rtfog\'f3ja.
\par 
\par 12. Bizony, Allah bebocs\'e1tja azokat, akik hisznek \'e9s j\'f3tetteket cselekszenek olyan kertekbe [a Paradicsomban], amelyek al\'f3l foly\'f3k folynak. \'c9s akik hitetlenn\'e9 v\'e1ltak, azok \'e9lvezik [az evil\'e1gi \'e9let muland\'f3 \'f6r\'f6
meit] \'e9s csak esznek, amik\'e9ppen a j\'f3sz\'e1gok esznek. \'c9s a [Pokol-]t\'fbz lesz az \'f5 otthonuk.
\par 13. \'c9s h\'e1ny olyan telep\'fcl\'e9s volt, amely er\'f5sebb [volt] a te telep\'fcl\'e9sedn\'e9l (Mekk\'e1n\'e1l), amely el\'fbz\'f6tt t\'e9ged [\'f3 Mohamed], \'e1m Mi elpuszt\'edtottuk azokat, \'e9s nem volt nekik seg\'edt\'f5j\'fck.
\par 14. \'c9s vajon az, akinek nyilv\'e1nval\'f3 bizony\'edt\'e9ka van az Ur\'e1t\'f3l, olyan lenne, mint azok, akiknek d\'edszess\'e9 t\'e9tetett a rossz cselekedet\'fck, \'e9s akik a k\'e9ny\'fcket k\'f6vetik?
\par {\*\bkmkstart 162}{\*\bkmkend 162}15. A Paradicsom le\'edr\'e1sa, amelyre \'edg\'e9retet kaptak az istenf\'e9l\'f5k: vannak benne nem poshad\'f3 viz\'fb foly\'f3k, \'e9s nem v\'e1ltoz\'f3 \'edz\'fb tejjel [foly\'f3] foly\'f3k, \'e9s borral [foly\'f3] foly
\'f3k, \'e9lvezet\'fcl az [abb\'f3l] iv\'f3knak, \'e9s tiszt\'edtott m\'e9zzel [foly\'f3] foly\'f3k. \'c9s lesz nekik ott mindenf\'e9le gy\'fcm\'f6lcs\'fck \'e9s megbocs\'e1t\'e1s az Urukt\'f3l. [Akik mindezekben r\'e9szes\'fc
lnek] olyanok-e, mint azok, akik \'f6r\'f6kk\'e9 a [Pokol-]t\'fbzben maradnak, [akik] forr\'e1sban l\'e9v\'f5 vizet kapnak inni, \'e9s [ami] sz\'e9tt\'e9pi a beleiket?
\par 
\par 16. \'c9s vannak k\'f6zt\'fck olyanok, akik meghallgatnak t\'e9ged. De mikor elmennek t\'f5led, azt mondj\'e1k azoknak, akiknek tud\'e1s adatott: \'84Mit is mondott az im\'e9nt?\'94 \'d5k azok, akiknek Allah lepecs\'e9telte a sz\'edv\'e9t, \'e9
s [akik] a k\'e9ny\'fcket k\'f6vetik.
\par 17. \'c9s akik r\'e1leltek az igaz \'fatra, azokat [Allah] gyarap\'edtja \'fatmutat\'e1sban, \'e9s istenf\'e9lelemmel l\'e1tja el \'f5ket.
\par 18. H\'e1t vajon mi m\'e1sra v\'e1rnak, mint hogy elj\'f6jj\'f6n hozz\'e1juk az \'d3ra (a Felt\'e1mad\'e1s) v\'e1ratlanul? Elj\'f6ttek imm\'e1r az el\'f5jelei. Hogyan is lehetne [hasznukra] az eml\'e9kez\'e9s\'fck, ha m\'e1r elj\'f6tt hozz\'e1juk [az \'d3
ra]?
\par {\*\bkmkstart 201}{\*\bkmkend 201}19. Tudd h\'e1t meg, hogy Allahon k\'edv\'fcl nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, \'e9s k\'e9rj bocs\'e1natot a b\'fbn\'f6d\'e9rt \'e9s a h\'edv\'f5 f\'e9rfiak \'e9s a h\'edv\'f5 n\'f5k [b\'fbnei\'e9rt]! \'c9
s Allah tudja, hogy merre j\'e1rtok-keltek [nappal] \'e9s hol nyugszotok [\'e9jjel].
\par 
\par 20. \'c9s azok, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben] azt mondj\'e1k: \'84Mi\'e9rt nem bocs\'e1ttatott le egy sz\'fara [a harcr\'f3l]?\'94 \'c1m amikor egy\'e9rtelm\'fb sz\'fara bocs\'e1
ttatik le \'e9s megeml\'edtettik benne a harc, akkor l\'e1thatod [\'f3 Mohamed], hogy azok, akiknek a sz\'edv\'e9ben betegs\'e9g van, \'fagy n\'e9znek r\'e1d, mint aki el\'e1jul a hal\'e1lt\'f3l [val\'f3 f\'e9lelm\'e9ben]. \'c1m jobb lenne nekik
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9516260 21. [Az Allahnak val\'f3] engedelmess\'e9g \'e9
s [a] hely\'e9nval\'f3 besz\'e9d. \'c9s ha m\'e1r eld\'f6ntetett az \'fcgy (elrendeltetett a harc), [a k\'e9pmutat\'f3k gy\'fbl\'f6letet tan\'fas\'edtanak ir\'e1nta]. \'c1m ha igazak lenn\'e9nek Allahhal szemben (hinn\'e9nek \'e9s j\'f3t cselekedn\'e9
nek), az jobb lenne nekik.
\par 22. \'c9s vajon [mi m\'e1s lenne], ha ti h\'e1tat ford\'edtan\'e1tok [a Kor\'e1nnak], mint hogy roml\'e1st okozn\'e1tok a f\'f6ld\'f6n \'e9s megszak\'edtan\'e1tok a rokoni kapcsolatokat?
\par 23 \'d5k azok, akiket el\'e1tkozott Allah, \'edgy megs\'fcket\'edtette \'f5ket, \'e9s vakk\'e1 tette a l\'e1t\'e1sukat [az igazs\'e1got illet\'f5en].
\par 24. H\'e1t vajon nem gondolkodnak el a Kor\'e1non? Vagy lakat van a sz\'edv\'fck\'f6n?
\par 
\par 25. Bizony, akik hitehagy\'f3v\'e1 v\'e1lnak azut\'e1n, hogy nyilv\'e1nval\'f3v\'e1 v\'e1lt sz\'e1mukra az \'fatmutat\'e1s, azokat a s\'e1t\'e1n csalta l\'e9pre, \'e9s hamis rem\'e9nyt adott nekik.
\par {\*\bkmkstart 271}{\*\bkmkend 271}26. Ez [az\'e9rt van \'edgy], mert azt mondt\'e1k azoknak, akik ut\'e1lt\'e1k azt, amit Allah lebocs\'e1tott: \'84Engedelmesked\'fcnk nektek az \'fcgy egy r\'e9sz\'e9ben.\'94 \'c1m Allah ismeri a titkaikat.
\par {\*\bkmkstart 281}{\*\bkmkend 281}27. \'c9s hogyan [lesz majd], amikor elsz\'f3l\'edtj\'e1k \'f5ket [a hal\'e1l] angyalai, mik\'f6zben \'fctik az arcukat \'e9s a h\'e1tukat?
\par 28. Ez [az\'e9rt van \'edgy], mert \'f5k azt k\'f6vett\'e9k, ami megharag\'edtotta Allahot \'e9s ut\'e1lt\'e1k [azt, amivel elnyerhetik] az \'d5 el\'e9gedetts\'e9g\'e9t, \'e9s ez\'e9rt [Allah] semmiv\'e9 tette a cselekedeteiket.
\par 29. Vagy azt gondolj\'e1k azok, akiknek a sz\'edv\'e9ben betegs\'e9g van, hogy Allah nem leplezi le a gy\'fbl\'f6lk\'f6d\'e9seiket?
\par 
\par 30. \'c9s ha \'fagy akarn\'e1nk, megmutatn\'e1nk \'f5ket neked [\'f3 Mohamed] \'e9s bizony, felismern\'e9d \'f5ket az ismertet\'f5jeleikr\'f5l. \'c9s bizonyosan felismered \'f5ket a besz\'e9d\'fck hanghordoz\'e1s\'e1b\'f3l. \'c9s Allahnak tudom\'e1
sa van a cselekedeteitekr\'f5l.
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9516260 31. \'c9s bizony, pr\'f3b\'e1ra tesz\'fc
nk titeket [a harc \'e1ltal], am\'edg [nyilv\'e1nval\'f3v\'e1 tessz\'fck az embereknek azt, amit m\'e1r] tudtunk az [Allah \'fatj\'e1n] er\'f5fesz\'edt\'e9st tev\'f5kr\'f5l, \'e9s a t\'fcrelmesekr\'f5l, \'e9s pr\'f3b\'e1ra tessz\'fck (felsz\'ed
nre hozzuk) a h\'edreiteket (cselekedeteiteket \'e9s mond\'e1saitokat).
\par 32. Bizony, akik hitetlenn\'e9 v\'e1ltak \'e9s t\'e1vol tartanak m\'e1sokat Allah \'fatj\'e1t\'f3l, \'e9s szembeszeg\'fclnek a K\'fcld\'f6ttel azut\'e1n, hogy nyilv\'e1nval\'f3v\'e1 v\'e1lt sz\'e1mukra az \'fatmutat\'e1s, azok nem lehetnek Allah k\'e1r
\'e1ra semmiben. \'c9s [Allah] semmiss\'e9 fogja tenni a cselekedeteiket.
\par 
\par 33. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Engedelmeskedjetek Allahnak \'e9s a K\'fcld\'f6ttnek \'e9s ne tegy\'e9tek semmiv\'e9 a cselekedeteiket!
\par 34. \'c9s bizony, akik hitetlenn\'e9 v\'e1ltak \'e9s t\'e1vol tartanak [m\'e1sokat] Allah \'fatj\'e1t\'f3l, azut\'e1n pedig hitetlenk\'e9nt halnak meg, h\'e1t azoknak Allah nem fog megbocs\'e1tani.
\par 35. \'c9s ne lankadjatok [az ellens\'e9ggel szemben], \'e9s ne sz\'f3l\'edtsatok fel a b\'e9k\'e9re, hiszen ti vagytok a fel\'fclkereked\'f5k! \'c9s Allah veletek van \'e9s nem fogja cs\'f6kkenteni a cselekedeteitek [jutalm\'e1t].
\par 36. Az evil\'e1gi \'e9let csup\'e1n j\'e1tszadoz\'e1s \'e9s sz\'f3rakoz\'e1s. \'c1m ha hisztek \'e9s istenf\'e9l\'f5k vagytok, Allah megadja nektek a fizets\'e9geteket \'e9s nem k\'e9ri el t\'f5letek a javaitok [eg\'e9sz\'e9t].
\par 37. Ha elk\'e9rn\'e9 t\'f5letek [a javaitokat], \'e9s megterhelne titeket, ti fukarok lenn\'e9tek \'e9s \'d5 leleplezn\'e9 a gy\'fbl\'f6lk\'f6d\'e9seiteket.
\par 38. \'cdme, ti azok vagytok, akiket felsz\'f3l\'edtanak, hogy adakozzatok Allah \'fatj\'e1n, de vannak k\'f6z\'f6ttetek, akik fukarkodnak. \'c9s aki fukarkodik, az \'f6nmaga k\'e1r\'e1ra fukarkodik. \'c9s Allah a Gazdag, a szeg\'e9
nyek pedig ti vagytok. Ha pedig elfordultok, akkor egy m\'e1sik n\'e9ppel fog felcser\'e9lni titeket. \'d5k azt\'e1n nem lesznek olyanok, mint [amilyenek] ti [vagytok].}{\insrsid10757626 
\par 
\par 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid983814 \hich\af0\dbch\af13\loch\f0 48. A \hich\af0\dbch\af13\loch\f0 \hich\f0 gy\'f5\loch\f0 \hich\f0 zelem (al-Fath) c. sz\'fa
\loch\f0 ra}{\insrsid10757626\charrsid9516260 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9516260 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9516260 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev
\'e9ben.
\par 
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9516260 1. Bizony, Mi nyilv\'e1nval\'f3 gy\'f5
zelmet adtunk neked [\'f3 Mohamed],
\par 2. Hogy Allah megbocs\'e1ssa el\'f5z\'f5 b\'fbneidet \'e9s a k\'e9s\'f5bbieket, \'e9s kiteljes\'edtse a j\'f3t\'e9tem\'e9ny\'e9t ir\'e1ntad \'e9s egyenes \'faton vezessen t\'e9ged,
\par 3. \'c9s hogy Allah m\'e9lt\'f3s\'e1gteljes seg\'edts\'e9ggel seg\'edtsen t\'e9ged.
\par 4. \'d5 az, aki lebocs\'e1totta a nyugalmat a h\'edv\'f5k sz\'edv\'e9be, hogy gyarapodjanak hitben a hit\'fck\'f6n fel\'fcl. \'c9s Allah\'e9 az egek \'e9s a f\'f6ld seregei. \'c9s Allah Mindentud\'f3, B\'f6lcs.
\par 
\par 5. [Az\'e9rt,] hogy a h\'edv\'f5 f\'e9rfiakat \'e9s a h\'edv\'f5 n\'f5ket olyan kertekbe bocs\'e1ssa be [a Paradicsomban], amelyek al\'f3l patakok folynak \endash  \'f6r\'f6kk\'e9 abban fognak maradni \endash , \'e9s [hogy] elt\'f6r\'f6
lje a rossz tetteiket. \'c9s ez hatalmas diadal Allah el\'f5tt.
\par 6. \'c9s [hogy] megb\'fcntesse a k\'e9pmutat\'f3 f\'e9rfiakat \'e9s a k\'e9pmutat\'f3 n\'f5ket, \'e9s az [Allah mell\'e9] t\'e1rsistent helyez\'f5 f\'e9rfiakat \'e9s az [Allah mell\'e9] t\'e1rsistent helyez\'f5 n\'f5ket, akik Allahr\'f3l rosszat felt\'e9
teleznek. K\'f6rbeveszi \'f5ket a rossz sorsfordulat, \'e9s Allah megharagudott r\'e1juk \'e9s meg\'e1tkozta \'f5ket, \'e9s el\'f5k\'e9sz\'edtette nekik a Gyehenn\'e1t. \'c9s milyen rossz v\'e9gc\'e9l!
\par 7. \'c9s Allah\'e9 az egek \'e9s a f\'f6ld seregei. \'c9s Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.
\par 
\par 8. Bizony, Mi elk\'fcldt\'fcnk t\'e9ged [\'f3 Mohamed], tan\'fak\'e9nt}{\highlight7\insrsid10757626\charrsid9516260 ,}{\insrsid10757626\charrsid9516260  \'f6r\'f6mh\'edrhoz\'f3k\'e9nt \'e9s figyelmeztet\'f5k\'e9nt,
\par 9. Hogy higgyetek Allahban \'e9s a k\'fcld\'f6tt\'e9ben, \'e9s t\'e1mogass\'e1tok [a vall\'e1s\'e1t] \'e9s nagyra becs\'fclj\'e9tek \'d5t, \'e9s magasztalj\'e1tok \'d5t hajnalban \'e9s k\'e9s\'f5 d\'e9lut\'e1n!
\par 
\par 10. Bizony, akik h\'fbs\'e9gesk\'fct tesznek neked, azok val\'f3j\'e1ban Allahnak tesznek h\'fbs\'e9gesk\'fct. Allah keze van a kez\'fck f\'f6l\'f6tt [amelyet Mohamed Pr\'f3f\'e9t\'e1nak ny\'fajtanak]. Aki megszegi [a h\'fbs\'e9gesk\'fct], az csup\'e1n 
\'f6nmaga ellen szegi meg. Aki azonban teljes\'edti az egyezs\'e9get, amit Allahhal k\'f6t\'f6tt, h\'e1t annak [Allah] hatalmas fizets\'e9get fog adni.
\par 11. Akik h\'e1tramaradtak a beduinok k\'f6z\'fcl [Hudejbia napj\'e1n], azt fogj\'e1k neked mondani: \'84A vagyonunk \'e9s a csal\'e1djaink foglaltak le minket. K\'e9rj h\'e1t [Allaht\'f3l] bocs\'e1natot sz\'e1munkra!\'94 Azt mondj\'e1k a nyelv\'fc
kkel, ami nincs a sz\'edv\'fckben. Mondd [\'f3 Mohamed]: \'84Kinek \'e1ll hatalm\'e1ban [b\'e1rmit is tenni] Allahhal szemben, ha \'d5 \'e1rtalmat akar [elt\'e1vol\'edtani] r\'f3latok, vagy hasznot akar [hozni] sz\'e1motokra?\'94 \'c1m Allah j\'f3
l ismeri mindazt, amit cselekszetek.
\par {\*\bkmkstart 131}{\*\bkmkend 131}12. De nem! Ti \'fagy v\'e9lt\'e9tek, hogy a K\'fcld\'f6tt \'e9s a h\'edv\'f5k nem t\'e9rnek vissza soha a csal\'e1djaikhoz. \'c9s d\'edszess\'e9 t\'e9tetett ez a sz\'edvetekben, \'e9s rosszat felt\'e9teleztetek. \'c9
s ti egy elpusztul\'f3, [mihaszna] n\'e9p lettetek.
\par 13. \'c9s aki nem hisz Allahban \'e9s a K\'fcld\'f6tt\'e9ben, h\'e1t Mi bizony a L\'e1ngol\'f3 [Pokol-t\'fczet] k\'e9sz\'edtett\'fck el\'f5 a hitetleneknek!
\par 
\par 14. \'c9s Allah\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett. Megbocs\'e1t annak, akinek akar, \'e9s megb\'fcnteti azt, akit akar. \'c9s Allah Megbocs\'e1t\'f3, K\'f6ny\'f6r\'fcletes.{\*\bkmkstart 151}{\*\bkmkend 151}
\par 15. Akik [kor\'e1bban] h\'e1tramaradtak [a beduinok k\'f6z\'fcl], azt fogj\'e1k mondani, amikor elindultok a [khajbari] zs\'e1km\'e1nyok fel\'e9, hogy megszerezz\'e9tek [azt]: \'84Hadd tartsunk veletek!\'94 Meg akarj\'e1k v\'e1ltoztatni Allah szav\'e1
t. Mondd [\'f3 Mohamed]: \'84Nem fogtok vel\'fcnk tartani! Ekk\'e9ppen sz\'f3lott Allah kor\'e1bban.\'94 \'d5k pedig azt mondj\'e1k majd: \'84Nem, ti irigykedtek r\'e1nk.\'94 De nem! \'d5k csup\'e1n kev\'e9ss\'e9 \'e9rtenek.
\par {\*\bkmkstart 171}{\*\bkmkend 171}
\par 16. Mondd a h\'e1tramaradt beduinoknak: \'84Hatalmas hader\'f5vel b\'edr\'f3 n\'e9p ellen lesztek h\'edvatva, akikkel harcolni fogtok, vagy [harc n\'e9lk\'fcl] al\'e1vetik magukat [Allah akarat\'e1nak]. \'c9s ha pedig engedelmeskedtek, akkor Allah sz\'e9
p fizets\'e9get ad nektek. \'c1m ha h\'e1tat ford\'edtotok, ahogyan kor\'e1bban h\'e1tat ford\'edtottatok, akkor f\'e1jdalmas gy\'f6trelemmel fog megb\'fcntetni titeket.\'94
\par 17. Ne \'e9rezzen fesz\'e9lyezetts\'e9get a vak, sem a s\'e1nta, sem a beteg [ha nem vesz r\'e9szt a harcban]! Aki engedelmeskedik Allahnak \'e9s a K\'fcld\'f6tt\'e9nek, azt [Allah] kertekbe bocs\'e1tja be [a Paradicsomban], amelyek al\'f3l foly\'f3
k folynak. Aki azonban h\'e1tat ford\'edt, azt f\'e1jdalmas gy\'f6trelemmel fogja megb\'fcntetni.
\par 
\par 18. Bizony, Allah m\'e1r el\'e9gedett lett a h\'edv\'f5kkel [akkor], amikor h\'fbs\'e9gesk\'fct tettek neked a fa alatt. \'c9s tudta, hogy mi volt a sz\'edv\'fckben, ez\'e9rt nyugalmat bocs\'e1tott le r\'e1juk \'e9s k\'f6zeli gy\'f5
zelemmel jutalmazta meg \'f5ket,
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9516260 19. \'c9s azzal, hogy sok zs\'e1km\'e1
nyt szereznek [Khajbarban]. \'c9s Allah M\'e9lt\'f3s\'e1gteljes, B\'f6lcs.
\par 20. Allah meg\'edg\'e9rte nektek, hogy sok zs\'e1km\'e1nyt szereztek, \'e9s siettette ezt nektek \'e9s t\'e1vol tartotta az emberek kez\'e9t t\'f5letek, hogy [ez] jel legyen a h\'edv\'f5knek, \'e9s hogy \'d5 az egyenes \'faton vezessen titeket.
\par }\pard\plain \s99\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\cf1\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9516260 21. \'c9s m\'e1s [zs\'e1km\'e1nyt is \'edg
\'e9rt nektek], ami f\'f6l\'f6tt m\'e9g nincsen hatalmatok. \'c1m Allah m\'e1r k\'f6r\'fclvette azt [v\'e9delm\'e9vel sz\'e1motokra]. \'c9s Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 22. \'c9s ha azok, akik hitetlenn\'e9 v\'e1ltak, harcoln\'e1nak ellenetek, akkor bizony, h\'e1tukat ford\'edtan\'e1k (megfutamodn\'e1nak). Azt\'e1n nem tal\'e1ln\'e1nak sem gy\'e1mol\'edt\'f3t, sem pedig seg\'edt\'f5t.{\*\bkmkstart 23}{\*\bkmkend 23}

\par 23. [Ez] Allah [\'e1ltal elrendelt] t\'f6rv\'e9nyszer\'fbs\'e9g, ami m\'e1r kor\'e1bban v\'e9gbement. \'c9s nem tal\'e1lsz az Allah [\'e1ltal elrendelt] t\'f6rv\'e9nyszer\'fbs\'e9gben [semmif\'e9le] v\'e1ltoz\'e1st.
\par 
\par 24. \'c9s \'d5 az, aki t\'e1vol tartotta a kez\'fcket t\'f5letek \'e9s a ti kezeteket t\'f5l\'fck Mekka [k\'fcls\'f5] ter\'fclet\'e9n, miut\'e1n \'d5\'e1ltala fel\'fclkerekedtetek rajtuk. \'c9s Allah l\'e1tja mindazt, amit cselekszetek.
\par 25. \'d5k azok, akik hitetlenn\'e9 v\'e1ltak \'e9s t\'e1vol tartottak titeket a Szent Mecsett\'f5l, \'e9s megakad\'e1lyoztak [titeket] az \'e1ldozati \'e1llatok eljuttat\'e1s\'e1ban a kijel\'f6lt \'e1ldoz\'f3helyre. Ha nem lettek volna sz\'e1
motokra ismeretlen h\'edv\'f5 f\'e9rfiak \'e9s h\'edv\'f5 n\'f5k [Mekk\'e1ban], letapost\'e1tok volna \'f5ket [ha Allah megengedte volna sz\'e1motokra a v\'e1laszcsap\'e1st] \'e9s ezzel v\'e9tkeztetek volna miattuk, an\'e9lk\'fcl hogy tudt\'e1
tok volna. [Allah az\'e9rt rendelkezett \'edgy], hogy bebocs\'e1ssa a k\'f6ny\'f6r\'fclet\'e9be azt, akit akar. Ha elk\'fcl\'f6n\'fcltek volna [a h\'edv\'f5k a hitetlenekt\'f5l], akkor f\'e1jdalmas gy\'f6trelemmel b\'fcntett\'fc
k volna azokat, akik hitetlenn\'e9 v\'e1ltak.
\par 26. [Eml\'edtsd meg,] amikor [Allah] azok sz\'edv\'e9be, akik hitetlenn\'e9 v\'e1ltak, d\'f6lyf\'f6ss\'e9get helyezett - a tudatlans\'e1g kor\'e1nak d\'f6lyf\'f6ss\'e9g\'e9t -, \'e1m Allah T\'f5le val\'f3 nyugalmat bocs\'e1tott le a K\'fcld\'f6tt\'e9re 
\'e9s a h\'edv\'f5kre, \'e9s az istenf\'e9lelem szav\'e1ra k\'f6telezte \'f5ket. \'d5k voltak arra a legjogosultabbak \'e9s m\'e9lt\'f3k voltak r\'e1. \'c9s Allah minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 
\par 27. Bizony, Allah m\'e1r beteljes\'edtette K\'fcld\'f6tt\'e9nek a l\'e1tom\'e1s\'e1t az igazs\'e1gnak megfelel\'f5en: \'84Be fogtok l\'e9pni, ha Allah \'fagy akarja, a Szent Mecsetbe biztons\'e1gban, leborotv\'e1lt fejjel \'e9s r\'f6vidre v\'e1
gott hajjal, an\'e9lk\'fcl hogy f\'e9ln\'e9tek.\'94 \'d5 tudta azt, amit ti nem tudtatok. \'c9s az el\'f5tt egy k\'f6zeli gy\'f5zelmet adott nektek (a Hudajbijai egyezm\'e9ny megk\'f6t\'e9se \'e1ltal).
\par 28. \'d5 az, aki elk\'fcldte a K\'fcld\'f6tt\'e9t az \'fatmutat\'e1ssal \'e9s az igaz vall\'e1ssal, hogy azt a t\'f6bbi vall\'e1s f\'f6l\'e9 helyezze. \'c9s elegend\'f5 Allah tan\'fanak!
\par 29. Mohamed Allah K\'fcld\'f6tte; \'e9s akik vele vannak, azok szigor\'faak a hitetlenekkel szemben \'e9s k\'f6ny\'f6r\'fcletesek egym\'e1s ir\'e1nt. L\'e1tod \'f5ket, amint meghajolnak \'e9s leborulnak [az im\'e1dkoz\'e1sban] az Allaht\'f3l val\'f3
 kegyet \'e9s az \'d5 megel\'e9ged\'e9s\'e9t \'e1h\'edtozv\'e1n. Az \'f5 ismertet\'f5jel\'fck az arcukon van, a leborul\'e1s nyom\'e1t\'f3l. Ez az \'f5 p\'e9ld\'e1zatuk (ismertet\'f5jel\'fck) a T\'f3r\'e1ban, \'e9s ez az \'f5 p\'e9ld\'e1zatuk (ismertet
\'f5jel\'fck) az Evang\'e9liumban: olyanok \'f5k, mint egy vet\'f5mag, amely hajt\'e1st hoz, majd meger\'f5s\'edti azt, azt\'e1n megvastagszik, \'e9s egyenesen \'e1ll a sz\'e1r\'e1n, a sz\'e1nt\'f3vet\'f5k tetsz\'e9s\'e9re, hogy \'d5 [Allah] feld\'fch\'ed
tse \'e1ltaluk a hitetleneket. Allah megbocs\'e1t\'e1st \'e9s hatalmas fizets\'e9get \'edg\'e9rt azoknak k\'f6z\'fcl\'fck, akik hisznek \'e9s j\'f3tetteket cselekszenek.
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid983814 \hich\af0\dbch\af13\loch\f0 \hich\f0 49. A szob\'e1\loch\f0 \hich\f0 k (al-Hudzsur\'e1\loch\f0 \hich\f0 t) c. sz\'fa
\loch\f0 ra}{\b0\fs24\insrsid10757626\charrsid10117349 
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid10117349 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10117349 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne helyezz\'e9tek [v\'e9lem\'e9nyeteket] Allah \'e9s a K\'fcld\'f6tte [d\'f6nt\'e9se] el\'e9, \'e9s f\'e9lj\'e9
tek Allahot! Bizony, Allah mindent Hall\'f3, Mindentud\'f3.
\par 2. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne emelj\'e9tek fel hangotokat a Pr\'f3f\'e9ta hangja f\'f6l\'e9 \'e9s ne \'fagy sz\'f3l\'edts\'e1tok meg \'f5t a besz\'e9
detekben, ahogyan egyik\'f5t\'f6k a m\'e1sikat sz\'f3l\'edtja meg, nehogy semmiv\'e9 v\'e1ljanak a cselekedeteitek mik\'f6zben \'e9szre sem veszitek!
\par 3. Bizony, akik lehalk\'edtj\'e1k a hangjukat Allah K\'fcld\'f6tte el\'f5tt, \'f5k azok, akiknek a sz\'edv\'e9t Allah pr\'f3b\'e1ra tette az\'e9rt, hogy [el\'e9rj\'e9k] az istenf\'e9lelmet. Megbocs\'e1t\'e1s \'e9s hatalmas fizets\'e9g j\'e1r nekik.
\par 4. Bizony, akik a szob\'e1k m\'f6g\'fcl sz\'f3l\'edtanak t\'e9ged [hangosan], azok legt\'f6bbje nem \'e9l az esz\'e9vel.
\par 5. \'c9s ha t\'fcrelmesek lettek volna, am\'edg kim\'e9sz hozz\'e1juk, az bizony jobb lett volna nekik. De Allah Megbocs\'e1t\'f3, K\'f6ny\'f6r\'fcletes.
\par 
\par 6. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha egy engedetlen [ember] j\'f6n hozz\'e1tok egy h\'edrrel, akkor bizonyosodjatok meg fel\'f5le, nehogy tudatlans\'e1gb\'f3l s\'fa
jtsatok le egy n\'e9pre, \'e9s emiatt [k\'e9s\'f5bb] megb\'e1nj\'e1tok azt, amit tettetek!
\par 7. \'c9s tudj\'e1tok meg, hogy Allah K\'fcld\'f6tte k\'f6ztetek van! Ha engedelmeskedne nektek sok dologban, akkor neh\'e9z helyzetbe ker\'fcln\'e9tek. \'c1m Allah megszerettette veletek a hitet \'e9s d\'edszess\'e9 tette a sz\'edvetekben, \'e9s ut\'e1
latoss\'e1 tette nektek a hitetlens\'e9get, az engedetlens\'e9get \'e9s az ellenszeg\'fcl\'e9st. \'d5k bizony azok, akik a helyes \'faton j\'e1rnak.
\par 8. [Ez adatott nektek] kegyk\'e9nt Allaht\'f3l \'e9s j\'f3t\'e9tem\'e9nyk\'e9nt. \'c9s Allah Mindentud\'f3, B\'f6lcs.
\par 
\par 9. \'c9s ha a h\'edv\'f5k k\'f6z\'fcl k\'e9t csoport harcol egym\'e1ssal, akkor k\'f6ssetek b\'e9k\'e9t k\'f6z\'f6tt\'fck! \'c1m ha az egyik [tov\'e1bbra is] zsarnokoskodni [akar] a m\'e1sikon, akkor harcoljatok az ellen, amely zsarnokoskodik, addig am
\'edg vissza nem t\'e9r Allah parancs\'e1hoz! Ha visszat\'e9r, akkor igazs\'e1ggal k\'f6ssetek b\'e9k\'e9t k\'f6z\'f6tt\'fck, \'e9s j\'e1rjatok el igazs\'e1gosan! Allah szereti az igazs\'e1gosakat.
\par 10. Bizony, a h\'edv\'f5k csak testv\'e9rek [lehetnek]! K\'f6ssetek h\'e1t b\'e9k\'e9t k\'e9t testv\'e9retek k\'f6z\'f6tt, \'e9s f\'e9lj\'e9tek Allahot, h\'e1tha k\'f6ny\'f6r\'fcletre leltek!}{\insrsid10757626 
\par 
\par 11. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne g\'fanyol\'f3djon egy n\'e9p sem egy m\'e1sik n\'e9pen, [akik] tal\'e1n jobbak \'f5n\'e1luk! \'c9s a n\'f5k se [g\'fanyol\'f3djanak] m
\'e1s n\'f5k\'f6n, [akik] tal\'e1n jobbak \'f5n\'e1luk. \'c9s ne becsm\'e9relj\'e9tek egym\'e1st, \'e9s ne sz\'f3l\'edts\'e1tok egym\'e1st g\'fanyneveken! Milyen nyomor\'fas\'e1gos, ha engedetlennek neveznek [valakit], miut\'e1n h\'edv\'f5
 lett. Akik pedig nem tan\'fas\'edtanak b\'fbnb\'e1natot, h\'e1t azok bizony az igazs\'e1gtalanok.
\par 12. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ker\'fclj\'e9tek a legt\'f6bb v\'e9leked\'e9st (a gyanakv\'e1s t\'f6bbs\'e9g\'e9t)! Bizony, n\'e9mely v\'e9leked\'e9s b\'fbn. \'c9s ne k
\'e9mkedjetek, \'e9s ne besz\'e9lje ki egyik\'f5t\'f6k a m\'e1sikat t\'e1voll\'e9t\'e9ben! Vajon szeretn\'e9 egyik\'f5t\'f6k a halott testv\'e9re h\'fas\'e1t enni? H\'e1t [nem], ti ut\'e1ln\'e1tok azt [ez\'e9rt tart\'f3zkodjatok a kibesz\'e9l\'e9st\'f5
l is]! \'c9s f\'e9lj\'e9tek Allahot! Bizony, Allah Kiengesztel\'f5d\'f5, Irgalmas.
\par 13. \'84\'d3 ti, emberek! Bizony, Mi egy f\'e9rfib\'f3l \'e9s egy n\'f5b\'f5l teremtett\'fcnk titeket, \'e9s n\'e9pekk\'e9 \'e9s t\'f6rzsekk\'e9 tett\'fcnk benneteket, hogy megismerj\'e9tek egym\'e1st. Bizony, a legnemesebb k\'f6z\'fcletek Allah el\'f5
tt, aki a legistenf\'e9l\'f5bb. Bizony, Allah Mindentud\'f3, [mindent] j\'f3l Ismer\'f5.
\par 
\par 14. A beduinok azt mondj\'e1k: \'84Hisz\'fcnk!\'94 Mondd [\'f3 Mohamed]: \'84Ti nem hisztek! Hanem mondj\'e1tok [ink\'e1bb] azt, [hogy] }{\insrsid10757626\charrsid10117349 al\'e1vetett\'fck magunkat [Allah akarat\'e1nak]! A hit m\'e9g nem jutott be a sz
\'edvetekbe.\'94 De ha engedelmeskedtek Allahnak \'e9s a K\'fcld\'f6tt\'e9nek, [Allah] semmiben sem fog megr\'f6vid\'edteni titeket a cselekedeteitek [jutalm\'e1t] illet\'f5en. Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 15. Bizony, a h\'edv\'f5k azok, akik hisznek Allahban \'e9s a K\'fcld\'f6tt\'e9ben, majd nem k\'e9telkednek, \'e9s er\'f5fesz\'edt\'e9st tesznek Allah \'fatj\'e1n vagyonukkal \'e9s magukkal (\'e9let\'fcket kock\'e1ztatva). \'d5k bizony az igazmond\'f3k.

\par 16. Mondd [\'f3 Mohamed]: \'84Vajon ti t\'e1j\'e9koztatni akarj\'e1tok Allahot a vall\'e1sotokr\'f3l, holott Allah tudja mindazt, ami az egekben \'e9s ami a f\'f6ld\'f6n van?\'94 \'c9s Allah minden dologr\'f3l tudom\'e1ssal b\'edr.}{
\insrsid10757626\charrsid10117349 
\par 17. Felh\'e1nytorgatj\'e1k neked azt, hogy al\'e1vetett\'e9k magukat [Allah akarat\'e1nak]. Mondd [\'f3 Mohamed]: \'84Ne h\'e1nytorgass\'e1tok fel nekem azt, hogy al\'e1vetett\'e9tek magatokat [Allah akarat\'e1nak]! Ellenkez\'f5leg! Allah h\'e1
nytorgathatn\'e1 fel nektek, hogy elvezetett titeket a hithez, ha }{\insrsid10757626\charrsid10117349 val\'f3ban }{\insrsid10757626\charrsid10117349 igazak vagytok [a kijelent\'e9setekben, hogy hisztek].\'94
\par 18. Bizony, Allah tudja az egek \'e9s a f\'f6ld rejtett dolgait. \'c9s Allah \'e1tl\'e1tja azt, amit cselekszetek.}{\insrsid10757626 
\par 
\par 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\fs24\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid983814 \hich\af0\dbch\af13\loch\f0 50\hich\af0\dbch\af13\loch\f0 . \hich\af0\dbch\af13\loch\f0 Q\loch\af0\dbch\af13\hich\f0 
\'e1\loch\f0 \hich\f0 f (Q\'e1\loch\f0 f\hich\af0\dbch\af13\loch\f0 ) \hich\af0\dbch\af13\loch\f0 \hich\f0 c. sz\'fa\loch\f0 ra}{\insrsid10757626\charrsid8458747 
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid8458747 
\par }\pard \qj \li0\ri-1\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin-1\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid8458747 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par }\pard \qj \li0\ri-1\widctlpar\tx374\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin-1\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid8458747 1. Q\'e1f. [Esk\'fcsz\'f6m] a Dics\'f5s\'e9ges Kor\'e1nra [hogy te, \'f3 Mohamed, a felt\'e1mad\'e1
sra figyelmeztet\'f5 vagy].
\par 2. De nem! Csod\'e1lkoztak azon, hogy egy k\'f6z\'fcl\'fck val\'f3 figyelmeztet\'f5 j\'f6tt el hozz\'e1juk, \'e9s azt mondt\'e1k a hitetlenek: \'84Csod\'e1lkoz\'e1sra okot ad\'f3 dolog ez!
\par 3. Vajon ha meghalunk \'e9s porr\'e1 lesz\'fcnk [akkor fel lesz\'fcnk t\'e1masztva]? T\'e1voli visszat\'e9r\'e9s ez!\'94
\par 4. Mi m\'e1r tudjuk, mit vesz el bel\'f5l\'fck a f\'f6ld [a hal\'e1luk ut\'e1n], \'e9s \'f5rz\'f6tt \'cdr\'e1s van n\'e1lunk.
\par 5. De nem! Meghazudtolt\'e1k az Igazs\'e1got (a Kor\'e1nt), amikor elj\'f6tt hozz\'e1juk, \'edgy \'f5k \'f6sszezavarodott helyzetben vannak.
\par 6. Nem n\'e9znek-e az \'e9g fel\'e9 felett\'fck, hogyan \'e9p\'edtett\'fck azt, \'e9s hogyan d\'edsz\'edtett\'fck fel, \'e9s nincsenek abban hasad\'e9kok.
\par 7. A F\'f6ldet pedig sz\'e9tter\'edtett\'fck \'e9s szil\'e1rdan r\'f6gz\'edtetteket (hegyeket) vetett\'fcnk bele, \'e9s minden fajta pomp\'e1s [n\'f6v\'e9nyt] sarjasztottunk rajta.
\par 8. Tiszt\'e1nl\'e1t\'e1st ad\'f3 [tanuls\'e1gk\'e9nt] \'e9s eml\'e9keztet\'f5\'fcl minden [b\'fbnb\'e1n\'f3an] visszat\'e9r\'f5 szolg\'e1nak.
\par 9. \'c9s \'e1ldott vizet bocs\'e1tottunk le az \'e9gb\'f5l, s \'e1ltala kerteket sarjasztottunk \'e9s aratni val\'f3 gabon\'e1t,
\par 10. \'c9s magas datolyap\'e1lm\'e1kat, amelyeknek egym\'e1sra r\'e9tegzett a vir\'e1gzata (term\'e9se).
\par 11. Ell\'e1t\'e1sk\'e9nt a szolg\'e1knak, \'e9s halott ter\'fcletet keltett\'fcnk \'e9letre vele (az es\'f5 \'e1ltal). Ekk\'e9ppen lesz az el\'f5j\'f6vetel [a s\'edrokb\'f3l].
\par 
\par 12. M\'e1r \'f5el\'f5tt\'fck meghazudtol\'e1st k\'f6vetett el No\'e9 n\'e9pe, \'e9s al-Rassz lak\'f3i \'e9s Tam\'fad [t\'f6rzse],
\par 13. \'c9s \'c1d [t\'f6rzse], \'e9s a F\'e1ra\'f3, \'e9s L\'f3t testv\'e9rei (n\'e9pe),
\par 14. \'c9s a cserj\'e9s [erd\'f5] lak\'f3i, \'e9s Tubba n\'e9pe. Mind meghazudtolta a k\'fcld\'f6tteket, \'e9s jogoss\'e1 v\'e1lt a fenyeget\'e9sem [megval\'f3sul\'e1sa].
\par 15. Vajon k\'e9ptelenek lett\'fcnk volna az els\'f5 teremt\'e9sre? De nem! \'d5k zavarodotts\'e1gban vannak egy \'faj teremt\'e9s (a Felt\'e1mad\'e1s) fel\'f5l.
\par 
\par 16. \'c9s bizony, megteremtett\'fck az embert, \'e9s tudjuk, mit sugdos neki \'f6nmaga \'e9s Mi k\'f6zelebb vagyunk hozz\'e1, mint a nyaki \'fct\'f5ere.
\par 17. Amikor a k\'e9t feljegyz\'f5 [angyal] feljegyzi [az ember tetteit], a jobb \'e9s a bal oldal\'e1n \'fclve,
\par 18. Nem ejthet ki egyetlen sz\'f3t sem \'fagy, hogy ne lenne vele egy megfigyel\'f5, aki mindig k\'e9sz [feljegyezni azt].
\par 19. \'c9s elj\'f6tt a hal\'e1l tus\'e1ja az igazs\'e1ggal: \'84Ez az, amit el akart\'e1l ker\'fclni [\'f3 ember].\'94
\par 
\par 20. \'c9s megf\'favatik a k\'fcrt [a Felt\'e1mad\'e1s napj\'e1n]; ez a fenyegetve [meg\'edg\'e9rt] nap.
\par 21. \'c9s el fog j\'f6nni minden ember [\'fagy], hogy lesz vele egy vezet\'f5 \'e9s egy tan\'fa (k\'e9t angyal).
\par 22. Bizony, figyelmen k\'edv\'fcl hagytad ezt, \'e1m felnyitottuk (elt\'e1vol\'edtottuk) az elfed\'f5det, s a l\'e1t\'e1sod ma \'e9les.
\par 23. \'c9s a k\'eds\'e9r\'f5je azt fogja mondani: \'84Itt van az, ami k\'e9szen \'e1ll [a b\'fcntet\'e9sre]!\'94
\par 24. [Allah azt mondja majd:] \'84Ti ketten, vessetek a Gyehenn\'e1ba minden megr\'f6gz\'f6tt hitetlent,
\par 25. J\'f3nak \'fatj\'e1ba \'e1ll\'f3t, hat\'e1rokat \'e1th\'e1g\'f3t, k\'e9telked\'f5t,
\par 26. Aki Allah mell\'e9 m\'e1s istent helyezett! Vess\'e9tek h\'e1t a s\'falyos gy\'f6trelembe!\'94
\par 27. A k\'eds\'e9r\'f5je (egy s\'e1t\'e1n) azt fogja mondani: \'84Urunk, nem k\'e9nyszer\'edtettem \'f5t arra, hogy t\'falkap\'e1sra vetemedjen, hanem [\'f5 maga] messzemen\'f5 t\'e9velyg\'e9sben volt!\'94
\par 28. [Allah] azt fogja mondani: \'84Ne vitatkozzatok el\'f5ttem, hiszen [kor\'e1bban] m\'e1r elk\'fcldtem sz\'e1motokra a fenyeget\'e9sr\'f5l [sz\'f3l\'f3 figyelmeztet\'e9st]!
\par 29. Nem v\'e1ltozik meg a sz\'f3 N\'e1lam (a kor\'e1bban kinyilatkoztatott d\'f6nt\'e9sem), \'e9s \'c9n nem vagyok igazs\'e1gtalan a szolg\'e1kkal (a teremtm\'e9nyekkel).\'94
\par 30. Azon a napon, amikor azt mondjuk a Gyehenn\'e1nak: \'84Vajon megtelt\'e9l m\'e1r?\'94 \'c9s azt fogja mondani [v\'e1laszolv\'e1n]: \'84Van-e m\'e9g t\'f6bb?\'94
\par 31. \'c9s a Paradicsom k\'f6zelebb hozatik [majd] az istenf\'e9l\'f5kh\'f6z, nem lesz messze [t\'f5l\'fck].
\par 32. Ez az, amire \'edg\'e9retet kaptatok, [ez j\'e1r] minden b\'fbnb\'e1n\'f3an visszat\'e9r\'f5nek, [a parancsolatokat] meg\'f5rz\'f5nek,
\par 33. Aki f\'e9li a K\'f6ny\'f6r\'fcletest an\'e9lk\'fcl, hogy l\'e1tn\'e1 [\'d5t] \'e9s [b\'fbnb\'e1n\'f3an] visszat\'e9r\'f5 sz\'edvvel j\'f6n el.
\par 34. L\'e9pjetek be oda b\'e9kess\'e9ggel! Ez az \'d6r\'f6kl\'e9t Napja!
\par 35. Az lesz ott nekik, amit csak akarnak, \'e9s t\'f6bb is van m\'e9g N\'e1lunk.
\par 
\par 36. \'c9s h\'e1ny el\'f5tt\'fck \'e9lt nemzed\'e9ket puszt\'edtottunk el, amelyek er\'f5sebbek voltak \'f5n\'e1luk [az ellens\'e9g] megragad\'e1s\'e1t illet\'f5en, \'e9s bej\'e1rt\'e1k az orsz\'e1gokat. Volt-e [ezek ut\'e1n sz\'e1mukra] hely a menek\'fcl
\'e9sre [a b\'fcntet\'e9s el\'f5l]?
\par 37. Bizony, eml\'e9keztet\'f5 van ebben annak, akinek van sz\'edve, vagy figyelmesen hallgat, mik\'f6zben \'f5 tan\'fa [az igazs\'e1g mellett].
\par 38. \'c9s bizony megteremtett\'fck az egeket \'e9s a f\'f6ldet, \'e9s mindazt, ami k\'f6z\'f6tt\'fck van hat nap alatt, \'e9s nem \'e9rt minket f\'e1radts\'e1g.
\par 39. Legy\'e9l h\'e1t t\'fcrelmes [\'f3 Mohamed] azzal szemben, amit mondanak, \'e9s magasztald Urad az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, napkelte el\'f5tt \'e9s napnyugta el\'f5tt!
\par 40. \'c9s magasztald h\'e1t \'d5t az \'e9jszaka egy r\'e9sz\'e9ben \'e9s a leborul\'e1s (az im\'e1dkoz\'e1s) ut\'e1n!
\par 41. \'c9s hallgasd [\'f3 Mohamed], azon a napon, amikor h\'edv a h\'edv\'f3 (Iszr\'e1f\'edl angyal) egy k\'f6zeli helyr\'f5l!
\par 42. Azon a napon, meghallj\'e1k a ki\'e1lt\'e1st az igazs\'e1ggal, az az el\'f5j\'f6vetel Napja [a s\'edrokb\'f3l].
\par 43. Bizony, Mi \'e9letre kelt\'fcnk \'e9s a hal\'e1lba bocs\'e1tunk, \'e9s Hozz\'e1nk lesz a v\'e9gc\'e9l.
\par 44. Azon a napon, amikor sz\'e9thasad [megny\'edlva] felett\'fck a f\'f6ld, sietve [j\'f6nnek majd el\'f5 a s\'edrokb\'f3l]. Ez egy k\'f6nny\'fb \'f6sszegy\'fbjt\'e9s lesz Sz\'e1munkra.
\par 45. Mi jobban tudjuk, hogy mit mondanak [a hitetlenek], \'e9s te nem vagy hatalmaskod\'f3 felett\'fck [hogy k\'e9nyszer\'edtsd \'f5ket]. Eml\'e9keztesd h\'e1t a Kor\'e1nnal azt, aki [val\'f3ban] f\'e9l a fenyeget\'e9semt\'f5l!}{\insrsid10757626 
\par 
\par 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid11695939 \hich\af0\dbch\af13\loch\f0 \hich\f0 51. A sz\'e9\loch\f0 \hich\f0 tsz\'f3\loch\f0 \hich\f0 r\'f3\loch\f0 k (adh-
\hich\af0\dbch\af13\loch\f0 \hich\f0 Dh\'e1\loch\f0 \hich\f0 rij\'e1\loch\f0 \hich\f0 t) c. sz\'fa\loch\f0 ra}{\insrsid10757626\charrsid8458747 
\par }\pard\plain \qj \li0\ri-1\widctlpar\tx374\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin-1\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid8458747 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. [Esk\'fcsz\'f6m] az elhintve sz\'e9tsz\'f3r\'f3 [szelekre]!
\par 2. \'c9s a terhet hordoz\'f3}{\insrsid10757626\charrsid8458747  [es\'f5felh\'f5kre]!}{\insrsid10757626\charrsid8458747 
\par 3. \'c9s a k\'f6nnyed\'e9n tovasikl\'f3 [haj\'f3kra]!
\par 4. \'c9s az [elrendelt] dolgokat [Allah parancs\'e1ra] sz\'e9toszt\'f3 [angyalokra]!
\par 5. Bizony, amire \'edg\'e9retet kaptatok [a felt\'e1mad\'e1ssal kapcsolatban], az val\'f3ban igaz.
\par 6. \'c9s bizony az \'edt\'e9let val\'f3ban bek\'f6vetkezik.
\par 
\par 7. \'c9s [a csillagok] p\'e1ly\'e1ival teli \'e9gre!
\par 8. Bizony, ti k\'fcl\'f6nb\'f6z\'f5 v\'e9lem\'e9nyen vagytok [a Kor\'e1nr\'f3l].
\par 9. Az ford\'edttatik el t\'f5le, aki [a tettei miatt] elford\'edttatik.
\par 10. Pusztuljanak el a tal\'e1lgat\'f3k!
\par 11. Akik elmer\'fcltek [a tudatlans\'e1gban], hanyagok [abban, amire parancsot kaptak].
\par 12. Azt k\'e9rdezik: \'84Mikor lesz az \'cdt\'e9let napja?\'94
\par 13. Azon a napon, amikor \'f5k a Pokol t\'fcz\'e9n lesznek pr\'f3b\'e1ra t\'e9ve.
\par 14. \'cdzlelj\'e9tek meg a pr\'f3bat\'e9teleteket (b\'fcntet\'e9seteket)! Ez az, aminek k\'e9rt\'e9tek [a] siettet\'e9s\'e9t.
\par 
\par 15. Bizony, az istenf\'e9l\'f5k kertekben lesznek \'e9s forr\'e1sokn\'e1l [a Paradicsomban].
\par 16. Megkapj\'e1k azt, amit Uruk adott nekik. Bizony, \'f5k az el\'f5tt j\'f3tev\'f5k voltak.
\par 17. \'c9jszak\'e1nk\'e9nt keveset aludtak.
\par 18. \'c9s az \'e9jszaka v\'e9g\'e9n \'f5k megbocs\'e1t\'e1st k\'e9rtek [Allaht\'f3l].
\par 19. \'c9s a vagyonukban [meghat\'e1rozott] jogos r\'e9sze van a k\'e9reget\'f5nek \'e9s a sz\'fbk\'f6lk\'f6d\'f5nek.
\par 20. \'c9s a F\'f6ld\'f6n jelek vannak azoknak, akiknek szil\'e1rd bizonyoss\'e1guk van [a hit\'fckben].
\par 21. \'c9s [jelek vannak] \'f6nmagatokban [is]. H\'e1t vajon nem l\'e1ttok?
\par 22. \'c9s az \'e9gben van az ell\'e1t\'e1sotok, \'e9s az, amire \'edg\'e9retet kaptatok.
\par 23. H\'e1t az \'e9g \'e9s a f\'f6ld Ur\'e1ra! Bizony, az [\'edg\'e9rete] olyannyira igaz, mint ahogy ti megsz\'f3laltok.
\par 
\par }{\insrsid10757626\charrsid11933434 24. Eljutott-e hozz\'e1d \'c1brah\'e1m megtiszteltet\'e9sben r\'e9szes\'fclt vend\'e9geinek (angyaloknak) az elbesz\'e9l\'e9se (a t\'f6rt\'e9nete)?
\par 25. Amikor bel\'e9ptek hozz\'e1, \'e9s azt mondt\'e1k: \'84B\'e9kess\'e9g!\'94 Azt mondta: \'84B\'e9kess\'e9g, ti ismeretlen n\'e9p [fiai]!\'94
\par 26. Azut\'e1n [\'e9szrev\'e9tlen\'fcl] elment a csal\'e1dj\'e1hoz, majd egy [s\'fclt] k\'f6v\'e9r borj\'faval t\'e9rt vissza.
\par 27. Azut\'e1n [vend\'e9gl\'e1t\'e1sul] el\'e9j\'fck tette. Azt mondta: \'84Vajon nem esztek?\'94
\par 28. \'c9s [amikor azt l\'e1tta, hogy nem esznek] f\'e9lelmet \'e9rzett miattuk. Azt mondt\'e1k: \'84Ne f\'e9lj!\'94 \'c9s egy nagy tud\'e1s\'fa gyermekr\'f5l hoztak \'f6r\'f6mh\'edrt neki.
\par 29. \'c9s a feles\'e9ge hangosan ki\'e1ltozva l\'e9pett be, [csod\'e1lkozva] csapott az arc\'e1ra, \'e9s azt mondta: \'84Medd\'f5 \'f6regasszony [vagyok]!\'94
\par 30. \'d5k azt mondt\'e1k: \'84Ez \'fagy van, [de] az Urad m\'e1r kimondta [d\'f6nt\'e9s\'e9t]. Bizony, \'d5 a B\'f6lcs, a Mindentud\'f3.\'94
\par 31. [Ezut\'e1n] azt mondta [\'c1brah\'e1m]: \'84H\'e1t milyen s\'falyos \'fcgyben [vagytok itt], \'f3 ti, k\'fcld\'f6ttek?\'94
\par 32. Azt mondt\'e1k: \'84Bizony, mi egy gonosztev\'f5 n\'e9phez k\'fcldett\'fcnk el,
\par 33. Az\'e9rt, hogy agyagk\'f6veket k\'fcldj\'fcnk r\'e1juk,
\par 34. [Amelyek] meg vannak jel\'f6lve az Uradn\'e1l a m\'e9rt\'e9ktelenek sz\'e1m\'e1ra.\'94
\par 35. \'c9s kivitt\'fck azokat, akik h\'edv\'f5k voltak ott.
\par 36. De csup\'e1n egy olyan h\'e1zat tal\'e1ltunk ott, amelynek lak\'f3i al\'e1vetett\'e9k magukat [Allahnak].
\par 37. \'c9s jelet hagytunk ott azoknak, akik f\'e9lik a f\'e1jdalmas gy\'f6trelmet.
\par 
\par 38. \'c9s M\'f3zes [t\'f6rt\'e9net\'e9ben is tanuls\'e1gos jel van]. Amikor elk\'fcldt\'fck \'f5t a F\'e1ra\'f3hoz nyilv\'e1nval\'f3 bizony\'edt\'e9kkal.
\par 39. \'c9s h\'e1tat ford\'edtott t\'e1maszt\'e9k\'e1ra (hadi erej\'e9re) [hagyatkozva] \'e9s azt mondta: \'84[M\'f3zes] egy var\'e1zsl\'f3, vagy egy \'f5r\'fclt!\'94
\par 40. Mi pedig megragadtuk \'f5t \'e9s a katon\'e1it, \'e9s a tengerbe vetett\'fck \'f5ket, \'e9s \'f5 r\'e1szolg\'e1lt a szemreh\'e1ny\'e1sra.
\par 41. \'c9s \'c1d [t\'f6rt\'e9net\'e9ben is tanuls\'e1gos jel van]. Amikor az \'e1ldatlan (medd\'f5) szelet k\'fcldt\'fck ellen\'fck.
\par 42. Nem hagyott meg semmit, amit el\'e9rt, an\'e9lk\'fcl, hogy ne tette volna olyann\'e1, mint a sz\'e9tporladt romok}{\insrsid10757626\charrsid7490630 .
\par 43. \'c9s Tam\'fad [t\'f6rt\'e9net\'e9ben is tanuls\'e1gos jel van]. Amikor az lett mondva nekik: \'84\'c9lvezz\'e9tek [az evil\'e1gi \'e9let muland\'f3 \'f6r\'f6meit] egy ideig!\'94
\par 44. \'c1m \'f5k g\'f5g\'f6sek voltak Uruk parancs\'e1val szemben, a vill\'e1mcsap\'e1s pedig elragadta \'f5ket, mik\'f6zben \'f5k [csak] n\'e9ztek,
\par 45. \'c9s nem tudtak fel\'e1llni [hogy elmenek\'fcljenek], \'e9s nem tudtak magukon seg\'edteni.
\par 46. \'c9s No\'e9 n\'e9p\'e9t [is elpuszt\'edtottuk] az el\'f5tt. Bizony, \'f5k engedetlen n\'e9p voltak.
\par 
\par 47. \'c9s az eget er\'f5vel \'e9p\'edtett\'fck, \'e9s bizony, Mi kit\'e1g\'edtjuk.
\par 48. \'c9s a f\'f6ldet kiter\'edtett\'fck. \'c9s milyen j\'f3 egyenget\'f5k [vagyunk]!
\par 49. \'c9s minden dologb\'f3l egy p\'e1rt teremtett\'fcnk. H\'e1tha okultok [az int\'e9sb\'f5l].
\par 50. \'84Menek\'fcljetek h\'e1t Allahhoz! Bizony, \'e9n (Mohamed) T\'f5le val\'f3 nyilv\'e1nval\'f3 figyelmeztet\'f5 vagyok hozz\'e1tok [k\'fcldve].
\par 51. \'c9s ne helyezzetek Allah mell\'e9 m\'e1s istent! Bizony, \'e9n T\'f5le val\'f3 nyilv\'e1nval\'f3 figyelmeztet\'f5 vagyok hozz\'e1tok [k\'fcldve].\'94
\par 
\par 52. Hasonl\'f3k\'e9ppen, nem j\'f6tt el egyetlen k\'fcld\'f6tt sem azokhoz, akik el\'f5tt\'fck voltak, an\'e9lk\'fcl, hogy azt ne mondt\'e1k volna: \'84[\'d5] egy var\'e1zsl\'f3 vagy egy \'f5r\'fclt.\'94
\par 53. Vajon egym\'e1s lelk\'e9re k\'f6t\'f6tt\'e9k [ezt a kijelent\'e9st]? Nem! \'d5k egy t\'falkap\'e1sra vetemed\'f5 n\'e9p.
\par 54. Fordulj h\'e1t el t\'f5l\'fck! Mert nem \'e9rhet t\'e9ged szemreh\'e1ny\'e1s.
\par 55. \'c9s eml\'e9keztess! Mert bizony az eml\'e9keztet\'e9s haszn\'e1ra v\'e1lik a h\'edv\'f5knek.
\par 56. \'c9s nem teremtettem a dzsinneket \'e9s az embereket m\'e1s\'e9rt, csup\'e1n az\'e9rt, hogy [egyed\'fcl] Engem szolg\'e1ljanak.
\par 57. Nem akarok t\'f5l\'fck semmilyen ell\'e1t\'e1st, \'e9s nem akarom, hogy t\'e1pl\'e1ljanak.
\par 58. Bizony, Allah az, aki az Ell\'e1t\'f3, az Er\'f5vel B\'edr\'f3, a Szil\'e1rd Erej\'fb.
\par 59. \'c9s bizony, az igazs\'e1gtalanoknak olyan r\'e9sz\'fck van [a b\'fcntet\'e9sb\'f5l], mint a t\'e1rsaik (el\'f5djeik) r\'e9sze, h\'e1t ne siettessenek Engem [b\'fcntet\'e9s\'fck el\'f5rehoz\'e1s\'e1val]!
\par 60. \'c9s jaj azoknak, akik hitetlenn\'e9 v\'e1ltak, att\'f3l a napjukt\'f3l (a Felt\'e1mad\'e1s napj\'e1t\'f3l), amire \'edg\'e9retet kaptak!
\par 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\insrsid10757626\charrsid7490630 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid11695939 \hich\af0\dbch\af13\loch\f0 \hich\f0 52. A hegy (at-T\'fa\loch\f0 \hich\f0 r) c. sz\'fa\loch\f0 ra}{
\b0\fs24\insrsid10757626\charrsid7490630 
\par }\pard\plain \qj \li0\ri-1\widctlpar\tx374\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin-1\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid7490630 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. [Esk\'fcsz\'f6m] a [S\'ednai] hegyre!
\par 2. \'c9s a sorokba rendezve [feljegyzett] \'edr\'e1sra!
\par 3. [Amely] kiter\'edtett pergamenen [van].
\par 4. \'c9s a gyakran l\'e1togatott [\'e9gi] H\'e1zra!
\par 5. \'c9s a felemelt mennyezetre (\'e9gboltozatra)!
\par 6. \'c9s a [Felt\'e1mad\'e1s napj\'e1n] l\'e1ngra lobbantott tengerre!
\par 7. Bizony, az Urad b\'fcntet\'e9se be fog k\'f6vetkezni.
\par 8. Nincs semmi, ami elh\'e1r\'edtan\'e1 azt.
\par 9. Azon a napon az \'e9g inogva megr\'e1zk\'f3dik.
\par 10. \'c9s a hegyek haladva elindulnak.
\par 11. Jaj h\'e1t azon a napon a meghazudtol\'f3knak!
\par 12. Akik [alaptalan] besz\'e9d\'fckbe mer\'fclve j\'e1tszadoznak.
\par 13. Azon a napon a Gyehenna t\'fcz\'e9be tasz\'edttatnak, [durv\'e1n] odal\'f6kve.
\par 14. [Az lesz mondva nekik:] \'84Ez az a t\'fbz, amelyet ti hazugs\'e1gnak tartottatok!
\par 15. Vajon h\'e1t var\'e1zslat ez, vagy ti nem l\'e1ttok?
\par 16. \'c9gjetek benne, \'e9s legyetek t\'fcrelemmel vagy ne legyetek t\'fcrelemmel, egyre megy nektek! Csup\'e1n [az\'e9rt] kaptok fizets\'e9get, amit cselekedtetek.\'94
\par }\pard \qj \li14\ri-1\widctlpar\tx374\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin-1\lin14\itap0\pararsid10757626 {\insrsid10757626\charrsid7490630 
\par 17. Bizony, az istenf\'e9l\'f5k kertekben \'e9s gy\'f6ny\'f6r\'fbs\'e9gben lesznek [a Paradicsomban],
\par 18. \'d6rvendezve annak, amit az Uruk adott nekik, \'e9s az Uruk megv\'e9di \'f5ket a Pokol gy\'f6trelm\'e9t\'f5l.
\par 19. [Az lesz mondva nekik:] \'84Egyetek \'e9s igyatok eg\'e9szs\'e9ggel amiatt, amit cselekedtetek!\'94
\par 20. Sorba helyezett \'e1gyakra d\'f5lve fekszenek, \'e9s nagyszem\'fb sz\'e9p n\'f5ket adunk nekik feles\'e9g\'fcl.
\par 21. \'c9s akik hittek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben], \'e9s a lesz\'e1rmazottaik, akik k\'f6vett\'e9k [el\'f5deiket] a hitben, azokhoz csatlakoztatni fogjuk a lesz\'e1rmazottaikat \'e9s nem cs\'f6
kkent\'fcnk semmit sem a tetteikb\'f5l. Minden ember [t\'falvil\'e1gi fizets\'e9ge] annak z\'e1loga, amit szerzett.
\par 22. \'c9s b\'f5s\'e9gesen ell\'e1tjuk \'f5ket [olyan] gy\'fcm\'f6lccsel \'e9s h\'fassal, amilyet csak k\'edv\'e1nnak.
\par 23. Olyan poh\'e1r [tartalm\'e1t] fogyasztj\'e1k majd ott, amelyt\'f5l nem lesz sem felesleges besz\'e9d, sem b\'fbn.
\par 24. \'c9s \'f5ket [szolg\'e1l\'f3] ifjak j\'e1rnak k\'f6rbe k\'f6z\'f6tt\'fck, [akik olyanok], mintha elrejtett gy\'f6ngy\'f6k lenn\'e9nek.
\par }{\insrsid10757626\charrsid8782526 25. \'c9s [a Paradicsom lak\'f3i] egym\'e1shoz fordulnak, k\'e9rdezgetv\'e9n egym\'e1st [a jutalmuk ok\'e1r\'f3l].
\par 26. Azt mondj\'e1k: \'84Bizony, mi kor\'e1bban a csal\'e1dunk k\'f6zt meg voltunk r\'e9m\'fclve [Allah b\'fcntet\'e9s\'e9t\'f5l],
\par 27. Azonban Allah kegyes volt ir\'e1ntunk \'e9s megmentett minket a forr\'f3 fuvallat\'fa [Pokol-]t\'fbz gy\'f6trelm\'e9t\'f5l.
\par 28. Bizony, mi ezel\'f5tt foh\'e1szkodtunk Hozz\'e1. Bizony, \'d5 a J\'f3s\'e1gos, az Irgalmas.\'94
\par 
\par 29. Eml\'e9keztess h\'e1t [\'f3 Mohamed]! Mert te nem vagy \endash  az Urad j\'f3t\'e9tem\'e9ny\'e9b\'f5l \endash  se j\'f6vend\'f5mond\'f3, se \'f5r\'fclt!
\par 30. Vagy azt mondj\'e1k [r\'f3lad a hitetlenek]: \'84[Egy] k\'f6lt\'f5, [akivel kapcsolatban] v\'e1rva v\'e1rjuk, hogy az id\'f5 k\'e9ts\'e9get kelt\'f5 t\'f6rt\'e9n\'e9sei [s\'fajtsanak le r\'e1]!\'94
\par 31. Mondd: \'84V\'e1rjatok csak [a hal\'e1lomra]! H\'e1t bizony, \'e9n is veletek [vagyok] a v\'e1rakoz\'f3k k\'f6z\'f6tt.\'94
\par 
\par 32. Vajon az esz\'fck parancsolja nekik ezt (amit tesznek), avagy \'f5k egy t\'falkap\'e1st elk\'f6vet\'f5 n\'e9p?
\par 33. Vagy azt mondj\'e1k: \'84\'d5 maga tal\'e1lta ki ezt [a Kor\'e1nt].\'94 Ink\'e1bb [\'f5k] nem hisznek.
\par 34. Hozzanak h\'e1t egy hozz\'e1 (a Kor\'e1nhoz) hasonl\'f3 besz\'e9det, ha val\'f3ban igazmond\'f3k!
\par 35. Vagy tal\'e1n a semmib\'f5l lettek teremtve, vagy \'f5k [lenn\'e9nek] a teremt\'f5k?
\par 36. Vagy [tal\'e1n] \'f5k teremtett\'e9k az egeket \'e9s a f\'f6ldet? Ellenkez\'f5leg! Nekik nincs szil\'e1rd bizonyoss\'e1guk.
\par 37. Vagy tal\'e1n n\'e1luk vannak a te Urad [k\'f6ny\'f6r\'fclet\'e9nek \'e9s ell\'e1t\'e1s\'e1nak] a t\'e1rh\'e1zai? Avagy \'f5k a [mindezek felett] uralkod\'f3k?
\par 38. Vagy tal\'e1n van l\'e9tr\'e1juk [az egekbe], amelyen hallgat\'f3znak? Nos h\'e1t az, aki hallgat\'f3zik k\'f6z\'fcl\'fck, hozzon nyilv\'e1nval\'f3 bizony\'edt\'e9kot!
\par 39. Vagy tal\'e1n Neki (Allahnak) [tulajdon\'edtj\'e1tok] a le\'e1nyokat, \'e9s magatoknak [v\'e1lasztj\'e1tok] a fi\'fakat?
\par 40. Vagy [tal\'e1n] fizets\'e9get k\'e9rsz t\'f5l\'fck [\'f3 Mohamed], ez\'e9rt \'f5ket ad\'f3ss\'e1g terhe nyomja?
\par 41. Vagy [tal\'e1n] n\'e1luk van a rejtett dolgok [tud\'e1sa], \'e9s \'f5k le\'edrj\'e1k [azt]?
\par 42. Vagy [tal\'e1n] fondorlatot akarnak sz\'f5ni? \'c1m akik hitetlenek, maguk esnek bele a fondorlat [csapd\'e1j\'e1ba].
\par 43. Vagy [tal\'e1n] m\'e1s isten\'fck van nekik Allah helyett? Magasztaltass\'e9k Allah! [\'d5 afelett van], amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [\'d5mell\'e9].
\par 44. Ha l\'e1tn\'e1nak egy darabot az \'e9gb\'f5l lezuhanni, azt mondan\'e1k: \'84Ez [csup\'e1n] egy halom felh\'f5.\'94
\par 45. Hagyd h\'e1t \'f5ket, am\'edg tal\'e1lkoznak [azzal] a napjukkal (a Felt\'e1mad\'e1s napj\'e1val), amely [kezdet\'e9n] holtan esnek \'f6ssze!
\par 46. Azon a napon nem fog hasznukra v\'e1lni a fondorlatuk, \'e9s nem lesznek megseg\'edtve.
\par 47. \'c9s bizony azoknak, akik igazs\'e1gtalans\'e1got k\'f6vettek el, m\'e9g [a t\'falvil\'e1gi b\'fcntet\'e9s] el\'f5tt gy\'f6trelem j\'e1r [m\'e1r az evil\'e1gon]. \'c1m a legt\'f6bbj\'fck nem rendelkezik tud\'e1ssal.
\par 
\par 48. \'c9s l\'e9gy t\'fcrelmes az Urad d\'f6nt\'e9se ir\'e1nt! Mert te bizony a Mi szem\'fcnk el\'f5tt vagy. \'c9s magasztald az Urad, az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, amikor fel\'e1llsz [az im\'e1dkoz\'e1shoz],
\par 49. \'c9s magasztald \'d5t az \'e9jszaka egy r\'e9sz\'e9ben, \'e9s a csillagok elt\'fbn\'e9se ut\'e1n (hajnalhasad\'e1skor)!}{\insrsid10757626 
\par 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\fs24\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid11695939 \hich\af0\dbch\af13\loch\f0 53. A csillag \hich\f0 \endash \loch\f0  (An-\hich\af0\dbch\af13\loch\f0 \hich\f0 
Nadzsm) c. sz\'fa\loch\f0 ra}{\insrsid10757626\charrsid8782526 
\par }\pard\plain \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid8782526 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.}{\insrsid10757626\charrsid8782526 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid8782526 
\par 1. [Esk\'fcsz\'f6m] a csillagra, amint lehullik!}{\insrsid10757626\charrsid8782526 
\par 2. A t\'e1rsatok (Mohamed) nem t\'e9velygett el, \'e9s nem volt t\'e9v\'faton sem.
\par 3. \'c9s nem a k\'e9nye szerint sz\'f3lal meg.
\par 4. Ez [a Kor\'e1n] nem m\'e1s, mint sugalltatott kinyilatkoztat\'e1s.
\par 5. A nagy erej\'fb [G\'e1briel angyal] tan\'edtotta neki,
\par 6. A sz\'e9p megjelen\'e9s\'fb, [aki] elhelyezkedett (megjelent az \'e9gben a maga val\'f3s\'e1g\'e1ban),
\par 7. Mik\'f6zben a l\'e1t\'f3hat\'e1r legmagasabb [r\'e9sz\'e9n] volt.
\par 8. Majd k\'f6zeledett, \'e9s lejjebb ereszkedett.
\par 9. \'c9s [G\'e1briel] k\'e9t \'edjhossznyi t\'e1vols\'e1gra volt [Mohamedt\'f5l], vagy m\'e9g k\'f6zelebb.
\par 10. \'c9s [Allah azt] sugallta a szolg\'e1j\'e1nak (Mohamednek), amit sugallt [G\'e1brielen kereszt\'fcl].
\par 11. Nem hazudtolta meg a sz\'edve azt, amit [a szem\'e9vel] l\'e1tott.
\par 12. Vajon [\'f5t meghazudtolva] sz\'e1lltok vit\'e1ba vele arr\'f3l, amit l\'e1tott?
\par 13. \'c9s bizony, m\'e1r l\'e1tta \'f5t (G\'e1brielt) egy m\'e1sik alkalommal is,
\par 14. A V\'e9gs\'f5 t\'f6visf\'e1n\'e1l,
\par 15. Amelyn\'e9l a Hajl\'e9k Kertje [a Paradicsom] van.
\par 16. Amikor bebor\'edtotta a t\'f6visf\'e1t az, ami bebor\'edtotta.
\par 17. Nem t\'e9rt el a tekintet \'e9s nem l\'e9pett t\'fal [hat\'e1rain].
\par 18. \'d5 bizony az Ura legnagyobb jeleib\'f5l l\'e1tott.
\par 
\par 19. Vajon h\'e1t mit gondoltok [arr\'f3l, amit im\'e1dtok] al-L\'e1tr\'f3l \'e9s al-Uzz\'e1r\'f3l?
\par 20. \'c9s Man\'e1tr\'f3l, a harmadikr\'f3l, az utols\'f3r\'f3l?
\par 21. Vajon magatoknak [v\'e1lasztj\'e1tok] a h\'edmnem\'fbeket, \'e9s Neki (Allahnak) [tulajdon\'edtj\'e1tok] a n\'f5nem\'fbeket?
\par 22. Ez azt\'e1n a legigazs\'e1gtalanabb feloszt\'e1s!
\par 23. Ezek csup\'e1n nevek, amelyeket ti \'e9s az aty\'e1itok adtatok [nekik], amelyekkel kapcsolatban Allah nem bocs\'e1tott le semmilyen bizony\'edt\'f3 \'e9rvet. Csup\'e1n a v\'e9leked\'e9st k\'f6vetik, \'e9s azt, ami a maguk kedv\'e9re van, [annak ellen
\'e9re, hogy] bizonyosan elj\'f6tt m\'e1r hozz\'e1juk az \'fatmutat\'e1s.
\par 24. Vagy [tal\'e1n] az ember\'e9 [lehet] mindaz, amire v\'e1gyik?
\par 25. \'c1m Allah\'e9 a t\'falvil\'e1g \'e9s az evil\'e1g.
\par 26. \'c9s h\'e1ny angyal van az egekben, [akiknek] a k\'f6zbenj\'e1r\'e1sa semmit sem haszn\'e1l, kiv\'e9ve [csak] azut\'e1n, hogy Allah enged\'e9lyt ad annak, akinek akar [hogy k\'f6zbenj\'e1rjon], \'e9s megel\'e9gedik [azzal, aki\'e9rt k\'f6zbenj\'e1
rnak].
\par 27. Bizony, akik nem hisznek a t\'falvil\'e1gban, n\'f5i nevekkel illetik az angyalokat!
\par 28. De nincs nekik err\'f5l tud\'e1suk. Csup\'e1n a v\'e9leked\'e9st k\'f6vetik, \'e1m a v\'e9leked\'e9s nem \'e9r semmit az igazs\'e1ggal szemben.
\par 29. Fordulj h\'e1t el att\'f3l, aki h\'e1tat ford\'edt az [\'c1ltalunk lebocs\'e1tott] Eml\'e9keztet\'e9snek, \'e9s nem akar m\'e1st, csup\'e1n az evil\'e1gi \'e9letet!
\par 30. Ez [minden], amit megszereztek a tud\'e1sb\'f3l. Bizony, az Urad tudja a legjobban, hogy ki t\'e9velyedett el az \'d5 \'fatj\'e1r\'f3l, \'e9s \'d5 tudja a legjobban, hogy ki lelt az igaz \'fatra.
\par 
\par 31. \'c9s Allah\'e9 mindaz, ami az egekben van \'e9s mindaz, ami a F\'f6ld\'f6n van, hogy megadja a fizets\'e9g\'e9t azoknak, akik rosszat tettek, aszerint amit cselekedtek, \'e9
s a legjobbal (a Paradicsommal) fizessen meg azoknak, akik helyesen cselekedtek.
\par 32. Akik elker\'fclik a legnagyobb b\'fbn\'f6ket \'e9s a f\'f6rtelmess\'e9geket \endash  kiv\'e9ve a kisebb v\'e9ts\'e9geket \endash  bizony, a te Urad megbocs\'e1t\'e1sa [mindent] \'e1tfog\'f3. \'d5 jobban ismer titeket, [m\'e1r akkort\'f3l] amikor l\'e9
trehozott titeket a f\'f6ldb\'f5l, \'e9s amikor m\'e9g magzatok voltatok any\'e1itok has\'e1ban. Ne \'edt\'e9lj\'e9tek h\'e1t [a b\'fbn\'f6kt\'f5l] megtiszt\'edtottnak magatokat! \'d5 tudja a legjobban, hogy ki az istenf\'e9l\'f5 [k\'f6z\'fcletek].
\par 33. Vajon h\'e1t mit gondolsz arr\'f3l, aki h\'e1tat ford\'edtott,
\par 34. \'c9s adott egy keveset, majd abbahagyta?
\par 35. Vajon n\'e1la van a rejtett dolgok tud\'e1sa, \'e9s \'f5 l\'e1tja [hogy elfogy a vagyona]?
\par 36. Vagy [tal\'e1n] nem kapott-e h\'edrt arr\'f3l, ami M\'f3zes lapjaiban van,
\par 37. \'c9s \'c1brah\'e1m\'e9ban, aki teljes\'edtette [azt, amire parancsot kapott]?
\par 38. Hogy egyetlen terhet cipel\'f5 sem cipeli egy m\'e1siknak a terh\'e9t.
\par 39. \'c9s hogy az embernek nem j\'e1r m\'e1s, csup\'e1n az, ami\'e9rt t\'f6rekszik.
\par 40. \'c9s hogy a t\'f6rekv\'e9s\'e9nek [a jutalma] majd l\'e1that\'f3v\'e1 v\'e1lik.
\par 41. Azut\'e1n megadatik neki a fizets\'e9g \'e9rte a legteljesebb fizets\'e9ggel.
\par 
\par 42. \'c9s hogy az Uradhoz lesz a v\'e9gs\'f5 [visszat\'e9r\'e9s].
\par 43. \'c9s hogy \'d5 az, Aki megnevettet \'e9s megr\'edkat.
\par 44. \'c9s hogy \'d5 az, Aki hal\'e1lba bocs\'e1t \'e9s \'e9letre kelt.
\par 45. \'c9s hogy \'d5 az, Aki megteremtette a p\'e1rt: a h\'edmet \'e9s a n\'f5st\'e9nyt,
\par 46. Egy [megterm\'e9keny\'fclt] cseppb\'f5l, miut\'e1n [a mag] kil\'f6velltetik.
\par 47. \'c9s hogy \'d5r\'e1 tartozik az \'fajra teremt\'e9s [a t\'falvil\'e1gon].
\par 48. \'c9s hogy \'d5 tesz gazdagg\'e1 \'e9s birtokoss\'e1.
\par 49. \'c9s hogy, \'d5 a Sz\'edriusz Ura.
\par 50. \'c9s hogy, \'d5 az, Aki elpuszt\'edtotta \'c1dot, az els\'f5t,
\par 51. \'c9s Tam\'fadot, \'e9s nem hagyott meg [senkit],
\par 52. \'c9s kor\'e1bban No\'e9 n\'e9p\'e9t. Bizony, \'f5k igazs\'e1gtalanabbak \'e9s [m\'e9g ink\'e1bb] t\'falkap\'e1sra vetemed\'f5k voltak.
\par 53. \'c9s [\'d5 az, Aki] az elpuszt\'edtott v\'e1rost (L\'f3t n\'e9p\'e9nek v\'e1ros\'e1t) m\'e9lybe vetette.
\par 54. \'c9s bebor\'edtotta azokat [azzal], ami bebor\'edtotta [a k\'f6vekb\'f5l].
\par 55. H\'e1t Urad melyik j\'f3t\'e9tem\'e9ny\'e9t meghazudtolva sz\'e1llsz vit\'e1ba [\'f3 te, hitetlen ember]?
\par 56. \'d5 (Mohamed Pr\'f3f\'e9ta) a kor\'e1bbi figyelmeztet\'f5k [sor\'e1ba] tartoz\'f3 figyelmeztet\'f5.
\par 
\par 57. K\'f6zeledik a K\'f6zeled\'f5 (a Felt\'e1mad\'e1s).
\par 58. Annak nincs Allahon k\'edv\'fcl elh\'e1r\'edt\'f3ja.
\par 59. Vajon h\'e1t ezen a besz\'e9den csod\'e1lkoztok?
\par 60. \'c9s [g\'fanyol\'f3dva] nevettek, \'e9s nem s\'edrtok [a f\'e9lelemt\'f5l],
\par 61. Mik\'f6zben ti \'e9nekelve (sz\'f3rakozva) elfordultok?
\par 62. Boruljatok h\'e1t le Allahnak \'e9s szolg\'e1lj\'e1tok [\'d5t]!}{\b\f0\insrsid10757626 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid11695939 \hich\af0\dbch\af13\loch\f0 54. A \hich\af0\dbch\af13\loch\f0 hold (al-\hich\af0\dbch\af13\loch\f0 Q
\hich\af0\dbch\af13\loch\f0 \hich\f0 amar) c. sz\'fa\loch\f0 ra}{\insrsid10757626\charrsid12521271  
\par }\pard\plain \qj \li0\ri-1\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin-1\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid12521271 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par }\pard \qj \li14\ri-1\widctlpar\tx374\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin-1\lin14\itap0\pararsid10757626 {\insrsid10757626\charrsid12521271 1. K\'f6zel ker\'fclt az \'d3ra, \'e9s sz\'e9thasadt a Hold.
\par 2. \'c9s ha egy jelet l\'e1tnak, elfordulnak \'e9s azt mondj\'e1k: \'84Folyamatos var\'e1zslat [ez]!\'94
\par 3. \'c9s meghazudtolt\'e1k [a K\'fcld\'f6ttet] \'e9s a k\'e9ny\'fcket k\'f6vett\'e9k, \'e1m minden \'fcgynek meg van a beteljesed\'e9si ideje.
\par 4. \'c9s bizony m\'e1r el\'e9rkeztek azok a h\'edrek hozz\'e1juk, amelyekben [elegend\'f5] elrettent\'e9s van [a sz\'e1mukra],
\par 5. Meggy\'f5z\'f5 b\'f6lcsess\'e9g [\'e9rkezett hozz\'e1juk], de nem v\'e1lnak a hasznukra a figyelmeztet\'e9sek.
\par 6. Fordulj h\'e1t el t\'f5l\'fck! Azon a napon, mikor a H\'edv\'f3 (Iszr\'e1f\'edl angyal) egy sz\'f6rny\'fb dologhoz fog h\'edvni,
\par 7. Al\'e1zatos lesz a tekintet\'fck, \'fagy j\'f6nnek majd ki a s\'edrokb\'f3l, mintha sz\'e9tsz\'e9ledt s\'e1sk\'e1k lenn\'e9nek,
\par 8. Megal\'e1zottan sietnek el\'f5 a H\'edv\'f3hoz. A hitetlenek azt mondj\'e1k majd: \'84Neh\'e9z nap ez!\'94
\par 
\par 9. Meghazudtol\'e1st k\'f6vetett el el\'f5tt\'fck No\'e9 n\'e9pe, s meghazudtolt\'e1k a szolg\'e1nkat (No\'e9t), \'e9s azt mondt\'e1k: \'84\'d5r\'fclt!\'94, \'e9s fenyegetve eltiltott\'e1k [att\'f3l, hogy \'e1tadja Isten \'fczenet\'e9t].
\par 10. \'d5 pedig az Ur\'e1hoz foh\'e1szkodott: \'84Bizony, \'e9n legy\'f5zettem, seg\'edts h\'e1t [rajtam]!\'94
\par 11. \'c9s lez\'fadul\'f3 [es\'f5]v\'edzzel nyitottuk meg az \'e9g kapuit,
\par 12. \'c9s a f\'f6ld\'f6n forr\'e1sokat fakasztottunk, \'e9s az [\'e9gi \'e9s f\'f6ldi] v\'edz olyan parancs szerint tal\'e1lkozott, amely m\'e1r elrendeltetett.
\par 13. \'c9s deszk\'e1kb\'f3l \'e9s szegekb\'f5l k\'e9sz\'edtett [b\'e1rk\'e1n] vitt\'fck \'f5t,
\par 14. Amely szem\'fcnk el\'f5tt haladt, fizets\'e9g\'fcl [No\'e9nak], aki meg lett tagadva [a n\'e9pe \'e1ltal].
\par 15. \'c9s bizony, h\'e1tra hagytuk [a b\'e1rk\'e1t] jelk\'e9nt. Van-e h\'e1t olyasvalaki, aki okul [az int\'e9sb\'f5l]?
\par 16. Milyen volt h\'e1t a gy\'f6trelmem \'e9s [milyenek voltak] a figyelmeztet\'e9seim?
\par 17. \'c9s bizony, k\'f6nny\'fbv\'e9 tett\'fck a Kor\'e1nt az eml\'e9kez\'e9sre. Van-e h\'e1t olyasvalaki, aki okul [az int\'e9sb\'f5l]?
\par 
\par 18. \'c1d [t\'f6rzse] meghazudtol\'e1st k\'f6vetett el. Milyen volt h\'e1t a gy\'f6trelmem, \'e9s [milyenek voltak] a figyelmeztet\'e9seim?
\par 19. Bizony, Mi s\'fcv\'edt\'f5, tombol\'f3 szelet k\'fcldt\'fcnk r\'e1juk, a folyamatos v\'e9szterhess\'e9g napj\'e1n,
\par 20. Amely \'fagy ragadta el az embereket, mintha gy\'f6kerest\'f5l kit\'e9pett datolyap\'e1lm\'e1k csonkjai lettek volna.
\par 21. Milyen volt h\'e1t a gy\'f6trelmem, \'e9s [milyenek voltak] a figyelmeztet\'e9seim?
\par 22. \'c9s bizony, k\'f6nny\'fbv\'e9 tett\'fck a Kor\'e1nt az eml\'e9kez\'e9sre. Van-e h\'e1t olyasvalaki, aki okul [az int\'e9sb\'f5l]?
\par 
\par 23. Tam\'fad [t\'f6rzse] meghazudtolta a figyelmeztet\'e9seket,
\par 24. \'c9s azt mondt\'e1k: \'84Vajon egy k\'f6z\'fcl\'fcnk val\'f3 embert k\'f6vess\'fcnk, aki egyed\'fcl van? Bizony, mi akkor t\'e9velyg\'e9sben \'e9s \'f5r\'fclts\'e9gben lenn\'e9nk!
\par 25. Vajon [egyed\'fcl] neki k\'fcldetett le k\'f6z\'fcl\'fcnk az Eml\'e9keztet\'e9s (kinyilatkoztat\'e1s)? De nem! \'d5 egy nagyk\'e9p\'fb, hazudoz\'f3!\'94
\par 26. Megtudj\'e1k majd holnap, ki a nagyk\'e9p\'fb, hazudoz\'f3!
\par 27. Bizony, Mi egy n\'f5st\'e9nytev\'e9t k\'fcld\'fcnk el hozz\'e1juk k\'eds\'e9rt\'e9sk\'e9nt, figyeld h\'e1t meg \'f5ket [\'f3 Sz\'e1leh] \'e9s l\'e9gy t\'fcrelmes!
\par 28. \'c9s add h\'edr\'fcl nekik, hogy a v\'edz megosztand\'f3 k\'f6z\'f6tt\'fck [\'e9s a teve k\'f6z\'f6tt]! Minden itat\'e1si [napon] legyen jelen [az, akire a sor ker\'fcl]!
\par 29. \'c9s \'f5k odah\'edvt\'e1k a t\'e1rsukat [b\'e1tor\'edtva \'f5t a teve meg\'f6l\'e9s\'e9re], aki nekil\'e1tott, \'e9s elv\'e1gta [a n\'f5st\'e9nyteve] l\'e1bin\'e1t.
\par 30. Milyen volt h\'e1t a gy\'f6trelmem, \'e9s [milyenek voltak] a figyelmeztet\'e9seim?
\par 31. Bizony, mi egyetlen ki\'e1lt\'e1st (csap\'e1st) k\'fcldt\'fcnk le r\'e1juk, s olyann\'e1 lettek, mint az elsz\'e1radt t\'f6rmel\'e9k, amelyet a kar\'e1mk\'e9sz\'edt\'f5 [haszn\'e1l].
\par 32. \'c9s bizony, k\'f6nny\'fbv\'e9 tett\'fck a Kor\'e1nt az eml\'e9kez\'e9sre. Van-}{\insrsid10757626\charrsid1580795 e h\'e1t olyasvalaki, aki okul [az int\'e9sb\'f5l]?
\par 
\par 33. L\'f3t n\'e9pe meghazudtolta a figyelmeztet\'e9seket.
\par 34. Mi bizony k\'f5z\'e1port k\'fcldt\'fcnk le r\'e1juk, kiv\'e9ve L\'f3t csal\'e1dj\'e1t; megmentett\'fck \'f5ket az \'e9jszaka v\'e9g\'e9n,
\par 35. J\'f3t\'e9tem\'e9nyk\'e9nt Mit\'f5l\'fcnk. Ekk\'e9ppen adjuk meg a fizets\'e9g\'e9t annak, aki h\'e1l\'e1s.
\par 36. \'c9s bizony, figyelmeztette \'f5ket a csap\'e1sunkra, \'e1m \'f5k [meghazudtolva] vit\'e1ba sz\'e1lltak a figyelmeztet\'e9sekkel [kapcsolatban].
\par 37. \'c9s bizony, megpr\'f3b\'e1lt\'e1k r\'e1venni a vend\'e9geit [a b\'fbnre], mire kioltottuk a szem\'fck vil\'e1g\'e1t, [\'e9s az lett mondva nekik:] \'84\'cdzlelj\'e9tek h\'e1t meg a b\'fcntet\'e9semet \'e9s a figyelmeztet\'e9seim [figyelmen k\'edv
\'fcli hagy\'e1s\'e1nak eredm\'e9ny\'e9t]!\'94
\par 38. \'c9s bizony, meglepte \'f5ket hajnalban [a teljes pusztul\'e1st] beteljes\'edt\'f5 gy\'f6trelem.
\par 39. \'cdzlelj\'e9tek h\'e1t meg a b\'fcntet\'e9semet \'e9s a figyelmeztet\'e9seim [figyelmen k\'edv\'fcli hagy\'e1s\'e1nak eredm\'e9ny\'e9t]!
\par 40. \'c9s bizony, k\'f6nny\'fbv\'e9 tett\'fck a Kor\'e1nt az eml\'e9kez\'e9sre. Van-e h\'e1t olyasvalaki, aki okul [az int\'e9sb\'f5l]?
\par 41. \'c9s bizony, a F\'e1ra\'f3 n\'e9p\'e9hez is elj\'f6ttek a figyelmeztet\'e9sek.
\par 42. Meghazudtolt\'e1k minden jel\'fcnket, ez\'e9rt elragadtuk \'f5ket \'fagy, ahogyan a M\'e9lt\'f3s\'e1gteljes \'e9s Mindenhat\'f3 b\'fcntet.
\par 
\par 43. Vajon a hitetlenjeitek jobbak-e [\'f3 Kurejs t\'f6rzse] ezekn\'e9l? Vagy tal\'e1n mentess\'e9getek van az \'cdr\'e1sokban?
\par 44. Mi t\'f6bb, \'f5k azt mondj\'e1k: \'84Mi egy gy\'f5zedelmes sokas\'e1g vagyunk!\'94
\par 45. [Ez] a sokas\'e1g le lesz gy\'f5zve \'e9s h\'e1tat fognak ford\'edtani [menek\'fclve].
\par 46. \'c1m az \'d3ra (a Felt\'e1mad\'e1s) a meg\'edg\'e9rt idej\'fck, \'e9s az \'d3ra keservesebb \'e9s keser\'fbbb [a veres\'e9gn\'e9l]!
\par 
\par 47. Bizony a gonosztev\'f5k t\'e9velyg\'e9sben [vannak] \'e9s a L\'e1ngol\'f3 [Pokol-t\'fbzbe] fognak ker\'fclni.
\par 48. Azon a napon, amikor az arcukon vonszoltatnak majd a [Pokol-]t\'fbzben, [az lesz mondva nekik:] \'84\'cdzlelj\'e9tek meg a Perzsel\'f5 [Pokol-]t\'fbz \'e9rint\'e9s\'e9t!\'94
\par 49. Bizony, Mi mindent megszabott m\'e9rt\'e9k szerint teremtett\'fcnk.
\par 50. \'c9s a parancsunk nem m\'e1s, csup\'e1n egyetlen [sz\'f3, amelynek megval\'f3sul\'e1sa annyi,] ak\'e1r egy szempillant\'e1s.
\par 
\par 51. \'c9s bizony, [kor\'e1bban] m\'e1r elpuszt\'edtottuk a [hitetlens\'e9gben] hozz\'e1tok hasonl\'f3kat, van-e h\'e1t olyasvalaki, aki okul [az int\'e9sb\'f5l]?
\par 52. \'c9s minden dolog, amit tettek, az \'edr\'e1sokban van [feljegyezve].
\par 53. \'c9s minden kicsi \'e9s nagy [cselekedet] fel van jegyezve.
\par 54. Bizony, az istenf\'e9l\'f5k kertekben \'e9s foly\'f3k k\'f6z\'f6tt lesznek [a Paradicsomban],
\par 55. Igaz helyen, egy Mindenhat\'f3 Uralkod\'f3 [k\'f6zels\'e9g\'e9ben].}{\insrsid10757626 
\par 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid11695939 \hich\af0\dbch\af13\loch\f0 \hich\f0 55. A K\'f6\loch\f0 \hich\f0 ny\'f6\hich\af0\dbch\af13\loch\f0 \hich\f0 r\'fc
\loch\f0 \hich\f0 letes (Ar-Rahman) c. sz\'fa\loch\f0 ra}{\b0\fs24\insrsid10757626\charrsid1580795 
\par }\pard\plain \qj \li14\ri-1\widctlpar\tx374\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin-1\lin14\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid1580795 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. A K\'f6ny\'f6r\'fcletes
\par }\pard \qj \li0\ri-1\widctlpar\tx374\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin-1\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid1580795 2. Megtan\'edtotta a Kor\'e1nt,
\par 3. Megteremtette az embert,
\par 4. Megtan\'edtotta \'f5t a [vil\'e1gos] \'f6nkifejez\'e9sre.
\par 5. A nap \'e9s a hold [pontosan] kisz\'e1m\'edtott m\'f3don [mozognak].
\par 6. \'c9s a csillagok \'e9s a f\'e1k leborulnak [Allah el\'f5tt].
\par 7. \'c9s [Allah] felemelte az eget, \'e9s fel\'e1ll\'edtotta a m\'e9rleget (el\'f5\'edrta az igazs\'e1goss\'e1got),
\par 8. Hogy ne vetemedjetek t\'falkap\'e1sra a m\'e9rleggel (igazs\'e1goss\'e1ggal) kapcsolatban.
\par 9. \'c9s v\'e9gezz\'e9tek el a m\'e9r\'e9st az igazs\'e1gnak megfelel\'f5en, \'e9s ne r\'f6vid\'edts\'e9tek meg a m\'e9rt\'e9ket!
\par 10. \'c9s a f\'f6ldet az [emberi] teremtm\'e9nyek al\'e1 rendelte.
\par 11. Azon gy\'fcm\'f6lcs\'f6k \'e9s kehelyvir\'e1gos datolyap\'e1lm\'e1k vannak.
\par 12. \'c9s szalm\'e1t ad\'f3 gabona, \'e9s illatos n\'f6v\'e9nyek.
\par 13. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 
\par 14. Megteremtette az embert sz\'e1raz agyagb\'f3l, a cser\'e9ped\'e9nyhez hasonl\'f3an.
\par 15. \'c9s megteremtette a dzsinneket [f\'fcsttelen] t\'fbz l\'e1ngj\'e1b\'f3l.
\par 16. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 
\par 17. [\'d5] a k\'e9t napkelet \'e9s a k\'e9t napnyugat Ura.
\par 18. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 19. [\'d5 az, Aki] engedte a k\'e9t tengert folyni, [hogy] tal\'e1lkozzanak.
\par 20. [\'c1m] k\'f6z\'f6tt\'fck akad\'e1ly tal\'e1lhat\'f3, melyen \'e1t nem l\'e9phetnek.
\par 21. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 22. Kettej\'fckb\'f5l ker\'fcl el\'f5 a gy\'f6ngy \'e9s a korall.
\par 23. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 24. \'c9s \'d6v\'e9 a tovasiet\'f5 [haj\'f3k], amelyek hegyk\'e9nt magasodnak a tengeren.
\par 25. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 
\par 26. Minden muland\'f3, ami rajta (a f\'f6ld\'f6n) van,
\par 27. \'c9s [csak] Urad arca (\'d5 maga) marad meg, a fens\'e9g \'e9s a b\'f5kez\'fbs\'e9g Birtokosa.
\par 28. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 29. \'d5t k\'e9ri mindenki, aki az egekben \'e9s a f\'f6ld\'f6n van. \'d5 a nap minden [egyes r\'e9sz\'e9ben] valamilyen \'fcgyben [d\'f6nt].
\par 30. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 31. Hamarosan fel\'e9tek fordulunk, [hogy elsz\'e1moltassunk titeket,] ti k\'e9t s\'falyos [teremtm\'e9ny \endash  emberek \'e9s dzsinnek]!
\par 32. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 
\par 33. \'d3 dzsinnek \'e9s emberek gy\'fclekezete! Ha k\'e9pesek vagytok az egek \'e9s a f\'f6ld sz\'e9lein \'e1thatolva [elmenek\'fclni el\'f5l\'fcnk], \'fagy tegy\'e9tek meg! De nem hatolhattok \'e1t, csup\'e1n [Allaht\'f3l kapott] hatalommal.
\par 34. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 35. A t\'fbz l\'e1ngjai \'e9s izz\'f3 r\'e9z k\'fcldetik r\'e1tok, \'e9s nem tudtok [ellen\'fck] magatokon seg\'edteni.
\par 36. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 
\par 37. \'c9s amikor sz\'e9thasad az \'e9g, \'e9s olyan [v\'f6r\'f6s] lesz mint a r\'f3zsa, [tiszta] mint a forr\'f3 olaj.
\par 38. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 39. \'c9s azon a napon nem k\'e9rdeztetik meg b\'fbneir\'f5l sem ember, sem dzsinn.
\par 40. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 41. A gonosztev\'f5k ismertet\'f5jeleikr\'f5l ismertetnek fel, \'e9s az \'fcst\'f6k\'fckn\'e9l \'e9s a l\'e1baikn\'e1l fogva ragadtatnak meg.
\par 42. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 43. Ez a Gyehenna, amelyet a gonosztev\'f5k meghazudtolnak.
\par 44. K\'f6rbej\'e1rnak e k\'f6z\'f6tt \'e9s fortyog\'f3 forr\'e1sban l\'e9v\'f5 v\'edz k\'f6z\'f6tt.
\par 45. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 
\par 46. \'c1m aki f\'e9lt att\'f3l, hogy Ura el\'e9 kell \'e1llnia [az elsz\'e1moltat\'e1sra az \'cdt\'e9let napj\'e1n], annak k\'e9t kert j\'e1r [a Paradicsomban].
\par 47. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 48. [\'c9rett term\'e9sekkel teli] \'e1gakkal \'e9kes mindkett\'f5.
\par 49. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 50. K\'e9t patak folyik mindkett\'f5ben.
\par 51. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 52. Mindenf\'e9le gy\'fcm\'f6lcsb\'f5l k\'e9t fajta van mindkett\'f5ben.
\par 53. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 54. Brok\'e1ttal b\'e9lelt k\'e9nyelmes \'e1gyakra d\'f5lve fekszenek, \'e9s a k\'e9t kert gy\'fcm\'f6lcsei m\'e9lyen al\'e1cs\'fcng\'f5ek.
\par 55. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 56. Azokban szem\'e9rmes tekintet\'fb [n\'f5k] lesznek, akiket el\'f5tt\'fck m\'e9g sem ember sem dzsinn nem \'e9rintett.
\par 57. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 58. Mintha rubintok \'e9s korallok lenn\'e9nek.
\par 59. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 60. Vajon m\'e1s-e a j\'f3tett fizets\'e9ge, mint a j\'f3 [jutalom]?
\par 61. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 62. \'c9s e k\'e9t [kert] alatt m\'e9g k\'e9t kert van.
\par 63. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 64. S\'f6t\'e9ten z\'f6ldell\'f5k [ezek].
\par 65. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 66. K\'e9t bugyog\'f3 forr\'e1s van mindkett\'f5ben.
\par 67. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 68. Mindkett\'f5ben gy\'fcm\'f6lcs\'f6k, datolyap\'e1lm\'e1k \'e9s gr\'e1n\'e1talmaf\'e1k vannak.
\par 69. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 70. J\'f3s\'e1gos [\'e9s] gy\'f6ny\'f6r\'fb [feles\'e9gek] lesznek mindazokban.
\par 71. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 72. S\'e1trakban \'f5rz\'f6tt, nagyszem\'fb [sz\'e9p] n\'f5k.
\par 73. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 74. Nem \'e9rintette \'f5ket el\'f5tt\'fck sem ember, sem dzsinn.
\par 75. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 76. Z\'f6ld bor\'edt\'e1s\'fa p\'e1rn\'e1kra \'e9s gy\'f6ny\'f6r\'fb sz\'f5nyegekre d\'f5lve fekszenek.
\par 77. H\'e1t Uratok melyik j\'f3t\'e9tem\'e9ny\'e9t hazudtolj\'e1tok meg ti ketten?
\par 78. \'c1ldass\'e9k az Uradnak, a fens\'e9g \'e9s a b\'f5kez\'fbs\'e9g Birtokos\'e1nak a neve!}{\insrsid10757626 
\par 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\cf1\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid11695939 \hich\af0\dbch\af13\loch\f0 56. A \hich\af0\dbch\af13\loch\f0 \hich\f0 bek\'f6\loch\f0 \hich\f0 vetkez\'f5\loch\f0 
\hich\f0  (Al-V\'e1\loch\f0 \hich\f0 kia) c. sz\'fa\loch\f0 ra}{\cf1\insrsid10757626\charrsid7948041 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\cf1\insrsid10757626\charrsid7948041 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. Amikor bek\'f6vetkezik a Bek\'f6vetkez\'f5,
\par 2. A bek\'f6vetkezt\'e9nek nem lesz meghazudtol\'f3ja.
\par 3. [N\'e9melyeket] lealacsony\'edt, [m\'e1sokat] felemel.
\par 4. Amikor megr\'e1zk\'f3dik a f\'f6ld [sz\'f6rny\'fb] r\'e1zk\'f3d\'e1ssal,
\par 5. \'c9s a hegyek porr\'e1 morzsol\'f3dnak,
\par 6. \'c9s sz\'e9tsz\'e1ll\'f3 porszemekk\'e9 v\'e1lnak.
\par 7. \'c9s ti h\'e1romf\'e9l\'e9k lesztek:
\par 8. A jobb k\'e9z fel\'f5liek. [De] milyenek a jobb k\'e9z fel\'f5liek?
\par 9. \'c9s a bal k\'e9z fel\'f5liek. [De] milyenek a bal k\'e9z fel\'f5liek?
\par 10. \'c9s [az evil\'e1gon a j\'f3tettekben] az \'e9lenj\'e1r\'f3k, az \'e9lenj\'e1r\'f3k [a t\'falvil\'e1gon].
\par 
\par 11. \'d5k azok, akik [Allahhoz] k\'f6zel\'e1ll\'f3k.
\par 12. A gy\'f6ny\'f6r\'fbs\'e9g Kertjeiben [lesznek a Paradicsomban].
\par 13. [\'d5k] egy [nagy] sokas\'e1g a hajdanvoltak k\'f6z\'fcl.
\par 14. \'c9s kevesen [vannak] a k\'e9s\'f5bbi [nemzed\'e9kekb\'f5l].
\par 15. Arannyal sz\'f5tt \'e1gyakon [lesznek].
\par 16. [Azokra] d\'f5lve fekszenek, egym\'e1ssal szemben.
\par 17. \'d6r\'f6kl\'e9t\'fb ifjak j\'e1rnak k\'f6rbe k\'f6z\'f6tt\'fck [szolg\'e1lv\'e1n \'f5ket].
\par 18. Kup\'e1kkal, kancs\'f3kkal \'e9s poh\'e1rral, [amelyekben olyan] kifogyhatatlan forr\'e1sb\'f3l sz\'e1rmaz\'f3 [ital van],
\par 19. Amit\'f5l fej\'fck nem f\'e1j \'e9s nem r\'e9szegednek le.
\par 20. \'c9s [olyan] gy\'fcm\'f6lcs\'f6kkel, amit [csak] v\'e1lasztanak [maguknak].
\par 21. \'c9s madarak h\'fas\'e1val, amit [csak] megk\'edv\'e1nnak.
\par 22. \'c9s sz\'e9p, nagyszem\'fb n\'f5k [lesznek a feles\'e9geik],
\par 23. Mintha elrejtett gy\'f6ngy\'f6k lenn\'e9nek,
\par 24. Fizets\'e9gk\'e9ppen az\'e9rt, amit cselekedtek.
\par 25. Nem hallanak ott felesleges besz\'e9det, sem b\'fbnt [id\'e9z\'f5 szavakat].
\par 26. Csup\'e1n az mondatik: \'84B\'e9kess\'e9g, b\'e9kess\'e9g!\'94
\par 
\par 27. \'c9s a jobb k\'e9z fel\'f5liek. De milyenek a jobb k\'e9z fel\'f5liek?
\par 28. [\'d5k] t\'f6vistelen t\'f6visf\'e1k [sokf\'e9le term\'e9sei] k\'f6z\'f6tt,
\par 29. \'c9s egym\'e1sra r\'e9tegzett, ban\'e1nt [term\'f5] f\'e1k [k\'f6z\'f6tt],
\par 30. \'c9s messze ny\'fal\'f3 \'e1rny\'e9kban [lesznek],
\par 31. \'c9s sz\'fcntelen\'fcl csobog\'f3 v\'edz [mellett].
\par 32. \'c9s sokf\'e9le gy\'fcm\'f6lccsel [lesznek k\'f6r\'fclv\'e9ve],
\par 33. [Amelyek] el nem fogynak, \'e9s nem is lesznek megtiltva [sz\'e1mukra],
\par 34. \'c9s magasra emelt k\'e9nyelmes \'e1gyakon [lesznek].
\par 35. Bizony, Mi [egy m\'e1sik] teremt\'e9ssel teremtett\'fck \'f5ket (a Paradicsom n\'f5i lak\'f3it).
\par 36. \'c9s sz\'fczekk\'e9 tett\'fck \'f5ket,
\par 37. Odaad\'f3kk\'e1, azonos kor\'faakk\'e1,
\par 38. A jobbk\'e9z fel\'f5lieknek.
\par 39. [\'d5k] egy sokas\'e1g a hajdanvoltak k\'f6z\'fcl,
\par 40. \'c9s egy sokas\'e1g a k\'e9s\'f5bbi [nemzed\'e9kek] k\'f6z\'fcl.
\par 
\par 41. \'c9s a bal k\'e9z fel\'f5liek. De milyenek a bal k\'e9z fel\'f5liek?
\par 42. A forr\'f3 fuvallat\'fa [sz\'e9lben] \'e9s a forr\'e1sban l\'e9v\'f5 v\'edzben [lesznek],
\par 43. \'c9s fekete f\'fcst \'e1rny\'e9k\'e1ban,
\par 44. [Amely] nem h\'fbv\'f6s \'e9s nem j\'f3t\'e9kony.
\par 45. Bizony, \'f5k kor\'e1bban d\'fask\'e1ltak a j\'f3l\'e9tben.
\par 46. \'c9s meg\'e1talkodottak voltak a hatalmas b\'fbnben.
\par 47. \'c9s [mindig] azt mondt\'e1k: \'84Vajon ha m\'e1r meghaltunk, \'e9s porr\'e1 \'e9s csontt\'e1 lett\'fcnk, akkor \'faj \'e9letre lesz\'fcnk felt\'e1masztva?
\par 48 \'c9s vajon a hajdanvolt aty\'e1ink [is]?
\par 49. Mondd [\'f3 Mohamed]: \'84Bizony, a hajdanvolt \'e9s a k\'e9s\'f5bbi [nemzed\'e9kek is].
\par 50. Bizonyosan \'f6ssze lesznek gy\'fbjtve egy kijel\'f6lt id\'f5pont\'fa, meghat\'e1rozott napon.\'94
\par 51. Majd bizony ti, \'f3 t\'e9velyg\'f5k \'e9s meghazudtol\'f3k!
\par 52. Bizonyosan enni fogtok a [Pokol-t\'fbzben l\'e9v\'f5] Zakk\'fam-fa [term\'e9s\'e9b\'f5l].
\par 53. \'c9s abb\'f3l fogj\'e1tok telet\'f6mni a hasatokat.
\par 54. \'c9s forr\'f3 vizet isztok majd r\'e1.
\par 55. \'c9s az olthatatlan szomj\'fas\'e1gban szenved\'f5 tev\'e9k m\'f3dj\'e1ra fogtok inni.
\par 56. Ez [lesz] az \'f5 sz\'e1ll\'e1shely\'fck az \'cdt\'e9let Napj\'e1n.
\par 
\par 57. Mi teremtett\'fcnk titeket. Mi\'e9rt nem tartj\'e1tok h\'e1t igaznak [a Felt\'e1mad\'e1s napj\'e1t]?
\par 58. Vajon h\'e1t mit gondoltok? Amit kil\'f6velltek,
\par 59. Vajon ti teremtitek [emberr\'e9], avagy Mi vagyunk a }{\cf1\insrsid10757626 T}{\cf1\insrsid10757626\charrsid7948041 eremt\'f5?
\par 60. Mi rendelt\'fck el k\'f6z\'f6ttetek a hal\'e1lt, \'e9s Minket senki sem el\'f5zhet meg
\par 61. Abban, hogy hozz\'e1tok hasonl\'f3kra cser\'e9lj\'fcnk le titeket, \'e9s hogy \'fajra teremts\'fcnk titeket [abban az \'e1llapotban], amir\'f5l nem tudtok.
\par 62. Holott ti [m\'e1r] megismert\'e9tek az els\'f5 (kezdeti) teremt\'e9st. H\'e1t mi\'e9rt nem okultok [az int\'e9sb\'f5l]?}{\cf1\insrsid10757626 
\par 
\par 63. Vajon h\'e1t mit gondoltok [a magokr\'f3l], amelyeket vettek [a f\'f6ldbe]?
\par 64. Vajon ti sarjasztj\'e1tok [a n\'f6v\'e9nyt] abb\'f3l, avagy Mi vagyunk a sarjaszt\'f3ja?
\par 65. Ha akarn\'e1nk, bizony elsz\'e1radt k\'f3r\'f3v\'e1 tenn\'e9nk azt, ti pedig sz\'fcntelen\'fcl csod\'e1lkozn\'e1tok [azt mondv\'e1n:]
\par 66. \'84Bizony mi [most] elad\'f3sodtunk!
\par }{\cf1\insrsid10757626\charrsid7948041 67. Mi t\'f6bb, mi meg vagyunk fosztva [a term\'e9s\'fcnk haszn\'e1t\'f3l]!\'94
\par 68. Vajon h\'e1t mit gondoltok a v\'edzr\'f5l, amit isztok?
\par 69. Vajon ti bocs\'e1tott\'e1tok azt le az es\'f5felh\'f5b\'f5l, avagy Mi vagyunk a lebocs\'e1t\'f3k?
\par 70. Ha akarn\'e1nk er\'f5sen s\'f3ss\'e1 [\'e9s keser\'fbv\'e9] tenn\'e9nk azt. H\'e1t mi\'e9rt nem vagytok h\'e1l\'e1sak?
\par 71. Vajon h\'e1t mit gondoltok a t\'fbzr\'f5l, amit gy\'fajtotok?
\par 72. Vajon ti hozt\'e1tok l\'e9tre a [hozz\'e1 val\'f3] f\'e1t, avagy Mi vagyunk annak a L\'e9trehoz\'f3ja?
\par 73. Mi bizony eml\'e9keztet\'f5v\'e9 tett\'fck azt \'e9s ell\'e1t\'e1sul az utaz\'f3knak.
\par 74. Magasztald h\'e1t a Hatalmas Urad nev\'e9t!}{\cf1\insrsid10757626 
\par 
\par 75. De nem! Esk\'fcsz\'f6m a csillagok lenyugv\'f3helyeire.
\par 76. \'c9s bizony hatalmas esk\'fc ez! B\'e1rcsak tudn\'e1tok!
\par 77. Ez bizony Kegyes Kor\'e1n!
\par 78. Egy elrejtett (j\'f3l \'f5rz\'f6tt) K\'f6nyvben.
\par 79. Csak a megtiszt\'edtottak \'e9rinthetik azt.
\par 80. Lebocs\'e1tott [kinyilatkoztat\'e1s] a teremtm\'e9nyek Ur\'e1t\'f3l.
\par 
\par 81. Vajon ezzel a besz\'e9ddel (a Kor\'e1nnal) kapcsolatban vagytok ti megalkuv\'f3k?
\par 82. \'c9s ell\'e1t\'e1sotok [ir\'e1nti h\'e1l\'e1b\'f3l] teszitek azt, hogy meghazudtolj\'e1tok?
\par 83. H\'e1t mi\'e9rt nem [l\'e9ptek k\'f6zbe akkor], amikor [a l\'e9lek] el\'e9r a torokhoz
\par 84. \'c9s ti \'e9ppen akkor n\'e9zitek [a haldokl\'f3t]?
\par 85. Holott Mi k\'f6zelebb vagyunk hozz\'e1, mint ti, \'e1m ti azt nem l\'e1thatj\'e1tok.
\par 86. H\'e1t mi\'e9rt nem [tesztek ellene], ha [}{\cf1\insrsid10757626\charrsid7948041 biztosak vagytok abban, hogy] nem lesztek meg\'edt\'e9lve [a T\'falvil\'e1gon]?
\par 87. [Akkor] hozz\'e1tok vissza a [lelket a testbe], ha }{\insrsid10757626\charrsid7948041 val\'f3ban }{\cf1\insrsid10757626\charrsid7948041 igazmond\'f3k vagytok!
\par 
\par 88. \'c9s ha \'f5 (a halott) a k\'f6zel\'e1ll\'f3k k\'f6z\'e9 tartozott,
\par 89. Akkor pihen\'e9s, illatos hely \'e9s gy\'f6ny\'f6r\'fbs\'e9g kertje [v\'e1rja a Paradicsomban].
\par 90. \'c1m ha \'f5 (a halott) a jobbk\'e9z fel\'f5liek k\'f6z\'e9 tartozik,
\par 91. Akkor [az mondatik neki:] \'84B\'e9kess\'e9g neked a jobbk\'e9z fel\'f5liekt\'f5l.\'94
\par 92. \'c1m ha \'f5 a meghazudtol\'f3k, a t\'e9velyg\'f5k k\'f6z\'e9 tartozik,
\par 93. Akkor forr\'f3 v\'edz lesz a sz\'e1ll\'e1shelye,
\par 94. \'c9s a Pokolban fog \'e9gni.
\par 95. Ez bizony a k\'e9ts\'e9gtelen bizonyoss\'e1g!
\par 96. Magasztald h\'e1t a Hatalmas Urad nev\'e9t!}{\cf1\insrsid10757626 
\par 
\par 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid10757626 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\cf1\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid11695939 \hich\af0\dbch\af13\loch\f0 57. A \hich\af0\dbch\af13\loch\f0 \hich\f0 vas (al-Had\'ed\loch\f0 \hich\f0 d) c. sz\'fa
\loch\f0 ra}{\insrsid10757626\charrsid11350926 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid11350926 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par 
\par 1. Allahot magasztalja mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van, \'e9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 2. \'d6v\'e9 a }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid11350926 kir\'e1lyi uralom}{\insrsid10757626\charrsid11350926  az egekben \'e9s a f\'f6ld\'f6n, \'e9letre kelt \'e9s hal\'e1lba bocs\'e1t, \'e9s \'d5 minden dologra kiterjed
\'f5 hatalm\'fa.
\par 3. \'d5 az Els\'f5 \'e9s a V\'e9gs\'f5, a Legfels\'f5bb, \'e9s a Legk\'f6zelebbi, \'e9s \'d5 minden dologr\'f3l tudom\'e1ssal b\'edr.
\par 4. \'d5 az, Aki hat nap alatt teremtette az egeket \'e9s a f\'f6ldet, azut\'e1n elhelyezkedett [Hozz\'e1 m\'e9lt\'f3an] a Tr\'f3nuson. Tudja, hogy mi megy be a f\'f6ldbe, \'e9s mi j\'f6n ki abb\'f3l, \'e9s mi j\'f6n le az \'e9gb\'f5l \'e9s mi emelk
edik fel oda. \'d5 veletek van, ahol csak vagytok. \'c9s Allah \'e1tl\'e1tja azt, amit cselekedtek.
\par 5. \'d6v\'e9 a }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid11350926 kir\'e1lyi uralom}{\insrsid10757626\charrsid11350926  az egekben \'e9s a f\'f6ld\'f6n, \'e9s Allahhoz vitetnek vissza az \'fcgyek [d\'f6nt\'e9sre].
\par 6. [Allah] beleviszi az \'e9jszak\'e1t a nappalba, \'e9s beleviszi a nappalt az \'e9jszak\'e1ba, \'e9s \'d5neki tudom\'e1sa van arr\'f3l, amit a keblek (sz\'edvek) rejtenek.
\par 
\par 7. Higgyetek Allahban \'e9s a K\'fcld\'f6tt\'e9ben \'e9s adakozzatok abb\'f3l, aminek [birtokosai] hely\'e9be l\'e9ptetett ut\'f3dk\'e9nt titeket! \'c9s akik hisznek k\'f6z\'fcletek \'e9s adakoznak, azoknak nagy fizets\'e9g j\'e1r.
\par 8. \'c9s mi lelt titeket, hogy nem hisztek Allahban, holott a K\'fcld\'f6tt arra h\'edv titeket, hogy higgyetek Uratokban, hiszen \'d5 m\'e1r sz\'f6vets\'e9get k\'f6t\'f6tt veletek? [Mi\'e9rt nem engedelmeskedtek a K\'fcld\'f6ttnek], ha }{
\insrsid10757626\charrsid11350926 val\'f3ban }{\insrsid10757626\charrsid11350926 h\'edv\'f5k vagytok?
\par 9. \'d5 az, Aki vil\'e1gos jeleket bocs\'e1t le a szolg\'e1j\'e1nak (Mohamednek), hogy kivezessen titeket a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9gekb\'f5l a f\'e9nyre. \'c9s bizony, Allah Egy\'fctt\'e9rz\'f5 ir\'e1ntatok, Irgalmas[veletek].
\par 10. \'c9s mi lelt titeket, hogy nem adakoztok Allah \'fatj\'e1n, holott Allah\'e9 az egek \'e9s a f\'f6ld \'f6r\'f6ks\'e9ge? Azok, akik a gy\'f5zelem (Mekka megh\'f3d\'edt\'e1sa) el\'f5tt adakoztak \'e9s harcoltak k\'f6z\'fcletek, nem egyenl\'f5ek [m\'e1
sokkal]. \'d5k hatalmasabb fokozat\'faak azokn\'e1l, akik azut\'e1n adakoztak \'e9s harcoltak. De Allah mindannyiuknak a legjobbat \'edg\'e9ri. \'c9s Allahnak tudom\'e1sa van arr\'f3l, amit cselekszetek.
\par 11. Ki az, aki sz\'e9p k\'f6lcs\'f6nt }{\insrsid10757626\charrsid3307951 ad Allahnak (a k\'f6telez\'f5n fel\'fcl ad}{\insrsid10757626 akozik}{\insrsid10757626\charrsid3307951 )}{\insrsid10757626\charrsid11350926 , hogy \'d5 megt\'f6bbsz\'f6r\'f6
zze azt a sz\'e1m\'e1ra, \'e9s nemes jutalom j\'e1rjon neki?
\par 
\par 12. Azon a napon l\'e1thatod, amint a h\'edv\'f5 f\'e9rfiak \'e9s a h\'edv\'f5 n\'f5k el\'f5tt \'e9s a jobb kez\'fck fel\'f5l halad el\'f5re a vil\'e1goss\'e1guk. [Az lesz mondva nekik]: \'84\'d6r\'f6mh\'edr [van] ma sz\'e1
motokra! Kertek [a Paradicsomban], amelyek al\'f3l patakok folynak, \'f6r\'f6kk\'e9 abban maradtok. Ez a hatalmas diadal!\'94
\par 13. Azon a napon a k\'e9pmutat\'f3 f\'e9rfiak \'e9s a k\'e9pmutat\'f3 n\'f5k azt mondj\'e1k a h\'edv\'f5knek: \'84V\'e1rjatok meg minket, hadd r\'e9szes\'fclhess\'fcnk a vil\'e1goss\'e1gotokb\'f3l!\'94 [Akkor az lesz nekik] mondva: \'84T\'e9
rjetek vissza magatok m\'f6g\'e9 [az evil\'e1gba], s keressetek [ott] vil\'e1goss\'e1got!\'94 \'c9s fel lesz \'e1ll\'edtva k\'f6z\'e9j\'fck egy fal, melynek van egy kapuja. Azon bel\'fcl [a h\'edv\'f5k fel\'f5l] van a k\'f6ny\'f6r\'fclet, \'e9s azon k\'ed
v\'fcl [a k\'e9pmutat\'f3k \'e9s a hitetlenek] fel\'f5l van a gy\'f6trelem.
\par 14. \'c9s [a k\'e9pmutat\'f3k] sz\'f3l\'edtani fogj\'e1k \'f5ket: \'84Nem voltunk-e veletek [az evil\'e1gon]?\'94 Azt fogj\'e1k mondani [a h\'edv\'f5k]: \'84Dehogynem! Azonban ti k\'eds\'e9rt\'e9sbe vitt\'e9tek magatokat (egyik a m\'e1sikat), [a veszt\'fc
nket] v\'e1rt\'e1tok, k\'e9telkedtetek \'e9s megt\'e9vesztettek titeket a v\'e1gyak, am\'edg [v\'e9g\'fcl] el nem j\'f6tt Allah d\'f6nt\'e9se. \'c9s megt\'e9vesztetett titeket Allahot illet\'f5en a megt\'e9veszt\'f5 (a s\'e1t\'e1n).
\par 15. \'c9s a mai napon nem fogadtatik el t\'f5letek v\'e1lts\'e1gd\'edj, sem azokt\'f3l, akik hitetlenek. Hajl\'e9kotok a [Pokol-]t\'fbz lesz, az lesz a p\'e1rtfog\'f3tok. \'c9s milyen nyomor\'fas\'e1gos v\'e9gc\'e9l!\'94
\par 
\par 16. Vajon nem j\'f6tt el az id\'f5 azok sz\'e1m\'e1ra, akik hisznek, hogy al\'e1zattal teljen meg a sz\'edv\'fck az Allahr\'f3l val\'f3 megeml\'e9kez\'e9st\'f5l \'e9s az igazs\'e1gt\'f3l, ami lej\'f6tt [kinyilatkoztat\'e1sk\'e9nt], \'e9
s hogy ne legyenek olyanok, mint azok, akiknek az \'cdr\'e1s adatott kor\'e1bban, [akik] sz\'e1m\'e1ra hossz\'fara ny\'falt az id\'f5, s megkem\'e9nyedett az \'f5 sz\'edv\'fck? \'c9s sokan k\'f6z\'fcl\'fck engedetlenek.
\par 17. Tudj\'e1tok meg, hogy Allah kelti \'e9letre a f\'f6ldet, annak hal\'e1la ut\'e1n. Mi m\'e1r vil\'e1goss\'e1 tett\'fck sz\'e1motokra a jeleket, h\'e1tha \'e9ltek az eszetekkel.
\par 
\par 18. Bizony, az adakoz\'f3 f\'e9rfiak \'e9s az adakoz\'f3 n\'f5k, \'e9s [akik] sz\'e9p k\'f6lcs\'f6nt adnak Allahnak}{\insrsid10757626  }{\insrsid10757626\charrsid3307951 (a k\'f6telez\'f5n fel\'fcl ad}{\insrsid10757626 akozna}{
\insrsid10757626\charrsid3307951 k)}{\insrsid10757626\charrsid11350926 , azoknak megt\'f6bbsz\'f6r\'f6z\'f5dik [a fizets\'e9g\'fck], \'e9s nemes jutalom j\'e1r nekik.
\par 19. \'c9s akik hisznek Allahban \'e9s a K\'fcld\'f6tteiben, azok bizony az igazak \'e9s a v\'e9rtan\'fak [soraiban lesznek] az Uruk el\'f5tt, meglesz nekik a jutalmuk \'e9s a vil\'e1goss\'e1guk. \'c1m akik hitetlenek \'e9s meghazudtolt\'e1
k a jeleinket, azok a Pokol lak\'f3i lesznek.
\par 20. Tudj\'e1tok meg, hogy az evil\'e1gi \'e9let csup\'e1n j\'e1tszadoz\'e1s, sz\'f3rakoz\'e1s, d\'edsz, egym\'e1s k\'f6z\'f6tti dicsekv\'e9s \'e9s rivaliz\'e1l\'e1s a javak \'e9s a gyermekek ter\'e9n! Hasonlatos a z\'e1pores\'f5h\'f6z, [amelynek nyom\'e1
n] n\'f6v\'e9nyzet [hajt ki], [amely] tetszik a sz\'e1nt\'f3vet\'f5knek, majd elsz\'e1rad, \'e9s l\'e1tod amint els\'e1rgul, azt\'e1n sz\'e1raz k\'f3r\'f3 lesz. }{\cf1\insrsid10757626\charrsid11350926 A t\'falvil\'e1gon azonban a [hitetleneknek] szigor
\'fa gy\'f6trelem lesz, \'e9s megbocs\'e1t\'e1s \'e9s megel\'e9ged\'e9s [a h\'edv\'f5knek]. \'c9s az evil\'e1gi \'e9let nem m\'e1s, csup\'e1n megt\'e9veszt\'f5 [muland\'f3] \'e9lvezet.
\par 21. Igyekezzetek Uratok megbocs\'e1t\'e1s\'e1\'e9rt \'e9s egy olyan kert\'e9rt [a Paradicsomban], amely olyan sz\'e9les, mint az \'e9g \'e9s a f\'f6ld, s amely el\'f5k\'e9sz\'edttetett azoknak, akik hisznek Allahban \'e9s a K\'fcld\'f6
tteiben! Ez Allah kegye, annak adja, akinek akarja. \'c9s Allah a hatalmas kegy birtokosa.
\par 
\par 22. Nem \'e9rheti egyetlen csap\'e1s sem a f\'f6ldet, sem titeket, an\'e9lk\'fcl hogy ne [az] lenne az \'cdr\'e1sban, m\'e9g miel\'f5tt megalkottuk volna azokat. Bizony, k\'f6nny\'fb ez Allahnak,
\par 23. Hogy ne b\'e1nk\'f3djatok az\'e9rt, amit elmulasztottatok, \'e9s ne \'f6rvendezzetek annak, amit [Allah] adott nektek. \'c9s Allah nem szeret egyetlen p\'f6ffeszked\'f5t, dicsekv\'f5t sem,
\par 24 [Sem azokat] akik fukarkodnak, \'e9s arra sz\'f3l\'edtj\'e1k fel az embereket, hogy fukarok legyenek. Aki h\'e1tat ford\'edt [a hitnek, az a maga k\'e1r\'e1ra teszi], mert bizony Allah [az, aki] a Gazdag, a Dics\'e9retrem\'e9lt\'f3.
\par 
\par 25. Bizony, elk\'fcldt\'fck [m\'e1r] kor\'e1bban a K\'fcld\'f6tteinket a vil\'e1gos bizony\'edt\'e9kokkal, \'e9s lebocs\'e1tottuk vel\'fck az \'cdr\'e1st \'e9s a m\'e9rleget, hogy az emberek fenntarts\'e1k az igazs\'e1goss\'e1got [egym\'e1s k\'f6z\'f6
tt]. \'c9s lebocs\'e1tottuk a vasat, amelyben sz\'f6rny\'fb csap\'e1s van \'e9s hasznok az emberek sz\'e1m\'e1ra, az\'e9rt, hogy Allah nyilv\'e1nval\'f3v\'e1 tegye azt, amit m\'e1r tudott arr\'f3l, hogy ki seg\'edti \'d5t \'e9s a K\'fcld\'f6tteit an\'e9lk
\'fcl, hogy l\'e1tn\'e1 \'d5t. Bizony, Allah Er\'f5s, M\'e9lt\'f3s\'e1gteljes.
\par 26. \'c9s elk\'fcldt\'fck kor\'e1bban No\'e9t \'e9s \'c1brah\'e1mot, \'e9s kettej\'fck lesz\'e1rmazottainak adtuk a pr\'f3f\'e9tas\'e1got \'e9s az \'cdr\'e1st, \'edgy van k\'f6zt\'fck olyan, aki az [igaz] \'fatra lelt, \'e1m sokan k\'f6z\'fcl\'fc
k engedetlenek.
\par 27. Majd ut\'e1nuk k\'fcldt\'fck az \'f5 nyomdokaikba a K\'fcld\'f6tteinket. \'c9s ut\'e1nuk k\'fcldt\'fck J\'e9zust, M\'e1ria fi\'e1t, \'e9s az Evang\'e9liumot adtuk neki. \'c9s a k\'f6vet\'f5inek a sz\'edv\'e9be egy\'fctt\'e9rz\'e9st \'e9s k\'f6ny\'f6r
\'fcletet helyezt\'fcnk. \'c9s a szerzetess\'e9get \'f5k tal\'e1lt\'e1k ki, Mi nem \'edrtuk el\'f5 nekik azt, csak [az\'e9rt tal\'e1lt\'e1k ki,] hogy Allah megel\'e9ged\'e9s\'e9t keress\'e9k, \'e1m nem tartott\'e1k be azt \'fagy, ahogyan kellett volna. 
\'c9s azoknak, akik hittek k\'f6z\'fcl\'fck, megadtuk a jutalmukat, \'e1m sokan k\'f6z\'fcl\'fck engedetlenek.
\par 
\par 28. \'d3 ti, akik hisztek, f\'e9lj\'e9tek Allahot, \'e9s higgyetek a K\'fcld\'f6tt\'e9ben (Mohamedben)! [Allah akkor] k\'e9tszeres r\'e9szt fog adni nektek az \'d5 k\'f6ny\'f6r\'fclet\'e9b\'f5l, \'e9s vil\'e1goss\'e1got ad sz\'e1motokra, amely \'e1
ltal [az igazs\'e1g \'fatj\'e1n] j\'e1rhattok, \'e9s megbocs\'e1t nektek. \'c9s Allah Megbocs\'e1t\'f3, Irgalmas,
\par }\pard \qj \li0\ri-1\widctlpar\tx374\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin-1\lin0\itap0\pararsid10757626 {\cf1\insrsid10757626\charrsid11350926 29. Hogy megtudhassa az \'cdr\'e1s n\'e9pe, hogy nekik nincs hatalmuk semmi felett Allah kegy\'e9b
\'f5l [ha nem hisznek Mohamed pr\'f3f\'e9t\'e1ban], \'e9s azt, hogy [minden] kegy Allah kez\'e9ben van, \'d5 [pedig] annak ad [bel\'f5le], akinek akar, mert Allah a hatalmas kegy birtokosa.}{\cf1\insrsid10757626 
\par }\pard\plain \s1\qj \fi-432\li432\ri0\sl240\slmult0\keepn\nowidctlpar\jclisttab\tx0\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin432\itap0\pararsid11695939 \b\f1\fs32\lang1038\langfe1025\kerning32\cgrid\langnp1038\langfenp1025 {
\cf1\insrsid10757626 \page }{\fs24\lang1038\langfe1081\kerning1\loch\af0\hich\af0\dbch\af13\langfenp1081\insrsid10757626\charrsid11695939 \hich\af0\dbch\af13\loch\f0 \hich\f0 58. A vit\'e1\loch\f0 \hich\f0 z\'f3\loch\f0 \hich\f0  n\'f5\loch\f0  (al-
\hich\af0\dbch\af13\loch\f0 \hich\f0 Mudzs\'e1\loch\f0 \hich\f0 dala) c. sz\'fa\loch\f0 ra}{\b0\insrsid10757626\charrsid9704094 
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\insrsid10757626\charrsid9704094 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid9704094 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid9704094 
\par 1. Bizony, Allah hallotta annak a besz\'e9d\'e9t, aki vit\'e1ba sz\'e1ll veled [\'f3 Mohamed] a f\'e9rj\'e9t illet\'f5en, \'e9s panaszkodik Allahnak. \'c9s Allah hallja a kett\'f5t\'f6k besz\'e9lget\'e9s\'e9t. Bizony, Allah mindent Hall\'f3, mindent L\'e1
t\'f3.
\par 2. Akik k\'f6z\'fcletek feles\'e9geiket tilalmass\'e1 teszik maguknak [mondv\'e1n: olyan vagy sz\'e1momra, mint \'e9desany\'e1m h\'e1ta, azok b\'fbnt k\'f6vetnek el], h\'e1t \'f5k (a feles\'e9gek) nem az \'e9desany\'e1ik. Az \'e9desany\'e1
ik csakis azok, akik megsz\'fclt\'e9k \'f5ket. \'c9s bizony, \'f5k elvetend\'f5 besz\'e9det \'e9s hazugs\'e1got mondanak. \'c9s bizony Allah Eln\'e9z\'f5, Megbocs\'e1t\'f3.
\par 3. \'c9s azok, akik feles\'e9geiket tilalmass\'e1 teszik maguknak [mondv\'e1n: olyan vagy sz\'e1momra, mint \'e9desany\'e1m h\'e1ta], majd vissza akarnak t\'e9rni (el akarnak \'e1llni) att\'f3l, amit mondtak, akkor [ennek a j\'f3v\'e1t\'e9tele] felszabad
\'edtani egy rabszolg\'e1t, miel\'f5tt meg\'e9rintik egym\'e1st (h\'e1lnak egym\'e1ssal). Ebben int\'e9s rejlik sz\'e1motokra. \'c9s Allah j\'f3l ismeri azt, amit tesztek.
\par 4. \'c9s aki nem tal\'e1l [r\'e1 m\'f3dot], az b\'f6jt\'f6lj\'f6n k\'e9t egym\'e1st k\'f6vet\'f5 h\'f3napot, miel\'f5tt meg\'e9rintik egym\'e1st (h\'e1lnak egym\'e1ssal)! \'c9s aki nem k\'e9pes [a b\'f6jt\'f6l\'e9sre], az t\'e1pl\'e1ljon hatvan szeg\'e9
nyt! Ez [a t\'f6rv\'e9nykez\'e9s] az\'e9rt van, hogy [er\'f5sebben] higgyetek Allahban \'e9s a K\'fcld\'f6tt\'e9ben. \'c9s ezek az Allah [\'e1ltal kijel\'f6lt] hat\'e1rok. \'c9s a hitetleneknek f\'e1jdalmas gy\'f6trelem j\'e1r.
\par 
\par 5. Bizony azok, akik szembesz\'e1llnak Allahhal \'e9s a k\'fcld\'f6tt\'e9vel, megal\'e1zottak lesznek, \'fagy ahogyan azok is megal\'e1zottak lettek, akik el\'f5tt\'fck voltak. \'c9s bizony vil\'e1gos jeleket bocs\'e1tottunk le, \'e9
s a hitetleneknek megsz\'e9gyen\'edt\'f5 gy\'f6trelemben lesz r\'e9sz\'fck.
\par 6. Azon a Napon, amikor Allah felt\'e1masztja \'f5ket, mindannyiukat \'e9s h\'edr\'fcl adja nekik azt, amit tettek. Allah sz\'e1mon tartotta azt, \'e1m \'f5k elfelejtett\'e9k. \'c9s Allah Tan\'fa minden dolog felett.
\par 
\par 7. Vajon nem gondolkodt\'e1l el azon, hogy Allah tudja mindazt, ami az egekben \'e9s mindazt, ami a f\'f6ld\'f6n van? Nincs bizalmas besz\'e9lget\'e9s h\'e1rmasban an\'e9lk\'fcl, hogy ne \'d5 (Allah) lenne a negyedik\'fck, sem \'f6t\'f6sben an\'e9lk\'fc
l, hogy ne \'d5 lenne a hatodikuk, se enn\'e9l kevesebb, se enn\'e9l t\'f6bb, an\'e9lk\'fcl, hogy \'d5 ne lenne vel\'fck, b\'e1rhol is legyenek. Majd a Felt\'e1mad\'e1s napj\'e1n h\'edr\'fcl adja nekik azt, amit cselekedtek. Bizony, Allahnak minden dologr
\'f3l tudom\'e1sa van.
\par 8. Vajon nem jutott tudom\'e1sodra azoknak [a h\'edre], akiknek meg lett tiltva a bizalmas besz\'e9lget\'e9s \'e9s k\'e9s\'f5bb visszat\'e9rnek ahhoz, ami meg lett tiltva nekik, \'e9s egym\'e1s k\'f6z\'f6tt bizalmasan besz\'e9lgetnek a b\'fbnr\'f5l \'e9
s az ellens\'e9gesked\'e9sr\'f5l \'e9s az engedetlens\'e9gr\'f5l a K\'fcld\'f6ttel (Mohameddel) szemben? \'c9s ha hozz\'e1d j\'f6nnek [\'f3 Mohamed], olyasmivel k\'f6sz\'f6nnek neked, amivel Allah nem k\'f6sz\'f6nt neked, \'e9s azt mondj\'e1k magukban: 
\'84Mi\'e9rt nem b\'fcntet meg minket Allah az\'e9rt, amit mondunk?\'94 Elegend\'f5 a Gyehenna sz\'e1mukra! Ott fognak \'e9gni, \'e9s milyen nyomor\'fas\'e1gos v\'e9gzet az!
\par 9. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Amikor bizalmas besz\'e9lget\'e9st folytattok, ne besz\'e9lgessetek bizalmasan a b\'fbnr\'f5l \'e9s az ellens\'e9gesked\'e9sr\'f5l, \'e9
s az engedetlens\'e9gr\'f5l a K\'fcld\'f6ttel szemben, hanem besz\'e9lgessetek bizalmasan a j\'f3s\'e1gr\'f3l \'e9s az istenf\'e9lelemr\'f5l, \'e9s f\'e9lj\'e9tek Allahot, akihez \'f6ssze lesztek gy\'fbjtve!
\par 10. A [rosszindulat\'fa] bizalmas besz\'e9lget\'e9s csup\'e1n a s\'e1t\'e1nt\'f3l van, hogy elszomor\'edtsa a h\'edv\'f5ket, \'e9s semmiben sem fog \'e1rtani nekik, csak Allah engedelm\'e9vel. \'c9s Allahra hagyatkozzanak a h\'edv\'f5k!
\par 
\par 11. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Amikor azt mondj\'e1k nektek a gy\'fbl\'e9seken: \'84Adjatok helyet!\'94, akkor adjatok helyet, Allah is helyet ad nektek! \'c9
s amikor azt mondj\'e1k nektek: \'84Keljetek fel! (\'c1lljatok fel!)\'94, akkor keljetek fel! Allah fel fogja emelni fokozatokkal azokat k\'f6z\'fcletek, akik hisznek, \'e9s azokat, akiknek tud\'e1s adatott. \'c9s Allah j\'f3
l ismeri mindazt, amit cselekszetek.
\par 
\par 12. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ha bizalmasan akartok besz\'e9lgetni a K\'fcld\'f6ttel, akkor adjatok adom\'e1nyt bizalmas besz\'e9lget\'e9setek el\'f5tt! Ez jobb nektek 
\'e9s tiszt\'e1bb. De ha nem tal\'e1ltok [olyasvalamit, amit adom\'e1nyk\'e9nt felaj\'e1nlhatn\'e1tok], h\'e1t Allah bizony Megbocs\'e1t\'f3, Irgalmas.
\par 13. Tal\'e1n tartatok att\'f3l, hogy adom\'e1nyokat kell adnotok [a K\'fcld\'f6ttel folytatott] bizalmas besz\'e9lget\'e9setek el\'f5tt? S ha nem teszitek meg, \'e9s Allah [m\'e9gis] megbocs\'e1t nektek, akkor [legal\'e1bb] tarts\'e1tok meg az im\'e1dkoz
\'e1st, \'e9s adj\'e1tok meg a k\'f6telez\'f5 adom\'e1nyt, \'e9s engedelmeskedjetek Allahnak \'e9s a K\'fcld\'f6tt\'e9nek! \'c9s Allah j\'f3l ismeri azt, amit cselekszetek.
\par 
\par 14. Vajon nem jutott tudom\'e1sodra azoknak [a k\'e9pmutat\'f3knak a h\'edre], akik p\'e1rtfog\'f3ikk\'e1 fogadtak egy n\'e9pet, akikre Allah megharagudott? \'d5k nem tartoznak k\'f6z\'e9tek, sem k\'f6z\'e9j\'fck, \'e9s hazug m\'f3don esk\'fcdnek, mik\'f6
zben tudj\'e1k.
\par 15. Allah szigor\'fa b\'fcntet\'e9st k\'e9sz\'edtett nekik. Bizony, gonosz az, amit \'f5k tettek.
\par 16. [Hazug] esk\'fciket v\'e9d\'f5pajzzs\'e1 tett\'e9k maguknak, \'e9s t\'e1vol tartottak [m\'e1sokat] Allah \'datj\'e1t\'f3l, ez\'e9rt megal\'e1z\'f3 b\'fcntet\'e9s j\'e1r nekik.
\par 17. Semmit sem haszn\'e1l majd a vagyonuk, sem a gyermekeik Allahhal szemben. Azok a Pokol-t\'fbz lak\'f3i, \'f5k \'f6r\'f6kk\'e9 abban fognak maradni.
\par 18. Azon a Napon, amikor Allah felt\'e1masztja \'f5ket, mindannyiukat, \'e9s esk\'fcd\'f6zni fognak Neki, ahogyan nektek esk\'fcd\'f6znek. \'c9s azt gondolj\'e1k, hogy rendelkeznek valamivel [ami hasznukra lehetne]. L\'e1m, bizony \'f5k a hazugok.
\par 19. A s\'e1t\'e1n hatalm\'e1ba ker\'edtette \'f5ket, s elfeledtette vel\'fck az Allahr\'f3l val\'f3 megeml\'e9kez\'e9st. Azok a s\'e1t\'e1n sz\'f6vets\'e9gesei. L\'e1m, bizony a s\'e1t\'e1n sz\'f6vets\'e9gesei a vesztesek!
\par 20. Bizony, akik szembesz\'e1llnak Allahhal \'e9s az \'d5 K\'fcld\'f6tt\'e9vel, azok a legmegal\'e1zottabbak k\'f6z\'f6tt lesznek.
\par 21. Allah meg\'edrta (elrendelte az \'d5rz\'f6tt T\'e1bl\'e1n): \'84Bizony, gy\'f5zelmet aratok \'c9n \'e9s a K\'fcld\'f6tteim!\'94 Bizony, Allah Er\'f5s, M\'e9lt\'f3s\'e1gteljes.
\par 
\par 22. Nem tal\'e1lsz olyan n\'e9pet, akik hisznek Allahban \'e9s az Utols\'f3 Napban, [ugyanakkor] szeretik azokat, akik szembesz\'e1llnak Allahhal \'e9s a K\'fcld\'f6tt\'e9vel, m\'e9g akkor sem, ha azok az ap\'e1ik, vagy a fiaik, vagy a testv\'e9
reik vagy a nemzets\'e9g\'fck [tagjai] lenn\'e9nek. Azoknak a sz\'edv\'e9be \'edrta [Allah] a hitet \'e9s t\'e1mogatta \'f5ket egy T\'f5le val\'f3 l\'e9lekkel, \'e9s bel\'e9pteti \'f5ket Kertekbe [a Paradicsomban], amelyek al\'f3l foly\'f3k folynak. \'d6r
\'f6kk\'e9 abban fognak maradni. Allah el\'e9gedett [lesz] vel\'fck, \'e9s \'f5k is el\'e9gedettek [lesznek] Vele (a T\'f5le kapott jutalommal). Bizony, Allah sz\'f6vets\'e9gesei azok, akik boldogulnak.}{\insrsid10757626 
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\lang1038\langfe1081\kerning1\dbch\af13\langfenp1081\insrsid10757626\charrsid11695939 
\hich\af0\dbch\af13\loch\f0 \hich\f0 59. Az egybegy\'fb\loch\f0 \hich\f0 jt\'e9\loch\f0 s (al-Hasr) c. \hich\af0\dbch\af13\loch\f0 \hich\f0 sz\'fa\loch\f0 ra}{\b\insrsid10757626\charrsid11148973 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid11148973 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid11148973 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid11148973 
\par 1. Allahot magasztalta [\'e9s magasztalja] mindaz, ami az egekben \'e9s ami a f\'f6ld\'f6n van. \'c9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 2. \'d5 az, Aki ki\'fbzte azokat, akik hitetlenn\'e9 v\'e1ltak az \'cdr\'e1s n\'e9pe k\'f6z\'fcl, az otthonaikb\'f3l az els\'f5 egybegy\'fbjt\'e9skor. Ti nem v\'e9lt\'e9tek azt, hogy \'f5k el fognak menni, \'e9s \'f5k \'fagy v\'e9lt\'e9k, hogy er\'f5d\'ed
tm\'e9nyeik meg fogj\'e1k v\'e9deni \'f5ket Allaht\'f3l. De Allah [b\'fcntet\'e9se] onnan j\'f6tt el hozz\'e1juk, ahonnan nem sz\'e1m\'edtottak r\'e1, \'e9s [\'d5] r\'e9m\'fcletet vetett a sz\'edv\'fckbe [\'fagy, hogy] lerombolj\'e1k h\'e1zaikat a saj\'e1
t kez\'fckkel \'e9s a h\'edv\'f5k kez\'e9vel. Fogadj\'e1tok h\'e1t tanuls\'e1gul, ti \'e9les megl\'e1t\'e1ssal b\'edr\'f3k!
\par 3. \'c9s ha Allah nem \'edrta volna el\'f5 nekik a sz\'e1m\'fbzet\'e9st, akkor megb\'fcntette volna \'f5ket az evil\'e1gon, de a t\'falvil\'e1gon a [Pokol-]t\'fbz gy\'f6trelme j\'e1r nekik.
\par 4. Az\'e9rt van ez, mert szembeszeg\'fcltek Allahhal \'e9s a K\'fcld\'f6tt\'e9vel. \'c9s aki szembeszeg\'fcl Allahhal, h\'e1t bizony, Allah szigor\'fa a b\'fcntet\'e9sben.
\par 5 Ami p\'e1lmaf\'e1t kiv\'e1gtatok vagy \'e1llni hagytatok az alapjain, az Allah enged\'e9ly\'e9vel t\'f6rt\'e9nt, \'e9s hogy megsz\'e9gyen\'edtse az engedetleneket.
\par 
\par 6. \'c9s amit Allah juttatott t\'f5l\'fck zs\'e1km\'e1nyul a K\'fcld\'f6tt\'e9nek [harc n\'e9lk\'fcl], ti az\'e9rt nem hajtottatok ki se lovat, se tev\'e9t, de Allah hatalmat ad a K\'fcld\'f6tteinek azok felett, akiket \'d5 akar. \'c9
s Allah minden dologra kiterjed\'f5 hatalm\'fa.
\par 7. Amit Allah a v\'e1rosok lak\'f3it\'f3l juttatott zs\'e1km\'e1nyul a K\'fcld\'f6tt\'e9nek [harc n\'e9lk\'fcl], az Allah\'e9, a K\'fcld\'f6tt\'e9, a rokonok\'e9, az \'e1rv\'e1k\'e9, a szeg\'e9nyek\'e9, \'e9s az utaz\'f3k\'e9, az\'e9rt hogy ne v\'e1
ljon a gazdagjaitok k\'f6z\'f6tt forg\'f3 vagyonn\'e1. \'c9s amit a K\'fcld\'f6tt ad nektek, azt vegy\'e9tek el, \'e9s amit\'f5l eltilt titeket, att\'f3l tart\'f3zkodjatok, \'e9s f\'e9lj\'e9tek Allahot! Bizony, Allah szigor\'fa a b\'fcntet\'e9sben.
\par 
\par 8. [Az ilyen zs\'e1km\'e1nyb\'f3l j\'e1r] a szeg\'e9ny kiv\'e1ndorl\'f3knak, akik ki\'fbzettek [mekkai] otthonaikb\'f3l \'e9s vagyonukb\'f3l, [mert] Allah kegy\'e9t \'e9s el\'e9gedetts\'e9g\'e9t keresik \'e9s Allahot \'e9s a K\'fcld\'f6tt\'e9t t\'e1mogatj
\'e1k. \'d5k bizony az igazmond\'f3k.
\par 9. \'c9s azok, akik \'f5el\'f5tt\'fck letelepedtek az otthonban [Medin\'e1ban] \'e9s [\'f5szint\'e9n elfogadt\'e1k] a hitet, szeretik azokat, akik kiv\'e1ndoroltak hozz\'e1juk, \'e9s nem \'e9reznek a kebl\'fckben bossz\'fas\'e1
got amiatt ami azoknak adatott. El\'f5nyben r\'e9szes\'edtik \'f5ket magukkal szemben, m\'e9g akkor is, ha sz\'fcks\'e9get szenvednek. \'c9s akik megv\'e9detnek saj\'e1t f\'f6sv\'e9nys\'e9g\'fckt\'f5l, nos, \'f5k bizony azok, akik boldogulnak.
\par 10. \'c9s akik \'f5ut\'e1nuk j\'f6ttek, azt mondj\'e1k: \'84Urunk! Bocs\'e1ss meg nek\'fcnk \'e9s testv\'e9reinknek, akik megel\'f5ztek minket a hitben \'e9s ne helyezz gy\'fbl\'f6letet a sz\'edv\'fcnkbe azok ellen, akik hisznek! Urunk! Bizony, Te Egy\'fc
tt\'e9rz\'f5, Irgalmas vagy!\'94
\par 
\par 11. Vajon nem jutott tudom\'e1sodra [\'f3 Mohamed] azoknak a k\'e9pmutat\'f3knak [a h\'edre], akik azt mondj\'e1k testv\'e9reiknek, azoknak, akik hitetlenn\'e9 v\'e1ltak az \'cdr\'e1s n\'e9pe k\'f6z\'fcl (a Ban\'fa an-Nad\'edr zsid\'f3 t\'f6rzsnek): \'84
Ha titeket ki\'fbznek, bizony mi is kimegy\'fcnk veletek egy\'fctt \'e9s soha sem fogunk engedelmeskedni senkinek ellenetek, \'e9s ha harcolnak ellenetek, mi seg\'edteni fogunk nektek.\'94 \'c1m Allah tan\'fas\'edtja azt, hogy \'f5k bizony hazugok.
\par 12. Ha \'f5k val\'f3ban ki\'fbzetn\'e9nek, [a k\'e9pmutat\'f3k] nem menn\'e9nek ki vel\'fck. \'c9s ha harcoln\'e1nak ellen\'fck, nem seg\'edten\'e9k \'f5ket. \'c9s ha m\'e9gis seg\'edten\'e9k \'f5ket, [akkor] bizonyosan h\'e1tat ford\'edtan\'e1nak, azt
\'e1n nem lesznek megseg\'edtve.
\par 13. Bizony, nagyobb retteg\'e9st \'e9reznek a kebl\'fckben t\'f5letek, mint Allaht\'f3l. Ez az\'e9rt van, mert \'f5k egy olyan n\'e9p, akik nem \'e9rtenek.
\par 14. Nem harcolnak ellenetek mindannyian egy\'fctt, kiv\'e9ve meger\'f5s\'edtett v\'e1rosokban vagy falak m\'f6g\'fcl. Az ellens\'e9gesked\'e9s k\'f6z\'f6tt\'fck nagy. Azt gondolod, hogy egy\'fctt vannak, de [val\'f3j\'e1ban] a sz\'ed
veik megosztottak. Ez az\'e9rt van, mert \'f5k olyan emberek, akik nem \'e9lnek az esz\'fckkel.
\par 15. Hasonlatosak [\'f5k] azokhoz, akik r\'f6viddel el\'f5tt\'fck voltak: meg\'edzlelt\'e9k tett\'fck s\'falyos k\'f6vetkezm\'e9ny\'e9t, \'e9s [a T\'falvil\'e1gon] f\'e1jdalmas gy\'f6trelemben lesz r\'e9sz\'fck.
\par 16. Hasonlatosak \'f5k (a k\'e9pmutat\'f3k) a s\'e1t\'e1nhoz, amikor azt mondta az embernek: \'84L\'e9gy hitetlen!\'94 De amikor (az ember) hitetlenn\'e9 v\'e1lt, akkor a s\'e1t\'e1n azt mondta: \'84Bizony, \'e9n elhat\'e1rolom magam t\'f5led. Bizony, 
\'e9n f\'e9lem Allahot, a teremtm\'e9nyek Ur\'e1t.\'94
\par 17. Mindkettej\'fck v\'e9ge azonban az, hogy a [Pokol-]t\'fbzben lesznek, \'f6r\'f6kk\'e9 abban fognak maradni. \'c9s ez a fizets\'e9ge az igazs\'e1gtalanoknak.
\par 
\par 18. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! F\'e9lj\'e9tek Allahot, \'e9s n\'e9zze meg minden emberi l\'e9lek, hogy mit k\'fcld\'f6tt el\'f5re holnapra (a Felt\'e1mad\'e1s napj\'e1
ra)! \'c9s f\'e9lj\'e9tek Allahot! Bizony, Allah j\'f3l ismeri azt, amit cselekszetek.
\par 19. \'c9s ne legyetek olyanok, mint [azok], akik elfelejtett\'e9k Allahot, ez\'e9rt \'d5 elfeledtette vel\'fck \'f6nmagukat! \'d5k bizony az engedetlenek.
\par 20. Nem egyenl\'f5k a [Pokol-t\'fbz] lak\'f3i \'e9s a Paradicsom lak\'f3i. A Paradicsom lak\'f3i [lesznek] a diadalmasak.
\par 
\par 21. Ha ezt a Kor\'e1nt egy hegyre bocs\'e1tan\'e1nk le, akkor l\'e1tn\'e1d \'f5t meghajolva \'e9s sz\'e9thasadva az Allaht\'f3l val\'f3 f\'e9lelm\'e9ben. \'c9s ezek [azok] a p\'e9ld\'e1zatok, amelyeket adunk az embereknek, h\'e1tha elgondolkodnak.
\par 22. \'d5 Allah, akin k\'edv\'fcl nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, a rejtett \'e9s a l\'e1that\'f3 dolgok Tud\'f3ja, \'d5 a K\'f6ny\'f6r\'fcletes, az Irgalmas.
\par 23. \'d5 Allah, akin k\'edv\'fcl nincs m\'e1s [jogosan im\'e1dhat\'f3] isten, a Kir\'e1ly, a Szents\'e9ges, a B\'e9kess\'e9g, a Biztons\'e1got ad\'f3, a [teremtm\'e9nyei felett] \'d5rk\'f6d\'f5, a M\'e9lt\'f3s\'e1gteljes, a K\'e9nyszer\'edt\'f5, a B\'fc
szke. Magasztaltass\'e9k Allah! [\'d5 afelett van], amit t\'e1rsistenk\'e9nt \'e1ll\'edtanak [mell\'e9].
\par 24. \'d5 Allah, a Teremt\'f5, az Alkot\'f3, a form\'e1t Ad\'f3, \'d5t illetik meg a legszebb nevek. \'d5t magasztalja mindaz, ami az egekben \'e9s a f\'f6ld\'f6n van. \'c9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.}{\insrsid10757626 
\par 
\par \page }{\b\insrsid10757626\charrsid11040789 60. sz\'fara \endash  A }{\b\insrsid10757626\charrsid10358430 pr\'f3b\'e1nak al\'e1vetett n\'f5 (al-Mumtahana) c. sz\'fara
\par }{\insrsid10757626\charrsid10358430 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10358430 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10358430 
\par 1. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne tegy\'e9tek meg az ellens\'e9geimet \'e9s az ellens\'e9geiteket [magatoknak] p\'e1rtfog\'f3kk\'e1, szeretetet nyilv\'e1n\'edtva ir\'e1
ntuk, mik\'f6zben \'f5k [m\'e1r] hitetlenek [lettek] azzal szemben, ami hozz\'e1tok j\'f6tt az igazs\'e1gb\'f3l, ki\'fbzik a K\'fcld\'f6ttet (Mohamedet) \'e9s titeket [otthonaitokb\'f3l], mert hisztek Allahban, az Uratokban! Ha [val\'f3ban] az \'c9
n Utamon k\'fczdve \'e9s az \'c9n el\'e9gedetts\'e9gemet keresve vonultok ki, [akkor ne tegy\'e9tek meg \'f5ket p\'e1rtfog\'f3kk\'e1]! Titokban fordultok fel\'e9j\'fck szeretettel, mik\'f6zben \'c9n tudom azt, amit eltitkoltok, \'e9s amit kinyilv\'e1n\'ed
totok! \'c9s aki k\'f6z\'fcletek ezt teszi, h\'e1t az m\'e1r [bizony] elt\'e9velyedett az Egyenes \'datt\'f3l.
\par 2. Ha r\'e1tok leln\'e9nek, akkor ellens\'e9gesek lenn\'e9nek veletek, \'e9s a kez\'fcket \'e9s a nyelv\'fcket gonoszul ellenetek ford\'edtan\'e1k, \'e9s [mindenek el\'f5tt] azt szeretn\'e9k, ha hitetlenekk\'e9 v\'e1ln\'e1tok.
\par 3. Sem a rokonaitok, sem a gyermekeitek nem fognak haszn\'e1lni nektek. A Felt\'e1mad\'e1s Napj\'e1n [Allah] sz\'e9tv\'e1laszt titeket. \'c9s Allah l\'e1tja azt, amit cselekedtek.
\par 
\par 4. Val\'f3ban, kiv\'e1l\'f3 p\'e9ldak\'e9p van sz\'e1motokra \'c1brah\'e1mban \'e9s azokban [a h\'edv\'f5kben], akik vele voltak, amikor azt mondt\'e1k a n\'e9p\'fcknek: \'84Bizony, mi elhat\'e1roljuk magunkat t\'f5letek, \'e9s att\'f3
l, amit Allah helyett im\'e1dtok. Hitetlenn\'e9 v\'e1ltunk veletek szemben (megtagadunk titeket) \'e9s k\'f6zt\'fcnk \'e9s k\'f6ztetek ellens\'e9gesked\'e9s \'e9s gy\'fbl\'f6let t\'e1mad \'f6r\'f6kre, am\'edg nem hisztek Allahban egyed\'fcl.\'94 \endash 
 kiv\'e9ve \'c1brah\'e1m mond\'e1s\'e1t [hitetlen] apj\'e1nak: \'84Bizony, megbocs\'e1t\'e1st fogok k\'e9rni sz\'e1modra [Allaht\'f3l], de nincs hatalmam b\'e1rmit [tenni] \'e9rted Allahhal szemben! Urunk! R\'e1d hagyatkozunk \'e9s Hozz\'e1d t\'e9r\'fc
nk vissza megb\'e1n\'e1ssal, \'e9s Hozz\'e1d lesz a v\'e9gc\'e9l.
\par 5. Urunk! Ne t\'e9gy minket k\'eds\'e9rt\'e9ss\'e9 azok sz\'e1m\'e1ra, akik hitetlenn\'e9 v\'e1ltak, \'e9s bocs\'e1ss meg nek\'fcnk, Urunk! Bizony, Te vagy a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.\'94
\par 6. Bizony, kiv\'e1l\'f3 p\'e9ldak\'e9p van benn\'fck sz\'e1motokra, azoknak, akik rem\'e9lik az Allahhal [val\'f3 tal\'e1lkoz\'e1st] \'e9s az Utols\'f3 nap [jutalm\'e1t]. \'c9s aki h\'e1tat ford\'edt, [a maga k\'e1r\'e1
ra teszi,] bizony Allah az, aki a Gazdag, a Dics\'e9retrem\'e9lt\'f3.
\par 7. Allah tal\'e1n szeretetet t\'e1maszt k\'f6ztetek \'e9s azok k\'f6z\'f6tt, akikkel ellens\'e9geskedtetek. \'c9s Allah Mindenhat\'f3. \'c9s Allah Megbocs\'e1t\'f3, Irgalmas.
\par 
\par 8. Nem tiltja meg Allah nektek, hogy j\'f3s\'e1gosan \'e9s igazs\'e1gosan b\'e1njatok azokkal, akik nem harcoltak ellenetek a vall\'e1s miatt \'e9s nem \'fcld\'f6ztek ki titeket az otthonaitokb\'f3l. Bizony, Allah szereti az igazs\'e1gosakat.
\par 9. Csup\'e1n azt tiltja meg Allah nektek, hogy p\'e1rtfog\'f3itokk\'e1 tegy\'e9tek azokat, akik harcoltak ellenetek a vall\'e1s miatt \'e9s ki\'fbztek titeket az otthonaitokb\'f3l, \'e9s seg\'edtettek a ki\'fbz\'e9setekben. \'c9s akik p\'e1rtfog\'f3v\'e1
 teszik \'f5ket, azok bizony az igazs\'e1gtalanok.
\par 
\par 10. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Amikor h\'edv\'f5 n\'f5k j\'f6nnek hozz\'e1tok kiv\'e1ndorl\'f3kk\'e9nt, vess\'e9tek al\'e1 \'f5ket pr\'f3b\'e1nak. \'c9
s Allah jobban ismeri a hit\'fcket. \'c9s ha megbizonyosodtatok r\'f3la, hogy [igaz] h\'edv\'f5 n\'f5k, akkor ne adj\'e1tok \'f5ket vissza a hitetleneknek (a f\'e9rj\'fcknek)! Nem megengedettek \'f5k azoknak (a hitetlen f\'e9rjeknek), \'e9
s azok sem megengedettek nekik. \'c9s adj\'e1tok oda nekik (a hitetlen f\'e9rjeknek) azt, amit [n\'e1szaj\'e1nd\'e9kk\'e9nt] k\'f6lt\'f6ttek! \'c9s nem terhel titeket v\'e9ts\'e9g, ha elveszitek \'f5ket feles\'e9g\'fcl, amennyiben odaadj\'e1tok nekik a j
\'e1rand\'f3s\'e1gukat (a n\'e1szaj\'e1nd\'e9kot). \'c9s ne tarts\'e1tok fenn a hitetlen n\'f5kh\'f6z f\'fbz\'f5d\'f5 [h\'e1zass\'e1gi] k\'f6tel\'e9ket, \'e9s k\'e9rj\'e9tek el azt, amit k\'f6lt\'f6ttetek [n\'e1szaj\'e1nd\'e9kk\'e9nt], \'e9s \'f5
k (a hitetlen f\'e9rjek) k\'e9rj\'e9k el azt, amit k\'f6lt\'f6ttek [n\'e1szaj\'e1nd\'e9kk\'e9nt]. Ez Allah \'edt\'e9lete! [\'d5] \'edt\'e9l k\'f6z\'f6ttetek. \'c9s Allah Mindentud\'f3, B\'f6lcs.
\par 11. \'c9s ha valaki a [hitetlen] feles\'e9geitek k\'f6z\'fcl megsz\'f6kik t\'f5letek a hitetlenekhez [akik megtagadt\'e1k a n\'e1szaj\'e1nd\'e9k visszafizet\'e9s\'e9t], \'e9s ti gy\'f5zelmet arattatok [felett\'fck], akkor adjatok [a hadizs\'e1km\'e1nyb
\'f3l] azoknak, akiknek elmentek a feles\'e9geik, ugyanannyit, amennyit k\'f6lt\'f6ttek [n\'e1szaj\'e1nd\'e9kk\'e9nt], \'e9s f\'e9lj\'e9tek Allahot, akiben hisztek!
\par 
\par 12. \'d3 Pr\'f3f\'e9ta! Amikor h\'edv\'f5 n\'f5k j\'f6nnek hozz\'e1d, hogy h\'fbs\'e9gesk\'fct tegyenek arra, hogy nem \'e1ll\'edtanak semmilyen t\'e1rsistent Allah mell\'e9, \'e9s nem lopnak, \'e9s nem par\'e1zn\'e1lkodnak, \'e9s nem \'f6
lik meg a gyerekeiket, \'e9s nem tulajdon\'edtanak a f\'e9rj\'fcknek olyan gyerekeket, akik nem az \'f6v\'e9k, \'e9s nem lesznek engedetlenek veled szemben abban, ami hely\'e9nval\'f3, h\'e1t fogadd el a h\'fbs\'e9gesk\'fcj\'fcket, \'e9s k\'e9rj megbocs
\'e1t\'e1st a sz\'e1mukra Allaht\'f3l! Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 13. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne tegyetek p\'e1rtfog\'f3v\'e1 olyan n\'e9pet, akikre Allah megharagudott! Elvesztett\'e9k imm\'e1r a rem\'e9nyt a T\'falvil\'e1gban, \'fa
gy, ahogyan a hitetlenek is elvesztett\'e9k a rem\'e9nyt a s\'edrok lak\'f3i fel\'f5l [hogy valaha is tal\'e1lkoznak vel\'fck].}{\insrsid10757626 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\lang1038\langfe1081\kerning1\dbch\af13\langfenp1081\insrsid10757626\charrsid11695939 
\hich\af0\dbch\af13\loch\f0 \hich\f0 61. A sorok (asz-Szaff) c. sz\'fa\loch\f0 ra}{\b\insrsid10757626\charrsid11040789 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10358430 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10358430 
\par 1. Allahot magasztalta [\'e9s magasztalja] mindaz, ami az egekben, \'e9s ami a f\'f6ld\'f6n van. \'c9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 2. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Mi\'e9rt mondtok olyat, amit nem tesztek meg?
\par 3. Mennyire gy\'fbl\'f6letes Allah el\'f5tt az, hogy olyat mondtok, amit nem tesztek meg!
\par 4. Bizony, Allah szereti azokat, akik harcolnak az \'d5 \'datj\'e1n sorokban, mintha szil\'e1rdan rakott \'e9p\'edtm\'e9ny lenn\'e9nek.
\par 
\par 5. \'c9s [eml\'edtsd meg], amikor M\'f3zes azt mondta a n\'e9p\'e9nek: \'84\'d3 n\'e9pem! Mi\'e9rt b\'e1ntotok engem, holott bizony tudj\'e1tok, hogy Allah K\'fcld\'f6tte vagyok hozz\'e1tok?\'94 \'c9s amikor elt\'e9rtek [az igazs\'e1gt\'f3l] Allah elt\'e9
r\'edtette a sz\'edv\'fcket [az \'fatmutat\'e1s elfogad\'e1s\'e1t\'f3l]. \'c9s Allah nem vezeti [igaz \'fatra] az engedetlen n\'e9pet.
\par 
\par 6. \'c9s [eml\'edtsd meg], amikor J\'e9zus, M\'e1ria fia, azt mondta: \'84\'d3 Izrael fiai! \'c9n bizony Allah K\'fcld\'f6tte vagyok hozz\'e1tok, igazolva annak az igazs\'e1g\'e1t, ami el\'f5ttem volt a T\'f3r\'e1b\'f3l, \'e9s \'f6r\'f6mh\'ed
rt hozva egy K\'fcld\'f6ttr\'f5l, aki ut\'e1nam j\'f6n, [s akinek] a neve Ahmed.\'94 \'c9s amikor elj\'f6tt hozz\'e1juk a vil\'e1gos bizony\'edt\'e9kokkal, azt mondt\'e1k: \'84Ez nyilv\'e1nval\'f3 var\'e1zslat.\'94
\par 7. \'c9s ki lehet igazs\'e1gtalanabb ann\'e1l, mint aki a hazugs\'e1got tal\'e1lja ki Allah ellen, mik\'f6zben az iszl\'e1mra h\'edvj\'e1k? \'c9s Allah nem vezeti [igaz \'fatra] az igazs\'e1gtalan n\'e9pet.
\par 8. El akarj\'e1k oltani a sz\'e1jukkal Allah vil\'e1goss\'e1g\'e1t, \'e1m Allah kiteljes\'edti a vil\'e1goss\'e1g\'e1t, m\'e9g ha ez ut\'e1latos is a hitetleneknek.
\par 9. \'d5 az, aki elk\'fcldte a K\'fcld\'f6tt\'e9t az \'fatmutat\'e1ssal \'e9s az igaz vall\'e1ssal, hogy azt az \'f6sszes [t\'f6bbi] vall\'e1s f\'f6l\'e9 helyezze, m\'e9g ha ez ut\'e1latos is a t\'e1rsistent \'e1ll\'edt\'f3knak.
\par 
\par 10. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Vajon vezesselek titeket egy olyan keresked\'e9sre, amely f\'e1jdalmas gy\'f6trelemt\'f5l ment meg titeket?
\par 11. [Ha] hisztek Allahban \'e9s a K\'fcld\'f6tt\'e9ben \'e9s k\'fczd\'f6t\'f6k Allah \'datj\'e1n vagyonotokkal \'e9s magatokkal (\'e9leteteket kock\'e1ztatva), ez jobb nektek, ha val\'f3ban rendelkeztek tud\'e1ssal!
\par 12. [Ha \'edgy cselekedtek, akkor Allah] megbocs\'e1tja nektek a b\'fbneiteket \'e9s bebocs\'e1t titeket olyan Kertekbe [a Paradicsomban], amelyek al\'f3l foly\'f3k folynak, \'e9s j\'f3 lakhelyeket [ad nektek] \'f6r\'f6kk\'e9 tart\'f3
 kertekben. Ez a hatalmas diadal!
\par 13. \'c9s [megjutalmaz] titeket egy m\'e1sik [keggyel], amit szerettek: seg\'edts\'e9g Allaht\'f3l \'e9s k\'f6zeli gy\'f5zelem. \'c9s adj \'f6r\'f6mh\'edrt [\'f3 Mohamed] a h\'edv\'f5knek!
\par 14. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Legyetek seg\'edt\'f5i Allahnak, mik\'e9nt J\'e9zus, M\'e1ria fia mondta a kiv\'e1lasztott k\'f6vet\'f5inek (a tan\'edtv\'e1nyainak): \'84
Kik a seg\'edt\'f5im az Allahhoz [vezet\'f5 \'faton]?\'94 A kiv\'e1lasztott k\'f6vet\'f5k azt mondt\'e1k: \'84Mi vagyunk Allah seg\'edt\'f5i.\'94 Azut\'e1n egy csoport Izrael fiai k\'f6z\'fcl hitt \'e9s egy [m\'e1sik] csoport hitetlenn\'e9 v\'e1lt. S Mi t
\'e1mogattuk azokat, akik hittek, az ellens\'e9geikkel szemben, \'e9s \'f5k lettek a fel\'fclkereked\'f5k.}{\insrsid10757626 
\par \page }{\b\insrsid10757626\charrsid11040789 62. sz\'fara \endash  A P\'e9ntek (al-Dzsuma) c. }{\b\insrsid10757626\charrsid10358430 sz\'fara
\par }{\insrsid10757626\charrsid10358430 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10358430 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10358430 
\par 1. Allahot magasztalja mindaz, ami az egekben, \'e9s ami a f\'f6ld\'f6n van, [Allahot] a Kir\'e1lyt, a Szents\'e9geset, a M\'e9lt\'f3s\'e1gteljeset, a B\'f6lcset.
\par 2. \'d5 az, aki az \'edr\'e1studatlanok (az \'cdr\'e1st nem ismer\'f5k) k\'f6z\'f6tt egy k\'f6z\'fcl\'fck val\'f3 K\'fcld\'f6ttet (Mohamed Pr\'f3f\'e9t\'e1t) t\'e1masztott, aki recit\'e1lja a jeleit (szavait), megtiszt\'edtja \'f5ket \'e9s megtan\'ed
tja nekik az \'cdr\'e1st \'e9s a b\'f6lcsess\'e9get, b\'e1r az el\'f5tt nyilv\'e1nval\'f3 t\'e9velyg\'e9sben voltak.
\par 3. \'c9s [Mohamed Pr\'f3f\'e9ta el lett k\'fcldve] m\'e1sokhoz is k\'f6z\'fcl\'fck (a t\'e9velyg\'f5kh\'f6z), akik m\'e9g nem csatlakoztak hozz\'e1juk (a Pr\'f3f\'e9ta k\'f6vet\'f5ihez). \'c9s \'d5 a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.
\par 4. Ez Allah Kegye, amelyet annak ad, akinek akar. \'c9s Allah a Hatalmas Kegy birtokosa.
\par 
\par 5. Azok, akikre r\'e1 lett b\'edzva a T\'f3ra, azut\'e1n nem tartott\'e1k be, hasonlatosak a szam\'e1rhoz, amely k\'f6nyveket hord. Mily nyomor\'fas\'e1gos annak a n\'e9pnek a p\'e9ld\'e1zata, akik meghazudtolt\'e1k Allah jeleit! \'c9
s Allah nem vezeti [igaz \'fatra] az igazs\'e1gtalan n\'e9pet.
\par 6. Mondd [\'f3 Mohamed]: \'84\'d3 ti, akik zsid\'f3k vagytok! Ha azt \'e1ll\'edtj\'e1tok, hogy ti [vagytok] Allah p\'e1rtfogoltjai egyed\'fcl az emberis\'e9g k\'f6z\'fcl, akkor k\'edv\'e1nj\'e1tok a hal\'e1lt, ha val\'f3ban igazmond\'f3k vagytok!\'94

\par 7. \'c1m soha nem fogj\'e1k k\'edv\'e1nni azt amiatt, amit a kez\'fck [kor\'e1bban] elk\'f6vetett. \'c9s Allah mindent tud az igazs\'e1gtalanokr\'f3l.
\par 8. Mondd [\'f3 Mohamed]: \'84Bizony a hal\'e1l, amely el\'f5l menek\'fclt\'f6k, val\'f3ban tal\'e1lkozni fog veletek, majd visszavitettek a rejtett \'e9s a l\'e1that\'f3 [dolgok] Tud\'f3j\'e1hoz, \'e9s h\'edr\'fcl adja nektek azt, amit cselekedtetek.\'94

\par 
\par 9. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Amikor elhangzik a h\'edv\'e1s az im\'e1dkoz\'e1sra a p\'e9nteki napon, akkor igyekezzetek az Allahr\'f3l val\'f3 megeml\'e9kez\'e9sre \'e9
s hagyj\'e1tok abba az ad\'e1sv\'e9telt! Ez jobb nektek, ha val\'f3ban rendelkeztek tud\'e1ssal.
\par 10. \'c9s amikor v\'e9get \'e9r az im\'e1dkoz\'e1s, sz\'e9ledjetek sz\'e9t a f\'f6ld\'f6n \'e9s keress\'e9tek Allah kegy\'e9t, \'e9s eml\'e9kezzetek meg sokszor Allahr\'f3l, h\'e1tha boldogultok!
\par 11. \'c9s amikor megl\'e1tnak egy keresked\'e9st vagy sz\'f3rakoz\'e1st [k\'edn\'e1l\'f3 dolgot], sz\'e9tsz\'f3r\'f3dnak afel\'e9 [sietve], \'e9s ott hagynak t\'e9ged [a sz\'f3sz\'e9ken] \'e1llva. Mondd [\'f3 Mohamed]: \'84Ami Allahn\'e1
l van az jobb, mint a sz\'f3rakoz\'e1s \'e9s mint a keresked\'e9s. \'c9s Allah a legjobb [Ell\'e1t\'f3] az ell\'e1t\'f3k k\'f6z\'f6tt.\'94}{\insrsid10757626 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid11040789 63. A k\'e9pmutat\'f3k (al-Mun\'e1fik\'fan) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626 
\par 1. Amikor elj\'f6nnek hozz\'e1d a k\'e9pmutat\'f3k, azt mondj\'e1k: \'84Tan\'fas\'edtjuk, hogy bizony te Allah K\'fcld\'f6tte vagy.\'94 Allah tudja, hogy bizony te, biztosan az \'d5 K\'fcld\'f6tte vagy, \'e9s Allah tan\'fas\'edtja, hogy bizony, a k\'e9
pmutat\'f3k hazugok.
\par 2. [Hazug] esk\'fciket v\'e9d\'f5pajzzs\'e1 tett\'e9k maguknak, \'e9s t\'e1vol tartottak [m\'e1sokat] Allah \'datj\'e1t\'f3l. Bizony, milyen rossz az, amit \'f5k cselekedtek.
\par 3. Ez az\'e9rt van, mert hittek, azut\'e1n hitetlenek lettek, \'e9s [emiatt] lepecs\'e9teltetett a sz\'edv\'fck, \'e9s [ez\'e9rt] nem \'e9rtenek.
\par 4. \'c9s ha r\'e1juk n\'e9zel, tetszik neked a k\'fclsej\'fck, \'e9s ha sz\'f3lnak, hallgatod a szavaikat. Olyanok, mintha megt\'e1masztott fadarabok lenn\'e9nek. Azt gondolj\'e1k, hogy minden ki\'e1lt\'e1s ellen\'fck sz\'f3l. \'d5k az ellens\'e9g, \'f3v
akodjatok h\'e1t t\'f5l\'fck! Allah puszt\'edtsa el \'f5ket! Hogyan t\'e9r\'edttetnek el [az igazs\'e1gt\'f3l]?
\par 
\par 5. \'c9s amikor }{\insrsid10757626\charrsid10517983 azt mondj\'e1k nekik: \'84Gyertek, hogy Allah K\'fcld\'f6tte megbocs\'e1t\'e1st k\'e9rjen sz\'e1motokra [Allaht\'f3l]!\'94, f\'e9lre ford\'edtj\'e1k a fej\'fcket, \'e9s l\'e1tod, amint fennh\'e9j\'e1
zva elfordulnak.
\par 6. Egyre megy nekik, hogy k\'e9rsz-e sz\'e1mukra megbocs\'e1t\'e1st [\'f3 Mohamed], vagy nem k\'e9rsz megbocs\'e1t\'e1st, Allah nem fog nekik megbocs\'e1tani. Bizony, Allah nem vezeti [igaz \'fatra] az engedetlen n\'e9pet.
\par 7. \'d5k azok, akik azt mondj\'e1k: \'84Ne k\'f6ltsetek azokra, akik Allah K\'fcld\'f6tt\'e9n\'e9l vannak, am\'edg sz\'e9t nem sz\'f3r\'f3dnak mell\'f5le!\'94 \'c9s Allah\'e9 az egek \'e9s a f\'f6ld t\'e1rh\'e1zai, de a k\'e9pmutat\'f3k nem \'e9rtenek.

\par 8. \'d5k azt mondj\'e1k: \'84Ha visszat\'e9r\'fcnk Medin\'e1ba, bizony a m\'e9lt\'f3s\'e1gteljesebb ki fogja \'fbzni a megvetettet.\'94 \'c1m a m\'e9lt\'f3s\'e1g Allah\'e9 \'e9s a K\'fcld\'f6tt\'e9j\'e9 \'e9s a h\'edv\'f5k\'e9, de a k\'e9pmutat\'f3
k nem rendelkeznek tud\'e1ssal.
\par 
\par 9. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Ne vonja el figyelmeteket a vagyonotok \'e9s a gyerekeitek az Allahr\'f3l val\'f3 megeml\'e9kez\'e9sr\'f5l! \'c9s akik ezt teszik, nos \'f5
k bizony a vesztesek.
\par 10. \'c9s adakozzatok abb\'f3l, amivel ell\'e1ttunk titeket m\'e9g miel\'f5tt elj\'f6nne valamelyik\'f5t\'f6kh\'f6z a hal\'e1l, \'e9s [\'f5] azt mondja: \'84Uram! B\'e1rcsak halad\'e9kot adn\'e1l egy k\'f6zeli hat\'e1rid\'f5ig, akkor adakozn\'e9k \'e9
s a j\'f3k k\'f6z\'e9 tartozn\'e9k!\'94
\par 11. \'c9s Allah nem ad halad\'e9kot egy embernek sem, amikor elj\'f6n annak a hat\'e1rideje. \'c9s Allah j\'f3l ismeri azt, amit cselekszetek.}{\insrsid10757626 
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid11040789 64. A Nyeres\'e9g \'e9s Vesztes\'e9g (at-}{
\b\insrsid10757626\charrsid10517983 Taghabun) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10517983 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10517983 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10517983 
\par 1. Allahot magasztalja mindaz, ami az egekben, \'e9s ami a f\'f6ld\'f6n van. \'d6v\'e9 a kir\'e1lyi uralom, \'d5t illeti a h\'e1latelt dics\'f5\'edt\'e9s, \'e9s \'d5 minden dologra kiterjed\'f5 hatalm\'fa.
\par 2. \'d5 az, Aki teremtett titeket, \'e9s k\'f6z\'fcletek van hitetlen \'e9s k\'f6z\'fcletek van h\'edv\'f5. \'c9s Allah l\'e1tja azt, amit cselekszetek.
\par 3. Megteremtette az egeket \'e9s a f\'f6ldet az igazs\'e1ggal (c\'e9llal), \'e9s megform\'e1lt titeket, \'e9s a legjobb form\'e1t adta nektek. \'c9s Hozz\'e1 lesz a v\'e9gc\'e9l.
\par 4. Tudja mindazt, ami az egekben \'e9s a f\'f6ld\'f6n van, \'e9s tudja mindazt, amit elrejtetek \'e9s amit kinyilv\'e1n\'edtotok. \'c9s Allahnak tudom\'e1sa van arr\'f3l, amit a keblek rejtenek.
\par }\pard \qj \li0\ri0\widctlpar\tx6010\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10517983 \tab 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid10517983 5. Vajon nem j\'f6tt el hozz\'e1tok azoknak a h\'edre, akik hitetlenn\'e9 v\'e1ltak kor\'e1bban? Meg\'edzlelt\'e9
k h\'e1t [az evil\'e1gon] tett\'fck s\'falyos k\'f6vetkezm\'e9ny\'e9t, \'e9s [a T\'falvil\'e1gon] f\'e1jdalmas gy\'f6trelemben lesz r\'e9sz\'fck.
\par 6. Ez az\'e9rt [t\'f6rt\'e9nt \'edgy], mert elj\'f6ttek hozz\'e1juk a K\'fcld\'f6tteik a vil\'e1gos bizony\'edt\'e9kokkal, de \'f5k azt mondt\'e1k: \'84Vajon emberek vezetn\'e9nek minket [az igaz \'fatra]?\'94 \'c9s hitetlenn\'e9 v\'e1ltak \'e9
s elfordultak, \'e1m Allahnak nem volt sz\'fcks\'e9ge [r\'e1juk]. \'c9s Allah Gazdag, Dics\'e9retrem\'e9lt\'f3.
\par 
\par 7. Akik hitetlenn\'e9 v\'e1ltak azt \'e1ll\'edtott\'e1k, hogy nem lesznek felt\'e1masztva. Mondd [\'f3 Mohamed]: \'84Dehogynem! Uramra [esk\'fcsz\'f6m], hogy bizony fel lesztek t\'e1masztva, majd k\'f6z\'f6lve lesz veletek az, amit cselekedtetek, \'e9
s ez k\'f6nny\'fb Allahnak.\'94
\par 8. Higgyetek h\'e1t Allahban \'e9s a K\'fcld\'f6tt\'e9ben \'e9s a F\'e9nyben (a Kor\'e1nban), amelyet lebocs\'e1tottunk! \'c9s Allah j\'f3l ismeri mindazt, amit cselekszetek.
\par 9. Azon a napon, amikor \'f6sszegy\'fbjt titeket a Gy\'fclekez\'e9s napj\'e1ra, az a Nyeres\'e9g \'e9s Vesztes\'e9g napja [lesz]. \'c9s aki hisz Allahban \'e9s j\'f3tettet cselekszik, [\'d5] elt\'f6rli neki a rossztetteit, \'e9s bel\'e9
pteti olyan Kertekbe [a Paradicsomban], amelyek al\'f3l foly\'f3k folynak, \'f6r\'f6kk\'e9 abban fognak maradni. Ez a hatalmas diadal.
\par 10. \'c9s akik hitetlenn\'e9 v\'e1ltak \'e9s meghazudtolt\'e1k a jeleinket, \'f5k a [Pokol-]t\'fbz lak\'f3i, [\'f6r\'f6kk\'e9] abban fognak maradni. \'c9s milyen nyomor\'fas\'e1gos v\'e9gc\'e9l.
\par 
\par 11. Nem \'e9r [senkit] egyetlen csap\'e1s sem, csakis Allah enged\'e9ly\'e9vel. \'c9s aki hisz Allahban, annak a sz\'edv\'e9t [igaz \'fatra] vezeti. \'c9s Allahnak tudom\'e1sa van minden dologr\'f3l.
\par 12. \'c9s engedelmeskedjetek Allahnak \'e9s engedelmeskedjetek a K\'fcld\'f6ttnek! \'c1m ha elfordultok [az nem \'e1rt a K\'fcld\'f6ttnek], hiszen k\'fcld\'f6tt\'fcnk feladata csup\'e1n a vil\'e1gos [\'fczenet-]\'e1tad\'e1s.
\par 13. Allah, nincs m\'e1s [jogosan im\'e1dhat\'f3] isten csak \'d5! \'c9s [egyed\'fcl] Allahra hagyatkozzanak h\'e1t a h\'edv\'f5k!
\par 
\par 14. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Bizony, a h\'e1zast\'e1rsaitok \'e9s a gyermekeitek k\'f6z\'f6tt van olyan, aki az ellens\'e9getek (akad\'e1
lyozni akarnak titeket az Allahnak val\'f3 engedelmess\'e9gben), \'f3vakodjatok h\'e1t t\'f5l\'fck! \'c9s ha eln\'e9zitek [a rossz tett\'fcket], \'e9s felhagytok [a b\'fcntet\'e9s\'fckkel], \'e9s megbocs\'e1totok [nekik], akkor bizony Allah Megbocs\'e1t
\'f3, Irgalmas.
\par 15. A vagyonotok \'e9s a gyermekeitek csup\'e1n k\'eds\'e9rt\'e9s (megpr\'f3b\'e1ltat\'e1s) [a sz\'e1motokra], \'e9s Allahn\'e1l hatalmas jutalom van.
\par 16. F\'e9lj\'e9tek h\'e1t Allahot, amennyire k\'e9pesek vagytok r\'e1, \'e9s hallgassatok, engedelmeskedjetek \'e9s adakozzatok a magatok jav\'e1ra! \'c9s akik megv\'e9detnek a saj\'e1t f\'f6sv\'e9nys\'e9g\'fckt\'f5l, nos \'f5
k bizony azok, akik boldogulnak.
\par 17. Ha sz\'e9p k\'f6lcs\'f6nt }{\insrsid10757626 adtok }{\insrsid10757626\charrsid10517983 Allahnak}{\insrsid10757626  }{\insrsid10757626\charrsid3307951 (a k\'f6telez\'f5n fel\'fcl ad}{\insrsid10757626 akoz}{\insrsid10757626\charrsid3307951 tok)}{
\insrsid10757626\charrsid10517983 , [}{\insrsid10757626 akkor }{\insrsid10757626\charrsid10517983 \'d5] megt\'f6bbsz\'f6r\'f6zi azt nektek \'e9s megbocs\'e1t nektek. \'c9s Allah H\'e1l\'e1s, B\'e9ket\'fbr\'f5,
\par 18. A rejtett \'e9s a l\'e1that\'f3 [dolgok] Tud\'f3ja, a M\'e9lt\'f3s\'e1gteljes, a B\'f6lcs.}{\insrsid10757626 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid11040789 65. A v\'e1l\'e1s (at-Tal\'e1k) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid6954339 A K\'f6ny\'f6r\'fcletes \'e9s Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid6954339 
\par 1. \'d3 Pr\'f3f\'e9ta! Amikor [ti, muszlimok] elv\'e1ltok az asszonyokt\'f3l, v\'e1ljatok el t\'f5l\'fck v\'e1rakoz\'e1si idej\'fckre (megtisztul\'e1sukat k\'f6vet\'f5en), \'e9s tarts\'e1tok sz\'e1mon a v\'e1rakoz\'e1si id\'f5t, \'e9s f\'e9lj\'e9
tek Allahot, az Uratokat! Ne \'fbzz\'e9tek ki \'f5ket a h\'e1zaikb\'f3l \'e9s \'f5k se menjenek ki [onnan], kiv\'e9ve, ha \'f5k nyilv\'e1nval\'f3 erk\'f6lcstelens\'e9get k\'f6vettek el (par\'e1zn\'e1lkodtak)! \'c9s ezek az Allah [\'e1ltal kijel\'f6lt] hat
\'e1rok, \'e9s aki \'e1th\'e1gja az Allah [\'e1ltal kijel\'f6lt] hat\'e1rokat, az igazs\'e1gtalans\'e1got k\'f6vet el mag\'e1val szemben. Nem tudhatod, h\'e1tha Allah [\'faj] helyzetet hoz el\'f5.
\par 2. \'c9s amikor el\'e9rik a [v\'e1rakoz\'e1si] hat\'e1ridej\'fcket, akkor vagy tarts\'e1tok meg \'f5ket hely\'e9nval\'f3 m\'f3don, vagy hagyj\'e1tok el \'f5ket hely\'e9nval\'f3 m\'f3don! \'c9s k\'e9rjetek fel tan\'fanak magatok k\'f6z\'fcl k\'e9t igazs
\'e1gos f\'e9rfit! \'c9s tegyenek tan\'fas\'e1got Allah\'e9rt! Ez int\'e9s annak, aki hisz Allahban \'e9s az Utols\'f3 napban. \'c9s aki f\'e9li Allahot, annak \'d5 kiutat ad,
\par 3. \'c9s ell\'e1tja \'f5t onnan, ahonnan nem is sz\'e1m\'edt r\'e1. \'c9s aki Allahra hagyatkozik, h\'e1t \'d5 elegend\'f5 lesz a sz\'e1m\'e1ra. Bizony, Allah el\'e9ri a dolg\'e1t [amit akar]. Allah m\'e1r minden dolognak m\'e9rt\'e9ket adott.
\par 
\par 4. \'c9s akiknek az asszonyaitok k\'f6z\'fcl v\'e9g\'e9rv\'e9nyesen elmarad a havi v\'e9rz\'e9s\'fck \endash  ha k\'e9ts\'e9getek van [azzal kapcsolatban] \endash  azoknak h\'e1rom h\'f3nap a v\'e1rakoz\'e1si idej\'fck, \'e9s azoknak is, akiknek m\'e9
g nem volt havi v\'e9rz\'e9s\'fck. \'c9s akik visel\'f5s n\'f5k, azoknak a [v\'e1rakoz\'e1si] hat\'e1ridej\'fck addig tart, am\'edg meg nem sz\'fclik a terh\'fcket. \'c9s aki f\'e9li Allahot, annak [\'d5] k\'f6nny\'fbv\'e9 teszi a dolg\'e1t.
\par 5. Ez Allah parancsa, amelyet lebocs\'e1tott hozz\'e1tok, \'e9s aki f\'e9li Allahot, annak [\'d5] elt\'f6rli a rossztetteit, \'e9s hatalmass\'e1 teszi a jutalm\'e1t.
\par 6. Adjatok lakhelyet nekik (az elv\'e1lt n\'f5knek a v\'e1rakoz\'e1si idej\'fck alatt) ott, ahol ti laktok, lehet\'f5s\'e9geteknek megfelel\'f5en, \'e9s ne k\'e1ros\'edts\'e1tok meg \'f5ket az\'e9rt, hogy sz\'fbk\'f6s helyzetbe hozz\'e1tok \'f5
ket [hogy lemondjanak a jogaikr\'f3l]! \'c9s ha az elv\'e1lt asszonyaitok visel\'f5sek voltak, akkor k\'f6ltsetek r\'e1juk addig, am\'edg nem sz\'fclik meg a terh\'fcket! \'c9s ha szoptatj\'e1k nektek [a gyermekeiteket], akkor adj\'e1
tok meg nekik a fizets\'e9g\'fcket, \'e9s tan\'e1cskozzatok egym\'e1s k\'f6z\'f6tt hely\'e9nval\'f3 m\'f3don! \'c1m ha neh\'e9zs\'e9g (egyet nem \'e9rt\'e9s) ad\'f3dik k\'f6z\'f6ttetek [a szoptat\'e1ssal kapcsolatban], akkor egy m\'e1sik n\'f5
 fog szoptatni [az apa] sz\'e1m\'e1ra.
\par 7. A tehet\'f5s tehet\'f5ss\'e9ge szerint k\'f6lts\'f6n [az elv\'e1lt feles\'e9g\'e9re \'e9s a gyermekeire], \'e9s az, akinek sz\'fbk\'f6ss\'e9 t\'e9tetett az ell\'e1t\'e1sa, k\'f6lts\'f6n abb\'f3l, amit Allah adott neki! Allah senkit sem k\'f6telez t\'f6
bbre, mint amennyit adott neki. Allah a neh\'e9zs\'e9g ut\'e1n k\'f6nnyebbs\'e9get fog adni.
\par 
\par 8. \'c9s h\'e1ny [olyan] v\'e1ros volt, amely szembeszeg\'fclt az Ura \'e9s a K\'fcld\'f6ttei parancs\'e1val, Mi pedig elsz\'e1moltattuk \'f5ket szigor\'fa elsz\'e1moltat\'e1ssal, \'e9s megb\'fcntett\'fck olyan gy\'f6trelemmel, amin elsz\'f6rnyednek.

\par 9. Meg\'edzlelt\'e9k h\'e1t tett\'fck s\'falyos k\'f6vetkezm\'e9ny\'e9t, \'e9s a dolguk v\'e9gzete vesztes\'e9g lett.
\par 10. Allah szigor\'fa b\'fcntet\'e9st k\'e9sz\'edtett el\'f5 nekik. F\'e9lj\'e9tek h\'e1t Allahot, ti \'e9rtelemmel b\'edr\'f3k, akik hisztek! Allah m\'e1r lebocs\'e1tott hozz\'e1tok [egy] Eml\'e9keztet\'f5t (a Kor\'e1nt)!
\par 11. [\'c9s elk\'fcld\'f6tt nektek egy] K\'fcld\'f6ttet (Mohamedet), aki recit\'e1lja nektek Allah nyilv\'e1nval\'f3 jeleit (szavait), az\'e9rt hogy kihozza azokat, akik hisznek \'e9s j\'f3tetteket cselekszenek a [k\'fcl\'f6nb\'f6z\'f5] s\'f6t\'e9ts\'e9
gekb\'f5l a vil\'e1goss\'e1gra. \'c9s aki hisz Allahban \'e9s j\'f3t cselekszik, [azt] olyan Kertekbe bocs\'e1tja [a Paradicsomba], amelyek al\'f3l foly\'f3k folynak, \'f6r\'f6kk\'f6n-\'f6r\'f6kk\'e9 abban maradnak. Allah val\'f3ban sz\'e9pp\'e9
 tette neki ell\'e1t\'e1s\'e1t.
\par 12. Allah az, aki h\'e9t eget teremtett, \'e9s a f\'f6ldb\'f5l is ugyanannyit. Leereszkedik a parancs k\'f6z\'f6tt\'fck, hogy megtudj\'e1tok azt, hogy Allah minden dologra kiterjed\'f5 hatalm\'fa, \'e9s azt hogy Allah minden dolgot }{
\insrsid10757626\charrsid13571665 k\'f6r\'fclvesz tud\'e1s\'e1val.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid13571665 \page 66. A tilalom (at-Tahr\'edm) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid13571665 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid13571665 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\insrsid10757626\charrsid13571665 
\par 1. \'d3 Pr\'f3f\'e9ta! Mi\'e9rt teszed tilalmass\'e1 azt, amit Allah megengedett neked, keresve a feles\'e9geid tetsz\'e9s\'e9t? \'c9s Allah Megbocs\'e1t\'f3, Irgalmas.
\par 2. Allah m\'e1r el\'f5\'edrta (megengedte) nektek az esk\'fcitek al\'f3li felment\'e9st [a j\'f3v\'e1t\'e9tel \'e1ltal]. \'c9s Allah a P\'e1rtfog\'f3tok, \'d5 a Mindentud\'f3, a B\'f6lcs.
\par 3. \'c9s [eml\'e9kezzetek arra,] amikor a Pr\'f3f\'e9ta titokk\'e9nt mondott el egy besz\'e9det az egyik feles\'e9g\'e9nek, majd mikor az h\'edr\'fcl adta azt [egy m\'e1sik feles\'e9gnek], \'e9s Allah felfedte ezt el\'f5tte (a Pr\'f3f\'e9ta el\'f5
tt), akkor \'f5 tudatta [a feles\'e9g\'e9vel] annak egy r\'e9sz\'e9t, \'e9s egy m\'e1sik r\'e9sz\'e9t\'f5l pedig eltekintett. \'c9s amikor [a Pr\'f3f\'e9ta] h\'edr\'fcl adta azt neki, azt mondta [a feles\'e9g] neki: \'84Ki adta ezt neked h\'edr\'fcl?\'94
 Azt mondta [a Pr\'f3f\'e9ta]: \'84A Mindentud\'f3, a [mindent] j\'f3l Ismer\'f5 adta nekem h\'edr\'fcl.\'94
\par 4. Ha ti ketten (a k\'e9t feles\'e9g) b\'fbnb\'e1nattal fordultok Allahhoz, [az jobb nektek] hiszen elhajolt a sz\'edvetek [az igazs\'e1gt\'f3l]. \'c1m ha egym\'e1st seg\'edtitek ellene (Mohamed ellen), h\'e1t bizony Allah az \'f5 P\'e1rtfog\'f3ja, \'e9
s G\'e1briel \'e9s a j\'f3k a h\'edv\'f5k k\'f6z\'f6tt, \'e9s az angyalok - azon t\'fal - az \'f5 seg\'edt\'f5i.
\par 5. Tal\'e1n az Ura \endash  hogyha \'f5 (a Pr\'f3f\'e9ta) elv\'e1lik t\'f5letek (mindny\'e1jatokt\'f3l) \endash  n\'e1latok jobb feles\'e9geket ad neki cser\'e9be [helyettetek]: muszlimokat, h\'edv\'f5ket, al\'e1zatosan engedelmeseket, b\'fbnb\'e1
natot tan\'fas\'edt\'f3kat, istenszolg\'e1l\'f3kat, [Allah\'e9rt] \'fatra kel\'f5ket, akik m\'e1r voltak f\'e9rjn\'e9l, \'e9s akik sz\'fczek.
\par 
\par 6. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! \'d3vj\'e1tok magatokat \'e9s a csal\'e1dotokat a [Pokol-]t\'fbzt\'f5l, amelynek t\'fczel\'f5je az emberek \'e9s a [b\'e1lv\'e1ny]k\'f6
vek, felette kem\'e9ny \'e9s szigor\'fa angyalok [\'f5rk\'f6dnek], nem szeg\'fclnek ellen Allahnak abban, amit parancsolt nekik, hanem megteszik, amire parancsot kapnak!
\par 7. \'d3 ti, akik hitetlenn\'e9 v\'e1ltatok! Ne menteget\'f5zzetek a mai napon (a Felt\'e1mad\'e1s napj\'e1n)! Csup\'e1n azt kapj\'e1tok fizets\'e9g\'fcl, amit tettetek.
\par 
\par 8. \'d3 ti, akik hisztek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed Pr\'f3f\'e9ta k\'fcldet\'e9s\'e9ben]! Forduljatok Allahhoz \'f5szinte b\'fbnb\'e1nattal! Tal\'e1n az Uratok elt\'f6rli a rossz tetteiteket \'e9s bebocs\'e1
t titeket olyan Kertekbe [a Paradicsomban] amelyek al\'f3l foly\'f3k folynak \endash  azon a Napon, amikor Allah nem sz\'e9gyen\'edti meg a Pr\'f3f\'e9t\'e1t (Mohamedet) \'e9s azokat, akik vele egy\'fctt hisznek. Az \'f5 f\'e9ny\'fck el\'f5tt\'fck \'e9
s a jobbjukon igyekezve halad. Azt mondj\'e1k: \'84Urunk! Tedd sz\'e1munkra teljess\'e9 a f\'e9ny\'fcnket \'e9s bocs\'e1ss meg nek\'fcnk! Bizony, Te minden dologra kiterjed\'f5 hatalm\'fa vagy.\'94
\par 
\par 9. \'d3 Pr\'f3f\'e9ta! K\'fczdj a hitetlenek \'e9s a k\'e9pmutat\'f3k ellen, \'e9s legy\'e9l kem\'e9ny vel\'fck! \'c9s a Gyehenna lesz a mened\'e9khely\'fck, \'e9s milyen nyomor\'fas\'e1gos v\'e9gc\'e9l.
\par 
\par 10. Allah p\'e9ld\'e1t \'e1ll\'edtott azoknak, akik hitetlenek: No\'e9 feles\'e9g\'e9t \'e9s L\'f3t feles\'e9g\'e9t, akik szolg\'e1im k\'f6z\'fcl k\'e9t j\'f3 szolg\'e1m alatt voltak (hozz\'e1juk tartoztak feles\'e9gk\'e9nt), de mindketten el\'e1rult\'e1
k \'f5ket, \'edgy \'f5k (No\'e9 \'e9s L\'f3t) nem voltak hasznukra semmiben Allah [b\'fcntet\'e9s\'e9vel] szemben, \'e9s az lett nekik (a feles\'e9geknek) mondva: \'84Menjetek be ketten a [Pokol-]t\'fbzbe a bemen\'f5kkel!\'94
\par 11. \'c9s Allah p\'e9ld\'e1t \'e1ll\'edtott azoknak, akik hisznek: a F\'e1ra\'f3 feles\'e9g\'e9t, amikor azt mondta: \'84Uram! \'c9p\'edts nekem n\'e1lad egy h\'e1zat a Paradicsomban, \'e9s ments meg a F\'e1ra\'f3t\'f3l \'e9s a tetteit\'f5l, \'e9
s ments meg az igazs\'e1gtalan n\'e9pt\'f5l!\'94
\par 12. \'c9s M\'e1ri\'e1t, Imr\'e1n le\'e1ny\'e1t, aki meg\'f5rizte a szem\'e9rm\'e9t [a par\'e1znas\'e1gt\'f3l], s Mi a lelk\'fcnkb\'f5l (G\'e1briel angyal \'e1ltal) lehelt\'fck bel\'e9je [J\'e9zus lelk\'e9t], \'e9s [M\'e1ria] hitt az Ura Szavaiban, \'e9
s az \'cdr\'e1saiban \'e9s az al\'e1zatosan engedelmesek k\'f6z\'e9 tartozott.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid13571665 \page 67. A kir\'e1lyi uralom (al-Mulk) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid13571665 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665 1. \'c1ldass\'e9k az, akinek a kez\'e9ben van a kir\'e1lyi uralom, 
\'e9s \'d5 minden dologra kiterjed\'f5 hatalm\'fa}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid13571665 !}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665 
\par 2. Aki megteremtette a hal\'e1lt \'e9s az \'e9letet az\'e9rt, hogy pr\'f3b\'e1ra tegyen titeket: melyik\'f5t\'f6k}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 nek}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665  jobb a cselekedete. \'c9s \'d5 a }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid13571665 M\'e9lt\'f3s\'e1gteljes}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665 , a Megbocs\'e1t\'f3,
\par 3. Aki megteremtett h\'e9t eget egym\'e1s feletti szintekk\'e9nt. Nem l\'e1tsz t\'f6k\'e9letlens\'e9get a K\'f6ny\'f6r\'fcletes teremt\'e9s\'e9ben. N\'e9zd h\'e1t meg \'fajra! L\'e1tsz-e vajon reped\'e9st?
\par 4. Azt\'e1n n\'e9zd meg \'fajra \'e9s \'fajra! A tekintet }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid13571665 kudarcot vallva}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665  \'e9s f\'e1radtan t\'e9
r vissza hozz\'e1d.
\par 5. \'c9s bizony a legals\'f3 eget l\'e1mp\'e1sokkal d\'edsz\'edtett\'fck fel, \'e9s a s\'e1t\'e1nokat kitasz\'edt\'f3 l\'f6ved\'e9kekk\'e9 tett\'fck [azokat], \'e9s el\'f5k\'e9sz\'edtett\'fck nekik (a s\'e1t\'e1noknak) a L\'e1ngol\'f3 [Pokol-t\'fbz] gy
\'f6trelm\'e9t.
\par 
\par 6. \'c9s akik nem hisznek az Urukban, azoknak a Gyehenna gy\'f6trelme j\'e1r. Milyen nyomor\'fas\'e1gos v\'e9gc\'e9l!
\par 7. Amikor belevetik \'f5ket, hallj\'e1k annak sz\'f6rny\'fb hangj\'e1t, mik\'f6zben forr.
\par 8. Majdnem sz\'e9tszakad a d\'fcht\'f5l. Valah\'e1nyszor belevetnek egy csoportot, megk\'e9rdezik \'f5ket a [Pokol-]t\'fbz \'f5rz\'f5i: \'84Nem j\'f6tt-e hozz\'e1tok figyelmeztet\'f5?\'94
\par 9. Azt mondj\'e1k: \'84Dehogynem! Bizony, j\'f6tt hozz\'e1nk figyelmeztet\'f5, de mi meghazudtoltuk, \'e9s azt mondtuk [neki \'e9s a k\'f6vet\'f5inek, hogy]: nem bocs\'e1tott le Allah semmit [kinyilatkoztat\'e1sk\'e9nt]. Ti csup\'e1n nagy t\'e9velyg\'e9
sben vagytok.\'94
\par 10. \'c9s azt mondj\'e1k: \'84Ha hallgattunk volna [a figyelmeztet\'e9sre], vagy \'e9lt\'fcnk volna az esz\'fcnkkel, akkor nem lenn\'e9nk a L\'e1ngol\'f3 [t\'fbz] lak\'f3i k\'f6z\'f6tt.}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid13571665 \'94
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665 11. \'c9s [ezzel] beismerik a v\'e9tk\'fcket. El h\'e1t innen a L\'e1ngol\'f3 [t\'fbz] lak\'f3ival!
\par 
\par 12. Bizony, akik f\'e9lnek az Urukt\'f3l an\'e9lk\'fcl, hogy l\'e1tn\'e1k \'d5t, azoknak megbocs\'e1t\'e1s \'e9s nagy jutalom j\'e1r.
\par 
\par 13. \'c9s rejts\'e9tek el mondanival\'f3tokat, vagy mondj\'e1tok ki ny\'edltan. Neki tudom\'e1sa van arr\'f3l, amit a keblek (sz\'edvek) rejtenek.
\par 14. Vajon annak ne lenne tudom\'e1sa [mindenr\'f5l], aki teremtett}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid13571665 ?}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665  \'c9s \'d5 a K\'edm\'e9let
es, a [mindent] j\'f3l Ismer\'f5.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid13571665 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665 15. \'d5 az, aki kezess\'e9 tette nektek a f\'f6ldet. J\'e1rjatok h\'e1t annak \'fatjain \'e9s egyetek abb\'f3l, amivel [\'d5] ell\'e1tott titeket! \'c9s \'d5hozz\'e1
 lesz a kij\'f6vetel [a s\'edrokb\'f3l].
\par 
\par 16. Biztons\'e1gban \'e9rzitek-e magatokat att\'f3l, aki az \'e9gben van, hogy nem s\'fcllyeszti el alattatok a f\'f6ldet, \'e9s \'edme az [r\'f6gt\'f6n] rengeni kezd?
\par 17. Vagy biztons\'e1gban \'e9rzitek-e magatokat att\'f3l, aki az \'e9gben van, hogy nem k\'fcld r\'e1tok kavicssz\'f3r\'f3 [sz\'e9lvihart]? \'c9s akkor megtudj\'e1tok majd, hogy milyen az \'e9n figyelmeztet\'e9sem!
\par 18. \'c9s bizony meghazudtol\'e1st k\'f6vettek el azok, akik el\'f5tt\'fck \'e9ltek. Milyen volt h\'e1t az \'e9n rosszall\'e1som?!
\par 19. \'c9s nem l\'e1tj\'e1k-e, ahogy a madarak f\'f6l\'f6tt\'fck kiterjesztik [a sz\'e1rnyukat] \'e9s \'f6sszeh\'fazz\'e1k? Nem tartja meg \'f5ket m\'e1s, csakis a K\'f6ny\'f6r\'fcletes. Bizony, \'d5 minden dolgot \'e1tl\'e1t.
\par 20. Vagy ki az, aki a ti seregetek lehetne, amely seg\'edtene titeket a K\'f6ny\'f6r\'fcletesen k\'edv\'fcl? A hitetlenek csup\'e1n megt\'e9veszt\'e9sben vannak.
\par 21. Vagy ki az, aki ell\'e1t titeket, ha [Allah] visszatartja az ell\'e1t\'e1s\'e1t? De nem! \'d5k megmakacsolt\'e1k magukat a g\'f5gben \'e9s }{\cs100\cf1\insrsid10757626\charrsid13571665 [az igazs\'e1gt\'f3l val\'f3]}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665  }{\cs100\cf1\insrsid10757626\charrsid13571665 viszolyg\'e1sban.}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid13571665 
\par 22. Vajon az, aki f\'f6ldre szegezett tekintettel j\'e1r, van-e jobban vezetve, vagy az, aki kiegyenesedve j\'e1r, egyenes \'faton?
\par 23. Mondd: \'84\'d5 az, aki l\'e9trehozott titeket \'e9s adta nektek a hall\'e1st, a l\'e1t\'e1st \'e9s a sz\'edvet (az \'e9rtelmet). Mily kev\'e9ss\'e9 adtok h\'e1l\'e1t!\'94
\par 
\par 24. Mondd: \'84\'d5 az, aki megsokas\'edtott titeket a f\'f6ld\'f6n, \'e9s \'d5hozz\'e1 lesztek \'f6sszegy\'fbjtve.\'94
\par 25. \'c9s \'f5k azt mondj\'e1k: \'84Mikor [k\'f6vetkezik be] ez az }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1071036 \'edg\'e9ret, ha }{\insrsid10757626\charrsid1071036 val\'f3ban }{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1071036 igazmond\'f3k vagytok?\'94
\par 26. Mondd }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid1071036 [\'f3 Mohamed]}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1071036 : \'84A tud\'e1s egyed\'fcli birtokosa Allah. \'c9n csak nyilv\'e1nval\'f3
 figyelmeztet\'f5 vagyok}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid1071036 .}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1071036 \'94
\par 27. \'c9s amikor majd [magukhoz] k\'f6zelinek l\'e1tj\'e1k azt (a t\'falvil\'e1gi b\'fcntet\'e9st), el fog komorulni a hitetlenek arca, \'e9s azt mondj\'e1k [nekik]: \'84Ez az, amit olyannyira k\'e9rtetek!\'94
\par 
\par 28. }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid12941253 Mondd [\'f3 Mohamed azoknak, akik a hal\'e1lodat k\'edv\'e1nj\'e1k]: \'84Vajon mit gondoltok, ha Allah elpuszt\'edtana engem \'e9s azokat, akik velem vannak, vagy megk\'f6
ny\'f6r\'fclne rajtunk [mit haszn\'e1lna ez nektek], nos ki adna v\'e9delmet a hitetleneknek a f\'e1jdalmas gy\'f6trelemmel szemben?\'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1071036 29. Mondd: \'84\'d5 a K\'f6ny\'f6r\'fcletes. Hisz\'fcnk benne \'e9s R\'e1 hagyatkozunk. Ti pedig meg fogj\'e1tok tudni, hogy ki az, aki nyilv\'e1nval\'f3 t\'e9velyg\'e9
sben van.\'94
\par 30. Mondd: \'84Vajon mit gondoltok? Ha [a f\'f6ld] m\'e9ly\'e9re s\'fcllyed\'f5v\'e9 v\'e1lik a vizetek, h\'e1t akkor ki hoz nektek szemmel l\'e1that\'f3 (felsz\'ednen foly\'f3) vizet?\'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 

\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid8850473 68. Az \'edr\'f3toll (al-Kalam) c}{\b\insrsid10757626\charrsid9462382 
. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid9462382 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid9462382 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid9462382 
\par 1. N\'fan. [Esk\'fcsz\'f6m] az \'edr\'f3tollra, \'e9s arra, amit le\'edrnak.
\par 2. Urad k\'f6ny\'f6r\'fclete \'e1ltal te nem vagy \'f5r\'fclt.
\par 3. \'c9s bizony, meg nem sz\'fbn\'f5 jutalomban lesz r\'e9szed.
\par 4. \'c9s te bizony nagyszer\'fb erk\'f6lcs\'fb vagy.
\par 
\par 5. Meg fogod h\'e1t l\'e1tni}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid9462382 ,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid9462382  \'e9s \'f5k is meg fogj\'e1k l\'e1tni,
\par 6. Hogy melyik\'f5t\'f6k az, akit k\'eds\'e9rt\'e9s (\'f5r\'fclts\'e9g) \'e9rt.
\par 7. Bizony, az Urad az, aki a legjobban tudja azt, hogy ki t\'e9velyedett el az [\'d5] \'fatj\'e1t\'f3l, \'e9s \'d5 tudja legjobban azt, hogy kik leltek az igaz \'fatra.
\par 8. Ne engedelmeskedj h\'e1t a meghazudtol\'f3knak!
\par 9. Azt szeretn\'e9k, ha hajlan\'e1l a megalkuv\'e1sra [a vall\'e1ssal kapcsolatban] \'e9s akkor \'f5k is hajlan\'e1nak a megalkuv\'e1sra.
\par 10. \'c9s ne engedelmeskedj minden hitv\'e1ny esk\'fcd\'f6z\'f5nek,
\par 11. R\'e1galmaz\'f3nak \'e9s pletyk\'e1t terjeszt\'f5nek,
\par 12. A j\'f3nak \'fatj\'e1ba \'e1ll\'f3nak, a hat\'e1rokat \'e1th\'e1g\'f3nak, sok b\'fbnt elk\'f6vet\'f5nek,
\par 13. Goromb\'e1nak \'e9s azon t\'fal fatty\'fanak,
\par 14. Az\'e9rt, mert vagyona \'e9s [sok] gyermeke van!
\par 15. Amikor a jeleink recit\'e1ltatnak neki, azt mondja: \'84[Ezek] a hajdanvoltak legend\'e1i!\'94
\par 16. Meg fogjuk b\'e9lyegezni az orr\'e1n.
\par 
\par 17. Bizony, Mi pr\'f3b\'e1ra tett\'fck \'f5ket, amik\'e9ppen pr\'f3b\'e1ra tett\'fck a kert birtokosait, amikor megesk\'fcdtek, hogy reggelre kelve lesz\'fcretelik azt,
\par 18. \'c9s nem hagynak semmit [lesz\'fcretel\'e9s n\'e9lk\'fcl].
\par 19. \'c9s megk\'f6rny\'e9kezte azt az Uradt\'f3l egy megk\'f6rny\'e9kez\'f5 (puszt\'edt\'f3 t\'fbz), mik\'f6zben aludtak,
\par 20. \'c9s reggelre olyan lett, mint a [felperzselt] tarl\'f3.
\par 21. \'d5k pedig reggelre kelve sz\'f3longatt\'e1k egym\'e1st,
\par 22. [mondv\'e1n:] \'84Menjetek kora reggel a vet\'e9setekre, ha val\'f3ban le akarj\'e1tok sz\'fcretelni!\'94
\par 23. Elindultak h\'e1t \'e9s k\'f6zben halkan besz\'e9ltek egym\'e1ssal,
\par 24. [mondv\'e1n:] \'84Nem l\'e9phet be hozz\'e1tok ma egy szeg\'e9ny sem!\'94
\par 25. \'c9s kora reggel elt\'f6k\'e9lten mentek el, [azt gondolv\'e1n, hogy] k\'e9pesek lesznek [v\'e9grehajtani a terv\'fcket].
\par 26. Amikor megl\'e1tt\'e1k azt (a kertet), azt mondt\'e1k: \'84Bizony, mi biztosan elt\'e9vedt\'fcnk!
\par 27. Mi t\'f6bb, mi meg vagyunk fosztva [a term\'e9s\'fcnkt\'f5l]!\'94
\par 28. A legj\'f3zanabbul gondolkod\'f3 k\'f6z\'fcl\'fck azt mondta: \'84Nem mondtam-e nektek}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid9462382 ,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid9462382  [hogy] mi\'e9
rt nem magasztalj\'e1tok [az Urat]?\'94
\par 29. Azt mondt\'e1k: \'84Magasztaltass\'e9k az Urunk! Bizony, mi igazs\'e1gtalanok voltunk!\'94
\par 30. \'c9s egyesek k\'f6z\'fcl\'fck a t\'f6bbiekhez fordultak, szemreh\'e1ny\'e1st t\'e9ve egym\'e1snak.
\par 31. Azt mondt\'e1k: \'84\'d3, jaj nek\'fcnk! Bizony, \'e1th\'e1gtuk a hat\'e1rokat.
\par 32. Tal\'e1n az Urunk enn\'e9l jobbat ad nek\'fcnk cser\'e9be. Mi bizony Allah [kegyei] ut\'e1n v\'e1gyakozunk.\'94
\par 33. Ilyen a b\'fcntet\'e9s [az evil\'e1gon], \'e1m a t\'falvil\'e1g b\'fcntet\'e9se [m\'e9g] nagyobb. B\'e1rcsak tudt\'e1k volna!
\par 
\par 34. Bizony, az istenf\'e9l\'f5knek a gy\'f6ny\'f6r\'fbs\'e9g kertjei lesznek az Urukn\'e1l.
\par 35. Vajon \'fagy b\'e1njunk az [\'f6nmagukat Allahnak] al\'e1vet\'f5kkel, mint a gonosztev\'f5kkel?
\par 36. Mi lelt titeket? Hogyan \'edt\'e9lhettek [\'edgy]?
\par 37. Vagy tal\'e1n van egy \'edr\'e1sotok, amelyben [ilyet] tanultok,
\par 38. [}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid9462382 M}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid9462382 ert akkor] bizony az van benne, ami [j\'f3t] v\'e1lasztotok [magatoknak].
\par 39. Vagy tal\'e1n R\'e1nk n\'e9zve [k\'f6telez\'f5en teljes\'edtend\'f5] esk\'fcvel rendelkeztek \endash  amely a Felt\'e1mad\'e1s napj\'e1ig \'e9rv\'e9nyben marad \endash  [arr\'f3l,] hogy bizony megillet titeket az, amit [magatoknak] \'edt\'e9ltek?

\par 40. K\'e9rdezd meg \'f5ket, hogy melyik\'fck kezeskedik ez\'e9rt!
\par 41. Vagy vannak [\'e1ltaluk Allah mell\'e9 helyezett] t\'e1rsisteneik? Hozz\'e1k h\'e1t a t\'e1rsisteneiket, ha val\'f3ban igazmond\'f3k!
\par 
\par 42. Azon a napon, amikor s\'falyoss\'e1 v\'e1lik a helyzet, \'e9s leborul\'e1sra lesznek h\'edvva, \'e1m \'f5k nem lesznek k\'e9pesek [r\'e1]!
\par 43. Al\'e1zatos lesz a tekintet\'fck, \'e9s megal\'e1ztat\'e1s fogja \'f5ket bor\'edtani, mert m\'e1r [az evil\'e1gon] leborul\'e1sra lettek h\'edvva, amikor m\'e9g eg\'e9szs\'e9gesek voltak.
\par 44. Hagyj h\'e1t engem azokkal, akik meghazudtolj\'e1k ezt a Besz\'e9det (a Kor\'e1nt)! Azokra fokozatosan m\'e9rj\'fck [a b\'fcntet\'e9st] olyan helyr\'f5l, amelyr\'f5l nem is tudnak.
\par 45. \'c9s halad\'e9kot adok nekik [egy ideig]. Bizony, er\'f5s az \'e9n fondorlatom.
\par 46. Vagy tal\'e1n fizets\'e9get k\'e9rsz t\'f5l\'fck, [\'e9s] ez\'e9rt \'f5ket ad\'f3ss\'e1g terhe nyomja?
\par 47. Vagy tal\'e1n n\'e1luk van a rejtett dolgok [ismerete], \'e9s \'f5k le\'edrj\'e1k [azt \'e9s aszerint \'edt\'e9lkeznek]?
\par 
\par 48. L\'e9gy h\'e1t t\'fcrelmes Urad d\'f6nt\'e9se ir\'e1nt, \'e9s ne legy\'e9l olyan, mint a Hal lak\'f3ja, amikor sz\'f3l\'edtotta [Ur\'e1t], mik\'f6zben nagy b\'e1nat t\'f6lt\'f6tte el!}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 

\par 49. Ha nem \'e9rte volna \'f5t el Ura j\'f3t\'e9tem\'e9nye, [akkor] bizony a kop\'e1r s\'edks\'e1gra lett volna kivetve, \'e9s}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626  m}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 egrov\'e1
sban r\'e9szes\'fclve.
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 50. Azut\'e1n Ura kiv\'e1lasztotta \'f5t, \'e9s a j\'f3 emberek k\'f6z\'e9 helyezte.
\par 51. \'c9s azok, akik hitetlenn\'e9 v\'e1ltak, majdnem botl\'e1sra k\'e9sztetnek t\'e9ged a tekintet\'fckkel, amikor meghallj\'e1k az eml\'e9keztet\'e9st, \'e9s azt mondj\'e1k: \'84Bizony, \'f5 biztosan egy \'f5r\'fclt!\'94
\par 52. \'c9s ez csup\'e1n egy eml\'e9keztet\'f5 a teremtm\'e9nyeknek.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page 69. A}{\b\insrsid10757626\charrsid8850473  }{\b\insrsid10757626\charrsid15092154 Beteljesed\'f5 (al-H\'e1
kka) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 .
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 1. A Beteljesed\'f5!
\par 2. Mi a Beteljesed\'f5?
\par 3. \'c9s mi tudatn\'e1 veled, hogy mi a Beteljesed\'f5?
\par 4. }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 Meghazudtolta }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 Tam\'fad \'e9s \'c1d [n\'e9pe] a Les\'fajt\'f3t (a Felt\'e1mad\'e1s napj\'e1t).
\par 5. Ami Tam\'fadot illeti, \'f5ket [az erej\'e9ben] minden hat\'e1rt t\'fall\'e9p\'f5 [ki\'e1lt\'e1s] puszt\'edtotta el.
\par 6. \'c9s ami \'c1dot illeti, \'f5ket pedig s\'fcv\'edt\'f5, tombol\'f3 sz\'e9l puszt\'edtotta el,
\par 7. Melynek [Allah] hatalmat adott felett\'fck h\'e9t \'e9jszak\'e1n \'e9s nyolc napon \'e1t szakadatlanul, s l\'e1thattad volna az embereket elter\'fclve, mintha datolyap\'e1lm\'e1k odvas csonkjai lenn\'e9nek.
\par 8. S vajon l\'e1tsz-e b\'e1rmit, ami megmaradt volna bel\'f5l\'fck?
\par 
\par 9. \'c9s v\'e9tkezett a F\'e1ra\'f3 \'e9s akik el\'f5tte voltak, \'e9s az elpuszt\'edtott v\'e1rosok [lak\'f3i],
\par 10. \'c9s ellenszeg\'fcltek az Uruk K\'fcld\'f6tt\'e9nek, \'d5 pedig n\'f6vekv\'f5 b\'fcntet\'e9ssel ragadta el \'f5ket.
\par 11. Bizony, amikor a v\'edz el\'f6nt\'f6tt mindent, egy [nagy hull\'e1mokon] halad\'f3 b\'e1rk\'e1n hordoztunk titeket (el\'f5deiteket),
\par 12. Hogy eml\'e9keztet\'f5v\'e9 tegy\'fck ezt nektek, \'e9s hogy megjegyezze [minden] figyel\'f5 f\'fcl!
\par 
\par 13. \'c9s amikor megf\'favatik a K\'fcrt egy f\'faj\'e1ssal,
\par 14. \'c9s a f\'f6ld \'e9s a hegyek f\'f6lemeltetnek \'e9s egyetlen z\'faz\'e1ssal sz\'e9tz\'faz\'f3dnak,
\par 15. \'c9s azon a napon bek\'f6vetkezik a Bek\'f6vetkez\'f5 (a Felt\'e1mad\'e1s napja).
\par 16. \'c9s sz\'e9thasad az \'e9g, \'e9s azon a napon gyenge lesz,
\par 17. \'c9s az angyalok a sz\'e9lein lesznek. \'c9s azon a napon az Urad tr\'f3nus\'e1t nyolcan hordozz\'e1k maguk f\'f6l\'f6tt.
\par 18. Azon a napon el\'f5 lesztek vezetve, [\'e9s] egyetlen titkotok sem marad rejtve.
\par 
\par 19. Ami pedig azt illeti, akinek az \'edr\'e1sa (tetteinek feljegyz\'e9se) a jobbj\'e1ba adatik, azt mondja majd: \'84\'cdmhol! Olvass\'e1tok az \'edr\'e1somat!
\par 20. Bizony, \'e9n [teljes bizonyoss\'e1ggal] v\'e9ltem, hogy tal\'e1lkozni fogok az elsz\'e1mol\'e1sommal.\'94
\par 21. \'c9s neki el\'e9gedetts\'e9get ad\'f3 \'e9lete lesz
\par 22. Egy magasan fekv\'f5 Kertben [a Paradicsomban],
\par 23. Amelynek [gy\'fcm\'f6lcs-]f\'fcrtjei m\'e9lyen al\'e1cs\'fcng\'f5ek.
\par 24. Egyetek \'e9s igyatok eg\'e9szs\'e9ggel amiatt, amit el\'f5re k\'fcldtetek a r\'e9gm\'falt napokban!
\par 
\par 25. \'c9s ami azt illeti, akinek az \'edr\'e1sa balj\'e1ba adatik, h\'e1t [\'f5] azt mondja: \'84\'d3, b\'e1rcsak ne kaptam volna meg az \'edr\'e1som,
\par 26. \'c9s ne tudn\'e1m, hogy mi is a sz\'e1mad\'e1som!
\par 27. \'d3, b\'e1rcsak [a hal\'e1l] lett volna a v\'e9g!
\par 28. A vagyonom nem haszn\'e1lt nekem semmit,
\par 29. S a hatalmam semmiv\'e9 v\'e1lt.\'94
\par 30. [A Pokol-t\'fbz str\'e1zs\'e1inak az lesz mondva:] \'84Ragadj\'e1tok meg \'e9s verj\'e9tek bilincsbe!
\par 31. Azt\'e1n a Pokolba vess\'e9tek!
\par 32. Majd verj\'e9tek l\'e1ncra, amely hetven karnyi hossz\'fa!\'94
\par 33. Bizony, \'f5 [kor\'e1bban] nem hitt a Hatalmas Allahban,
\par 34. \'c9s nem \'f6szt\'f6nz\'f6tt a szeg\'e9ny etet\'e9s\'e9re.
\par 35. Nincs h\'e1t neki ma itt bar\'e1tja,
\par 36. Sem eledele, csup\'e1n gennyb\'f5l,
\par 37. Amit csak a v\'e9tkesek esznek.
\par 
\par 38. De nem! Esk\'fcsz\'f6m arra, amit l\'e1ttok,
\par 39. \'c9s amit nem l\'e1ttok,
\par 40. [}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 H}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 ogy] bizony ez, bizonyosan egy nemes k\'fcld\'f6tt szava!
\par 41. \'c9s ez nem egy k\'f6lt\'f5 szava! [Milyen] kev\'e9s az, amiben hisztek!
\par 42. \'c9s nem egy j\'f3s szava! [Mily] kev\'e9ss\'e9 okultok az int\'e9sb\'f5l!
\par 43. [A Kor\'e1n] a teremtm\'e9nyek Ur\'e1nak lebocs\'e1tott [kinyilatkoztat\'e1sa].}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 44. \'c9s ha [Mohamed] n\'e9h\'e1ny hazugs\'e1got tal\'e1lna ki s Mi nev\'fcnkben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 ,}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par 45. [Akkor] bizony megragadn\'e1nk \'f5t a jobbj\'e1n\'e1l,
\par 46. Azt\'e1n elv\'e1gn\'e1nk az \'fct\'f5er\'e9t,
\par 47. \'c9s k\'f6z\'fcletek senki sem tarthatna vissza [Minket] t\'f5le.
\par 48. \'c9s bizony, ez eml\'e9keztet\'e9s az istenf\'e9l\'f5knek.
\par 49. \'c9s bizony, mi tudjuk, hogy vannak k\'f6z\'fcletek, akik meghazudtolj\'e1k [ezt].
\par 50. \'c9s ez bizony, biztosan b\'e1natot hoz a hitetleneknek!
\par 51. \'c9s ez bizony, a szil\'e1rd igazs\'e1g k\'e9ts\'e9gtelen bizonyoss\'e1ga!
\par 52. Magasztald h\'e1t a te Hatalmas Urad nev\'e9t!}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page 70. }{\b\insrsid10757626\charrsid8850473 Az }{\b\insrsid10757626\charrsid15092154 emelked\'f5 utak (al-Ma
\'e1ridzs) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 1. Egy k\'e9rdez\'f5 k\'e9rd\'e9st tett fel a bek\'f6vetkez\'f5 gy
\'f6trelemr\'f5l
\par 2. A}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154  }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 hitetlenek sz\'e1m\'e1ra, }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 
aminek nincs elh\'e1r\'edt\'f3ja,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 3. [Ami] Allaht\'f3l, az emelked\'f5 utak Birtokos\'e1t\'f3l [val\'f3
].
\par 4. F\'f6lmennek az angyalok \'e9s a L\'e9lek \'d5hozz\'e1, egy olyan napon, amely [hossz\'e1nak] m\'e9rt\'e9ke \'f6tvenezer esztend\'f5.
\par 5. T\'fbrj h\'e1t sz\'e9p t\'fcrelemmel!
\par 6. Bizony, \'f5k t\'e1volinak l\'e1tj\'e1k azt,
\par 7. Mi pedig k\'f6zelinek l\'e1tjuk azt.
\par 
\par 8. Azon a napon az \'e9g olyan lesz, mint az olvasztott \'e9rc,
\par 9. \'c9s a hegyek olyanok lesznek, mint a gyapj\'fa,
\par 10. \'c9s egy bar\'e1t sem k\'e9rdez a bar\'e1tj\'e1r\'f3l,
\par 11. [Noha] l\'e1tj\'e1k egym\'e1st. A gonosztev\'f5 azt szeretn\'e9, ha megv\'e1lthatn\'e1 mag\'e1t azon nap gy\'f6trelm\'e9t\'f5l a gyermekeivel,
\par 12. \'c9s a [h\'e1zas]t\'e1rs\'e1val \'e9s a fiv\'e9r\'e9vel,
\par 13. \'c9s a k\'f6zeli rokonaival, akik v\'e9delmezt\'e9k,
\par 14. \'c9s mindenkivel, aki a f\'f6ld\'f6n van \endash  [hogy] azut\'e1n [ily m\'f3don] menek\'fclj\'f6n meg.
\par 15. De nem! Bizony, ez Lobog\'f3 t\'fbz,
\par 16. Amely let\'e9pi a fejb\'f5rt,
\par 17. [}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 M}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 ag\'e1hoz] h\'edvja azt, aki elfordult \'e9s h\'e1tat ford\'edtott,
\par 18. \'c9s [vagyont] gy\'fbjt\'f6tt \'e9s felhalmozott.
\par 
\par 19. Bizony, az ember kishit\'fbnek lett teremtve}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 :}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par 20. Amikor baj \'e9ri, akkor k\'e9ts\'e9gbeesett lesz,
\par 21. \'c9s amikor j\'f3 \'e9ri, akkor sz\'fbkmark\'fa lesz,}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par 22. Kiv\'e9ve az im\'e1dkoz\'f3kat,
\par 23. Azokat, akik \'e1llhatatosak az im\'e1dkoz\'e1sukban,
\par 24. \'c9s akiknek a vagyon\'e1ban meghat\'e1rozott jogos r\'e9sze van
\par 25. A k\'e9reget\'f5nek \'e9s a sz\'fbk\'f6lk\'f6d\'f5nek,
\par 26. \'c9s akik igaznak tartj\'e1k az \'cdt\'e9let napj\'e1t;
\par 27. \'c9s azokat, akik az Uruk gy\'f6trelm\'e9t\'f5l meg vannak r\'e9m\'fclve -
\par 28. Bizony, az Uruk gy\'f6trelm\'e9t\'f5l senki sem \'e9rezheti mag\'e1t biztons\'e1gban -,
\par 29. \'c9s azokat, akik a szem\'e9rm\'fcket meg\'f5rzik [a nemi kapcsolatokt\'f3l],
\par 30. Kiv\'e9ve a h\'e1zast\'e1rsaikkal [val\'f3 kapcsolatot], vagy azokkal, akiket a jobbjuk birtokol, mert bizony [akkor] nem \'e9ri \'f5ket szemreh\'e1ny\'e1s.
\par 31. Akik pedig ezen fel\'fcl keresnek [nemi kapcsolatot], nos \'f5k bizony a hat\'e1rokat \'e1th\'e1g\'f3k.
\par 32. \'c9s azokat, akik a r\'e1juk b\'edzott let\'e9teket \'e9s egyezs\'e9g\'fcket meg\'f5rzik.
\par 33. \'c9s azokat, akik szil\'e1rdan \'e1llnak tan\'fas\'e1gt\'e9tel\'fckben,
\par 34. \'c9s azokat, akik im\'e1dkoz\'e1saik [betart\'e1s\'e1ra] \'fcgyelnek.
\par 35. [Mert] azok [mind] Kertekben lesznek [a Paradicsomban], m\'e9lt\'f3s\'e1gban r\'e9szes\'fclve.
\par 
\par 36. Mi van h\'e1t azokkal, akik hitetlenn\'e9 v\'e1ltak, hogy [megal\'e1zottan] fel\'e9d sietnek,
\par 37. A jobb [oldalr\'f3l] \'e9s }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 a }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 bal [oldalr\'f3l], csoportokba [gy\'fblve]?
\par 38. Vajon abban rem\'e9nykedik minden ember k\'f6z\'fcl\'fck, hogy a gy\'f6ny\'f6r\'fbs\'e9g kertj\'e9be lesz bebocs\'e1tva?
\par 39. De nem! Bizony, megteremtett\'fck \'f5ket abb\'f3l, amir\'f5l tudnak.
\par 
\par 40. \'c9s nem! Esk\'fcsz\'f6m a napkelt\'e9k \'e9s a napnyugt\'e1k Ur\'e1ra! Bizony, hatalmunkban \'e1ll,
\par 41. }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 H}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 ogy felcser\'e9lj\'fck [\'f5ket] n\'e1luk jobbakra, \'e9s Minket nem lehet megakad\'e1
lyozni [ebben].}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 42. Hagyd h\'e1t \'f5ket, hadd elegyedjenek [\'fcres fecseg\'e9sbe] \'e9s hadd sz\'f3rakozzanak [addig]}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 ,
}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154  am\'edg nem tal\'e1lkoznak azzal a nappal, amelyre \'edg\'e9retet kaptak!
\par 43. A napon, melyen sietve j\'f6nnek el\'f5 a s\'edrokb\'f3l, mint ahogyan [az evil\'e1gon] vonultak az \'e1ldozati k\'f6vekhez.
\par 44. Al\'e1zatos lesz a tekintet\'fck, \'e9s megal\'e1ztat\'e1s fogja \'f5ket bor\'edtani. Ez az a nap, amelyre \'edg\'e9retet kaptak!}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid1597387 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid8850473 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page 71. }{\b\insrsid10757626\charrsid15092154 No\'e9 (N\'fah) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 1. Bizony, elk\'fcldt\'fck No\'e9t a n\'e9p\'e9hez }{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 [parancsolv\'e1n], hogy: \'84}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 Intsd a n\'e9pedet, miel\'f5tt elj\'f6n hozz\'e1juk egy f\'e1jdalmas b\'fc
ntet\'e9s!}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 2. Azt mondta [No\'e9]: }{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'84}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 \'d3 n\'e9pem! \'c9n a ti nyilv\'e1nval\'f3 int\'f5t\'f6k vagyok,
\par 3. [Azzal] hogy Szolg\'e1lj\'e1tok Allahot, f\'e9lj\'e9tek \'d5t \'e9s engedelmeskedjetek nekem,
\par 4. Akkor megbocs\'e1t nektek b\'fbneitekb\'f5l \'e9s halad\'e9kot ad nektek egy megszabott hat\'e1rid\'f5ig. Bizony, ha elj\'f6n [az] Allah [\'e1ltal megszabott] hat\'e1rid\'f5, azt nem lehet [akkor m\'e1r] elhalasztani. B\'e1rcsak tudn\'e1tok!\'94
\par 
\par 5. Azt mondta [No\'e9]: }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'84}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 Uram! Bizony, h\'edvtam a n\'e9pemet \'e9jjel \'e9s nappal,
\par 6. \'c1m a h\'edv\'e1som csak n\'f6velte az elt\'e1volod\'e1sukat.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 7. \'c9s bizony, valah\'e1nyszor csak h\'edvtam \'f5ket, hogy megbocs\'e1ss nekik, ujjukat a f\'fcl\'fckbe dugt\'e1k, beburkol\'f3ztak a ruh\'e1jukba, \'e9s meg\'e1
talkodottak lettek [a b\'fbnben] \'e9s g\'f5g\'f6sen fennh\'e9j\'e1ztak.
\par 8. Azt\'e1n bizony, hangos sz\'f3val h\'edvtam \'f5ket,
\par 9. Majd bizony, [hol] ny\'edltan, \'e9s [hol pedig] titokban hirdettem nekik.
\par 10. \'c9s azt mondtam: 'K\'e9rjetek }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 megbocs\'e1t\'e1st}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154  az Uratokt\'f3l \endash  bizony, }{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'d5}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154  }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 mindig}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154  }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 Megbocs\'e1t\'f3!}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par 11. [Akkor] elk\'fcldi r\'e1tok az \'e9g [felh\'f5it] b\'f5s\'e9ges es\'f5z\'e9ssel,
\par 12. \'c9s gyarap\'edt titeket vagyonnal \'e9s gyermekekkel, \'e9s l\'e9trehoz nektek kerteket \'e9s foly\'f3kat.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \rquote \'94
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par 13. Mi lelt titeket, hogy nem adj\'e1tok meg Allahnak [az \'d5t megillet\'f5] nagyrabecs\'fcl\'e9st,
\par 14. Holott szakaszokban teremtett titeket?
\par 15. Vajon nem }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 gondolkodtatok el azon,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154  hogyan teremtett Allah h\'e9t eget egym\'e1s feletti szintekk\'e9
nt,
\par 16. \'c9s helyezte el benn\'fck a Holdat vil\'e1goss\'e1gk\'e9nt, \'e9s a Napot l\'e1mp\'e1sk\'e9nt?
\par 17. \'c9s Allah a f\'f6ldb\'f5l hozott l\'e9tre titeket, l\'e9trehoz\'e1ssal.
\par 18. Azt\'e1n visszat\'e9r\'edt titeket oda, \'e9s [majd] el\'f5hoz titeket [az \'cdt\'e9let napj\'e1n egy \'faj] el\'f5hoz\'e1ssal.
\par 19. \'c9s Allah kiter\'edtett [tart\'f3zkod\'e1si helly\'e9] tette sz\'e1motokra a f\'f6ldet,
\par 20. Hogy j\'e1rj\'e1tok annak t\'e1gas \'fatjait.
\par 
\par 21. Azt mondta No\'e9: }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'84}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 Uram! Bizony, \'f5k ellenszeg\'fcltek nekem \'e9s azt k\'f6vett\'e9
k, akinek a vagyona \'e9s a gyermekei csak n\'f6velt\'e9k vesztes\'e9g\'e9t.
\par 22. \'c9s hatalmas cselt sz\'f5ttek,
\par 23. \'c9s azt mondt\'e1k: 'Ne hagyj\'e1tok el isteneiteket! \'c9s ne hagyj\'e1tok el Vaddot, se Szuv\'e1t, se Jagh\'fatot, se Ja\'fakot, se Naszr-t!'
\par 24. \'c9s m\'e1r sokakat t\'e9velyg\'e9sbe vittek. \'c9s ne gyarap\'edtsd [\'f3 Allah] az igazs\'e1gtalanokat, csak t\'e9velyg\'e9sben!}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'94}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par 
\par 25. A v\'e9tkeik miatt v\'edzbe lettek fullasztva, \'e9s [a t\'falvil\'e1gi Pokol-]T\'fbzbe lettek l\'e9ptetve, \'e9s Allahon k\'edv\'fcl nem tal\'e1ltak maguknak seg\'edt\'f5kre.
\par 26. \'c9s No\'e9 azt mondta: }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'84}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 Uram! Ne hagyj a f\'f6ld\'f6n egyetlen \'e9l\'f5 hitetlent sem!
\par 27. Bizony, ha meghagyod \'f5ket, t\'e9velyg\'e9sbe viszik a szolg\'e1idat, \'e9s nem nemzenek csup\'e1n [f\'e9ktelen] gonoszt, megr\'f6gz\'f6tt hitetlent.
\par 28. Uram! Bocs\'e1ss meg nekem \'e9s a sz\'fcleimnek \'e9s annak, aki h\'edv\'f5k\'e9nt l\'e9pett a h\'e1zamba, \'e9s a h\'edv\'f5 f\'e9rfiaknak \'e9s a h\'edv\'f5 n\'f5knek! \'c9s ne gyarap\'edtsd az igazs\'e1gtalanokat csup\'e1n pusztul\'e1sban!}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page 72. }{\b\insrsid10757626\charrsid8850473 A }{\b\insrsid10757626\charrsid15092154 dzsinnek (al-Dzsinn) c. sz
\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par 1. Mondd [\'f3 Mohamed]: \'84Sugallatot kaptam, hogy egy csapat dzsinn hallgat\'f3zott [amint recit\'e1ltam a Kor\'e1nt] \'e9s azt mondt\'e1k: }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \rquote }{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 Bizony, mi egy csod\'e1latos Kor\'e1nt hallottunk,
\par 2. [Amely] a helyes \'fatra vezet, hisz\'fcnk h\'e1t benne \'e9s semmilyen t\'e1rsistent nem \'e1ll\'edtunk Urunk mell\'e9,
\par 3. \'c9s [hissz\'fck], hogy \'d5 - magasztaltass\'e9k a mi Urunk fens\'e9ge - nem vett maga mell\'e9 sem [h\'e1zas]t\'e1rsat, sem gyermeket.
\par 4. \'c9s egy ostoba k\'f6z\'fcl\'fcnk [az igazs\'e1gt\'f3l] t\'e1vol \'e1ll\'f3t mondott R\'f3la.
\par 5. \'c9s hogy mi \'fagy v\'e9lt\'fck: sem ember, sem dzsinn nem mondhat hazugs\'e1got Allahr\'f3l.
\par 6. \'c9s hogy voltak f\'e9rfiak az emberek k\'f6z\'fcl, akik mened\'e9ket kerestek dzsinnek k\'f6z\'fcl val\'f3 f\'e9rfiakn\'e1l, akik csak gyarap\'edtott\'e1k \'f5ket megal\'e1ztat\'e1sban.
\par 7. \'c9s hogy \'f5k [azok az emberek] is \'fagy v\'e9lt\'e9k, ahogyan ti v\'e9lt\'e9tek [\'f3 dzsinnek], hogy Allah senkit sem fog felt\'e1masztani.
\par 
\par 8. \'c9s bizony, hogy mi megpr\'f3b\'e1ltuk megk\'f6zel\'edteni az eget, \'e9s \'fagy tal\'e1ltuk, hogy tele van er\'f5s \'f5rz\'f5kkel \'e9s t\'fbzcs\'f3v\'e1kkal.
\par 9. \'c9s hogy mi azel\'f5tt ott \'fclt\'fcnk, a hallgat\'f3z\'e1sra [alkalmas] helyeken. Aki azonban most hallgat\'f3zik, az lesben \'e1ll\'f3 t\'fbzcs\'f3v\'e1val tal\'e1lja mag\'e1t szemben.
\par 10. \'c9s hogy mi [ez\'e9rt] nem tudjuk, hogy vajon rossz-e a sz\'e1nd\'e9k azokkal, akik a f\'f6ld\'f6n vannak, vagy pedig az Uruk a helyes utat akarja-e nekik.
\par 11. \'c9s hogy vannak k\'f6z\'f6tt\'fcnk j\'f3k \'e9s vannak olyanok, akik nem azok. K\'fcl\'f6nb\'f6z\'f5 utakat k\'f6vet\'f5 [csoportok] voltunk.
\par 12. \'c9s hogy mi azt v\'e9lt\'fck, hogy nem fogjuk [semmiben] megakad\'e1lyozni Allahot a f\'f6ld\'f6n, \'e9s nem fogjuk megakad\'e1lyozni [az \'e9g fel\'e9] menek\'fclve sem.
\par 13. \'c9s hogy miut\'e1n hallottuk az \'fatmutat\'e1st, hitt\'fcnk benne. Aki pedig hisz az Ur\'e1ban, annak nem kell f\'e9lnie sem vesztes\'e9gt\'f5l, sem megal\'e1ztat\'e1st\'f3l.
\par 
\par 14. \'c9s hogy vannak k\'f6zt\'fcnk, akik al\'e1vetik magukat [Allahnak], \'e9s vannak [az igaz \'fatr\'f3l] let\'e9r\'f5k. \'c9s akik al\'e1vetett\'e9k magukat [Allahnak], azok bizony a helyes \'fat fel\'e9 vett\'e9k \'fatjukat.
\par 15. \'c9s ami [az igaz \'fatr\'f3l] let\'e9r\'f5ket illeti, h\'e1t azok a Gyehenna t\'fczel\'f5i lesznek.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \rquote \'94}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par 16. \'c9s [mondd, \'f3 Mohamed, az lett kinyaltkoztatva nekem:] \'84Hogy ha az egyenes \'faton j\'e1rtak volna, akkor bizony b\'f5s\'e9ges v\'edzzel itattuk volna \'f5ket,
\par 17. Hogy azzal tegy\'fck pr\'f3b\'e1ra \'f5ket. \'c1m aki elfordul az Ur\'e1r\'f3l val\'f3 megeml\'e9kez\'e9st\'f5l, azt roskaszt\'f3 gy\'f6trelembe fogja vezetni.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'94
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par 18. \'c9s bizony, a mecsetek egyed\'fcl Allah\'e9 (az \'d5 szolg\'e1lat\'e1ra vannak), ne foh\'e1szkodjatok h\'e1t Allah mellett senkihez!}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 19. \'c9s bizony, amikor \'f5, Allah szolg\'e1ja (Mohamed pr\'f3f\'e9ta) fel\'e1llt, hogy foh\'e1szkodjon (im\'e1dkozzon) Hozz\'e1, [a dzsinnek] szinte t\'fclekedtek k\'f6r
\'fcl\'f6tte.
\par 20. Mondd [\'f3 Mohamed]: \'84\'c9n csakis az Uramhoz foh\'e1szkodom, \'e9s semmilyen t\'e1rsistent nem \'e1ll\'edtok \'d5mell\'e9.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'94
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 21. Mondd: \'84Bizony nekem nincs hatalmam sem k\'e1rt okozni nektek, sem helyes \'fatra [vezetni] titeket.}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'94
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 22. Mondd: \'84Engem bizony senki sem fog megv\'e9delmezni Allahhal szemben, \'e9s nem tal\'e1lok [majd] Rajta k\'edv\'fcl mened\'e9ket.
\par 23. [Azonban hatalmam van] }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'e1t}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 adni az Allaht\'f3l val\'f3 [igazs\'e1got] \'e9s az \'fczeneteit.}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 \'94 \'c1}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 m aki ellenszeg\'fcl Allahnak \'e9s a K\'fcld\'f6tt\'e9nek, azoknak bizony a Gyehenna t\'fcze j
\'e1r, \'e9s ott maradnak \'f6r\'f6kk\'f6n \'f6r\'f6kk\'e9.
\par 24. Amikor pedig megl\'e1tj\'e1k azt, amire \'edg\'e9retet kaptak, h\'e1t [majd akkor] megtudj\'e1k, hogy kinek van gyeng\'e9bb seg\'edt\'f5je \'e9s kevesebb sz\'e1m\'fa [serege]!}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 

\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 
\par 25. Mondd [\'f3 Mohamed]: \'84Nem tudom, hogy k\'f6zel van-e az, amire \'edg\'e9retet kaptatok, vagy az \'e9n Uram egy t\'e1volabbi [hat\'e1r-]id\'f5t jel\'f6l ki annak.\'94}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 26. [Allah] a rejtett dolgok ismer\'f5je, \'e1m [\'d5] nem t\'e1rja fel senkinek a rejtett dolgait - 
\par 27. Kiv\'e9ve annak a K\'fcld\'f6ttnek, akit [\'d5] kiv\'e1lasztott, akkor bizony \'f5rz\'f5ket helyez [a K\'fcld\'f6tt] el\'e9 \'e9s m\'f6g\'e9,}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15092154 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15092154 28. Az\'e9rt, hogy l\'e1that\'f3v\'e1 v\'e1ljon, hogy [m\'e1r] \'e1tadt\'e1k az Uruk \'fczeneteit. \'c9s [\'d5] \'e1tfogja [a tud\'e1s\'e1val] mindazt, ami n\'e1luk van, \'e9
s sz\'e1mba vesz minden dolgot sz\'e1m szerint.}{\f169\fs21\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid4262948 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page 73. }{\b\insrsid10757626\charrsid8850473 A }{\b\insrsid10757626\charrsid1537298 beburkol\'f3dz\'f3
 (al-Muzzammil) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1537298 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid1537298 .
\par 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1537298 1. \'d3, te beburkol\'f3dz\'f3!
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1537298 2. \'c1llj fel [im\'e1dkoz\'e1ssal t\'f6lteni] az \'e9jszaka [eg\'e9sz
\'e9t], kiv\'e9ve egy kis r\'e9szt,
\par 3. A fel\'e9t, vagy ann\'e1l egy kicsit kisebb r\'e9szt,
\par 4. }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid1537298 V}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1537298 agy ann\'e1l nagyobb r\'e9szt! \'c9s recit\'e1ld a Kor\'e1nt dallamos recit\'e1l\'e1ssal!
\par 5. Bizony, Mi s\'falyos besz\'e9det fogunk lebocs\'e1tani neked.
\par 6. Bizony, az \'e9jszaka kezd\'f5d\'f5 [im\'e1dkoz\'e1s] er\'f5sebb az \'f6sszhang, \'e9s hat\'e1sosabb a besz\'e9d tekintet\'e9ben.
\par 7. Bizony, neked nappal elny\'fal\'f3 elfoglalts\'e1gaid vannak.
\par 8. \'c9s eml\'e9kezz meg Urad nev\'e9r\'f5l \'e9s szenteld magad Neki teljes elk\'f6telezetts\'e9ggel (\'f5szinte) odaad\'e1ssal!
\par 9. [\'d5] a Kelet \'e9s a Nyugat Ura. Nincs m\'e1s [jogosan im\'e1dhat\'f3] }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid1537298  i}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1537298 sten rajta k\'edv\'fc
l. Tedd h\'e1t \'d5t v\'e9delmez\'f5dnek,
\par 10. \'c9s tan\'fas\'edts t\'fcrelmet azzal szemben, amit mondanak, \'e9s tartsd magad t\'e1vol t\'f5l\'fck sz\'e9p t\'e1vols\'e1gtart\'e1ssal!
\par 
\par 11. Hagyj h\'e1t engem \'e9s a meghazudtol\'f3kat, a j\'f3t\'e9tem\'e9nyekben r\'e9szes\'fclteket [egyed\'fcl], \'e9s adj nekik kev\'e9s halad\'e9kot!
\par 12. Bizony, b\'e9kly\'f3k \'e9s Pokol van N\'e1lunk,
\par 13. \'c9s olyan \'e9tel, ami a torkon akad \'e9s f\'e1jdalmas b\'fcntet\'e9s,
\par 14. Azon a napon, amikor a f\'f6ld \'e9s a hegyek megremegnek, \'e9s amikor a hegyek sz\'e9tporlad\'f3 homokd\'fbn\'e9kk\'e9 v\'e1lnak.
\par 15. Bizony, Mi elk\'fcldt\'fcnk hozz\'e1tok egy K\'fcld\'f6ttet, hogy tan\'fa legyen veletek szemben, ahogyan k\'fcld\'f6ttet k\'fcldt\'fcnk }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid1537298 a }{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1537298 F\'e1ra\'f3hoz is.
\par 16. A F\'e1ra\'f3 azonban ellenszeg\'fclt a K\'fcld\'f6ttnek, Mi pedig megragadtuk \'f5t s\'falyos megragad\'e1ssal.
\par 17. H\'e1t hogyan \'f3vhatn\'e1tok meg magatokat \endash  ha hitetlenek vagytok \endash  egy olyan napt\'f3l, amely \'f5ssz\'e9 teszi a gyermeket?
\par 18. Az \'e9g sz\'e9treped att\'f3l. Az \'d5 \'edg\'e9rete beteljesedik.
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1537298 19. Bizony, ez egy eml\'e9keztet\'f5, \'edgy aki [okulni] akar, az Ur
\'e1hoz veszi \'fatj\'e1t.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid1537298 
\par 20. Bizony, a te Urad tudja, hogy te \'e9s a veled tart\'f3k egy csoportja fel\'e1lltok [im\'e1dkoz\'e1ssal t\'f6lteni] az \'e9jszaka k\'f6zel k\'e9tharmad\'e1t, vagy a fel\'e9t, vagy a harmad\'e1t. \'c9s Allah szabja meg az \'e9jszaka \'e9s a nappal [m
\'e9rt\'e9k\'e9t]. [\'d5] tudja, hogy ti nem fogj\'e1tok tudni betartani [azt, hogy az eg\'e9sz \'e9jszak\'e1t v\'e9gig im\'e1dkozz\'e1tok, ez\'e9rt megk\'f6nny\'edtette nektek \'e9s] kiengesztel\'f5d\'f6tt ir\'e1ntatok. Recit\'e1ljatok h\'e1t a Kor\'e1nb
\'f3l annyit, ami k\'f6nny\'fb a sz\'e1motokra}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid1537298 !}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626  [\'d5] tudja, hogy vannak k\'f6z\'f6ttetek betegek, m\'e1sok pedig a f\'f6ldet j
\'e1rj\'e1k, hogy Allah kegy\'e9t keress\'e9k, \'e9s m\'e1sok pedig Allah \'fatj\'e1n harcolnak. Recit\'e1ljatok h\'e1t annyit bel\'f5le, ami k\'f6nny\'fb a sz\'e1motokra (nem esik nehezetekre)! \'c9s tarts\'e1tok meg az [el\'f5\'edrt] im\'e1dkoz\'e1
st, adj\'e1tok oda a k\'f6telez\'f5 adom\'e1nyt \'e9s adjatok Allahnak sz\'e9p k\'f6lcs\'f6nt }{\insrsid10757626\charrsid3307951 (ad}{\insrsid10757626 akozza}{\insrsid10757626\charrsid3307951 tok a k\'f6telez\'f5n fel\'fcl)}{
\lang255\langfe255\langnp255\langfenp255\insrsid10757626 ! \'c9s ami j\'f3t el\'f5rek\'fcldt\'f6k magatoknak, azt Allahn\'e1l jobb \'e9s nagyobb jutalomk\'e9nt fogj\'e1tok megtal\'e1lni. \'c9s }{\lang1038\langfe255\langfenp255\insrsid10757626 k\'e9rjetek}
{\lang255\langfe255\langnp255\langfenp255\insrsid10757626  }{\lang1038\langfe255\langfenp255\insrsid10757626 megbocs\'e1t\'e1st Allaht\'f3l}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626 ! Bizony, Allah Megbocs\'e1t\'f3, Irgalmas.
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page 74. }{\b\insrsid10757626\charrsid8850473 A betakar\'f3dz\'f3 (al-Muddasszir) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626 .}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid418821 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 1. \'d3, te betakar\'f3dz\'f3!
\par 2. \'c1llj fel \'e9s figyelmeztess!
\par 3. \'c9s magasztald h\'e1t az Urad [nagys\'e1g\'e1t]!
\par 4. \'c9s tiszt\'edtsd meg h\'e1t a ruh\'e1dat!
\par 5. \'c9s ker\'fcld h\'e1t a tiszt\'e1talans\'e1got!
\par 6. \'c9s ne h\'e1nytorgasd fel [a j\'f3tetteid], soknak tartva!
\par 7. \'c9s az Urad\'e9rt tan\'fas\'edts h\'e1t t\'fcrelmet!
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 8. \'c9s amikor megf\'favatik a k\'fcrt,
\par 9. H\'e1t az a nap egy neh\'e9z nap lesz,
\par 10. Nem lesz k\'f6nny\'fb a hitetleneknek.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 
\par 
\par 11. Hagyj engem azzal, akit egyed\'fcl teremtettem,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 12. \'c9s akinek b\'f5s\'e9ges vagyont adtam,
\par 13. \'c9s fi\'fagyermekeket, [akik] jelen vannak [k\'f6r\'fcl\'f6tte]!
\par 14. \'c9s elegyengetve k\'f6nny\'edtettem meg neki [minden utat].
\par 15. Azut\'e1n}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626  azt rem\'e9li}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 , hogy m\'e9g t\'f6bbet adjak [neki].
\par 16. De nem! Bizony, \'f5 makacsul szembesz\'e1llt a jeleinkkel (szavainkkal)!
\par 17. Kimer\'edt\'f5 [gy\'f6trelemmel] fogom \'f5t s\'fajtani.
\par 18. Bizony, \'f5 elgondolkodott \'e9s m\'e9rlegelt.
\par 19. \'c9s pusztuljon el az\'e9rt, ahogyan m\'e9rlegelt!
\par 20. \'c9s \'fajra pusztuljon el az\'e9rt, ahogyan m\'e9rlegelt!
\par 21. Azt\'e1n k\'f6r\'fcln\'e9zett,
\par 22. Majd \'f6sszer\'e1ncolta homlok\'e1t \'e9s elkomorodott.
\par 23. Azut\'e1n h\'e1tat ford\'edtott [az igazs\'e1gnak] \'e9s fennh\'e9j\'e1zott,
\par 24. \'c9s azt mondta: \'84Ez csak egy [a m\'faltb\'f3l] hagyom\'e1nyozott var\'e1zslat,
\par 25. Nem m\'e1s ez, mint emberi besz\'e9d.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 \'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 26. A Perzsel\'f5 [Pokol-]t\'fbzben fogom \'e9getni!
\par 
\par 27. \'c9s mi tudatn\'e1 veled, hogy mi a Perzsel\'f5 [Pokol-]t\'fbz?
\par 28. Nem hagy h\'e1tra, \'e9s nem hagy \'e9pen [semmit].
\par 29. Megperzsel\'f5je a b\'f5rnek.
\par 30. [\'d5rk\'f6dik] felette tizenkilenc [angyal].
\par 31. \'c9s nem tett\'fcnk meg [m\'e1sokat] a [Pokol-]t\'fbz \'f5rz\'f5iv\'e9, csakis angyalokat. \'c9s nem rendelt\'fck el a sz\'e1mukat csup\'e1n k\'eds\'e9rt\'e9sk\'e9nt, azok sz\'e1m\'e1ra, akik hitetlenn\'e1 v\'e1ltak, \'e9s az\'e9rt, hogy bizonys\'e1
got szerezzenek azok, akiknek az \'cdr\'e1s adatott, \'e9s hogy gyarapodjanak hit\'fckben azok, akik hisznek, \'e9s hogy ne t\'e1madjon k\'e9ts\'e9g azokban, akiknek az \'cdr\'e1s adatott \'e9s a h\'edv\'f5kben [sem], \'e9s az\'e9rt, hogy azt mondj\'e1
k azok, akiknek a sz\'edv\'e9ben betegs\'e9g van \'e9s a hitetlenek: \'84Mit akart Allah ezzel a p\'e9ld\'e1zattal?}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 \'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626  Ekk\'e9
ppen viszi Allah t\'e9velyg\'e9sbe azt, akit akar, \'e9s vezeti [az Igaz \'fatra] azt, akit akar. \'c9s nem ismeri [m\'e1s] az Urad seregeit csakis \'d5. \'c9s ez nem m\'e1s, mint eml\'e9keztet\'e9s az emberek sz\'e1m\'e1ra.
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 32. De nem! [Esk\'fcsz\'f6m] a Holdra!
\par 33. \'c9s az \'e9jszak\'e1ra, amint elfordult,
\par 34. \'c9s a reggelre, amikor pirkad!
\par 35. Bizony ez [a Pokol-t\'fbz] biztosan az egyik legsz\'f6rny\'fbbb [csap\'e1s],
\par 36. Figyelmeztet\'e9s\'fcl az embereknek,
\par 37. Annak, aki el\'f5re akar menni k\'f6z\'fcletek, vagy h\'e1tra akar maradni.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 38. Minden ember z\'e1loga annak, amire szert tett,
\par 39. Kiv\'e9ve a jobb k\'e9z fel\'f5lieket [akik kiv\'e1ltott\'e1k magukat a j\'f3tetteik \'e1ltal].
\par 40. [\'d5k] kertekben k\'e9rdezgetik majd egym\'e1st [a Paradicsomban],
\par 41. A gonosztev\'f5kr\'f5l,}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid5785117 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 42. [\'cdgy sz\'f3lv\'e1n azokhoz, amikor megl\'e1tj\'e1k \'f5ket]: \'84Mi juttatott benneteket a Perzsel\'f5 [Pokol-]t\'fbzbe?\'94
\par 43. Azok azt fogj\'e1k mondani: \'84Nem tartoztunk az im\'e1dkoz\'f3k k\'f6z\'e9,
\par 44. \'c9s nem adtunk enni a szeg\'e9nynek,
\par 45. \'c9s [egy\'fctt] fecsegt\'fcnk a fecseg\'f5kkel,
\par 46. \'c9s hazugs\'e1gnak tartottuk az \'cdt\'e9let Napj\'e1t,
\par 47. Am\'edg el nem j\'f6tt hozz\'e1nk a Bizonyoss\'e1g (a hal\'e1l).\'94
\par 48. \'c9s [akkor] nem haszn\'e1l [m\'e1r] nekik a k\'f6zbenj\'e1r\'f3k k\'f6zbenj\'e1r\'e1sa.
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 49. Mi lelte h\'e1t \'f5ket, hogy elfordulnak az Eml\'e9keztet\'e9st\'f5l?
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 50. Mintha megriadt vadszamarak lenn\'e9nek,
\par 51. [Amelyek] egy oroszl\'e1n el\'f5l menek\'fclnek.
\par 52. \'c1m k\'f6z\'fcl\'fck minden ember azt szeretn\'e9, hogy kiter\'edtett lapok [\'edr\'e1sok] adassanak neki [Allaht\'f3l].
\par 53. De nem! [\'d5k] nem f\'e9lik a t\'falvil\'e1got.
\par 54. Nem! Bizony [a Kor\'e1n] egy eml\'e9keztet\'f5.
\par 55. \'c9s aki akar, az megeml\'e9kezik r\'f3la.
\par 56. \'c1m csak akkor eml\'e9keznek meg, ha Allah \'fagy akarja. \'d5 a jogosult az istenf\'e9lelemre \'e9s \'d5 a jogosult a megbocs\'e1t\'e1sra.
\par }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid5785117 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page 75. }{\b\insrsid10757626\charrsid8850473 A Felt\'e1mad\'e1s (al-Kij\'e1ma) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626 .}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid5785117 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 1. Nem! Esk\'fcsz\'f6m a Felt\'e1mad\'e1s Napj\'e1ra!
\par 2. \'c9s nem! Esk\'fcsz\'f6m az \'f6nmag\'e1nak szemreh\'e1ny\'e1st t\'e9v\'f5 emberre!
\par 3. Azt gondolja-e az ember, hogy nem gy\'fbjtj\'fck \'f6ssze majd a csontjait?
\par 4. Dehogynem! [Mi] k\'e9pesek vagyunk arra, hogy helyre \'e1ll\'edtsuk az ujjbegyeit.
\par 5. De nem! Az ember [ennek ellen\'e9re] tov\'e1bbra is folytatni akarja gonosztetteit.
\par 6. Azt k\'e9rdi: \'84Mikor lesz a Felt\'e1mad\'e1s Napja?}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 \'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 7. H\'e1t amikor megriad a tekintet,
\par 8. \'c9s els\'f6t\'e9t\'fcl a Hold,
\par 9. \'c9s \'f6sszegy\'fbjtetik a Nap \'e9s a Hold,
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 10. Azon a napon azt mondja az ember: \'84Merre van a menekv\'e9s?}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626 \'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 11. De nem! Nincs mened\'e9k!
\par 12. Azon a napon az Uradn\'e1l lesz a nyugv\'f3hely.
\par 13. Azon a napon h\'edrt adnak az embernek arr\'f3l, hogy mit tett [az evil\'e1gon]}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 ,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626  \'e9s hogy mit mulasztott el.
\par 14. S\'f5t, az ember tan\'fa lesz \'f6nmag\'e1val szemben,
\par 15. M\'e9g ha el\'f5 is hozakodik a ments\'e9geivel.
\par 
\par 16. Ne mozgasd [\'f3 Mohamed] a nyelved ezzel (a Kor\'e1nnal) hogy siettesd [a megjegyz\'e9s\'e9t annak kinyilatkozat\'e1sakor]!
\par 17. Bizony r\'e1nk tartozik az \'f6sszegy\'fbjt\'e9se [az elm\'e9dben] \'e9s a recit\'e1l\'e1sa [a kinyilatkozat\'e1s\'e1t k\'f6vet\'f5en],
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 18. \'cdgy ha elrecit\'e1ltuk [G\'e1briel angyalon kereszt\'fcl], akkor k\'f6ve
sd annak recit\'e1l\'e1s\'e1t!
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 19 Azt\'e1n bizony R\'e1nk tartozik a vil\'e1goss\'e1 t\'e9tele.
\par 
\par 20. De nem! Ti a tovasiet\'f5 [evil\'e1gi \'e9lvezetet] szeretitek,
\par 21. \'c9s ott hagyj\'e1tok a t\'falvil\'e1gi [jutalmat].
\par 22. Azon a napon lesznek ragyog\'f3 arcok,
\par 23. [Amelyek] Urukra tekintenek,
\par 24. \'c9s azon a napon lesznek komor arcok,
\par 25. [Amelyek] \'fagy v\'e9lik, hogy gerincroppant\'f3 [csap\'e1s] fogja \'e9rni \'f5ket.
\par 
\par 26. De nem! Amikor [a l\'e9lek] a kulcscsonthoz \'e9rkezik}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid5785117 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 27. \'c9s azt mondj\'e1k [a k\'f6r\'fcl\'f6tte l\'e9v\'f5k]: \'84Ki tudn\'e1 [\'f5t] gy\'f3gy\'edtani?}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 \'94}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 28. \'c9s [a haldokl\'f3] \'fagy v\'e9li, hogy ez m\'e1r az elb\'facs\'faz\'e1s [ideje],
\par 29. \'c9s \'f6sszekapcsol\'f3dik [az evil\'e1g v\'e9g\'e9nek] a neh\'e9zs\'e9ge [a t\'falvil\'e1g elej\'e9nek] a neh\'e9zs\'e9g\'e9vel. 
\par 30. Azon a napon az Uradhoz lesz a menetel\'e9s.
\par 31. Hiszen [a hitetlen] nem tartotta igaznak [Mohamed k\'fcldet\'e9s\'e9t], \'e9s nem [is] im\'e1dkozott,
\par 32. Hanem meghazudtolta [a k\'fcldet\'e9st] \'e9s h\'e1tat ford\'edtott [a hitnek],
\par 33. }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 Azt\'e1n p\'f6ffeszked\'f5 l\'e9ptekkel ment [vissza] a h\'e1za n\'e9p\'e9hez.
\par 34. Jaj neked \'e9s jaj!
\par 35. Azt\'e1n jaj neked \'e9s jaj!
\par 
\par 36. Vajon azt gondolja az ember, hogy [sz\'e1monk\'e9r\'e9s n\'e9lk\'fcl] hagyatik, elhanyagolva?
\par 37. Nem volt-e \'f5 egy [megterm\'e9keny\'fclt] csepp egy kil\'f6vellt magb\'f3l?
\par 38. Azt\'e1n v\'e9rr\'f6g lett, majd [Allah] teremtette \'e9s megform\'e1lta [\'f5t],
\par 39. \'c9s p\'e1rt alkotott bel\'f5le: a h\'edmnem\'fbt \'e9s a n\'f5nem\'fbt.
\par 40. Vajon ne lenne-e k\'e9pes arra Az (a Teremt\'f5), hogy \'e9letre keltse a holtakat?
\par }\pard \qj \li0\ri0\widctlpar\tx3010\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid15287864 \page 76. Az ember (al-Insz\'e1n) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 .}{
\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 1. Vajon nem volt-e egy olyan id\'f5szaka az embernek, amikor nem volt m\'e9g egy eml\'edt\'e9sre m\'e9lt\'f3 dolog sem?
\par 2. Bizony, megteremtett\'fck az embert egy [megterm\'e9keny\'fclt] cseppb\'f5l, [amely] \'f6sszevegy\'fclt, hogy pr\'f3b\'e1ra tegy\'fck \'f5t, azt\'e1n hall\'e1st \'e9s l\'e1t\'e1st adtunk neki.
\par 3. Bizony, r\'e1vezett\'fck \'f5t az [egyenes] \'fatra, legyen ak\'e1r h\'e1l\'e1s (h\'edv\'f5) vagy h\'e1l\'e1tlan (hitetlen).
\par 4. Bizony, a hitetleneknek l\'e1ncokat, b\'e9kly\'f3kat \'e9s L\'e1ngol\'f3 [Pokol-t\'fczet] k\'e9sz\'edtett\'fcnk el\'f5.
\par 
\par 5. Bizony, a j\'f3s\'e1gosak olyan poh\'e1rb\'f3l isznak, amelyben k\'e1mfor van keverve [az italhoz],
\par 6. Olyan forr\'e1sb\'f3l [sz\'e1rmaz\'f3hoz], amelyb\'f5l Allah szolg\'e1i isznak, \'e9s amelyet ott fakasztanak, ahol csak akarj\'e1k.
\par 7. \'d5k [azok, akik] teljes\'edtik a fogadalmat \'e9s f\'e9lnek egy napt\'f3l, amelynek a veszedelme szerte\'e1rad\'f3 [lesz].
\par 8. \'c9s \'e9lelemmel t\'e1pl\'e1lnak \endash  [annak ellen\'e9re, hogy az] kedves nekik (sz\'fcks\'e9g\'fck van r\'e1) \endash  szeg\'e9nyt \'e9s \'e1rv\'e1t \'e9s foglyot,
\par 9. [Mondv\'e1n]: \'84}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 Csakis }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 Allah arc\'e1\'e9rt (el\'e9gedetts\'e9g\'e9\'e9
rt) adunk enni nektek. Nem akarunk t\'f5letek sem fizets\'e9get, sem h\'e1l\'e1t [sz\'f3beli k\'f6sz\'f6netet].
\par 10. Bizony, mi f\'e9l\'fcnk Urunk r\'e9sz\'e9r\'f5l egy homlokot r\'e1ncol\'f3 \'e9s les\'fajt\'f3 napt\'f3l.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 \'94}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 
\par 11. Allah pedig meg\'f3vta \'f5ket annak a napnak a veszedelm\'e9t\'f5l \'e9s [arcuknak] ragyog\'e1st \'e9s [sz\'edv\'fcknek] \'f6r\'f6m\'f6t adott,
\par 12. \'c9s kertet [a Paradicsomban] \'e9s selyem [-ruh\'e1kat] adott nekik fizets\'e9g\'fcl, ami\'e9rt t\'fcrelmesek voltak.
\par 13. Kerevetekre d\'f5lve fekszenek. Nem l\'e1tnak ott sem [forr\'f3s\'e1got ad\'f3] Napot, sem dermeszt\'f5 hideget.
\par 14. \'c9s [a Paradicsom] \'e1rny\'e9kai r\'e1juk hajolnak, \'e9s gy\'fcm\'f6lcsei m\'e9lyen al\'e1cs\'fcng\'f5ek.
\par 15. \'c9s ez\'fcst iv\'f3ed\'e9nyeket \'e9s [krist\'e1ly] \'fcvegkup\'e1kat hordanak k\'f6rbe k\'f6z\'f6tt\'fck,
\par 16. Ez\'fcstb\'f5l val\'f3 krist\'e1ly [}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 -}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 tiszta] ed\'e9nyeket, amelyeknek pontosan megszabt\'e1k a m\'e9
rt\'e9k\'fcket.
\par 17. \'c9s olyan poh\'e1r italt kapnak ott inni, amelybe [gy\'f6mb\'e9r] van keverve.
\par 18. }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 E}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 gy [olyan] forr\'e1sb\'f3l abban [a Paradicsomban], amelyet Szelszeb\'edlnek [k\'f6nnyed\'e9n foly
\'f3nak] h\'edvnak,
\par 19. \'c9s \'f6r\'f6kl\'e9t\'fb ifjak j\'e1rnak k\'f6rbe k\'f6z\'f6tt\'fck (a Paradicsom lak\'f3i k\'f6z\'f6tt), ha megl\'e1tn\'e1d [\'f5ket], sz\'e9thintett gy\'f6ngy\'f6knek v\'e9ln\'e9d \'f5ket.
\par 20. \'c9s ha sz\'e9tn\'e9zel ott, gy\'f6ny\'f6r\'fbs\'e9get \'e9s nagy birodalmat l\'e1tsz.
\par 21. Finom selyemb\'f5l \'e9s brok\'e1tb\'f3l k\'e9sz\'fclt z\'f6ld ruh\'e1kat viselnek majd \'e9s ez\'fcst kark\'f6t\'f5kkel lesznek \'e9kes\'edtve, \'e9s Uruk tiszta italt ad nekik inni.
\par 22. [Az lesz nekik mondva:] \'84Bizony, ez lett a ti fizets\'e9getek. \'c9s az igyekv\'e9setek meg lett h\'e1l\'e1lva.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 \'94}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 
\par 
\par 23. Bizony, Mi r\'e9szletenk\'e9nt lebocs\'e1tott [kinyilatkoztat\'e1sk\'e9nt] bocs\'e1tottuk le hozz\'e1d a Kor\'e1nt.
\par 24. V\'e1rj h\'e1t t\'fcrelemmel Urad d\'f6nt\'e9s\'e9re, \'e9s ne engedelmeskedj k\'f6z\'fcl\'fck egyetlen b\'fbn\'f6snek vagy hitetlennek [sem]!
\par 25. \'c9s eml\'e9kezz meg az Urad nev\'e9r\'f5l hajnalban \'e9s k\'e9s\'f5 d\'e9lut\'e1n,
\par 26. \'c9s az \'e9jszaka egy r\'e9sz\'e9ben borulj h\'e1t le El\'f5tte! \'c9s magasztald \'d5t \'e9jszaka hosszasan!
\par 
\par 27. Bizony, ezek a tovasiet\'f5 [evil\'e1gi \'e9lvezetet] szeretik \'e9s neh\'e9z napot hagynak maguk m\'f6g\'f6tt.
\par 28. Mi teremtett\'fck \'f5ket \'e9s er\'f5ss\'e9 [t\'f6k\'e9letess\'e9] tett\'fck a tart\'e1sukat. \'c9s ha akarjuk, hozz\'e1juk hasonl\'f3kkal cser\'e9lj\'fck fel \'f5ket.
\par 
\par 29. Bizony, ez eml\'e9keztet\'f5; \'e9s aki akarja, az Ur\'e1hoz veszi \'fatj\'e1t.
\par 30. \'c1m ti csak akkor akarhattok, ha Allah is \'fagy akarja. Bizony Allah Mindentud\'f3, B\'f6lcs.
\par 31. Azt bocs\'e1tja be a k\'f6ny\'f6r\'fclet\'e9be, akit akar. \'c9s f\'e1jdalmas gy\'f6trelmet k\'e9sz\'edtett el\'f5 az igazs\'e1gtalanoknak.}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page 77. }{\b\insrsid10757626\charrsid8850473 Az elk\'fcld\'f6ttek (al-Mu}{\b\insrsid10757626\charrsid15287864 
rszal\'e1t) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 
\par 1. Az egym\'e1s ut\'e1n elk\'fcld\'f6tt\'f6kre,
\par 2. \'c9s a viharosan tombol\'f3kra (szelekre),
\par 3. \'c9s [a felh\'f5ket] sz\'e9tsz\'f3r\'e1ssal sz\'e9tterjeszt\'f5kre,
\par 4. \'c9s az [igazs\'e1g \'e9s hamiss\'e1g k\'f6z\'f6tti] k\'fcl\'f6nbs\'e9gtev\'e9ssel sz\'e9tv\'e1laszt\'f3kra,
\par 5. \'c9s az Eml\'e9keztet\'f5t \'e1tad\'f3kra (angyalokra),
\par 6. Kifog\'e1sok c\'e1folatak\'e9nt vagy figyelmeztet\'e9sk\'e9nt!
\par 7. Bizony, amire \'edg\'e9retet kaptok, az bizonyosan bek\'f6vetkezik.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 8. \'c9s amikor a csillagok kioltatnak,
\par 9. \'c9s amikor az \'e9g meghasad,
\par 10. \'c9s amikor a hegyek porr\'e1 z\'fazatnak,
\par 11. \'c9s amikor a k\'fcld\'f6tteknek ki lesz jel\'f6lve az idej\'fck [az \'f6sszegy\'fbl\'e9sre \'e9s }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 a }{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 tan\'fas\'e1gt\'e9telre].
\par 12. Milyen napra lesz [ez] elhalasztva?
\par 13. A D\'f6nt\'e9s napj\'e1ra!
\par 14. \'c9s mi tudatn\'e1 veled, hogy mi a D\'f6nt\'e9s napja?
\par 15. Jaj [lesz] azon a napon a meghazudtol\'f3knak!
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 
\par 16. Nem puszt\'edtottuk-e el a hajdanvoltakat,
\par 17. Majd ut\'e1nuk k\'fcldt\'fck a k\'e9s\'f5bbiek [nemzed\'e9keit]?
\par 18. Ekk\'e9ppen tesz\'fcnk a gonosztev\'f5kkel.
\par 19. Jaj [lesz] azon a napon a meghazudtol\'f3knak!
\par 
\par 20. Nem teremtett\'fcnk-e titeket }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 megvetett}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864  v\'edzb\'f5l?
\par 21. Azt\'e1n egy biztos tart\'f3zkod\'e1s}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 i}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864  }{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 [}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 helyen}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 ]}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864  }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 (}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 az anyam\'e9hben}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 )}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864  helyezt\'fck el azt,
\par 22. Egy meghat\'e1rozott ideig.
\par 23. \'c9s Mi k\'e9pesek voltunk r\'e1! \'c9s mily nagyszer\'fb a k\'e9pess\'e9g\'fcnk!
\par 24. Jaj [lesz] azon a napon a meghazudtol\'f3knak!
\par 25. Nem tett\'fck-e a f\'f6ldet gy\'fbjt\'f5helly\'e9,
\par 26. \'c9l\'f5knek \'e9s holtaknak,
\par 27. \'c9s nem helyezt\'fcnk-e el [azon] szil\'e1rdan r\'f6gz\'edtett, magasba ny\'fal\'f3 (hegyeket), \'e9s itattunk titeket \'e9des v\'edzzel?
\par 28. Jaj [lesz] azon a napon a meghazudtol\'f3knak!
\par 
\par 29. [Az lesz nekik mondva:] \'84Induljatok ahhoz, amit hazugs\'e1gnak tartottatok!
\par 30. Induljatok egy h\'e1rom [f\'fcstoszlopra] \'e1gaz\'f3 \'e1rny\'e9khoz,
\par 31. [Amely] nem [ad h\'fbs] \'e1rny\'e9kot, se nem haszn\'e1l a l\'e1nggal szemben [sem]!}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 \'94
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 32. Bizony, az (a Pokol-t\'fbz) akkora szikr\'e1kat sz\'f3r, mint egy palota,
\par 33. Olyanokat, mintha s\'e1rga tev\'e9k [lenn\'e9nek].
\par 34. Jaj [lesz] azon a napon a meghazudtol\'f3knak!
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 35. Ez a nap [az], amikor nem fognak megsz\'f3lalni,
\par 36. \'c9s nem kapnak enged\'e9lyt arra [sem], hogy kifog\'e1sokkal j\'f6jjenek el\'f5.
\par 37. Jaj [lesz] azon a napon a meghazudtol\'f3knak!
\par 38. Ez a D\'f6nt\'e9s Napja. \'d6sszegy\'fbjt\'f6tt\'fcnk titeket \'e9s a hajdanvoltakat.
\par 39. Ha van fondorlatotok, h\'e1t sz\'f5jetek fondorlatot ellenem!
\par 40. Jaj [lesz] azon a napon a meghazudtol\'f3knak!
\par 
\par 41. Bizony, az istenf\'e9l\'f5k \'e1rny\'e9kokban \'e9s forr\'e1sok k\'f6z\'f6tt lesznek,
\par 42. \'c9s [olyan] gy\'fcm\'f6lcs\'f6ket [kapnak], amilyet csak k\'edv\'e1nnak.
\par 43. [Az lesz mondva nekik:] \'84Egyetek \'e9s igyatok eg\'e9szs\'e9ggel amiatt, amit cselekedtetek!\'94
\par }\pard\plain \s91\qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\kerning1\cgrid\langnp1038\langfenp1025 {
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 44. Bizony,}{\insrsid10757626\charrsid15287864 Mi ekk\'e9ppen adjuk meg a fizets\'e9g\'e9t a j\'f3tev\'f5knek.
\par }\pard\plain \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 \fs24\lang1038\langfe1025\cgrid\langnp1038\langfenp1025 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 
\par 45. Jaj [lesz] azon a napon a meghazudtol\'f3knak!
\par 46. [Az lesz mondva nekik:] \'84[Ti csak] egyetek \'e9s \'e9lvezz\'e9tek [az evil\'e1got] egy keveset! Bizony, gonosztev\'f5k vagytok!}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 \'94}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 
\par 47. Jaj [lesz] azon a napon a meghazudtol\'f3knak!
\par 48. \'c9s ha azt mondj\'e1k nekik: \'84Hajoljatok meg [im\'e1dkozva], akkor nem hajolnak meg!}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid15287864 \'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid15287864 
\par 49. Jaj [lesz] azon a napon a meghazudtol\'f3knak!
\par 50. H\'e1t mif\'e9le besz\'e9dben (kinyilatkoztat\'e1sban) fognak ezut\'e1n (a Kor\'e1n ut\'e1n) hinni?}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid11949620 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 78. A h\'edr (an-Naba) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 .}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid9202615 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 1. Mir\'f5l k\'e9rdezgetik egym\'e1st?
\par 2. A hatalmas h\'edrr\'f5l,
\par 3. Amir\'f5l \'f5k k\'fcl\'f6nb\'f6z\'f5 [v\'e9lem\'e9nyen] vannak.
\par 4. De nem! Majd meg fogj\'e1k tudni!
\par 5. M\'e9g egyszer nem! Majd meg fogj\'e1k tudni!
\par 
\par 6. Nem tett\'fck-e a f\'f6ldet fekhelly\'e9,
\par 7. \'c9s a hegyeket c\'f6l\'f6p\'f6kk\'e9?
\par 8. \'c9s p\'e1rokk\'e1 teremtett\'fcnk titeket,
\par 9. \'c9s az alv\'e1sotokat pihen\'e9ss\'e9 tett\'fck,
\par 10. \'c9s az \'e9jszak\'e1t \'f6lt\'f6z\'e9kk\'e9 tett\'fck,
\par 11. \'c9s a nappalt meg\'e9lhet\'e9ss\'e9 tett\'fck.
\par 12. \'c9s f\'f6l\'e9tek h\'e9t er\'f5s [\'e9gboltot] \'e9p\'edtett\'fcnk,
\par 13. \'c9s [a napot] f\'e9nyesen \'e9g\'f5 l\'e1mp\'e1ss\'e1 tett\'fck,
\par 14. \'c9s a felh\'f5kb\'f5l b\'f5s\'e9gesen \'f6ml\'f5 vizet bocs\'e1tottunk le,
\par 15. Hogy [gabona]szemeket \'e9s n\'f6v\'e9nyeket fakasszunk \'e1ltala,
\par 16. \'c9s egym\'e1sba fon\'f3d\'f3 [n\'f6v\'e9nyzet\'fb] kerteket.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 17. Bizony, a D\'f6nt\'e9s napj\'e1nak id\'f5pontja ki van jel\'f6lve.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 18. A nap, amelyen meg lesz f\'fajva a K\'fcrt, \'e9s el\'f5j\'f6tt\'f6k csoportokban!

\par 19. \'c9s megny\'edlik az \'e9g, \'e9s kapukk\'e1 v\'e1lik,
\par 20. \'c9s elmozd\'edttatnak a hegyek, \'e9s d\'e9lib\'e1bb\'e1 v\'e1lnak.
\par 
\par 21. Bizony, a Gyehenna lesben van,
\par 22. A t\'falkap\'e1sokra vetemed\'f5kre, [akik] oda t\'e9rnek meg.
\par 23. Hossz\'fa id\'f5k\'f6n \'e1t id\'f5znek ott.}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid9202615 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 24. Nem \'edzlelnek ott sem h\'fbv\'f6set, sem italt,
\par 25. Csak forr\'e1sban l\'e9v\'f5 vizet \'e9s gennyet,
\par 26. Meg\'e9rdemelt fizets\'e9gk\'e9nt.
\par 27. Bizony, \'f5k nem rem\'e9lt\'e9k az }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 elsz\'e1mol\'e1st,
\par 28. \'c9s meghazudtolt\'e1k a jeleinket teljes meghazudtol\'e1ssal,}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 29. \'c1m minden dolgot sz\'e1mba vett\'fcnk egy k\'f6nyvben.
\par 30. \'cdzlelj\'e9tek h\'e1t meg! Mert nem gyarap\'edtunk titeket m\'e1sban, csakis gy\'f6trelemben.
\par 
\par 31. Bizony, az istenf\'e9l\'f5knek a diadal helye j\'e1r,
\par 32. Kertek \'e9s sz\'f5l\'f5k,
\par 33. \'c9s azonos kor\'fa fiatal asszonyok,
\par 34. \'c9s sz\'edn\'fcltig teli poh\'e1r.
\par 35. Nem hallanak majd ott felesleges besz\'e9det, \'e9s hazudoz\'e1st [sem],
\par 36. Fizets\'e9gk\'e9ppen az Uradt\'f3l, b\'f5s\'e9ges aj\'e1nd\'e9kk\'e9nt elsz\'e1mol\'e1s [alapj\'e1n],
\par 37. [Fizets\'e9g\'fcl T\'f5le, aki] az Ura az egeknek \'e9s a f\'f6ldnek, \'e9s ami a kett\'f5 k\'f6z\'f6tt van, a K\'f6ny\'f6r\'fcletest\'f5l. Nem \'e1ll [majd] m\'f3djukban megsz\'f3lalni az \'d5 [enged\'e9lye] n\'e9lk\'fcl,}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 38. Azon a napon, amikor a l\'e9lek (G\'e1briel) \'e9s az angyalok sorban \'e1llnak, nem besz\'e9lnek, csak az, akinek a K\'f6ny\'f6r\'fcletes enged\'e9lyt adott \'e9
s azt mondja, ami helyes.
\par 39. Ez az Igazs\'e1g napja, \'e9s aki akarja, az Ur\'e1hoz t\'e9r meg.
\par 40. Bizony, Mi egy k\'f6zeli b\'fcntet\'e9sre figyelmeztet\'fcnk titeket, [amely] egy [olyan] napon [fog bek\'f6vetkezni], amikor az ember megl\'e1tja, hogy mit k\'fcld\'f6tt el\'f5re a keze [a tettekb\'f5l], \'e9s a hitetlen azt mondja: }{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 \'84}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 \'d3, b\'e1rcsak por lenn\'e9k!}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 
\'94}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 
\par \page }{\b\insrsid10757626\charrsid9257603 79. A }{\b\insrsid10757626\charrsid16085953 kiszak\'edt\'f3k (an-N\'e1zi\'e1t) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 
\par 1. Az er\'f5vel kiszak\'edt\'f3kra, 
\par 2. \'c9s a k\'f6nnyed\'e9n kiemel\'f5kre,
\par 3. \'c9s a [gyorsan] sikl\'f3 \'fasz\'f3kra,
\par 4. \'c9s az [egym\'e1st] t\'falsz\'e1rnyalva megel\'f5z\'f5kre,
\par 5. \'c9s a [minden] \'fcgyet elrendez\'f5kre!
\par 
\par 6. Azon a napon, [melyen az els\'f5 k\'fcrtf\'faj\'e1sn\'e1l] megreng a reng\'f5 (a f\'f6ld),
\par 7. Amelyet k\'f6vet a k\'f6vetkez\'f5 [k\'fcrtf\'faj\'e1s],
\par 8. [Egyes] sz\'edvek [a f\'e9lelem miatt] azon a napon hevesen fognak dobogni,
\par 9. A tekintet\'fck al\'e1zatos [lesz].
\par 10. Azt mondj\'e1k: \'84Vajon bizony a kor\'e1bbi (\'e9l\'f5) \'e1llapotba vitet\'fcnk vissza,
\par 11. Akkor is, ha [m\'e1r] sz\'e9tm\'e1llott csontok lett\'fcnk?}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 \'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 
\par 12. Azt mondj\'e1k: \'84Az akkor egy vesztes\'e9ges visszat\'e9r\'e9s lesz!\'94
\par 13. \'c1m csup\'e1n egyetlen ki\'e1lt\'e1s lesz,
\par 14. \'c9s \'edme, \'f5k a f\'f6ld felsz\'edn\'e9n lesznek.
\par 
\par 15. Vajon eljutott hozz\'e1d az elbesz\'e9l\'e9s M\'f3zesr\'f5l,
\par 16. Amikor az Ura a megszentelt v\'f6lgyben, Tuv\'e1ban sz\'f3l\'edtotta \'f5t?
\par 17. [Azt parancsolta neki:] \'84Menj el a F\'e1ra\'f3hoz! Bizony, \'f5 t\'falkap\'e1sokra vetemedett,
\par 18. S mondd: 'Hajlasz-e arra, hogy megtiszt\'edtsd magad?
\par 19. \'c9s szeretn\'e9d-e, hogy az Uradhoz vezesselek t\'e9ged, [hogy] f\'e9ld [\'d5t]?'\'94
\par 20. \'c9s megmutatta neki a legnagyobb jelet.
\par 21. \'c1m [a F\'e1ra\'f3] meghazudtolta \'e9s ellenszeg\'fclt,
\par 22. \'c9s elfordult [gonoszs\'e1gra] t\'f6rekedve,
\par 23. Azt\'e1n \'f6sszegy\'fbjt\'f6tte [}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 az }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 alattval\'f3it] \'e9s sz\'f3l\'edtotta [\'f5ket],
\par 24. \'c9s azt mondta: \'84\'c9n vagyok a legmagass\'e1gosabb uratok!\'94
\par 25. Allah pedig a t\'falvil\'e1g \'e9s az evil\'e1g elrettent\'f5 b\'fcntet\'e9s\'e9vel elragadta \'f5t.
\par 26. Bizony, ebben tanuls\'e1g van annak, aki f\'e9li [az Ur\'e1t].
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\nooverflow\aspnum\faroman\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 
\par 27. Vajon a ti megteremt\'e9setek volt-e nehezebb, vagy az \'c9g\'e9, amit [\'d5] \'e9p\'edtett? 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 28. F\'f6lemelte a boltozat\'e1t \'e9s megform\'e1lta,
\par 29. \'c9s s\'f6t\'e9tt\'e9 tette az \'e9jszak\'e1j\'e1t \'e9s el\'f5hozta [nappal\'e1nak] f\'e9nyess\'e9g\'e9t,
\par 30. \'c9s ezut\'e1n kiter\'edtette a f\'f6ldet,
\par 31. El\'f5hozta bel\'f5le a viz\'e9t \'e9s a legel\'f5j\'e9t,
\par 32. \'c9s szil\'e1rdan r\'f6gz\'edtette a hegyeket,
\par 33. [Mindezt] ell\'e1t\'e1sul nektek \'e9s a j\'f3sz\'e1gaitoknak.
\par 
\par 34. \'c9s amikor elj\'f6n a Nagy Csap\'e1s,
\par 35. Azon a napon, az ember visszaeml\'e9kezik arra, amire igyekezett.
\par 36. \'c9s a Pokol pedig l\'e1that\'f3v\'e1 t\'e9tetik annak, aki l\'e1t.
\par 37. Akkor annak, aki t\'falkap\'e1sokra vetemedett,
\par 38. \'c9s el\'f5nyben r\'e9szes\'edtette az evil\'e1gi \'e9letet,
\par 39. H\'e1t bizony a Pokol [lesz] a hajl\'e9ka.
\par 40. Annak pedig, aki f\'e9lt att\'f3l, hogy az Ura el\'e9 kell \'e1llnia [az elsz\'e1moltat\'e1sra az \'cdt\'e9let napj\'e1n] \'e9s visszatartotta mag\'e1t a k\'e9nyt\'f5l,
\par 41. H\'e1t bizony a Paradicsom [lesz] a hajl\'e9ka.
\par 
\par 42. K\'e9rdeznek t\'e9ged }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 [\'f3 Mohamed] }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 az \'d3r\'e1r\'f3l: }{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 \'84}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 Mikor lesz az el\'e9rkez\'e9se?}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 
\'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 
\par 43. Hol vagy te att\'f3l, hogy b\'e1rmit [is] mondhass arr\'f3l!
\par 44. Az Uradra tartozik annak a beteljes\'edt\'e9se.
\par 45. Te csup\'e1n egy int\'f5 vagy annak, aki f\'e9li azt.
\par 46. Azon a napon, amikor megl\'e1tj\'e1k azt, olyan lesz nekik, mint ha nem id\'f5ztek volna [az evil\'e1gon], csup\'e1n egy est\'e9t vagy egy }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 [nap] }{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 d\'e9lel\'f5ttj\'e9t.}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 
\par 
\par }\pard \qc \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 80. \'d6sszer\'e1ncolta }{\b\insrsid10757626\charrsid16085953 homlok
\'e1t (Abasza) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{
\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 
\par 1. [Mohamed] \'f6sszer\'e1ncolta a homlok\'e1t \'e9s h\'e1tat ford\'edtott,
\par 2. [amiatt,] hogy elj\'f6tt hozz\'e1 a vak [hogy k\'e9rdezzen].
\par 3. \'c9s honnan tudn\'e1d? Tal\'e1n megtiszt\'edtja mag\'e1t [a b\'fbn\'f6kt\'f5l],
\par 4. Vagy eml\'e9keztet\'e9st kap, \'e9s haszn\'e1ra v\'e1lik az eml\'e9keztet\'e9s.
\par 5. Aki \'fagy gondolja, hogy nincs sz}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 \'fc}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 ks\'e9ge [az int\'e9sre],
\par 6. H\'e1t annak te figyelmet szentelsz.
\par 7. \'c9s nem t\'e9ged terhel, ha \'f5 nem tiszt\'edtja mag\'e1t.
\par 8. Aki viszont igyekezve j\'f6n hozz\'e1d,
\par 9. \'c9s \'f5 f\'e9li [az Ur\'e1t],
\par 10. H\'e1t att\'f3l te elvonod a figyelmet.
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 11. De nem! Bizony, ez egy eml\'e9keztet\'f5,
\par 12. S aki akarja, okulni fog bel\'f5le,
\par 13. [Amely olyan] lapokon [van r\'f6gz\'edtve], amelyek tiszteletrem\'e9lt\'f3k,
\par 14. Emelkedettek \'e9s megtiszt\'edtottak,
\par 15. Olyan [angyal-]\'edrnokok kez\'e9ben,
\par 16. [}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 A}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 kik] nemesek, j\'f3s\'e1gosak.
\par 
\par 17. Pusztuljon az ember! Milyen hitetlen!
\par 18. Mib\'f5l teremtette \'f5t [Allah]?
\par 19. [Megterm\'e9keny\'fclt] cseppb\'f5l teremtette \'e9s [szakaszokban] szabta meg a m\'e9rt\'e9k\'e9t.
\par 20. Azut\'e1n k\'f6nny\'fbv\'e9 tette [a j\'f3 \'e9s a rossz megismer\'e9s\'e9nek] \'fatj\'e1t.
\par 21. Majd a hal\'e1lba bocs\'e1tja, \'e9s a s\'edrba helyezteti \'f5t.
\par 22. Azut\'e1n - amikor akarja - felt\'e1masztja \'f5t.
\par 23. De nem! [Az ember] nem teljes\'edtette azt, amit [Allah] parancsolt neki.
\par 
\par 24. N\'e9zzen h\'e1t az ember a t\'e1pl\'e1l\'e9k\'e1ra!
\par 25. Mi bizony b\'f5s\'e9gesen z\'fad\'edtottuk le az es\'f5vizet,
\par 26. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid16085953 A}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 zut\'e1n felhas\'edtottuk a f\'f6ldet hasad\'e9kokkal,
\par 27. \'c9s [gabona-]szemet sarjasztottunk benne,
\par 28. \'c9s sz\'f5l\'f5t \'e9s takarm\'e1nyn\'f6v\'e9nyeket,
\par 29. \'c9s olajf\'e1t \'e9s datolya-p\'e1lm\'e1t,
\par 30. \'c9s s\'fbr\'fb n\'f6v\'e9nyzet\'fb kerteket,
\par 31. \'c9s gy\'fcm\'f6lcs\'f6ket \'e9s legel\'f5t,
\par 32. [Mindezt] ell\'e1t\'e1sul nektek \'e9s a j\'f3sz\'e1gaitoknak.
\par 
\par 33. \'c9s amikor elj\'f6n a F\'fclsiket\'edt\'f5 Ki\'e1lt\'e1s!
\par 34. Azon a napon, az ember elmenek\'fcl a fiv\'e9r\'e9t\'f5l,
\par 35. \'c9s az anyj\'e1t\'f3l \'e9s az apj\'e1t\'f3l
\par 36. \'c9s a feles\'e9g\'e9t\'f5l \'e9s a gyermekeit\'f5l.
\par 37. Mindenkinek k\'f6z\'fcl\'fck azon a napon [olyan] \'fcgye [lesz], ami lefoglalja \'f5t.
\par 38. Azon a napon lesznek ragyog\'f3 arcok,
\par 39. Nevet\'f5k, \'f6rvendez\'f5k,
\par 40. \'c9s lesznek azon a napon olyan arcok [is], amelyeket por takar,
\par 41. [\'c9s amelyeket] s\'f6t\'e9ts\'e9g bor\'edt.
\par 42. Azok bizony a }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626  megr\'f6gz\'f6tt }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid16085953 hitetlenek [\'e9s] a f\'e9ktelen gonoszok [arcai].
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 81. A }{\b\insrsid10757626\charrsid10944933 felg\'f6ngy\'f6l\'edt\'e9
s (at-Taku\'edr) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid10944933 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 
\par 1. Amikor a Nap felg\'f6ngy\'f6l\'edttetik,
\par 2. \'c9s amikor a csillagok lezuhannak,
\par 3. \'c9s amikor a hegyek elmozd\'edttatnak,
\par 4. \'c9s amikor a vemhes n\'f5st\'e9nytev\'e9ket elhanyagolj\'e1k,
\par 5. \'c9s amikor a vad\'e1llatok \'f6sszegy\'fbjtetnek,
\par 6. \'c9s amikor a tengerek l\'e1ngra lobbantatnak,
\par 7. \'c9s amikor az emberek [a hozz\'e1juk hasonl\'f3kkal] csoportos\'edttatnak,
\par 8. \'c9s amikor az \'e9lve eltemetett [gyermek]l\'e1nyt megk\'e9rdezik,
\par 9. [Hogy] milyen b\'fbn\'e9rt \'f6letett meg,
\par 10. \'c9s amikor a [tettek feljegyz\'e9s\'e9t tartalmaz\'f3] lapok kiter\'edttetnek,
\par 11. \'c9s amikor az \'e9g lecsupasz\'edttatik,
\par 12. \'c9s amikor a Pokol [t\'fcze] fellobbantatik,
\par 13. \'c9s amikor a Paradicsom k\'f6zel hozatik [a h\'edv\'f5kh\'f6z],
\par 14. [Akkor] megtudja [minden] ember, hogy milyen [tetteket] hozott [mag\'e1val].
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 
\par 15. De nem! Esk\'fcsz\'f6m az elt\'fbn\'f5 [\'e9gitestekre],
\par 16. A [p\'e1ly\'e1jukon] fut\'f3kra, a rejt\'f5zk\'f6d\'f5kre,
\par 17. \'c9s az \'e9jszak\'e1ra, amikor el\'e9rkezik a s\'f6t\'e9ts\'e9ge,
\par 18. \'c9s a reggelre, amikor elj\'f6n a vil\'e1goss\'e1ga!
\par 19. Bizony, ez egy nemes k\'fcld\'f6tt [G\'e1briel angyal] szava,
\par 20. [Az] er\'f5vel b\'edr\'f3\'e9, a Tr\'f3nus Birtokos\'e1n\'e1l [magas] rangot visel\'f5\'e9,
\par 21. [Akinek] engedelmeskednek [az angyalok] ott, [aki] megb\'edzhat\'f3.
\par 22. A t\'e1rsatok [Mohamed] pedig nem egy \'f5r\'fclt.
\par 23. \'c9s bizony m\'e1r l\'e1tta \'f5t [G\'e1briel angyalt] a vil\'e1gos l\'e1t\'f3hat\'e1ron.
\par 24. \'c9s \'f5 (Mohamed) nem fukarkodik [\'e1tadni] a rejtettet [a kinyilatkoztat\'e1st].
\par 25. \'c9s ez [a Kor\'e1n] nem egy kitasz\'edtott s\'e1t\'e1n szava!
\par 
\par 26. Mely utat k\'f6vetitek h\'e1t [a Kor\'e1nt illet\'f5en]?
\par 27. Ez csup\'e1n eml\'e9keztet\'f5 a teremtm\'e9nyeknek \endash  
\par 28. Annak, aki k\'f6z\'fcletek az egyenes \'faton akar j\'e1rni.
\par 29. \'c1m ti csak akkor akarhattok, ha Allah, a teremtm\'e9nyek Ura [is \'fagy] akarja.}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 82. A }{\b\insrsid10757626\charrsid10944933 sz\'e9treped\'e9
s (al-Infitar) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid10944933 .
\par 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 1. Amikor az \'e9g sz\'e9treped,}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid10944933 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 2. \'c9s amikor a bolyg\'f3k sz\'e9tsz\'f3r\'f3dnak,
\par 3. \'c9s amikor a tengerek felrobbantatnak,
\par 4. \'c9s amikor a s\'edrok kiforgattatnak,
\par 5. [Akkor] megtudja [minden] ember, hogy mit k\'fcld\'f6tt el\'f5re [az evil\'e1gi tetteivel a t\'falvil\'e1gra] \'e9s mit mulasztott el.
\par 
\par 6. \'d3 ember! Mi t\'e9vesztett meg t\'e9ged a B\'f5kez\'fb Uradat illet\'f5en?
\par 7. Aki teremtett, megform\'e1lt \'e9s ar\'e1nyoss\'e1 tett t\'e9ged,
\par 8. Olyan alakban \'e1ll\'edtott \'f6ssze t\'e9ged, amilyenben akart.
\par 
\par 9. De nem! Ti hazugs\'e1gnak tartj\'e1tok az \'cdt\'e9let [napj\'e1t].
\par 10. \'c9s bizony, \'f5rz\'f5 [angyalok] vannak f\'f6l\'f6ttetek,
\par 11. [}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid10944933 A}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 kik] nemesek \'e9s [a tetteiteket] feljegyz\'f5k,
\par 12. Tudj\'e1k, hogy mit tesztek.
\par 
\par 13. Bizony a j\'f3s\'e1gosak gy\'f6ny\'f6r\'fbs\'e9gben lesznek [a Paradicsomban].
\par 14. \'c9s bizony a [f\'e9ktelen] gonoszok a Pokolban lesznek,
\par 15. Ott fognak \'e9gni az \'cdt\'e9let napj\'e1n,
\par 16. \'c9s \'f5k onnan nem t\'e1vozhatnak.
\par 17. \'c9s mi tudatn\'e1 veled, hogy mi az \'cdt\'e9let napja?
\par 18. Azut\'e1n mi }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 [is] }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 tudatn\'e1 veled, hogy mi az \'cdt\'e9let napja?
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 19. [Az a] nap, amelyen egyetlen ember sem tehet semmit egy m\'e1sik ember\'e9rt, \'e9s az \'f6sszes \'fcgy [eld\'f6nt\'e9se] azon a napon}{
\lang255\langfe255\langnp255\langfenp255\insrsid10757626  [egyed\'fcl] Allahra tartozik}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid10944933 .}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 83. A }{\b\insrsid10757626\charrsid3224126 hamisan m\'e9r\'f5
k (al-Mutaffif\'edn) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 .
\par 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 1. Jaj a hamisan m\'e9r\'f5knek!
\par 2. Akik, ha kim\'e9retnek maguknak az emberekkel, akkor teljes [m\'e9rt\'e9ket] k\'f6vetelnek.
\par 3. \'c1m, ha \'f5k m\'e9rnek ki m\'e1soknak vagy s\'falyt haszn\'e1lnak, akkor k\'e1ros\'edtanak.
\par 4. Nem gondolnak-e \'f5k arra, hogy fel lesznek t\'e1masztva
\par 5. egy hatalmas napra?
\par 6. [Arra] a napra, amikor az emberek a teremtm\'e9nyek Ura el\'e9 \'e1llnak [az elsz\'e1mol\'e1sra].
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par 7. De nem! Bizony, a [f\'e9ktelen] gonosz}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 o}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 k k\'f6nyve a Sz\'fbk\'f6ss\'e9g hely\'e9n van (oda vezet).
\par 8 \'c9s mi tudatn\'e1 veled, hogy mi a Sz\'fbk\'f6ss\'e9g helye?
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 9. Egy\'e9rtelm\'fben meg\'edrt k\'f6nyv [a gonoszok k\'f6nyve].
\par 10. Azon a napon jaj a meghazudtol\'f3knak,
\par 11. Akik hazugs\'e1gnak tartj\'e1k az \'cdt\'e9let Napj\'e1t!
\par 12. \'c9s nem tartja hazugs\'e1gnak azt, csakis minden hat\'e1rokat \'e1th\'e1g\'f3, sok b\'fbnt elk\'f6vet\'f5.
\par 13. Amikor recit\'e1ltatnak neki a jeleink, azt mondja: \'84[Ezek] a hajdan voltak legend\'e1i.\'94
\par 14. De nem! [Ez az\'e9rt van \'edgy,] mert befedte a sz\'edv\'fcket [mindaz a gonoszs\'e1g], amit}{\insrsid10757626\charrsid3224126  szereztek (elk\'f6vettek)}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 15. Nem! Azon a napon bizony \'f5k el lesznek v\'e1lasztva az Urukt\'f3l.
\par 16. Azut\'e1n \'f5k bizony a Pokolban lesznek \'e9getve.
\par 17. Azt\'e1n azt mondj\'e1k majd [nekik]: \'84Ez az, amit hazugs\'e1gnak tartottatok.\'94
\par 
\par 18. De nem! Bizony a j\'f3s\'e1gosak k\'f6nyve a Magas helyen lesz (oda vezet).
\par 19. \'c9s mi tudatn\'e1 veled, hogy mi az a Magas hely?
\par 20. Egy\'e9rtelm\'fben meg\'edrt k\'f6nyv}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126  }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 [a j\'f3s\'e1gosak k\'f6nyve].
\par 21. Tan\'fas\'edtj\'e1k azt az [Allahhoz] k\'f6zel\'e1ll\'f3 [angyalok].
\par 22. Bizony, a j\'f3s\'e1gosak gy\'f6ny\'f6r\'fbs\'e9gben lesznek [a Paradicsomban],
\par 23. A kerevetekre [d\'f5lve] n\'e9zel\'f5dnek.
\par 24. Az arcukon felismerheted a gy\'f6ny\'f6r\'fbs\'e9g ragyog\'e1s\'e1t.
\par 25. Lepecs\'e9telt sz\'ednborb\'f3l \'f6ntenek nekik,
\par 26. Amelynek m\'f3susz a pecs\'e9tje. H\'e1t ev\'e9gett vet\'e9lkedjenek a vet\'e9lked\'f5k!
\par 27. \'c9s a hozz\'e1 kevert [ital] a Teszn\'edmb\'f5l [Magasan fekv\'f5 forr\'e1sb\'f3l] val\'f3,
\par 28. [Ami] egy olyan forr\'e1s, amelyb\'f5l a k\'f6zel\'e1ll\'f3k isznak.
\par 
\par 29. Bizony, akik gonosztetteket k\'f6vettek el, [mindig] nevettek a h\'edv\'f5k\'f6n.
\par 30. Amikor pedig elhaladtak mellett\'fck, \'f6sszekacsintottak.
\par 31. \'c9s amikor visszat\'e9rtek a h\'e1zuk n\'e9p\'e9hez, g\'fanyosan tr\'e9f\'e1lkozva t\'e9rtek vissza.
\par 32. \'c9s ha megl\'e1tt\'e1k \'f5ket, azt mondt\'e1k: \'84Bizony, ezek t\'e9velyg\'f5k!}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 \'94}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par 33. \'c1m nem k\'fcldettek f\'f6l\'e9j\'fck \'f5rz\'f5knek.
\par 34. Ma azonban azok, akik hisznek [Allah egyed\'fclval\'f3s\'e1g\'e1ban \'e9s Mohamed k\'fcldet\'e9s\'e9ben] nevetnek a hitetleneken.
\par 35. A kerevetekre [d\'f5lve] n\'e9zel\'f5dnek.
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 36. Vajon megkapt\'e1k-e a [m\'e9lt\'f3}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 ] jutalmukat a hitetlenek az\'e9rt, amit cselekedtek?
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 84. A sz\'e9thasad\'e1s (al}{\b\insrsid10757626\charrsid3224126 
-Insikak) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{
\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par 1. Amikor az \'e9g sz\'e9thasad,
\par 2. \'c9s hallgat az Ur\'e1ra \'e9s ezt kell tennie.
\par 3. \'c9s amikor a f\'f6ld kiter\'edttetik,
\par 4. \'c9s kiveti mindazt, ami benne van \'e9s ki\'fcr\'fcl,
\par 5. \'c9s hallgat az Ur\'e1ra \'e9s ezt kell tennie.
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par 6. \'d3, te ember! Bizony f\'e1radozva igyekszel Uradhoz, azt\'e1n tal\'e1lkozni fogsz Vele.
\par 7. \'c9s akinek a [tetteinek] feljegyz\'e9se a jobbj\'e1ba adatik,
\par 8. H\'e1t az k\'f6nny\'fb elsz\'e1moltat\'e1ssal lesz elsz\'e1moltatva,
\par 9. \'c9s a h\'e1za n\'e9p\'e9hez \'f6rvendezve t\'e9r haza.
\par 10. \'c1m akinek a [tetteinek] feljegyz\'e9se a h\'e1ta m\'f6g\'e9 adatik [a bal kez\'e9be],
\par 11. H\'e1t az pusztul\'e1s\'e9rt fog ki\'e1ltani,
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 12. \'c9s a L\'e1ngol\'f3 [Pokol-t\'fbzben] fog \'e9gni.
\par 13. Bizony, a h\'e1za n\'e9pe k\'f6z\'f6tt \'f6rvendezett [nem t\'f6r\'f5dve a t\'falvil\'e1gi \'e9lettel].
\par 14. Bizony, \'f5 \'fagy v\'e9lte, hogy nem fog [Ur\'e1hoz] visszat\'e9rni.
\par 15. Dehogynem! Bizony, az Ura \'e1tl\'e1tta \'f5t.
\par 
\par 16. H\'e1t nem! Esk\'fcsz\'f6m az alkonyp\'edrra,
\par 17. \'c9s az \'e9jszak\'e1ra \'e9s mindarra, amit egybeterel,
\par 18. \'c9s a Holdra, amikor kiteljesedik!
\par 19. Bizonyosan, egyik szakaszb\'f3l egy m\'e1sik szakaszba ker\'fclt\'f6k.
\par 20. Mi lelte h\'e1t \'f5ket, hogy nem hisznek,
\par 21. \'c9s amikor recit\'e1ltatik nekik a Kor\'e1n, nem borulnak le?
\par 22. Ellenkez\'f5leg! Azok, akik hitetlenek, meghazudtol\'e1st k\'f6vetnek el.
\par 23. \'c9s Allah jobban tudja, hogy mit fognak fel [a sz\'edv\'fckben].
\par 24. Adj h\'e1t nekik \'f6r\'f6mh\'edrt egy f\'e1jdalmas b\'fcntet\'e9sr\'f5l!
\par 25. Kiv\'e9ve azokat, akik hisznek, \'e9s j\'f3tetteket cselekszenek. Nekik meg nem sz\'fbn\'f5 jutalom [lesz a r\'e9sz\'fck].
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 85. A csillagok }{\b\insrsid10757626\charrsid3224126 \'e1llom\'e1
sai (al-Bur\'fadzs) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par 1. [Esk\'fcsz\'f6m] a csillagok \'e1llom\'e1saival teli \'e9gre,
\par 2. \'c9s a meg\'edg\'e9rt napra,
\par 3. \'c9s egy tan\'fas\'edt\'f3ra (aki jelen lesz azon a napon), \'e9s [arra, amit] tan\'fas\'edt!
\par 4. Pusztuljanak el az \'e1rok emberei,
\par 5. [Akik] sz\'fcntelen\'fcl t\'e1pl\'e1lt t\'fczet [gy\'fajtottak],
\par 6. Amikor \'f5k k\'f6r\'fcl\'f6tte \'fcltek,
\par 7. \'c9s \'f5k tan\'fai voltak annak, amit tettek a h\'edv\'f5kkel!
\par 8. \'c9s nem [m\'e1st] toroltak meg rajtuk, csak azt, hogy hittek a M\'e9lt\'f3s\'e1gteljes, a Dics\'e9retrem\'e9lt\'f3 Allahban,
\par 9. Aki\'e9 a kir\'e1lyi uralom az egek \'e9s a f\'f6ld felett, \'e9s Allah minden dologra tan\'fa.
\par 
\par 10. Bizony, akik k\'eds\'e9rt\'e9s el\'e9 \'e1ll\'edtott\'e1k a h\'edv\'f5 f\'e9rfiakat \'e9s a h\'edv\'f5 n\'f5ket, azut\'e1n nem tan\'fas\'edtottak b\'fbnb\'e1natot, h\'e1t azoknak a Gyehenna gy\'f6trelme \'e9s az \'c9get\'f5 [Pokol] gy\'f6trelme [j\'e1
r b\'fcntet\'e9sk\'e9nt].
\par 11. Bizony, akik hisznek, \'e9s j\'f3tetteket cselekszenek, azoknak Kertek [j\'e1rnak a Paradicsomban], melyek al\'f3l foly\'f3k folynak. Ez a hatalmas diadal.
\par 
\par 12. Bizony, rettenetes az Urad csap\'e1sa!
\par 13. Bizony, \'d5 az, aki elkezdi [a teremt\'e9st], azt\'e1n megism\'e9tli [azt].
\par 14. \'c9s \'d5 a Megbocs\'e1t\'f3, a Szeretetteljes,
\par 15. A Tr\'f3nus Ura, a Dics\'f5s\'e9ges.
\par 16. [Aki] azt tesz, amit akar.
\par 
\par 17. Vajon elj\'f6tt-e hozz\'e1d a seregekr\'f5l sz\'f3l\'f3 elbesz\'e9l\'e9s,
\par 18. }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 A }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 F\'e1ra\'f3\'e9 \'e9s Tam\'fad\'e9?
\par 19. De nem! Akik hitetlenek, [azok] meghazudtol\'e1sban vannak.
\par 20. \'c1m Allah k\'f6r\'fclveszi \'f5ket, a h\'e1tuk m\'f6g\'fcl.
\par 21. De nem! Ez Dics\'f5s\'e9ges Kor\'e1n,
\par 22. Egy \'d5rz\'f6tt T\'e1bl\'e1n!}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 86. Az \'e9jszaka kopogtat\'f3 [}{\b\insrsid10757626\charrsid3224126 
csillag] (at-T\'e1rik) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par 1. [Esk\'fcsz\'f6m] az \'e9gre \'e9s az \'e9jszaka kopogtat\'f3ra!
\par 2. \'c9s mi tudatn\'e1 veled, hogy mi az \'e9jszaka kopogtat\'f3?
\par 3. A f\'e9nyl\'f5en ragyog\'f3 csillag.
\par 4. Nincs egy ember sem, aki felett ne lenne \'f5rz\'f5.
\par 
\par 5. N\'e9zze h\'e1t meg az ember, [hogy] mib\'f5l teremtetett!
\par 6. Kil\'f6vell\'f5 v\'edzb\'f5l teremtetett,
\par 7. Ami a gerinc \'e9s a bord\'e1k k\'f6z\'fcl j\'f6n el\'f5.
\par 8. Bizony, \'d5neki hatalma van arra, hogy visszahozza [az \'e9letbe],
\par 9. Azon a napon, [melyen] leleplez\'f5dnek a rejtett titkok.
\par 10. Akkor nem lesz neki se ereje, se seg\'edt\'f5je.
\par 
\par 11. [Esk\'fcsz\'f6m] az ism\'e9tl\'f5d\'f5 [es\'f5vel] b\'edr\'f3 \'e9gre,
\par 12. \'c9s hasad\'e9kokkal b\'edr\'f3 f\'f6ldre!
\par 13. Bizony, ez [a Kor\'e1n] d\'f6nt\'f5 sz\'f3,
\par 14. \'c9s ez nem tr\'e9fa.
\par 15. Bizony \'f5k fondorlattal sz\'f5nek cselt,}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 16. \'c1m \'c9n [is] fondorlattal sz\'f6v\'f6k cselt.
\par 17. Adj h\'e1t halad\'e9kot a hitetleneknek! Adj nekik halad\'e9kot egy kev\'e9s ideig!}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 87. A }{\b\insrsid10757626\charrsid3224126 Legmagass\'e1gosabb (al-A
\'e1l\'e1) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par 1. Magasztald a Legmagass\'e1gosabb Urad nev\'e9t,
\par 2. Aki teremtett, azut\'e1n megform\'e1lt,
\par 3. \'c9s aki m\'e9rt\'e9ket szabott \'e9s az [igaz \'fatra] vezetett,
\par 4. \'c9s aki kisarjasztotta [a z\'f6ld] legel\'f5t,
\par 5. S azt fekete, sz\'e1raz avarr\'e1 tette}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 !}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par 
\par 6. Olvastatni fogjuk veled [a Kor\'e1nt], \'e9s nem fogod elfelejteni,
\par 7. Kiv\'e9ve azt, amit Allah akar. Bizony, \'d5 ismeri a megnyilv\'e1nul\'f3t \'e9s azt ami rejtve van.
\par 8. \'c9s k\'f6nny\'fbv\'e9 tessz\'fck sz\'e1modra [a vall\'e1s ter\'e9n] a legk\'f6nnyebb [\'fat v\'e1laszt\'e1s\'e1t].
\par 9. Eml\'e9keztess h\'e1t }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 [a Kor\'e1nnal]}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 , ha [rem\'e9lhet\'f5, hogy] haszn\'e1l az eml\'e9keztet\'e9s!

\par 10. Eml\'e9kezni fog az, aki f\'e9li [Ur\'e1t].
\par 11. \'c1m [aki] elker\'fcli, az a legboldogtalanabb,
\par 12. Aki a [leg]nagyobb [Pokol}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 -}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 ]t\'fbzbe fog beker\'fclni,
\par 13. Azut\'e1n nem fog ott sem meghalni, sem [pedig] \'e9lni.
\par 
\par 14. Bizony, boldogul az, aki megtiszt\'edtja [mag\'e1t],
\par 15. \'c9s megeml\'e9kezik az Ura nev\'e9r\'f5l \'e9s im\'e1dkozik.
\par 16. \'c1m ti el\'f5nyben r\'e9szes\'edtitek az evil\'e1gi \'e9letet,
\par 17. Holott a t\'falvil\'e1g jobb \'e9s maradand\'f3bb.
\par 18. Bizony, ez a kor\'e1bbi }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 [kinyilatkoztatott] lapokon van}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 ,
\par 19. \'c1brah\'e1m \'e9s M\'f3zes lapjain.}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 88. }{\b\insrsid10757626 Az }{\b\insrsid10757626\charrsid9257603 Elbor
\'edt\'f3 (al-Ghasija) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 .}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid944957 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 1. Vajon eljutott-e hozz\'e1d a [borzalmakkal] elbor\'edt\'f3 [\'cdt\'e9let nap] h\'edre?
\par 2. Azon a napon lesznek megal\'e1zott arcok,
\par 3. F\'e1radoz\'f3k, kimer\'fcltek,
\par 4. [Akik] forr\'f3 [Pokol-]t\'fbzben fognak \'e9gni,
\par 5. Fortyog\'f3 viz\'fb forr\'e1sb\'f3l kapnak inni.
\par 6. Nem lesz m\'e1s t\'e1pl\'e1l\'e9kuk, csak egy t\'fcsk\'e9s bokorr\'f3l,
\par 7. Amely nem hizlal, \'e9s nem csillap\'edt \'e9hs\'e9get [sem].
\par 
\par 8. Azon a napon lesznek \'f6r\'f6mt\'f5l ragyog\'f3 arcok,
\par 9. [}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 Akik] }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 igyekezet\'fckkel el\'e9gedettek.
\par 10. Magasan fekv\'f5 kertben lesznek [a Paradicsomban],
\par 11. [Amelyben] nem hallanak \'fcres besz\'e9det.
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 12. }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 [B\'f5s\'e9gesen] \'f6ml\'f5
 forr\'e1s van abban,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 13. Magasra emelt \'e1gyak vannak ott,
\par 14. \'c9s kihelyezett kup\'e1k,
\par 15. \'c9s sorba helyezett p\'e1rn\'e1k,
\par 16. \'c9s kiter\'edtett sz\'f5nyegek.
\par 
\par 17. Nem gondolkodtak el a tev\'e9ken, hogyan teremtettek,
\par 18. \'c9s az \'e9gen, hogyan emeltetett [fel],
\par 19. \'c9s a hegyeken, hogyan }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626 lettek [szil\'e1rdan] r\'f6gz\'edtve,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 20. \'c9s a f\'f6ld\'f6n, }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 hogyan ter\'edttetett ki?
\par 
\par 21. Eml\'e9keztess h\'e1t! Te csup\'e1n egy eml\'e9keztet\'f5 vagy,
\par 22. \'c9s nem vagy felett\'fck uralkod\'f3 [aki k\'e9nyszer\'edten\'e9 \'f5ket].
\par 23. Azonban, aki elfordul \'e9s hitetlen,
\par 24. }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 H\'e1t }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 Allah azt a legnagyobb }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 gy
\'f6trelemmel}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126  fogja s\'fajtani.
\par 25. Bizony, Hozz\'e1nk lesz a visszat\'e9r\'e9s\'fck,
\par 26. [\'c9s] azut\'e1n bizony, r\'e1nk tartozik}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626  az elsz\'e1moltat\'e1suk.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 89. A hajnal (al-F}{\b\insrsid10757626\charrsid3224126 adzsr) c. sz\'fa
ra
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 
\par 1. [Esk\'fcsz\'f6m] a hajnalra,
\par 2. \'c9s [a] t\'edz \'e9jszak\'e1ra,
\par 3. \'c9s a p\'e1rosra \'e9s a p\'e1ratlanra,
\par 4. \'c9s az \'e9jszak\'e1ra, amint elm\'falik!
\par 5. Van-e ebben }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 esk\'fc [ami el\'e9g] }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 az \'e9sszel b\'edr\'f3knak?
\par 6. }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid3224126 Vajon nem gondolkodt\'e1l el azon}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid3224126 , hogyan b\'e1nt el az Urad \'c1ddal,
\par 7. Az oszlopokkal b\'edr\'f3 Iram [n\'e9p\'e9vel],
\par 8. Akikhez hasonl\'f3 [erej\'fb] nem teremtetett az orsz\'e1gokban,
\par 9. \'c9s Tam\'faddal, akik a szikl\'e1kat v\'e1jt\'e1k ki a v\'f6lgyben,
\par 10. \'c9s a szil\'e1rd kar\'f3kkal (seregekkel) b\'edr\'f3 F\'e1ra\'f3val,
\par 11. Akik [mindannyian] t\'falkap\'e1sra vetemedtek az orsz\'e1gokban,
\par 12. \'c9s sok roml\'e1st okoztak azokban?
\par 13. Az Urad pedig a b\'fcntet\'e9s ostor\'e1val s\'fajtott le r\'e1juk.
\par 14. Bizony, Urad lesben \'e1ll.
\par 
\par 15. \'c9s ami az embert illeti, amikor az Ura pr\'f3b\'e1ra teszi [azzal], hogy b\'f5kez\'fb vele \'e9s j\'f3t\'e9tem\'e9nyeivel \'e1rasztja el, akkor azt mondja: \'84Az Uram b\'f5kez\'fb velem!\'94
\par 16. Azonban, amikor azzal teszi \'f5t pr\'f3b\'e1ra, hogy sz\'fbk\'edti neki az ell\'e1t\'e1s\'e1t, akkor azt mondja: \'84Az Uram megal\'e1zott engem!\'94
\par 17. De nem! Ti nem vagytok nagylelk\'fbek az \'e1rv\'e1kkal,
\par 18. \'c9s nem \'f6szt\'f6nzitek [egym\'e1st] a szeg\'e9nyek t\'e1pl\'e1l\'e1s\'e1ra,
\par 19. \'c9s moh\'f3n habzsolva falj\'e1tok fel az \'f6r\'f6ks\'e9get,
\par 20. \'c9s t\'falzott szeretettel szeretitek a vagyont.
\par 
\par 21. De nem! Amikor a f\'f6ld \'fajra \'e9s \'fajra porr\'e1 romboltatik,
\par 22. \'c9s elj\'f6n az Urad, \'e9s egym\'e1st k\'f6vet\'f5 sorokban az angyalok,
\par 23. \'c9s [k\'f6zelebb] hozatik azon a napon a Gyehenna, azon a napon eml\'e9kezni fog az ember, \'e1m hogyan is lehetne [haszn\'e1ra] az eml\'e9kez\'e9s?
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 24. Azt mondja: \'84B\'e1rcsak el\'f5rek\'fcldtem volna valami [j\'f3tettet] a [t\'falvil\'e1gi] \'e9letem sz\'e1m\'e1ra!\'94
\par 25. \'c9s azon a napon senki sem b\'fcntet olyan gy\'f6trelemmel}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid668574 , mint \'d5,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 
\par 26. \'c9s senki sem k\'f6t g\'fazsba \'fagy}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid668574 ,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574  ahogy \'d5 }{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid668574 k\'f6t g\'fazsba.}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 
\par 27. [Akkor az lesz mondva a h\'edv\'f5nek:] \'84\'d3 te}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid668574 ,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574  emberi l\'e9lek, ki nyugalomra lelt\'e9l!
\par 28. T\'e9rj vissza az Uradhoz el\'e9gedetten, megel\'e9ged\'e9st okozva [Neki],
\par 29. \'c9s l\'e9pj be szolg\'e1im k\'f6z\'e9,}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 30. \'c9s l\'e9pj be a Kertembe [a Paradicsomban]!\'94
\par 
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 90. A }{\b\insrsid10757626\charrsid668574 helys\'e9g (al-Balad) c. sz
\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid668574 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 1. Nem! Esk\'fcsz\'f6m erre a helys\'e9gre (Mekk\'e1ra)!
\par 2. \'c9s te ennek a helys\'e9gnek a lak\'f3ja vagy.
\par 3. \'c9s [esk\'fcsz\'f6m] egy ap\'e1ra (\'c1d\'e1mra) \'e9s [arra,] amit nemzett!
\par 4. Bizony, az embert neh\'e9zs\'e9gekkel [teli \'e9letre] teremtett\'fck.
\par 
\par 5. Vajon azt gondolja, hogy senkinek nincs hatalma felette?
\par 6. Azt mondja [b\'fcszk\'e9lkedve]: \'84Egy tem\'e9rdek vagyont herd\'e1ltam el!\'94
\par 7. Vajon azt gondolja, hogy nem l\'e1tta \'f5t senki?
\par 8. Nem adtunk-e neki k\'e9t szemet,
\par 9. \'c9s nyelvet \'e9s k\'e9t ajkat,
\par 10. \'c9s nem mutattuk-e meg neki mindk\'e9t utat?
\par 
\par 11. [Ezek ut\'e1n] b\'e1rcsak neki v\'e1gott volna a kaptat\'f3nak.
\par 12. \'c9s mi tudatn\'e1 veled, hogy mi az a kaptat\'f3?
\par 13. Felszabad\'edtani egy rabszolg\'e1t,
\par 14. Vagy t\'e1pl\'e1lni egy \'e9h\'edns\'e9ges napon
\par 15. Egy \'e1rva rokont,
\par 16. Vagy egy hontalan szeg\'e9nyt,}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid668574 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 17. [\'c9s] emellett azok k\'f6z\'e9 tartozni, akik hisznek, \'e9
s akik egym\'e1s lelk\'e9re k\'f6tik a t\'fcrelmet \'e9s egym\'e1s lelk\'e9re k\'f6tik a k\'f6ny\'f6r\'fcletet.
\par 18. \'d5k a jobb k\'e9z fel\'f5liek.
\par 19. Akik azonban hitetlenn\'e9 v\'e1ltak a jeleinkkel szemben, \'f5k a bal k\'e9z fel\'f5liek.
\par 20. Bez\'e1rult [Pokol-]t\'fbz lesz felett\'fck.}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }{\b\insrsid10757626 
\par 
\par 
\par }{\b\insrsid10757626\charrsid9257603 91. A Nap (as-}{\b\insrsid10757626\charrsid668574 Samsz) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{
\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid668574 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 
\par 1. [Esk\'fcsz\'f6m] a Napra \'e9s a [d\'e9lel\'f5tti] f\'e9nyess\'e9g\'e9re,
\par 2. \'c9s a Holdra, amikor k\'f6veti,
\par 3. \'c9s a nappalra, amikor beragyogja
\par 4. \'c9s az \'e9jszak\'e1ra, amint bebor\'edtja }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid668574 [a f\'f6ldet]}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 ,
\par 5. \'c9s az \'e9gre \'e9s arra, aki fel\'e9p\'edtette,
\par 6. \'c9s a f\'f6ldre \'e9s arra, aki kiter\'edtette,
\par 7. \'c9s az emberre \'e9s arra, aki }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid668574 [ar\'e1nyosan] }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 megform\'e1lta,
\par 8. \'c9s sugallta neki a f\'e9ktelen gonoszs\'e1g\'e1t \'e9s az istenf\'e9lelm\'e9t!
\par 9. Bizony, boldogul, aki megtiszt\'edtja azt,
\par 10. \'c9s bizony kudarcot vall, aki megrontja azt.
\par 
\par 11. Meghazudtolta Tam\'fad [a k\'fcld\'f6ttet azzal, hogy] t\'falkap\'e1sra vetemedtek,
\par 12. Amikor a legnyomorultabb felkerekedett [meg\'f6lni a tev\'e9t],
\par 13. Holott Allah k\'fcld\'f6tte (Szaleh pr\'f3f\'e9ta) azt mondta nekik: \'84[Vigy\'e1zzatok] Allah n\'f5st\'e9nytev\'e9j\'e9re, \'e9s [\'fcgyeljetek] }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid668574 az }{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid668574 itat\'e1s\'e1ra!\'94
\par 14. \'c1m meghazudtolt\'e1k [a pr\'f3f\'e9t\'e1t] \'e9s elv\'e1gt\'e1k [a teve] l\'e1bin\'e1t, az Uruk pedig elpuszt\'edtotta \'f5ket a b\'fbn\'fck miatt, egyform\'e1n [les\'fajtv\'e1n mindannyiukra].
\par 15. \'c9s nem f\'e9l annak a k\'f6vetkezm\'e9ny\'e9t\'f5l.}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 92. Az \'e9jszaka (al-Lejl) c. }{\b\insrsid10757626\charrsid14763858 sz
\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid14763858 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid14763858 .
\par 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid14763858 1. [Esk\'fcsz\'f6m] az \'e9jszak\'e1ra, amikor bebor\'edt,
\par 2. \'c9s a nappalra, amikor felragyog,
\par 3. \'c9s arra [Aki] a h\'edmnem\'fbt \'e9s a n\'f5nem\'fbt teremtette!
\par 4. Bizony, k\'fcl\'f6nb\'f6z\'f5 az igyekezetetek.
\par 5. \'cdgy az, aki adakozik \'e9s istenf\'e9l\'f5,
\par 6. \'c9s hisz a legjobb [jutalomban] (a Paradicsomban),
\par 7. }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid14763858 H}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid14763858 \'e1t neki k\'f6nny\'fbv\'e9 fogjuk tenni [az utat] a legk\'f6nnyebb [sorsra].
\par 
\par 8. Aki azonban f\'f6sv\'e9ny \'e9s \'f6nmag\'e1t el\'e9gnek tartja,
\par 9. \'c9s hazugs\'e1gnak tartja a legjobb [jutalmat] (a Paradicsomot),
\par 10. }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid14763858 H}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid14763858 \'e1t neki k\'f6nny\'fbv\'e9 fogjuk tenni [az utat] a legnehezebb [sorsra].
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid14763858 11. \'c9s nem fog haszn\'e1
lni neki a vagyona, amikor lezuhan [a Pokol-t\'fbzbe].
\par 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 12. Bizony, R\'e1nk tartozik az \'fatmutat\'e1s.
\par 13. \'c9s bizony, a Mi\'e9nk (a hatalmunk al\'e1 tartozik) a t\'falvil\'e1g \'e9s az evil\'e1g.
\par 14. Figyelmeztetlek h\'e1t titeket egy [olyan] t\'fbzzel kapcsolatban, amely lobog.
\par 15. Csup\'e1n a legboldogtalanabb fog benne \'e9gni,
\par 16. Aki meghazudtol\'e1st k\'f6vetett el \'e9s elfordult.
\par 17. \'c1m t\'e1vol lesz tartva t\'f5le a legistenf\'e9l\'f5bb,
\par 18. Aki adakozik vagyon\'e1b\'f3l, hogy megtiszt\'edtsa mag\'e1t.
\par 19. \'c9s nem [az\'e9rt teszi, mert] tartozik valakinek [viszonz\'e1ssal] valamilyen j\'f3t\'e9tem\'e9ny\'e9rt, amelyet [\'edgy] fizetnek meg.
\par 20. Csakis [az\'e9rt teszi, mert] a Legmagass\'e1gosabb Ura arc\'e1t (el\'e9gedetts\'e9g\'e9t) \'e1h\'edtozza.
\par 21. \'c9s bizonyosan el\'e9gedett lesz.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 93. A D\'e9lel\'f5tt (ad-Duh\'e1) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. [Esk\'fcsz\'f6m] a d\'e9lel\'f5ttre,
\par 2. \'c9s az \'e9jszak\'e1ra, amint els\'f6t\'e9t\'fcl!
\par 3. Nem hagyott el t\'e9ged az Urad, \'e9s nem [is] gy\'fbl\'f6lt meg.
\par 4. \'c9s bizony, a t\'falvil\'e1g jobb neked, mint az evil\'e1g,
\par 5. \'c9s bizonyosan adni fog neked az Urad, \'e9s te el\'e9gedett leszel [azzal].
\par 
\par 6. Vajon nem tal\'e1lt t\'e9ged \'e1rv\'e1nak, s adott mened\'e9ket?
\par 7. \'c9s tal\'e1lt t\'e9ged t\'e9velyg\'f5nek (nem tudtad, hogy mi az \'cdr\'e1s, \'e9s hogy mi a hit), majd vezetett [az igaz \'fatra]?
\par 8. \'c9s tal\'e1lt t\'e9ged sz\'fbk\'f6lk\'f6d\'f5nek, majd tett gazdagg\'e1?
\par 9. \'cdgy h\'e1t az \'e1rv\'e1val ne zsarnokoskodj!
\par 10. \'c9s a k\'e9reget\'f5t ne utas\'edtsd el durv\'e1n!
\par 11. \'c9s az Urad j\'f3t\'e9tem\'e9ny\'e9t pedig h\'edreszteld el!}{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626 \page }{\b\insrsid10757626\charrsid9257603 94. A kit\'e1r\'e1s (as-}{\b\insrsid10757626\charrsid6884728 Sarh) c.
 sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .}{
\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 1. Nem t\'e1rtuk-e ki neked }{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 [\'f3 Mohamed] }{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 a kebled,
\par 2. \'c9s vett\'fck le r\'f3lad a terhed,
\par 3. Amely roskasztotta a h\'e1tad,
\par 4. \'c9s emelt\'fck [magasra] a tekint\'e9lyed?
\par 
\par 5. \'c9s bizony, a neh\'e9zs\'e9ggel k\'f6nnyebbs\'e9g [j\'f6n].
\par 6. Bizony, a neh\'e9zs\'e9ggel k\'f6nnyebbs\'e9g [j\'f6n].
\par 7. S ha befejezted [az evil\'e1gi teend\'f5id], akkor f\'e1radozz [az istenszolg\'e1latban]!
\par 8. \'c9s Uradhoz [\'f5szint\'e9n] v\'e1gyakozz!}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 95. A f\'fcgefa (at-T\'edn) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. [Esk\'fcsz\'f6m] a f\'fcge \'e9s az ol\'edva [term\'f5hely\'e9re] (Jeruzs\'e1lemre),
\par 2. \'c9s a S\'ednai hegyre,
\par 3. \'c9s erre a biztons\'e1gos v\'e1rosra (Mekk\'e1ra)!
\par 4. Bizony, a legszebb fel\'e9p\'edt\'e9sben teremtett\'fck az embert.
\par 5. Azt\'e1n az alantasak legalantasabbj\'e1v\'e1 vetett\'fck vissza,
\par 6. Kiv\'e9ve azokat, akik hisznek \'e9s j\'f3tetteket cselekszenek, azoknak meg nem sz\'fbn\'f5 fizets\'e9gben lesz r\'e9sz\'fck.
\par 
\par 7. Mi vesz r\'e1 t\'e9ged [\'f3 ember] ezut\'e1n [arra], hogy hazugs\'e1gnak tartsd az \'cdt\'e9letet?
\par 8. H\'e1t nem Allah-e a legb\'f6lcsebb az \'edt\'e9lkez\'f5k k\'f6z\'f6tt}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 ?}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 !
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 96. A v\'e9rr\'f6g (al-Alaq) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. Olvass az Urad nev\'e9vel [kezdve], aki teremtett!
\par 2. V\'e9rr\'f6gb\'f5l teremtette az embert.
\par 3. Olvass! \'c9s a te Urad a legb\'f5kez\'fbbb,
\par 4. Aki tan\'edtott az \'edr\'f3tollal,
\par 5. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 M}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 egtan\'edtotta az embert arra, amit nem tudott.
\par 
\par 6. De nem! Bizony, az ember t\'falkap\'e1sokra vetemedik,
\par 7. Mert olyannak l\'e1tja mag\'e1t, akinek nincs sz\'fcks\'e9ge [senkire].
\par 8. Bizony, az Uradhoz lesz a visszat\'e9r\'e9s!
\par 
\par 9. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 Vajon m}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 it gondolsz arr\'f3l, aki eltilt
\par 10. Egy szolg\'e1t [att\'f3l, hogy im\'e1dkozzon] amikor im\'e1dkozik?
\par 11. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 Vajon m}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 it gondolsz [}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 a}{
\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 rr\'f5l], ha [ez a szolga] az igaz \'faton van,
\par 12. Vagy az istenf\'e9lelemre sz\'f3l\'edt fel?
\par 13. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 Vajon m}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 it gondolsz [}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 a}{
\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 rr\'f5l], ha [a tilt\'f3] meghazudtol\'e1st k\'f6vet el, \'e9s elfordul?
\par 14. Nem tudja-e, hogy Allah l\'e1tja [\'f5t]?
\par 15. De nem! Ha nem hagyja abba, bizony az \'fcst\'f6k\'e9n\'e9l fogva megragadjuk,
\par 16. Egy hazug, b\'fbn\'f6s [ember] \'fcst\'f6k\'e9n\'e9l.
\par 17. H\'edvja csak }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 [akkor] }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 a gy\'fbl\'e9s\'e9t!
\par 18. Mi [is] h\'edvni fogjuk a [Pokol-t\'fbz] \'f5reit!
\par 19. De nem! Ne engedelmeskedj neki! Borulj le \'e9s k\'f6zeledj [az Uradhoz]!
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 97. Az Elrendel\'e9s (al-Kadr) c. sz\'fara
\par }\pard \ql \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. Bizony, mi az Elrendel\'e9s \'e9jszak\'e1j\'e1n bocs\'e1tottuk le azt [a Kor\'e1nt].
\par 2. }{\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 \'c9s mi tudatn\'e1 veled}{\cf1\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 ,}{
\cf1\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728  [hogy]}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728  mi az Elrendel\'e9s \'e9jszak\'e1ja?
\par 3. Az Elrendel\'e9s \'e9jszak\'e1ja jobb, mint ezer h\'f3nap.
\par 4. Leereszkednek az angyalok \'e9s a L\'e9lek azon }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 [az \'e9jszak\'e1n] az}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728  Uruk engedelm\'e9vel minden paranccsal.

\par 5. B\'e9kess\'e9g az a hajnalhasad\'e1s elj\'f6vetel\'e9ig.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 98. A vil\'e1gos bizony\'edt\'e9k (al-Bajjina) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 1. Akik hitetlenek az \'cdr\'e1s n\'e9pe k\'f6z\'fcl \'e9s az [Allah mell\'e9] t\'e1rsistent helyez\'f5k mindaddig k\'e9ptelenek eloldozni magukat [a hitetlens\'e9g\'fckt\'f5l], m
\'edg el nem j\'f6n hozz\'e1juk a vil\'e1gos bizony\'edt\'e9k,
\par 2. Egy k\'fcld\'f6tt (Mohamed) Allaht\'f3l, aki megtiszt\'edtott lapokat (Kor\'e1nt) recit\'e1l [nekik],
\par 3. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 M}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 elyekben igaz \'edr\'e1sok vannak.
\par 4. \'c9s azok, akiknek az \'cdr\'e1s adatott, nem szakadtak csoportokra, csak azut\'e1n, hogy elj\'f6tt hozz\'e1juk a vil\'e1gos bizony\'edt\'e9k.
\par 5. \'c1m nem parancsoltatott nekik m\'e1s, minthogy szolg\'e1lj\'e1k Allahot \'f5szinte odaad\'e1ssal szentelve Neki a vall\'e1s [gyakorl\'e1s\'e1t], han\'edf-okk\'e9nt (egyistenh\'edv\'f5kk\'e9nt, a hamis vall\'e1sokt\'f3l elhajl\'f3kk\'e9nt), \'e9
s [hogy] tarts\'e1k meg az im\'e1dkoz\'e1st \'e9s adj\'e1k meg a k\'f6telez\'f5 adom\'e1nyt. \'c9s ez az igaz vall\'e1s.
\par 
\par 6. Bizony [azok]}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 ,}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728  akik hitetlenn\'e9 v\'e1ltak az \'cdr\'e1s n\'e9p\'e9b\'f5l \'e9s az [Allah mell\'e9] t\'e1
rsistent \'e1ll\'edtok, azok a Gyehenna t\'fcz\'e9ben [lesznek], abban maradnak \'f6r\'f6kk\'e9. \'d5k bizony a legrosszabb teremtm\'e9nyek.
\par 7. Azonban, akik hisznek \'e9s j\'f3tetteket cselekszenek, azok bizony a legjobb teremtm\'e9nyek.
\par 8. Az \'f5 fizets\'e9g\'fck az Urukn\'e1l }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 \'f6r\'f6kk\'e9 tart\'f3}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728  kertek}{
\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 ,}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728  amelyek al\'f3l foly\'f3k folynak, \'f6r\'f6kk\'f6n \'f6r\'f6kk\'e9 abban fognak maradni. }{
\insrsid10757626\charrsid6884728 Allah el\'e9gedett [lesz] vel\'fck, \'e9s \'f5k is el\'e9gedettek [lesznek] Vele (a T\'f5le kapott jutalommal).}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728  Ez j\'e1r annak, aki f\'e9li az Ur
\'e1t.
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 99. A f\'f6ldreng\'e9s (az-Zelzela) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. Amikor rengeni [kezd] a f\'f6ld, [a v\'e9gs\'f5] reng\'e9s\'e9vel,
\par 2. \'c9s kiveti a f\'f6ld a terheit,
\par 3. \'c9s azt mondja az ember: \'84Mi lelte?\'94,
\par 4. Azon a napon [a f\'f6ld] elmondja a h\'edreit,
\par 5. Mivel az Urad sugallatot ad neki.
\par 6. Azon a napon az emberek elk\'fcl\'f6n\'fclt csoportokban j\'f6nnek el\'f5, hogy megmutass\'e1k nekik tetteiket.
\par 7. \'c9s aki egy porszem s\'falynyi j\'f3t tett, meg fogja l\'e1tni azt,
\par 8. \'c9s aki egy porszem s\'falynyi rosszat tett, meg fogja l\'e1tni azt.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 \page 100. A v\'e1gtat\'f3k (al-\'c1dij\'e1t) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. [Esk\'fcsz\'f6m a lovakra}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 ,}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 ] a zih\'e1lva v\'e1gtat\'f3kra,
\par 2. \'c9s a [pat\'e1jukkal] szikr\'e1t sz\'f3r\'f3kra,
\par 3. \'c9s az [ellens\'e9gre] reggel t\'e1mad\'f3kra,
\par 4. \'c9s amelyek [v\'e1gt\'e1z\'e1sukkal] porfelh\'f5t kavarnak,
\par 5. \'c9s ez\'e1ltal a sereg k\'f6zep\'e9be hatolnak!
\par 
\par 6. Az ember bizony h\'e1l\'e1tlan az Ur\'e1val szemben,
\par 7. \'c9s bizony erre \'f5 [maga] a tan\'fa,
\par 8. \'c9s bizony er\'f5s benne a vagyon szeretete.
\par 9. Vajon h\'e1t nem tudja, hogy amikor kisz\'f3ratik az, ami a s\'edrokban van (felt\'e1madnak az emberek),
\par 10. \'c9s felfedetik az, ami a keblekben [rejtve] van,
\par 11. [}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 H}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 ogy] bizony azon a napon, az Uruk j\'f3l ismeri \'f5ket?!
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 101. A Les\'fajt\'f3 (al-Kari\'e1) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 1. A Les\'fajt\'f3!
\par 2. Mi a Les\'fajt\'f3?
\par 3. \'c9s mi tudatn\'e1 veled, }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 [hogy] }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 mi a Les\'fajt\'f3?
\par 4. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 [Az a] nap, [amikor] }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 az emberek olyanok lesznek, mint a [f\'e9ny miatt zavartan] sz\'e9tsz\'f3r\'f3d\'f3 lepk
\'e9k,
\par 5. \'c9s a hegyek olyanok lesznek, mint a [k\'e1rtol\'e1s \'e1ltal] bolyholt gyapj\'fa.
\par 
\par 6. Akkor}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 ,}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728  akinek s\'falyosak lesznek a m\'e9rend\'f5i [a j\'f3tettekb\'f5l],
\par 7. H\'e1t annak el\'e9gedetts\'e9get ad\'f3 \'e9lete lesz.
\par 8. Akinek pedig k\'f6nny\'fbek lesznek a m\'e9rend\'f5i [a j\'f3tettekb\'f5l],
\par 9. Annak Szakad\'e9k lesz a lakhelye.
\par 10. \'c9s mi tudatn\'e1 veled, [hogy] mi az?
\par 11. Forr\'f3 t\'fbz!
\par 
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 102. A rivaliz\'e1l\'e1s (at-Tak\'e1szur) c. sz\'fara}{
\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. Lefoglal titeket a rivaliz\'e1l\'e1s [az evil\'e1gi javak felhalmoz\'e1s\'e1ban],}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 2. Am\'edg meg [nem] l\'e1togatj\'e1tok a s\'edrokat [a hal\'e1lotokkor].
\par 3. De nem! Megtudj\'e1tok majd!
\par 4. \'c9s m\'e9g egyszer nem! Megtudj\'e1tok majd!
\par 
\par 5. De nem! Ha biztos tud\'e1ssal b\'edrn\'e1tok [akkor nem rivaliz\'e1ln\'e1tok]!
\par 6. Bizony, l\'e1tni fogj\'e1tok a Poklot.
\par 7. Majd bizony, l\'e1tni fogj\'e1tok azt biztos l\'e1t\'e1ssal!
\par 8. Majd bizony, azon a napon k\'e9rd\'f5re lesztek vonva az }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 [evil\'e1gi] }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 gy\'f6ny\'f6r\'fbs\'e9gekr\'f5l.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 \page 103. A d\'e9lut\'e1n (al-Aszr) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. [Esk\'fcsz\'f6m] a d\'e9lut\'e1nra!
\par 2. Bizony, az ember }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 biztosan }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 vesztes lesz,
\par 3. Kiv\'e9ve azok, akik hisznek \'e9s j\'f3tetteket cselekszenek, \'e9s egym\'e1s lelk\'e9re k\'f6tik az igazs\'e1got \'e9s egym\'e1s lelk\'e9re k\'f6tik a t\'fcrelmet.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 104. A s\'e9rtve r\'e1galmaz\'f3k (al-Humaza) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. Jaj minden s\'e9rtve r\'e1galmaz\'f3nak, becsm\'e9rl\'f5en mutogat\'f3nak,}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 2. Aki vagyont gy\'fbjt \'e9s [folyton] sz\'e1ml\'e1lja azt!
\par 3. Azt gondolja, hogy a vagyona \'f6r\'f6k \'e9let\'fbv\'e9 teszi?!
\par 4. De nem! Biztosan a Sz\'e9tz\'faz\'f3ba lesz belevetve!
\par 5. \'c9s mi tudatn\'e1 veled, hogy mi a Sz\'e9tz\'faz\'f3?
\par 6. Allah meggy\'fajtott t\'fcze,
\par 7. Amely a sz\'edvekig hatol.
\par 8. Bizony, az \'f6sszez\'e1rul felett\'fck,
\par 9. Magasba ny\'fal\'f3 [l\'e1ng] oszlopokban.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 105. Az elef\'e1nt (al-F\'edl) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 Vajon n}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 em }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 gondolkodt\'e1l el azon}{
\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 , [hogy] }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 mit}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728  tett az Urad a [harci] elef
\'e1nt gazd\'e1ival?
\par 2. Nem vitte-e a fondorlatukat t\'e9v\'fatra?
\par 3. \'c9s madarakat k\'fcld\'f6tt r\'e1juk csoportokban,
\par 4. [}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 A}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 melyek] \'e9getett agyagk\'f6vekkel dob\'e1lt\'e1k meg \'f5ket.
\par 5. \'c9s olyann\'e1 tette \'f5ket, mint [a] ler\'e1gott levelek.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 106. Kurejs (Kurajs) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. A Kurejs [t\'f6rzs] egyezs\'e9g\'e9\'e9rt [ami\'e9rt elpuszt\'edtottuk a Mekka ellen harci elef\'e1nttal t\'e1mad\'f3kat],
\par 2. A t\'e9li \'e9s a ny\'e1ri karav\'e1n\'fatjaik [biztons\'e1g\'e1t szavatol\'f3] egyezs\'e9g\'fck\'e9rt}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 3. Szolg\'e1lj\'e1k h\'e1t e H\'e1z [a Mekkai szent\'e9ly] Ur\'e1t,}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 4. Aki t\'e1pl\'e1lta \'f5ket \'e9hs\'e9g\'fck ellen, \'e9s biztons\'e1got adott nekik f\'e9lelm\'fck ellen!}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 

\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 107. A seg\'edts\'e9gad\'e1s (al-M\'e1\'fan) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. V}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 ajon mit gondolsz arr\'f3l,}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728  aki meghazudtolja az \'cdt\'e9letet?
\par 2. H\'e1t \'f5 az, aki elzavarja az \'e1rv\'e1t,
\par 3. \'c9s nem \'f6szt\'f6n\'f6z a szeg\'e9nyek t\'e1pl\'e1l\'e1s\'e1ra.
\par 
\par 4. Jaj h\'e1t az im\'e1dkoz\'f3knak,
\par 5. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 Azoknak, }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 akik hanyagok az im\'e1dkoz\'e1sukat illet\'f5en,
\par 6. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 Azoknak, }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 akik a l\'e1tszat kedv\'e9\'e9rt cselekszenek,
\par 7. \'c9s megtagadj\'e1k [m\'e1sokt\'f3l] a seg\'edts\'e9gad\'e1st.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 108. A b\'f5s\'e9g (al-Kauthar) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. Bizony, Mi megadtuk neked [\'f3 Mohamed] a b\'f5s\'e9get.
\par 2. Im\'e1dkozz h\'e1t az Uradhoz \'e9s [csak Neki] \'e1ldozz!}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 3. Bizony, a t\'e9ged gy\'fbl\'f6l\'f5, \'f5 az [aki minden j\'f3t\'f3l] elv\'e1gatott!
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 109. A hitetlenek (al-K\'e1fir\'fan) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. Mondd: \'d3, ti hitetlenek!
\par 2. Nem szolg\'e1lom, amit ti szolg\'e1ltok,
\par 3. \'c9s ti sem szolg\'e1lj\'e1tok, amit \'e9n szolg\'e1lok.
\par 4. \'c9s \'e9n nem fogom szolg\'e1lni azt, amit ti szolg\'e1ltok,
\par 5. \'c9s ti sem fogj\'e1tok azt szolg\'e1lni, amit \'e9n szolg\'e1lok.
\par 6. Nektek megvan a vall\'e1sotok \'e9s nekem is megvan a vall\'e1som.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 110. A seg\'edts\'e9g (an-Naszr) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. Amikor elj\'f6n Allah seg\'edts\'e9ge \'e9s a gy\'f5zelem,
\par 2. \'c9s [amikor] l\'e1tod, ahogyan az emberek t\'f6megesen l\'e9pnek be Allah vall\'e1s\'e1ba,
\par 3. [Akkor] magasztald h\'e1t az Urad, az \'d5t illet\'f5 h\'e1latelt dics\'e9rettel, \'e9s k\'e9rj t\'f5le }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 megbocs\'e1t\'e1st}{
\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 ! Bizony, \'d5 }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 mindig K}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 iengesztel\'f5d
\'f5.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 111. A p\'e1lmarost (al-Meszed) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par A K\'f6ny\'f6r\'fcletes \'e9s az Irgalmas Allah nev\'e9ben}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 .
\par }{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
\par 1. Pusztuljon el Ab\'fa Leheb mindk\'e9t keze, \'e9s el is fog pusztulni!
\par 2. Nem seg\'edt rajta a vagyona, \'e9s [az sem] amit szerzett.
\par 3. L\'e1ngol\'f3 t\'fbzben fog \'e9gni,
\par 4. }{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 \'c9}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 s a feles\'e9ge [is], a t\'fbzifahord\'f3,
\par 5. [}{\lang1038\langfe255\langfenp255\insrsid10757626\charrsid6884728 A}{\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 kinek] a nyak\'e1ban p\'e1lmarost-k\'f6t\'e9l lesz.
\par 
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid10757626 {\b\insrsid10757626\charrsid6884728 112. Az \'f5szinte egyistenhit (al-Ikhlasz) c. sz\'fara
\par }\pard \qj \li0\ri0\widctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10757626 {\lang255\langfe255\langnp255\langfenp255\insrsid10757626\charrsid6884728 
